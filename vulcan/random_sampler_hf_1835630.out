    # code...


    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    import collections
    import numpy as np

    # Action indices as defined in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_adjacent(start, targets, occ):
        """
        Bread‑first search returning a list of actions that moves the agent
        from `start` to a cell that is orthogonally adjacent to any cell in
        `targets`.  `occ` is a 2‑D boolean mask where True indicates a blocked
        cell.
        """
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Explore neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell.
        return []

    def _apply_actions(pos, actions):
        """Return the new position after executing `actions` from `pos`."""
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ----------------------------------------------------------------------
    # Locate world / cookbook objects
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers store the world inside the current state.
        cur = getattr(env, "_current_state", None)
        if cur is not None:
            world = getattr(cur, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Identify goal and its primitive requirements
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary)
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()              # mutable copy for planning
    occ = np.any(grid, axis=2)            # occupied cells mask (bool)

    plan_actions = []
    harvested_cells = set()               # primitives already taken

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # Locate all cells that currently contain this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position to reduce travel.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed_cnt:
                break
            if cell in harvested_cells:
                continue
            # Move adjacent to the primitive.
            path = _bfs_adjacent(pos, [cell], occ)
            plan_actions.extend(path)
            pos = _apply_actions(pos, path)

            # Pick it up.
            plan_actions.append(USE)
            # Update planning structures: cell becomes empty.
            occ[cell[0], cell[1]] = False
            grid[cell[0], cell[1], prim_idx] = 0
            harvested_cells.add(cell)
            collected += 1

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or already an integer).
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str)
                  else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_adjacent(pos, [target_ws], occ)
            plan_actions.extend(path)
            pos = _apply_actions(pos, path)
            plan_actions.append(USE)   # craft at workshop
        else:
            # No visible workshop – attempt to craft where we stand.
            plan_actions.append(USE)
    else:
        # No specific workshop required.
        plan_actions.append(USE)

    return plan_actions

