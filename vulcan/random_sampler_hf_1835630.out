    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_to(pos, target, seq):
        """Append moves that bring mutable ``pos`` (list [x, y]) to ``target``."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos):
        """Return the (x, y) of the nearest cell containing ``kind_idx``."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Initialise mutable state
    # ------------------------------------------------------------------
    # Starting position
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Static grid copy – we will clear primitives once they are picked up.
    grid = env.scenario.init_grid.copy()

    # Inventory tracker (counts of each kind we have already collected/crafted)
    inventory = {}

    # Action sequence to be returned
    actions = []

    # Goal item index
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # Core recursive planner
    # ------------------------------------------------------------------
    def _ensure(item_idx, needed):
        """Make sure ``inventory[item_idx]`` >= ``needed`` by collecting/crafting."""
        have = inventory.get(item_idx, 0)
        while have < needed:
            # Primitive case – just pick it up from the world.
            if item_idx in env.world.cookbook.primitives:
                target = _nearest_kind(item_idx, cur_pos)
                if target is None:
                    # Primitive not available; abort planning.
                    return False
                _move_to(cur_pos, target, actions)
                actions.append(USE)                     # pick up
                grid[target[1], target[0], item_idx] = 0  # remove from static view
                inventory[item_idx] = inventory.get(item_idx, 0) + 1
                have += 1
            else:
                # Crafted item – first ensure all its ingredients.
                recipe = env.world.cookbook.recipes.get(item_idx, {})
                # Gather ingredients (ignore the special "_at" key).
                for ing_idx, cnt in recipe.items():
                    if ing_idx == "_at":
                        continue
                    if not _ensure(ing_idx, cnt):
                        return False
                # Move to the required workshop (if any) and craft.
                workshop_idx = recipe.get("_at")
                if workshop_idx is not None:
                    w_target = _nearest_kind(workshop_idx, cur_pos)
                    if w_target is None:
                        # No workshop found; abort.
                        return False
                    _move_to(cur_pos, w_target, actions)
                actions.append(USE)                     # perform crafting
                # Update inventory: consume ingredients, add the crafted item.
                for ing_idx, cnt in recipe.items():
                    if ing_idx == "_at":
                        continue
                    inventory[ing_idx] = inventory.get(ing_idx, 0) - cnt
                inventory[item_idx] = inventory.get(item_idx, 0) + 1
                have += 1
        return True

    # ------------------------------------------------------------------
    # Execute the plan for the final goal.
    # ------------------------------------------------------------------
    _ensure(goal_idx, 1)

    return actions


