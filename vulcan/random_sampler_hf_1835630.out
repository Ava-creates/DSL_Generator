    import collections
    import numpy as np

    # Action indices (standard CraftWorld actions)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from `start` to a
    # position adjacent (Manhattan distance = 1) to any cell in `targets`.
    # The search treats any occupied cell (grid[...,k] > 0 for any k) as
    # blocked.  If `start` is already adjacent, an empty list is returned.
    # ------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # adjacency check
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no reachable adjacency – return empty list
        return []

    # ------------------------------------------------------------------
    # Helper: update a position tuple given an action.
    # ------------------------------------------------------------------
    def _apply_path(pos, path):
        x, y = pos
        for act in path:
            if act == RIGHT:
                x += 1
            elif act == LEFT:
                x -= 1
            elif act == DOWN:
                y += 1
            elif act == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate the underlying CraftWorld and its cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the internal state.
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal: craft an 'arrow'.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for one arrow.
    primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # ------------------------------------------------------------------
    # Ensure we start from a fresh episode.
    # ------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)            # (x, y)
    grid = state.grid                  # (W, H, n_kinds)

    # Occupancy map: True where any entity blocks movement.
    occupied = np.any(grid > 0, axis=2)

    actions = []                       # final action list
    collected_cells = set()            # primitives already taken

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Current locations of this primitive.
        locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locs:
            if gathered >= needed:
                break
            if loc in collected_cells:
                continue
            # Path to a cell adjacent to the primitive.
            path = _bfs_to_adjacent(pos, [loc], occupied)
            actions.extend(path)
            pos = _apply_path(pos, path)

            # Pick up the primitive.
            actions.append(USE)

            # Update occupancy and bookkeeping.
            occupied[loc[0], loc[1]] = False
            collected_cells.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or an int).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if not workshop_cells:
            raise RuntimeError(f"No workshop of type '{workshop_key}' found in the scenario.")
        # Choose the nearest workshop.
        workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        target_ws = workshop_cells[0]

        path = _bfs_to_adjacent(pos, [target_ws], occupied)
        actions.extend(path)
        pos = _apply_path(pos, path)

        # Craft the arrow.
        actions.append(USE)

    return actions

