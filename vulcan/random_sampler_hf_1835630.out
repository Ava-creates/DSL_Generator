    DIR_TO_ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    from collections import deque
    import numpy as np

    def bfs(start, targets, grid, blocked_kinds):
        """Return actions moving from ``start`` to a cell adjacent to any
        cell in ``targets`` while avoiding ``blocked_kinds``."""
        W, H = grid.shape[:2]
        blocked = np.zeros((W, H), dtype=bool)
        for k in blocked_kinds:
            blocked |= grid[:, :, k] > 0

        sx, sy = start
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []

    # ------------------------------------------------------------------
    # Initialise environment and extract task information.
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)

    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task.")

    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind: count}
    block_set = env.world.non_grabbable_indices

    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_kind, cnt in needed_prims.items():
        while cnt > 0:
            cells = np.argwhere(grid[:, :, prim_kind] > 0)
            if cells.size == 0:
                # Primitive exhausted – abort planning.
                return plan
            path = bfs(pos, cells.tolist(), grid, block_set)
            plan.extend(path)
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            plan.append(4)  # USE to pick up
            adj = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                break
            grid[adj[0], adj[1], prim_kind] -= 1
            cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to the workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get('_at') or recipe.get('_key')
    if workshop_key is not None:
        if isinstance(workshop_key, str):
            workshop_kind = env.world.cookbook.index[workshop_key]
        else:
            workshop_kind = int(workshop_key)
        workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid, block_set)
            plan.extend(path)
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            plan.append(4)  # USE to craft

    return plan


    # Mapping from direction vectors to action indices.
    DIR_TO_ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    # ------------------------------------------------------------------
    # Breadth‑first search that returns a list of actions moving the agent
    # from ``start_pos`` to a position that is Manhattan‑adjacent to any
    # cell in ``target_cells``.  Cells that contain any entity are treated
    # as blocked (the agent may only stand on empty cells).
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs(start_pos, target_cells, grid):
        """Return actions to reach a cell adjacent to one of ``target_cells``."""
        W, H = grid.shape[:2]
        # A cell is blocked if any kind occupies it.
        blocked = np.any(grid, axis=2)

        sx, sy = start_pos
        # If we are already adjacent, no movement needed.
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency – return empty list.
        return []

    # ------------------------------------------------------------------
    # Initialise the environment and extract task information.
    # ------------------------------------------------------------------
    obs = env.reset()
    state = env._current_state
    grid = state.grid.copy()               # (W, H, K) occupancy tensor
    pos = tuple(state.pos)                 # current (x, y) coordinates

    # Goal index is stored in the task object.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in the environment's task.")

    # Primitive requirements for the goal (primitive kind → count).
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    plan = []  # List of action indices to be returned.

    # ------------------------------------------------------------------
    # 1. Collect all required primitive resources.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        while needed_cnt > 0:
            # Locate all remaining cells that contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more of this primitive on the map – abort planning.
                return plan

            # Find a path to the nearest reachable primitive (adjacent cell).
            path = bfs(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Update simulated position according to the path taken.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use the primitive (action index 4 corresponds to USE).
            plan.append(4)   # USE

            # Determine which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation – break to avoid infinite loop.
                break

            # Remove one instance of the primitive from the local grid copy.
            grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
            needed_cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get('_at') or recipe.get('_key')
    if workshop_key is not None:
        # Resolve the workshop kind index (string name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            # Update simulated position.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft the item by using the workshop.
            plan.append(4)   # USE

    return plan

