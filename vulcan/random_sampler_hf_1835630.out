    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `start`
    # to a cell adjacent (Manhattan distance 1) to any of `targets`.
    # Cells with any non‑zero kind are treated as obstacles.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where blocked
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path
            # Explore neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable position – return empty list
        return []

    # ------------------------------------------------------------------
    # Retrieve world, cookbook and goal information (hard‑coded to "arrow")
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if needed)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    grid = state.grid               # (W, H, n_kinds)

    actions = []
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells currently holding this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Greedy nearest‑first ordering
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive
            path = _bfs_path(pos, [loc])
            actions.extend(path)
            # Update simulated position
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick it up
            actions.append(USE)
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its workshop (if the recipe specifies one)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be name or integer)
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str) else workshop_key)
        # Locate workshop cells
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft using the workshop
            actions.append(USE)

    return actions


