    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """Return True if the cell at `pos` contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    from collections import deque

    def bfs_path(start, goal):
        """Shortest walkable path (list of positions) from start to goal inclusive."""
        if start == goal:
            return [start]
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y-1, x), (y+1, x), (y, x-1), (y, x+1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            return []  # unreachable

        # reconstruct path
        path = []
        cur = goal
        while cur is not None:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Translate a list of positions into movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the nearest cell containing `kind` (Manhattan distance)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of `target`; if none, return `target` itself."""
        y, x = target
        for ny, nx in ((y-1, x), (y+1, x), (y, x-1), (y, x+1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target

