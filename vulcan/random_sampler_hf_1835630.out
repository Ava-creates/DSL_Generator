    # ------------------------------------------------------------------
    # Action constants (matching CraftWorld definitions)
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: move position according to an action (assumes move succeeds)
    # ------------------------------------------------------------------
    def _move(pos, act):
        x, y = pos
        if act == RIGHT:
            return (x + 1, y)
        if act == LEFT:
            return (x - 1, y)
        if act == DOWN:
            return (x, y + 1)
        if act == UP:
            return (x, y - 1)
        return pos

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions leading to a cell
    # adjacent to any target location (target cells may be occupied).
    # Also returns the final adjacent position.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        from collections import deque
        w, h = occupied.shape
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path, (x, y)
            # explore neighbours
            for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),
                                  (DOWN, (0, 1)), (UP, (0, -1))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no reachable adjacent cell
        return [], start

    # ------------------------------------------------------------------
    # Retrieve world and cookbook objects
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal: make an "arrow"
    # ------------------------------------------------------------------
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    direction = int(state.dir)      # current facing direction
    grid = state.grid               # (W, H, n_kinds)

    # We'll work on a mutable copy of the grid to reflect collected items
    mutable_grid = np.copy(grid)

    actions = []

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # locate remaining instances of this primitive
            locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]
            if not locations:
                # no more primitives of this type – break to avoid infinite loop
                break
            # pick the closest one
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locations[0]

            # occupied cells for path‑finding (ignore the target itself – it is blocked)
            occupied = np.any(mutable_grid > 0, axis=2)

            # find path to a free cell adjacent to the target
            path, pos = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # update position following the path
            for act in path:
                pos = _move(pos, act)
                direction = act

            # determine which direction we must face to interact with the target
            tx, ty = target
            needed_dir = None
            if tx > pos[0]:
                needed_dir = RIGHT
            elif tx < pos[0]:
                needed_dir = LEFT
            elif ty > pos[1]:
                needed_dir = DOWN
            elif ty < pos[1]:
                needed_dir = UP

            # adjust facing direction if necessary (a single turn action suffices)
            if needed_dir is not None and direction != needed_dir:
                actions.append(needed_dir)
                direction = needed_dir

            # pick up the primitive
            actions.append(USE)
            gathered += 1

            # mark the cell as empty in our mutable copy
            mutable_grid[tx, ty, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if the recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (may be a string name)
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else workshop_key)

        # locate workshop cells (they are not consumable, so we keep the original grid)
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = workshop_cells[0]

            occupied = np.any(mutable_grid > 0, axis=2)
            path, pos = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)

            for act in path:
                pos = _move(pos, act)
                direction = act

            # face the workshop
            wx, wy = ws_target
            needed_dir = None
            if wx > pos[0]:
                needed_dir = RIGHT
            elif wx < pos[0]:
                needed_dir = LEFT
            elif wy > pos[1]:
                needed_dir = DOWN
            elif wy < pos[1]:
                needed_dir = UP

            if needed_dir is not None and direction != needed_dir:
                actions.append(needed_dir)
                direction = needed_dir

            # craft the arrow
            actions.append(USE)

    # ------------------------------------------------------------------
    # Return the complete action list
    # ------------------------------------------------------------------
    return actions


    # ----------------------------------------------------------------------
    # Basic movement helper: returns new position and updates direction.
    # ----------------------------------------------------------------------
    def _step(pos, direction, act):
        x, y = pos
        # movement vectors
        if act == 0:   # DOWN
            dx, dy = 0, 1
        elif act == 1:  # UP
            dx, dy = 0, -1
        elif act == 2:  # LEFT
            dx, dy = -1, 0
        elif act == 3:  # RIGHT
            dx, dy = 1, 0
        else:  # USE does not change position
            return pos, act
        nx, ny = x + dx, y + dy
        # check bounds and blockage
        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and not occupied[nx, ny]:
            return (nx, ny), act
        else:
            # cannot move, but direction still becomes act
            return pos, act

    # ----------------------------------------------------------------------
    # BFS that returns a list of actions moving the agent to a cell that is
    # orthogonally adjacent to any of the target positions.
    # ----------------------------------------------------------------------
    def _bfs_adj(start, targets):
        w, h, _ = grid.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # if adjacent to a target, stop
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path, (x, y)
            # explore neighbours
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # fallback: stay where we are
        return [], start

    # ----------------------------------------------------------------------
    # Retrieve world, cookbook and goal information.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Ensure we have a current state (reset if needed) and extract data.
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state
    pos = tuple(state.pos)
    direction = int(state.dir)
    grid = state.grid
    occupied = np.any(grid > 0, axis=2)

    actions = []

    # ----------------------------------------------------------------------
    # Collect each required primitive.
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # locate all cells containing this primitive
        prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from current position
        prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in prim_cells:
            if collected >= needed:
                break
            # move adjacent to the primitive
            path, pos = _bfs_adj(pos, [cell])
            actions.extend(path)
            for act in path:
                pos, direction = _step(pos, direction, act)

            # determine direction needed to face the primitive
            dx = cell[0] - pos[0]
            dy = cell[1] - pos[1]
            needed_dir = None
            if dx == 1:
                needed_dir = 3          # RIGHT
            elif dx == -1:
                needed_dir = 2          # LEFT
            elif dy == 1:
                needed_dir = 0          # DOWN
            elif dy == -1:
                needed_dir = 1          # UP

            if needed_dir is not None and direction != needed_dir:
                # turn by attempting a move in the desired direction;
                # if the cell ahead is blocked the position stays but direction changes
                actions.append(needed_dir)
                pos, direction = _step(pos, direction, needed_dir)

            # pick up the primitive
            actions.append(4)  # USE
            collected += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = workshop_cells[0]
            path, pos = _bfs_adj(pos, [target_ws])
            actions.extend(path)
            for act in path:
                pos, direction = _step(pos, direction, act)

            # face the workshop
            dx = target_ws[0] - pos[0]
            dy = target_ws[1] - pos[1]
            needed_dir = None
            if dx == 1:
                needed_dir = 3
            elif dx == -1:
                needed_dir = 2
            elif dy == 1:
                needed_dir = 0
            elif dy == -1:
                needed_dir = 1
            if needed_dir is not None and direction != needed_dir:
                actions.append(needed_dir)
                pos, direction = _step(pos, direction, needed_dir)

            # craft using the workshop
            actions.append(4)  # USE

    return actions

