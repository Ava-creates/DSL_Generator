    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Direction / action maps (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)
    # ----------------------------------------------------------------------
    DIR_TO_ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search: move from ``start`` to a cell adjacent (Manhattan‑1)
    # to any cell in ``targets`` while avoiding blocked cells.
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, targets, grid, blocked_mask):
        """
        Returns a list of actions that brings the agent from ``start`` to a
        position adjacent to any coordinate in ``targets``. ``blocked_mask`` is
        a 2‑D boolean array where True indicates an impassable cell.
        """
        W, H = grid.shape[:2]
        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked_mask[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Initialise environment and extract goal.
    # ----------------------------------------------------------------------
    obs = env.reset()
    state = env._current_state
    grid = state.grid.copy()                     # mutable copy for simulation
    pos = tuple(state.pos)                       # (x, y)

    # Goal index stored in the task (env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # ----------------------------------------------------------------------
    # Determine primitive requirements for the goal.
    # ----------------------------------------------------------------------
    needed_primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # Build a mask of cells that are permanently blocked (non‑grabbable entities)
    # and also any cell currently occupied by any object.
    def compute_blocked(g):
        # Any non‑zero entry in the last dimension blocks movement.
        return np.any(g > 0, axis=2)

    # ----------------------------------------------------------------------
    # 1. Collect required primitives.
    # ----------------------------------------------------------------------
    for prim_idx, count in needed_primitives.items():
        while count > 0:
            # Locate all cells that still contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present – abort planning.
                return plan

            blocked = compute_blocked(grid)
            path = bfs_adjacent(pos, prim_cells.tolist(), grid, blocked)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(4)   # USE

            # Find which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected – break to avoid infinite loop.
                break

            # Update simulated grid and remaining need.
            grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
            count -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get('_at') or recipe.get('_key')
    if workshop_key is not None:
        # Resolve workshop index (string name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            blocked = compute_blocked(grid)
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked)
            plan.extend(path)

            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(4)   # USE

    return plan

