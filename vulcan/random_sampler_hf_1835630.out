    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        # combine position, direction, inventory tuple and grid bytes
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(start_state)}
    frontier = deque([Node(start_state, [])])

    MAX_STEPS = 300
    n_actions = getattr(world, "n_actions", 5)

    # Optional primitive requirement map for simple pruning
    try:
        primitive_req = world.cookbook.primitives_for(target_idx)
    except Exception:
        primitive_req = {}

    while frontier:
        node = frontier.popleft()
        state = node.state

        # Goal test
        if state.satisfies("", target_idx):
            return node.actions

        # Depth limit
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand
        for a in range(n_actions):
            _, nxt = state.step(a)
            h = _state_hash(nxt)
            if h in visited:
                continue

            # Simple pruning: if we already have more of any primitive than needed
            if primitive_req:
                inv = nxt.inventory
                over = False
                for prim_idx, need in primitive_req.items():
                    if inv[prim_idx] > need:
                        over = True
                        break
                if over:
                    # allow if we also already have the target (checked above)
                    # otherwise discard this branch
                    continue

            visited.add(h)
            frontier.append(Node(nxt, node.actions + [a]))

    # No plan found
    return []


    # Retrieve the scenario and world objects
    scenario = getattr(env, "scenario", env)
