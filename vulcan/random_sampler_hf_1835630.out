    # Reset environment and initialize variables
    env.reset()
    actions = []
    act_map = env.action_specs()                     # e.g. {'DOWN':0, 'UP':1, ...}
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving the agent
    # from `start` to a cell adjacent (including diagonal) to any cell in
    # `targets`.  It only walks through empty cells.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, targets, grid):
        W, H = grid.shape[:2]
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # Check adjacency to any target cell
            for tx, ty in target_set:
                if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:
                    return path

            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H:
                    # Only walk through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    # ------------------------------------------------------------------
    # Retrieve goal information and required primitives
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Locate all cells that currently contain the needed primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Primitive not present – skip this instance
                continue

            # Plan a path to an adjacent cell of the nearest primitive
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # Unreachable primitive – skip
                continue

            # Execute movement actions
            for act_name in path:
                a = act_map[act_name]
                actions.append(a)
                env.step(a)

            # Use action to pick up the primitive
            actions.append(act_map["USE"])
            env.step(act_map["USE"])

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    a = act_map[act_name]
                    actions.append(a)
                    env.step(a)

            # Use action at the workshop to craft the item
            actions.append(act_map["USE"])
            env.step(act_map["USE"])

    # Return the computed action sequence
    return actions

