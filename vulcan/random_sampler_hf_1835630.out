    import numpy as np
    from collections import deque

    # Helper: map direction constants to movement deltas
    DIRS = {
        env.DOWN: (0, 1),
        env.UP:   (0, -1),
        env.LEFT: (-1, 0),
        env.RIGHT:(1, 0),
    }

    def bfs_path(start, goal, blocked):
        """Return list of direction actions to move from start to goal avoiding blocked cells."""
        w, h = blocked.shape
        visited = np.full((w, h), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        while q:
            (x, y), path = q.popleft()
            if (x, y) == goal:
                return path
            for a, (dx, dy) in DIRS.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny] and not blocked[nx, ny]:
                    visited[nx, ny] = True
                    q.append(((nx, ny), path + [a]))
        raise RuntimeError("No path found")

    # ------------------------------------------------------------------
    # 1. Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    state = env._current_state
    world = state.world
    cb = world.cookbook

    arrow_idx = cb.index["arrow"]
    # primitive requirements for one arrow
    prim_req = cb.primitives_for(arrow_idx).copy()   # {prim_idx: count}

    actions = []

    # ------------------------------------------------------------------
    # 2. Collect each required primitive
    # ------------------------------------------------------------------
    while any(cnt > 0 for cnt in prim_req.values()):
        # recompute blocked cells (any non‑zero in any channel)
        blocked = np.any(state.grid > 0, axis=2)

        # find a primitive we still need
        needed_idx = None
        for k, v in prim_req.items():
            if v > 0:
                needed_idx = k
                break
        # locate all cells containing that primitive
        prim_cells = np.argwhere(state.grid[:, :, needed_idx] > 0)
        if prim_cells.size == 0:
            raise RuntimeError("Required primitive not present in the world")

        # pick the first occurrence
        px, py = prim_cells[0]

        # find a free neighbour of that cell to stand on
        neighbour = None
        for dx, dy in DIRS.values():
            nx, ny = px + dx, py + dy
            if (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]
                    and not blocked[nx, ny]):
                neighbour = (nx, ny)
                break
        if neighbour is None:
            raise RuntimeError("No free neighbour to reach primitive")

        # plan path to the neighbour
        path = bfs_path(state.pos, neighbour, blocked)
        for a in path:
            reward, new_state = env.step(a)
            state = new_state
            actions.append(a)

        # now we are adjacent and facing the primitive (last move direction points to it)
        # perform USE to pick it up
        reward, new_state = env.step(env.USE)
        state = new_state
        actions.append(env.USE)

        # update bookkeeping
        prim_req[needed_idx] -= 1

    # ------------------------------------------------------------------
    # 3. Craft the arrow at its workshop
    # ------------------------------------------------------------------
    # workshop index is stored under the special key "_at" in the recipe
    wk_idx = cb.recipes[arrow_idx]["_at"]
    wk_cells = np.argwhere(state.grid[:, :, wk_idx] > 0)
    if wk_cells.size == 0:
        raise RuntimeError("No workshop for arrow found")
    wx, wy = wk_cells[0]

    # find free neighbour of the workshop
    blocked = np.any(state.grid > 0, axis=2)
    wk_neighbour = None
    for dx, dy in DIRS.values():
        nx, ny = wx + dx, wy + dy
        if (0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]
                and not blocked[nx, ny]):
            wk_neighbour = (nx, ny)
            break
    if wk_neighbour is None:
        raise RuntimeError("No free neighbour to reach workshop")

    # move to that neighbour
    path = bfs_path(state.pos, wk_neighbour, blocked)
    for a in path:
        reward, new_state = env.step(a)
        state = new_state
        actions.append(a)

    # use the workshop to craft the arrow
    reward, new_state = env.step(env.USE)
    state = new_state
    actions.append(env.USE)

    # return the complete action list
    return actions


# Initialize a list to store the sequence of actions
actions = []

# Helper function to move the agent to a target position using simple Manhattan moves
def move_to(target_pos):
    while env.state.pos != target_pos:
        cur_x, cur_y = env.state.pos
        tgt_x, tgt_y = target_pos
        if cur_x < tgt_x:
            actions.append(env.actions.RIGHT)
            env.step(env.actions.RIGHT)
        elif cur_x > tgt_x:
            actions.append(env.actions.LEFT)
            env.step(env.actions.LEFT)
        elif cur_y < tgt_y:
            actions.append(env.actions.DOWN)
            env.step(env.actions.DOWN)
        elif cur_y > tgt_y:
            actions.append(env.actions.UP)
            env.step(env.actions.UP)

# Helper function to collect a primitive at a given location
def collect_at(pos):
    move_to(pos)
    # Face the cell (no rotation needed in this simplified version)
    actions.append(env.actions.USE)
    env.step(env.actions.USE)

# Determine the recipe for the arrow item
arrow_index = env.world.cookbook.index["arrow"]
recipe = env.world.cookbook.recipes.get(arrow_index, {})

# Gather all required primitives and their counts
required = {}
for ingredient, count in recipe.items():
    if ingredient == "_key":
        continue
    required[ingredient] = required.get(ingredient, 0) + count

# Locate each primitive on the grid and collect the needed amount
for prim_idx, needed in required.items():
    prim_name = env.world.cookbook.index.get(prim_idx)
    # Find all cells containing this primitive
    positions = list(zip(*np.where(env.state.grid[:, :, prim_idx] > 0)))
    collected = 0
    for pos in positions:
        if collected >= needed:
            break
        collect_at(pos)
        collected += 1

# After collecting all primitives, move to the appropriate workshop to craft the arrow
workshop_idx = recipe.get("_at")
if workshop_idx is not None:
    # Find the workshop location
    workshop_positions = list(zip(*np.where(env.state.grid[:, :, workshop_idx] > 0)))
    if workshop_positions:
        move_to(workshop_positions[0])

# Perform the craft action
actions.append(env.actions.USE)
env.step(env.actions.USE)

# Return the compiled list of actions
actions

