    # Obtain scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_state_hash(init_state))

    # Upper bound on plan length to keep search tractable
    MAX_PLAN_LEN = 2000
    n_actions = getattr(world, "n_actions", 5)  # typically 4 moves + USE

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Do not expand overly long trajectories
        if len(node.actions) >= MAX_PLAN_LEN:
            continue

        # Expand all possible actions from the current state
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No solution found within the search budget
    return []


