    # --------------------------------------------------------------
    # Helper functions
    # --------------------------------------------------------------
    from collections import deque

    # movement vectors and corresponding action indices (as defined in CraftLab)
    _DIRS = [(0, -1), (0, 1), (-1, 0), (1, 0)]          # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    _ACTION_USE = 4

    def _bfs_path(grid_occ, start, goal):
        """Return list of positions from start (inclusive) to goal (inclusive)
        using 4‑connected Manhattan moves, avoiding occupied cells."""
        if start == goal:
            return [start]
        W, H = grid_occ.shape
        q = deque([start])
        prev = {start: None}
        while q:
            x, y = q.popleft()
            for dx, dy in _DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in prev:
                    if not grid_occ[nx, ny]:          # free cell
                        prev[(nx, ny)] = (x, y)
                        if (nx, ny) == goal:
                            # reconstruct path
                            path = [(nx, ny)]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append((nx, ny))
        raise RuntimeError("No path found")

    def _pos_to_actions(path):
        """Convert a list of positions (len>=2) into action indices."""
        actions = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            dx, dy = x1 - x0, y1 - y0
            for a, (vx, vy) in enumerate(_DIRS):
                if (dx, dy) == (vx, vy):
                    actions.append(a)
                    break
        return actions

    # --------------------------------------------------------------
    # Initialise environment and fetch problem data
    # --------------------------------------------------------------
    # reset the environment to get a clean start
    env.reset()
    state = env._current_state          # underlying CraftState
    world = state.world                 # CraftWorld instance
    goal_idx = env.task.goal            # integer index of the desired item

    # recipe for the goal
    recipe = world.cookbook.recipes[goal_idx]
    workshop_kind = recipe["_at"]
    ingredients = {k: v for k, v in recipe.items() if k != "_at"}

    # ----------------------------------------------------------------
    # Main planning loop
    # ----------------------------------------------------------------
    actions_plan = []

    # helper to update local copies after each action batch
    def _apply_actions(seq):
        nonlocal state, actions_plan
        for a in seq:
            _, done, _ = env.step(a)
            actions_plan.append(a)
            state = env._current_state
            if done:
                return True
        return False

    # ----------------------------------------------------------------
    # Collect required primitives (or intermediate items) greedily
    # ----------------------------------------------------------------
    # we will keep collecting until the inventory contains enough of each
    # required ingredient.
    while True:
        # check if we already have enough of each ingredient
        have_all = True
        for kind, cnt in ingredients.items():
            if state.inventory[kind] < cnt:
                have_all = False
                needed_kind = kind
                break
        if have_all:
            break

        # locate any instance of the needed kind on the grid
        occ = (state.grid[:, :, needed_kind] > 0)
        positions = np.argwhere(occ)
        if positions.size == 0:
            raise RuntimeError("Required item not present on the map")

        # pick the closest one (Manhattan distance)
        cur_x, cur_y = state.pos
        dists = np.abs(positions[:, 0] - cur_x) + np.abs(positions[:, 1] - cur_y)
        target_idx = int(np.argmin(dists))
        tx, ty = positions[target_idx]

        # Find a free neighbour from which we can face the target.
        # We try the four directions; the neighbour is the cell opposite to
        # the facing direction.
        neighbour = None
        approach_dir = None
        for a, (dx, dy) in enumerate(_DIRS):
            nx, ny = tx - dx, ty - dy          # cell we would stand on
            if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:
                if not state.grid[nx, ny].any():   # free cell
                    neighbour = (nx, ny)
                    approach_dir = a
                    break
        if neighbour is None:
            raise RuntimeError("No free neighbour to reach item")

        # compute occupancy map for path‑finding (ignore the target cell itself)
        occ_map = state.grid.sum(axis=2) > 0
        # make sure the start cell is considered free
        occ_map[state.pos[0], state.pos[1]] = False

        # plan path to the neighbour
        path = _bfs_path(occ_map, state.pos, neighbour)
        move_actions = _pos_to_actions(path)

        # after the last move we will be facing the target (by construction)
        # so a single USE action picks it up.
        seq = move_actions + [_ACTION_USE]
        if _apply_actions(seq):
            return actions_plan   # episode finished early (unlikely)

    # ----------------------------------------------------------------
    # Move to the workshop and craft the goal item
    # ----------------------------------------------------------------
    # locate a workshop cell of the required type
    workshop_occ = (state.grid[:, :, workshop_kind] > 0)
    workshop_positions = np.argwhere(workshop_occ)
    if workshop_positions.size == 0:
        raise RuntimeError("Workshop for goal not found")
    # choose the closest
    cur_x, cur_y = state.pos
    dists = np.abs(workshop_positions[:, 0] - cur_x) + np.abs(workshop_positions[:, 1] - cur_y)
    w_idx = int(np.argmin(dists))
    wx, wy = workshop_positions[w_idx]

    # Find a free neighbour to stand on (same logic as above)
    neighbour = None
    for a, (dx, dy) in enumerate(_DIRS):
        nx, ny = wx - dx, wy - dy
        if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:
            if not state.grid[nx, ny].any():
                neighbour = (nx, ny)
                break
    if neighbour is None:
        raise RuntimeError("No free neighbour near workshop")

    # path to neighbour
    occ_map = state.grid.sum(axis=2) > 0
    occ_map[state.pos[0], state.pos[1]] = False
    path = _bfs_path(occ_map, state.pos, neighbour)
    move_actions = _pos_to_actions(path)

    # USE at the workshop to craft
    seq = move_actions + [_ACTION_USE]
    _apply_actions(seq)

    # Return the full list of actions
    return actions_plan

