    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # helper: locate the nearest cell (Manhattan) containing a given kind
    # ------------------------------------------------------------------
    def _find_nearest(grid, kind_idx, start_pos):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start_pos[0]) + abs(j - start_pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # helper: locate any cell containing a given kind (e.g., workshop)
    # ------------------------------------------------------------------
    def _find_any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # helper: generate a simple Manhattan path (list of actions)
    # ------------------------------------------------------------------
    def _path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # ------------------------------------------------------------------
    # identify the goal item (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:                   # unknown goal
        return []

    # ------------------------------------------------------------------
    # primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # collect each required primitive (respecting required counts)
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:            # primitive missing – abort
                return action_seq
            # move to the primitive location
            for a in _path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # if a workshop is required, go there and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)

    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # craft at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    return action_seq


    # ------------------------------------------------------------------
    # helpers
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    ACTIONS = {(1, 0): DOWN, (-1, 0): UP, (0, 1): RIGHT, (0, -1): LEFT}

    def _nearest(grid, kind, pos):
        """Manhattan nearest cell containing *kind*."""
        h, w, _ = grid.shape
        best, best_d = None, None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind] > 0:
                    d = abs(i - pos[0]) + abs(j - pos[1])
                    if best_d is None or d < best_d:
                        best, best_d = (i, j), d
        return best

    def _any(grid, kind):
        """First cell containing *kind* (used for workshops)."""
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind] > 0:
                    return (i, j)
        return None

    def _manhattan_path(src, dst):
        """Straight‑line Manhattan actions from src to dst."""
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN); r += 1
            else:
                actions.append(UP);   r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT); c += 1
            else:
                actions.append(LEFT);  c -= 1
        return actions

    # ------------------------------------------------------------------
    # initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # ------------------------------------------------------------------
    # goal identification (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # arrow not defined in this world
        return []

    # ------------------------------------------------------------------
    # primitive requirements for ONE arrow
    # ------------------------------------------------------------------
    needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # collect required primitives
    # ------------------------------------------------------------------
    for kind, cnt in needs.items():
        for _ in range(cnt):
            tgt = _nearest(state.grid, kind, state.pos)
            if tgt is None:                     # missing primitive – abort
                return plan
            # move to the primitive cell
            for a in _manhattan_path(state.pos, tgt):
                reward, done, obs = env.step(a)
                state = env._current_state
                plan.append(a)
                if done:
                    return plan
            # pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            plan.append(USE)
            if done:
                return plan

    # ------------------------------------------------------------------
    # if a workshop is required, go there and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        wk_idx = world.cookbook.index.index(workshop_name)
        wk_pos = _any(state.grid, wk_idx)
        if wk_pos is not None:
            for a in _manhattan_path(state.pos, wk_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                plan.append(a)
                if done:
                    return plan
            # craft / use at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            plan.append(USE)

    return plan

