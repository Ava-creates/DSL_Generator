    import collections
    import numpy as np

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec["DOWN"]
    UP = spec["UP"]
    LEFT = spec["LEFT"]
    RIGHT = spec["RIGHT"]
    USE = spec["USE"]

    def _delta_to_action(dx, dy):
        """Convert a grid delta into the corresponding movement action."""
        if dx == 1:
            return DOWN
        if dx == -1:
            return UP
        if dy == 1:
            return RIGHT
        if dy == -1:
            return LEFT
        raise ValueError("Invalid delta for movement")

    def _bfs_path(start, goal, grid):
        """
        Bread‑first search on the occupancy grid.
        Cells where any kind > 0 are considered blocked,
        except the goal cell itself which is allowed.
        Returns a list of positions from start to goal (inclusive).
        """
        width, height = grid.shape[:2]
        occupied = np.any(grid > 0, axis=2)

        # allow stepping onto the goal cell even if occupied
        occupied[goal[0], goal[1]] = False

        q = collections.deque()
        q.append(start)
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            x, y = cur
            for nx, ny in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):
                if 0 <= nx < width and 0 <= ny < height:
                    if not occupied[nx, ny] and (nx, ny) not in came_from:
                        came_from[(nx, ny)] = cur
                        q.append((nx, ny))
        else:
            # no path found
            return []

        # reconstruct path
        path = []
        cur = goal
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []

    # goal index for the current task
    goal_idx = env.task.goal

    # primitive requirements for the goal
    needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # current state snapshot
    state = env._current_state
    cur_pos = tuple(state.pos)  # (x, y)
    grid = state.grid

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # locate all cells that currently contain this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # no more of this primitive on the map – abort planning
                break

            # pick the nearest one (Manhattan distance as heuristic)
            distances = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in prim_cells]
            target = prim_cells[int(np.argmin(distances))]

            # compute a path to the target cell
            path = _bfs_path(cur_pos, target, grid)
            if not path:
                # fallback to direct Manhattan moves if BFS fails
                dx = target[0] - cur_pos[0]
                dy = target[1] - cur_pos[1]
                while dx != 0:
                    actions.append(DOWN if dx > 0 else UP)
                    dx += -1 if dx > 0 else 1
                while dy != 0:
                    actions.append(RIGHT if dy > 0 else LEFT)
                    dy += -1 if dy > 0 else 1
            else:
                # translate path steps into actions (skip the first cell – current pos)
                for nxt in path[1:]:
                    act = _delta_to_action(nxt[0] - cur_pos[0], nxt[1] - cur_pos[1])
                    actions.append(act)
                    cur_pos = nxt

            # now we are on the primitive cell; pick it up
            actions.append(USE)

            # update local grid snapshot to reflect that the primitive has been taken
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the appropriate workshop and craft the item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if workshop_cells:
            # choose the nearest workshop
            distances = [
                abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in workshop_cells
            ]
            target_ws = workshop_cells[int(np.argmin(distances))]

            path = _bfs_path(cur_pos, target_ws, grid)
            if not path:
                dx = target_ws[0] - cur_pos[0]
                dy = target_ws[1] - cur_pos[1]
                while dx != 0:
                    actions.append(DOWN if dx > 0 else UP)
                    dx += -1 if dx > 0 else 1
                while dy != 0:
                    actions.append(RIGHT if dy > 0 else LEFT)
                    dy += -1 if dy > 0 else 1
            else:
                for nxt in path[1:]:
                    act = _delta_to_action(nxt[0] - cur_pos[0], nxt[1] - cur_pos[1])
                    actions.append(act)
                    cur_pos = nxt

            # perform the crafting action
            actions.append(USE)

    return actions


    actions = []
    state = env._current_state
    pos = tuple(state.pos)

    spec = env.action_specs()
    DOWN = spec['DOWN']
    UP = spec['UP']
    LEFT = spec['LEFT']
    RIGHT = spec['RIGHT']
    USE = spec['USE']

    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}

    # Work on a mutable copy of the grid so we can “remove” items as we pick them up.
    grid = state.grid.copy()

    def _move_actions(cur, tgt):
        """Return a list of movement actions to go from cur to tgt using Manhattan steps."""
        moves = []
        dx = tgt[0] - cur[0]
        dy = tgt[1] - cur[1]
        while dx != 0:
            if dx > 0:
                moves.append(DOWN)
                dx -= 1
            else:
                moves.append(UP)
                dx += 1
        while dy != 0:
            if dy > 0:
                moves.append(RIGHT)
                dy -= 1
            else:
                moves.append(LEFT)
                dy += 1
        return moves

    # Collect each required primitive the needed number of times.
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                break  # No more of this primitive on the map.
            # Choose the closest occurrence (Manhattan distance).
            target = min(locations,
                         key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            actions.extend(_move_actions(pos, target))
            pos = target
            actions.append(USE)
            # Simulate picking up the item.
            grid[pos[0], pos[1], prim_idx] = 0

    # After gathering primitives, go to the appropriate workshop and craft.
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target = ws_locs[0]
            actions.extend(_move_actions(pos, target))
            actions.append(USE)

    return actions

