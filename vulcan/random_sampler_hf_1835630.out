                elif a == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif a == UP:
                    pos = (pos[0], pos[1] - 1)
        # finally use to craft
        actions.append(USE)
    else:
        # no specific workshop, just use at current location
        actions.append(USE)

    return actions

