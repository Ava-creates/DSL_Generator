    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, avoid=collected_cells)
            if ws_adj is None:
                ws_adj = ws_cell
                if is_blocked(*ws_adj):
                    # Cannot reach workshop; abort.
                    return actions
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj
            # Face the workshop cell.
            dy = ws_cell[0] - cur_pos[0]
            dx = ws_cell[1] - cur_pos[1]
            if dy > 0:
                actions.append(DOWN)
            elif dy < 0:
                actions.append(UP)
            elif dx > 0:
                actions.append(RIGHT)
            elif dx < 0:
                actions.append(LEFT)

    # Finally, trigger the crafting action.
    actions.append(USE)

    return actions


