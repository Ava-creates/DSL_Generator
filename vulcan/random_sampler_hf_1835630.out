    import collections, numpy as np

    # Action constants (match CraftWorld definitions)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that stops when we are orthogonally adjacent to any target.
    # Returns a list of actions to reach such a cell (empty list if already adjacent).
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # if we are orthogonally adjacent to a target cell, stop
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # explore neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:          # can walk only on empty cells
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # no reachable adjacent cell (should not happen in valid maps)

    # ------------------------------------------------------------------
    # Helper: apply a sequence of actions to a position.
    # ------------------------------------------------------------------
    def _apply(pos, actions):
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate the world and its cookbook inside the provided env object.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # some wrappers expose the state directly
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal information.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for the goal (primitive_index -> count).
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Planning structures.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # current (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    occ = np.any(grid, axis=2)                 # occupied mask (bool)

    plan_actions = []                          # final action list
    harvested = set()                          # cells already collected from

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # locate all cells that currently contain this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from the current position (greedy)
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed_cnt:
                break
            if cell in harvested:
                continue
            # move adjacent to the primitive
            path = _bfs_adjacent(pos, [cell], occ)
            plan_actions.extend(path)
            pos = _apply(pos, path)

            # pick it up
            plan_actions.append(USE)

            # update planning structures: primitive disappears, cell becomes free
            grid[cell[0], cell[1], prim_idx] = 0
            occ = np.any(grid, axis=2)
            harvested.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # workshop may be given as a string name or directly as an index
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_adjacent(pos, [target_ws], occ)
            plan_actions.extend(path)
            pos = _apply(pos, path)
            plan_actions.append(USE)          # craft at the workshop
        else:
            # workshop not visible – attempt crafting at current location
            plan_actions.append(USE)
    else:
        # No specific workshop required; craft wherever we are.
        plan_actions.append(USE)

    return plan_actions

