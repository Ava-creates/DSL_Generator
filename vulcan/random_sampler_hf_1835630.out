    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # target item index
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # required primitive counts for one arrow
    required_prims = world.cookbook.primitives_for(target_idx)

    # initial state
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import namedtuple
    import heapq

    Node = namedtuple("Node", ["state", "actions", "cost"])

    def _state_hash(st):
        """Hashable representation for visited set."""
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    def _heuristic(st):
        """Estimate remaining steps: sum of missing primitive counts."""
        missing = 0
        inv = st.inventory
        for prim_idx, cnt in required_prims.items():
            have = inv[prim_idx] if prim_idx < len(inv) else 0
            if have < cnt:
                missing += cnt - have
        # add one for the final crafting action
        return missing + 1

    visited = set()
    start_node = Node(init_state, [], 0)
    heap = [( _heuristic(init_state), start_node )]
    visited.add(_state_hash(init_state))

    MAX_EXPANSIONS = 20000
    expansions = 0
    n_actions = getattr(world, "n_actions", 5)

    while heap:
        _, node = heapq.heappop(heap)
        cur_state = node.state

        # goal test
        if cur_state.satisfies("", target_idx):
            return node.actions

        if expansions >= MAX_EXPANSIONS:
            break
        expansions += 1

        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h in visited:
                continue
            visited.add(h)
            g = node.cost + 1
            f = g + _heuristic(nxt_state)
            heapq.heappush(heap, (f, Node(nxt_state, node.actions + [a], g)))

    # fallback: no plan found within limits
    return []


