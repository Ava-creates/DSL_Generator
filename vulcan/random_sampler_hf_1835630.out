    # Resolve scenario and world objects (compatible with CraftLab or raw CraftScenario)
    scenario = getattr(env, "scenario", None) or env
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # Index of the target item “arrow”; abort if not present in the cookbook
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Obtain the initial state of the episode; abort on failure
    try:
        start_state = scenario.init()
    except Exception:
        return []

    # Helper: produce a hashable representation of a state for visited‑state tracking
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    from collections import deque, namedtuple
    Node = namedtuple("Node", ["state", "actions"])

    visited = {_state_hash(start_state)}
    frontier = deque([Node(start_state, [])])

    # Search limits – keep planning tractable while allowing reasonable plans
    MAX_STEPS = 400
    n_actions = getattr(world, "n_actions", 5)  # default action space size (0‑4)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: arrow present in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible primitive actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No viable plan found within the search budget
    return []


    # Retrieve scenario and world objects from the environment
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state of the episode
    try:
        start_state = scenario.init()
    except Exception:
        return []

    # Helper: hash a state for visited‑set checking
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    from collections import deque, namedtuple
    Node = namedtuple("Node", ["state", "actions"])

    visited = {_state_hash(start_state)}
    frontier = deque([Node(start_state, [])])

    # Search limits
    MAX_STEPS = 500                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # default action space size

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the search budget
    return []

