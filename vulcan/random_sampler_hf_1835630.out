    import numpy as np
    from collections import deque

    # Reset environment and get core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)
    H, W = grid.shape[:2]

    # Action indices
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding non‑grabbable cells."""
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                actions_rev = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    if py + 1 == cur[0]:
                        actions_rev.append(DOWN)
                    elif py - 1 == cur[0]:
                        actions_rev.append(UP)
                    elif px + 1 == cur[1]:
                        actions_rev.append(RIGHT)
                    elif px - 1 == cur[1]:
                        actions_rev.append(LEFT)
                    cur = (py, px)
                actions_rev.reverse()
                return actions_rev

            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # blocked if any non‑grabbable entity occupies the cell
                    if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list (should not happen in valid scenarios)
        return []

    def find_nearest(kind, from_pos):
        """Find the nearest cell that contains ``kind`` (primitive or workshop)."""
        locations = np.argwhere(grid[:, :, kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = int(np.argmin(dists))
        return tuple(locations[nearest_idx])

    # ------------------------------------------------------------------
    # Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early
                return actions

            # Move to the primitive cell
            actions += bfs_path(cur_pos, target)
            cur_pos = target

            # Pick up the primitive
            actions.append(USE)

            # Remove the primitive from our local copy of the grid so we don't
            # try to collect it again.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)
    H, W = grid.shape[:2]

    # Action indices (fallback to default ordering if specs missing)
    specs = env.action_specs()
    DOWN = specs.get("DOWN", 0)
    UP = specs.get("UP", 1)
    LEFT = specs.get("LEFT", 2)
    RIGHT = specs.get("RIGHT", 3)
    USE = specs.get("USE", 4)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding non‑grabbable
        obstacles. If no path is found, fall back to Manhattan moves."""
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                actions_rev = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        actions_rev.append(DOWN)
                    elif py == cur[0] + 1:
                        actions_rev.append(UP)
                    elif px == cur[1] - 1:
                        actions_rev.append(RIGHT)
                    elif px == cur[1] + 1:
                        actions_rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(actions_rev))

            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # blocked if any non‑grabbable entity occupies the cell
                    if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))

        # No path found – use simple Manhattan moves (may hit obstacles)
        y0, x0 = start
        y1, x1 = goal
        actions = []
        dy = y1 - y0
        dx = x1 - x0
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind, from_pos):
        """Find the nearest cell containing ``kind`` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest_idx = int(np.argmin(dists))
        return tuple(locs[nearest_idx])

    # ------------------------------------------------------------------
    # Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early
                return actions

            ty, tx = target

            # Choose a free adjacent cell to stand on before using
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < H and 0 <= nx < W:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; fallback to standing on the primitive cell itself
                adj = (ty, tx)

            # Move to the adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (add a movement action that would step into it)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions

