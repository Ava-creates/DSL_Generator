    # ----------------------------------------------------------------------
    # Setup: obtain scenario, world and the index of the target item “arrow”.
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:                     # arrow not present in this world
        return []

    try:
        init_state = scenario.init()
    except Exception:                     # cannot initialise the episode
        return []

    # ----------------------------------------------------------------------
    # BFS planner – each node stores a CraftState and the list of actions that
    # lead to it.  We hash a state by position, direction, inventory contents and
    # the full grid layout (bytes).  This is sufficient to avoid revisiting
    # identical configurations while keeping the search deterministic.
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _hash_state(st):
        # Use immutable representations for hashing.
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_hash_state(init_state)}
    frontier = deque([Node(init_state, [])])

    # Upper bound on plan length – prevents infinite loops in pathological
    # maps.  The value 1500 works well for the default CraftWorld sizes.
    MAX_PLAN_LEN = 1500

    n_actions = getattr(world, "n_actions", 5)   # default action count

    # Prefer movement actions before the USE action (if present) – this
    # encourages exploration before attempting to interact.
    action_order = list(range(n_actions))

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: we have at least one arrow in the inventory.
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories.
        if len(node.actions) >= MAX_PLAN_LEN:
            continue

        # Expand all actions.
        for a in action_order:
            _, nxt_state = cur_state.step(a)
            h = _hash_state(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the budget – return an empty list as a safe fallback.
    return []

