    # Bread‑first search over the state space to find a sequence of actions
    from collections import deque, namedtuple
    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """Hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_PLAN_LENGTH = 500                     # safety limit for plan length
    n_actions = getattr(world, "n_actions", 5)  # number of possible actions

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in the inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Do not expand nodes that already exceed the length limit
        if len(node.actions) >= MAX_PLAN_LENGTH:
            continue

        # Expand all possible actions from the current state
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            key = _state_key(next_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(next_state, node.actions + [a]))

    # If no plan was found within the search limits, return an empty list
    return []

