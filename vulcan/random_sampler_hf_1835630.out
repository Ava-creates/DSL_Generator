    # Action constants (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: find the nearest cell (Manhattan distance) that contains a given kind
    # ------------------------------------------------------------------
    def _find_nearest(grid, kind_idx, start_pos):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start_pos[0]) + abs(j - start_pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: locate any cell that contains a given kind
    # ------------------------------------------------------------------
    def _find_any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Helper: produce a Manhattan path (list of actions) from src to dst
    # ------------------------------------------------------------------
    def _path(src, dst):
        actions = []
        cur_r, cur_c = src
        dst_r, dst_c = dst
        # vertical moves
        while cur_r != dst_r:
            if cur_r < dst_r:
                actions.append(DOWN)
                cur_r += 1
            else:
                actions.append(UP)
                cur_r -= 1
        # horizontal moves
        while cur_c != dst_c:
            if cur_c < dst_c:
                actions.append(RIGHT)
                cur_c += 1
            else:
                actions.append(LEFT)
                cur_c -= 1
        return actions

    # ------------------------------------------------------------------
    # Start a fresh episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify the goal item (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # unknown goal – nothing to do
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting required counts)
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # Primitive not present – abort early
                return action_seq
            # Move to the target cell
            for a in _path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick it up (USE)
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = None
    for k, v in recipe.items():
        if k == "_at":
            workshop_name = v
            break

    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Perform the crafting action
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    # If there is no explicit workshop, simply attempt to craft in place
    else:
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq


    # ------------------------------------------------------------------
    # action identifiers
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # helper: find the nearest cell (Manhattan distance) containing a kind
    # ------------------------------------------------------------------
    def _find_nearest(grid, kind_idx, start_pos):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start_pos[0]) + abs(j - start_pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # helper: locate any cell containing a given kind (used for workshops)
    # ------------------------------------------------------------------
    def _find_any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # helper: produce a Manhattan path (list of actions) from src to dst
    # ------------------------------------------------------------------
    def _path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # ------------------------------------------------------------------
    # identify the goal item (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:                 # arrow not defined in the recipe set
        return []

    # ------------------------------------------------------------------
    # primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # collect each required primitive (repeat for required count)
    # ------------------------------------------------------------------
    for prim_idx, count in primitive_needs.items():
        for _ in range(count):
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # primitive not present – abort early
                return action_seq
            # move to the primitive cell (standing on it is fine for USE)
            for a in _path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # if the recipe specifies a workshop, move there and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)

    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # craft at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    return action_seq

