    # Reset environment and prepare helpers
    env.reset()
    act_map = env.action_specs()
    move_delta = {"UP": (-1, 0), "DOWN": (1, 0), "LEFT": (0, -1), "RIGHT": (0, 1)}

    # Identify goal and required resources
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving from `start`
    # to a cell adjacent (Chebyshev distance ≤ 1) to any cell in `targets`.
    # Only empty cells (no entity) may be traversed.
    # ------------------------------------------------------------------
    from collections import deque
    def bfs_to_adjacent(start, targets, grid):
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()
            # adjacency test
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path
            # expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if grid[nx, ny].sum() == 0:      # empty cell
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in needed.items():
        while True:
            state = env._current_state
            if state.inventory[prim_idx] >= required_cnt:
                break

            grid = state.grid
            pos = state.pos

            # locate all cells containing the needed primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # primitive missing from map – cannot collect further
                break

            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # unreachable primitive – abort this type
                break

            # follow the path
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # pick up the primitive
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # craft at the workshop
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # Return the accumulated action sequence
    return actions


