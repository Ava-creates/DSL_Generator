    # ----------------------------------------------------------------------
    # Locate the CraftWorld instance and its cookbook
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Obtain current state (reset if necessary) and make a mutable copy of the grid
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    mutable_grid = state.grid.copy()  # (W, H, n_kinds)

    # ----------------------------------------------------------------------
    # Action constants (as used by CraftLab)
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    actions = []                     # final action sequence

    # ----------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions that brings the agent
    # from `start` to a cell adjacent (or equal) to any cell in `targets`.
    # Any non‑empty cell in `mutable_grid` is considered blocked.
    # ----------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = mutable_grid.shape
        occupied = np.any(mutable_grid > 0, axis=2)
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # success if we are on a target or adjacent to one
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no path found
        return []

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # locate remaining instances of this primitive on the map
            locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]
            if not locs:
                # cannot find enough primitives – abort early
                break
            # choose the closest one (Manhattan distance)
            locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locs[0]

            # plan a path to an adjacent cell
            path = _bfs_path(pos, [target])
            actions.extend(path)

            # simulate movement to update `pos`
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # pick up the primitive
            actions.append(USE)
            mutable_grid[target[0], target[1], prim_idx] = 0
            gathered += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (may be a string name)
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_locs[0]
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)          # craft at the workshop
        else:
            # workshop not present – attempt crafting at current location
            actions.append(USE)
    else:
        # no specific workshop required
        actions.append(USE)

    return actions


    # ----------------------------------------------------------------------
    # Setup: obtain world, cookbook, goal index, and current state
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow (including nested primitives)
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Ensure we have a state object; reset if necessary
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Working copies of position and grid (to simulate pickups)
    pos = tuple(state.pos)          # (x, y)
    mutable_grid = state.grid.copy()

    # ----------------------------------------------------------------------
    # Action constants (as used by CraftLab)
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    actions: list[int] = []

    # ----------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions that brings the agent
    # from `start` to a cell adjacent (or equal) to any cell in `targets`.
    # Any non‑empty cell in `mutable_grid` is considered blocked.
    # ----------------------------------------------------------------------
    def _bfs_path(start: tuple[int, int], targets: list[tuple[int, int]]) -> list[int]:
        w, h, _ = mutable_grid.shape
        occupied = np.any(mutable_grid > 0, axis=2)
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # success if we are on a target or adjacent to one
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no path found
        return []

    # ----------------------------------------------------------------------
    # Phase 1: collect all required primitives (greedy nearest‑first)
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            # locate remaining instances of this primitive on the map
            locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]
            if not locations:
                # not enough primitives – abort early (environment will fail)
                break

            # choose the closest one (Manhattan distance)
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_loc = locations[0]

            # plan path to an adjacent cell
            path = _bfs_path(pos, [target_loc])
            actions.extend(path)

            # update simulated position
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # pick up the primitive
            actions.append(USE)
            mutable_grid[target_loc[0], target_loc[1], prim_idx] = 0
            collected += 1

    # ----------------------------------------------------------------------
    # Phase 2: move to workshop (if required) and craft the arrow
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (may be a string name)
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        workshop_locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, workshop_idx] > 0)]
        if workshop_locs:
            # move to the nearest workshop
            workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = workshop_locs[0]
            path = _bfs_path(pos, [ws_target])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)   # craft at the workshop
        else:
            # no workshop cell found – attempt crafting at current location
            actions.append(USE)
    else:
        # no specific workshop required
        actions.append(USE)

    return actions

