    import numpy as np
    from collections import deque

    # Mapping from direction vector to action index (as defined in CraftWorld)
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs_adjacent(start_pos, target_cells, grid, blocked_kinds):
        """Return a list of actions moving from start_pos to a cell adjacent
        (Manhattan distance = 1) to any of target_cells, avoiding blocked_kinds."""
        W, H = grid.shape[:2]
        # Build blocked map
        blocked = np.zeros((W, H), dtype=bool)
        for k in blocked_kinds:
            blocked |= grid[:, :, k] > 0

        sx, sy = start_pos
        # Already adjacent?
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ------------------------------------------------------------------
    # Extract information from the environment.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)

    # Goal index stored in the task (env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # Primitive (and intermediate) requirements for the goal.
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    blocked_kinds = env.world.non_grabbable_indices

    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        while cnt > 0:
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive not present anymore; abort planning.
                return plan

            path = bfs_adjacent(pos, cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(4)   # USE action

            # Find which cell we are adjacent to.
            adj = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                # Unexpected; stop to avoid infinite loop.
                break

            # Update local grid copy and decrement needed count.
            grid[adj[0], adj[1], kind_idx] -= 1
            cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(4)   # USE

    return plan


    # ----- Direction / action helpers -------------------------------------------------
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    from collections import deque
    import numpy as np

    def _bfs_adjacent(start_pos, target_cells, grid, blocked_kinds):
        """
        Bread‑first search that returns a list of actions moving the agent from
        ``start_pos`` to a cell *adjacent* (Manhattan distance = 1) to any cell in
        ``target_cells``.  ``grid`` has shape (W, H, K).  Cells whose kind is in
        ``blocked_kinds`` are treated as obstacles.
        """
        W, H = grid.shape[:2]

        # Build a boolean map of blocked cells.
        blocked = np.zeros((W, H), dtype=bool)
        for kind in blocked_kinds:
            blocked |= grid[:, :, kind] > 0

        sx, sy = start_pos

        # Already adjacent to a target?
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacent cell.
        return []

    # ----- Extract task information ---------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()                 # mutable copy for planning
    pos = tuple(state.pos)                   # (x, y)

    # Goal index is stored inside the task (CraftLab passes a Task namedtuple).
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in the environment task.")

    # Primitive (or intermediate) requirements for the goal.
    required = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    blocked_kinds = env.world.non_grabbable_indices          # e.g. trees, water

    plan = []

    # ----- 1. Collect all required primitives -----------------------------------------
    for kind_idx, need_cnt in required.items():
        while need_cnt > 0:
            # Locate all remaining instances of this kind on the map.
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Not enough primitives left; abort planning.
                return plan

            # Find a path to the nearest reachable instance (adjacent).
            path = _bfs_adjacent(pos, cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Identify which cell we are now adjacent to.
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected – break to avoid infinite loop.
                break

            # Pick up as many as we need from this cell (could be >1).
            while need_cnt > 0 and grid[adj_cell[0], adj_cell[1], kind_idx] > 0:
                plan.append(4)                     # USE
                grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
                need_cnt -= 1

    # ----- 2. Move to the workshop and craft the goal item ---------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    # Workshop location can be stored under "_at" (new) or "_key" (legacy).
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index.
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = _bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement to workshop adjacency.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(4)   # USE

    return plan

