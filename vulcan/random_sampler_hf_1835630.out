    # Reset the environment to obtain the initial state.
    env.reset()
    # Access the underlying world and indexing utilities.
    world = env.world
    idx = world.cookbook.index

    # Identify the goal item ("arrow") and its recipe.
    try:
        arrow_id = idx["arrow"]
    except Exception:
        # If the name is not directly indexed, fall back to a safe default.
        return []

    recipe = world.cookbook.recipes.get(arrow_id, {})
    workshop_kind = recipe.get("_at", None)

    # Determine which primitive resources are required and in what quantities.
    needed_prims = world.cookbook.primitives_for(arrow_id)  # {prim_id: count}
    if not needed_prims:
        return []

    # Helper: translate a Manhattan displacement into a list of actions.
    # Action mapping follows CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    def manhattan_path(start, goal):
        sx, sy = start
        gx, gy = goal
        path = []
        dx = gx - sx
        dy = gy - sy
        # Move in x direction first.
        while dx > 0:
            path.append(3)  # RIGHT
            dx -= 1
        while dx < 0:
            path.append(2)  # LEFT
            dx += 1
        # Then move in y direction.
        while dy > 0:
            path.append(0)  # DOWN
            dy -= 1
        while dy < 0:
            path.append(1)  # UP
            dy += 1
        return path

    # Retrieve the current state object (CraftState) from the environment.
    state = getattr(env, "_current_state", None)
    if state is None:
        # If the environment does not expose the state directly, we cannot proceed.
        return []
    pos = state.pos  # (x, y) tuple
    grid = state.grid  # shape: (WIDTH, HEIGHT, n_kinds)

    # Locate all cells that contain the required primitive kinds.
    prim_positions = {pid: [] for pid in needed_prims}
    width, height, _ = grid.shape
    for x in range(width):
        for y in range(height):
            cell_vec = grid[x, y]
            # Find which kind(s) are present in this cell.
            present_kinds = np.where(cell_vec > 0)[0]
            for kind in present_kinds:
                if kind in prim_positions:
                    prim_positions[kind].append((x, y))

    actions = []

    # Collect each required primitive the necessary number of times.
    for pid, cnt in needed_prims.items():
        # Sort available positions by distance from the current location.
        available = sorted(prim_positions.get(pid, []),
                           key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
        for _ in range(cnt):
            if not available:
                # No more locations for this primitive; abort early.
                return actions
            target = available.pop(0)
            # Move to the target cell.
            actions.extend(manhattan_path(pos, target))
            # Use the item (collect it). In CraftWorld the USE action works when
            # the agent is on the same cell as the item.
            actions.append(4)  # USE
            pos = target

    # After gathering primitives, travel to the appropriate workshop (if any) and craft.
    if workshop_kind is not None:
        workshop_pos = None
        for x in range(width):
            for y in range(height):
                if grid[x, y, workshop_kind] > 0:
                    workshop_pos = (x, y)
                    break
            if workshop_pos:
                break
        if workshop_pos:
            actions.extend(manhattan_path(pos, workshop_pos))
            actions.append(4)  # USE to trigger crafting at the workshop

    return actions


    # Initialise the environment and obtain useful references
    env.reset()
    state = env._current_state
    action_map = env.action_specs()                # name → int
    world = env.world
    # Index of the goal item “arrow”
    arrow_idx = world.cookbook.index["arrow"]
    # Primitive requirements (expanded recursively)
    needed_prims = world.cookbook.primitives_for(arrow_idx)

    # Helper to move the agent to a target cell using Manhattan moves
    def _move_to(target):
        """Move current agent to *target* (x, y) and record actions."""
        nonlocal state
        while state.pos[0] != target[0]:
            if target[0] > state.pos[0]:
                act = action_map["RIGHT"]
            else:
                act = action_map["LEFT"]
            actions.append(act)
            env.step(act)
            state = env._current_state
        while state.pos[1] != target[1]:
            if target[1] > state.pos[1]:
                act = action_map["DOWN"]
            else:
                act = action_map["UP"]
            actions.append(act)
            env.step(act)
            state = env._current_state

    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitive resources
    # ------------------------------------------------------------------
    dir_vec = {
        "UP":    (0, -1),
        "DOWN":  (0, 1),
        "LEFT":  (-1, 0),
        "RIGHT": (1, 0),
    }

    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            # locate all remaining instances of the primitive
            prim_pos = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_pos.size == 0:
                raise RuntimeError("Required primitive not found in the grid.")
            # pick the closest one (Manhattan distance)
            dists = np.abs(prim_pos[:, 0] - state.pos[0]) + np.abs(prim_pos[:, 1] - state.pos[1])
            target = prim_pos[dists.argmin()]
            # Choose a side to approach from – we want to step onto the cell
            # that is opposite the direction we will finally face.
            approach = None
            approach_dir = None
            for dname, (dx, dy) in dir_vec.items():
                cand = (target[0] - dx, target[1] - dy)
                if (0 <= cand[0] < state.grid.shape[0] and
                        0 <= cand[1] < state.grid.shape[1] and
                        state.grid[cand[0], cand[1], :].sum() == 0):
                    approach = cand
                    approach_dir = dname
                    break
            # Fallback – any adjacent cell (even if occupied)
            if approach is None:
                for dname, (dx, dy) in dir_vec.items():
                    cand = (target[0] - dx, target[1] - dy)
                    if 0 <= cand[0] < state.grid.shape[0] and 0 <= cand[1] < state.grid.shape[1]:
                        approach = cand
                        approach_dir = dname
                        break
            # Move to the chosen adjacent cell
            _move_to(approach)
            # The last move we performed set the direction correctly,
            # so a single USE will pick up the primitive.
            actions.append(action_map["USE"])
            env.step(action_map["USE"])
            state = env._current_state

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes[arrow_idx]
    # The workshop index is stored under the special key “_at” (or “_key” as a fallback)
    workshop_idx = recipe.get("_at", recipe.get("_key"))
    if workshop_idx is None:
        raise RuntimeError("Workshop information for arrow not found in recipe.")

    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        raise RuntimeError("No workshop of required type present in the grid.")
    dists = np.abs(workshop_cells[:, 0] - state.pos[0]) + np.abs(workshop_cells[:, 1] - state.pos[1])
    ws_target = workshop_cells[dists.argmin()]

    # Find an adjacent free cell to stand on before using the workshop
    ws_adj = None
    for dname, (dx, dy) in dir_vec.items():
        cand = (ws_target[0] - dx, ws_target[1] - dy)
        if (0 <= cand[0] < state.grid.shape[0] and
                0 <= cand[1] < state.grid.shape[1] and
                state.grid[cand[0], cand[1], :].sum() == 0):
            ws_adj = cand
            break
    if ws_adj is None:
        # As a last resort pick any neighbour (might be occupied)
        ws_adj = (max(ws_target[0] - 1, 0), ws_target[1])

    # Move next to the workshop
    _move_to(ws_adj)

    # Use the workshop to craft the arrow
    actions.append(action_map["USE"])
    env.step(action_map["USE"])
    state = env._current_state

    # Return the full action list
    return actions

