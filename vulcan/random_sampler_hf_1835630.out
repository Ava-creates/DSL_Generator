    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid.copy()
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def cell_blocked(y, x):
        return grid[y, x].any()

    def bfs_path(start, goal):
        if start == goal:
            return []
        from collections import deque
        q = deque([(start[0], start[1], [])])
        visited = {start}
        while q:
            y, x, path = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx) or (ny, nx) in visited or cell_blocked(ny, nx):
                    continue
                npath = path + [act]
                if (ny, nx) == goal:
                    return npath
                visited.add((ny, nx))
                q.append((ny, nx, npath))
        return []

    def find_nearest(kind_idx, from_pos):
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if not locs.size:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[np.argmin(dists)])

    def adjacent_free(cell, avoid=set()):
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx) or (ny, nx) in avoid or cell_blocked(ny, nx):
                continue
            return (ny, nx)
        return None

    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos
    taken = set()

    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                return actions
            adj = adjacent_free(target, avoid=taken)
            if adj is None:
                return actions
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)
            actions.append(USE)
            grid[target[0], target[1], prim_idx] = 0
            taken.add(target)

    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, avoid=taken)
            if ws_adj is None:
                ws_adj = ws_cell if not cell_blocked(*ws_cell) else cur_pos
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    actions.append(USE)
    return actions


    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)

    # Action indices (consistent with CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def cell_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return grid[y, x].any()

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding blocked cells.
        ``goal`` must be a free cell."""
        if start == goal:
            return []
        from collections import deque
        q = deque([(start[0], start[1], [])])
        visited = {start}
        while q:
            y, x, path = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_blocked(ny, nx):
                    continue
                new_path = path + [act]
                if (ny, nx) == goal:
                    return new_path
                visited.add((ny, nx))
                q.append((ny, nx, new_path))
        return []   # no path found

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing ``kind_idx`` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Return a free neighbour (y,x) of ``cell`` that is not in ``avoid``."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not cell_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives for 'arrow'
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    harvested = set()  # cells already taken
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early
                return actions

            # Choose a free adjacent cell to stand on while picking up
            adj = adjacent_free(target, avoid=harvested)
            if adj is None:
                # No free neighbour – abort
                return actions

            # Move to the adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (optional blocked move)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update internal grid representation
            grid[target[0], target[1], prim_idx] = 0
            harvested.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, avoid=harvested)
            if ws_adj is None:
                # If no free neighbour, try standing directly on the workshop if it's free
                ws_adj = ws_cell if not cell_blocked(*ws_cell) else cur_pos
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop (optional blocked move)
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting
    actions.append(USE)

    return actions

