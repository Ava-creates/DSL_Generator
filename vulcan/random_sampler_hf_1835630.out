    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    actions = []

    # Determine starting position (use live state if available)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the initial grid to keep track of taken items
    grid = env.scenario.init_grid.copy()

    # Goal item index (the task the environment expects)
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_to(target):
        """Append actions that move the agent from cur_pos to target."""
        nonlocal cur_pos
        while cur_pos[0] != target[0] or cur_pos[1] != target[1]:
            if cur_pos[0] < target[0]:
                actions.append(RIGHT)
                cur_pos[0] += 1
            elif cur_pos[0] > target[0]:
                actions.append(LEFT)
                cur_pos[0] -= 1
            elif cur_pos[1] < target[1]:
                actions.append(DOWN)
                cur_pos[1] += 1
            elif cur_pos[1] > target[1]:
                actions.append(UP)
                cur_pos[1] -= 1

    def _nearest_kind(kind_idx):
        """Return coordinates [x, y] of the nearest cell containing kind_idx."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal
    # ------------------------------------------------------------------
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, needed in primitive_requirements.items():
        for _ in range(needed):
            target = _nearest_kind(prim_kind)
            if target is None:
                # Primitive not present – abort planning (return whatever we have)
                return actions
            _move_to(target)
            actions.append(USE)                     # pick up the primitive
            grid[target[1], target[0], prim_kind] = 0  # mark as taken

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind)
        if workshop_pos is not None:
            _move_to(workshop_pos)
            actions.append(USE)                     # craft at the workshop

    # Return the full planned action sequence
    return actions


    # Action indices (standard for CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    actions = []

    # ------------------------------------------------------------------
    # Current position (use the live state if it exists, otherwise the start)
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)          # [x, y]
    else:
        cur_pos = list(env.scenario.init_pos)           # [x, y]

    # Work on a mutable copy of the initial grid so we can “remove” items once taken
    grid = env.scenario.init_grid.copy()

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_to(pos, target, seq):
        """Append actions that move the agent from `pos` to `target`."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur, g):
        """Return coordinates [x, y] of the nearest cell containing `kind_idx`."""
        ys, xs = np.where(g[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # 1. Collect required primitive resources for the goal item
    # ------------------------------------------------------------------
    goal_idx = env.task.goal                                 # integer index of the target item
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    for prim_kind, count in primitive_requirements.items():
        for _ in range(count):
            target = _nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive not present – cannot plan further; return what we have
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)                               # pick up the primitive
            grid[target[1], target[0], prim_kind] = 0         # mark as taken

    # ------------------------------------------------------------------
    # 2. If the recipe requires a specific workshop, go there and craft
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)                               # craft at the workshop

    # ------------------------------------------------------------------
    # Return the planned action list
    # ------------------------------------------------------------------
    return actions

