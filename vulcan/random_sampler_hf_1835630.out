    import heapq
    from collections import namedtuple

    Node = namedtuple("Node", ["state", "actions", "cost"])

    def _state_key(st):
        """Hashable representation of a state for visited tracking."""
        # Position, direction, inventory tuple, and a hash of the grid occupancy
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    def _missing_primitive_count(st):
        """Heuristic: total number of missing primitive items for the goal."""
        have = st.inventory
        missing = 0
        for p_idx, cnt in needed_prims.items():
            have_cnt = have[p_idx] if p_idx < len(have) else 0
            if have_cnt < cnt:
                missing += cnt - have_cnt
        # Also count if we already have the final product
        if st.inventory[target_idx] > 0:
            missing = 0
        return missing

    # A* search
    start_key = _state_key(init_state)
    visited = {start_key}
    start_node = Node(init_state, [], 0)
    frontier = [(0 + _missing_primitive_count(init_state), start_node)]  # (f, node)

    MAX_EXPANSIONS = 50000
    expansions = 0
    n_actions = getattr(world, "n_actions", 5)  # typically 5 (4 moves + USE)

    while frontier:
        _, current = heapq.heappop(frontier)
        cur_state = current.state

        # Goal test
        if cur_state.satisfies("", target_idx):
            return current.actions

        # Expansion limit
        expansions += 1
        if expansions > MAX_EXPANSIONS:
            break

        # Expand neighbours
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            key = _state_key(next_state)
            if key in visited:
                continue
            visited.add(key)

            g_cost = len(current.actions) + 1
            h_cost = _missing_primitive_count(next_state)
            f_cost = g_cost + h_cost
            heapq.heappush(frontier, (f_cost, Node(next_state, current.actions + [a], g_cost)))

    # If we exit the loop without finding a solution, return empty plan
    return []


