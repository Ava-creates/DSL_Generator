    import collections, numpy as np

    # action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def bfs_to_adjacent(start, targets, occupied):
        """Return a list of actions moving from `start` to a cell adjacent to any
        target in `targets`. `occupied` is a 2‑D boolean array where True means
        the cell cannot be entered."""
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # adjacency test
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # explore neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Locate world and cookbook objects – they may be stored in different
    # attributes depending on the environment wrapper.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        wrapper = getattr(env, "_current_state", None)
        if wrapper is not None:
            world = getattr(wrapper, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal identification (hard‑coded to 'arrow').
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements (recursive expansion to base resources)
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Planning copies of position and grid.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()             # (W, H, n_kinds)
    occupied = np.any(grid, axis=2)      # 2‑D bool mask of blocked cells

    plan = []
    used_cells = set()                   # primitives already taken

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # locate all cells that currently contain this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # greedy order: nearest first
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed:
                break
            if cell in used_cells:
                continue
            # move adjacent to the primitive
            path = bfs_to_adjacent(pos, [cell], occupied)
            plan.extend(path)
            # update position following the path
            for a in path:
                if a == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif a == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif a == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif a == UP:
                    pos = (pos[0], pos[1] - 1)
            # pick it up
            plan.append(USE)

            # mark cell empty for future planning
            grid[cell[0], cell[1], prim_idx] = 0
            occupied = np.any(grid, axis=2)
            used_cells.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (may be string or already int)
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = bfs_to_adjacent(pos, [target_ws], occupied)
            plan.extend(path)
            for a in path:
                if a == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif a == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif a == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif a == UP:
                    pos = (pos[0], pos[1] - 1)
            plan.append(USE)
        else:
            # workshop not visible – attempt crafting where we stand
            plan.append(USE)
    else:
        # no specific workshop required
        plan.append(USE)

    return plan


    import collections
    import numpy as np

    # Action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_adjacent(start, targets, blocked):
        """Return a list of actions moving from start to a cell adjacent to any target."""
        w, h = blocked.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # check adjacency
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # no path found

    def _apply_actions(pos, actions):
        """Update a (x, y) position by sequentially applying actions."""
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate world and cookbook (may be stored in different places)
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal identification (hard‑coded to 'arrow')
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' is not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitives required for the arrow
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Working copies for planning
    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()             # (W, H, n_kinds)
    blocked = np.any(grid, axis=2)       # True where any entity occupies the cell

    plan = []            # list of action indices to return
    harvested = set()    # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locate all cells containing this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position (greedy nearest first)
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed:
                break
            if cell in harvested:
                continue
            # Move adjacent to the primitive
            path = _bfs_adjacent(pos, [cell], blocked)
            plan.extend(path)
            pos = _apply_actions(pos, path)

            # Pick it up
            plan.append(USE)

            # Update planning structures
            grid[cell[0], cell[1], prim_idx] = 0
            blocked = np.any(grid, axis=2)
            harvested.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name)
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_adjacent(pos, [target_ws], blocked)
            plan.extend(path)
            pos = _apply_actions(pos, path)
            plan.append(USE)
        else:
            # No visible workshop; attempt to craft at current location
            plan.append(USE)
    else:
        # No specific workshop required; simply use to craft
        plan.append(USE)

    return plan

