    import numpy as np
    from collections import deque

    # Action constants as defined in CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Initialise environment and obtain world information
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Goal item index for "arrow" and its primitive requirements
    goal_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """Return True if a non‑grabbable entity occupies the cell."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs_path(start, goal):
        """Shortest 4‑connected walkable path from start to goal (inclusive)."""
        if start == goal:
            return [start]
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            return []  # unreachable

        # reconstruct path backwards
        path = []
        cur = goal
        while cur is not None:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Translate a list of positions (including start) into movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the closest cell that contains the given kind."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of `target` (N, S, W, E preference)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        # fallback to the target itself (might be walkable)
        return target

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)

    # Collect each required primitive the required number of times
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            prim_loc = nearest_cell(prim_idx, cur_pos)
            if prim_loc is None:
                # Primitive missing – abort early
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur_pos, stand_pos)
            if not path:
                return actions
            actions.extend(path_to_actions(path))
            cur_pos = stand_pos

            # Step onto the primitive cell itself (if not blocked)
            if not is_blocked(prim_loc):
                path = bfs_path(cur_pos, prim_loc)
                if not path:
                    return actions
                actions.extend(path_to_actions(path))
                cur_pos = prim_loc

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid to reflect removal
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # If the recipe specifies a workshop, travel there before crafting
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur_pos)
        if ws_loc is not None:
            path = bfs_path(cur_pos, ws_loc)
            if path:
                actions.extend(path_to_actions(path))
                cur_pos = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions


