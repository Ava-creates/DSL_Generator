    height, width, _ = grid.shape

    def in_bounds(y, x):
        return 0 <= y < height and 0 <= x < width

    def is_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return grid[y, x].any()

    # Directions with corresponding action indices
    DIRS = [
        (1, 0, DOWN),   # down
        (-1, 0, UP),    # up
        (0, -1, LEFT),  # left
        (0, 1, RIGHT),  # right
    ]

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that
        moves the agent from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct path
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    for dy, dx, act in DIRS:
                        if cur[0] == py + dy and cur[1] == px + dx:
                            rev.append(act)
                            break
                    cur = (py, px)
                return list(reversed(rev))
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if is_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # No path found – return empty list (caller may handle)
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing the given kind."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[dists.argmin()]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Return a free (non‑blocked) cell adjacent to `cell`.
        `avoid` is a set of positions that should not be used (e.g., already
        collected primitive locations)."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not is_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos
    collected_positions = set()   # to avoid standing on a just‑collected cell

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, qty in needed_prims.items():
        for _ in range(qty):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort planning
                return actions
            # Choose a free adjacent cell to stand on
            adj = adjacent_free(target, avoid=collected_positions)
            if adj is None:
                # No free adjacent cell; fall back to standing on the cell itself
                adj = target
            # Move to the chosen adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the target cell (move action that will be blocked)
            dy = target[0] - cur_pos[0]
            dx = target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid: primitive removed
            grid[target[0], target[1], prim_idx] = 0
            collected_positions.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, avoid=collected_positions)
            if ws_adj is None:
                ws_adj = ws_cell  # fallback: stand on the workshop cell
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop cell
            dy = ws_cell[0] - cur_pos[0]
            dx = ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting
    actions.append(USE)

    return actions

