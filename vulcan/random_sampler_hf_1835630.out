        q = deque([start])
        prev = {start: None}
        visited = {start}
        while q:
            cur = q.popleft()
            if cur in targets:
                # reconstruct path (list of positions)
                path = [cur]
                while prev[path[-1]] is not None:
                    path.append(prev[path[-1]])
                path.reverse()
