            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive not present – cannot continue planning.
                return plan

            # Compute a path to a cell adjacent to any of the candidate cells.
            path = _bfs_to_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to update the agent's position.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Perform the USE action to pick up the primitive.
