    # constants for actions
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    import collections, numpy as np

    def _bfs_path(start, targets, occupied):
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    # locate world and cookbook
    world = getattr(env, "world", None)
    if world is None:
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = getattr(state_tmp, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld not found in env")
    cookbook = world.cookbook

    # ensure we have a state
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    prim_req = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    pos = tuple(state.pos)
    grid = state.grid.copy()
    occupied = np.any(grid > 0, axis=2)

    actions = []
    harvested = set()

    # collect primitives
    for prim_idx, needed in prim_req.items():
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            path = _bfs_path(pos, [loc], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
            grid[loc[0], loc[1], prim_idx] = 0
            occupied[loc[0], loc[1]] = False
            harvested.add(loc)
            collected += 1

    # craft at workshop if required
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str) else workshop_key)
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_path(pos, [target_ws], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)

    return actions

