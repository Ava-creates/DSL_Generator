    import numpy as np

    # Action constants (as used by CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: generate a Manhattan‑style action list from cur → tgt
    # ------------------------------------------------------------------
    def _move_actions(cur, tgt):
        """Return a list of actions moving from cur (x,y) to tgt (x,y)."""
        ax, ay = cur
        bx, by = tgt
        acts = []
        # vertical movement (x coordinate)
        while ax < bx:
            acts.append(DOWN)
            ax += 1
        while ax > bx:
            acts.append(UP)
            ax -= 1
        # horizontal movement (y coordinate)
        while ay < by:
            acts.append(RIGHT)
            ay += 1
        while ay > by:
            acts.append(LEFT)
            ay -= 1
        return acts

    # ------------------------------------------------------------------
    # Reset / obtain the current underlying state
    # ------------------------------------------------------------------
    # ``env.reset`` returns an observation dict; the internal state is stored
    # in ``env._current_state`` (the implementation of CraftLab keeps a
    # reference to the CraftState instance).  We rely on that attribute.
    _ = env.reset()
    state = env._current_state          # type: CraftState
    grid = state.grid.copy()            # mutable copy for planning
    pos = list(state.pos)               # current (x, y) location

    # ------------------------------------------------------------------
    # Identify the recipe for the target item “arrow”
    # ------------------------------------------------------------------
    idx = env.world.cookbook.index               # name → int mapping
    arrow_idx = idx["arrow"]                     # integer id of the goal
    recipe = env.world.cookbook.recipes[arrow_idx]

    # The workshop where the arrow must be crafted is stored under the
    # special key ``"_at"`` in the recipe.
    workshop_kind = recipe["_at"]

    # Primitive ingredients are all entries whose key is an integer (i.e.
    # not ``"_at"``).  The value is the required count.
    primitives = {k: v for k, v in recipe.items() if k != "_at"}

    plan_actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting multiplicities)
    # ------------------------------------------------------------------
    for kind, needed in primitives.items():
        for _ in range(needed):
            # Locate all cells that currently contain the needed primitive.
            locations = np.argwhere(grid[:, :, kind] > 0)
            if locations.size == 0:
                # No more of this primitive on the map – abort planning.
                # (In a well‑formed scenario this should never happen.)
                break

            # Choose the nearest occurrence (Manhattan distance).
            dists = np.abs(locations - pos).sum(axis=1)
            nearest_idx = dists.argmin()
            target = locations[nearest_idx].tolist()

            # Move to the primitive and pick it up.
            plan_actions += _move_actions(pos, target)
            pos = target
            plan_actions.append(USE)

            # Simulate the pickup in our planning copy of the grid.
            grid[pos[0], pos[1], kind] = 0

    # ------------------------------------------------------------------
    # Travel to the appropriate workshop and craft the arrow
    # ------------------------------------------------------------------
    workshop_locs = np.argwhere(grid[:, :, workshop_kind] > 0)
    if workshop_locs.size > 0:
        dists = np.abs(workshop_locs - pos).sum(axis=1)
        nearest_idx = dists.argmin()
        workshop_pos = workshop_locs[nearest_idx].tolist()

        plan_actions += _move_actions(pos, workshop_pos)
        pos = workshop_pos
        plan_actions.append(USE)   # using the workshop crafts the arrow

    # Return the complete list of action indices.
    return plan_actions


    # Action indices as defined in CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Access world and cookbook – handle both CraftLab and raw CraftWorld objects
    world = getattr(env, "world", None)
    if world is None:
        # In some setups the current state holds a reference to the world
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook

    # Goal identifier for the arrow
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Current state information
    state = getattr(env, "_current_state", None)
    if state is None:
        # If not already present, initialise a state from the scenario
        state = env.scenario.init()
    pos = tuple(state.pos)
    grid = state.grid

    actions = []

    # Helper: generate Manhattan move sequence from cur to target
    def _move_to(cur, target):
        cx, cy = cur
        tx, ty = target
        seq = []
        while cx < tx:
            seq.append(RIGHT)
            cx += 1
        while cx > tx:
            seq.append(LEFT)
            cx -= 1
        while cy < ty:
            seq.append(DOWN)
            cy += 1
        while cy > ty:
            seq.append(UP)
            cy -= 1
        return seq

    # Keep track of primitive cells already used
    used_cells = set()

    # Collect each required primitive
    for prim_idx, needed_cnt in primitives_needed.items():
        # Locate all cells containing this primitive type
        locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position
        locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locs:
            if gathered >= needed_cnt:
                break
            if loc in used_cells:
                continue
            # Move to the primitive cell
            actions.extend(_move_to(pos, loc))
            pos = loc
            # Pick it up
            actions.append(USE)
            used_cells.add(loc)
            gathered += 1

    # After gathering primitives, head to the appropriate workshop and craft
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be name or already an index)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key
        # Find workshop locations
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_locs[0]
            actions.extend(_move_to(pos, target_ws))
            pos = target_ws
            actions.append(USE)

    return actions

