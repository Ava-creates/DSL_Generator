    import numpy as np
    import collections

    # Retrieve the world and current state
    world = getattr(env, "world", None)
    if world is None:
        if not hasattr(env, "_current_state") or env._current_state is None:
            env.reset()
        state = env._current_state
        world = state.world
    else:
        if not hasattr(env, "_current_state") or env._current_state is None:
            env.reset()
        state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for one arrow
    primitives_needed = cookbook.primitives_for(goal_idx)
    if not primitives_needed:
        return []

    grid = state.grid
    pos = tuple(state.pos)
    occupied = np.any(grid > 0, axis=2)

    # Action identifiers and movement deltas
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    actions = []
    harvested = set()

    # ------------------------------------------------------------------
    # Helper: BFS to a cell adjacent to any of the target positions.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        from collections import deque
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                visited.add((nx, ny))
                q.append((nx, ny, new_path))
        return []

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            prim_locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            prim_locs = [loc for loc in prim_locs if loc not in harvested]
            if not prim_locs:
                break
            prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = prim_locs[0]

            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            actions.append(USE)
            harvested.add(target)
            gathered += 1
            occupied[target] = False

    # ------------------------------------------------------------------
    # Craft at the required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = ws_locs[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)
        else:
            actions.append(USE)
    else:
        actions.append(USE)

    return actions


    import collections
    import numpy as np

    # ----------------------------------------------------------------------
    # Action constants – match default CraftWorld ordering.
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `start`
    # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in
    # `targets`.  Cells containing any entity are treated as blocked.
    # ----------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # no reachable adjacent cell

    # ----------------------------------------------------------------------
    # Retrieve world / cookbook.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Fallback: world may be stored inside the current state.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        # Ensure we have a state object for position / grid.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Primitive requirements for a single arrow.
    # ----------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    if not primitives_needed:
        return []  # arrow is already a primitive (unlikely)

    # ----------------------------------------------------------------------
    # Current grid / position.
    # ----------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)

    # Occupancy mask – True where any entity exists.
    occupied = np.any(grid > 0, axis=2)

    actions = []
    harvested = set()                     # primitive locations already used

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # Locate all cells containing this primitive and not yet harvested.
            locations = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not locations:
                # No more primitives of this type on the map; abort early.
                break
            # Choose the nearest location (Manhattan distance).
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locations[0]

            # Plan path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement to update `pos`.
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # After picking up, the cell becomes empty – update occupancy.
            occupied[target] = False

    # ----------------------------------------------------------------------
    # Craft the arrow at the required workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string).
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key

        # Find all workshop cells of the required type.
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(
                key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])
            )
            ws_target = workshop_cells[0]

            # Move adjacent to the workshop.
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use to craft.
            actions.append(USE)
        else:
            # No workshop found – fall back to using current cell.
            actions.append(USE)
    else:
        # No workshop required; simply use at current location.
        actions.append(USE)

    return actions

