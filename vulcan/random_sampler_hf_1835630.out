    grid = state.grid.copy()             # mutable copy for planning

    # ------------------------------------------------------------------
    # Action indices (fallback to default ordering if specs unavailable)
    # ------------------------------------------------------------------
    try:
        specs = env.action_specs()
        DOWN = specs['DOWN']
        UP = specs['UP']
        LEFT = specs['LEFT']
        RIGHT = specs['RIGHT']
        USE = specs['USE']
    except Exception:
        DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_free(cell):
        """Return True iff cell inside grid and not occupied by a non‑grabbable entity."""
        y, x = cell
        if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):
            return False
        return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def free_adjacent(target):
        """Find a free orthogonal neighbour of `target`. Return None if none."""
        ty, tx = target
        for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            ny, nx = ty + dy, tx + dx
            if is_free((ny, nx)):
                return (ny, nx)
        return None

    def bfs_path(start, goal):
        """Breadth‑first search returning a list of movement actions from start to goal."""
        if start == goal:
            return []
        from collections import deque
        queue = deque([start])
        parent = {start: (None, None)}   # pos -> (prev_pos, action)

        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            y, x = cur
            for (dy, dx), act in [((-1, 0), UP), ((1, 0), DOWN),
                                  ((0, -1), LEFT), ((0, 1), RIGHT)]:
                ny, nx = y + dy, x + dx
                nxt = (ny, nx)
                if not is_free(nxt):
                    continue
                if nxt not in parent:
                    parent[nxt] = (cur, act)
                    queue.append(nxt)

        if goal not in parent:
            return []   # unreachable

        # reconstruct actions
        actions_rev = []
        cur = goal
        while parent[cur][0] is not None:
            prev, act = parent[cur]
            actions_rev.append(act)
            cur = prev
        actions_rev.reverse()
        return actions_rev

    def turn_towards(src, dst):
        """Return a single turn action making src face dst (orthogonal)."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    def find_nearest(kind_idx, from_pos):
        """Locate nearest cell containing entity of kind_idx."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine goal and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in needed_prims.items():
        for _ in range(needed_cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on; fall back to the primitive cell.
            stand = free_adjacent(target) or target

            # Move to the standing position.
            actions += bfs_path(cur_pos, stand)
            cur_pos = stand

            # Turn towards the primitive (if not standing on it).
            turn = turn_towards(cur_pos, target)
            if turn is not None:
                actions.append(turn)

            # Pick up the primitive.
            actions.append(USE)

            # Update planning grid so we don't re‑pick the same item.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if recipe specifies one) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions


