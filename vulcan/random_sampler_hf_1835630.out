    # Reset environment and obtain initial state references
    env.reset()
    cur_state = env._current_state          # type: CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # not defined in this world
        return []

    # --------------------------------------------------------------
    # Helper: BFS returning a list of movement actions (0‑3) that
    # leaves the agent facing a cell containing `target_kind`.
    # Returns [] if already facing the target, or [] if unreachable.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # direction deltas matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sdir = state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return []   # unreachable

    # --------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}

    # If the recipe has no primitives (arrow itself is a primitive), we simply need to pick it up.
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    plan_actions = []

    # --------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_seq = _bfs_to_target(cur_state, prim_idx)

            # If BFS failed and we are not already facing the primitive, abort planning.
            if not move_seq:
                # Verify whether the primitive is already directly in front.
                d_dx, d_dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[cur_state.dir]
                fx, fy = cur_state.pos[0] + d_dx, cur_state.pos[1] + d_dy
                if not (0 <= fx < cur_state.grid.shape[0] and
                        0 <= fy < cur_state.grid.shape[1] and
                        cur_state.grid[fx, fy, prim_idx] > 0):
                    return plan_actions   # unreachable primitive

            plan_actions.extend(move_seq)
            plan_actions.append(4)   # USE to pick up

            # Apply actions to keep cur_state up‑to‑date.
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        plan_actions.extend(move_seq)
        plan_actions.append(4)   # USE to craft

        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – attempt crafting in place.
        plan_actions.append(4)   # USE to craft
        _, cur_state = cur_state.step(4)

    return plan_actions


    # Reset the environment and get handles to the current state and world configuration
    env.reset()
    cur_state = env._current_state          # type: CraftState
    world = env.world

    # ----------------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # arrow not defined in this world
        return []

    # If we already have an arrow in the inventory, no actions are needed
    if cur_state.inventory[arrow_idx] > 0:
        return []

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) which ends
    # with the agent facing a cell that contains `target_kind`.
    # Returns [] if the target is already in front, or [] if unreachable.
    # ----------------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # direction deltas matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sdir = state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return []   # unreachable

    # ----------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ----------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    if not primitive_needs:
        # Arrow itself is a primitive; we just need to pick it up.
        primitive_needs = {arrow_idx: 1}

    plan_actions = []

    # ----------------------------------------------------------------------
    # Collect each required primitive the necessary number of times,
    # taking into account any that may already be in the inventory.
    # ----------------------------------------------------------------------
    for prim_idx, required_cnt in primitive_needs.items():
        already = int(cur_state.inventory[prim_idx])
        to_collect = max(0, required_cnt - already)
        for _ in range(to_collect):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            # If BFS failed (empty) and we're not already facing the primitive, abort.
            if not move_seq:
                # Verify if the primitive is already directly in front.
                d_dx, d_dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[cur_state.dir]
                fx, fy = cur_state.pos[0] + d_dx, cur_state.pos[1] + d_dy
                if not (0 <= fx < cur_state.grid.shape[0] and
                        0 <= fy < cur_state.grid.shape[1] and
                        cur_state.grid[fx, fy, prim_idx] > 0):
                    return plan_actions   # unreachable primitive
            plan_actions.extend(move_seq)
            plan_actions.append(4)   # USE to pick up

            # Apply the actions to keep the state up‑to‑date.
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        plan_actions.extend(move_seq)
        plan_actions.append(4)   # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – attempt crafting in place.
        plan_actions.append(4)   # USE to craft
        _, cur_state = cur_state.step(4)

    return plan_actions

