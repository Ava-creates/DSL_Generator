    # Bread‑first search over the state space
    frontier = deque([(start_state, [])])
    visited = {_state_key(start_state)}

    MAX_STEPS = 300                     # safety cutoff for plan length
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        cur_state, cur_actions = frontier.popleft()

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return cur_actions

        if len(cur_actions) >= MAX_STEPS:
            continue

        # Expand neighbours
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append((nxt_state, cur_actions + [a]))

    # No plan found within the depth limit
    return []

