    DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}
    from collections import deque
    import numpy as np

    def bfs_adj(start, targets, grid):
        """Return a list of actions that moves the agent from ``start`` to a cell
        adjacent to any cell in ``targets`` while avoiding non‑grabbable blocks."""
        W, H = grid.shape[:2]

        # Cells that cannot be entered.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.zeros((W, H), dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # local mutable copy
    pos = tuple(state.pos)            # (x, y)

    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        return []

    # Primitive (or intermediate) requirements for the goal.
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # --------------------------------------------------------------
    # 1. Collect required primitives.
    # --------------------------------------------------------------
    for kind_idx, count in needed.items():
        while count > 0:
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # No more of this primitive on the map – abort.
                return plan

            path = bfs_adj(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(4)   # USE action

            # Identify which primitive cell we just used.
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                break  # safety

            # Update the simulated grid and remaining count.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            count -= 1

    # --------------------------------------------------------------
    # 2. Go to the workshop and craft the goal item.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_adj(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            plan.append(4)   # USE to craft at the workshop

    return plan


    # action indices (consistent with CraftLab.action_specs)
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}
    USE_ACT = 4

    from collections import deque
    import numpy as np

    def bfs_to_adjacent(start, targets, grid):
        """
        Bread‑first search returning a list of actions that moves the agent
        from ``start`` to any cell that is orthogonally adjacent to one of the
        ``targets`` (list of (x, y) tuples).  Cells that contain any
        non‑grabbable entity are treated as blocked.
        """
        W, H = grid.shape[:2]

        # blocked cells = any non‑grabbable entity present
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start

        # already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # check adjacency to any target
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacent cell
        return []

    # ------------------------------------------------------------------
    # Begin planning.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable simulation of the world
    pos = tuple(state.pos)            # (x, y)

    # Goal index is stored in the task (env.task.goal).  It may be an int
    # or a Struct; we only need the integer index.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # ------------------------------------------------------------------
    # 1. Determine primitive (and intermediate) requirements.
    # ------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 2. Collect each required primitive.
    # ------------------------------------------------------------------
    for kind_idx, count in needed.items():
        while count > 0:
            # locate all cells that currently contain this kind
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # primitive not present – cannot continue planning
                return plan

            # compute path to a cell adjacent to any of those primitive cells
            path = bfs_to_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # simulate movement
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # use action to pick up the primitive
            plan.append(USE_ACT)

            # find which primitive cell we are now adjacent to
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # safety fallback – should not happen
                break

            # update simulated grid (remove one instance of the primitive)
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            count -= 1

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be string name or already an int)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action at the workshop to craft the item
            plan.append(USE_ACT)

    # Return the complete action sequence
    return plan

