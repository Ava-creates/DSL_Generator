    # Action constants (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    ACTIONS = {(1, 0): DOWN, (-1, 0): UP, (0, -1): LEFT, (0, 1): RIGHT}

    # ------------------------------------------------------------------
    # Helper: BFS path finder that avoids any non‑empty cell.
    # It returns a list of actions that moves the agent from `start`
    # to a position adjacent to any of the `targets` (inclusive of the
    # possibility that `start` is already adjacent).
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        width, height, _ = grid.shape
        # Pre‑compute occupied cells (any non‑zero kind)
        occupied = np.any(grid > 0, axis=2)
        # Queue stores (x, y, path_actions)
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = set()
        visited.add(start)

        # Convert targets to a set for fast membership testing
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are adjacent (including diagonal) to a target, stop
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    # Already on the target (rare for primitives)
                    return path

            # Explore 4‑connected neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    if (nx, ny) in visited:
                        continue
                    # Can step on the cell if it is empty
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # If no path found, fall back to empty list
        return []

    # ------------------------------------------------------------------
    # Identify world and cookbook
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers store the world inside the current state
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook

    # Goal information (hard‑coded to "arrow")
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Obtain current state (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        # Reset the environment to obtain an initial state
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # current (x, y) position
    grid = state.grid                # (W, H, n_kinds)

    actions = []
    harvested = set()                # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, count_needed in primitives_needed.items():
        # Find all locations that currently contain this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Greedy nearest‑first ordering based on Manhattan distance
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= count_needed:
                break
            if loc in harvested:
                continue
            # Move to a cell adjacent to the primitive location
            path = _bfs_path(pos, [loc])
            actions.extend(path)
            # Update agent position after following the path
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use action to pick up the primitive (must be facing it)
            actions.append(USE)
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft at the appropriate workshop (if the recipe specifies one)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or already an integer)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key
        # Locate all workshop cells of the required type
        workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_locs:
            # Choose the nearest workshop
            workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_locs[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use action to craft at the workshop
            actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = {
        (0, 1): DOWN,
        (0, -1): UP,
        (-1, 0): LEFT,
        (1, 0): RIGHT,
    }

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------
    def bfs(start, goal, blocked):
        """Return a list of positions from start (exclusive) to goal (inclusive)."""
        if start == goal:
            return []
        q = deque([start])
        visited = {start}
        parent = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]:
                    if not blocked[nx, ny] and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        parent[(nx, ny)] = cur
                        q.append((nx, ny))
        else:
            # No path found – return empty list (will likely fail later)
            return []

        # reconstruct path
        path = []
        cur = goal
        while parent[cur] is not None:
            path.append(cur)
            cur = parent[cur]
        path.reverse()
        return path

    def path_to_actions(path, start_pos):
        """Convert a list of positions to action indices, assuming start_pos is the
        agent's current location."""
        actions = []
        cur = start_pos
        for nxt in path:
            dx = nxt[0] - cur[0]
            dy = nxt[1] - cur[1]
            act = DIRS.get((dx, dy))
            if act is None:
                # should not happen
                continue
            actions.append(act)
            cur = nxt
        return actions

    # ------------------------------------------------------------------
    # Identify world, cookbook and goal
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # CraftLab wraps a scenario; the underlying world is in the scenario
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook

    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Get current state (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        # reset the environment to obtain an initial state
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)            # (x, y)
    grid = state.grid                  # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Determine which cells are blocked (non‑grabbable entities)
    # ------------------------------------------------------------------
    non_grabbable = set(world.non_grabbable_indices)
    blocked = np.zeros(grid.shape[:2], dtype=bool)
    if non_grabbable:
        idxs = list(non_grabbable)
        blocked = np.any(grid[:, :, idxs] > 0, axis=2)

    actions = []
    used_cells = set()   # primitives already collected

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, need_cnt in primitives_needed.items():
        # locate all cells that currently contain this primitive
        prim_locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from current position (greedy)
        prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in prim_locs:
            if gathered >= need_cnt:
                break
            if loc in used_cells:
                continue

            # Find path to the primitive location (allow stepping onto it)
            path = bfs(pos, loc, blocked)
            actions.extend(path_to_actions(path, pos))
            pos = loc

            # Pick up the primitive
            actions.append(USE)
            used_cells.add(loc)
            gathered += 1

            # After pickup the cell becomes empty – update blocked map
            blocked[loc[0], loc[1]] = False

    # ------------------------------------------------------------------
    # Move to workshop (if recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or already an index)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key

        # Locate workshop cells
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            # Choose the nearest workshop
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_locs[0]

            # Path to workshop (treat workshop cell as passable)
            path = bfs(pos, target_ws, blocked)
            actions.extend(path_to_actions(path, pos))
            pos = target_ws

            # Craft at the workshop
            actions.append(USE)

    return actions

