    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Mapping from action index to (dx, dy)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def in_bounds(x, y, W, H):
        return 0 <= x < W and 0 <= y < H

    def walkable(grid, x, y):
        """A cell is walkable if it is inside the grid and contains no entities."""
        W, H = grid.shape[:2]
        if not in_bounds(x, y, W, H):
            return False
        return not np.any(grid[x, y, :])

    from collections import deque

    def bfs_to_target(cur_state, target_kind):
        """
        Bread‑first search that returns a list of movement actions (0‑3) which
        ends with the agent facing a cell that contains `target_kind`.
        Returns [] if already facing the target, or None if the target cannot
        be reached.
        """
        grid = cur_state.grid
        W, H = grid.shape[:2]
        sx, sy = cur_state.pos
        sdir = cur_state.dir

        # Already facing the target?
        dx, dy = deltas[sdir]
        fx, fy = sx + dx, sy + dy
        if in_bounds(fx, fy, W, H) and grid[fx, fy, target_kind] > 0:
            return []

        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy, W, H) and grid[fx, fy, target_kind] > 0:
                return actions
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for a single arrow.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:          # arrow itself is a primitive resource
        primitive_needs = {arrow_idx: 1}

    for kind_idx, required_cnt in primitive_needs.items():
        for _ in range(required_cnt):
            move_seq = bfs_to_target(state, kind_idx)
            if move_seq is None:    # unreachable primitive – abort planning
                return plan
            plan.extend(move_seq)
            plan.append(4)           # USE to pick up
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2. Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(state, workshop_idx)
        if move_seq is None:        # unreachable workshop – abort
            return plan
        plan.extend(move_seq)
        plan.append(4)               # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No dedicated workshop – craft in place.
        plan.append(4)
        _, state = state.step(4)

    return plan

