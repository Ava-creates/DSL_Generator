    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_to(cur_pos, target, seq):
        """Append actions to move from cur_pos to target (both [x, y] lists)."""
        while cur_pos[0] != target[0] or cur_pos[1] != target[1]:
            if cur_pos[0] < target[0]:
                seq.append(RIGHT)
                cur_pos[0] += 1
            elif cur_pos[0] > target[0]:
                seq.append(LEFT)
                cur_pos[0] -= 1
            elif cur_pos[1] < target[1]:
                seq.append(DOWN)
                cur_pos[1] += 1
            elif cur_pos[1] > target[1]:
                seq.append(UP)
                cur_pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Return [x, y] of the nearest cell containing kind_idx, or None."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Initialise planning state
    # ------------------------------------------------------------------
    actions = []

    # Current position (list so we can modify in‑place)
    if hasattr(env, "_current_state"):
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Working copy of the grid – we will zero out primitives once taken
    grid = env.scenario.init_grid.copy()

    # Goal item index
    goal_idx = env.task.goal

    # Shortcut references
    cookbook = env.world.cookbook
    primitives_set = cookbook.primitives
    recipes = cookbook.recipes
    init_grid = env.scenario.init_grid  # for locating static workshops

    # ------------------------------------------------------------------
    # Recursive planning function
    # ------------------------------------------------------------------
    def _ensure_item(item_idx):
        """Plan actions that guarantee one unit of item_idx in inventory."""
        # Primitive – just collect it from the world
        if item_idx in primitives_set:
            target = _nearest_kind(item_idx, cur_pos, grid)
            if target is None:
                # Primitive not found; give up planning
                return False
            _move_to(cur_pos, target, actions)
            actions.append(USE)           # pick up primitive
            grid[target[1], target[0], item_idx] = 0   # remove from copy
            return True

        # Non‑primitive – need to craft using its recipe
        recipe = recipes.get(item_idx)
        if recipe is None:
            # No way to obtain this item
            return False

        # First obtain all ingredients
        for ingr_idx, cnt in recipe.items():
            if ingr_idx == "_at":
                continue
            for _ in range(cnt):
                if not _ensure_item(ingr_idx):
                    return False

        # Then go to the required workshop (if any) and craft
        workshop_kind = recipe.get("_at")
        if workshop_kind is not None:
            # Workshops are static; locate them in the original grid
            ws_target = _nearest_kind(workshop_kind, cur_pos, init_grid)
            if ws_target is None:
                return False
            _move_to(cur_pos, ws_target, actions)
            actions.append(USE)   # craft at the workshop
        else:
            # No workshop specified – just use (should never happen)
            actions.append(USE)
        return True

    # ------------------------------------------------------------------
    # Start planning for the final goal
    # ------------------------------------------------------------------
    _ensure_item(goal_idx)

    # Return the full action sequence
    return actions


