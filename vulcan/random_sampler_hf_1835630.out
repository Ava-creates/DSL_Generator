    # Reset environment and extract useful references
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)

    # Action constants (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_free(cell):
        """Return True if `cell` is inside the grid and not blocked by a
        non‑grabbable entity."""
        y, x = cell
        if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):
            return False
        # Any non‑grabbable entity present?
        occupied = np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)
        return not occupied

    def free_adjacent(target):
        """Find a free orthogonal neighbour of `target`. Return None if none."""
        ty, tx = target
        for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            ny, nx = ty + dy, tx + dx
            if is_free((ny, nx)):
                return (ny, nx)
        return None

    def bfs_path(start, goal):
        """Return a list of actions (DOWN/UP/LEFT/RIGHT) that moves from
        `start` to `goal` using BFS while avoiding non‑grabbable cells."""
        if start == goal:
            return []

        from collections import deque
        queue = deque([start])
        # map position -> (parent_position, action_taken_to_reach)
        parent = {start: (None, None)}

        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            y, x = cur
            for (dy, dx), act in [((-1, 0), UP), ((1, 0), DOWN),
                                  ((0, -1), LEFT), ((0, 1), RIGHT)]:
                ny, nx = y + dy, x + dx
                nxt = (ny, nx)
                if not is_free(nxt):
                    continue
                if nxt not in parent:
                    parent[nxt] = (cur, act)
                    queue.append(nxt)

        if goal not in parent:
            # unreachable – return empty list
            return []

        # reconstruct actions
        actions_rev = []
        cur = goal
        while parent[cur][0] is not None:
            prev, act = parent[cur]
            actions_rev.append(act)
            cur = prev
        actions_rev.reverse()
        return actions_rev

    def turn_towards(src, dst):
        """Return a single turn action that makes `src` face `dst` (must be orthogonal)."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None  # same cell or not orthogonal

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell that contains an entity of `kind_idx`."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine goal and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in needed_prims.items():
        for _ in range(needed_cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Choose a free adjacent cell to stand on before using.
            adj = free_adjacent(target)
            if adj is None:
                # If no free neighbour, try standing on the primitive itself
                if is_free(target):
                    adj = target
                else:
                    # Unable to access this primitive; skip it.
                    continue

            # Move to the selected adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Turn towards the primitive (if we are not on the same cell).
            turn_act = turn_towards(cur_pos, target)
            if turn_act is not None:
                actions.append(turn_act)

            # Pick up the primitive.
            actions.append(USE)

            # Update internal grid copy to reflect that the primitive has been taken.
            ty, tx = target
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions


    # Reset environment and get initial state
    env.reset()
    state = env._current_state            # CraftState
    world = env.world                     # CraftWorld
    grid = state.grid.copy()              # (W, H, n_kinds)

    # Action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    moves = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def bfs_path(start, goals):
        """Bread‑first search from start to any cell in *goals*.
        Returns a list of actions (DOWN/UP/LEFT/RIGHT) to reach the first
        reachable goal, or an empty list if none reachable."""
        H, W = grid.shape[0], grid.shape[1]
        q = collections.deque()
        q.append(start)
        visited = {start: (None, None)}  # pos -> (parent_pos, action)
        goal_set = set(goals)

        while q:
            y, x = q.popleft()
            if (y, x) in goal_set:
                # reconstruct path
                actions = []
                cur = (y, x)
                while visited[cur][0] is not None:
                    parent, act = visited[cur]
                    actions.append(act)
                    cur = parent
                actions.reverse()
                return actions
            for dy, dx, act in moves:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W:
                    if (ny, nx) in visited:
                        continue
                    # cell is free if no entity occupies it
                    if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                        continue
                    visited[(ny, nx)] = ((y, x), act)
                    q.append((ny, nx))
        return []  # no reachable goal

    def nearest_cells_of(kind_idx, from_pos):
        """Return list of free cells adjacent to any occurrence of *kind_idx*."""
        occ = np.argwhere(grid[:, :, kind_idx] > 0)
        cells = set()
        H, W = grid.shape[0], grid.shape[1]
        for (y, x) in occ:
            for dy, dx, _ in moves:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W:
                    # free cell?
                    if not np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                        cells.add((ny, nx))
        return list(cells)

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Find reachable adjacent cell to the nearest primitive of this type
            candidate_cells = nearest_cells_of(prim_idx, cur_pos)
            if not candidate_cells:
                # No reachable primitive – abort early
                return actions
            path = bfs_path(cur_pos, candidate_cells)
            if not path:
                # Unreachable
                return actions
            actions.extend(path)
            # Update current position after following the path
            for act in path:
                if act == DOWN:
                    cur_pos = (cur_pos[0] + 1, cur_pos[1])
                elif act == UP:
                    cur_pos = (cur_pos[0] - 1, cur_pos[1])
                elif act == LEFT:
                    cur_pos = (cur_pos[0], cur_pos[1] - 1)
                elif act == RIGHT:
                    cur_pos = (cur_pos[0], cur_pos[1] + 1)

            # At this point we stand on a free cell adjacent to the primitive.
            # Use the primitive.
            actions.append(USE)

            # Remove the primitive from the grid (simulate collection)
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size > 0:
                # take the first one (the one we were adjacent to)
                y, x = prim_cells[0]
                grid[y, x, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the goal
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_adj_cells = nearest_cells_of(ws_idx, cur_pos)
        if ws_adj_cells:
            ws_path = bfs_path(cur_pos, ws_adj_cells)
            actions.extend(ws_path)
            # update position after moving to workshop adjacency
            for act in ws_path:
                if act == DOWN:
                    cur_pos = (cur_pos[0] + 1, cur_pos[1])
                elif act == UP:
                    cur_pos = (cur_pos[0] - 1, cur_pos[1])
                elif act == LEFT:
                    cur_pos = (cur_pos[0], cur_pos[1] - 1)
                elif act == RIGHT:
                    cur_pos = (cur_pos[0], cur_pos[1] + 1)

    # Final USE to craft the arrow
    actions.append(USE)

    return actions

