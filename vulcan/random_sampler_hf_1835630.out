    import numpy as np
    from collections import deque

    # Action indices (standard for CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # Mapping action → (dx, dy)
    _DELTA = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }
    # Mapping direction → opposite action
    _OPPOSITE = {RIGHT: LEFT, LEFT: RIGHT, DOWN: UP, UP: DOWN}

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell adjacent to any of `targets`.  Cells that contain
    # any non‑zero kind are treated as obstacles.
    # ------------------------------------------------------------------
    def _bfs_adj(start, targets, occ_grid):
        w, h = occ_grid.shape
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours
            for act, (dx, dy) in _DELTA.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ_grid[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacency – return empty path
        return []

    # ------------------------------------------------------------------
    # Helper: turn the agent to face `needed_dir` while staying on the
    # same cell (by a two‑step detour if necessary).  Returns a list of
    # actions that achieve the turn and updates `pos` and `direction`.
    # ------------------------------------------------------------------
    def _turn_to(pos, direction, needed_dir, occ_grid):
        actions = []
        if direction == needed_dir:
            return actions, pos, direction
        # Try a simple two‑step detour: step opposite, then needed_dir
        opp = _OPPOSITE[needed_dir]
        dx_opp, dy_opp = _DELTA[opp]
        nx, ny = pos[0] + dx_opp, pos[1] + dy_opp
        w, h = occ_grid.shape
        if 0 <= nx < w and 0 <= ny < h and not occ_grid[nx, ny]:
            actions.extend([opp, needed_dir])
            pos = (nx, ny)                     # after opposite step
            pos = (pos[0] + _DELTA[needed_dir][0],
                   pos[1] + _DELTA[needed_dir][1])  # back to original
            direction = needed_dir
        else:
            # If opposite cell blocked, just move in needed direction
            # (may hit a wall – but we assume at least one free neighbour)
            actions.append(needed_dir)
            pos = (pos[0] + _DELTA[needed_dir][0],
                   pos[1] + _DELTA[needed_dir][1])
            direction = needed_dir
        return actions, pos, direction

    # ------------------------------------------------------------------
    # Locate world / cookbook objects
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = state_wrapper.world
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Identify goal (hard‑coded to "arrow") and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in cookbook.")
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    direction = int(state.dir)      # current facing direction
    grid = state.grid.copy()        # mutable copy for planning

    # Occupancy map (True where any kind occupies the cell)
    occupied = np.any(grid > 0, axis=2)

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells that currently hold this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            # Plan path to a cell adjacent to the primitive
            path = _bfs_adj(pos, [loc], occupied)
            actions.extend(path)
            # Simulate movement to update position & direction
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)
                direction = act
            # Determine direction needed to face the primitive
            if loc[0] > pos[0]:
                needed_dir = RIGHT
            elif loc[0] < pos[0]:
                needed_dir = LEFT
            elif loc[1] > pos[1]:
                needed_dir = DOWN
            else:
                needed_dir = UP
            # Turn if necessary
            turn_actions, pos, direction = _turn_to(pos, direction, needed_dir, occupied)
            actions.extend(turn_actions)
            # Pick up the primitive
            actions.append(USE)
            # Update planning structures
            grid[loc[0], loc[1], prim_idx] = 0
            occupied[loc[0], loc[1]] = False
            gathered += 1

    # ------------------------------------------------------------------
    # Craft at the required workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)
        # Locate workshop cells
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to workshop
            path = _bfs_adj(pos, [target_ws], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)
                direction = act
            # Face the workshop
            if target_ws[0] > pos[0]:
                needed_dir = RIGHT
            elif target_ws[0] < pos[0]:
                needed_dir = LEFT
            elif target_ws[1] > pos[1]:
                needed_dir = DOWN
            else:
                needed_dir = UP
            turn_actions, pos, direction = _turn_to(pos, direction, needed_dir, occupied)
            actions.extend(turn_actions)
            # Craft the arrow
            actions.append(USE)
        else:
            # No visible workshop – just use at current location
            actions.append(USE)
    else:
        # No specific workshop required
        actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Action constants and movement deltas
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    _DELTA = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a path (list of actions) taking the agent
    # from `start` to any free cell adjacent to any cell in `targets`.
    # The grid is treated as occupied wherever any kind is present.
    # ------------------------------------------------------------------
    def _bfs_adj(start, targets, cur_grid):
        w, h, _ = cur_grid.shape
        occupied = np.any(cur_grid > 0, axis=2)  # True where any entity blocks movement
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency to any target location
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path, (x, y)
            # Expand neighbours
            for act, (dx, dy) in _DELTA.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell – return empty path and original position
        return [], start

    # ------------------------------------------------------------------
    # Retrieve world and cookbook objects from the environment
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = state_wrapper.world
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance from the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Identify the goal ("arrow") and the primitives required to craft it
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in cookbook.")
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # current (x, y) position
    grid = state.grid.copy()        # mutable copy for planning

    actions = []                    # final list of action indices to return
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locate all cells that currently contain this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from the agent for efficiency
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue

            # Plan a path to a free cell adjacent to the primitive
            path, new_pos = _bfs_adj(pos, [loc], grid)
            actions.extend(path)
            # Simulate moving along the path to update our internal position
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Face the primitive by issuing the movement action towards it
            # (the cell is occupied, so the move will be blocked but will set direction)
            if loc[0] > pos[0]:
                face_act = RIGHT
            elif loc[0] < pos[0]:
                face_act = LEFT
            elif loc[1] > pos[1]:
                face_act = DOWN
            else:
                face_act = UP
            actions.append(face_act)          # direction is now towards the primitive
            # No position change because the cell is occupied

            # Pick up the primitive
            actions.append(USE)

            # Update planning structures
            harvested.add(loc)
            gathered += 1
            grid[loc[0], loc[1], prim_idx] = 0   # primitive removed from the world

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a string name or an integer)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        # Locate workshop cells
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]

            # Move adjacent to the workshop
            path, new_pos = _bfs_adj(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Face the workshop
            if target_ws[0] > pos[0]:
                face_act = RIGHT
            elif target_ws[0] < pos[0]:
                face_act = LEFT
            elif target_ws[1] > pos[1]:
                face_act = DOWN
            else:
                face_act = UP
            actions.append(face_act)

            # Craft the arrow
            actions.append(USE)
        else:
            # No visible workshop; just attempt to craft at current location
            actions.append(USE)
    else:
        # No specific workshop required – use current location
        actions.append(USE)

    # Return the complete action sequence
    return actions

