    # ... code ...


    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    moves = [
        ((0, 1), DOWN),   # down
        ((0, -1), UP),    # up
        ((-1, 0), LEFT),  # left
        ((1, 0), RIGHT),  # right
    ]

    def bfs_path(start, goal, grid):
        """Return a list of actions moving from start to goal using BFS.
        Cells with any non‑zero kind are considered blocked, except the goal
        cell itself (which may contain the target item)."""
        w, h = grid.shape[0], grid.shape[1]
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # Goal cell may be occupied (item we want to pick up)
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []   # no reachable path
        # reconstruct
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell (Manhattan) that contains the given kind."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if len(xs) == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Planning
    # ----------------------------------------------------------------------
    actions = []

    # Determine current position (use live state if available)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the static grid for planning purposes
    grid = env.scenario.init_grid.copy()

    # Goal item index
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal
    # ------------------------------------------------------------------
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, needed in primitive_requirements.items():
        for _ in range(needed):
            target = nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # primitive not found – abort planning
                return actions
            actions.extend(bfs_path(cur_pos, target, grid))
            actions.append(USE)                     # pick up the primitive
            grid[target[0], target[1], prim_kind] = 0   # remove from simulated grid
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)   # perform crafting at the workshop
            cur_pos = workshop_pos

    # Return the complete action sequence
    return actions

