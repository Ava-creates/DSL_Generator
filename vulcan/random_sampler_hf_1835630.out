    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # dict kind->count

    for kind, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = bfs_to_target(state, kind)
            if not move_seq and not state.next_to(kind):
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE
            for a in move_seq + [4]:
                _, state = state.step(a)

    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        wk_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(state, wk_idx)
        actions.extend(move_seq)
        actions.append(4)
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        actions.append(4)
        _, state = state.step(4)

    return actions


    env.reset()
    cur_state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) which
    # bring the agent to a position where the cell directly in front
    # contains `target_kind`. Returns [] if the target cannot be reached.
    # ------------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def _in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def _walkable(x, y):
            if not _in_bounds(x, y):
                return False
            # a cell is walkable if it contains no entities at all
            return not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = state.pos
        sd = state.dir
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not _walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))

        return []

    actions = []

    # ------------------------------------------------------------------
    # Gather all primitive resources required for a single arrow.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_actions = _bfs_to_target(cur_state, prim_idx)
            if not move_actions and not cur_state.next_to(prim_idx):
                # Target unreachable – abort early.
                return actions
            actions.extend(move_actions)
            actions.append(4)                     # USE to pick up
            for a in move_actions + [4]:
                _, cur_state = cur_state.step(a)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_actions = _bfs_to_target(cur_state, workshop_idx)
        actions.extend(move_actions)
        actions.append(4)                     # USE to craft
        for a in move_actions + [4]:
            _, cur_state = cur_state.step(a)
    else:
        actions.append(4)                     # USE to craft in place
        _, cur_state = cur_state.step(4)

    return actions

