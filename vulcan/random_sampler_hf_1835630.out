    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks
        from ``start`` to ``goal`` using Manhattan distance. No obstacle
        checking is performed."""
        actions = []
        y, x = start
        gy, gx = goal
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind, from_pos):
        """Find the nearest cell that contains ``kind`` (primitive or workshop)."""
        locations = np.argwhere(grid[:, :, kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = int(np.argmin(dists))
        return tuple(locations[nearest_idx])

    # Goal index for the arrow and the primitives required to craft it.
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not found – abort early.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on before using.
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # Fallback: stand directly on the primitive cell.
                adj = target

            # Move to the adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (a blocked move updates direction).
            dy = ty - cur_pos[0]
            dx = tx - cur_pos[1]
            if dy > 0:
                actions.append(DOWN)
            elif dy < 0:
                actions.append(UP)
            elif dx > 0:
                actions.append(RIGHT)
            elif dx < 0:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions


