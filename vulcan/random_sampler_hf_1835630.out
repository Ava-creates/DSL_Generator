    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Determine current agent position (live state if available)
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)      # [x, y]
    else:
        cur_pos = list(env.scenario.init_pos)       # [x, y]

    # Copy of the static grid so we can mark items as taken
    grid = env.scenario.init_grid.copy()

    actions = []

    # ------------------------------------------------------------------
    # Helper: move from cur_pos to target, appending actions to seq
    # ------------------------------------------------------------------
    def _move_to(pos, target, seq):
        """Append actions that move the agent from `pos` to `target`."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    # ------------------------------------------------------------------
    # Helper: locate nearest cell (x, y) that contains the given kind index
    # ------------------------------------------------------------------
    def _nearest_kind(kind_idx, cur, g):
        """Return [x, y] of the nearest cell with `kind_idx`, or None."""
        ys, xs = np.where(g[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the goal item
    # ------------------------------------------------------------------
    goal_idx = env.task.goal  # integer index of the target item
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()

    # If the goal itself is a primitive, we must also pick it up.
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for kind_idx, count in primitive_needs.items():
        for _ in range(count):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Required primitive not present; abort planning.
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)  # pick up the primitive
            # Mark the item as taken in our copy of the grid.
            grid[target[1], target[0], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2. If the recipe specifies a workshop, go there and craft the item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)  # craft at the workshop

    # ------------------------------------------------------------------
    # Return the planned sequence of actions
    # ------------------------------------------------------------------
    return actions


    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    actions = []

    # ------------------------------------------------------------------
    # Determine current position (live state if available, else start pos)
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)          # [x, y]
    else:
        cur_pos = list(env.scenario.init_pos)           # [x, y]

    # Work on a mutable copy of the static grid to track taken items
    grid = env.scenario.init_grid.copy()

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_to(pos, target, seq):
        """Append moves that bring `pos` (list [x, y]) to `target` (list [x, y])."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur, g):
        """Return coordinates [x, y] of the nearest cell containing `kind_idx`."""
        ys, xs = np.where(g[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal item
    # ------------------------------------------------------------------
    goal_idx = env.task.goal                                 # integer index of target
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    for prim_kind, count in primitive_requirements.items():
        for _ in range(count):
            target = _nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive missing – abort planning; return what we have so far
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)                               # pick up primitive
            grid[target[1], target[0], prim_kind] = 0         # mark cell as empty

    # ------------------------------------------------------------------
    # 2. If the recipe specifies a workshop, move there and craft the item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)                               # craft at workshop

    # ------------------------------------------------------------------
    # Return the complete planned action sequence
    # ------------------------------------------------------------------
    return actions

