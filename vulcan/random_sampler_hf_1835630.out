    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    def bfs_adjacent(start, targets, blocked):
        """Return a list of actions that moves the agent from ``start`` to a
        cell adjacent (Manhattan distance 1) to any coordinate in ``targets``,
        avoiding cells where ``blocked`` is True."""
        W, H = blocked.shape
        sx, sy = start

        # already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.zeros((W, H), dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Initialise current state
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy for simulation
    pos = tuple(state.pos)            # (x, y)

    # goal index stored in the task (env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        return []

    # primitives (or intermediate items) required for the goal
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    def blocked_mask(g):
        """Boolean mask where True indicates an impassable cell."""
        return np.any(g > 0, axis=2)

    # --------------------------------------------------------------
    # 1. Collect required primitives.
    # --------------------------------------------------------------
    for kind_idx, count in needed.items():
        while count > 0:
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # no more of this primitive on the map – abort planning
                return plan

            blk = blocked_mask(grid)
            path = bfs_adjacent(pos, cells.tolist(), blk)
            plan.extend(path)

            # simulate movement
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # pick up the primitive
            plan.append(4)   # USE

            # locate the primitive cell we just used (adjacent to current pos)
            used_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    used_cell = (cx, cy)
                    break
            if used_cell is None:
                break  # safety

            # update simulated grid and remaining count
            grid[used_cell[0], used_cell[1], kind_idx] -= 1
            count -= 1

    # --------------------------------------------------------------
    # 2. Move to the workshop and craft the goal item.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size > 0:
            blk = blocked_mask(grid)
            path = bfs_adjacent(pos, ws_cells.tolist(), blk)
            plan.extend(path)

            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            plan.append(4)   # USE to craft at the workshop

    return plan


    # map direction vectors to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)
    DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    from collections import deque
    import numpy as np

    def bfs_adjacent(start, targets, blocked):
        """Return a list of actions moving from ``start`` to a cell adjacent to any
        coordinate in ``targets`` while avoiding cells where ``blocked`` is True."""
        W, H = blocked.shape
        sx, sy = start

        # already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.zeros((W, H), dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Initialise current state
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()                 # mutable copy for planning
    pos = tuple(state.pos)                   # (x, y)

    # Goal index is stored in env.task.goal (or env.task.goal_idx)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        goal_idx = getattr(env.task, "goal_idx", None)
    if goal_idx is None:
        return []  # cannot determine goal

    # ------------------------------------------------------------------
    # Determine primitive (or intermediate) requirements for the goal
    # ------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # Pre‑compute blocked cells mask (non‑grabbable entities block movement)
    def compute_blocked(g):
        blocked = np.zeros(g.shape[:2], dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= g[:, :, idx] > 0
        return blocked

    # ------------------------------------------------------------------
    # 1. Collect required primitives / intermediate items
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        while cnt > 0:
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # required item not present on map – abort planning
                return plan

            blocked_mask = compute_blocked(grid)
            path = bfs_adjacent(pos, cells.tolist(), blocked_mask)
            plan.extend(path)

            # simulate movement
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # use action to pick up
            plan.append(4)   # USE

            # find which cell we just used (adjacent)
            used_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    used_cell = (cx, cy)
                    break
            if used_cell is None:
                break  # safety

            # update simulated grid
            grid[used_cell[0], used_cell[1], kind_idx] -= 1
            cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to workshop and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # resolve workshop index
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            blocked_mask = compute_blocked(grid)
            path = bfs_adjacent(pos, workshop_cells.tolist(), blocked_mask)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            plan.append(4)   # USE to craft at workshop

    return plan

