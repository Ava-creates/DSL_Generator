    # code...


    import numpy as np
    from collections import deque

    # Action indices as defined in CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and fetch the current state / world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Goal item (arrow) and its primitive requirements
    goal_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Indices that truly block movement (non‑grabbable and not a workshop)
    blocked_idxs = list(set(world.non_grabbable_indices) - set(world.workshop_indices))

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(pos):
        """Return True if the cell at ``pos`` contains a blocking entity."""
        y, x = pos
        return np.any(grid[y, x, blocked_idxs] > 0)

    def bfs(start, goal):
        """Shortest walkable path (list of positions) from start to goal."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y-1, x), (y+1, x), (y, x-1), (y, x+1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            return []   # unreachable

        # reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions to movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the closest cell that currently contains ``kind``."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    # ------------------------------------------------------------------
    # Build the action list
    # ------------------------------------------------------------------
    actions = []
    cur = tuple(state.pos)

    # Collect each primitive the required number of times
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = nearest_cell(prim_idx, cur)
            if target is None:
                # Primitive missing – abort early
                return actions

            # Move to the primitive cell
            path = bfs(cur, target)
            if not path and cur != target:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = target

            # Pick it up
            actions.append(USE)

            # Remove it from the planning grid
            grid[target[0], target[1], prim_idx] = 0

    # If the recipe specifies a workshop, move there before crafting
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs(cur, ws_loc)
            if path:
                actions.extend(path_to_actions([cur] + path))
                cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions

