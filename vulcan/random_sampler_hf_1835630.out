    import collections, numpy as np

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_path(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    # Retrieve world and cookbook
    world = getattr(env, "world", None)
    if world is None:
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = state_tmp.world
    cookbook = world.cookbook

    # Goal is hard‑coded to "arrow"
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Ensure we have a current state
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)               # (x, y)
    cur_grid = state.grid.copy()         # mutable copy
    occ = np.any(cur_grid > 0, axis=2)   # occupied cells mask

    actions = []
    harvested = set()

    # Collect required primitives
    for prim_idx, needed in primitives_needed.items():
        cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        gathered = 0
        for cell in cells:
            if gathered >= needed:
                break
            if cell in harvested:
                continue
            path = _bfs_path(pos, [cell], occ)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
            cur_grid[cell[0], cell[1], prim_idx] = 0
            occ[cell[0], cell[1]] = False
            harvested.add(cell)
            gathered += 1

    # Craft at the required workshop, if any
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_path(pos, [target_ws], occ)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)

    return actions

