    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Mapping from action index to movement delta (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1),   # DOWN
              1: (0, -1),  # UP
              2: (-1, 0),  # LEFT
              3: (1, 0)}   # RIGHT

    # Helper utilities -------------------------------------------------
    def in_bounds(x, y, W, H):
        return 0 <= x < W and 0 <= y < H

    def walkable(grid, x, y):
        W, H = grid.shape[:2]
        return in_bounds(x, y, W, H) and not np.any(grid[x, y, :])

    def target_ahead(st, kind):
        x, y = st.pos
        d = st.dir
        dx, dy = deltas[d]
        fx, fy = x + dx, y + dy
        W, H = st.grid.shape[:2]
        return in_bounds(fx, fy, W, H) and st.grid[fx, fy, kind] > 0

    from collections import deque

    def bfs_to_target(st, kind):
        """Return a list of movement actions (0‑3) that leaves the agent
        facing a cell containing `kind`. Returns None if unreachable."""
        grid = st.grid
        W, H = grid.shape[:2]
        sx, sy = st.pos
        sdir = st.dir
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}
        while q:
            x, y, d, seq = q.popleft()
            # Check if the cell in front contains the target kind
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy, W, H) and grid[fx, fy, kind] > 0:
                return seq
            # Expand possible moves
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))
        return None

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all primitive resources required for one arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:
        # Arrow itself may be a primitive (e.g., already present)
        primitive_needs = {arrow_idx: 1}

    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            seq = bfs_to_target(state, prim_idx)
            if seq is None:
                # Cannot reach a required primitive – abort planning
                return actions
            actions.extend(seq)
            actions.append(4)  # USE to pick up
            # Simulate the actions so subsequent planning sees the updated state
            for a in seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its designated workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = bfs_to_target(state, workshop_idx)
        if seq is None:
            # Workshop unreachable – abort
            return actions
        actions.extend(seq)
        actions.append(4)  # USE to craft
        for a in seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop; craft in place
        actions.append(4)
        _, state = state.step(4)

    return actions

