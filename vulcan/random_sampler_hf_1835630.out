    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # movement deltas and corresponding action indices
    moves = [((0, 1), DOWN), ((0, -1), UP), ((-1, 0), LEFT), ((1, 0), RIGHT)]

    def bfs_path(start, goal, grid):
        """Return a list of actions to move from start to goal using BFS.
        Cells occupied by any kind are treated as blocked, except the goal cell."""
        w, h = grid.shape[0], grid.shape[1]
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if (x, y) == tuple(goal):
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []  # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell containing the given kind index.
        Returns [x, y] or None if not found."""
        xs, ys = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Determine current agent position (live state if available)
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)          # [x, y]
    else:
        cur_pos = list(env.scenario.init_pos)           # [x, y]

    # Copy of the static grid so we can mark items as taken
    grid = env.scenario.init_grid.copy()

    actions = []

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the goal item
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()

    # If the goal itself is a primitive, we must also pick it up.
