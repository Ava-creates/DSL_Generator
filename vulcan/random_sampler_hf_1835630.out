import numpy as np

def make_arrow_vn(env):
    """
    Generate a list of actions that makes an ``arrow`` in the given CraftLab
    environment.  The function works generically for any recipe that can be
    expressed as a set of primitive ingredients and a single workshop where the
    final crafting takes place.

    The returned list contains the action indices that can be fed directly to
    ``env.step``.  The function also steps the environment while building the
    plan so that the internal state stays in sync.
    """
    # ----------------------------------------------------------------------
    # Helper: move the agent from its current position to a target cell.
    # ----------------------------------------------------------------------
    def _move_to(target, state, specs):
        """Return a list of movement actions that brings the agent next to *target*."""
        actions = []
        # target is a (row, col) coordinate.  We stop when we are on the same cell.
        while (state.pos[0], state.pos[1]) != (target[0], target[1]):
            cur_r, cur_c = state.pos
            trg_r, trg_c = target
            if cur_r < trg_r:
                act = specs["DOWN"]
            elif cur_r > trg_r:
                act = specs["UP"]
            elif cur_c < trg_c:
                act = specs["RIGHT"]
            else:  # cur_c > trg_c
                act = specs["LEFT"]
            actions.append(act)
            # step the environment so that ``state`` stays up‑to‑date
            _, _, _ = env.step(act)
            state = env._current_state
        return actions

    # ----------------------------------------------------------------------
    # Initialise the episode.
    # ----------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world
    specs = env.action_specs()          # mapping name → integer action id

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe.
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index[goal_name]

    # Primitive requirements for one arrow.
    prim_req = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    # Full recipe (ingredients + workshop info).
    recipe = world.cookbook.recipes[goal_idx]

    plan_actions = []

    # ----------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ----------------------------------------------------------------------
    for prim_idx, needed in prim_req.items():
        for _ in range(needed):
            # Locate the primitive on the current grid.
            locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                raise RuntimeError(f"Primitive {prim_idx} not found on the map.")
            target = tuple(locations[0])   # pick the first occurrence

            # Move to the primitive and pick it up (USE).
            plan_actions += _move_to(target, state, specs)
            plan_actions.append(specs["USE"])
            _, _, _ = env.step(specs["USE"])
            state = env._current_state

    # ----------------------------------------------------------------------
    # Move to the required workshop and craft the arrow.
    # ----------------------------------------------------------------------
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        raise RuntimeError("No workshop specified for the arrow recipe.")
    workshop_idx = world.cookbook.index[workshop_name]

    # Find any workshop cell.
    ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if ws_locs.size == 0:
        raise RuntimeError("Workshop not present on the map.")
    workshop_cell = tuple(ws_locs[0])

    # Move to the workshop and use (craft).
    plan_actions += _move_to(workshop_cell, state, specs)
    plan_actions.append(specs["USE"])
    _, _, _ = env.step(specs["USE"])

    # Return the complete list of actions.
    return plan_actions


    # Helper: BFS to reach a state where the cell in front contains the target kind.
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        w, h = grid.shape[:2]
        # Directions: 0 DOWN, 1 UP, 2 LEFT, 3 RIGHT
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }
        non_grab = env.world.non_grabbable_indices

        def in_bounds(x, y):
            return 0 <= x < w and 0 <= y < h

        def walkable(x, y):
            if not in_bounds(x, y):
                return False
            # any entity (including target) blocks movement
            return not np.any(grid[x, y, list(non_grab)]) and not np.any(grid[x, y, :])

        start_pos = state.pos
        start_dir = state.dir
        from collections import deque
        queue = deque()
        queue.append((start_pos[0], start_pos[1], start_dir, []))
        visited = set()
        visited.add((start_pos[0], start_pos[1], start_dir))

        while queue:
            x, y, d, acts = queue.popleft()
            # check if the cell in front contains the target
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts
            # expand moves
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))
        # No path found – return empty list (will cause failure later)
        return []

    actions = []
    # Current mutable state reference
    cur_state = env._current_state
    world = env.world
    goal_idx = env.task.goal

    # Determine primitive requirements for the goal
    primitive_reqs = world.cookbook.primitives_for(goal_idx)

    # Determine workshop kind for the goal (if any)
    workshop_kind = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    if isinstance(recipe, dict):
        workshop_kind = recipe.get('_at')

    # Collect each required primitive the necessary number of times
    for prim_kind, count in primitive_reqs.items():
        for _ in range(count):
            move_actions = _bfs_to_target(cur_state, prim_kind)
            actions.extend(move_actions)
            actions.append(4)  # USE to pick up the primitive
            # Apply actions to keep cur_state in sync
            for a in move_actions + [4]:
                _, cur_state = cur_state.step(a)

    # Finally, go to the appropriate workshop and use it to craft the goal item
    if workshop_kind is not None:
        move_actions = _bfs_to_target(cur_state, workshop_kind)
        actions.extend(move_actions)
        actions.append(4)  # USE to craft at the workshop
        # (optional) apply these actions to cur_state for completeness
        for a in move_actions + [4]:
            _, cur_state = cur_state.step(a)

    return actions

