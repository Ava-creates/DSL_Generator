    # Retrieve the world and ensure we have access to the cookbook
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Target item index for “arrow”
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Starting state of the episode
    try:
        start_state = scenario.init()
    except Exception:
        return []

    # Primitive requirements for a single arrow (may be empty if arrow is primitive)
    primitive_reqs = world.cookbook.primitives_for(target_idx)

    # Workshop kind required for crafting the arrow (if any)
    workshop_idx = None
    recipe = world.cookbook.recipes.get(target_idx, {})
    if "_at" in recipe:
        workshop_idx = recipe["_at"]

    # Helper: Manhattan distance between two points
    def manhattan(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    # Helper: find the nearest cell (Manhattan) that contains a given kind
    def nearest_distance(state, kind_idx):
        positions = np.argwhere(state.grid[:, :, kind_idx] > 0)
        if positions.size == 0:
            return None
        dists = np.abs(positions - np.array(state.pos)).sum(axis=1)
        return int(dists.min())

    # Heuristic for A*:
    #   - If we still need primitives, distance to the closest needed primitive.
    #   - Otherwise, distance to the workshop (if known).
    def heuristic(state):
        # Check missing primitives
        missing = []
        for pid, cnt in primitive_reqs.items():
            if state.inventory[pid] < cnt:
                missing.append(pid)
        if missing:
            dists = [nearest_distance(state, pid) for pid in missing]
            dists = [d for d in dists if d is not None]
            return min(dists) if dists else 0
        # All primitives satisfied – head to workshop if needed
        if workshop_idx is not None:
            d = nearest_distance(state, workshop_idx)
            return d if d is not None else 0
        return 0

    from collections import deque, namedtuple
    import heapq

    Node = namedtuple("Node", ["state", "actions", "g"])

    def state_hash(st):
        # Unique identifier for a state (position, direction, inventory, grid)
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {state_hash(start_state)}
    # priority queue: (f = g + h, g, Node)
    frontier = []
    start_h = heuristic(start_state)
    heapq.heappush(frontier, (start_h, 0, Node(start_state, [], 0)))

    MAX_STEPS = 500
    n_actions = getattr(world, "n_actions", 5)  # typical actions: 0‑4

    while frontier:
        _, g, node = heapq.heappop(frontier)
        cur_state = node.state

        # Goal check
        if cur_state.satisfies("", target_idx):
            return node.actions

        if g >= MAX_STEPS:
            continue

        # Expand possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = state_hash(nxt_state)
            if h in visited:
                continue
            visited.add(h)
            new_actions = node.actions + [a]
            new_g = g + 1
            f = new_g + heuristic(nxt_state)
            heapq.heappush(frontier, (f, new_g, Node(nxt_state, new_actions, new_g)))

    # If we exhaust the search without finding a plan, return empty list
    return []


    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
