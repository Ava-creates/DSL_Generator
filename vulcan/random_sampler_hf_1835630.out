    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    # Map direction vectors to action indices
    DIRS = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    def bfs_path(start, goal):
        """Return a list of actions (DOWN/UP/LEFT/RIGHT) that moves the
        agent from ``start`` to ``goal`` while avoiding non‑grabbable cells.
        If no path is found, returns an empty list."""
        if start == goal:
            return []
        W, H = grid.shape[0], grid.shape[1]
        blocked_kinds = list(world.non_grabbable_indices)

        visited = np.full((W, H), False, dtype=bool)
        prev = dict()  # (y,x) -> (prev_y, prev_x, action)

        q = deque()
        q.append(start)
        visited[start] = True

        while q:
            y, x = q.popleft()
            for (dy, dx), act in DIRS.items():
                ny, nx = y + dy, x + dx
                if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:
                    # cell is free if none of the blocked kinds are present
                    if not np.any(grid[ny, nx, blocked_kinds] > 0):
                        visited[ny, nx] = True
                        prev[(ny, nx)] = (y, x, act)
                        if (ny, nx) == goal:
                            # reconstruct path
                            actions = []
                            cur = (ny, nx)
                            while cur != start:
                                py, px, a = prev[cur]
                                actions.append(a)
                                cur = (py, px)
                            actions.reverse()
                            return actions
                        q.append((ny, nx))
        # No path found
        return []

    def find_nearest(cell_kind, from_pos):
        """Find the nearest cell containing ``cell_kind`` (primitive or workshop)
        using Manhattan distance. Returns coordinates (y, x) or None."""
        locations = np.argwhere(grid[:, :, cell_kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = np.argmin(dists)
        return tuple(locations[nearest_idx])

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Move to the primitive cell (standing on it is sufficient for USE)
            move_actions = bfs_path(cur_pos, target)
            actions.extend(move_actions)
            cur_pos = target

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if the recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions.extend(bfs_path(cur_pos, ws_cell))
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions

