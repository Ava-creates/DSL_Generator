    # Action constants as defined in CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Initialise environment and obtain a mutable copy of the grid for planning
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid.copy()             # (H, W, n_kinds) mutable copy

    # Goal item index and its primitive requirements
    goal_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    non_grab = list(world.non_grabbable_indices)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(pos):
        """Return True if a non‑grabbable entity occupies ``pos``."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def astar_path(start, goal):
        """A* search on the 4‑connected grid avoiding blocked cells.
        Returns a list of positions from ``start`` (excluded) to ``goal`` (included)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        open_set = []
        heapq.heappush(open_set, (0 + manhattan(start, goal), 0, start, None))
        came_from = {}
        g_score = {start: 0}
        while open_set:
            _, cur_g, cur, parent = heapq.heappop(open_set)
            if cur in came_from:
                continue
            came_from[cur] = parent
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if is_blocked(nxt):
                        continue
                    tentative_g = cur_g + 1
                    if tentative_g < g_score.get(nxt, float('inf')):
                        g_score[nxt] = tentative_g
                        f = tentative_g + manhattan(nxt, goal)
                        heapq.heappush(open_set, (f, tentative_g, nxt, cur))
        else:
            return []   # unreachable

        # reconstruct path (exclude start)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    def manhattan(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    def path_to_actions(path):
        """Convert a list of positions to movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the nearest cell containing ``kind`` (Manhattan distance)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of ``target`` (preferring N, S, W, E)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        # fallback – if no free neighbour, just use the target cell itself
        return target

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = tuple(state.pos)   # current position (y, x)

    # Collect each required primitive the needed number of times
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # primitive missing – abort early
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = astar_path(cur, stand_pos)
            if not path and cur != stand_pos:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive cell itself
            path = astar_path(cur, prim_loc)
            if not path and cur != prim_loc:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid to reflect removal of the primitive
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = astar_path(cur, ws_loc)
            if path:
                actions.extend(path_to_actions([cur] + path))
                cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions


