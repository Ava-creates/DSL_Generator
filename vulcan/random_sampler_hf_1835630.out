    # Reset environment and get initial references
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ----------------------------------------------------------------------
    # Helper: Bread‑first search that returns a list of movement actions
    # (0‑3) which brings the agent to a cell where the tile directly in front
    # of the agent contains `target_kind`.  Returns [] if already adjacent.
    # ----------------------------------------------------------------------
    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # Mapping from action index to (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def _in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def _walkable(x, y):
            # A cell is walkable if it is inside the grid and contains no entities
            return _in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = cur_state.pos
        sd = cur_state.dir
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                # Target is directly in front – we have found a solution
                return acts

            # Expand neighbours (move actions)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not _walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))

        # Unreachable
        return []

    actions = []

    # ----------------------------------------------------------------------
    # 1) Collect all primitive resources needed for ONE arrow.
    # ----------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            # Find a path to the primitive (or stay if already adjacent)
            move_seq = _bfs_to_target(state, prim_idx)

            # If BFS failed but we are already next to the primitive, we can still pick it up
            if not move_seq and not state.next_to(prim_idx):
                # Primitive cannot be reached – abort early
                return actions

            actions.extend(move_seq)
            actions.append(4)                     # USE to pick up

            # Execute the actions to keep the internal state up‑to‑date
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ----------------------------------------------------------------------
    # 2) Go to the required workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(state, workshop_idx)
        actions.extend(move_seq)
        actions.append(4)                     # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop – craft in place
        actions.append(4)
        _, state = state.step(4)

    return actions


    # Reset the environment and obtain the initial state and world reference
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) which
    # bring the agent to a position where the cell directly in front
    # contains `target_kind`. Returns [] if already facing the target.
    # ------------------------------------------------------------------
    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # Mapping from action index to (dx, dy) movement
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def _in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def _walkable(x, y):
            # Walkable if inside bounds and the cell is empty (no entities)
            return _in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = cur_state.pos
        sd = cur_state.dir
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts  # front cell already contains the target

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not _walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        # Target not reachable
        return []

    actions = []

    # --------------------------------------------------------------
    # 1. Gather all primitive resources required for a single arrow.
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_seq = _bfs_to_target(state, prim_idx)
            # If we cannot reach the primitive and it's not already adjacent, abort.
            if not move_seq and not state.next_to(prim_idx):
                return actions
            actions.extend(move_seq)
            actions.append(4)                     # USE to pick up

            # Simulate the actions to keep `state` up‑to‑date.
            for a in move_seq + [4]:
                _, state = state.step(a)

    # --------------------------------------------------------------
    # 2. Move to the required workshop (if any) and craft the arrow.
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        wk_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(state, wk_idx)
        actions.extend(move_seq)
        actions.append(4)                     # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop – craft in place.
        actions.append(4)
        _, state = state.step(4)

    return actions

