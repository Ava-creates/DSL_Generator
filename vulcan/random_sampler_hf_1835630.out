    from collections import deque
    import numpy as np

    # ----------------------------------------------------------------------
    # BFS that returns a list of movement actions from start to the *nearest*
    # cell in ``targets`` while avoiding non‑grabbable objects.
    # ----------------------------------------------------------------------
    def bfs_to_target(start, targets):
        """Find shortest path (as action list) from ``start`` to any cell in
        ``targets``. Returns (path, target_cell) or (None, None) if unreachable."""
        w, h = grid.shape[:2]

        # Cells that cannot be entered (any non‑grabbable entity present)
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((w, h), dtype=bool)

        q = deque([start])
        came_from = {start: None}
        act_from = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur in targets:
                # reconstruct path
                path = []
                while cur != start:
                    path.append(act_from[cur])
                    cur = came_from[cur]
                path.reverse()
                return path, cur  # cur is the target reached
            x, y = cur
            for a, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if blocked[nx, ny] and (nx, ny) not in targets:
                    continue
                nxt = (nx, ny)
                if nxt not in came_from:
                    came_from[nxt] = cur
                    act_from[nxt] = a
                    q.append(nxt)

        return None, None  # no reachable target

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives (may need several copies).
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # locate remaining instances of this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                break  # nothing left on the map

            path, target = bfs_to_target(pos, set(locations))
            if path is None:
                # fallback: simple Manhattan moves ignoring obstacles
                target = locations[0]
                dr, dc = target[0] - pos[0], target[1] - pos[1]
                path = []
                while dr > 0:
                    path.append(DOWN)
                    dr -= 1
                while dr < 0:
                    path.append(UP)
                    dr += 1
                while dc > 0:
                    path.append(RIGHT)
                    dc -= 1
                while dc < 0:
                    path.append(LEFT)
                    dc += 1

            actions.extend(path)
            actions.append(USE)                 # pick up the primitive
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0  # remove from simulated grid

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            path, target_ws = bfs_to_target(pos, set(ws_locs))
            if path is None:
                # fallback Manhattan moves
                target_ws = ws_locs[0]
                dr, dc = target_ws[0] - pos[0], target_ws[1] - pos[1]
                path = []
                while dr > 0:
                    path.append(DOWN)
                    dr -= 1
                while dr < 0:
                    path.append(UP)
                    dr += 1
                while dc > 0:
                    path.append(RIGHT)
                    dc -= 1
                while dc < 0:
                    path.append(LEFT)
                    dc += 1

            actions.extend(path)
            actions.append(USE)                 # craft at the workshop

    return actions

