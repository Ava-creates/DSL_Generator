    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN,UP,LEFT,RIGHT
    ACTION_USE = 4

    def bfs(start, targets, blocked):
        """Return a list of action indices that moves from start to any cell in targets."""
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # No reachable target – return empty list (should not happen in valid scenarios)
        return []

    def move_to(target_cells):
        """Move from current position to the nearest cell in target_cells, updating pos and actions."""
        nonlocal pos, actions
        path = bfs(pos, target_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

    def collect(kind_idx, amount):
        """Collect `amount` items of the given kind by moving onto them and using."""
        nonlocal pos, actions
        for _ in range(amount):
            cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            move_to(cells)
            actions.append(ACTION_USE)   # pick up the item

    # ----------------------------------------------------------------------
    # Resolve recipe for the goal (arrow)
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    # primitive requirements and ordered crafting steps
    needed_prims = {}          # primitive kind → total count
    craft_steps = []           # list of (item_idx, count) in topological order

    def resolve(item_idx, mult):
        """Recursively accumulate primitive needs and schedule crafting steps."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # first resolve all ingredient items (ignore special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # then schedule this item to be crafted
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # Static environment data
    # ----------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    # cells that cannot be stepped onto (non‑grabbable entities)
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Build the action sequence
    # ----------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Gather all primitive resources needed
    for kind_idx, cnt in needed_prims.items():
        collect(kind_idx, cnt)

    # 2) Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_name = rec.get("_at", rec.get("_key"))
        wk_idx = wk_name if isinstance(wk_name, int) else cookbook.index[wk_name]

        # locate workshop cells
        wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}
        move_to(wk_cells)

        # use the workshop the required number of times
        actions.extend([ACTION_USE] * cnt)

    return actions


    import collections
    import numpy as np

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT

    def bfs(start, targets, blocked):
        """Return a list of action indices that moves from start to any cell in targets."""
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # should not happen in a solvable scenario

    def go_to_kind(kind_idx, count):
        """Move to a cell containing `kind_idx` and USE it `count` times."""
        nonlocal pos, actions
        for _ in range(count):
            cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)  # USE

    # ------------------------------------------------------------------
    # Gather recipe information for the target item (arrow)
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}          # primitive kind -> total count required
    craft_steps = []           # ordered list of (item_idx, count) to craft

    def resolve(item_idx, multiplier):
        """Recursively collect primitive requirements and schedule crafting steps."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:  # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier
            return
        # Resolve ingredients first (ignore special keys like "_at" or "_key")
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * multiplier)
        # Schedule this item to be crafted after its ingredients are ready
        craft_steps.append((item_idx, multiplier))

    resolve(arrow_idx, 1)

    # ------------------------------------------------------------------
    # Static environment data
    # ------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    pos = tuple(env._current_state.pos)
    actions = []

    # Cells that cannot be walked through (non‑grabbable entities)
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed_prims.items():
        go_to_kind(kind_idx, cnt)

    # ------------------------------------------------------------------
    # 2) Perform crafting steps at their respective workshops
    # ------------------------------------------------------------------
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * cnt)   # USE at workshop the required number of times

    return actions

