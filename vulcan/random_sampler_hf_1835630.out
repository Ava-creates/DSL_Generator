    import numpy as np

    # Helper to generate Manhattan moves from pos to target.
    def _manhattan_path(start, target):
        x, y = start
        tx, ty = target
        moves = []
        # Move in x direction
        while x < tx:
            moves.append(3)   # RIGHT
            x += 1
        while x > tx:
            moves.append(2)   # LEFT
            x -= 1
        # Move in y direction
        while y < ty:
            moves.append(0)   # DOWN
            y += 1
        while y > ty:
            moves.append(1)   # UP
            y -= 1
        return moves, (x, y)

    # ------------------------------------------------------------------
    # Access world, grid and initial position from the environment.
    # The exact attribute names may differ between implementations,
    # so we try a few common possibilities.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # some wrappers expose the world via a nested attribute
        world = getattr(getattr(env, "_current_state", None), "world", None)

    # obtain the initial grid layout
    grid = None
    if hasattr(env, "scenario"):
        grid = getattr(env.scenario, "init_grid", None)
        init_pos = getattr(env.scenario, "init_pos", None)
    if grid is None:
        # fallback to the current state's grid (may be after a reset)
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            grid = getattr(cur_state, "grid", None)
            init_pos = getattr(cur_state, "pos", None)

    if grid is None or init_pos is None or world is None:
        # unable to retrieve necessary information – return empty plan
        return []

    # ------------------------------------------------------------------
    # Identify the goal index for "arrow".
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.get("arrow")
    if arrow_idx is None:
        return []

    # ------------------------------------------------------------------
    # Determine which primitive items are needed and how many of each.
    # ------------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(arrow_idx)  # dict {prim_idx: count}
    actions = []
    cur_pos = tuple(init_pos)

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        # locate all cells that contain this primitive
        locations = np.argwhere(grid[:, :, prim_idx] > 0)
        if locations.size == 0:
            # primitive not present – cannot fulfill the task
            return []
        # we will repeatedly collect from the nearest location (simple heuristic)
        loc_ptr = 0
        for _ in range(needed):
            target = tuple(locations[loc_ptr % len(locations)])
            # move to the primitive cell
            path, cur_pos = _manhattan_path(cur_pos, target)
            actions.extend(path)
            # use action to pick up the item
            actions.append(4)   # USE
            # after picking up, the primitive disappears from the grid,
            # but for planning we keep using the same location list.
            loc_ptr += 1

    # ------------------------------------------------------------------
    # Find the workshop required for crafting the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if not workshop_name:
        return []
    workshop_idx = world.cookbook.index.get(workshop_name)
    if workshop_idx is None:
        return []

    # locate a workshop cell
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return []
    workshop_pos = tuple(workshop_cells[0])

    # move to the workshop
    path, cur_pos = _manhattan_path(cur_pos, workshop_pos)
    actions.extend(path)
    # craft the arrow
    actions.append(4)   # USE

    return actions


    # Initialize and fetch world information
    actions = []
    obs = env.reset()
    world = env.world
    idx = world.cookbook.index

    # Index of the goal item
    arrow_idx = idx["arrow"]

    # Primitive requirements for one arrow
    needed = dict(world.cookbook.primitives_for(arrow_idx))

    # Workshop type where the arrow must be crafted
    workshop_kind = world.cookbook.recipes[arrow_idx]["_at"]
    workshop_idx = idx[workshop_kind]

    # Helper: convert normalized position to integer grid coordinates
    def get_pos(o):
        pos_norm = o["features_dict"]["pos"]
        grid_shape = o["features_dict"]["features_global"].shape
        return (
            int(round(pos_norm[0] * (grid_shape[0] - 1))),
            int(round(pos_norm[1] * (grid_shape[1] - 1))),
        )

    # Helper: locate all cells that contain a given kind (one‑hot channel)
    def find_cells(o, kind):
        grid = o["features_dict"]["features_global"]
        cells = np.argwhere(grid[:, :, kind] == 1)
        return [tuple(c) for c in cells]

    # Action mapping (DOWN, UP, LEFT, RIGHT, USE)
    act_map = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        act_map["DOWN"],
        act_map["UP"],
        act_map["LEFT"],
        act_map["RIGHT"],
        act_map["USE"],
    )

    # Simple Manhattan move generator
    def move_to(cur, target):
        cx, cy = cur
        tx, ty = target
        seq = []
        while cx < tx:
            seq.append(RIGHT)
            cx += 1
        while cx > tx:
            seq.append(LEFT)
            cx -= 1
        while cy < ty:
            seq.append(DOWN)
            cy += 1
        while cy > ty:
            seq.append(UP)
            cy -= 1
        return seq

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    while any(v > 0 for v in needed.values()):
        cur_pos = get_pos(obs)

        # Find the nearest needed primitive that is currently visible
        chosen_cell = None
        chosen_kind = None
        for kind, cnt in needed.items():
            if cnt <= 0:
                continue
            cells = find_cells(obs, kind)
            if not cells:
                continue
            cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            chosen_cell = cells[0]
            chosen_kind = kind
            break

        # If we cannot see any remaining primitive, abort the loop
        if chosen_cell is None:
            break

        # Move to the cell (or adjacent to it) and pick it up
        path = move_to(cur_pos, chosen_cell)
        for a in path:
            actions.append(a)
            _, _, obs = env.step(a)

        actions.append(USE)
        _, _, obs = env.step(USE)

        # Update bookkeeping
        needed[chosen_kind] = max(0, needed[chosen_kind] - 1)

    # ------------------------------------------------------------------
    # 2. Go to the appropriate workshop and craft the arrow
    # ------------------------------------------------------------------
    workshop_cells = find_cells(obs, workshop_idx)
    if workshop_cells:
        target_ws = workshop_cells[0]
        cur_pos = get_pos(obs)
        path = move_to(cur_pos, target_ws)
        for a in path:
            actions.append(a)
            _, _, obs = env.step(a)

        actions.append(USE)
        _, _, obs = env.step(USE)

    return actions

