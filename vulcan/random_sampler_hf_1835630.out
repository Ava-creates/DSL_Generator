    # code body


    import numpy as np
    from collections import deque

    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    def bfs(start, goals):
        q = deque([(start, [])])
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # allow stepping onto a goal cell even if occupied
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    def collect(kind_idx, needed):
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # find any cell containing the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, kind_idx] > 0]
            if not locations:
                raise RuntimeError("Primitive not found")
            # pick the nearest reachable one
            best_path = None
            best_loc = None
            for loc in locations:
                p = bfs(pos, {loc})
                if p is not None:
                    best_path, best_loc = p, loc
                    break
            if best_path is None:
                raise RuntimeError("Primitive unreachable")
            actions.extend(best_path)
            move_along(best_path)
            actions.append(4)  # USE
            grid[best_loc[0], best_loc[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    primitives = cookbook.primitives
    recipes = cookbook.recipes

    def ensure(item_idx, amount):
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives:
                collect(item_idx, amount - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            # gather ingredients
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure(ing_idx, cnt)

            # go to required workshop if any
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if not ws_cells:
                    raise RuntimeError("Workshop missing")
                path = bfs(pos, {ws_cells[0]})
                if path is None:
                    raise RuntimeError("Workshop unreachable")
                actions.extend(path)
                move_along(path)

            # perform crafting
            actions.append(4)  # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    ensure(target_idx, 1)
    return actions

