    def bfs(start, target):
        w, h = grid.shape[:2]
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((w, h), dtype=bool)
        blocked[target[0], target[1]] = False

        q = collections.deque([start])
        parent = {start: None}
        act_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        seq = []
        cur = target
        while cur != start:
            seq.append(act_to[cur])
            cur = parent[cur]
        seq.reverse()
        return seq

    def manhattan_path(start, target):
        seq = []
        dx = target[0] - start[0]
        dy = target[1] - start[1]
        while dx > 0:
            seq.append(DOWN)
            dx -= 1
        while dx < 0:
            seq.append(UP)
            dx += 1
        while dy > 0:
            seq.append(RIGHT)
            dy -= 1
        while dy < 0:
            seq.append(LEFT)
            dy += 1
        return seq

    def move_to(tgt):
        nonlocal pos
        if pos == tgt:
            return
        path = bfs(pos, tgt)
        if path is None:
            path = manhattan_path(pos, tgt)
        actions.extend(path)
        pos = tgt

    # Collect required primitives
    for kind, cnt_needed in needed.items():
        have = int(inventory[kind])
        to_collect = max(0, cnt_needed - have)
        for _ in range(to_collect):
            locations = list(zip(*np.where(grid[:, :, kind] > 0)))
            if not locations:
                break
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
