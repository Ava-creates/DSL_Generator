    import numpy as np

    # Action indices as defined in CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: move from cur (x, y) to target (x, y) using Manhattan steps.
    # The actions list is extended in‑place.
    # ------------------------------------------------------------------
    def _move(cur, target, act_list):
        x, y = cur
        tx, ty = target
        while x < tx:
            act_list.append(RIGHT)
            x += 1
        while x > tx:
            act_list.append(LEFT)
            x -= 1
        while y < ty:
            act_list.append(DOWN)
            y += 1
        while y > ty:
            act_list.append(UP)
            y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Access world and current state from the Lab wrapper.
    # ------------------------------------------------------------------
    world = env.world
    state = env._current_state

    # ------------------------------------------------------------------
    # Determine the index of the goal item (arrow).
    # ------------------------------------------------------------------
    try:
        goal_idx = world.cookbook.index["arrow"]
    except Exception:
        # fallback to the goal stored in the task if present
        goal_idx = getattr(getattr(env, "task", None), "goal", None)
        if goal_idx is None:
            raise RuntimeError("Unable to locate goal index for 'arrow'.")

    # ------------------------------------------------------------------
    # Primitive requirements for the goal (dict {prim_idx: count}).
    # ------------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    actions = []
    cur_pos = tuple(state.pos)

    # Make a mutable copy of the grid counts for planning so we don't
    # repeatedly pick from the same cell.
    planning_grid = state.grid.copy()

    # ------------------------------------------------------------------
    # Collect each required primitive (may need >1 of a kind).
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        while needed > 0:
            # Find cells that currently contain this primitive.
            locations = np.argwhere(planning_grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # No more instances available – stop trying to collect.
                break

            # Choose the nearest instance (Manhattan distance).
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            nearest = tuple(locations[dists.argmin()])

            # Move to that cell.
            cur_pos = _move(cur_pos, nearest, actions)

            # How many units are available on that cell?
            available = int(planning_grid[nearest[0], nearest[1], prim_idx])
            take = min(available, needed)

            # Pick up the required amount (one USE per unit).
            for _ in range(take):
                actions.append(USE)

            # Update planning grid and remaining need.
            planning_grid[nearest[0], nearest[1], prim_idx] -= take
            needed -= take

    # ------------------------------------------------------------------
    # After gathering primitives, go to the appropriate workshop and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    # The workshop key may be stored under "_key" or "_at" depending on the YAML.
    workshop_name = recipe.get("_key") or recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.get(workshop_name)
        if workshop_idx is not None:
            ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
            if ws_locs.size > 0:
                dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])
                workshop_pos = tuple(ws_locs[dists.argmin()])
                cur_pos = _move(cur_pos, workshop_pos, actions)
                actions.append(USE)  # craft at the workshop

    return actions


    import numpy as np

    # Action indices (as used by CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: move from cur (x, y) to target (x, y) using Manhattan steps.
    # The actions are appended to the provided list.
    # ------------------------------------------------------------------
    def _move(cur, target, act_list):
        x, y = cur
        tx, ty = target
        while x < tx:
            act_list.append(RIGHT)
            x += 1
        while x > tx:
            act_list.append(LEFT)
            x -= 1
        while y < ty:
            act_list.append(DOWN)
            y += 1
        while y > ty:
            act_list.append(UP)
            y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Access world and current state from the Lab wrapper.
    # ------------------------------------------------------------------
    world = env.world
    state = env._current_state

    # ------------------------------------------------------------------
    # Determine the index of the goal item ('arrow').
    # ------------------------------------------------------------------
    try:
        goal_idx = world.cookbook.index["arrow"]
    except Exception:
        goal_idx = getattr(getattr(env, "task", None), "goal", None)
        if goal_idx is None:
            raise RuntimeError("Unable to locate goal index for 'arrow'.")

    # ------------------------------------------------------------------
    # Primitive requirements for the goal (dict {prim_idx: count}).
    # ------------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Collect each required primitive (may need >1 of a kind).
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        while needed > 0:
            # Find all cells currently containing this primitive.
            locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # No instances left on the map – give up on this primitive.
                break

            # Choose the nearest instance (Manhattan distance).
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            nearest = tuple(locations[dists.argmin()])

            # Move to that cell.
            cur_pos = _move(cur_pos, nearest, actions)

            # How many units are available on that cell?
            available = int(state.grid[nearest[0], nearest[1], prim_idx])
            take = min(available, needed)

            # Pick up the required amount.
            for _ in range(take):
                actions.append(USE)

            needed -= take
            # Note: we do not update the simulated grid; planning only.

    # ------------------------------------------------------------------
    # After gathering primitives, go to the appropriate workshop and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_key")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.get(workshop_name)
        if workshop_idx is not None:
            ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
            if ws_locs.size > 0:
                dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])
                workshop_pos = tuple(ws_locs[dists.argmin()])
                cur_pos = _move(cur_pos, workshop_pos, actions)
                actions.append(USE)  # craft at the workshop

    return actions

