    import collections
    import numpy as np

    # Action indices (matching CraftWorld's definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: shortest path (BFS) to any cell adjacent to a target location.
    # Returns a list of actions that moves the agent from `start` to a cell
    # that is orthogonally adjacent to one of `targets`.  Cells that are
    # occupied (any non‑zero kind) are treated as blocked.
    # ----------------------------------------------------------------------
    def _bfs_path(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are next to a target, stop (we can USE from here)
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Explore neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:          # free cell
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable path – return empty list (caller will ignore)
        return []

    # ----------------------------------------------------------------------
    # Grab world / cookbook information
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Fallback: try to obtain from the current CraftState
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = state_tmp.world
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Goal is the item named "arrow"
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary)
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Current mutable view of the grid and occupancy mask
    pos = tuple(state.pos)                     # (x, y)
    cur_grid = state.grid.copy()
    occupied = np.any(cur_grid > 0, axis=2)    # True where any kind is present

    actions = []                               # final action list
    harvested = set()                          # cells already collected from

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        # All cells that currently contain this primitive
        prim_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position (greedy nearest‑first)
        prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))

        gathered = 0
        for cell in prim_cells:
            if gathered >= required_cnt:
                break
            if cell in harvested:
                continue

            # Move next to the cell
            path = _bfs_path(pos, [cell], occupied)
            actions.extend(path)
            # Update our internal position following the path
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick up the primitive
            actions.append(USE)
            # Remove it from our local copy of the grid so future planning sees the cell as free
            cur_grid[cell[0], cell[1], prim_idx] = 0
            occupied[cell[0], cell[1]] = False
            harvested.add(cell)
            gathered += 1

    # ----------------------------------------------------------------------
    # 2. Go to the workshop (if the recipe specifies one) and craft
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")            # may be None or a string / index
    if workshop_key is not None:
        # Resolve workshop index
        ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, ws_idx] > 0)]
        if ws_cells:
            # Choose nearest workshop cell
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_path(pos, [target_ws], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft the arrow
            actions.append(USE)
        else:
            # No visible workshop (unlikely), just attempt to USE at current location
            actions.append(USE)
    else:
        # Recipe has no explicit workshop – just USE where we are
        actions.append(USE)

    # Return the complete plan
    return actions


