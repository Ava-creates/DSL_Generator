    env.reset()
    state = env._current_state
    world = env.world
    grid = np.copy(state.grid)

    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) to walk
        from ``start`` to ``goal`` using a simple Manhattan route."""
        actions = []
        y, x = start
        gy, gx = goal
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing ``kind_idx`` (primitive or workshop).
        Returns the cell coordinates (y, x) or ``None`` if not found."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a free (non‑blocked) neighbour of ``cell`` if any,
        otherwise return ``cell`` itself."""
        y, x = cell
        for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        return cell

    # ------------------------------------------------------------------
    # Determine which primitives are needed for the 'arrow' item
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # current agent position (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on (prefer empty).
            stand = free_adjacent(target)

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, stand)
            cur_pos = stand

            # Face the primitive (best‑effort direction).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update the internal copy of the grid to reflect collection.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the workshop specified in the recipe (if any) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions


    env.reset()
    state = env._current_state
    world = env.world
    grid = np.copy(state.grid)

    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def manhattan_path(start, goal):
        """Return movement actions to go from start to goal (Manhattan)."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Locate nearest cell containing kind_idx; return (y,x) or None."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine primitives required for an arrow
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect each primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            ty, tx = target

            # Choose a free adjacent cell to stand on (prefer empty).
            stand = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        stand = (ny, nx)
                        break
            if stand is None:
                # No free neighbour; stand on the primitive cell itself.
                stand = target

            # Move to the chosen standing cell.
            actions += manhattan_path(cur_pos, stand)
            cur_pos = stand

            # Face the primitive (if not already on it).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update our local copy of the grid to reflect collection.
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws = find_nearest(workshop_idx, cur_pos)
        if ws is not None:
            actions += manhattan_path(cur_pos, ws)
            cur_pos = ws

    # Final USE to craft the arrow.
    actions.append(USE)
    return actions

