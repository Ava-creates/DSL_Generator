    # make a mutable copy that we will update as we “pick up” items
    mutable_grid = grid.copy()

    actions = []                     # final action sequence
    # ------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions moving the
    # agent from `start` to a cell adjacent to any target in `targets`.
    # It treats any non‑empty cell in `mutable_grid` as blocked.
    # ------------------------------------------------------------
    def _bfs_path(start, targets):
        width, height, _ = mutable_grid.shape
        occupied = np.any(mutable_grid > 0, axis=2)

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path
            # explore neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no path found – return empty list (will cause later failure)
        return []

    # ------------------------------------------------------------
    # Collect required primitives (greedy nearest‑first)
    # ------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # locate remaining instances of this primitive
            locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]
            if not locations:
                # cannot find enough primitives – abort early
                break
            # sort by Manhattan distance from current position
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_loc = locations[0]

            # move adjacent to the primitive
            path = _bfs_path(pos, [target_loc])
            actions.extend(path)
            # update simulated position
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # pick it up
            actions.append(USE)
            # remove the primitive from the mutable grid
            mutable_grid[target_loc[0], target_loc[1], prim_idx] = 0
            gathered += 1

