    import collections
    import numpy as np

    # ----------------------------------------------------------------------
    # Helper: shortest‑path (BFS) returning a list of action indices
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT
    ACTION_USE = env.action_specs().get("USE", 4)

    def bfs(start, targets, blocked):
        """Return a list of actions that moves from start to any cell in targets."""
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # No reachable target – should not happen for a solvable scenario
        return []

    def move_to(target_cells):
        """Move from the current position to the nearest cell in target_cells."""
        nonlocal pos, actions
        path = bfs(pos, target_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

    def collect(kind_idx, amount):
        """Collect `amount` items of the given kind by moving onto them and using."""
