    # Reset the environment and get current state information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # ------------------------------------------------------------------
    # Resolve action indices (fallback to default ordering if not provided)
    # ------------------------------------------------------------------
    try:
        specs = env.action_specs()
        DOWN = specs['DOWN']
        UP = specs['UP']
        LEFT = specs['LEFT']
        RIGHT = specs['RIGHT']
        USE = specs['USE']
    except Exception:
        DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk
        from ``start`` to ``goal`` using a simple Manhattan route."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing ``kind_idx`` (primitive or workshop).
        Returns a (y, x) tuple or ``None`` if not found."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine which primitives are needed for the 'arrow' item
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos   # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on (prefer empty).
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; stand on the primitive cell itself.
                adj = (ty, tx)

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (by attempting a step towards it; direction updates even if blocked).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop specified in the recipe (if any) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions


    # Reset environment to get a fresh state
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # ------------------------------------------------------------------
    # Resolve action indices (use env specs if available, otherwise fall back)
    # ------------------------------------------------------------------
    try:
        specs = env.action_specs()
        DOWN = specs['DOWN']
        UP = specs['UP']
        LEFT = specs['LEFT']
        RIGHT = specs['RIGHT']
        USE = specs['USE']
    except Exception:
        # Default ordering as defined in the original environment
        DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk
        from ``start`` to ``goal`` using a simple Manhattan route."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing ``kind_idx`` (primitive or workshop).
        Returns a (y, x) tuple or ``None`` if not found."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(target, cur_grid):
        """Return a free adjacent coordinate to ``target`` (prefer empty).
        If none are free, return ``target`` itself."""
        ty, tx = target
        candidates = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]
        for ny, nx in candidates:
            if 0 <= ny < cur_grid.shape[0] and 0 <= nx < cur_grid.shape[1]:
                # A cell is considered occupied if any non‑grabbable entity is present
                occupied = np.any(cur_grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        return target

    # ------------------------------------------------------------------
    # Determine which primitives are needed for the 'arrow' item
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos   # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on (or the primitive cell itself)
            stand_pos = free_adjacent(target, grid)

            # Move to the chosen position
            actions += manhattan_path(cur_pos, stand_pos)
            cur_pos = stand_pos

            # Face the primitive (direction updates by attempting a step towards it)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions

