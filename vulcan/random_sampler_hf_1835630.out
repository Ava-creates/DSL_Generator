    # Get mapping from action names to indices
    action_map = env.action_specs()

    # Identify the index for the target item "arrow"
    arrow_idx = env.world.cookbook.index["arrow"]

    # Determine primitive requirements for one arrow
    needed_primitives = env.world.cookbook.primitives_for(arrow_idx).copy()

    # Helper: find the nearest cell containing a given kind (primitive or workshop)
    def _find_nearest(kind_idx):
        grid_layer = env._current_state.grid[:, :, kind_idx]
        positions = np.argwhere(grid_layer > 0)
        if positions.size == 0:
            return None
        cur_pos = np.array(env._current_state.pos)
        dists = np.sum(np.abs(positions - cur_pos), axis=1)
        nearest = positions[dists.argmin()]
        return tuple(nearest)

    # Helper: move the agent from its current location to a target location
    def _move_to(target):
        # We directly issue movement actions and also step the environment
        # so that subsequent calls see the updated position.
        cur = list(env._current_state.pos)
        ty, tx = target
        while cur[0] < ty:
            env.step(action_map["DOWN"])
            cur[0] += 1
        while cur[0] > ty:
            env.step(action_map["UP"])
            cur[0] -= 1
        while cur[1] < tx:
            env.step(action_map["RIGHT"])
            cur[1] += 1
        while cur[1] > tx:
            env.step(action_map["LEFT"])
            cur[1] -= 1

    actions = []

    # Collect each required primitive
    for prim_idx, needed_cnt in needed_primitives.items():
        while env._current_state.inventory[prim_idx] < needed_cnt:
            prim_pos = _find_nearest(prim_idx)
            if prim_pos is None:
                # No more of this primitive on the map; break to avoid infinite loop
                break
            _move_to(prim_pos)
            # Use action to pick up the primitive
            env.step(action_map["USE"])
            actions.append(action_map["USE"])

    # Move to the appropriate workshop (if any) and craft the arrow
    workshop_idx = env.world.cookbook.recipes[arrow_idx].get("_at")
    if workshop_idx is not None:
        workshop_pos = _find_nearest(workshop_idx)
        if workshop_pos is not None:
            _move_to(workshop_pos)

    # Final USE to craft the arrow
    env.step(action_map["USE"])
    actions.append(action_map["USE"])

    return actions


    import numpy as np
    from collections import deque

    # Get the current state (assumes env is a CraftLab instance that has been reset)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_state = env._current_state
    else:
        # Fallback: create a fresh state from the scenario
        cur_state = env.scenario.init()

    world = env.world
    cookbook = world.cookbook

    # ------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------
    # movement deltas and corresponding action indices (as defined in CraftLab)
    MOVES = [
        (0, 1, 0),   # DOWN  -> action 0
        (0, -1, 1),  # UP    -> action 1
        (-1, 0, 2),  # LEFT  -> action 2
        (1, 0, 3),   # RIGHT -> action 3
    ]

    def is_free(x, y, grid):
        """A cell is free if no entity occupies it."""
        return not grid[x, y, :].any()

    def bfs(start, target_set, grid):
        """Bread‑first search returning a list of actions to reach any cell in target_set."""
        w, h, _ = grid.shape
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in target_set:
                return path
            for dx, dy, act in MOVES:
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if is_free(nx, ny, grid):
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return None

    def find_positions(kind_idx, grid):
        xs, ys = np.where(grid[:, :, kind_idx] > 0)
        return list(zip(xs, ys))

    # ------------------------------------------------------------
    # Determine goal index for the arrow
    # ------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        # unknown goal – return empty plan
        return []
    goal_idx = cookbook.index[goal_name]

    # ------------------------------------------------------------
    # Gather required primitive items
    # ------------------------------------------------------------
    primitive_requirements = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    plan_actions = []
    # work on a copy of the grid so that we can “remove” collected items locally
    grid = cur_state.grid.copy()
    cur_pos = tuple(cur_state.pos)

    for prim_idx, needed in primitive_requirements.items():
        # find all locations of this primitive in the current grid
        prim_locs = find_positions(prim_idx, grid)
        for _ in range(needed):
            # locate the nearest reachable primitive
            best_path = None
            best_prim_loc = None
            for (tx, ty) in prim_locs:
                # candidate standing cells (free neighbours of the primitive)
                neighbour_cells = set()
                for dx, dy, _ in MOVES:
                    nx, ny = tx + dx, ty + dy
                    if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and is_free(nx, ny, grid):
                        neighbour_cells.add((nx, ny))
                if not neighbour_cells:
                    continue
                path = bfs(cur_pos, neighbour_cells, grid)
                if path is not None and (best_path is None or len(path) < len(best_path)):
                    best_path = path
                    best_prim_loc = (tx, ty)
            if best_path is None:
                # cannot reach any remaining instance – abort planning
                return plan_actions
            # move to the chosen neighbour (the last step of the path points toward the primitive)
            plan_actions.extend(best_path)
            # use action to pick up the primitive
            plan_actions.append(4)  # USE
            # update simulated position
            cx, cy = cur_pos
            for act in best_path:
                dx, dy, _ = next(m for m in MOVES if m[2] == act)
                cx += dx
                cy += dy
            cur_pos = (cx, cy)
            # locally remove the primitive from the grid (as if it were collected)
            px, py = best_prim_loc
            grid[px, py, prim_idx] = 0
            # also remove this location from future searches
            prim_locs = [loc for loc in prim_locs if loc != best_prim_loc]

    # ------------------------------------------------------------
    # Go to the workshop for the arrow and craft it
    # ------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)
    if workshop_kind is not None:
        workshop_cells = find_positions(workshop_kind, grid)
        best_path = None
        for (wx, wy) in workshop_cells:
            neighbour_cells = set()
            for dx, dy, _ in MOVES:
                nx, ny = wx + dx, wy + dy
                if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and is_free(nx, ny, grid):
                    neighbour_cells.add((nx, ny))
            if not neighbour_cells:
                continue
            path = bfs(cur_pos, neighbour_cells, grid)
            if path is not None and (best_path is None or len(path) < len(best_path)):
                best_path = path
        if best_path is not None:
            plan_actions.extend(best_path)
            plan_actions.append(4)  # USE to craft the arrow at the workshop

    return plan_actions

