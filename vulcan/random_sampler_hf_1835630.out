    state = env._current_state
    grid = state.grid
    cur_pos = state.pos  # (x, y)

    # Helper to move to an absolute coordinate using Manhattan moves
    def _move_to(target):
        nonlocal cur_pos, actions
        tx, ty = target
        while cur_pos[0] < tx:
            actions.append(env.RIGHT)
            cur_pos = (cur_pos[0] + 1, cur_pos[1])
        while cur_pos[0] > tx:
            actions.append(env.LEFT)
            cur_pos = (cur_pos[0] - 1, cur_pos[1])
        while cur_pos[1] < ty:
            actions.append(env.DOWN)
            cur_pos = (cur_pos[0], cur_pos[1] + 1)
        while cur_pos[1] > ty:
            actions.append(env.UP)
            cur_pos = (cur_pos[0], cur_pos[1] - 1)

    # Collect each required primitive from any available location
    for kind_idx, needed_cnt in needed.items():
        # Find all cells that currently contain this kind
        locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))
        collected = 0
        for loc in locations:
            if collected >= needed_cnt:
                break
            _move_to(loc)          # go to the primitive cell
            actions.append(env.USE)  # pick it up
            collected += 1
        # If we could not find enough instances, just continue (the plan may fail later)

    # Finally go to the workshop that can craft the arrow and use it
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        # workshop may be stored as a name (string) or directly as an index
        if isinstance(workshop_name, str):
            workshop_idx = idx[workshop_name]
        else:
            workshop_idx = workshop_name
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if workshop_cells:
            _move_to(workshop_cells[0])
            actions.append(env.USE)  # craft the arrow

    return actions

