    import collections, numpy as np

    # Action indices as defined in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_adjacent(start, targets, blocked):
        """Return a list of actions that moves from start to a cell orthogonally adjacent to any target."""
        w, h = blocked.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # Stop when we are adjacent to a target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    def _apply(pos, actions):
        """Apply a sequence of actions to a position and return the resulting position."""
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate world and cookbook objects.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the provided environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state; reset if necessary.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Goal item.
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitives required for the goal.
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Planning structures.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                 # (x, y)
    grid = state.grid.copy()               # (W, H, n_kinds)
    blocked = np.any(grid, axis=2)         # bool mask of occupied cells
    plan_actions = []                      # final action list
    harvested = set()                      # cells already collected from

    # ------------------------------------------------------------------
    # Collect required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # Find all cells containing this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by distance to reduce travel.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed_cnt:
                break
            if cell in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_adjacent(pos, [cell], blocked)
            plan_actions.extend(path)
            pos = _apply(pos, path)

            # Pick it up.
            plan_actions.append(USE)

            # Update planning structures.
            grid[cell[0], cell[1], prim_idx] = 0
            blocked = np.any(grid, axis=2)
            harvested.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the goal at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_adjacent(pos, [target_ws], blocked)
            plan_actions.extend(path)
            pos = _apply(pos, path)
            plan_actions.append(USE)
        else:
            # No visible workshop; try crafting at current location.
            plan_actions.append(USE)
    else:
        # No specific workshop required.
        plan_actions.append(USE)

    return plan_actions

