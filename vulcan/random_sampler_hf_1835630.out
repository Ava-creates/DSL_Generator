    import numpy as np
    from collections import deque

    # Mapping between direction vectors and action indices
    DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs_adjacent(start, targets, grid):
        """Return a list of actions that brings the agent next to any target cell."""
        W, H = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)  # any non‑empty cell is an obstacle
        sx, sy = start
        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []
        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True
        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []  # no reachable target

    # ----------------------------------------------------------------------
    # Gather current state information
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)

    # Goal index is stored in the task object (namedtuple Task(goal, steps))
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal not found in the environment task.")

    # ----------------------------------------------------------------------
    # Determine which primitive resources are required for the goal
    # ----------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # ----------------------------------------------------------------------
    # Collect each required primitive
    # ----------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        while cnt > 0:
            # Locate all cells that currently contain this primitive
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # No more of this primitive on the map – abort early
                return plan
            # Find a path to the nearest cell (any cell works)
            path = bfs_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)
            # Update position according to the path taken
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Perform the USE action to pick up the primitive
            plan.append(4)  # USE
            # Identify which cell we are now adjacent to and decrement it
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Something went wrong; stop planning
                return plan
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt -= 1

    # ----------------------------------------------------------------------
    # If the recipe requires a specific workshop, move there and USE
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (might be a string name)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)
        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            plan.append(4)  # USE at the workshop

    return plan


    DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}
    from collections import deque
    import numpy as np

    def bfs_adjacent(start, targets, grid):
        """Return a list of actions that moves the agent from *start* to a cell
        adjacent to any of *targets* while avoiding blocked cells."""
        W, H = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)          # any occupied cell blocks movement
        sx, sy = start

        # already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.zeros((W, H), dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []   # no reachable target

    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)

    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    needed = env.world.cookbook.primitives_for(goal_idx)
    plan = []

    # Collect each required primitive
    for kind_idx, count in needed.items():
        while count > 0:
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                return plan  # cannot find required primitive, abort early
            path = bfs_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            plan.append(4)   # USE to pick up
            # identify which primitive cell we are adjacent to
            adj = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                break
            grid[adj[0], adj[1], kind_idx] -= 1
            count -= 1

    # Move to the appropriate workshop and craft the goal item
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)
        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            plan.append(4)   # USE to craft

    return plan

