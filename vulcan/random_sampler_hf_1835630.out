    # Bread‑first search over the state space
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """Hashable representation of a CraftState."""
        return (
            st.pos,                                   # (x, y) position
            st.dir,                                   # facing direction
            tuple(st.inventory.tolist()),             # inventory as tuple
            st.grid.tobytes(),                        # full grid occupancy
        )

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    # Limits to keep search tractable
    MAX_STEPS = 300          # maximum depth of a plan
    MAX_NODES = 150000       # maximum number of expanded nodes
    nodes_expanded = 0

    n_actions = getattr(world, "n_actions", 5)   # typical action space size

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test – have we obtained an arrow?
        if cur_state.satisfies("", target_idx):
            return cur_actions

        # Enforce depth and node limits
        if len(cur_actions) >= MAX_STEPS:
            continue
        if nodes_expanded >= MAX_NODES:
            break
        nodes_expanded += 1

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, cur_actions + [a]))

    # No viable plan found within limits – return empty list
    return []


    # Retrieve world and target item index
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # Determine which primitive kinds are required to craft the arrow
    # primitives_for returns a dict {primitive_idx: count} needed for ONE unit
    primitive_needs = world.cookbook.primitives_for(target_idx)

    # If the recipe is empty, the arrow itself is a primitive – just collect it
    # In that case we treat the arrow as the only needed kind
    needed_kinds = set(primitive_needs.keys())
    needed_kinds.add(target_idx)

    # Required counts (capped at needed + 1 for pruning)
    required_counts = {k: primitive_needs.get(k, 0) for k in needed_kinds}
    required_counts[target_idx] = 1  # we need at least one arrow

    # Helper to create a compact inventory representation for hashing
    def _inventory_key(inv):
        # Cap each needed count to required+1 to keep the key small
        return tuple(min(int(inv[k]), required_counts[k] + 1) for k in sorted(needed_kinds))

    # State hashing for visited set
    def _state_key(st):
        return (
            st.pos,                     # (x, y) position
            st.dir,                     # facing direction
            _inventory_key(st.inventory),  # compact inventory
            st.grid.tobytes(),          # full grid occupancy
        )

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 400          # depth limit
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: have we crafted at least one arrow?
        if cur_state.inventory[target_idx] > 0:
            return cur_actions

        if len(cur_actions) >= MAX_STEPS:
            continue

        # Expand possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, cur_actions + [a]))

    # If we exit the loop no plan was found within limits
    return []

