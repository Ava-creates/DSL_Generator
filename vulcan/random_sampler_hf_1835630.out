env_interactions 0

    # Reset environment and obtain current state and world reference
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify the integer index of the goal item "arrow"
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:                   # arrow not defined in this world
        return []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) which
    # bring the agent to a position where the cell directly in front
    # contains `target_kind`. Returns None if unreachable.
    # ------------------------------------------------------------------
    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # Mapping from action index to (dx, dy)
        deltas = {0: (0, 1),   # DOWN
                  1: (0, -1),  # UP
                  2: (-1, 0),  # LEFT
                  3: (1, 0)}   # RIGHT

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = cur_state.pos
        sdir = cur_state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # `primitives_for` expands the recipe recursively to true primitives.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:                         # arrow itself may be primitive
        needed = {arrow_idx: 1}

    plan = []  # list of action indices to be returned

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            move_seq = _bfs_to_target(state, prim_idx)
            if move_seq is None:          # cannot reach this primitive
                return plan
            plan.extend(move_seq)
            plan.append(4)                # USE to pick it up
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).  If the recipe
    # does not specify a workshop, we can craft in place.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(state, workshop_idx)
        if move_seq is None:              # unreachable workshop
            return plan
        plan.extend(move_seq)
        plan.append(4)                    # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        plan.append(4)                    # USE to craft directly
        _, state = state.step(4)

    return plan


    env.reset()
    state = env._current_state
    world = env.world

    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # BFS to reach a cell whose front contains target_kind
    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}  # action -> (dx, dy)

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = cur_state.pos
        sdir = cur_state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return None

    # Determine primitive requirements
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:
        needed = {arrow_idx: 1}

    plan = []

    # Collect primitives
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            seq = _bfs_to_target(state, prim_idx)
            if seq is None:
                return plan
            plan.extend(seq)
            plan.append(4)  # USE to pick up
            for a in seq + [4]:
                _, state = state.step(a)

    # Craft at workshop if required
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = _bfs_to_target(state, workshop_idx)
        if seq is None:
            return plan
        plan.extend(seq)
        plan.append(4)  # USE to craft
        for a in seq + [4]:
            _, state = state.step(a)
    else:
        plan.append(4)
        _, state = state.step(4)

    return plan

