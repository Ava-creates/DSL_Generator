    import numpy as np

    # action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # helper bfs to adjacency
    def bfs_adj(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # check adjacency
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    # helper to update position
    def apply_path(pos, path):
        x, y = pos
        for act in path:
            if act == RIGHT:
                x += 1
            elif act == LEFT:
                x -= 1
            elif act == DOWN:
                y += 1
            elif act == UP:
                y -= 1
        return (x, y)

    # locate world and cookbook
    world = getattr(env, "world", None)
    if world is None:
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in env.")
    cookbook = world.cookbook

    # goal arrow
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # primitive requirements
    primitives_needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # make sure episode started
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)
    grid = state.grid
    occupied = np.any(grid > 0, axis=2)

    actions = []
    taken = set()

    # collect primitives
    for prim_idx, need in primitives_needed.items():
        # locate all cells with this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by distance from current pos
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= need:
                break
            if cell in taken:
                continue
            path = bfs_adj(pos, [cell], occupied)
            actions.extend(path)
            pos = apply_path(pos, path)

            actions.append(USE)

            occupied[cell[0], cell[1]] = False
            taken.add(cell)
            collected += 1

    # move to workshop if required and craft
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if not ws_cells:
            raise RuntimeError(f"No workshop '{workshop_key}' found.")
        ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        target_ws = ws_cells[0]
        path = bfs_adj(pos, [target_ws], occupied)
        actions.extend(path)
        pos = apply_path(pos, path)
        actions.append(USE)
    else:
        actions.append(USE)

    return actions


