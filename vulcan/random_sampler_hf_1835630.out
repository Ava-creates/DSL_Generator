    import numpy as np

    # ------------------------------------------------------------------
    # Action constants (match CraftWorld's default ordering)
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: Manhattan moves from cur to target (returns list of actions)
    # ------------------------------------------------------------------
    def _move_to(cur, target):
        cx, cy = cur
        tx, ty = target
        seq = []
        while cx < tx:
            seq.append(RIGHT)
            cx += 1
        while cx > tx:
            seq.append(LEFT)
            cx -= 1
        while cy < ty:
            seq.append(DOWN)
            cy += 1
        while cy > ty:
            seq.append(UP)
            cy -= 1
        return seq

    # ------------------------------------------------------------------
    # Resolve world / cookbook
    # ------------------------------------------------------------------
    world = getattr(env, "world", env)          # CraftLab wraps a CraftWorld
    cookbook = world.cookbook

    # Goal: make an "arrow"
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if needed)
    # ------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)                     # current agent position
    grid = state.grid                           # static grid layout (W,H,kind)

    actions = []

    # ------------------------------------------------------------------
    # 1. Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        # locate all cells that currently contain this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        gathered = 0
        while gathered < required_cnt and locations:
            # choose nearest remaining location
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locations.pop(0)
            actions.extend(_move_to(pos, target))
            pos = target
            actions.append(USE)                # pick up the primitive
            gathered += 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
