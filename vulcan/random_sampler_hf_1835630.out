    # --- Setup --------------------------------------------------------------
    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Resolve world and cookbook objects (works for raw CraftWorld or CraftLab)
    world = getattr(env, "world", None)
    if world is None:
        # CraftLab stores the world inside the current state
        state = getattr(env, "_current_state", None)
        if state is not None:
            world = state.world
        else:
            # Fallback: maybe env.scenario.world exists
            world = getattr(getattr(env, "scenario", None), "world", None)
    cookbook = world.cookbook

    # Goal we want to craft
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Obtain a fresh state (grid, position).  For CraftLab we may already have one.
    state = getattr(env, "_current_state", None)
    if state is None:
        # CraftLab: env.scenario.init() creates the initial state
        state = env.scenario.init()
    pos = tuple(state.pos)          # (x, y)
    grid = state.grid                # shape (W, H, n_kinds)

    actions = []                     # result list

    # -----------------------------------------------------------------------
    # Helper to generate a Manhattan move sequence from cur → target
    def _move_to(cur, target):
        cx, cy = cur
        tx, ty = target
        seq = []
        while cx < tx:
            seq.append(RIGHT); cx += 1
        while cx > tx:
            seq.append(LEFT);  cx -= 1
        while cy < ty:
            seq.append(DOWN);  cy += 1
        while cy > ty:
            seq.append(UP);    cy -= 1
        return seq

    # Keep track of cells already harvested (avoid picking same primitive twice)
    used_cells = set()

    # -----------------------------------------------------------------------
    # 1) Gather all required primitives
    for prim_idx, needed_cnt in primitives_needed.items():
        # Find all locations that currently contain this primitive
        locs = [tuple(p) for p in __import__("numpy").argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position for efficiency
        locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locs:
            if gathered >= needed_cnt:
                break
            if loc in used_cells:
                continue
            # Move to the primitive cell
            actions.extend(_move_to(pos, loc))
            pos = loc
            # Pick it up
            actions.append(USE)
            used_cells.add(loc)
            gathered += 1

    # -----------------------------------------------------------------------
    # 2) Go to the workshop for the arrow and craft it
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key
        # Locate workshop cells on the map
        ws_locs = [tuple(p) for p in __import__("numpy").argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_locs[0]
            actions.extend(_move_to(pos, target_ws))
            pos = target_ws
            actions.append(USE)   # craft at the workshop

    # Return the complete action list
    return actions


    # constants for actions (match CraftWorld ordering)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper to obtain the CraftWorld instance and the Cookbook
    # ----------------------------------------------------------------------
    # env may be a CraftLab or a raw CraftWorld; handle both.
    world = getattr(env, "world", None)
    if world is None:
        # CraftLab stores the underlying world in its current state
        state = getattr(env, "_current_state", None)
        if state is not None:
            world = state.world
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance from env")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Identify goal (arrow) and its primitive requirements
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive counts needed for ONE arrow (already recursively expanded)
    primitive_requirements = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}

    # ----------------------------------------------------------------------
    # Get current state (grid, position, inventory)
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        # If env is a raw CraftWorld, we need to initialise a scenario first
        # Assume env has attribute 'scenario'
        if hasattr(env, "scenario"):
            state = env.scenario.init()
        else:
            raise RuntimeError("Cannot obtain current CraftState from env")
    pos = tuple(state.pos)                 # (x, y)
    grid = state.grid                       # (W, H, n_kinds)
    inventory = state.inventory.copy()      # 1‑D array length n_kinds

    actions = []                            # plan to return

    # ----------------------------------------------------------------------
    # Simple Manhattan move generator (ignores obstacles)
    # ----------------------------------------------------------------------
    def _move_to(start, target):
        cx, cy = start
        tx, ty = target
        seq = []
        while cx < tx:
            seq.append(RIGHT); cx += 1
        while cx > tx:
            seq.append(LEFT); cx -= 1
        while cy < ty:
            seq.append(DOWN); cy += 1
        while cy > ty:
            seq.append(UP); cy -= 1
        return seq

    # ----------------------------------------------------------------------
    # Collect required primitives (skip those already in inventory)
    # ----------------------------------------------------------------------
    used_cells = set()   # locations already harvested in this plan

    for prim_idx, total_needed in primitive_requirements.items():
        already_have = int(inventory[prim_idx])
        need = max(0, total_needed - already_have)
        if need == 0:
            continue

        # locate all cells that currently contain this primitive
        locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from current position (greedy)
        locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))

        gathered = 0
        for loc in locs:
            if gathered >= need:
                break
            if loc in used_cells:
                continue
            # move to the primitive cell
            actions.extend(_move_to(pos, loc))
            pos = loc
            # pick it up
            actions.append(USE)
            used_cells.add(loc)
            gathered += 1
            # update our mental inventory & grid for subsequent planning
            inventory[prim_idx] += 1
            # pretend the cell is now empty (so we don't try to reuse it)
            # (no need to modify grid as we track used_cells)

        # if we couldn't find enough instances, we just stop – the plan will
        # inevitably fail at execution time, but this is the best we can do
        # without a full search.

    # ----------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name string or already an int)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key

        # Find all workshop cells
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_locs[0]
            actions.extend(_move_to(pos, target_ws))
            pos = target_ws
            actions.append(USE)   # craft at the workshop
        else:
            # No workshop found – fall back to using current cell
            actions.append(USE)
    else:
        # No specific workshop required; just use current cell to craft
        actions.append(USE)

    return actions

