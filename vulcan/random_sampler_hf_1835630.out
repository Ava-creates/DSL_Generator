    # Reset environment and obtain core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy of the grid

    # Action indices (as defined by CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    height, width, _ = grid.shape

    def in_bounds(y, x):
        return 0 <= y < height and 0 <= x < width

    def cell_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return np.any(grid[y, x, :])

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from *start* to *goal* while avoiding blocked cells."""
        if start == goal:
            return []
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        rev.append(DOWN)
                    elif cur[0] == py - 1:
                        rev.append(UP)
                    elif cur[1] == px + 1:
                        rev.append(RIGHT)
                    elif cur[1] == px - 1:
                        rev.append(LEFT)
                    cur = (py, px)
                rev.reverse()
                return rev
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # No path found – return empty (will cause failure later)
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing *kind_idx* (primitive or workshop)."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell, avoid=set()):
        """Return a free neighbouring cell (y, x) to *cell* not in *avoid*.
        If none exist, return None."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not cell_blocked(ny, nx):
                return (ny, nx)
        return None

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe information
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)      # {primitive_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos                     # (y, x)
    taken_positions = set()                 # remember cells we already harvested

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on while picking up.
            adj = free_adjacent(target, avoid=taken_positions)
            if adj is None:
                # No free neighbour; fallback to standing on the primitive itself.
                adj = target

            # Move to the chosen adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (if not standing on it).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update internal grid representation and remember the location.
            grid[target[0], target[1], prim_idx] = 0
            taken_positions.add(target)

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = free_adjacent(ws_cell, avoid=taken_positions)
            if ws_adj is None:
                ws_adj = ws_cell
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop.
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting of the arrow.
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Reset environment and obtain core objects
    # ----------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy of the grid

    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    height, width, _ = grid.shape

    def in_bounds(y, x):
        return 0 <= y < height and 0 <= x < width

    def blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return np.any(grid[y, x, :])

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from *start* to *goal* while avoiding blocked cells."""
        if start == goal:
            return []
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        rev.append(DOWN)
                    elif cur[0] == py - 1:
                        rev.append(UP)
                    elif cur[1] == px + 1:
                        rev.append(RIGHT)
                    elif cur[1] == px - 1:
                        rev.append(LEFT)
                    cur = (py, px)
                rev.reverse()
                return rev
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # No path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell (Manhattan) containing *kind_idx*."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[dists.argmin()]
        return tuple(nearest)

    def free_adjacent(cell, forbidden=set()):
        """Return a free neighbour of *cell* not in *forbidden*."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in forbidden:
                continue
            if not blocked(ny, nx):
                return (ny, nx)
        return None

    def face_action(src, dst):
        """Single action needed to face *dst* from *src*."""
        dy, dx = dst[0] - src[0], dst[1] - src[1]
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe information
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)      # {primitive_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos                     # (y, x)
    harvested = set()                       # cells already collected from

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on while picking up.
            adj = free_adjacent(target, forbidden=harvested)
            if adj is None:
                # Fallback: stand directly on the primitive cell.
                adj = target

            # Move to the chosen adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (if not standing on it) and pick up.
            fa = face_action(cur_pos, target)
            if fa is not None:
                actions.append(fa)
            actions.append(USE)

            # Update internal grid copy and remember the harvest.
            grid[target[0], target[1], prim_idx] = 0
            harvested.add(target)

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = free_adjacent(ws_cell, forbidden=harvested)
            if ws_adj is None:
                ws_adj = cur_pos
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop before using.
            fa = face_action(cur_pos, ws_cell)
            if fa is not None:
                actions.append(fa)

    # Final USE to trigger crafting (or craft directly if no workshop).
    actions.append(USE)

    return actions

