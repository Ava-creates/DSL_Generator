        state = env._current_state

    pos = tuple(state.pos)          # current (x, y)
    grid = state.grid                # (W, H, n_kinds)

    actions = []
    harvested = set()                # cells already used

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, count_needed in primitives_needed.items():
        # Locate all cells containing this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Greedy nearest-first ordering
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= count_needed:
                break
            if loc in harvested:
                continue
            # Move to the primitive cell
            actions.extend(_move_to(pos, loc))
            pos = loc
            # Pick it up
            actions.append(USE)
            harvested.add(loc)
            gathered += 1

