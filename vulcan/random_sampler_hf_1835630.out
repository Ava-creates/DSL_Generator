    import numpy as np
    from collections import deque

    # helper mappings between actions and movement vectors
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR_TO_VEC = {
        ACTION_DOWN: (0, 1),
        ACTION_UP:   (0, -1),
        ACTION_LEFT: (-1, 0),
        ACTION_RIGHT:(1, 0),
    }
    VEC_TO_DIR = {v: k for k, v in DIR_TO_VEC.items()}

    def bfs(start, targets, free_mask):
        """Simple BFS returning a list of actions to reach any cell in *targets*."""
        q = deque()
        q.append((start[0], start[1], []))
        visited = set()
        visited.add((start[0], start[1]))
        while q:
            x, y, path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in DIR_TO_VEC.items():
                nx, ny = x + dx, y + dy
                if (0 <= nx < free_mask.shape[0] and
                    0 <= ny < free_mask.shape[1] and
                    free_mask[nx, ny] and
                    (nx, ny) not in visited):
                    visited.add((nx, ny))
                    q.append((nx, ny, path + [a]))
        # no path found – return empty list (will likely fail later)
        return []

    def move_to(state, dest):
        """Return actions to move from current position to *dest* (empty cell)."""
        # free cells are those with no entities at all
        free_mask = np.all(state.grid == 0, axis=2)
        start = state.pos
        actions = bfs(start, {dest}, free_mask)
        return actions

    def approach_and_use(state, target_pos):
        """
        Generate actions to stand on a free cell adjacent to *target_pos*
        and face the target, then USE.
        """
        # choose an adjacent free cell (prefer the one with a clear approach)
        adj_candidates = []
        for dx, dy in DIR_TO_VEC.values():
            ax, ay = target_pos[0] - dx, target_pos[1] - dy  # cell opposite the target
            if (0 <= ax < state.grid.shape[0] and
                0 <= ay < state.grid.shape[1] and
                np.all(state.grid[ax, ay] == 0)):
                adj_candidates.append(((ax, ay), (dx, dy)))  # also store direction to target

        if not adj_candidates:
            # fallback: any free neighbour
            for dx, dy in DIR_TO_VEC.values():
                ax, ay = target_pos[0] + dx, target_pos[1] + dy
                if (0 <= ax < state.grid.shape[0] and
                    0 <= ay < state.grid.shape[1] and
                    np.all(state.grid[ax, ay] == 0)):
                    adj_candidates.append(((ax, ay), (-dx, -dy)))  # direction opposite
        # pick the first candidate
        (adj_cell, dir_vec) = adj_candidates[0]

        actions = move_to(state, adj_cell)

        # after moving, ensure we are facing the target.
        # The direction we need is the vector from adj_cell to target_pos.
        needed_dir = VEC_TO_DIR[dir_vec]
        # check current direction; if not correct, perform a small turn maneuver
        cur_dir = state.dir
        if cur_dir != needed_dir:
            # try to step one cell opposite to needed_dir (if free) and step back
            back_vec = (-dir_vec[0], -dir_vec[1])
            back_cell = (adj_cell[0] + back_vec[0], adj_cell[1] + back_vec[1])
            if (0 <= back_cell[0] < state.grid.shape[0] and
                0 <= back_cell[1] < state.grid.shape[1] and
                np.all(state.grid[back_cell[0], back_cell[1]] == 0)):
                actions.append(VEC_TO_DIR[back_vec])   # move away
                actions.append(needed_dir)            # move back, now facing target
            else:
                # as a last resort just move in any direction then back
                for a in (ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT):
                    if a != needed_dir:
                        actions.append(a)
                        actions.append(needed_dir)
                        break

        actions.append(ACTION_USE)   # interact with the target
        return actions

    # ----------------------------------------------------------------------
    # Begin main logic of make_arrow_vn
    # ----------------------------------------------------------------------
    # reset environment and obtain initial state
    env.reset()
    state = env._current_state

    # lookup indices
    arrow_idx = state.world.cookbook.index['arrow']
    recipe = state.world.cookbook.recipes[arrow_idx]

    # ------------------------------------------------------------------
    # 1) collect all required primitive resources
    # ------------------------------------------------------------------
    plan_actions = []
    for prim_idx, count in state.world.cookbook.primitives_for(arrow_idx).items():
        for _ in range(count):
            # locate a remaining instance of this primitive
            prim_positions = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_positions.size == 0:
                raise RuntimeError("Required primitive not found in the grid.")
            prim_pos = tuple(prim_positions[0])  # (x, y)

            # generate actions to collect it
            act_seq = approach_and_use(state, prim_pos)
            for a in act_seq:
                reward, done, obs = env.step(a)
                state = env._current_state
                plan_actions.append(a)
                if done:
                    return plan_actions

    # ------------------------------------------------------------------
    # 2) move to the workshop for the arrow and craft it
    # ------------------------------------------------------------------
    workshop_name = recipe['_at']          # e.g. "crafting_table"
    workshop_idx = state.world.cookbook.index[workshop_name]
    workshop_positions = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_positions.size == 0:
        raise RuntimeError("Workshop for arrow not found.")
    workshop_pos = tuple(workshop_positions[0])

    # actions to reach workshop and use it
    act_seq = approach_and_use(state, workshop_pos)
    for a in act_seq:
        reward, done, obs = env.step(a)
        state = env._current_state
        plan_actions.append(a)
        if done:
            return plan_actions

    # after crafting, the goal should be satisfied; return the accumulated plan
    return plan_actions


    # Ensure the environment is in a fresh state.
    try:
        env.reset()
    except Exception:
        # If reset is not available, ignore – the env may already be ready.
        pass

    # Determine the integer code for the USE action (craft / interact).
    action_map = env.action_specs()
    use_action = action_map.get("USE", 4)  # default to 4 if not found

    # Use a safe upper bound on the number of steps; many environments expose
    # a max_steps attribute, otherwise fall back to a reasonable constant.
    max_steps = getattr(env, "max_steps", 200)

    actions = []
    for _ in range(max_steps):
        # Stop early if the task is already completed.
        if hasattr(env, "_is_done") and env._is_done():
            break
        # Try to interact (collect / craft) at the current location.
        actions.append(use_action)
        env.step(use_action)

    return actions

