    # ----- helper functions -------------------------------------------------
    def _find_positions(grid, kind):
        """Return list of (x, y) positions where `kind` is present."""
        ys, xs = np.where(grid[:, :, kind] > 0)
        return list(zip(xs.tolist(), ys.tolist()))

    def _move_to(start_pos, target_pos, actions, act_map):
        """Greedy Manhattan move from start_pos to target_pos, appending actions."""
        x, y = start_pos
        tx, ty = target_pos
        while (x, y) != (tx, ty):
            if x < tx:
                actions.append(act_map["RIGHT"])
                x += 1
            elif x > tx:
                actions.append(act_map["LEFT"])
                x -= 1
            elif y < ty:
                actions.append(act_map["DOWN"])
                y += 1
            elif y > ty:
                actions.append(act_map["UP"])
                y -= 1
        return (x, y)

    # ----------------------------------------------------------------------
    # Get core objects from the environment
    world = env.world                     # CraftWorld instance
    state = env._current_state            # current CraftState
    grid = state.grid
    pos = tuple(state.pos)                # (x, y) agent position

    # Action mapping (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)
    act_map = env.action_specs()          # e.g. {"DOWN":0, "UP":1, ...}
    use_action = act_map["USE"]

    # Resolve the goal index for "arrow"
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)

    # ----------------------------------------------------------------------
    # 1. Gather required primitive resources
    primitives_needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    actions = []

    for prim_idx, count in primitives_needed.items():
        # Find any location that contains this primitive
        prim_positions = _find_positions(grid, prim_idx)
        if not prim_positions:
            # No primitive found – cannot continue; return empty plan
            return []
        target = prim_positions[0]   # pick the first occurrence

        for _ in range(count):
            # Move to the primitive cell
            pos = _move_to(pos, target, actions, act_map)
            # Pick it up
            actions.append(use_action)

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at", None)
    if workshop_idx is None:
        # No workshop information – cannot craft
        return actions

    workshop_positions = _find_positions(grid, workshop_idx)
    if not workshop_positions:
        # No workshop found – cannot craft
        return actions
    workshop_target = workshop_positions[0]

    # Move to the workshop cell
    pos = _move_to(pos, workshop_target, actions, act_map)
    # Use the workshop to craft the arrow
    actions.append(use_action)

    # Return the complete action sequence
    return actions

