    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    # Mapping from (dy,dx) to the corresponding movement action
    DIRS = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    def bfs_path(start, goal):
        """Return a list of movement actions that walks from ``start`` to ``goal``
        while avoiding cells that contain any non‑grabbable entity.
        If no path exists, an empty list is returned."""
        if start == goal:
            return []

        W, H = grid.shape[0], grid.shape[1]
        blocked = list(world.non_grabbable_indices)

        visited = np.full((W, H), False, dtype=bool)
        prev = {}  # (y,x) -> (prev_y, prev_x, action)

        q = deque()
        q.append(start)
        visited[start] = True

        while q:
            y, x = q.popleft()
            for (dy, dx), act in DIRS.items():
                ny, nx = y + dy, x + dx
                if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:
                    # Cell is free if none of the blocked kinds are present
                    if not np.any(grid[ny, nx, blocked] > 0):
                        visited[ny, nx] = True
                        prev[(ny, nx)] = (y, x, act)
                        if (ny, nx) == goal:
                            # Reconstruct path
                            actions = []
                            cur = (ny, nx)
                            while cur != start:
                                py, px, a = prev[cur]
                                actions.append(a)
                                cur = (py, px)
                            actions.reverse()
                            return actions
                        q.append((ny, nx))
        # No reachable path
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell that contains the entity ``kind_idx``.
        Returns a tuple (y, x) or None if the entity does not appear."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    primitive_requirements = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_requirements.items():
        for _ in range(needed_cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early; return actions gathered so far.
                return actions

            # Move to the primitive cell (standing on it is sufficient for USE)
            move_actions = bfs_path(cur_pos, target)
            actions.extend(move_actions)
            cur_pos = target

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions.extend(bfs_path(cur_pos, ws_cell))
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions

