    # Get current state and world information
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Identify the target item index for "arrow"
    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # Work on local copies so we can simulate actions without affecting the env
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape

    actions = []

    from collections import deque

    def bfs(start, goals):
        """Bread‑first search returning a list of movement actions to reach any goal cell."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # Treat any occupied cell as a wall unless it is a goal cell.
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update the simulated position according to a sequence of movement actions."""
        nonlocal pos
        for a in path:
            if a == 0:      # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1:    # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2:    # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3:    # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ------------------------------------------------------------------
    # Primitive collection helper
    def collect_primitive(prim_idx, needed):
        """Collect *needed* units of a primitive from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # Find all cells that still contain the primitive.
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                break  # No more of this primitive on the map.
            # Choose the first reachable primitive.
            path = None
            target = None
            for loc in locations:
                cand = bfs(pos, {loc})
                if cand is not None:
                    path = cand
                    target = loc
                    break
            if path is None:
                break  # Nothing reachable.
            actions.extend(path)
            move_along(path)
            # Use action to pick up the primitive.
            actions.append(4)          # USE
            grid[target[0], target[1], prim_idx] = 0
            inventory[prim_idx] += 1
            needed -= 1

    # ------------------------------------------------------------------
    # Recursive crafting helper
    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        """Guarantee that inventory[item_idx] >= amount by collecting/crafting."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives_set:
                # Primitive: just collect the missing amount.
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # Obtain the recipe for the item (may be empty if no recipe).
            recipe = recipes.get(item_idx, {})

            # First, make sure all ingredient quantities are available.
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # If the recipe requires a specific workshop, move next to it.
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # Perform the crafting action.
            actions.append(4)          # USE
            # Consume the ingredients.
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            # Add the newly crafted item to the inventory.
            inventory[item_idx] += 1

    # ------------------------------------------------------------------
    # Build the target arrow.
    ensure_item(target_idx, 1)

    return actions


