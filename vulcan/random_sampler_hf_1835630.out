    # ----------------------------------------------------------------------
    # Action / direction helpers (CraftLab action indices)
    # ----------------------------------------------------------------------
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search returning a list of actions that moves the agent
    # from ``start`` to a cell adjacent to any cell in ``targets`` while
    # avoiding non‑grabbable obstacles.
    # ----------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_to_adjacent(start, targets, grid):
        """Return actions that move from ``start`` to a position adjacent to any
        cell in ``targets``. ``grid`` has shape (W, H, K). Cells are blocked if
        they contain any non‑grabbable entity."""
        W, H = grid.shape[:2]

        # Build blocked mask using the environment's non‑grabbable indices.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start
        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()                     # mutable copy of world grid
    pos = tuple(state.pos)                       # (x, y)

    # Goal index stored in the task (could be int or struct with .goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive (and intermediate) requirements for the goal.
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # --------------------------------------------------------------
    # 1. Collect all required primitives / intermediate items.
    # --------------------------------------------------------------
    for kind_idx, count_needed in needed.items():
        while count_needed > 0:
            # Find all cells that currently contain this kind.
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive not present any more – abort planning.
                return plan

            # Move adjacent to the nearest such cell.
            path = bfs_to_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(ACTION_USE)

            # Identify which cell we are now adjacent to.
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected – break to avoid infinite loop.
                break

            # Update local grid copy and decrement needed count.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            count_needed -= 1

    # --------------------------------------------------------------
    # 2. Move to the required workshop (if any) and craft the goal.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name string or already an int).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft by using the workshop.
            plan.append(ACTION_USE)

    return plan


    import numpy as np
    from collections import deque

    # Action indices (as defined by CraftLab)
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,   # down (y + 1)
        (0, -1): ACTION_UP,    # up   (y - 1)
        (-1, 0): ACTION_LEFT,  # left (x - 1)
        (1, 0): ACTION_RIGHT,  # right(x + 1)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs(start, targets, grid):
        """
        Bread‑first search returning a list of actions that moves the agent
        from ``start`` to a cell adjacent to any cell in ``targets``.
        """
        W, H = grid.shape[:2]                     # grid dimensions (x, y)
        blocked = np.any(grid > 0, axis=2)        # any occupied cell blocks movement
        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()                 # mutable copy of the world grid
    pos = tuple(state.pos)                   # (x, y)

    # Goal index (stored in env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal not found in env.task")

    # Primitive requirements for the goal (including intermediate items)
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for kind_idx, cnt_needed in needed.items():
        while cnt_needed > 0:
            # Locate cells that currently contain this primitive
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive unavailable – abort planning
                return plan

            # Find path to a position adjacent to the nearest primitive
            path = bfs(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to keep ``pos`` up‑to‑date
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected; break to avoid infinite loop
                break

            # Update local grid copy and decrement needed count
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt_needed -= 1

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (name or integer)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft by using the workshop
            plan.append(ACTION_USE)

    return plan

