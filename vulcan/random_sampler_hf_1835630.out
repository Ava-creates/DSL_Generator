    # Identify the target item ("arrow") and its recipe
    arrow_idx = cookbook.index["arrow"]
    recipe = cookbook.recipes[arrow_idx]

    # Extract required ingredients (ignore the workshop entry)
    required = {k: v for k, v in recipe.items() if k != "_at"}

    # Make local mutable copies of grid, position and inventory for planning
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()

    width, height, _ = grid.shape
    actions = []

    # Helper: BFS to find shortest path from start to any goal cell,
    # allowing stepping onto the goal even if it is occupied.
    from collections import deque

    def bfs(start, goal_set):
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goal_set:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                nxt = (nx, ny)
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if nxt in visited:
                    continue
                # Blocked if any entity occupies the cell, unless it is a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goal_set:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    # Gather each required primitive
    for ing_idx, needed_cnt in required.items():
        # Locate all cells that currently hold this ingredient
        locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ing_idx] > 0]
        gathered = 0
        while gathered < needed_cnt and locations:
            target = locations.pop(0)

            # Move to the target cell
            path = bfs(pos, {target})
            if path is None:
                continue
            actions.extend(path)
            # Simulate movement
            for a in path:
                if a == 0:   # DOWN
                    pos = (pos[0], pos[1] + 1)
                elif a == 1:  # UP
                    pos = (pos[0], pos[1] - 1)
                elif a == 2:  # LEFT
                    pos = (pos[0] - 1, pos[1])
                elif a == 3:  # RIGHT
                    pos = (pos[0] + 1, pos[1])

            # Use action to pick up the item
            actions.append(4)  # USE
            # Update our local copies to reflect the pickup
            grid[target[0], target[1], ing_idx] = 0
            inventory[ing_idx] += 1
            gathered += 1

    # Move to the appropriate workshop for crafting the arrow
    workshop_name = recipe["_at"]
    workshop_idx = workshop_name if isinstance(workshop_name, int) else cookbook.index[workshop_name]
    workshop_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, workshop_idx] > 0]
    if workshop_cells:
        ws_target = workshop_cells[0]
        path = bfs(pos, {ws_target})
        if path:
            actions.extend(path)
            for a in path:
                if a == 0:
                    pos = (pos[0], pos[1] + 1)
                elif a == 1:
                    pos = (pos[0], pos[1] - 1)
                elif a == 2:
                    pos = (pos[0] - 1, pos[1])
                elif a == 3:
                    pos = (pos[0] + 1, pos[1])

    # Finally, use the workshop to craft the arrow
    actions.append(4)  # USE

    return actions

