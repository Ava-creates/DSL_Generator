    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    # Action indices – they match the ordering used in CraftLab.action_specs()
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4

    def _move_towards(state, target):
        """Return a list of actions that moves the agent from its current
        position to *target* using Manhattan moves only.

        The function also updates the environment by stepping through the
        actions, so that subsequent calls see the new position.
        """
        actions = []
        while True:
            x, y = state.pos
            tx, ty = target
            if (x, y) == (tx, ty):
                break
            if x < tx:
                act = ACTION_RIGHT
                nx, ny = x + 1, y
            elif x > tx:
                act = ACTION_LEFT
                nx, ny = x - 1, y
            elif y < ty:
                act = ACTION_DOWN
                nx, ny = x, y + 1
            else:  # y > ty
                act = ACTION_UP
                nx, ny = x, y - 1

            actions.append(act)
            _, _, obs = env.step(act)          # ignore reward & done
            state = env._current_state          # update reference
        return actions

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    # 1. reset environment and fetch the current state
    env.reset()
    state = env._current_state

    # 2. Resolve the index of the target item ("arrow") and its recipe
    arrow_idx = state.world.cookbook.index["arrow"]
    recipe = state.world.cookbook.recipes.get(arrow_idx, {})

    # 3. Determine which primitive kinds are needed and how many of each
    #    (primitives_for already expands intermediate items)
    needed = state.world.cookbook.primitives_for(arrow_idx)

    # 4. Collect each required primitive
    action_plan = []
    for prim_idx, count in needed.items():
        for _ in range(count):
            # locate the nearest cell that contains the primitive
            # (grid is shape (W, H, K) with binary occupancy)
            locations = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
            if not locations:
                # primitive not present – give up early
                return action_plan
            # pick the location with minimal Manhattan distance
            cur_x, cur_y = state.pos
            target = min(locations, key=lambda p: abs(p[0] - cur_x) + abs(p[1] - cur_y))

            # move to the primitive and pick it up
            action_plan += _move_towards(state, target)
            action_plan.append(ACTION_USE)          # pick up / collect
            _, _, obs = env.step(ACTION_USE)
            state = env._current_state

    # 5. Move to the appropriate workshop (if any) and craft the arrow
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = state.world.cookbook.index[workshop_name]
        # find any workshop cell
        workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
        if workshop_cells:
            target_ws = min(workshop_cells,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            action_plan += _move_towards(state, target_ws)

    # finally use the craft action
    action_plan.append(ACTION_USE)

    # return the complete list of actions
    return action_plan

