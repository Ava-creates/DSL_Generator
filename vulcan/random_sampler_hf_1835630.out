    blocked = np.any(grid, axis=2)   # any non‑zero kind blocks movement

    plan = []          # list of action indices to return
    harvested = set()  # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # All cells currently containing this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position to reduce travel.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed:
                break
            if cell in harvested:
                continue
            # Move adjacent to the primitive.
            path = bfs_adjacent(pos, [cell], blocked)
            plan.extend(path)
            pos = apply_actions(pos, path)

            # Pick up the primitive.
            plan.append(USE)

            # Update planning structures: remove the primitive from the grid,
            # recompute blocked map, and remember the cell.
            grid[cell[0], cell[1], prim_idx] = 0
            blocked = np.any(grid, axis=2)
            harvested.add(cell)
