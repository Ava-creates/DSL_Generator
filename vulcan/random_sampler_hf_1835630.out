    import collections, numpy as np

    # Action indices matching CraftWorld definitions
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # BFS that returns a sequence of actions moving the agent to a cell
    # orthogonally adjacent to any target cell (stops as soon as adjacency
    # is achieved).  It walks only on currently empty cells.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # adjacency test
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # unreachable (should not happen in valid maps)

    # ------------------------------------------------------------------
    # Apply a list of actions to a position, returning the resulting coord.
    # ------------------------------------------------------------------
    def _apply(pos, actions):
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate the underlying CraftWorld and its Cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if the wrapper hasn't done so).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal setup.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for the goal (primitive index -> count).
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Planning state.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                 # current (x, y)
    grid = state.grid.copy()               # (W, H, n_kinds)
    occupied = np.any(grid, axis=2)        # bool mask of occupied cells
    plan_actions = []                      # final action list
    harvested = set()                      # cells already collected from

    # ------------------------------------------------------------------
    # 1) Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # locate all cells containing this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # greedy order by Manhattan distance from current position
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed_cnt:
                break
            if cell in harvested:
                continue
            # move to a cell adjacent to the primitive
            path = _bfs_adjacent(pos, [cell], occupied)
            plan_actions.extend(path)
            pos = _apply(pos, path)

            # pick it up
            plan_actions.append(USE)

            # update planning structures: primitive disappears, cell becomes free
            grid[cell[0], cell[1], prim_idx] = 0
            occupied = np.any(grid, axis=2)
            harvested.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_adjacent(pos, [target_ws], occupied)
            plan_actions.extend(path)
            pos = _apply(pos, path)
            plan_actions.append(USE)          # craft at the workshop
        else:
            # workshop not visible – attempt crafting at current location
            plan_actions.append(USE)
    else:
        # No specific workshop required; craft wherever we are.
        plan_actions.append(USE)

    return plan_actions


    import collections, numpy as np

    # Action indices as defined in CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_adjacent(start, targets, blocked):
        """Breadth‑first search that stops when we are orthogonally adjacent
        to any cell in *targets*. Returns a list of actions to reach such a
        position (empty list if already adjacent)."""
        w, h = blocked.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # check adjacency
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell – return empty list (should not happen)
        return []

    def _apply(pos, actions):
        """Return the new position after executing *actions* from *pos*."""
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate the world and its cookbook inside the provided env object.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the underlying state directly.
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal information.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for the goal (primitive_index -> count).
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Planning structures.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # current (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    blocked = np.any(grid, axis=2)             # occupied mask (bool)

    plan_actions = []                          # final action list
    harvested = set()                          # cells already collected from

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # locate all cells that currently contain this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from the current position (greedy)
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed_cnt:
                break
            if cell in harvested:
                continue
            # move adjacent to the primitive
            path = _bfs_adjacent(pos, [cell], blocked)
            plan_actions.extend(path)
            pos = _apply(pos, path)

            # pick it up
            plan_actions.append(USE)

            # update planning structures: primitive disappears, cell becomes free
            grid[cell[0], cell[1], prim_idx] = 0
            blocked = np.any(grid, axis=2)
            harvested.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # workshop may be given as a string name or directly as an index
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_adjacent(pos, [target_ws], blocked)
            plan_actions.extend(path)
            pos = _apply(pos, path)
            plan_actions.append(USE)          # craft at the workshop
        else:
            # workshop not visible – attempt crafting at current location
            plan_actions.append(USE)
    else:
        # No specific workshop required; craft wherever we are.
        plan_actions.append(USE)

    return plan_actions

