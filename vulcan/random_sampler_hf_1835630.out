    import numpy as np
    from collections import deque

    # Action indices (as defined in CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and obtain current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Goal item index and its primitive requirements
    goal_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """True if cell at ``pos`` contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs_path(start, goal):
        """Shortest walkable path from ``start`` to ``goal`` (excluding start)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            return []  # no path found

        # Reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Translate a position path into movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Locate the nearest cell containing ``kind``."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of ``target`` (preferring N,S,W,E)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos  # current (y, x)

    # Collect each required primitive the needed number of times
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive missing – abort early
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur, stand_pos)
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive cell itself
            path = bfs_path(cur, prim_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick up the primitive
            actions.append(USE)

            # Update grid to reflect collection
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # If the recipe specifies a workshop, go there
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and grab the current state/world objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for bookkeeping

    # Index of the goal item ("arrow") and its primitive requirements
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """True if the cell at ``pos`` contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs_path(start, goal):
        """Shortest walkable path from ``start`` to ``goal`` (list of positions)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            return []  # no path found

        # reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions into movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Return position of the nearest cell containing ``kind``."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Find a walkable neighbour of ``target`` (prefers N,S,W,E)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos  # current agent position (y, x)

    # Collect each required primitive the needed number of times
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                return actions  # primitive missing; abort

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur, stand_pos)
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Ensure we are facing the primitive: move one step away and back if needed
            dy = prim_loc[0] - cur[0]
            dx = prim_loc[1] - cur[1]
            needed_dir = None
            if dy == -1:
                needed_dir = DOWN
                opposite = UP
                opp_move = (cur[0] - 1, cur[1])
            elif dy == 1:
                needed_dir = UP
                opposite = DOWN
                opp_move = (cur[0] + 1, cur[1])
            elif dx == -1:
                needed_dir = RIGHT
                opposite = LEFT
                opp_move = (cur[0], cur[1] - 1)
            elif dx == 1:
                needed_dir = LEFT
                opposite = RIGHT
                opp_move = (cur[0], cur[1] + 1)

            if needed_dir is not None:
                # Try a quick turn by stepping away and back if possible
                if 0 <= opp_move[0] < grid.shape[0] and 0 <= opp_move[1] < grid.shape[1] and not is_blocked(opp_move):
                    # step away
                    actions.append({UP: UP, DOWN: DOWN, LEFT: LEFT, RIGHT: RIGHT}[opposite])
                    # step back towards primitive
                    actions.append(needed_dir)
                else:
                    # cannot step away; just add a dummy move in needed direction (will stay in place)
                    actions.append(needed_dir)

            # Pick up the primitive
            actions.append(USE)

            # Update local grid copy to reflect collection
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # Move to the workshop required for crafting the arrow (if any)
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions

