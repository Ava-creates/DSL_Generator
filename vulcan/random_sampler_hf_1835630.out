    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return a list of actions to reach any cell in goals."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat any occupied cell as blocked unless it is a goal
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update simulated position following actions in path."""
        nonlocal pos
        for a in path:
            if a == 0:      # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1:    # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2:    # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3:    # RIGHT
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(kind_idx, needed):
        """Collect `needed` units of primitive `kind_idx` from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate all cells that currently hold the primitive
            candidates = [(x, y) for x in range(width) for y in range(height)
                          if grid[x, y, kind_idx] > 0]
            if not candidates:
                break
            # find the nearest reachable candidate
            path = None
            target = None
            for cand in candidates:
                p = bfs(pos, {cand})
                if p is not None:
                    path = p
                    target = cand
                    break
            if path is None:
                break
            actions.extend(path)
            move_along(path)
            actions.append(4)   # USE
            grid[target[0], target[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    recipes = cookbook.recipes
    primitives = cookbook.primitives

    def ensure(item_idx, amount):
        """Make sure at least `amount` of `item_idx` are in inventory."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            # first, obtain all ingredients
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure(ing_idx, cnt)

            # move to workshop if required
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    p = bfs(pos, {ws_cells[0]})
                    if p:
                        actions.extend(p)
                        move_along(p)

            # craft the item
            actions.append(4)   # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    ensure(target_idx, 1)

    return actions


    # Access current state and world information
    state = env._current_state
