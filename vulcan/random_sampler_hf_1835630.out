        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        # locate workshop cells
        workshop_locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, workshop_idx] > 0)]
        if workshop_locs:
            workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_locs[0]
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
    else:
        # no specific workshop – just use the craft action at current location
        actions.append(USE)

    return actions


