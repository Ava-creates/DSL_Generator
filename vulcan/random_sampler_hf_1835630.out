    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Action ↔ direction helpers (environment uses 0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
    # ------------------------------------------------------------------
    DIR2ACT = {
        (0, 1): 0,    # DOWN
        (0, -1): 1,   # UP
        (-1, 0): 2,   # LEFT
        (1, 0): 3,    # RIGHT
    }
    ACT2DIR = {a: d for d, a in DIR2ACT.items()}

    # ------------------------------------------------------------------
    # Bread‑first search that returns a list of actions moving the agent
    # from ``start`` to a cell adjacent (Manhattan distance 1) to any
    # cell in ``targets`` while avoiding cells that contain any index in
    # ``blocked_kinds``.
    # ------------------------------------------------------------------
    def bfs_adjacent(start, targets, grid, blocked_kinds):
        W, H = grid.shape[:2]

        # Build a boolean mask of blocked cells.
        blocked = np.zeros((W, H), dtype=bool)
        for k in blocked_kinds:
            blocked |= grid[:, :, k] > 0

        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.zeros((W, H), dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ------------------------------------------------------------------
    # Initialise environment state.
    # ------------------------------------------------------------------
    # Ensure the environment has been reset; ``reset`` also returns the
    # initial observation which we do not need here.
    _ = env.reset()
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)                     # (x, y)

    # Goal index (the item we need to craft).
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # Primitive requirements for the goal (only raw resources).
    required_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    blocked_kinds = env.world.non_grabbable_indices

    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in required_prims.items():
        while needed_cnt > 0:
            # Locate all cells that still contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present anywhere – abort planning.
                return plan

            # Find actions to become adjacent to the nearest reachable primitive.
            path = bfs_adjacent(pos, prim_cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(4)   # USE action

            # Identify which primitive cell we are adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Something went wrong; break to avoid infinite loop.
                break

            # Update our local copy of the grid and decrement need.
            grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
            needed_cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve the workshop kind index.
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement to workshop adjacency.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft the item by using the workshop.
            plan.append(4)   # USE action

    return plan

