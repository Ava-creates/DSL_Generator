    # Action mapping provided by the environment
    act_map = env.action_specs()
    DOWN = act_map["DOWN"]
    UP = act_map["UP"]
    LEFT = act_map["LEFT"]
    RIGHT = act_map["RIGHT"]
    USE = act_map["USE"]

    # Goal information (arrow)
    goal_name = "arrow"
    goal_idx = env.world.cookbook.index[goal_name]

    # Primitive requirements for the goal
    primitive_reqs = env.world.cookbook.primitives_for(goal_idx)

    # Workshop location for the goal (if any)
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = (
        env.world.cookbook.index[workshop_name] if workshop_name is not None else None
    )

    # Helper: locate the nearest cell containing a given kind index
    def _nearest_position(kind_idx):
        grid = env._current_state.grid[:, :, kind_idx]
        positions = np.argwhere(grid > 0)
        if positions.size == 0:
            return None
        cur = np.array(env._current_state.pos)
        dists = np.sum(np.abs(positions - cur), axis=1)
        return tuple(positions[dists.argmin()])

    # Helper: generate a simple Manhattan‑distance path (right/left then down/up)
    def _path_to(start, target):
        actions = []
        x, y = start
        tx, ty = target
        while x != tx:
            if x < tx:
                actions.append(RIGHT)
                x += 1
            else:
                actions.append(LEFT)
                x -= 1
        while y != ty:
            if y < ty:
                actions.append(DOWN)
                y += 1
            else:
                actions.append(UP)
                y -= 1
        return actions

    actions = []
    max_total_steps = 2000  # safety guard
    steps_taken = 0

    while steps_taken < max_total_steps:
        # Goal satisfied?
        if env._current_state.satisfies("", goal_idx):
            break

        inventory = env._current_state.inventory

        # ------------------------------------------------------------------
        # 1) If we already have all required primitives, go to the workshop
        # ------------------------------------------------------------------
        have_all = all(inventory[p] >= cnt for p, cnt in primitive_reqs.items())
        if have_all and workshop_idx is not None:
            target_pos = _nearest_position(workshop_idx)
            if target_pos is None:
                break  # no workshop found – abort
            if tuple(env._current_state.pos) != target_pos:
                # move towards the workshop
                for a in _path_to(env._current_state.pos, target_pos):
                    actions.append(a)
                    env.step(a)
                    steps_taken += 1
                continue
            else:
                # at workshop – craft the item
                actions.append(USE)
                env.step(USE)
                steps_taken += 1
                continue

        # ---------------------------------------------------------------
        # 2) Otherwise, collect a missing primitive (pick the first lacking)
        # ---------------------------------------------------------------
        lacking = [(p, cnt - inventory[p]) for p, cnt in primitive_reqs.items() if inventory[p] < cnt]
        if not lacking:
            # nothing to collect (should not happen)
            break
        need_idx, _ = lacking[0]
        target_pos = _nearest_position(need_idx)
        if target_pos is None:
            break  # primitive not present – abort
        if tuple(env._current_state.pos) != target_pos:
            # move towards the primitive
            for a in _path_to(env._current_state.pos, target_pos):
                actions.append(a)
                env.step(a)
                steps_taken += 1
            continue
        else:
            # at primitive location – pick it up
            actions.append(USE)
            env.step(USE)
            steps_taken += 1
            continue

    return actions


    actions = []
    # Access the world and its cookbook
    world = env.world
    cookbook = world.cookbook
    idx = cookbook.index

    # Goal item name
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return actions
    goal_idx = idx[goal_name]

    # Primitive requirements for one arrow (transitive)
