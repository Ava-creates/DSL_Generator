    # ----------------------------------------------------------------------
    # Helper: deterministic hash for a CraftState (to avoid revisiting)
    # ----------------------------------------------------------------------
    def _state_hash(st):
        # pos, dir, inventory (as tuple) and the raw grid bytes uniquely
        # identify a state for the purpose of planning.
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    # ----------------------------------------------------------------------
    # Bread‑first search over (state, action_sequence) pairs
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])
    frontier = deque([Node(init_state, [])])
    visited = { _state_hash(init_state) }

    MAX_STEPS = 400                     # safety bound for plan length
    n_actions = getattr(world, "n_actions", 5)   # default: 4 moves + USE

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: arrow present in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No feasible plan found within the limits
    return []

