    # ----------------------------------------------------------------------
    # Constants and direction helpers
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ----------------------------------------------------------------------
    # Helper: BFS shortest path that avoids non‑grabbable entities
    # ----------------------------------------------------------------------
    def _bfs_path(src, dst, grid):
        h, w, _ = grid.shape
        blocked_kinds = env.world.non_grabbable_indices

        def cell_free(r, c):
            if not (0 <= r < h and 0 <= c < w):
                return False
            # cell is blocked if any non‑grabbable kind has a positive count
            return not any(grid[r, c, k] > 0 for k in blocked_kinds)

        from collections import deque
        q = deque([src])
        parent = {src: None}
        while q:
            r, c = q.popleft()
            if (r, c) == dst:
                break
            for dr, dc, act in DIRS:
                nr, nc = r + dr, c + dc
                if (nr, nc) not in parent and cell_free(nr, nc):
                    parent[(nr, nc)] = (r, c, act)
                    q.append((nr, nc))
        if dst not in parent:
            return []                     # no reachable path

        # reconstruct action list
        actions = []
        cur = dst
        while parent[cur] is not None:
            pr, pc, act = parent[cur]
            actions.append(act)
            cur = (pr, pc)
        actions.reverse()
        return actions

    # ----------------------------------------------------------------------
    # Helper: locate the nearest cell (Manhattan) containing a given kind
    # ----------------------------------------------------------------------
    def _nearest_cell(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ----------------------------------------------------------------------
    # Helper: locate any cell containing a given kind (used for workshops)
    # ----------------------------------------------------------------------
    def _any_cell(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ----------------------------------------------------------------------
    # Initialise a fresh episode
    # ----------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # ----------------------------------------------------------------------
    # Identify the goal index for "arrow"
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:                 # recipe not found
        return []

    # ----------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ----------------------------------------------------------------------
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ----------------------------------------------------------------------
    # Collect each required primitive (respecting required counts)
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = _nearest_cell(state.grid, prim_idx, state.pos)
            if target is None:          # primitive missing – abort early
                return action_seq
            # Move to the primitive using BFS path
            for a in _bfs_path(state.pos, target, state.grid):
                _, done, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick it up
            _, done, _ = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ----------------------------------------------------------------------
    # Craft the arrow (possibly at a required workshop)
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any_cell(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _bfs_path(state.pos, workshop_pos, state.grid):
                _, done, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
    # Perform the crafting action
    _, done, _ = env.step(USE)
    action_seq.append(USE)

    return action_seq


