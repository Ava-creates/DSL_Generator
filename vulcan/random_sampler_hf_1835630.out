    # standard action ids
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `start`
    # to a cell adjacent (Manhattan distance 1) to any cell in `targets`.
    # ------------------------------------------------------------------
    def _bfs_adj(start, targets, occ):
        w, h = occ.shape
        q = collections.deque([(start[0], start[1], [])])
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # adjacency check
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Locate the world and its cookbook
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        st = getattr(env, "_current_state", None)
        if st is not None:
            world = getattr(st, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in env.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal: arrow
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow
    needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh episode and obtain the current state
    # ------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid                           # (W, H, n_kinds)
    occupied = np.any(grid > 0, axis=2)        # True where blocked

    actions = []
    used_cells = set()                         # primitives already collected

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest first)
    # ------------------------------------------------------------------
    for prim_idx, qty in needed.items():
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        have = 0
        for loc in locations:
            if have >= qty:
                break
            if loc in used_cells:
                continue
            # move adjacent to the primitive
            path = _bfs_adj(pos, [loc], occupied)
            actions.extend(path)
            # update position according to the path taken
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # pick up the primitive
            actions.append(USE)
            occupied[loc[0], loc[1]] = False   # cell becomes free
            used_cells.add(loc)
            have += 1

    # ------------------------------------------------------------------
    # Craft at the required workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else workshop_key)
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if not ws_cells:
            raise RuntimeError(f"Workshop '{workshop_key}' not found.")
        ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        target_ws = ws_cells[0]
        path = _bfs_adj(pos, [target_ws], occupied)
        actions.extend(path)
        for act in path:
            if act == RIGHT:
                pos = (pos[0] + 1, pos[1])
            elif act == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif act == DOWN:
                pos = (pos[0], pos[1] + 1)
            elif act == UP:
                pos = (pos[0], pos[1] - 1)
        actions.append(USE)

    return actions


    # standard action ids
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `start`
    # to a cell adjacent (Manhattan distance = 1) to any cell in `targets`.
    # The search avoids any occupied cell (grid[...,kind] > 0 for any kind).
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where blocked
        q = collections.deque([(start[0], start[1], [])])
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # adjacency test
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # explore neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # unreachable – return empty list
        return []

    # ------------------------------------------------------------------
    # Locate world and cookbook
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # some wrappers store world inside the current state
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in env.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal: arrow
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # primitive requirements for one arrow
    needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh episode and fetch current state
    # ------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)                        # (x, y)
    grid = state.grid                              # (W, H, n_kinds)

    actions = []
    used_cells = set()                             # primitives already collected

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest first)
    # ------------------------------------------------------------------
    for prim_idx, qty in needed.items():
        # locate all cells containing this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from current position
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        have = 0
        for loc in locations:
            if have >= qty:
                break
            if loc in used_cells:
                continue
            # move adjacent to the primitive
            path = _bfs_adjacent(pos, [loc])
            actions.extend(path)
            # update agent position following the path
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # pick up the primitive
            actions.append(USE)
            used_cells.add(loc)
            have += 1

    # ------------------------------------------------------------------
    # Go to the appropriate workshop (if recipe specifies) and craft
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (may be a string name)
        ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if not ws_cells:
            raise RuntimeError(f"No workshop '{workshop_key}' found in the grid.")
        # choose nearest workshop
        ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        target_ws = ws_cells[0]
        path = _bfs_adjacent(pos, [target_ws])
        actions.extend(path)
        for act in path:
            if act == RIGHT:
                pos = (pos[0] + 1, pos[1])
            elif act == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif act == DOWN:
                pos = (pos[0], pos[1] + 1)
            elif act == UP:
                pos = (pos[0], pos[1] - 1)
        # craft at the workshop
        actions.append(USE)

    return actions

