    # ------------------------------------------------------------------
    # Constants and helpers
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    def _bfs(start, goal, grid):
        """Return a list of actions to move from start to goal (inclusive)."""
        if start == goal:
            return []
        w, h, _ = grid.shape
        from collections import deque
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited:
                    continue
                # a cell is blocked if it contains any entity except the goal cell
                if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:
                    continue
                new_path = path + [act]
                if (nx, ny) == goal:
                    return new_path
                visited.add((nx, ny))
                q.append(((nx, ny), new_path))
        # no path found – return empty list (will likely fail later)
        return []

    # ------------------------------------------------------------------
    # Access world / cookbook (works for raw env and CraftLab wrappers)
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # CraftLab stores the world inside the current state object
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = cur_state.world
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal information (hard‑coded to the "arrow" item)
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Obtain current state (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        # raw env: initialise from the scenario directly
        if hasattr(env, "scenario"):
            state = env.scenario.init()
        else:
            # fallback – try to reset the environment
            env.reset()
            state = getattr(env, "_current_state", None)
    pos = tuple(state.pos)          # (x, y)
    grid = state.grid.copy()        # mutable copy so we can clear collected items

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            # locate all cells still containing this primitive
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                # nothing left – abort early
                break
            # pick the nearest location (Manhattan distance heuristic)
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locations[0]

            # move to the primitive cell
            path = _bfs(pos, target, grid)
            actions.extend(path)
            # update position according to the path taken
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # pick it up
            actions.append(USE)
            # clear the primitive from the grid copy
            grid[pos[0], pos[1], prim_idx] = 0
            collected += 1

    # ------------------------------------------------------------------
    # Move to required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (could be a name or already an int)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str)
            else workshop_key
        )
        # locate workshop cells
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = ws_locs[0]
            # move to the workshop cell
            path = _bfs(pos, ws_target, grid)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # craft using the workshop
            actions.append(USE)

    return actions


    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions from start to goal.
    # Goal cell may be occupied (e.g., contains the primitive we want).
    # ------------------------------------------------------------------
    def _bfs_path(start, goal, grid):
        if start == goal:
            return []
        w, h, _ = grid.shape
        from collections import deque
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited:
                    continue
                # treat the goal cell as traversable even if occupied
                if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:
                    continue
                new_path = path + [act]
                if (nx, ny) == goal:
                    return new_path
                visited.add((nx, ny))
                q.append(((nx, ny), new_path))
        return []  # no path found

    # ------------------------------------------------------------------
    # Retrieve world and cookbook (works for both raw env and CraftLab)
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # CraftLab stores the world inside the current state object
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal information (hard‑coded to "arrow")
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Obtain current state (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        # fallback: initialise from the scenario directly
        state = env.scenario.init()
    pos = tuple(state.pos)          # (x, y)
    grid = state.grid.copy()        # mutable copy for bookkeeping

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            # Find all cells still containing this primitive
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                break  # should not happen in a valid scenario
            # Choose the closest one (Manhattan distance)
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locations[0]

            # Move to the primitive
            actions.extend(_bfs_path(pos, target, grid))
            pos = target

            # Pick it up
            actions.append(USE)

            # Update bookkeeping
            grid[pos[0], pos[1], prim_idx] = 0
            collected += 1

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be name or integer)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str)
            else workshop_key
        )
        # Locate workshop cells
        ws_locations = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locations:
            ws_locations.sort(
                key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])
            )
            ws_target = ws_locations[0]

            # Move to workshop
            actions.extend(_bfs_path(pos, ws_target, grid))
            pos = ws_target

            # Craft
            actions.append(USE)

    return actions

