    # ----------------------------------------------------------------------
    # Helper mappings between directions and action indices (as defined in CraftLab)
    # ----------------------------------------------------------------------
    DIR_TO_ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search that returns a list of actions moving the agent from
    # ``start`` to a cell that is Manhattan‑adjacent to any cell in ``targets``.
    # Cells occupied by any *non‑grabbable* entity are considered blocked.
    # ----------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_to_adjacent(start, targets, grid):
        """Return a list of actions that brings the agent adjacent to a target."""
        W, H = grid.shape[:2]

        # Build a blocked mask: any cell containing a non‑grabbable entity blocks movement.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start

        # If already adjacent, no movement needed.
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Extract current state information.
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()               # mutable copy for planning
    pos = tuple(state.pos)                 # (x, y)

    # Goal index is stored in the task object.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in the environment's task.")

    # Primitive requirements for the goal (primitive kind → count).
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    plan = []  # List of action indices to be returned.

    # ----------------------------------------------------------------------
    # 1. Collect all required primitive resources.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        while needed_cnt > 0:
            # Locate all cells that currently contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more of this primitive on the map – abort planning.
                return plan

            # Find a path to the nearest reachable primitive (adjacent).
            path = bfs_to_adjacent(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive.
            plan.append(4)   # USE

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update simulated grid copy (remove one instance) and decrement counter.
            grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
            needed_cnt -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        # Locate workshop cells on the current grid.
        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to the workshop.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft the item by using the workshop.
            plan.append(4)   # USE

    return plan


    """Plan a sequence of actions that makes an ``arrow`` in the given environment.

    The planner extracts the primitive requirements for the goal from the
    cookbook, walks to each needed primitive, picks it up (USE), then walks to
    the appropriate workshop (if any) and crafts the item (USE again).  The
    returned list can be fed directly to the environment via ``step`` calls.
    """
    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Helpers for movement ↔ action conversion.
    # ------------------------------------------------------------------
    DIR_TO_ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    # ------------------------------------------------------------------
    # Bread‑first search that returns a list of actions moving the agent
    # from ``start`` to a cell that is Manhattan‑adjacent to any cell in
    # ``targets``.  Any occupied cell (including primitives) is treated as
    # blocked for movement.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, targets, grid):
        """Return a list of actions to reach a neighbour of one of ``targets``."""
        W, H = grid.shape[:2]

        # A cell is blocked if *any* kind is present there.
        blocked = np.any(grid, axis=2)

        sx, sy = start

        # Already adjacent to a target?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ------------------------------------------------------------------
    # Extract current state information.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy for planning simulation
    pos = tuple(state.pos)            # (x, y)

    # Goal index is stored in the task (a Task namedtuple).
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # ------------------------------------------------------------------
    # Determine which primitive resources are required for the goal.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []  # final list of action indices

    # ------------------------------------------------------------------
    # 1. Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        while required_cnt > 0:
            # Locate all cells that currently contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present on the map – abort planning.
                return plan

            # Find a path to the nearest reachable primitive (adjacent).
            path = bfs_to_adjacent(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Simulate the movement.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive.
            plan.append(4)   # USE

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation – stop to avoid an infinite loop.
                break

            # Update simulated grid (remove one instance) and decrement count.
            grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
            required_cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop kind index (string name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        # Locate workshop cells on the current grid.
        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to the workshop.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft the item by using the workshop.
            plan.append(4)   # USE

    return plan

