        init_state = scenario.init()
    except Exception:
        return []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory (as tuple) and grid bytes
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # ------------------------------------------------------------------
    # BFS search configuration
    # ------------------------------------------------------------------
    visited = set()
    frontier = deque()
    frontier.append(Node(init_state, []))
    visited.add(_state_hash(init_state))

    MAX_STEPS = 300                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)

    # Optionally compute primitive requirements (used only for pruning)
    try:
        primitive_req = world.cookbook.primitives_for(arrow_idx)
    except Exception:
        primitive_req = {}

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", arrow_idx):
            return node.actions

        # Depth limit
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand neighbours
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h in visited:
                continue

            # Simple pruning: if we already collected more primitives than needed,
            # and we have no crafted items that could be useful, skip.
            if primitive_req:
                inv = nxt_state.inventory
                over = False
                for prim_idx, needed in primitive_req.items():
                    if inv[prim_idx] > needed:
                        over = True
                        break
                if over:
                    # allow if we also have the arrow (handled above) or other
                    # non‑primitive items that might be intermediate; we keep it simple
                    pass

            visited.add(h)
            frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within limits
    return []

