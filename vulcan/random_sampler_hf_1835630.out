    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell adjacent (Manhattan distance = 1) to any cell in
    # `targets`.  Cells that contain any entity are treated as blocked,
    # except the target cells themselves (we only need to get next to them).
    # ------------------------------------------------------------------
    import collections

    def _bfs_adjacent(start, targets, occupied):
        w, h = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited or occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Retrieve world / state objects from the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]

    # ------------------------------------------------------------------
    # Determine primitive resources needed for a single arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    if not primitives_needed:
        # Arrow itself is primitive – just use the current cell.
        return [USE]

    # ------------------------------------------------------------------
    # Current grid, agent position and occupancy mask.
    # ------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # locations already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # Find all remaining instances of this primitive.
            prim_locs = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not prim_locs:
                # No more of this primitive on the map – abort early.
                break

            # Choose the closest primitive (Manhattan distance).
            prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = prim_locs[0]

            # Plan path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement.
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # Update occupancy (the primitive cell becomes empty).
            occupied[target] = False

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        # Locate workshop cells of the required type.
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Move to the nearest workshop.
            workshop_cells.sort(
                key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])
            )
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)  # craft at workshop
        else:
            # No workshop found – fall back to using current cell.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    import collections
    import numpy as np

    # Action indices – match default CraftWorld ordering.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell adjacent (Manhattan distance = 1) to any cell in
    # `targets`. Cells that contain any entity are treated as blocked.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        w, h = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Retrieve world / state objects from the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Likely a wrapped CraftLab instance.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        # Raw CraftWorld / CraftScenario.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]

    # ------------------------------------------------------------------
    # Determine primitive resources needed for a single arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    if not primitives_needed:
        # Arrow itself is primitive – just use the current cell.
        return [USE]

    # ------------------------------------------------------------------
    # Current grid, agent position and occupancy mask.
    # ------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # locations already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # Locate all remaining instances of this primitive.
            prim_cells = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not prim_cells:
                # No more of this primitive on the map – abort early.
                break

            # Choose the closest primitive (Manhattan distance).
            prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = prim_cells[0]

            # Plan a path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement to update `pos`.
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # Update occupancy mask – the primitive cell becomes empty.
            occupied[target] = False

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        # Locate all workshop cells of the required type.
        ws_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if ws_cells:
            # Choose the nearest workshop.
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = ws_cells[0]

            # Move adjacent to the workshop.
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use to craft.
            actions.append(USE)
        else:
            # No workshop found – fall back to using current cell.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions

