    # Determine the goal index for the arrow
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        try:
            goal_idx = world.cookbook.index["arrow"]
        except Exception as e:
            raise RuntimeError("Unable to locate goal index for 'arrow'") from e

    # Primitive requirements for the goal (expanded to raw resources)
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    actions = []
    cur_pos = tuple(state.pos)

    # Helper to move Manhattan-style from current position to target
    def _move_to(target):
        nonlocal cur_pos
        tx, ty = target
        # Move in x direction
        while cur_pos[0] < tx:
            actions.append(RIGHT)
            cur_pos = (cur_pos[0] + 1, cur_pos[1])
        while cur_pos[0] > tx:
            actions.append(LEFT)
            cur_pos = (cur_pos[0] - 1, cur_pos[1])
        # Move in y direction
        while cur_pos[1] < ty:
            actions.append(DOWN)
            cur_pos = (cur_pos[0], cur_pos[1] + 1)
        while cur_pos[1] > ty:
            actions.append(UP)
            cur_pos = (cur_pos[0], cur_pos[1] - 1)

    # Collect each required primitive
    for prim_idx, needed in primitive_requirements.items():
        # Find all cells containing this primitive
        locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
        if locations.size == 0:
            # Primitive not present on the map; skip (cannot craft)
            continue
        # Choose the first occurrence as a target
        target = tuple(locations[0])
        _move_to(target)
        # Pick up the required amount (USE once per unit)
        for _ in range(needed):
            actions.append(USE)

    # Locate the workshop for the final crafting step
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_key") or recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.get(workshop_name)
        if workshop_idx is not None:
            ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
            if ws_locs.size > 0:
                ws_pos = tuple(ws_locs[0])
                _move_to(ws_pos)
                actions.append(USE)  # craft the arrow at the workshop

    return actions

