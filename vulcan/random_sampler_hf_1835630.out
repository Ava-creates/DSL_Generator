    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    _MOVES = [
        ((0, 1), DOWN),   # down  (y+1)
        ((0, -1), UP),    # up    (y-1)
        ((-1, 0), LEFT),  # left  (x-1)
        ((1, 0), RIGHT),  # right (x+1)
    ]

    def _bfs_path(start, goal, grid):
        """Return a list of actions that moves from start to goal using BFS.
        Cells that contain any non‑zero kind are treated as blocked,
        except the goal cell itself (which may hold the target item)."""
        w, h = grid.shape[0], grid.shape[1]          # width (x), height (y)
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in _MOVES:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal cell even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []   # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Return [x, y] of the nearest cell containing kind_idx, or None."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)   # y‑rows, x‑cols
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Initialise planning state
    # ------------------------------------------------------------------
    actions = []

    # Current position (list so we can modify in‑place)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Working copy of the grid – we will zero out primitives once taken
    grid = env.scenario.init_grid.copy()

    # Goal item index
    goal_idx = env.task.goal

    cookbook = env.world.cookbook
    primitives_set = cookbook.primitives
    recipes = cookbook.recipes
    init_grid = env.scenario.init_grid   # for locating static workshops

    # ------------------------------------------------------------------
    # Recursive planning function
    # ------------------------------------------------------------------
    def _ensure_item(item_idx):
        """Plan actions guaranteeing one unit of `item_idx` in the inventory."""
        # Primitive – just collect it from the world
        if item_idx in primitives_set:
            target = _nearest_kind(item_idx, cur_pos, grid)
            if target is None:
                return False
            # move to primitive
            actions.extend(_bfs_path(cur_pos, target, grid))
            actions.append(USE)               # pick up
            # mark cell as empty for later planning
            grid[target[1], target[0], item_idx] = 0
            cur_pos[0], cur_pos[1] = target[0], target[1]
            return True

        # Non‑primitive – need to craft using its recipe
        recipe = recipes.get(item_idx)
        if recipe is None:
            return False

        # First obtain all ingredients
        for ingr_idx, cnt in recipe.items():
            if ingr_idx == "_at":
                continue
            for _ in range(cnt):
                if not _ensure_item(ingr_idx):
                    return False

        # Then go to the required workshop (if any) and craft
        workshop_kind = recipe.get("_at")
        if workshop_kind is not None:
            ws_target = _nearest_kind(workshop_kind, cur_pos, init_grid)
            if ws_target is None:
                return False
            actions.extend(_bfs_path(cur_pos, ws_target, grid))
            actions.append(USE)               # craft at workshop
            cur_pos[0], cur_pos[1] = ws_target[0], ws_target[1]
        else:
            # No workshop specified – just use (should rarely happen)
            actions.append(USE)
        return True

    # ------------------------------------------------------------------
    # Start planning for the final goal
    # ------------------------------------------------------------------
    _ensure_item(goal_idx)

    # Return the complete action sequence
    return actions


    # ------------------------------------------------------------------
    # Constants and helper utilities
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    _MOVES = [((0, 1), DOWN), ((0, -1), UP), ((-1, 0), LEFT), ((1, 0), RIGHT)]

    def _bfs_path(start, goal, grid):
        """Return a list of actions that moves from ``start`` to ``goal`` using BFS.
        Cells that contain any non‑zero kind are treated as blocked, except the
        goal cell itself (which may be occupied by the target item)."""
        w, h = grid.shape[0], grid.shape[1]          # width (x), height (y)
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in _MOVES:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal cell even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []   # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def _nearest_kind(kind_idx, cur_pos, search_grid):
        """Return the [x, y] coordinate of the nearest cell that contains ``kind_idx``.
        If none exists, return ``None``."""
        ys, xs = np.where(search_grid[:, :, kind_idx] > 0)   # y‑rows, x‑cols
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Initialise planning state
    # ------------------------------------------------------------------
    actions = []

    # Current position (list so it can be mutated in‑place)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Working copy of the grid – we will zero out primitives once taken.
    planning_grid = env.scenario.init_grid.copy()

    goal_idx = env.task.goal
    cookbook = env.world.cookbook
    primitives_set = cookbook.primitives
    recipes = cookbook.recipes
    static_grid = env.scenario.init_grid   # used for locating fixed workshops

    # ------------------------------------------------------------------
    # Recursive planner that ensures one unit of ``item_idx`` ends up in inventory
    # ------------------------------------------------------------------
    def _obtain(item_idx):
        """Plan actions that guarantee one unit of ``item_idx`` in the inventory."""
        # ---- Primitive -------------------------------------------------
        if item_idx in primitives_set:
            target = _nearest_kind(item_idx, cur_pos, planning_grid)
            if target is None:
                return False
            actions.extend(_bfs_path(cur_pos, target, planning_grid))
            actions.append(USE)                     # pick up primitive
            planning_grid[target[1], target[0], item_idx] = 0   # remove it
            cur_pos[0], cur_pos[1] = target[0], target[1]
            return True

        # ---- Crafted item ---------------------------------------------
        recipe = recipes.get(item_idx)
        if recipe is None:
            return False

        # First collect all ingredients (respecting required counts)
        for ingr_idx, cnt in recipe.items():
            if ingr_idx == "_at":
                continue
            for _ in range(cnt):
                if not _obtain(ingr_idx):
                    return False

        # Then go to the required workshop (if any) and craft
        workshop_kind = recipe.get("_at")
        if workshop_kind is not None:
            ws_target = _nearest_kind(workshop_kind, cur_pos, static_grid)
            if ws_target is None:
                return False
            actions.extend(_bfs_path(cur_pos, ws_target, planning_grid))
            actions.append(USE)                     # craft at workshop
            cur_pos[0], cur_pos[1] = ws_target[0], ws_target[1]
        else:
            # No workshop specified – simply use (should rarely happen)
            actions.append(USE)
        return True

    # ------------------------------------------------------------------
    # Start planning for the final goal
    # ------------------------------------------------------------------
    _obtain(goal_idx)

    # Return the full action sequence
    return actions

