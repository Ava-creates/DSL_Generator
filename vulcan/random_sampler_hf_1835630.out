    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )

    goal_idx = env.task.goal
    required = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    state = env._current_state
    pos = tuple(state.pos)               # current (x, y)
    grid = state.grid.copy()              # mutable copy for simulation
    actions = []                           # accumulated actions

    # -----------------------------------------------------------------
    # Helper: BFS pathfinder that avoids non‑grabbable entities.
    # Returns a list of actions moving from start → target.
    # -----------------------------------------------------------------
    def bfs(start, target):
        width, height = grid.shape[:2]

        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Allow stepping onto the target cell even if it is blocked.
        blocked[target[0], target[1]] = False

        q = collections.deque([start])
        parent = {start: None}
        act_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        # Reconstruct action sequence.
        seq = []
        cur = target
        while cur != start:
            seq.append(act_to[cur])
            cur = parent[cur]
        seq.reverse()
        return seq

    # -----------------------------------------------------------------
    # Simple Manhattan fallback (ignores obstacles).
    # -----------------------------------------------------------------
    def manhattan_path(start, target):
        seq = []
        dx = target[0] - start[0]
        dy = target[1] - start[1]
        while dx > 0:
            seq.append(DOWN)
            dx -= 1
        while dx < 0:
            seq.append(UP)
            dx += 1
        while dy > 0:
            seq.append(RIGHT)
            dy -= 1
        while dy < 0:
            seq.append(LEFT)
            dy += 1
        return seq

    # -----------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    # -----------------------------------------------------------------
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # Primitive not present on the map – assume already in inventory.
                continue

            # Choose the nearest instance (Manhattan distance).
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            path = bfs(pos, target)
            if path is None:
                path = manhattan_path(pos, target)

            actions.extend(path)
            actions.append(USE)          # pick up

            # Update simulated state.
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0

    # -----------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the goal.
    # -----------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target_ws = min(
                ws_locs,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = bfs(pos, target_ws)
            if path is None:
                path = manhattan_path(pos, target_ws)
            actions.extend(path)
            actions.append(USE)          # craft at workshop

    return actions


    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"],
