    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:      # arrow not defined in this world
        return []

    # --------------------------------------------------------------
    # Determine which primitive items are required to craft one arrow.
    # If the arrow itself has no recipe, treat it as a primitive that
    # must simply be picked up.
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    actions = []   # final action sequence to return

    # --------------------------------------------------------------
    # Helper: Bread‑first search that returns a list of movement actions
    # (0‑3) which brings the agent to a cell where the *front* cell
    # contains `target_kind`. Returns None if the target cannot be reached.
    # --------------------------------------------------------------
    def _bfs_to_target(st, target_kind):
        grid = st.grid
        W, H = grid.shape[:2]

        # Mapping from action index to (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            # a cell is walkable if it is inside the grid and contains no entities
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        start_x, start_y = st.pos
        start_dir = st.dir
        q.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while q:
            x, y, d, seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return seq

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))
        return None

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # --------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            seq = _bfs_to_target(state, prim_idx)
            if seq is None:
                # Primitive unreachable – abort and return whatever we have so far
                return actions
            actions.extend(seq)
            actions.append(4)   # USE to pick up / interact

            # Keep the simulated state in sync with the actions we just added
            for a in seq + [4]:
                _, state = state.step(a)

    # --------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = _bfs_to_target(state, workshop_idx)
        if seq is None:
            return actions   # workshop unreachable
        actions.extend(seq)
        actions.append(4)   # USE to craft
        for a in seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop – just attempt crafting in place
        actions.append(4)   # USE to craft
        _, state = state.step(4)

    return actions


    # Reset the environment and obtain the initial state / world reference
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Determine the index of the goal item "arrow". If it does not exist,
    # return an empty plan.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # Determine which primitive resources are required to craft one arrow.
    # If the arrow has no recipe it is treated as a primitive that must be
    # simply picked up.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    # ------------------------------------------------------------------
    # Helper: Bread‑first search that returns a list of movement actions
    # (0‑3) which brings the agent to a cell where the *front* cell contains
    # `target_kind`. Returns an empty list if the target is already in front,
    # or None if unreachable.
    # ------------------------------------------------------------------
    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # Mapping from action index to (dx, dy) – matches the direction the
        # agent will be facing after taking that action.
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            # A cell is walkable if it is empty (no entity of any kind).
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        start_x, start_y = cur_state.pos
        start_dir = cur_state.dir

        from collections import deque
        q = deque()
        q.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while q:
            x, y, d, seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return seq

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))
        # Target not reachable
        return None

    plan_actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            move_seq = _bfs_to_target(state, prim_idx)
            if move_seq is None:
                # Primitive unreachable – abort and return what we have so far.
                return plan_actions
            # Append movement then USE (action 4) to pick up.
            plan_actions.extend(move_seq)
            plan_actions.append(4)

            # Keep the simulated state in sync with the actions taken.
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(state, workshop_idx)
        if move_seq is None:
            # Workshop unreachable – return current plan.
            return plan_actions
        plan_actions.extend(move_seq)
        plan_actions.append(4)
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop – simply attempt to craft in place.
        plan_actions.append(4)
        _, state = state.step(4)

    return plan_actions

