    from collections import namedtuple
    import heapq

    Node = namedtuple("Node", ["state", "actions", "cost"])

    def _state_key(st):
        """Hashable representation of a CraftState."""
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    # Heuristic: number of missing primitive items needed for one arrow
    try:
        needed_prims = world.cookbook.primitives_for(target_idx)
    except Exception:
        needed_prims = {}

    def _heuristic(st):
        missing = 0
        inv = st.inventory
        for prim_idx, req_cnt in needed_prims.items():
            have = int(inv[prim_idx]) if prim_idx < len(inv) else 0
            missing += max(0, req_cnt - have)
        return missing

    start_key = _state_key(init_state)
    visited = {start_key}
    frontier = [( _heuristic(init_state), Node(init_state, [], 0) )]

    MAX_PLAN_LEN = 500
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        _, node = heapq.heappop(frontier)
        cur_state, cur_actions = node.state, node.actions

        # Goal test
        if cur_state.satisfies("", target_idx):
            return cur_actions

        # Depth cutoff
        if len(cur_actions) >= MAX_PLAN_LEN:
            continue

        # Expand actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key in visited:
                continue
            visited.add(key)
            new_actions = cur_actions + [a]
            g = len(new_actions)                     # path cost so far
            h = _heuristic(nxt_state)                # estimated remaining work
            heapq.heappush(frontier, (g + h, Node(nxt_state, new_actions, g)))

    # No plan found within limits
    return []

