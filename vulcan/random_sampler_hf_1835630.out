            actions.extend(path)
            # update current position following the path
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # perform the pickup
            actions.append(4)          # USE
            # remove the item from our mutable copy of the grid
            grid[pos[0], pos[1], kind_idx] -= 1

