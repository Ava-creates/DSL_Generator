    # pre‑compute blocked cells (non‑grabbable entities)
    non_grab = list(env.world.non_grabbable_indices)
    if non_grab:
        base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
    else:
        base_blocked = np.zeros(grid.shape[:2], dtype=bool)

    def bfs(start, target, allow_target=False):
        """Return a list of actions from start to target avoiding blocked cells."""
        blocked = base_blocked.copy()
        if allow_target:
            blocked[target[0], target[1]] = False

        q = collections.deque([start])
        came_from = {start: None}
        action_from = {}
        moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (RIGHT, (0, 1)), (LEFT, (0, -1))]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in moves:
                nx, ny = x + dx, y + dy
                if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_from[nxt] = a
                        q.append(nxt)

        if target not in came_from:
            return None

        path = []
        cur = target
        while cur != start:
            path.append(action_from[cur])
            cur = came_from[cur]
        path.reverse()
        return path

    def manhattan_path(start, target):
        """Fallback path ignoring obstacles."""
        moves = []
        x, y = start
        tx, ty = target
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    actions = []

    # ----------------------------------------------------------------------
    # 1) Collect required primitives
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                break
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = bfs(pos, target, allow_target=True)
            if path is None:
                path = manhattan_path(pos, target)
            actions.extend(path)
            actions.append(USE)
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0  # simulate pickup

    # ----------------------------------------------------------------------
    # 2) Goal is a primitive (no recipe) – just pick it up
    # ----------------------------------------------------------------------
