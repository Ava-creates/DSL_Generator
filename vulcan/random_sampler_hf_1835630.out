            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        seq = []
        cur = target
        while cur != start:
            seq.append(act_to[cur])
            cur = parent[cur]
        seq.reverse()
        return seq

    def move_to(target):
        nonlocal pos
        if pos == target:
            return
        path = bfs(pos, target)
        if path is None:
            # Fallback: simple Manhattan moves (ignores obstacles)
            dx = target[0] - pos[0]
            dy = target[1] - pos[1]
            while dx > 0:
                actions.append(DOWN)
                dx -= 1
            while dx < 0:
                actions.append(UP)
                dx += 1
            while dy > 0:
                actions.append(RIGHT)
                dy -= 1
            while dy < 0:
                actions.append(LEFT)
                dy += 1
        else:
            actions.extend(path)
        pos = target

