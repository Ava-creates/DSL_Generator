    import numpy as np
    from collections import deque

    # reset environment and get initial state / world reference
    env.reset()
    cur_state = env._current_state
    world = env.world

    # index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # action → (dx, dy) mapping (DOWN,UP,LEFT,RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def _bfs_to_target(state, target_kind):
        """Return a list of movement actions (0‑3) that ends with the agent
        facing a cell containing `target_kind`.  Return None if unreachable."""
        grid = state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sdir = state.dir
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return None

    actions = []

    # ------------------------------------------------------------------
    # 1) Gather all primitive resources needed for a single arrow.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            path = _bfs_to_target(cur_state, prim_idx)
            # If BFS fails but we are already adjacent, still allow a USE.
            if path is None and not cur_state.next_to(prim_idx):
                return actions
            if path is None:
                path = []  # already next to it
            actions.extend(path)
            actions.append(4)  # USE to pick up
            for a in path + [4]:
                _, cur_state = cur_state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        path = _bfs_to_target(cur_state, workshop_idx)
        if path is None and not cur_state.next_to(workshop_idx):
            # cannot reach workshop – try to craft anyway
            actions.append(4)
            _, cur_state = cur_state.step(4)
            return actions
        if path is None:
            path = []  # already next to it
        actions.extend(path)
        actions.append(4)  # USE to craft
        for a in path + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – craft in place.
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions


