        q.append((start, []))
        visited = {start}
        target_set = set(targets)
        while q:
            (y, x), path = q.popleft()
            if (y, x) in target_set:
                return path + [(y, x)]
            for dy, dx, _ in DIRS:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and (ny, nx) not in visited:
                    # cell must be completely empty to move through
                    if not np.any(grid[ny, nx, :]):
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [(y, x)]))
        return None

    def path_to_actions(path):
        """Convert a list of positions (including start) to action indices."""
        actions = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            dy, dx = y1 - y0, x1 - x0
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)
        return actions

    def nearest_cell_of_kind(kind_idx, from_pos):
        """Return the coordinate of the nearest cell containing kind_idx."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def empty_adjacent_cells(y, x):
        """Return a list of empty neighbour coordinates around (y, x)."""
        cells = []
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if 0 <= ny < H and 0 <= nx < W:
                if not np.any(grid[ny, nx, :]):
                    cells.append((ny, nx))
        return cells

    # ------------------------------------------------------------------
    # Identify the recipe for 'arrow' and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            prim_cell = nearest_cell_of_kind(prim_idx, cur_pos)
            if prim_cell is None:
                # Primitive not present; abort early.
                return actions
            py, px = prim_cell

            # Choose an empty adjacent cell to stand on (prefer the closest)
            adj_cells = empty_adjacent_cells(py, px)
            if not adj_cells:
                # No empty neighbour – cannot collect this primitive.
                return actions

            # Find shortest path to any of the candidate adjacent cells
            path = bfs(cur_pos, adj_cells)
            if path is None:
                # No reachable adjacent cell.
                return actions

            # Convert movement path to actions and update position
            actions += path_to_actions(path)
            cur_pos = path[-1]

            # Face the primitive (by moving direction towards it)
            dy, dx = py - cur_pos[0], px - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop specified in the recipe (if any) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest_cell_of_kind(workshop_idx, cur_pos)
        if ws_cell is not None:
            wy, wx = ws_cell
            adj_cells = empty_adjacent_cells(wy, wx)
            if adj_cells:
                path = bfs(cur_pos, adj_cells)
                if path:
                    actions += path_to_actions(path)
                    cur_pos = path[-1]

    # Final USE to trigger crafting of the arrow
    actions.append(USE)

    return actions

