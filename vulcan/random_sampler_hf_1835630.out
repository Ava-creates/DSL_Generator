    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _action_map():
        """Return mapping from action name to integer."""
        spec = env.action_specs()
        return {
            "DOWN": spec.get("DOWN", 0),
            "UP": spec.get("UP", 1),
            "LEFT": spec.get("LEFT", 2),
            "RIGHT": spec.get("RIGHT", 3),
            "USE": spec.get("USE", 4),
        }

    ACTIONS = _action_map()
    DOWN, UP, LEFT, RIGHT, USE = (
        ACTIONS["DOWN"],
        ACTIONS["UP"],
        ACTIONS["LEFT"],
        ACTIONS["RIGHT"],
        ACTIONS["USE"],
    )

    # ----------------------------------------------------------------------
    # Path‑finding (Manhattan BFS avoiding occupied cells)
    # ----------------------------------------------------------------------
    def _blocked_cells(grid):
        """Boolean 2‑D array: True where any entity occupies the cell."""
        return np.any(grid > 0, axis=2)

    def _in_bounds(pos, shape):
        x, y = pos
        w, h = shape
        return 0 <= x < w and 0 <= y < h

    def _neighbors(pos, shape):
        x, y = pos
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if _in_bounds((nx, ny), shape):
                yield (nx, ny)

    def _bfs(start, goals, blocked):
        """
        Breadth‑first search from ``start`` to any cell in ``goals``.
        ``blocked`` is a 2‑D bool array where True means the cell cannot be entered.
        Returns a list of positions (including start) representing the path,
        or ``None`` if no path exists.
        """
        w, h = blocked.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = dict()

        dq = deque()
        dq.append(start)
        visited[start] = True

        while dq:
            cur = dq.popleft()
            if cur in goals:
                # reconstruct path
                path = [cur]
                while path[-1] != start:
                    path.append(prev[path[-1]])
                path.reverse()
                return path
            for nb in _neighbors(cur, (w, h)):
                if not visited[nb] and not blocked[nb]:
                    visited[nb] = True
                    prev[nb] = cur
                    dq.append(nb)
        return None

    def _pos_to_actions(path, cur_dir):
        """
        Convert a list of positions (including the starting cell) into a list
        of movement actions. ``cur_dir`` is ignored because the environment
        updates direction automatically on movement.
        Returns (actions, final_pos).
        """
        actions = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 > x0:
                actions.append(RIGHT)
            elif x1 < x0:
                actions.append(LEFT)
            elif y1 > y0:
                actions.append(DOWN)
            elif y1 < y0:
                actions.append(UP)
        return actions

    # ----------------------------------------------------------------------
    # Main logic
    # ----------------------------------------------------------------------
    world = env.world
    state = env._current_state
    grid = state.grid
    shape = grid.shape[:2]  # (WIDTH, HEIGHT)

    # --------------------------------------------------------------
    # Determine the goal index for the item “arrow”.
    # --------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        try:
            goal_idx = world.cookbook.index["arrow"]
        except Exception as e:
            raise RuntimeError("Could not find goal index for 'arrow'") from e

    # --------------------------------------------------------------
    # Primitive requirements (expanded to raw resources)
    # --------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    actions = []
    cur_pos = tuple(state.pos)

    blocked = _blocked_cells(grid)

    # --------------------------------------------------------------
    # Helper: move to a target cell (or adjacent free cell) and
    # optionally turn towards a neighbour before using.
    # --------------------------------------------------------------
    def _move_to_adjacent(target):
        """
        Move the agent to a free cell that is orthogonally adjacent to ``target``.
        Returns the position the agent ends up in (the adjacent cell).
        """
        nonlocal cur_pos, actions, blocked

        # First try the target itself if it is free (some primitives may be on
        # the floor and not block movement). Otherwise search neighbours.
        candidates = []
        if not blocked[target]:
            candidates.append(target)
        for nb in _neighbors(target, shape):
            if not blocked[nb]:
                candidates.append(nb)

        if not candidates:
            # No reachable adjacent cell – give up.
            return cur_pos

        # Choose the candidate with the shortest Manhattan distance.
        candidates.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
        dest = candidates[0]

        # Find path.
        path = _bfs(cur_pos, {dest}, blocked)
        if path is None:
            # No path – give up.
            return cur_pos

        # Convert to actions.
        actions.extend(_pos_to_actions(path, None))
        cur_pos = dest
        return cur_pos

    def _face_towards(src, tgt):
        """
        Append a single movement action that points the agent from ``src`` to
        ``tgt`` (the agent does not move if the cell is blocked, but the
        direction changes). Returns nothing.
        """
        sx, sy = src
        tx, ty = tgt
        if tx > sx:
            actions.append(RIGHT)
        elif tx < sx:
            actions.append(LEFT)
        elif ty > sy:
            actions.append(DOWN)
        elif ty < sy:
            actions.append(UP)

    # --------------------------------------------------------------
    # Collect each required primitive.
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        # Locations where the primitive currently exists.
        locs = np.argwhere(grid[:, :, prim_idx] > 0)
        if locs.size == 0:
            # Primitive not present – skip (cannot collect).
            continue

        # Use the first location found.
        prim_pos = tuple(locs[0])

        # Move to a free adjacent cell.
        cur_pos = _move_to_adjacent(prim_pos)

        # Face the primitive.
        _face_towards(cur_pos, prim_pos)

        # Pick up the required amount.
        actions.extend([USE] * needed)

        # Update blocked map – after picking up the primitive the cell becomes empty.
        blocked[prim_pos] = False

    # --------------------------------------------------------------
    # Move to the workshop and craft the final item.
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_key") or recipe.get("_at")
    if workshop_name is not None:
        # Resolve workshop index (could be already an int).
        if isinstance(workshop_name, int):
            workshop_idx = workshop_name
        else:
            workshop_idx = world.cookbook.index.get(workshop_name)

        if workshop_idx is not None:
            ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
            if ws_locs.size > 0:
                ws_pos = tuple(ws_locs[0])
                cur_pos = _move_to_adjacent(ws_pos)
                _face_towards(cur_pos, ws_pos)

    # Finally use the workshop (or current cell) to craft the arrow.
    actions.append(USE)

    return actions


    # Retrieve action indices from the environment
    action_map = env.action_specs()
    DOWN = action_map.get("DOWN", 0)
    UP = action_map.get("UP", 1)
    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    world = env.world
    state = env._current_state

    # ------------------------------------------------------------------
    # Determine the goal index (the item we need to make)
    # ------------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        # fall back to looking up by name
        try:
            goal_idx = world.cookbook.index["arrow"]
        except Exception as e:
            raise RuntimeError("Unable to locate goal index for 'arrow'") from e

    # ------------------------------------------------------------------
    # Get the primitive requirements for the goal (expanded to raw items)
    # ------------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Helper to move from the current position to a target cell using
    # Manhattan moves (no path‑finding – assumes open space).
    # ------------------------------------------------------------------
    def _move_to(target, cur_pos, action_list):
        """Append actions that move from cur_pos to target, return new pos."""
        x, y = cur_pos
        tx, ty = target
        # Move in x direction
        while x < tx:
            action_list.append(RIGHT)
            x += 1
        while x > tx:
            action_list.append(LEFT)
            x -= 1
        # Move in y direction
        while y < ty:
            action_list.append(DOWN)
            y += 1
        while y > ty:
            action_list.append(UP)
            y -= 1
        return (x, y)

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        # Find any cell that currently contains this primitive
        locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
        if locations.size == 0:
            # Primitive not present on the map – cannot collect; skip
            continue
        # Choose the first occurrence as the target
        target = tuple(locations[0])
        cur_pos = _move_to(target, cur_pos, actions)
        # Pick up the required amount (one USE per unit)
        for _ in range(needed):
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    # Recipe may store workshop name under "_key" or "_at"
    workshop_name = recipe.get("_key") or recipe.get("_at")
    workshop_idx = None
    if workshop_name is not None:
        # workshop_name may already be an index or a string name
        if isinstance(workshop_name, int):
            workshop_idx = workshop_name
        else:
            workshop_idx = world.cookbook.index.get(workshop_name)

    if workshop_idx is not None:
        ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if ws_locs.size > 0:
            ws_pos = tuple(ws_locs[0])
            cur_pos = _move_to(ws_pos, cur_pos, actions)

    # Use the workshop (or current cell) to perform the crafting
    actions.append(USE)

    return actions

