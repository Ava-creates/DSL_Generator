    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item index for "arrow"
    target_idx = cookbook.index["arrow"]

    # local mutable copies of grid, position, inventory
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions: list[int] = []

    from collections import deque

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (DOWN,UP,LEFT,RIGHT)
    # from start to any cell in *goals*.  Cells occupied by any entity are
    # treated as blocked unless the cell itself is a goal.
    def bfs(start: tuple[int, int], goals: set[tuple[int, int]]) -> list[int] | None:
        q = deque([(start, [])])
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # allow stepping onto a goal even if occupied
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    # ------------------------------------------------------------------
    # Update simulated position according to a list of movement actions.
    def apply_path(path: list[int]) -> None:
        nonlocal pos
        for a in path:
            if a == 0:      # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1:    # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2:    # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3:    # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ------------------------------------------------------------------
    # Primitive collection routine.
    def collect_primitive(kind_idx: int, needed: int) -> None:
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate all cells that still contain this primitive
            cells = [(x, y) for x in range(width) for y in range(height)
                     if grid[x, y, kind_idx] > 0]
            if not cells:
                raise RuntimeError(f"Primitive {kind_idx} not found on map")
            # pick the first reachable primitive (could be optimized)
            chosen_path = None
            chosen_cell = None
            for cell in cells:
                p = bfs(pos, {cell})
                if p is not None:
                    chosen_path, chosen_cell = p, cell
                    break
            if chosen_path is None:
                raise RuntimeError("No reachable primitive found")
            actions.extend(chosen_path)
            apply_path(chosen_path)
            # USE to pick up
            actions.append(4)
            grid[chosen_cell[0], chosen_cell[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    # ------------------------------------------------------------------
    # Recursive crafting helper ensuring *item_idx* is present in at least *cnt* units.
    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx: int, cnt: int) -> None:
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < cnt:
            if item_idx in primitives_set:
                # Primitive: just collect the missing amount
                collect_primitive(item_idx, cnt - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            # Satisfy all ingredient requirements first
            for ing_idx, need in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < need:
                    ensure_item(ing_idx, need)

            # Move to required workshop if the recipe specifies one
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if not ws_cells:
                    raise RuntimeError(f"Workshop {workshop} not found on map")
                path = bfs(pos, {ws_cells[0]})
                if path is None:
                    raise RuntimeError("Cannot reach required workshop")
                actions.extend(path)
                apply_path(path)

            # Perform the craft action
            actions.append(4)  # USE
            for ing_idx, need in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= need
            inventory[item_idx] += 1

    # ------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions


    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # index of the goal item (arrow)
    target_idx = cookbook.index["arrow"]

    # mutable copies of the world state for planning
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions: list[int] = []

    from collections import deque

    def bfs(start: tuple[int, int],
            goals: set[tuple[int, int]]) -> list[int] | None:
        """Shortest path (as list of action ids) from start to any goal cell."""
        q = deque([(start, [])])
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # can step onto a goal even if occupied
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path: list[int]) -> None:
        """Update simulated position after following a list of actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ------------------------------------------------------------------
    # Primitive collection
    def collect_primitive(kind_idx: int, needed: int) -> None:
        """Collect `needed` units of a primitive from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate cells still containing the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, kind_idx] > 0]
            if not locations:
                raise RuntimeError(f"Primitive {kind_idx} missing from map")
            # pick first reachable location (any will do for correctness)
            chosen_path = None
            chosen_loc = None
            for loc in locations:
                p = bfs(pos, {loc})
                if p is not None:
                    chosen_path, chosen_loc = p, loc
                    break
            if chosen_path is None:
                raise RuntimeError("No reachable primitive found")
            actions.extend(chosen_path)
            move_along(chosen_path)
            actions.append(4)                     # USE to pick up
            grid[chosen_loc[0], chosen_loc[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    # ------------------------------------------------------------------
    # Recursive crafting helper
    recipes = cookbook.recipes
    primitives = cookbook.primitives

    def ensure_item(item_idx: int, amount: int) -> None:
        """Guarantee that `inventory[item_idx] >= amount` by collecting/crafting."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives:
                # primitive: just collect the missing amount
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # obtain recipe (may be empty)
            recipe = recipes.get(item_idx, {})
            # first satisfy all ingredient requirements
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to required workshop, if any
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if not ws_cells:
                    raise RuntimeError(f"Workshop {workshop} not present on the map")
                p = bfs(pos, {ws_cells[0]})
                if p is None:
                    raise RuntimeError("Cannot reach required workshop")
                actions.extend(p)
                move_along(p)

            # perform the craft action
            actions.append(4)  # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions

