    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        # Use position, direction, inventory, and grid bytes as a hashable representation
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 400                     # Upper bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # Usually 5 (4 moves + USE)

    # Primitive requirements for the target (may be used for future heuristics)
    try:
        prim_req = world.cookbook.primitives_for(target_idx)
        needed_prim = set(prim_req.keys())
    except Exception:
        needed_prim = set()

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand neighbours by trying every possible action
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            key = _state_key(next_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(next_state, node.actions + [a]))

    # No plan found within the search budget
    return []


    # Resolve the scenario and world objects
    scenario = getattr(env, "scenario", None) or env
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # Find the index for the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Obtain the initial state from which to plan
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """
        Create a hashable representation of a state.
        Includes position, direction, inventory contents and the grid layout.
        """
        # inventory is a 1‑D numpy array; convert to tuple of ints for hashing
        inv_key = tuple(st.inventory.tolist())
        # grid is a 3‑D array; use its raw bytes as part of the key
        grid_key = st.grid.tobytes()
        return (st.pos, st.dir, inv_key, grid_key)

    # BFS initialisation
    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_PLAN_LENGTH = 500                     # safety cap on plan length
    n_actions = getattr(world, "n_actions", 5)   # usually 5 (4 moves + USE)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: we have at least one arrow in the inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_PLAN_LENGTH:
            continue

        # Expand all possible primitive actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            key = _state_key(next_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(next_state, node.actions + [a]))

    # If we exhaust the search without finding a solution, return empty plan
    return []

