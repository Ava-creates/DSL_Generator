    # Get scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # Primitive requirements for one arrow (may be empty if arrow is primitive)
    primitive_req = world.cookbook.primitives_for(target_idx)  # dict {prim_idx: count}

    import collections, heapq

    Node = collections.namedtuple("Node", ["state", "actions", "cost"])

    def _state_hash(st):
        """Hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    def _missing_primitive_count(st):
        """Number of required primitive items that are still missing."""
        inv = st.inventory
        missing = 0
        for p_idx, needed in primitive_req.items():
            have = int(inv[p_idx])
            if have < needed:
                missing += needed - have
        return missing

    # A* search
    start_h = _missing_primitive_count(init_state)
    frontier = [(start_h, 0, Node(init_state, [], 0))]  # (f, g, node)
    visited = {_state_hash(init_state): 0}

    MAX_PLAN_LEN = 2000
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        f, g, node = heapq.heappop(frontier)
        state = node.state

        # Goal test: have at least one arrow in inventory
        if state.satisfies("", target_idx):
            return node.actions

        if g >= MAX_PLAN_LEN:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = state.step(a)
            h = _state_hash(nxt_state)
            new_g = g + 1
            # If we have already reached this state with an equal or shorter path, skip
            if visited.get(h, 1_000_000) <= new_g:
                continue
            visited[h] = new_g
            heur = _missing_primitive_count(nxt_state)
            heapq.heappush(frontier, (new_g + heur, new_g, Node(nxt_state, node.actions + [a], new_g)))

    # No plan found within the search budget
    return []


    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
