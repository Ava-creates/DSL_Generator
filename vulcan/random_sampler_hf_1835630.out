    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = free_adjacent(ws_cell, forbidden=harvested)
            if ws_adj is None:
                ws_adj = cur_pos
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop before using
            fa = face_action(cur_pos, ws_cell)
            if fa is not None:
                actions.append(fa)

    # Final USE to trigger crafting (or to craft directly if no workshop)
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Action indices (as defined by CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid.copy()

    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def occupied(y, x):
        return grid[y, x].any()

    def bfs_path(start, goal):
        """Return a list of movement actions from start to goal avoiding occupied cells."""
        if start == goal:
            return []
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if occupied(ny, nx):
                    continue
                new_path = path + [act]
                if (ny, nx) == goal:
                    return new_path
                visited.add((ny, nx))
                q.append(((ny, nx), new_path))
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing the given kind index."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[dists.argmin()]
        return tuple(nearest)

    def free_adjacent(cell, avoid=set()):
        """Return a free neighbour of `cell` not in `avoid`."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not occupied(ny, nx):
                return (ny, nx)
        return None

    # Identify the arrow goal and its recipe
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos
    harvested = set()

    # --------------------------------------------------------------
    # Collect all required primitives
    # --------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                return actions

            adj = free_adjacent(target, avoid=harvested)
            if adj is None:
                return actions

            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Use the primitive (direction after the last move points toward it)
            actions.append(USE)

            # Update internal grid copy and record the harvest
            grid[target[0], target[1], prim_idx] = 0
            harvested.add(target)

    # --------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = free_adjacent(ws_cell, avoid=harvested)
            if ws_adj is not None:
                actions += bfs_path(cur_pos, ws_adj)
                cur_pos = ws_adj

    # Final USE to trigger crafting
    actions.append(USE)
    return actions

