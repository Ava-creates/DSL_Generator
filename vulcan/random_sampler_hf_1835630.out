    # ----------------------------------------------------------------------
    # make_arrow_vn: generic BFS planner to obtain at least one "arrow"
    # ----------------------------------------------------------------------
    # Retrieve scenario and world objects (they may be wrapped in the env)
    scenario = getattr(env, "scenario", None) or env
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Hashable representation of a CraftState."""
        # Position, direction, inventory tuple, and immutable grid snapshot
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    # BFS frontier
    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    # Safety limits
    MAX_STEPS = 500                     # max plan length explored
    n_actions = getattr(world, "n_actions", 5)   # typically 5 (4 moves + USE)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have an arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune excessively long action sequences
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand each possible action
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            key = _state_hash(next_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(next_state, node.actions + [a]))

    # If we exit the loop no plan was found within limits
    return []

