    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    # ------------------------------------------------------------------
    # Obtain current state and world objects
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    world = getattr(env, "world", None) or getattr(state, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance.")

    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in cookbook.")
    goal_idx = cookbook.index[goal_name]

    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Work on a mutable copy of the grid so we can mark collected items
    grid = state.grid.copy()
    pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions that moves the agent from
    # `start` to any empty cell adjacent to any of `targets`.
    # ------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)

        # Build the set of goal cells (empty neighbours of any target)
        goal_cells = set()
        for tx, ty in targets:
            for dx, dy, _ in DIRS:
                nx, ny = tx + dx, ty + dy
                if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:
                    goal_cells.add((nx, ny))

        if not goal_cells:
            return []  # no reachable adjacent cell

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            if (x, y) in goal_cells:
                return path
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # unreachable

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        collected = 0
        while collected < needed:
            # Locate remaining instances of this primitive
            locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locs:
                # No more instances; break to avoid infinite loop
                break
            # Choose the nearest one (Manhattan distance)
            locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locs[0]

            # Move adjacent to the primitive
            path = _bfs_to_adjacent(pos, [target])
            actions.extend(path)

            # Update position according to the path taken
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Use to pick up the primitive
            actions.append(USE)

            # Mark the primitive as collected in our copy of the grid
            grid[target[0], target[1], prim_idx] = 0
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key

        # Find workshop locations
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = ws_locs[0]

            # Move adjacent to the workshop
            path = _bfs_to_adjacent(pos, [ws_target])
            actions.extend(path)

            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Use to craft the arrow
            actions.append(USE)
        else:
            # No workshop cell found; just issue a USE (will fail gracefully)
            actions.append(USE)
    else:
        # No specific workshop required; issue USE at current location
        actions.append(USE)

    return actions


    # ------------------------------------------------------------
    # Setup: obtain current state, world, cookbook and goal information
    # ------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    world = getattr(env, "world", None) or getattr(state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # Goal is to craft an arrow
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive items required to craft one arrow (flattened)
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Working copies of grid and agent position
    grid = state.grid.copy()
    pos = tuple(state.pos)          # (x, y)

    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    # ------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions taking the
    # agent from `start` to a cell that is either the target itself
    # or adjacent (Manhattan distance 1) to the target.
    # ------------------------------------------------------------
    def _bfs_path(start, target):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # any entity blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        tx, ty = target

        while q:
            x, y, path = q.popleft()
            # Stop if we are on the target or next to it
            if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                return path
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []          # no path found (should not happen in well‑formed maps)

    actions = []

    # ------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            # Locate remaining instances of the primitive on the map
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                # No more of this primitive left on the map – abort early
                break
            # Choose the nearest location (Manhattan distance)
            locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            target_loc = locations[0]

            # Move adjacent to the primitive
            path = _bfs_path(pos, target_loc)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick up the primitive
            actions.append(USE)
            # Remove it from the grid so we don't target it again
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            collected += 1

    # ------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be string name or integer)
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop
            workshop_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            ws_target = workshop_cells[0]
            path = _bfs_path(pos, ws_target)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Perform crafting action
            actions.append(USE)
        else:
            # No workshop found – still attempt a USE (will have no effect)
            actions.append(USE)
    else:
        # No specific workshop required; a final USE attempts crafting in place
        actions.append(USE)

    return actions

