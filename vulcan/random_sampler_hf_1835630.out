    # Mapping from action index to movement delta
    deltas = {0: (0, 1),   # DOWN
              1: (0, -1),  # UP
              2: (-1, 0),  # LEFT
              3: (1, 0)}   # RIGHT

    def walkable(grid, x, y):
        """True if (x, y) is inside the grid and contains no entities."""
        W, H = grid.shape[:2]
        if not (0 <= x < W and 0 <= y < H):
            return False
        return not np.any(grid[x, y, :])

    def bfs_to_target(state, target_kind):
        """
        Bread‑first search for a sequence of movement actions (0‑3) that ends
        with the agent facing a cell containing `target_kind`. Returns the
        action list, or an empty list if already facing the target or unreachable.
        """
        grid = state.grid
        W, H = grid.shape[:2]
        sx, sy = state.pos
        sdir = state.dir

        # Already facing the target?
        dx, dy = deltas[sdir]
        fx, fy = sx + dx, sy + dy
        if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
            return []

        queue = deque()
        queue.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while queue:
            x, y, d, acts = queue.popleft()
            # Look ahead from current orientation
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
                return acts
            # Expand to four possible movement actions
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))
        # Unreachable
        return []

    def target_ahead(state, kind):
        """True if the cell directly in front of the agent contains `kind`."""
        x, y = state.pos
        d = state.dir
        dx, dy = deltas[d]
        fx, fy = x + dx, y + dy
        W, H = state.grid.shape[:2]
        return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)

