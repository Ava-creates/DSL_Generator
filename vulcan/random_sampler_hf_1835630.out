    # Reset the environment to start a fresh episode.
    env.reset()
    actions = []

    # Mapping from action names to integer indices.
    action_map = env.action_specs()
    move_names = ["DOWN", "UP", "LEFT", "RIGHT"]
    move_inds = [action_map[name] for name in move_names if name in action_map]
    use_ind = action_map.get("USE")

    # Upper bound on the number of steps we will try.
    max_steps = getattr(env, "max_steps", 1000)

    for _ in range(max_steps):
        # Goal reached?  The CraftState `satisfies` method ignores the name argument.
        if env._current_state.satisfies("", env.task.goal):
            break

        # Try to use (collect/craft) in the current facing direction.
        if use_ind is not None:
            actions.append(use_ind)
            reward, done, obs = env.step(use_ind)
            if done:
                break

        # If not done, move randomly to explore the world.
        if move_inds:
            act = int(np.random.choice(move_inds))
            actions.append(act)
            reward, done, obs = env.step(act)
            if done:
                break

    return actions


    import numpy as np

    # Reset the environment to start a new episode and obtain the initial observation.
    # The reset may return a dictionary; we ignore its contents here.
    try:
        env.reset()
    except Exception:
        # If reset requires a seed argument, provide a default one.
        env.reset(seed=0)

    # Determine the maximum number of steps allowed in the episode.
    # CraftLab stores this as `task.steps`; fall back to a reasonable default.
    max_steps = getattr(getattr(env, "task", None), "steps", 1000)

    # Retrieve the list of possible action integers from the environment.
    # `action_specs()` returns a dict mapping action names to integer codes.
    try:
        action_values = list(env.action_specs().values())
    except Exception:
        # If the method is unavailable, assume 5 standard actions (0‑4).
        action_values = list(range(5))

    actions = []
    done = False
    step_count = 0

    # Simple random policy: keep taking random actions until the episode ends
    # or we exceed the step limit. This generic approach works for any goal,
    # including “make[arrow]”.
    while not done and step_count < max_steps:
        action = int(np.random.choice(action_values))
        actions.append(action)

        # Perform the action; the step method returns (reward, done, obs).
        try:
            _, done, _ = env.step(action)
        except Exception:
            # If the environment uses a different signature, ignore the return values.
            env.step(action)
            done = False

        step_count += 1

    return actions

