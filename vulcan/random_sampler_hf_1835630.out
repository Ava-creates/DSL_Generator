    def cell_blocked(y, x):
        """A cell is blocked if any non‑grabbable entity occupies it."""
        # world.non_grabbable_indices is a set of kind indices
        if not world.non_grabbable_indices:
            return False
        return grid[y, x, list(world.non_grabbable_indices)].any()

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal
        avoiding blocked cells. Uses BFS for shortest Manhattan path."""
        if start == goal:
            return []
        from collections import deque
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        while q:
            y, x, path = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_blocked(ny, nx):
                    continue
                npath = path + [act]
                if (ny, nx) == goal:
                    return npath
                visited.add((ny, nx))
                q.append((ny, nx, npath))
        # No path found – return empty list (caller may handle)
        return []

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing `kind_idx` using Manhattan distance."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Return a free orthogonal neighbour of `cell` not in `avoid`."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if cell_blocked(ny, nx):
                continue
            return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)      # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos                                    # (y, x)
    taken = set()                                          # locations of already collected primitives

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early
                return actions
            # Choose a free adjacent cell to stand on
            adj = adjacent_free(target, avoid=taken)
            if adj is None:
                # No free neighbour; fallback to staying on current cell (unlikely)
                adj = cur_pos
            # Move to the adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (add a movement action toward it; the move will be blocked but direction changes)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
