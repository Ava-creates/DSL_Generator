    # ------------------------------------------------------------------
    # Setup and helpers
    # ------------------------------------------------------------------
    world = env.world
    state = env._current_state
    grid = state.grid
    pos = tuple(state.pos)          # current (x, y) position
    w, h, _ = grid.shape

    # Directions: 0=RIGHT,1=LEFT,2=UP,3=DOWN (matching env action ordering)
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    # Cells that cannot be traversed (non‑grabbable entities)
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # Bread‑first search returning a list of movement actions from start to any target cell
    def bfs(start, targets, blocked_mask):
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked_mask[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []   # should not happen in a solvable scenario

    # Move to a cell containing `kind_idx` and execute USE action `count` times
    def acquire(kind_idx, count):
        nonlocal pos, actions, grid, blocked
        for _ in range(count):
            # locate any cell that currently holds the required kind
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            if not cells:
                # no more of this primitive on the map – abort early
                return
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            # update position according to the path taken
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # pick up the item
            actions.append(4)   # USE
            # after pickup the cell becomes empty; update grid and blocked mask
            x, y = pos
            grid[x, y, kind_idx] = max(0, grid[x, y, kind_idx] - 1)
            # picking up a primitive never creates a new obstacle,
            # but if the cell previously held a non‑grabbable entity we keep it blocked

    # ------------------------------------------------------------------
    # Resolve recipe for "arrow": primitives needed and ordered craft steps
    # ------------------------------------------------------------------
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]
    needed_prims = {}          # primitive idx -> total count required
    craft_steps = []           # (item_idx, count) in dependency order (post‑order)

    def resolve(item_idx, multiplier):
        rec = cookbook.recipes.get(item_idx)
        if rec is None:
            # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier
            return
        # first resolve all ingredient items (skip special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * multiplier)
        # then schedule this item to be crafted
        craft_steps.append((item_idx, multiplier))

    resolve(arrow_idx, 1)

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []

    # 1) Collect all required primitives
    for kind_idx, cnt in needed_prims.items():
        acquire(kind_idx, cnt)

    # 2) Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        # locate any workshop cell of the required type
        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        if not wk_cells:
            continue  # safety fallback; in a valid scenario this should not happen
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        # use the workshop the required number of times
        actions.extend([4] * cnt)

    return actions

