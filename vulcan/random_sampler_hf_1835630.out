    import numpy as np

    # Action indices as defined in CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment to get a fresh state
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = np.copy(state.grid)           # mutable copy of the initial grid

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks
        from ``start`` to ``goal`` using a simple Manhattan walk."""
        y, x = start
        gy, gx = goal
        actions = []
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos, cur_grid):
        """Linear scan for the nearest cell containing ``kind_idx``.
        Returns (y, x) or None if not found."""
        locations = np.argwhere(cur_grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def is_cell_free(pos, cur_grid):
        """A cell is free if no non‑grabbable entity occupies it."""
        y, x = pos
        # Check any entity present (including primitives). If all zeros, it's free.
        return not np.any(cur_grid[y, x, :] > 0)

    # ------------------------------------------------------------------
    # Identify arrow recipe and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos, grid)
            if target is None:
                # Primitive not present – abort planning.
                return actions

            ty, tx = target

            # Choose an adjacent free cell to stand on (prefer one that keeps us
            # facing the primitive after moving).
            adj_candidates = [
                (ty - 1, tx),  # above (face DOWN)
                (ty + 1, tx),  # below (face UP)
                (ty, tx - 1),  # left  (face RIGHT)
                (ty, tx + 1),  # right (face LEFT)
            ]
            adj = None
            for cand in adj_candidates:
                cy, cx = cand
                if 0 <= cy < grid.shape[0] and 0 <= cx < grid.shape[1] and is_cell_free((cy, cx), grid):
                    adj = (cy, cx)
                    break
            if adj is None:
                # Fallback: stand on the primitive cell itself if no free neighbour.
                adj = target

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (best‑effort) by issuing a movement in that direction.
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
                cur_pos = (cur_pos[0] + 1, cur_pos[1])
            elif dy == -1:
                actions.append(UP)
                cur_pos = (cur_pos[0] - 1, cur_pos[1])
            elif dx == 1:
                actions.append(RIGHT)
                cur_pos = (cur_pos[0], cur_pos[1] + 1)
            elif dx == -1:
                actions.append(LEFT)
                cur_pos = (cur_pos[0], cur_pos[1] - 1)
            # If already on the same cell, direction does not matter.

            # Pick up the primitive.
            actions.append(USE)

            # Update our local grid copy: remove the primitive we just collected.
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos, grid)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions


    # Reset the environment and obtain the current state and world objects
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) to walk
        from ``start`` to ``goal`` using a simple Manhattan route."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing ``kind_idx`` (primitive or workshop).
        Returns the cell coordinates (y, x) or ``None`` if not found."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine which primitives are needed for the 'arrow' item
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # current agent position (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            ty, tx = target

            # Choose a free adjacent cell to stand on (prefer empty).
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; stand on the primitive cell itself.
                adj = target

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (best‑effort direction).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop specified in the recipe (if any) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions

