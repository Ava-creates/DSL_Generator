    import numpy as np
    from collections import deque

    # Action indices (match CraftWorld default ordering)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell adjacent (Manhattan distance = 1) to any of the
    # `targets`.  Cells occupied by any entity are treated as blocked.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        w, h = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                new_path = path + [act]
                # Check adjacency after this move
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                visited.add((nx, ny))
                q.append((nx, ny, new_path))
        # No reachable adjacent cell
        return []

    # ------------------------------------------------------------------
    # Retrieve world and current state from the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # May be wrapped; ensure a reset so a state exists
        if not hasattr(env, "_current_state") or env._current_state is None:
            env.reset()
        state = env._current_state
        world = state.world
    else:
        # Ensure we have a state object for position / grid information
        if not hasattr(env, "_current_state") or env._current_state is None:
            env.reset()
        state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ------------------------------------------------------------------
    # Determine which primitive resources are needed for one arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    if not primitives_needed:
        # Arrow is already a primitive – nothing to do
        return []

    # ------------------------------------------------------------------
    # Current grid, position and occupancy mask.
    # ------------------------------------------------------------------
    grid = state.grid                         # (W, H, n_kinds)
    pos = tuple(state.pos)                    # (x, y)
    occupied = np.any(grid > 0, axis=2)       # True where any entity exists

    actions = []
    harvested = set()                         # locations already collected

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # Locate all cells that currently contain this primitive
            prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            # Remove cells we have already harvested
            prim_cells = [c for c in prim_cells if c not in harvested]
            if not prim_cells:
                # No more of this primitive left on the map – give up
                break

            # Choose the nearest primitive (Manhattan distance)
            prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = prim_cells[0]

            # Plan a path to a cell adjacent to the primitive
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate the movement to update `pos`
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # Update occupancy (the cell becomes empty after pickup)
            occupied[target] = False
            # Also clear the primitive from the grid representation
            grid[:, :, prim_idx][target] = 0

    # ------------------------------------------------------------------
    # Craft the arrow at the required workshop (if the recipe specifies one).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key

        # Locate workshop cells
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_cells:
            # Choose the nearest workshop
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = ws_cells[0]

            # Move adjacent to the workshop
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use to craft the arrow
            actions.append(USE)
        else:
            # No workshop found – fall back to using current position
            actions.append(USE)
    else:
        # No specific workshop required; just use at current location
        actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Action constants (match CraftWorld ordering)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP:   (0, -1),
        LEFT: (-1, 0),
        RIGHT:(1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions that moves the agent from
    # `start` to a cell adjacent (Manhattan distance = 1) to any position
    # in `targets`.  Cells where `occupied` is True are treated as blocked.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        w, h = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                new_path = path + [act]
                # Check adjacency after this move
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                visited.add((nx, ny))
                q.append((nx, ny, new_path))
        # Unreachable
        return []

