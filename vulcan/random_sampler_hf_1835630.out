    # movement deltas for cardinal actions
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  ( 1, 0),
        "LEFT":  ( 0,-1),
        "RIGHT": ( 0, 1),
    }

    from collections import deque

    # BFS returning a list of action names that moves the agent from `start`
    # to a cell adjacent (Chebyshev distance ≤ 1) to any cell in `targets`.
    # Only completely empty cells may be traversed.
    def bfs_to_adjacent(start, targets, grid):
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # check adjacency to any target cell
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if grid[nx, ny].sum() == 0:   # cell is empty
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None  # no reachable adjacent cell

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # locate all cells currently holding the needed primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                break   # primitive not present any more

            # plan a path to the nearest primitive (adjacent cell)
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                break   # unreachable primitive

            # execute movement actions
            for act_name in path:
                aid = act_map[act_name]
                actions.append(aid)
                env.step(aid)

            # pick up the primitive with the USE action
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        # locate all workshop cells of the required kind
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    aid = act_map[act_name]
                    actions.append(aid)
                    env.step(aid)

            # craft the item with the USE action
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    return actions


    # Reset environment and initialise containers
    env.reset()
    actions = []
    act_map = env.action_specs()                     # e.g. {'DOWN':0, 'UP':1, ...}
    goal_idx = env.task.goal                         # integer index of the target item
    needed = env.world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at', None)

    # Cardinal movement deltas (matching the action names in act_map)
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving the agent from
    # `start` to a cell that is *adjacent* (Chebyshev distance ≤ 1) to any
    # cell in `targets`. Only completely empty cells may be traversed.
    # ----------------------------------------------------------------------
    def bfs_to_adjacent(start, targets, grid):
        from collections import deque
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # If we are adjacent (including diagonal) to any target cell, stop.
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # Traversable only if the cell contains no entities
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None   # No reachable adjacent cell

    # ----------------------------------------------------------------------
    # 1) Collect each required primitive the needed number of times
    # ----------------------------------------------------------------------
    for prim_idx, required_cnt in needed.items():
        for _ in range(required_cnt):
            # Refresh current state information
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Find all cells that currently hold the primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Primitive not present any more – abort further collection
                break

            # Plan a path to the nearest primitive (adjacent cell)
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # Unreachable primitive – abort further collection
                break

            # Execute the movement actions
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # Pick up the primitive using the USE action
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ----------------------------------------------------------------------
    # 2) If the recipe specifies a workshop, move there and craft the goal
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        # Refresh state after primitive collection
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # Use the workshop to craft the item
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # Return the compiled sequence of action IDs
    return actions

