    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `start`
    # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in
    # `targets`.  Cells where any kind is present are treated as obstacles.
    # ----------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are adjacent to a target, stop.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell.
        return []

