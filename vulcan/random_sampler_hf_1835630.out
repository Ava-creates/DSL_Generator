    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions taking the agent
    # from `start` to a cell adjacent to any of `targets`. The agent may
    # only step on empty cells (no entity present in any kind channel).
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where something exists
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency (including standing on a target)
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:          # can only walk on empty cells
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable target – return empty list (will cause failure later)
        return []

    # ------------------------------------------------------------------
    # Locate the CraftWorld instance and the recipe index for "arrow"
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers keep the world inside the current state object
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("Unable to find CraftWorld instance in the environment.")

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow (primitive index -> count)
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if the environment hasn't started)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y) coordinates
    grid = state.grid                # (W, H, n_kinds)

    actions = []
    harvested = set()                # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # Current locations of this primitive on the grid
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Order by Manhattan distance from current position
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed_cnt:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive
            path = _bfs_path(pos, [loc])
            actions.extend(path)
            # Simulate moving the agent
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick it up
            actions.append(USE)
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or already an int)
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        # Locate workshop cells
        workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_locs:
            # Choose nearest workshop
            workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_locs[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft using USE
            actions.append(USE)

    # If there is no explicit workshop, simply try to craft at the current location
    elif not actions or actions[-1] != USE:
        actions.append(USE)

    return actions


    # ------------------------------------------------------------------
    # Locate world and recipe for "arrow"
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # fallback for wrappers that store the world inside the current state
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ------------------------------------------------------------------
    # Primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Ensure we have a state object (reset if needed)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Current position and grid (will be mutated locally to reflect pickups)
    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()              # (W, H, n_kinds)

    # Action constants (match CraftLab's action specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions that brings the
    # agent from `start` to a cell adjacent to any of `targets`.
    # The agent may walk only on empty cells (no entity present in any channel).
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where something exists
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency (including standing on a target)
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny] or (nx, ny) in target_set:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable target
        return []

    # ------------------------------------------------------------------
    # Collect required primitives (greedy nearest‑first)
    # ------------------------------------------------------------------
    harvested = set()  # keep track of cells already used
    for prim_idx, need_cnt in primitives_needed.items():
        collected = 0
        while collected < need_cnt:
            # Locate remaining cells containing the primitive
            candidates = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not candidates:
                # Nothing left – break; the episode will later fail if insufficient
                break
            # Choose the closest candidate (Manhattan distance)
            candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = candidates[0]

            # Move adjacent to the primitive
            path = _bfs_path(pos, [target])
            actions.extend(path)
            # Simulate movement
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick it up
            actions.append(USE)
            harvested.add(target)
            # Remove the item from our local copy of the grid
            grid[target[0], target[1], prim_idx] = 0
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its workshop (if the recipe specifies one)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be name or already an int)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        # Find all workshop cells of this type
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = ws_cells[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [ws_target])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft
            actions.append(USE)
    else:
        # No specific workshop – attempt crafting at current location
        actions.append(USE)

    return actions

