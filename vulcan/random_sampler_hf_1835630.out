            _, nxt = state.step(a)
            hsh = _state_hash(nxt)
            if hsh in visited:
                continue
            visited.add(hsh)
            g_next = g + 1
            f_next = g_next + _heuristic(nxt)
            heapq.heappush(frontier, (f_next, g_next, nxt, actions + [a]))

    # If we exit the loop without finding a plan, return empty list
    return []

