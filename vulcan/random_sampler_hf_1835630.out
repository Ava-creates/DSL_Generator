    # Get action indices
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )

    # Goal index (int) for the item we need to produce
    goal = env.task.goal

    # Primitive requirements for the goal (primitive index -> count)
    needed = env.world.cookbook.primitives_for(goal)

    # Snapshot of current state to simulate pickups without affecting the env
    state = env._current_state
    pos = tuple(state.pos)                     # (x, y) current position
    grid = state.grid.copy()                   # mutable copy of the grid

    # ----------------------------------------------------------------------
    # Helper: BFS path planning that avoids non‑grabbable entities
    # ----------------------------------------------------------------------
    def _bfs_path(start, target, allow_target_block=False):
        """Return a list of actions moving from start to target.
        If allow_target_block is True the target cell is considered traversable
        even if it contains a non‑grabbable entity (useful for picking up the
        item or reaching a workshop). Returns None if no path exists."""
        width, height = grid.shape[:2]

        # Determine blocked cells (non‑grabbable entities)
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        if allow_target_block:
            blocked[target[0], target[1]] = False

        # BFS
        q = collections.deque([start])
        came_from = {start: None}
        action_from = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in (
                (DOWN, (1, 0)),
                (UP, (-1, 0)),
                (RIGHT, (0, 1)),
                (LEFT, (0, -1)),
            ):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_from[nxt] = a
                        q.append(nxt)

        if target not in came_from:
            return None  # no path found

        # Reconstruct actions
        actions = []
        cur = target
        while cur != start:
            a = action_from[cur]
            actions.append(a)
            cur = came_from[cur]
        actions.reverse()
        return actions

    # ----------------------------------------------------------------------
    # Helper: Simple Manhattan movement (ignores obstacles) as a fallback
    # ----------------------------------------------------------------------
    def _manhattan_path(start, target):
        moves = []
        x, y = start
        tx, ty = target
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    actions = []

    # ----------------------------------------------------------------------
    # Phase 1: Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Find all remaining cells containing this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # Primitive not available; stop trying to collect more
                break
            # Choose the closest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            # Plan a path to the target
            path = _bfs_path(pos, target, allow_target_block=True)
            if path is None:
                path = _manhattan_path(pos, target)
            actions.extend(path)
            pos = target
            # Pick up the primitive
            actions.append(USE)
            # Simulate removal from the grid
            grid[pos[0], pos[1], prim_idx] = 0

    # ----------------------------------------------------------------------
    # Phase 2: Move to the appropriate workshop and craft the goal item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locations:
            # Pick the nearest workshop
            target_ws = min(
                ws_locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = _bfs_path(pos, target_ws, allow_target_block=True)
            if path is None:
                path = _manhattan_path(pos, target_ws)
            actions.extend(path)
            pos = target_ws
            # Use the workshop to craft
            actions.append(USE)

    return actions

