    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at', None)

    # Cardinal movement deltas
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving the agent
    # from `start` to a cell that is adjacent (Chebyshev distance ≤ 1)
    # to any cell in `targets`. Only empty cells may be traversed.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, targets, grid):
        from collections import deque
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # Check adjacency to any target cell
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # Only walk through completely empty cells
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Locate all cells currently holding the needed primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Primitive not present – cannot continue
                break

            # Plan a path to the nearest primitive (adjacent cell)
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # Unreachable – abort further attempts for this primitive
                break

            # Execute movement actions
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # Use action to pick up the primitive
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        # Locate all workshop cells of the appropriate kind
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # Use action at the workshop to craft the item
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # Return the compiled action sequence (list of integer action IDs)
    return actions


