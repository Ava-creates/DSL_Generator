    # Reset environment and grab useful references
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def delta_to_action(dy, dx):
        """Convert a unit delta into the corresponding action."""
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        raise ValueError("Non‑unit delta")

    def bfs_path(start, goal):
        """Bread‑first search on the static map (ignores dynamic inventory).
        Returns a list of actions that move from *start* to *goal*.
        Cells containing any *non‑grabbable* entity are treated as obstacles."""
        H, W = grid.shape[:2]
        q = collections.deque()
        q.append(start)
        visited = {start: None}          # map position -> (prev_pos, action)

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                break
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                if not (0 <= ny < H and 0 <= nx < W):
                    continue
                # block if any non‑grabbable entity occupies the cell
                if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                    continue
                if (ny, nx) not in visited:
                    visited[(ny, nx)] = ((y, x), delta_to_action(dy, dx))
                    q.append((ny, nx))

        # reconstruct path
        if goal not in visited:
            return []          # unreachable – return empty path
        actions_rev = []
        cur = goal
        while visited[cur] is not None:
            prev, act = visited[cur]
            actions_rev.append(act)
            cur = prev
        actions_rev.reverse()
        return actions_rev

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell that contains *kind_idx* (primitive or workshop)."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def choose_adjacent(target, cur):
        """Pick a free neighbour of *target* to stand on.
        Preference order: above, below, left, right. If none free, return the target itself."""
        ty, tx = target
        H, W = grid.shape[:2]
        for ny, nx, facing in [
            (ty - 1, tx, DOWN),   # stand above, face downwards
            (ty + 1, tx, UP),     # stand below, face upwards
            (ty, tx - 1, RIGHT),  # stand left, face rightwards
            (ty, tx + 1, LEFT)    # stand right, face leftwards
        ]:
            if 0 <= ny < H and 0 <= nx < W:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx, facing)
        # fallback: stand on the primitive cell itself (no specific facing)
        return (ty, tx, None)

    # ------------------------------------------------------------------
    # Determine primitive requirements for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in required_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose where to stand before using.
            stand_y, stand_x, facing = choose_adjacent(target, cur_pos)

            # Move to the chosen standing cell.
            actions += bfs_path(cur_pos, (stand_y, stand_x))
            cur_pos = (stand_y, stand_x)

            # If we need a specific facing direction, issue a turn action.
            if facing is not None:
                actions.append(facing)   # turn without moving (blocked move)

            # Use action to pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions


    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid

    # Action indices (standard ordering)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions that walk from ``start`` to ``goal``."""
        actions = []
        y, x = start
        gy, gx = goal
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing ``kind_idx`` (primitive or workshop)."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine required primitives for the goal item ('arrow')
    # ------------------------------------------------------------------
    goal_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # current (y, x)

    # ------------------------------------------------------------------
    # Collect each primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on (prefer empty).
            stand = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        stand = (ny, nx)
                        break
            if stand is None:
                # No free neighbour; stand on the primitive cell itself.
                stand = target

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, stand)
            cur_pos = stand

            # Face the primitive (by moving towards it; direction changes even if blocked).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions

