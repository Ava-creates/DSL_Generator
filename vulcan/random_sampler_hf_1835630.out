    # Mapping between direction vectors and action indices.
    DIR_TO_ACT = {(0, 1): 0,   # DOWN
                  (0, -1): 1,  # UP
                  (-1, 0): 2,  # LEFT
                  (1, 0): 3}   # RIGHT
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}
    ACTION_USE = 4

    from collections import deque
    import numpy as np

    def bfs(start, targets, grid, blocked_kinds):
        """Return a list of movement actions that brings the agent from ``start``
        to a cell adjacent (Manhattan distance 1) to any cell in ``targets``.
        Cells containing any kind in ``blocked_kinds`` are treated as obstacles.
        """
        W, H = grid.shape[:2]

        # Pre‑compute blocked mask.
        blocked = np.zeros((W, H), dtype=bool)
        for k in blocked_kinds:
            blocked |= grid[:, :, k] > 0

        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # Unreachable.
        return []

    # ------------------------------------------------------------------
    # Extract current state information.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)                     # (x, y)

    # Goal index is stored in the task (env.task.goal).
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive requirements for the goal (including counts).
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    blocked_kinds = env.world.non_grabbable_indices

    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        while cnt > 0:
            # Locate remaining cells that still contain this primitive.
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive unavailable – abort planning.
                return plan

            # Move adjacent to the closest such cell.
            path = bfs(pos, cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement to keep ``pos`` up‑to‑date.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to.
            adj = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                # Safety break to avoid infinite loop.
                break

            # Update local copy of the grid and decrement the needed count.
            grid[adj[0], adj[1], kind_idx] -= 1
            cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(ACTION_USE)

    return plan


    DIR_TO_ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}
    ACTION_USE = 4

    from collections import deque
    import numpy as np

    def bfs(start, targets, grid, block_set):
        """Return a list of actions moving from ``start`` to a cell adjacent to any target."""
        W, H = grid.shape[:2]
        blocked = np.zeros((W, H), dtype=bool)
        for b in block_set:
            blocked |= grid[:, :, b] > 0

        sx, sy = start
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []

    # ------------------------------------------------------------------
    # Extract current state.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)

    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    block_set = env.world.non_grabbable_indices

    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, count in needed.items():
        while count > 0:
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                return plan  # primitive missing, abort planning

            path = bfs(pos, cells.tolist(), grid, block_set)
            plan.extend(path)

            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            plan.append(ACTION_USE)

            adj = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                break  # safety

            grid[adj[0], adj[1], kind_idx] -= 1
            count -= 1

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid, block_set)
            plan.extend(path)

            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            plan.append(ACTION_USE)

    return plan

