    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _hash_state(st):
        """Create a hashable representation of a CraftState."""
        return (
            st.pos,                     # (x, y) tuple
            st.dir,                     # facing direction (int)
            tuple(st.inventory.tolist()),  # inventory counts
            st.grid.tobytes(),          # full grid occupancy
        )

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_hash_state(init_state))

