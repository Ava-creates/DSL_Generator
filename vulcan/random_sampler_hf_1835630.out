    # Locate world and cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # Goal item name.
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in cookbook.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for the goal.
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)
    grid = state.grid.copy()          # planning copy of the grid
    occ = np.any(grid > 0, axis=2)    # occupied cells mask

    actions = []
    harvested = set()                 # locations already collected

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest first).
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        collected = 0
        while collected < needed:
            # Find all remaining locations of this primitive.
            candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                          if tuple(p) not in harvested]
            if not candidates:
                # No more of this primitive on the map – cannot complete.
                break
            # Choose the closest candidate.
            candidates.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            target = candidates[0]

            # Move adjacent to the target.
            path = bfs_path(pos, [target], occ)
            actions.extend(path)
            pos = apply_path(pos, path)

            # Pick up the primitive.
            actions.append(USE)
            # Update planning structures.
            occ[target[0], target[1]] = False
            grid[target[0], target[1], prim_idx] = 0
            harvested.add(target)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
