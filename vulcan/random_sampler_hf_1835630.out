        ty, tx = target
        for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            ny, nx = ty + dy, tx + dx
            if is_free((ny, nx)):
                return (ny, nx)
        return None

    def bfs_path(start, goal):
        """Return a list of actions (DOWN/UP/LEFT/RIGHT) moving from `start`
        to `goal` while avoiding non‑grabbable cells. Empty list if unreachable."""
        if start == goal:
            return []

        from collections import deque
        queue = deque([start])
        parent = {start: (None, None)}   # pos -> (prev_pos, action)

        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            y, x = cur
            for (dy, dx), act in [((-1, 0), UP), ((1, 0), DOWN),
                                  ((0, -1), LEFT), ((0, 1), RIGHT)]:
                ny, nx = y + dy, x + dx
                nxt = (ny, nx)
                if not is_free(nxt):
                    continue
                if nxt not in parent:
                    parent[nxt] = (cur, act)
