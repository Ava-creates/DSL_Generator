            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = bfs_adjacent(pos, [target_ws], blocked)
            plan.extend(path)
            pos = apply_actions(pos, path)
            plan.append(USE)
        else:
            # No visible workshop – attempt to craft at current location.
            plan.append(USE)
    else:
        # No specific workshop required – just use the current cell.
        plan.append(USE)

    return plan

