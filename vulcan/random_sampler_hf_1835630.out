    import collections
    import numpy as np

    # Action indices (standard CraftWorld actions)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from `start` to a
    # position adjacent (Manhattan distance = 1) to any cell in `targets`.
    # The search treats any occupied cell (grid[...,k] > 0 for any k) as
    # blocked.  If `start` is already adjacent, an empty list is returned.
    # ------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # adjacency check
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no reachable adjacency – return empty list
        return []

    # ------------------------------------------------------------------
    # Locate the underlying CraftWorld and its cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the internal state.
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal: craft an 'arrow'.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Determine primitive requirements for a single arrow.
    primitives_needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # ------------------------------------------------------------------
    # Ensure we start from a fresh episode.
    # ------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    grid = state.grid                # (W, H, n_kinds)

    # Occupancy map: True where any entity blocks movement.
    occupied = np.any(grid > 0, axis=2)

    actions = []                     # final action list
    used_cells = set()               # primitives already collected

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all current locations of this primitive.
        locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locs:
            if gathered >= needed:
                break
            if loc in used_cells:
                continue
            # Path to a cell adjacent to the primitive.
            path = _bfs_to_adjacent(pos, [loc], occupied)
            actions.extend(path)
            # Update `pos` according to the actions taken.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use action to pick up the primitive.
            actions.append(USE)
            # After collection the cell becomes empty – update occupancy.
            occupied[loc[0], loc[1]] = False
            used_cells.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Move to the required workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be name or int).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if not workshop_cells:
            raise RuntimeError(f"No workshop of type '{workshop_key}' found in the scenario.")
        # Choose the nearest workshop.
        workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        target_ws = workshop_cells[0]
        path = _bfs_to_adjacent(pos, [target_ws], occupied)
        actions.extend(path)
        for act in path:
            if act == RIGHT:
                pos = (pos[0] + 1, pos[1])
            elif act == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif act == DOWN:
                pos = (pos[0], pos[1] + 1)
            elif act == UP:
                pos = (pos[0], pos[1] - 1)
        # Use action to craft the arrow.
        actions.append(USE)

    return actions


    # action identifiers
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: BFS that avoids any occupied cell and returns a list of actions
    # moving from `start` to a position adjacent to any cell in `targets`.
    # ----------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where something blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # adjacency check
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # unreachable – return empty list
        return []

    # ----------------------------------------------------------------------
    # Locate the world / cookbook inside the environment wrapper
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # some wrappers expose the world via the internal state
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = state_obj.world
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Goal is the item named "arrow"
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not present in recipe index.")
    goal_idx = cookbook.index[goal_name]

    # primitives required for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # ----------------------------------------------------------------------
    # Ensure we start from a fresh reset state
    # ----------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)          # current (x, y)
    grid = state.grid                # (W, H, n_kinds)

    actions = []                     # final action sequence
    used_cells = set()               # primitives already harvested

    # ----------------------------------------------------------------------
    # Gather each required primitive (nearest‑first greedy)
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # locate all cells currently containing this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from current position
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed:
                break
            if cell in used_cells:
                continue
            # move adjacent to the primitive
            path = _bfs_to_adjacent(pos, [cell])
            actions.extend(path)
            # update our notion of position
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # pick it up
            actions.append(USE)
            used_cells.add(cell)
            collected += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (may be name or already an int)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        # locate all workshop cells of this type
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_to_adjacent(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)

    return actions

