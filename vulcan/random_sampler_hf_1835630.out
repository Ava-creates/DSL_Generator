    # Reset environment to a fresh start
    env.reset()

    # Mapping from action name to integer id used by the environment
    act_map = env.action_specs()
    # Direction vectors for movement actions
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  ( 1, 0),
        "LEFT":  ( 0,-1),
        "RIGHT": ( 0, 1),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving from `start`
    # to a cell that is adjacent (including diagonally) to any cell in
    # `targets`.  Returns None if no such path exists.
    # ------------------------------------------------------------------
    from collections import deque
    def bfs_to_adjacent(start, targets, grid):
        W, H = grid.shape[:2]
        visited = {start}
        q = deque([(start, [])])
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # adjacency test (Chebyshev distance ≤ 1)
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                    # can only walk on empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None

    # ------------------------------------------------------------------
    # Gather information about the goal and its recipe
    # ------------------------------------------------------------------
    goal_idx = env.task.goal                     # index of the desired item
    needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)      # may be None

    actions = []   # list of integer action ids to be returned

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in needed_prims.items():
        for _ in range(required_cnt):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # locate all cells that currently contain this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                raise RuntimeError(f"Primitive {prim_idx} not found on the map.")

            # plan a path to a cell adjacent to any of those locations
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                raise RuntimeError(f"Cannot reach primitive {prim_idx} from position {pos}.")

            # execute the movement actions (both for planning and to keep env state up‑to‑date)
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # pick up the primitive (USE action)
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not found on the map.")

        path = bfs_to_adjacent(pos, workshop_cells, grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")

        for act_name in path:
            act_id = act_map[act_name]
            actions.append(act_id)
            env.step(act_id)

    # ------------------------------------------------------------------
    # 3) Final USE to perform the crafting (or to pick up if no workshop)
    # ------------------------------------------------------------------
    actions.append(act_map["USE"])
    env.step(act_map["USE"])

    return actions


    # Reset environment to get a fresh state
    env.reset()
    # Mapping from action name to integer ID
    act_id = env.action_specs()
    # Direction vectors for movement actions
    moves = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    # ----------------------------------------------------------------------
    # Helper: Bread‑first search that returns a list of action NAMES moving
    # from `start` to any empty cell that is adjacent (including diagonally)
    # to one of the target cells.
    # ----------------------------------------------------------------------
    from collections import deque

    def bfs_to_adjacent(start, targets, grid):
        """Return list of action names to reach a cell adjacent to any target.
        Returns None if no such path exists."""
        W, H = grid.shape[:2]
        visited = {start}
        q = deque([(start, [])])
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # adjacency test (Chebyshev distance ≤ 1)
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # explore neighbours
            for name, (dx, dy) in moves.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                    # a cell is traversable only if it contains no entity
                    if grid[nx, ny].sum() == 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [name]))
        return None

    # ----------------------------------------------------------------------
    # Gather recipe information for the goal (arrow)
    # ----------------------------------------------------------------------
    goal_idx = env.task.goal
    # primitive requirements for one unit of the goal
    needed = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}
    # recipe dict may also contain a workshop location via key "_at"
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    actions = []          # list of integer action IDs to be returned

    # ----------------------------------------------------------------------
    # 1) Collect each required primitive the needed number of times
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # locate all cells that currently contain this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                raise RuntimeError(f"Primitive {prim_idx} not found on the map.")

            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                raise RuntimeError(f"Cannot reach primitive {prim_idx} from {pos}.")

            # translate action names to IDs and record them
            for name in path:
                aid = act_id[name]
                actions.append(aid)

            # finally use the "USE" action to pick it up
            actions.append(act_id["USE"])

    # ----------------------------------------------------------------------
    # 2) If the recipe requires a workshop, move next to one and craft
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not present in the world.")

        path = bfs_to_adjacent(pos, workshop_cells, grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable.")

        for name in path:
            actions.append(act_id[name])

    # ----------------------------------------------------------------------
    # 3) Final USE action to craft (or pick up if no workshop)
    # ----------------------------------------------------------------------
    actions.append(act_id["USE"])

    return actions

