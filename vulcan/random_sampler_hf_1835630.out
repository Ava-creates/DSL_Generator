    from collections import namedtuple
    import heapq

    Node = namedtuple("Node", ["g", "f", "state", "actions"])

    def _state_key(st):
        """Hashable representation of a CraftState."""
        return (st.pos, st.dir,
                tuple(st.inventory.tolist()),
                st.grid.tobytes())

    def _manhattan(p1, p2):
        return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])

    def _nearest_distance(grid, kind, pos):
        """Return Manhattan distance from pos to nearest cell containing `kind` (>0)."""
        mask = grid[:, :, kind] > 0
        if not mask.any():
            return None
        ys, xs = np.where(mask)
        dists = np.abs(ys - pos[0]) + np.abs(xs - pos[1])
        return int(dists.min())

    def _heuristic(st):
        """Estimate remaining steps to obtain an arrow."""
        # If we already have the arrow, h = 0
        if st.inventory[target_idx] > 0:
            return 0

        # Determine which primitives are still missing
        missing = {}
        for p_idx, cnt in prim_req.items():
            have = st.inventory[p_idx]
            need = max(0, cnt - have)
            if need > 0:
                missing[p_idx] = need

        # If there are missing primitives, distance to the closest needed primitive
        if missing:
            dmin = None
            for p_idx in missing:
                d = _nearest_distance(st.grid, p_idx, st.pos)
                if d is not None:
                    dmin = d if dmin is None else min(dmin, d)
            # If none of the needed primitives are present on the map, give a large penalty
            return dmin if dmin is not None else 1000

        # All primitives satisfied: need to reach a workshop (if known)
        if workshop_idx is not None:
            d = _nearest_distance(st.grid, workshop_idx, st.pos)
            return d if d is not None else 1000

        # Fallback: just a small constant
        return 1

    visited = {_state_key(init_state)}
    start_h = _heuristic(init_state)
    frontier = [Node(g=0, f=start_h, state=init_state, actions=[])]

    MAX_ITER = 20000          # safeguard against infinite loops
    n_actions = getattr(world, "n_actions", 5)   # typically 5 (4 moves + USE)
    # Prefer USE (usually last index) before movement actions
    action_order = list(range(n_actions - 1, -1, -1))

    iter_cnt = 0
    while frontier:
        iter_cnt += 1
        if iter_cnt > MAX_ITER:
            break
        node = heapq.heappop(frontier)
        cur_state = node.state

        # Goal test
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Expand neighbours
        for a in action_order:
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key in visited:
                continue
            visited.add(key)
            g2 = node.g + 1
            h2 = _heuristic(nxt_state)
            f2 = g2 + h2
            heapq.heappush(frontier, Node(g=g2, f=f2, state=nxt_state,
                                         actions=node.actions + [a]))

    # No plan found within budget
    return []

