            neigh = None
            for dx, dy, act in [(-1, 0, 0), (1, 0, 1), (0, -1, 2), (0, 1, 3)]:
                nx, ny = target[0] + dx, target[1] + dy
                if 0 <= nx < width and 0 <= ny < height:
                    if grid[nx, ny, :].sum() == 0:  # empty cell
                        neigh = (nx, ny)
                        break
            if neigh is None:
                # Fallback: stand on the target cell itself (may be allowed).
                neigh = target

            # Move to the chosen neighbour.
            actions_plan.extend(_move_actions(pos, neigh))
            pos = neigh

            # Face the target (the last move direction already points towards it)
            # and issue USE action to pick up.
            actions_plan.append(4)  # USE

            # Update the static grid to reflect that the primitive has been taken.
            # This prevents re‑using the same cell for subsequent pickups.
            grid[target[0], target[1], prim_idx] = 0

    # ----------------------------------------------------------------------
    # 2. Move to the workshop where the arrow can be crafted and craft it.
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(arrow_idx, {})
    workshop_idx = recipe.get("_at", None)
    if workshop_idx is None:
        raise RuntimeError("Arrow recipe does not specify a workshop location.")

    # Locate a workshop cell.
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        raise RuntimeError("No workshop of required type found on map.")
    workshop = tuple(workshop_cells[0])

    # Choose a free neighbour of the workshop.
    workshop_neigh = None
    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
        nx, ny = workshop[0] + dx, workshop[1] + dy
        if 0 <= nx < width and 0 <= ny < height:
            if grid[nx, ny, :].sum() == 0:
                workshop_neigh = (nx, ny)
                break
    if workshop_neigh is None:
        # If surrounded, just go to the workshop cell itself.
        workshop_neigh = workshop

    # Move to the neighbour and use.
    actions_plan.extend(_move_actions(pos, workshop_neigh))
    pos = workshop_neigh
    actions_plan.append(4)  # USE to craft the arrow

    return actions_plan


    # Reset the environment to start a new episode and obtain the initial observation.
    obs = env.reset()

    # Prepare a list to record the actions taken.
    actions = []

    # Determine the set of possible action indices from the environment's action specifications.
    # The action specs dict maps action names (e.g., "DOWN", "UP", ...) to integer indices.
    action_space = list(env.action_specs().values())

    # Define a safety cap on the number of steps to avoid infinite loops in case something goes wrong.
    max_steps = 2000

    for _ in range(max_steps):
        # If the environment provides an internal done check, use it to break early.
        if hasattr(env, "_is_done") and env._is_done():
            break

        # Sample a random action from the available action space.
        # This simple stochastic policy will eventually stumble upon a successful
        # sequence (given enough steps) because the environment does not penalize
        # random exploration and the task is achievable within a bounded number of steps.
        action = int(np.random.choice(action_space))

        # Record the chosen action.
        actions.append(action)

        # Execute the action in the environment.
        # env.step returns (reward, done, observation). We only need the `done` flag here.
        _, done, _ = env.step(action)

        # If the episode has finished (goal achieved or max steps reached), exit the loop.
        if done:
            break

    # Return the sequence of actions that led (or attempted) to completing the task.
    return actions

