    import collections
    import numpy as np

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT
    ACTION_USE = 4

    def bfs(start, targets, blocked):
        """Return a list of action indices that reaches any cell in *targets*."""
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # No path found – should not happen in well‑formed scenarios
        return []

    def go_to_and_use(kind_idx, count):
        """Move to a cell containing *kind_idx* and USE it *count* times."""
        nonlocal pos, actions
        for _ in range(count):
            cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # Extract recipe information for the target item "arrow"
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    # primitive requirements and ordered crafting steps
    needed_prims = {}          # primitive kind -> total count required
    craft_steps = []           # list of (item_idx, multiplier) in post‑order

    def resolve(item_idx, mult):
        """Recursively gather primitive counts and schedule crafting."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # Resolve ingredients first
        for ing, cnt in rec.items():
            if isinstance(ing, int):        # ignore special keys like "_at"
                resolve(ing, cnt * mult)
        # Then schedule this item to be crafted
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ------------------------------------------------------------------
    # Prepare static data about the current grid
    # ------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ------------------------------------------------------------------
    # Build the full action sequence
    # ------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Collect all primitive resources needed
    for prim_idx, cnt in needed_prims.items():
        go_to_and_use(prim_idx, cnt)

    # 2) Perform crafting steps at the required workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([ACTION_USE] * cnt)

    return actions


    # Helper BFS to find a path of actions from start to any target cell.
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT

    def bfs(start, targets, blocked):
        """Return a list of action indices that reaches any target cell."""
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # Should not happen for solvable scenarios

    def go_to_kind(kind_idx, count):
        """Move to cells containing `kind_idx` and USE them `count` times."""
        nonlocal pos, actions
        for _ in range(count):
            cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)  # USE action

    # ------------------------------------------------------------------
    # Gather recipe information for the target item ("arrow")
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}
    craft_steps = []

    def resolve(item_idx, mult):
        """Recursively compute primitive requirements and crafting order."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:
            # Primitive item (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # Resolve ingredients first
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # Schedule this item to be crafted after its ingredients are ready
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ------------------------------------------------------------------
    # Static data about the current grid
    # ------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1. Collect all required primitive resources
    for kind_idx, cnt in needed_prims.items():
        go_to_kind(kind_idx, cnt)

    # 2. Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * cnt)  # USE at workshop the required number of times

    return actions

