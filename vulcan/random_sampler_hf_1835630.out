    goal_idx = env.task.goal
    # Mapping primitive kind index -> count needed to craft one goal item.
    needed_prims = env.world.cookbook.primitives_for(goal_idx)

    # Snapshot of current state (grid, position).
    cur_state = env._current_state
    pos = tuple(cur_state.pos)                 # (x, y)
    grid = cur_state.grid.copy()                # mutable local copy

    actions = []                                 # final action list

    # ----------------------------------------------------------------------
    # Helper: BFS path finder that avoids non‑grabbable entities.
    # Returns a list of actions moving from `start` to `target`.
    # ----------------------------------------------------------------------
    def bfs_path(start, target):
        """Return list of actions from start to target, or None if unreachable."""
        width, height = grid.shape[:2]

        # Cells occupied by any non‑grabbable kind are blocked.
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Target cell may be occupied (e.g. workshop); allow stepping onto it.
        blocked[target[0], target[1]] = False

        q = collections.deque([start])
        parent = {start: None}
        act_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        # Reconstruct actions from target back to start.
        seq = []
        cur = target
        while cur != start:
            seq.append(act_to[cur])
            cur = parent[cur]
        seq.reverse()
        return seq

    # ----------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ----------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            # Find all cells that currently contain this primitive.
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Nothing left on the map – assume we already have it in inventory.
                break

            # Choose the closest primitive (Manhattan distance) as a heuristic.
            target = min(prim_cells,
                         key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))

            path = bfs_path(pos, target)
            if path is None:
