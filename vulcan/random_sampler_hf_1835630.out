    import numpy as np
    from collections import deque

    # Reset environment and get initial state/world handles
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # Helper: breadth‑first search that returns a list of movement actions
    # (0‑3) which brings the agent to a cell whose *front* contains the
    # target kind. Returns None if the target cannot be reached.
    # ------------------------------------------------------------------
    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)  (DOWN, UP, LEFT, RIGHT)
        deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = cur_state.pos
        sdir = cur_state.dir

        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine which primitive kinds and how many of each are needed to
    # craft a single arrow.  If the recipe is empty, arrow itself is a
    # primitive.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:
        needed = {arrow_idx: 1}

    plan = []

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            seq = _bfs_to_target(state, prim_idx)
            if seq is None:          # unreachable primitive → abort early
                return plan
            plan.extend(seq)
            plan.append(4)           # USE to pick it up
            for a in seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).  If the recipe
    # does not specify a workshop, we can craft in place.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = _bfs_to_target(state, workshop_idx)
        if seq is None:               # unreachable workshop → abort
            return plan
        plan.extend(seq)
        plan.append(4)                # USE to craft
        for a in seq + [4]:
            _, state = state.step(a)
    else:
        plan.append(4)                # USE to craft in place
        _, state = state.step(4)

    return plan


