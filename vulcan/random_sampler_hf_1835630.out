    import numpy as np

    # Retrieve action indices from the environment (fallback to defaults if missing)
    action_map = env.action_specs()
    DOWN = action_map.get("DOWN", 0)
    UP = action_map.get("UP", 1)
    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    world = env.world
    state = env._current_state

    # Determine the goal index for the arrow (use task goal if available)
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        goal_idx = world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise RuntimeError("Goal 'arrow' not found in the cookbook.")

    # Primitive requirements for the goal (expanded to raw resources)
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    actions = []
    cur_pos = tuple(state.pos)

    # Helper: move Manhattan‑style from current position to target, updating cur_pos
    def _move_to(target):
        nonlocal cur_pos
        tx, ty = target
        while cur_pos[0] < tx:
            actions.append(RIGHT)
            cur_pos = (cur_pos[0] + 1, cur_pos[1])
        while cur_pos[0] > tx:
            actions.append(LEFT)
            cur_pos = (cur_pos[0] - 1, cur_pos[1])
        while cur_pos[1] < ty:
            actions.append(DOWN)
            cur_pos = (cur_pos[0], cur_pos[1] + 1)
        while cur_pos[1] > ty:
            actions.append(UP)
            cur_pos = (cur_pos[0], cur_pos[1] - 1)

    # Collect each required primitive
    for prim_idx, needed in primitive_requirements.items():
        if needed <= 0:
            continue
        # Find all cells that currently contain this primitive
        locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
        if locations.size == 0:
            # Primitive not present on the map; cannot collect it
            continue
        # Choose the nearest occurrence to reduce steps
        dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
        nearest_loc = tuple(locations[dists.argmin()])
        _move_to(nearest_loc)
        # Pick up the required amount (one USE per unit)
        for _ in range(needed):
            actions.append(USE)

    # Locate the workshop required for the final crafting step
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_key") or recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = (
            world.cookbook.index.get(workshop_name)
            if isinstance(workshop_name, str)
            else workshop_name
        )
        if workshop_idx is not None:
            ws_locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)
            if ws_locations.size > 0:
                # Move to the nearest workshop location
                dists = np.abs(ws_locations[:, 0] - cur_pos[0]) + np.abs(ws_locations[:, 1] - cur_pos[1])
                nearest_ws = tuple(ws_locations[dists.argmin()])
                _move_to(nearest_ws)

    # Use the workshop (or current cell) to craft the arrow
    actions.append(USE)

    return actions


