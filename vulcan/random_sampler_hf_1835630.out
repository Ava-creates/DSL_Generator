    # reset environment and obtain state/world information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy of the grid

    # ------------------------------------------------------------------
    # Action identifiers (consistent with CraftLab.action_specs)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    H, W = grid.shape[0], grid.shape[1]

    def in_bounds(y, x):
        return 0 <= y < H and 0 <= x < W

    def cell_blocked(y, x):
        """A cell is blocked if any *non‑grabbable* entity occupies it."""
        if not world.non_grabbable_indices:
            return False
        idxs = list(world.non_grabbable_indices)
        return np.any(grid[y, x, idxs] > 0)

    def bfs_path(start, goal):
        """Shortest path (as a list of movement actions) from start to goal."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        rev.append(DOWN)
                    elif cur[0] == py - 1:
                        rev.append(UP)
                    elif cur[1] == px + 1:
                        rev.append(RIGHT)
                    elif cur[1] == px - 1:
                        rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(rev))
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # no path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Return the coordinates of the closest cell containing ``kind_idx``."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell, avoid=set()):
        """Return a free neighbour of ``cell`` not in ``avoid``."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not cell_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal (arrow) and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_primitives = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos                     # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    collected = set()                       # cells from which primitives were taken
    for prim_idx, cnt in needed_primitives.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # primitive missing – abort early
                return actions

            # Choose a free adjacent cell to stand on while picking up
            adj = free_adjacent(target, avoid=collected)
            if adj is None:
                # fallback: stand directly on the primitive cell
                adj = target

            # Move to the chosen adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (a blocked move updates direction)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update internal grid representation
            grid[target[0], target[1], prim_idx] = 0
            collected.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = free_adjacent(ws_cell, avoid=collected)
            if ws_adj is None:
                ws_adj = ws_cell
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop (optional blocked move)
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting of the arrow
    actions.append(USE)

    return actions


    # Reset environment to get a fresh state
    env.reset()
    state = env._current_state            # CraftState instance
    world = env.world                      # CraftWorld instance
    grid = state.grid.copy()               # mutable copy of the grid

    # ------------------------------------------------------------------
    # Action identifiers (consistent with CraftLab.action_specs)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    H, W = grid.shape[0], grid.shape[1]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < H and 0 <= x < W

    def cell_blocked(y, x):
        """A cell is blocked if any non‑grabbable entity occupies it."""
        # Non‑grabbable kinds are stored in world.non_grabbable_indices
        if not world.non_grabbable_indices:
            return False
        return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs_path(start, goal):
        """Return a list of movement actions that brings the agent from start to goal."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct path
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        rev.append(DOWN)
                    elif cur[0] == py - 1:
                        rev.append(UP)
                    elif cur[1] == px + 1:
                        rev.append(RIGHT)
                    elif cur[1] == px - 1:
                        rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(rev))
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # No path found – return empty list (will likely cause failure later)
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing ``kind_idx``."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell, avoid=set()):
        """Return a free neighbour of ``cell`` not in ``avoid``."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not cell_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine the goal index for 'arrow' and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting required counts)
    # ------------------------------------------------------------------
    taken_cells = set()   # keep track of primitive cells already harvested
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early
                return actions

            # Choose a free adjacent cell to stand on while picking up
            adj = free_adjacent(target, avoid=taken_cells)
            if adj is None:
                # No free neighbour; fall back to standing directly on the primitive
                adj = target

            # Move to the chosen adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Orient towards the primitive (optional blocked move to set direction)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update internal grid representation so we don't try to collect it again
            grid[target[0], target[1], prim_idx] = 0
            taken_cells.add(target)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = free_adjacent(ws_cell, avoid=taken_cells)
            if ws_adj is None:
                ws_adj = ws_cell
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop (optional blocked move)
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Finally, use the crafting action to create the arrow
    actions.append(USE)

    return actions

