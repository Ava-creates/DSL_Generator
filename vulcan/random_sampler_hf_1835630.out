    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helper maps between movement vectors and action indices.
    # ----------------------------------------------------------------------
    DIR_TO_ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search returning a list of actions that moves the agent
    # from ``start`` to a cell *adjacent* to any cell in ``targets``.
    # Cells containing any index from ``block_set`` are treated as obstacles.
    # ----------------------------------------------------------------------
    def bfs(start_pos, target_cells, grid, block_set):
        W, H = grid.shape[:2]
        # Build a boolean map of blocked cells.
        blocked = np.zeros((W, H), dtype=bool)
        for b in block_set:
            blocked |= grid[:, :, b] > 0

        sx, sy = start_pos
        # Already adjacent?
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Initialise state and extract goal information.
    # ----------------------------------------------------------------------
    obs = env.reset()
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)                     # (x, y)

    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # Primitive requirements for the goal (expanded to primitives only).
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    block_set = env.world.non_grabbable_indices

    plan = []

    # ----------------------------------------------------------------------
    # 1. Collect each required primitive.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        while needed_cnt > 0:
            # Locate all cells that currently contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive no longer present – abort planning.
                return plan

            # Find a path to the nearest reachable primitive (adjacent).
            path = bfs(pos, prim_cells.tolist(), grid, block_set)
            plan.extend(path)

            # Simulate the movement to update ``pos``.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive.
            plan.append(4)   # USE

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation – break to avoid infinite loop.
                break

            # Update local grid copy (remove one instance) and decrement need.
            grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
            needed_cnt -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get('_at') or recipe.get('_key')
    if workshop_key is not None:
        # Resolve workshop index.
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid, block_set)
            plan.extend(path)
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft by using the workshop.
            plan.append(4)   # USE

    return plan


    # ----------------------------------------------------------------------
    # Helper mappings and BFS to reach a cell adjacent to any target cell.
    # ----------------------------------------------------------------------
    DIR_TO_ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    from collections import deque
    import numpy as np

    def bfs(start_pos, target_cells, grid, blocked_kinds):
        """Return a list of actions moving from ``start_pos`` to a position
        adjacent (Manhattan distance = 1) to any cell in ``target_cells``.
        ``grid`` has shape (W, H, K). Cells whose kind is in ``blocked_kinds``
        are treated as obstacles.
        """
        W, H = grid.shape[:2]
        # Build a boolean map of blocked cells.
        blocked = np.zeros((W, H), dtype=bool)
        for kind in blocked_kinds:
            blocked |= grid[:, :, kind] > 0

        sx, sy = start_pos
        # If we are already adjacent, no movement needed.
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacent cell.
        return []

    # ----------------------------------------------------------------------
    # Extract task information from the environment.
    # ----------------------------------------------------------------------
    # Current state and a mutable copy of the grid.
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)                     # (x, y)

    # Goal index as stored in the task.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in the environment task.")

    # Primitive requirements for the goal (primitive kind → count).
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    # Kinds that block movement (e.g., trees, water, etc.).
    blocked_kinds = env.world.non_grabbable_indices

    plan = []

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ----------------------------------------------------------------------
    for prim_kind, needed_cnt in primitives_needed.items():
        while needed_cnt > 0:
            # Locate remaining instances of this primitive on the map.
            prim_cells = np.argwhere(grid[:, :, prim_kind] > 0)
            if prim_cells.size == 0:
                # Not enough primitives left; abort planning.
                return plan

            # Find a path to the nearest reachable primitive (adjacent).
            path = bfs(pos, prim_cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement to update our current position.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive.
            plan.append(4)   # USE

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation – break to avoid an infinite loop.
                break

            # Update the local grid copy (remove one instance) and decrement need.
            grid[adj_cell[0], adj_cell[1], prim_kind] -= 1
            needed_cnt -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    # Workshop can be stored under '_at' or legacy '_key'.
    workshop_key = recipe.get('_at') or recipe.get('_key')
    if workshop_key is not None:
        # Resolve workshop kind index.
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement to the workshop adjacency.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(4)   # USE

    return plan

