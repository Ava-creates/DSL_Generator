    import numpy as np

    # Action indices (as defined by CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and fetch the current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for bookkeeping

    # Index of the goal item (“arrow”) and its primitive requirements
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that
        moves the agent from ``start`` to ``goal`` using a simple Manhattan walk."""
        y, x = start
        gy, gx = goal
        actions = []
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def nearest_cell(kind, from_pos):
        """Find the nearest cell that contains ``kind`` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of ``target`` (preferring N,S,W,E)."""
        ty, tx = target
        for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        # If no free neighbour, fall back to the target cell itself
        return target

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos  # current position (y, x)

    # Collect each required primitive the needed number of times
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive not found – abort early
                return actions

            stand_pos = free_adjacent(prim_loc)
            actions += manhattan_path(cur, stand_pos)
            cur = stand_pos

            # Step onto the primitive cell
            dy = prim_loc[0] - cur[0]
            dx = prim_loc[1] - cur[1]
            if dy == 1:
                actions.append(DOWN)
                cur = (cur[0] + 1, cur[1])
            elif dy == -1:
                actions.append(UP)
                cur = (cur[0] - 1, cur[1])
            elif dx == 1:
                actions.append(RIGHT)
                cur = (cur[0], cur[1] + 1)
            elif dx == -1:
                actions.append(LEFT)
                cur = (cur[0], cur[1] - 1)
            # Pick up the primitive
            actions.append(USE)

            # Mark it as collected locally
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # Move to the appropriate workshop (if the recipe specifies one)
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            actions += manhattan_path(cur, ws_loc)
            cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions


    import numpy as np

    # Action indices (as defined in CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and obtain current state/world
    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid.copy()   # mutable copy for bookkeeping

    # Index of the goal item ("arrow") and its primitive requirements
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal."""
        y, x = start
        gy, gx = goal
        actions = []
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def nearest_cell(kind, from_pos):
        """Find nearest cell containing the given kind (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of target that is not occupied by non‑grabbable entities."""
        ty, tx = target
        for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        # fallback – target itself (assumed walkable)
        return target

    actions = []
    cur = state.pos  # current agent position (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # primitive not found – abort early
                return actions

            stand_pos = free_adjacent(prim_loc)
            actions += manhattan_path(cur, stand_pos)
            cur = stand_pos

            # step onto the primitive cell
            dy = prim_loc[0] - cur[0]
            dx = prim_loc[1] - cur[1]
            if dy == 1:
                actions.append(DOWN); cur = (cur[0] + 1, cur[1])
            elif dy == -1:
                actions.append(UP); cur = (cur[0] - 1, cur[1])
            elif dx == 1:
                actions.append(RIGHT); cur = (cur[0], cur[1] + 1)
            elif dx == -1:
                actions.append(LEFT); cur = (cur[0], cur[1] - 1)

            # pick up the primitive
            actions.append(USE)

            # mark it as collected locally
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            actions += manhattan_path(cur, ws_loc)
            cur = ws_loc

    actions.append(USE)   # craft the arrow
    return actions

