    import numpy as np
    import collections

    # Action indices as defined in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def bfs_path(start, targets, occ):
        """Return a list of actions moving from start to a cell adjacent to any target."""
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    def apply_path(pos, path):
        """Return new position after applying a sequence of actions."""
        x, y = pos
        for act in path:
            if act == RIGHT:
                x += 1
            elif act == LEFT:
                x -= 1
            elif act == DOWN:
                y += 1
            elif act == UP:
                y -= 1
        return (x, y)

