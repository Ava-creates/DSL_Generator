    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ----------------------------------------------------------------------
    # BFS: find a sequence of actions that moves the agent to a cell adjacent
    # (Manhattan distance 1) to any target cell while avoiding non‑grabbable
    # obstacles.
    # ----------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_to_adjacent(start, targets, grid):
        """Return a list of actions that brings the agent from ``start`` to a
        position adjacent to any cell in ``targets``. ``grid`` has shape
        (W, H, K). A cell is considered blocked if any non‑grabbable kind has
        a positive count in that cell."""
        W, H = grid.shape[:2]
        # Determine blocked cells (any non‑grabbable entity present)
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start
        # Already adjacent to a target?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()            # mutable copy for simulation
    pos = tuple(state.pos)              # (x, y)

    # Goal index is stored in the task object (env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # Determine primitive (and intermediate) requirements for the goal.
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # --------------------------------------------------------------
    # 1. Collect all required primitives (including intermediates)
    # --------------------------------------------------------------
    for kind_idx, cnt_needed in needed.items():
        while cnt_needed > 0:
            # Locate all cells currently containing this kind
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive not present on the map – abort planning.
                return plan

            # Find a path to the nearest reachable primitive (adjacent)
            path = bfs_to_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to update the agent's position
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive
            plan.append(4)   # USE

            # Identify which primitive cell we are now adjacent to
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update local grid copy (remove one instance) and decrement need
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt_needed -= 1

    # --------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a string name or already an int)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft by using the workshop
            plan.append(4)   # USE

    return plan

