    import collections
    import numpy as np

    # Action indices: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    def bfs(start, targets, blocked):
        """Bread‑first search returning a list of action indices from start to the nearest target."""
        w, h = start_grid.shape[:2]
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # No reachable target – return empty path (should not happen in well‑formed scenarios)
        return []

    # ----------------------------------------------------------------------
    # Gather recipe information
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]
    # Primitive requirements for one arrow (handles intermediate recursion)
    needed_prims = cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}
    # Workshop location where the arrow must be crafted
    recipe = cookbook.recipes[goal_idx]
    workshop_key = recipe.get("_at", recipe.get("_key"))
    workshop_idx = (
        workshop_key
        if isinstance(workshop_key, int)
        else cookbook.index[workshop_key]
    )

    # ----------------------------------------------------------------------
    # Prepare static grid and blocked‑cell mask
    # ----------------------------------------------------------------------
    start_grid = env._current_state.grid
    w, h, _ = start_grid.shape
    blocked_mask = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked_mask |= start_grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Build action sequence
    # ----------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)

    # Helper: move to the nearest cell containing a given kind and USE it
    def collect_kind(kind_idx, qty):
        nonlocal cur_pos, actions
        for _ in range(qty):
            # Locate all cells that currently contain the required kind
            cells = {
                (x, y)
                for x in range(w)
                for y in range(h)
                if start_grid[x, y, kind_idx] > 0
            }
            # Find path to the closest such cell
            path = bfs(cur_pos, cells, blocked_mask)
            actions.extend(path)
            # Update current position following the path
            for a in path:
                dx, dy = DIRS[a]
                cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)
            # Pick up the item
            actions.append(4)  # USE

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        collect_kind(prim_idx, count)

    # ----------------------------------------------------------------------
    # Go to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = {
        (x, y)
        for x in range(w)
        for y in range(h)
        if start_grid[x, y, workshop_idx] > 0
    }
    path_to_ws = bfs(cur_pos, workshop_cells, blocked_mask)
    actions.extend(path_to_ws)
    # (optional) update cur_pos – not needed after final step
    actions.append(4)  # USE to craft the arrow

    return actions


    # Helper: BFS to nearest target cell avoiding blocked cells.
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    def bfs(start, targets, blocked):
        from collections import deque
        w, h = start_grid.shape[:2]
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable (should not happen)

    # ------------------------------------------------------------------
    # Gather world / recipe information
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]
    recipe = cookbook.recipes[arrow_idx]

    # workshop where the arrow must be crafted
    workshop_key = recipe.get("_at", recipe.get("_key"))
    if isinstance(workshop_key, int):
        workshop_idx = workshop_key
    else:
        workshop_idx = cookbook.index[workshop_key]

    # primitive requirements for one arrow
    needed_prims = cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Grid, position, and blocked‑cell mask
    # ------------------------------------------------------------------
    start_grid = env._current_state.grid.copy()
    w, h, _ = start_grid.shape
    cur_pos = tuple(env._current_state.pos)

    blocked_mask = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked_mask |= start_grid[:, :, idx] > 0

    actions = []

    # ------------------------------------------------------------------
    # Function to move to a cell containing a given kind and pick it up
    # ------------------------------------------------------------------
    def move_and_pick(kind_idx, qty):
        nonlocal cur_pos, actions, start_grid
        for _ in range(qty):
            # locate all cells currently holding the required kind
            cells = {(x, y) for x in range(w) for y in range(h)
                     if start_grid[x, y, kind_idx] > 0}
            if not cells:
                raise RuntimeError(f"No remaining cells for kind {kind_idx}")
            path = bfs(cur_pos, cells, blocked_mask)
            actions.extend(path)
            # update position following the path
            for a in path:
                dx, dy = DIRS[a]
                cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)
            # pick up the item
            actions.append(4)  # USE
            # remove the item from the grid so it won't be reused
            start_grid[cur_pos[0], cur_pos[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        move_and_pick(prim_idx, count)

    # ------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ------------------------------------------------------------------
    workshop_cells = {(x, y) for x in range(w) for y in range(h)
                      if start_grid[x, y, workshop_idx] > 0}
    if not workshop_cells:
        raise RuntimeError("No workshop cell found for arrow crafting")
    path = bfs(cur_pos, workshop_cells, blocked_mask)
    actions.extend(path)
    for a in path:
        dx, dy = DIRS[a]
        cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)
    actions.append(4)  # USE to craft

    return actions

