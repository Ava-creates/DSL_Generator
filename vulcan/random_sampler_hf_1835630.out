    # ----------------------------------------------------------------------
    # Helper functions
    # ----------------------------------------------------------------------
    def _bfs_path(start, goal, grid):
        """Return a list of actions to move from start to goal using BFS.
        start/goal are [x, y] lists. Cells with any non‑zero kind are considered
        blocked, except the goal cell itself.
        """
        width, height = grid.shape[0], grid.shape[1]
        moves = [
            ((0, 1), 0),   # DOWN
            ((0, -1), 1),  # UP
            ((-1, 0), 2),  # LEFT
            ((1, 0), 3),   # RIGHT
        ]
        from collections import deque
        q = deque()
        q.append(tuple(start))
        visited = {tuple(start): (None, None)}  # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                # allow stepping onto the goal even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                visited[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in visited:
            return []  # no path found

        # reconstruct path
        path = []
        cur = tuple(goal)
        while visited[cur][0] is not None:
            prev, act = visited[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell containing the given kind (Manhattan distance)."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if len(xs) == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Planning
    # ----------------------------------------------------------------------
    actions = []
    USE = 4

    # Determine current position: use live state if available, else init pos
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the static grid to simulate item removal
    grid = env.scenario.init_grid.copy()

    # Goal item index
    goal_idx = env.task.goal

    # ----------------------------------------------------------------------
    # 1. Gather required primitives
    # ----------------------------------------------------------------------
    primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, count in primitive_reqs.items():
        for _ in range(count):
            tgt = _nearest_kind(prim_kind, cur_pos, grid)
            if tgt is None:
                # Primitive not found – abort planning
                return actions
            actions.extend(_bfs_path(cur_pos, tgt, grid))
            actions.append(USE)  # pick up primitive
            grid[tgt[0], tgt[1], prim_kind] = 0
            cur_pos = tgt

    # ----------------------------------------------------------------------
    # 2. Move to workshop and craft the goal
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(_bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)  # craft at workshop
            cur_pos = workshop_pos

    # Return the complete action list
    return actions


    # Action indices (consistent with CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS path finder on the static grid (ignores inventory)
    # ------------------------------------------------------------------
    def _bfs_path(start, goal, grid):
        """Return a list of actions moving from start to goal.

        start / goal : [x, y] coordinates (list or tuple)
        grid : static occupancy grid (WIDTH, HEIGHT, n_kinds)
        Cells with any non‑zero kind are treated as blocked,
        except the goal cell itself which may be occupied.
        """
        width, height = grid.shape[0], grid.shape[1]
        moves = [
            ((0, 1), DOWN),   # down  (+y)
            ((0, -1), UP),    # up    (-y)
            ((-1, 0), LEFT),  # left  (-x)
            ((1, 0), RIGHT),  # right (+x)
        ]

        from collections import deque
        q = deque()
        q.append(tuple(start))
        visited = {tuple(start): (None, None)}   # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow stepping onto the goal even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                visited[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        # Reconstruct path
        if tuple(goal) not in visited:
            return []   # No path found
        path = []
        cur = tuple(goal)
        while visited[cur][0] is not None:
            prev, act = visited[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind (Manhattan distance)
    # ------------------------------------------------------------------
    def _nearest_kind(kind_idx, cur_pos, grid):
        """Return [x, y] of the closest cell that has at least one of kind_idx."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if len(xs) == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Planning start
    # ------------------------------------------------------------------
    actions = []

    # Current position: use live state if available, else initial position
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the static grid to mark collected items
    grid = env.scenario.init_grid.copy()

    # Goal item index
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the goal
    # ------------------------------------------------------------------
    primitive_reqs = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    for prim_kind, count in primitive_reqs.items():
        for _ in range(count):
            target = _nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive not found – abort planning
                return actions
            actions.extend(_bfs_path(cur_pos, target, grid))
            actions.append(USE)                     # pick up the primitive
            # Update simulated world: remove the primitive from the grid
            grid[target[0], target[1], prim_kind] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(_bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)                     # craft at the workshop
            cur_pos = workshop_pos
    else:
        # No specific workshop – simply use the item at current location
        actions.append(USE)

    return actions

