    pos = tuple(state.pos)                     # current (x, y)
    grid = state.grid.copy()                   # mutable copy of the world grid
    inventory = state.inventory.copy()         # mutable copy of inventory
    width, height = grid.shape[:2]

    # -----------------------------------------------------------------
    # BFS pathfinder avoiding non‑grabbable entities.
    # -----------------------------------------------------------------
    def bfs(start, target):
        nonlocal grid
        blocked = np.zeros((width, height), dtype=bool)
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        # allow stepping onto the target even if it would otherwise be blocked
        blocked[target[0], target[1]] = False

        q = collections.deque([start])
        parent = {start: None}
        act_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
