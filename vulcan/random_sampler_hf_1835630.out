    )

    goal = env.task.goal
    required = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    state = env._current_state
    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()              # mutable copy of the grid
    actions = []                           # accumulated action list

    # -----------------------------------------------------------------
    # Helper: BFS pathfinder that avoids non‑grabbable entities.
    # Allows stepping onto the target even if it would otherwise be blocked.
    # -----------------------------------------------------------------
    def bfs(start, target):
        width, height = grid.shape[:2]

        # Cells occupied by any non‑grabbable entity are blocked.
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Permit moving onto the target cell (e.g., a workshop or primitive).
        blocked[target[0], target[1]] = False

        q = collections.deque([start])
        parent = {start: None}
        act_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        # Reconstruct the action sequence from start to target.
        seq = []
        cur = target
        while cur != start:
            seq.append(act_to[cur])
            cur = parent[cur]
        seq.reverse()
        return seq

    # -----------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # -----------------------------------------------------------------
    for prim_idx, count in required.items():
        for _ in range(count):
            # Find all cells that currently contain this primitive.
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more instances; assume they are already in inventory.
                break

            # Choose the nearest instance (Manhattan distance).
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            # Plan a path to the primitive.
            path = bfs(pos, target)
            if path is None:
                # Fallback to simple Manhattan moves if BFS fails.
                dx, dy = target[0] - pos[0], target[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1

            # Execute movement and pickup.
            actions.extend(path)
            actions.append(USE)

            # Update simulated position and grid.
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0

    # -----------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the goal item.
    # -----------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if workshop_cells:
            target_ws = min(
                workshop_cells,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = bfs(pos, target_ws)
            if path is None:
                dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1
            actions.extend(path)
            actions.append(USE)  # craft at the workshop

    return actions

