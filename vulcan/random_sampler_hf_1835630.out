    import numpy as np
    from collections import deque

    # Action indices (as defined by CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Initialise environment and obtain handles to the underlying objects.
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Fallback path: straight Manhattan moves ignoring obstacles."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def bfs_path(start, goal, walkable):
        """A*‑like BFS returning a list of movement actions from start to goal.
        `walkable(y, x)` must return True iff the agent can occupy (y, x)."""
        if start == goal:
            return []
        H, W = grid.shape[0], grid.shape[1]
        q = deque([start])
        came_from = {start: None}
        action_from = {}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            cy, cx = cur
            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = cy + dy, cx + dx
                if 0 <= ny < H and 0 <= nx < W and walkable(ny, nx):
                    nxt = (ny, nx)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_from[nxt] = act
                        q.append(nxt)
        else:
            return None  # no path found

        # reconstruct actions
        actions_rev = []
        cur = goal
        while cur != start:
            act = action_from[cur]
            actions_rev.append(act)
            cur = came_from[cur]
        actions_rev.reverse()
        return actions_rev

    def nearest_cell(kind_idx, from_pos):
        """Return coordinates of the nearest cell containing `kind_idx`."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[np.argmin(dists)])

    def empty_adjacent(pos):
        """Return an empty neighbour of `pos` (or None)."""
        y, x = pos
        H, W = grid.shape[0], grid.shape[1]
        for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            ny, nx = y + dy, x + dx
            if 0 <= ny < H and 0 <= nx < W:
                if np.all(grid[ny, nx, :] == 0):
                    return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = nearest_cell(prim_idx, cur_pos)
            if target is None:
                # No more primitives of this type – abort planning.
                return actions

            adj = empty_adjacent(target)
            if adj is None:
                # If no empty neighbour, stand on the primitive cell after it is taken.
                adj = target

            # Walk to the adjacent (or same) cell.
            def walkable(y, x):
                # Cannot step on any occupied cell.
                return np.all(grid[y, x, :] == 0) or (y, x) == adj

            path = bfs_path(cur_pos, adj, walkable)
            if path is None:
                path = manhattan_path(cur_pos, adj)
            actions.extend(path)
            cur_pos = adj

            # Face the primitive (move towards it; will be blocked, but direction changes).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick it up.
            actions.append(USE)

            # Update grid to reflect that the primitive has been taken.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest_cell(workshop_idx, cur_pos)
        if ws_cell is not None:
            def ws_walkable(y, x):
                # All cells must be empty except the goal workshop cell.
                return (y, x) == ws_cell or np.all(grid[y, x, :] == 0)

            path = bfs_path(cur_pos, ws_cell, ws_walkable)
            if path is None:
                path = manhattan_path(cur_pos, ws_cell)
            actions.extend(path)
            cur_pos = ws_cell

    # Trigger crafting.
    actions.append(USE)

    return actions


    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and obtain the underlying state objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that
        moves the agent from ``start`` to ``goal`` using a Manhattan walk.
        No obstacle checking is performed."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x

        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)

        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)

        return actions

    def find_nearest(cell_kind, from_pos):
        """Find the nearest cell containing ``cell_kind`` (primitive or workshop).
        Returns the coordinate (y, x) or ``None`` if not found."""
        locations = np.argwhere(grid[:, :, cell_kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = np.argmin(dists)
        return tuple(locations[nearest_idx])

    # ------------------------------------------------------------------
    # Determine the goal index for 'arrow' and the required primitives.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not found – abort early.
                return actions

            ty, tx = target

            # Choose a free adjacent cell (prefer one that lets us face the primitive).
            adj = None
            neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]
            for ny, nx in neighbours:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour – fallback to the primitive cell itself.
                adj = target

            # Move to the adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Turn to face the primitive (use a movement action that will be blocked).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions

