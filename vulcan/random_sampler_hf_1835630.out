    # BFS node definition
    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_state_hash(init_state))

    MAX_PLAN_LENGTH = 300  # safety cutoff for plan length
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", arrow_idx):
            return cur_actions

        if len(cur_actions) >= MAX_PLAN_LENGTH:
            continue

        # Expand neighbours
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, cur_actions + [a]))

    # No viable plan found within the depth limit
    return []

