                env.step(act_id)

            # pick up the primitive (USE)
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Go to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not found on the map.")

        path = bfs_to_adjacent(pos, workshop_cells, grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")

        for act_name in path:
            act_id = act_map[act_name]
            actions.append(act_id)
            env.step(act_id)

    # ------------------------------------------------------------------
    # 3) Final USE to perform the crafting (or to pick up if no workshop)
    # ------------------------------------------------------------------
    actions.append(act_map["USE"])
    env.step(act_map["USE"])

    return actions

