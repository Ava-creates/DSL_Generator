    # Helper to get kind index from name
    def _idx(name):
        return env.world.cookbook.index[name]

    # Action indices (consistent with CraftWorld)
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    move_to_action = {
        (1, 0): ACTION_DOWN,
        (-1, 0): ACTION_UP,
        (0, -1): ACTION_LEFT,
        (0, 1): ACTION_RIGHT,
    }

    # Reset and obtain initial state
    env.reset()
    state = env._current_state
    grid = state.grid
    pos = tuple(state.pos)

    # Goal: make an arrow
    goal_idx = _idx('arrow')
    # Primitive (and intermediate) requirements for one arrow
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    # Workshop where arrow must be crafted
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at') or recipe.get('_key')
    if isinstance(workshop_kind, str):
        workshop_kind = _idx(workshop_kind)

    # Set of indices that block movement (non‑grabbable entities)
    block_set = env.world.non_grabbable_indices

    # ------------------------------------------------------------------
    # Utility functions
    # ------------------------------------------------------------------
    def _walkable(x, y):
        """Return True if cell (x,y) is inside the grid and not blocked by a
        non‑grabbable entity."""
        if x < 0 or x >= grid.shape[0] or y < 0 or y >= grid.shape[1]:
            return False
        return not any(grid[x, y, idx] > 0 for idx in block_set)

    from collections import deque

    def _bfs_path(start, target_cells, require_adjacent=False):
        """Find a shortest path (list of actions) from start to any cell in
        target_cells. If require_adjacent=True the returned path ends on a
        walkable cell that is orthogonally adjacent to a target cell."""
        if not target_cells:
            return []

        # quick check: already adjacent (or on) a target
        if not require_adjacent:
            if start in target_cells:
                return []
        else:
            for tx, ty in target_cells:
                if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                    return []

        q = deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if require_adjacent:
                # stop when cur is adjacent to any target
                for tx, ty in target_cells:
                    if abs(cur[0] - tx) + abs(cur[1] - ty) == 1:
                        goal = cur
                        break
                else:
                    goal = None
                if goal is not None:
                    # reconstruct path
                    actions = []
                    while came_from[goal] is not None:
                        prev, move = came_from[goal]
                        actions.append(move_to_action[move])
                        goal = prev
                    actions.reverse()
                    return actions
            else:
                if cur in target_cells:
                    # reconstruct path
                    actions = []
                    while came_from[cur] is not None:
                        prev, move = came_from[cur]
                        actions.append(move_to_action[move])
                        cur = prev
                    actions.reverse()
                    return actions

            x, y = cur
            for dx, dy in [(1, 0), (-1, 0), (0, -1), (0, 1)]:
                nx, ny = x + dx, y + dy
                if _walkable(nx, ny) and (nx, ny) not in came_from:
                    came_from[(nx, ny)] = (cur, (dx, dy))
                    q.append((nx, ny))
        # no path found
        return []

    # ------------------------------------------------------------------
    # Planning loop
    # ------------------------------------------------------------------
    actions_seq = []
    max_total_steps = 2000  # safety limit

    while not state.satisfies('', goal_idx) and len(actions_seq) < max_total_steps:
        inventory = state.inventory

        # Determine which primitives we still need
        missing = None
        for kind_idx, cnt in needed.items():
            if inventory[kind_idx] < cnt:
                missing = kind_idx
                break

        if missing is None:
            # All required items are in inventory – go craft at workshop
            if workshop_kind is None:
                break  # no workshop info, cannot continue
            workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
            if workshop_cells.size == 0:
                break  # no workshop on map
            path = _bfs_path(tuple(state.pos), workshop_cells.tolist(),
                             require_adjacent=True)
            actions_seq.extend(path)
            for a in path:
                _, state = env.step(a)
            actions_seq.append(ACTION_USE)
            _, state = env.step(ACTION_USE)
        else:
            # Need to collect the missing primitive
            prim_cells = np.argwhere(grid[:, :, missing] > 0)
            if prim_cells.size == 0:
                break  # primitive not present on map
            path = _bfs_path(tuple(state.pos), prim_cells.tolist(),
                             require_adjacent=False)
            actions_seq.extend(path)
            for a in path:
                _, state = env.step(a)
            actions_seq.append(ACTION_USE)
            _, state = env.step(ACTION_USE)

    return actions_seq


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helper constants and functions
    # ----------------------------------------------------------------------
    # Action indices (as used by CraftWorld)
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {(1, 0): ACTION_DOWN,
               (-1, 0): ACTION_UP,
               (0, -1): ACTION_LEFT,
               (0, 1): ACTION_RIGHT}
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs_adjacent(start, targets, blocked):
        """
        Return a list of actions that moves from ``start`` to a cell
        adjacent (Manhattan distance = 1) to any coordinate in ``targets``.
        ``blocked`` is a 2‑D bool array where True means the cell cannot be entered.
        """
        W, H = blocked.shape
        sx, sy = start
        # already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.zeros((W, H), dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:
                    npath = path + [act]
                    # check adjacency to any target
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []  # unreachable

    # ----------------------------------------------------------------------
    # Initialise environment / state
    # ----------------------------------------------------------------------
    # Reset to a fresh state (if not already reset)
    try:
        env.reset()
    except Exception:
        pass  # env may already be in a reset state

    state = env._current_state
    grid = state.grid.copy()            # mutable copy for planning
    pos = tuple(state.pos)              # (x, y)

    # Goal: make an arrow
    goal_idx = env.world.cookbook.index.get('arrow')
    if goal_idx is None:
        return []  # cannot find arrow in index

    # ----------------------------------------------------------------------
    # Determine required primitives / intermediate items
    # ----------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # Pre‑compute a mask of cells that block movement (non‑grabbable entities)
    def blocked_mask_from_grid(g):
        mask = np.zeros(g.shape[:2], dtype=bool)
        for idx in env.world.non_grabbable_indices:
            mask |= g[:, :, idx] > 0
        return mask

    # ----------------------------------------------------------------------
    # 1. Collect all required items
    # ----------------------------------------------------------------------
    for kind_idx, required_cnt in needed.items():
        while required_cnt > 0:
            # locate cells that still contain the needed kind
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # no more of this item on the map – abort planning
                return plan

            # compute current blocked cells
            blocked = blocked_mask_from_grid(grid)
            # find path to a cell adjacent to any of the candidate cells
            path = bfs_adjacent(pos, cells.tolist(), blocked)
            plan.extend(path)

            # simulate movement
            for act in path:
                dx, dy = ACT2DIR[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # use action to pick up the item
            plan.append(ACTION_USE)

            # determine which item cell we interacted with (must be adjacent)
            used_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    used_cell = (cx, cy)
                    break
            if used_cell is None:
                # safety fallback – stop planning
                return plan

            # update simulated grid (remove one instance)
            grid[used_cell[0], used_cell[1], kind_idx] -= 1
            required_cnt -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get('_at') or recipe.get('_key')
    if workshop_key is not None:
        # Resolve workshop index (could be string name or integer)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index.get(workshop_key)
        else:
            workshop_idx = int(workshop_key)

        if workshop_idx is not None:
            workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
            if workshop_cells.size > 0:
                blocked = blocked_mask_from_grid(grid)
                path = bfs_adjacent(pos, workshop_cells.tolist(), blocked)
                plan.extend(path)

                # simulate movement to workshop
                for act in path:
                    dx, dy = ACT2DIR[act]
                    pos = (pos[0] + dx, pos[1] + dy)

                # final USE to craft the arrow
                plan.append(ACTION_USE)

    return plan

