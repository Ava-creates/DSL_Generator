    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    pos = tuple(state.pos)

    # Determine goal index for "arrow"
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        goal_idx = world.cookbook.index.get("arrow")
    if goal_idx is None:
        raise RuntimeError("Unable to locate goal index for 'arrow'.")

    # Primitive requirements (raw resources) for the goal
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to nearest target cells while avoiding blocked cells
    # ------------------------------------------------------------------
    from collections import deque

    def bfs(start, targets):
        """Return a list of actions to reach any cell in *targets*.
        Cells are considered blocked if any kind occupies them, unless the
        cell is one of the target cells."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in targets:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # Blocked if any entity present and not a target
                if np.any(grid[nx, ny, :]) and nxt not in targets:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def apply_path(path):
        """Update *pos* according to a sequence of actions."""
        nonlocal pos
        for a in path:
            if a == DOWN:
                pos = (pos[0], pos[1] + 1)
            elif a == UP:
                pos = (pos[0], pos[1] - 1)
            elif a == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif a == RIGHT:
                pos = (pos[0] + 1, pos[1])

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count_needed in primitives_needed.items():
        collected = 0
        # Find all locations containing this primitive
        locations = [(x, y) for x in range(width) for y in range(height)
                     if grid[x, y, prim_idx] > 0]
        # Simple greedy: iterate through locations until we have enough
        loc_ptr = 0
        while collected < count_needed and loc_ptr < len(locations):
            target = locations[loc_ptr]
            loc_ptr += 1

            # Move to the target cell
            path = bfs(pos, {target})
            if path is None:
                continue  # cannot reach this instance, try next
            actions.extend(path)
            apply_path(path)

            # Determine how many units are on this cell
            available = int(grid[target[0], target[1], prim_idx])
            to_take = min(count_needed - collected, available)

            for _ in range(to_take):
                actions.append(USE)
                inventory[prim_idx] += 1
                grid[target[0], target[1], prim_idx] -= 1

            collected += to_take

        if collected < count_needed:
            # Not enough of this primitive on the map; cannot complete task
            raise RuntimeError(
                f"Insufficient primitive {prim_idx} for crafting arrow."
            )

    # ------------------------------------------------------------------
    # Move to workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at") or recipe.get("_key")
    if workshop_name is not None:
        # Resolve workshop index
        if isinstance(workshop_name, int):
            workshop_idx = workshop_name
        else:
            workshop_idx = world.cookbook.index.get(workshop_name)
        if workshop_idx is None:
            raise RuntimeError(f"Workshop '{workshop_name}' not found in index.")
        # Locate any workshop cell
        workshop_cells = [(x, y) for x in range(width) for y in range(height)
                          if grid[x, y, workshop_idx] > 0]
        if not workshop_cells:
            raise RuntimeError("No workshop cell found on the map.")
        ws_target = workshop_cells[0]
        path = bfs(pos, {ws_target})
        if path is not None:
            actions.extend(path)
            apply_path(path)
        # Final USE to craft the arrow
        actions.append(USE)
    else:
        # No specific workshop required; just use to craft in place
        actions.append(USE)

    return actions

