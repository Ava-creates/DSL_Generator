    # action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: move current position (list [x, y]) towards target (list [x, y])
    # ----------------------------------------------------------------------
    def _move_to(cur, target, seq):
        while cur[0] != target[0] or cur[1] != target[1]:
            if cur[0] < target[0]:
                seq.append(RIGHT); cur[0] += 1
            elif cur[0] > target[0]:
                seq.append(LEFT);  cur[0] -= 1
            elif cur[1] < target[1]:
                seq.append(DOWN);  cur[1] += 1
            elif cur[1] > target[1]:
                seq.append(UP);    cur[1] -= 1

    # ----------------------------------------------------------------------
    # Helper: locate nearest cell that currently contains at least one of
    # the given kind index. Returns [x, y] or None.
    # ----------------------------------------------------------------------
    def _nearest_kind(kind_idx, cur_pos, grid):
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Determine starting position (use the state if already created,
    # otherwise fall back to the scenario's init position).
    # ----------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the initial grid so we can “remove” items
    # once they have been collected.
    grid = env.scenario.init_grid.copy()

    actions = []
    goal_idx = env.task.goal

    # ----------------------------------------------------------------------
    # 1. Gather all primitive resources needed for the goal.
    # ----------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()
    # If the goal itself is a primitive, we also need to pick it up.
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Required primitive missing – abort planning.
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)
            # Mark the item as taken.
            grid[target[1], target[0], kind_idx] = 0

    # ----------------------------------------------------------------------
    # 2. If the recipe specifies a workshop, go there and craft.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _move_to(pos, target, seq):
        """Append moves to seq to bring pos (list [x,y]) to target (list [x,y])."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Return [x,y] of nearest cell containing kind_idx, or None."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # Determine current position
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Copy the static grid to track which items have been collected
    grid = env.scenario.init_grid.copy()

    actions = []
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal.
    # ------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()
    # If the goal itself is a primitive, we also need to pick it up.
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for kind_idx, count in primitive_needs.items():
        for _ in range(count):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Required primitive not found; abort planning.
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)
            # Mark the item as taken in our copy of the grid.
            grid[target[1], target[0], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)

    return actions

