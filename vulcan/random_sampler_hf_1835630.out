    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny] or (nx, ny) in target_set:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    actions = []

    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locs:
                break
            locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locs[0]

            path = _bfs_path(pos, [target])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            actions.append(USE)
            grid[target[0], target[1], prim_idx] = 0
            collected += 1

    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str)
            else workshop_key
        )
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_locs[0]
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
    else:
        actions.append(USE)

    return actions


    # Ensure we have a current state
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Access world and cookbook
    world = getattr(env, "world", None) or getattr(state, "world", None)
    if world is None:
        raise RuntimeError("World object not found in the environment.")
    cookbook = world.cookbook

    # Goal: make an arrow
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for one arrow (primitive index → count)
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Simulated copies of grid and agent position
    grid = state.grid.copy()
    pos = tuple(state.pos)          # (x, y)

    # Action identifiers
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions moving the agent
    # from `start` to a cell adjacent (or equal) to any of `targets`.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # any non‑zero cell blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check if we are adjacent (or on) a target
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable target
        return []

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            # Find remaining cells that contain this primitive
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                # No more instances; break (the episode will later fail if needed)
                break
            # Choose the closest location by Manhattan distance
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_loc = locations[0]

            # Move adjacent to the primitive
            path = _bfs_path(pos, [target_loc])
            actions.extend(path)
            # Update simulated position
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick up the primitive
            actions.append(USE)
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or integer)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str)
            else workshop_key
        )
        # Locate workshop cells of this type
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            # Choose nearest workshop
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_locs[0]

            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Craft the arrow
            actions.append(USE)
        else:
            # No workshop found; attempt crafting at current location
            actions.append(USE)
    else:
        # No explicit workshop – craft at current location
        actions.append(USE)

    return actions

