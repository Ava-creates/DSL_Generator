    # Constants for actions
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # Mapping from movement actions to coordinate changes (x=row, y=col)
    MOVE_DELTAS = {
        DOWN: (1, 0),
        UP: (-1, 0),
        LEFT: (0, -1),
        RIGHT: (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions moving the agent
    # from `start` to a cell adjacent (Manhattan distance 1) to any of the
    # `targets`. Cells occupied by any entity are treated as blocked.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        width, height, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where any kind is present
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Explore neighbours
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:
                    if not occupied[nx, ny]:        # can step only on empty cells
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No path found – return empty list (will likely fail later)
        return []

    # ------------------------------------------------------------------
    # Retrieve world and cookbook information
    # ------------------------------------------------------------------
    # `env` may be a CraftLab wrapper; the underlying world is stored in
    # `env.world` or inside the current state.
    world = getattr(env, "world", None)
    if world is None:
        # Try to fetch from the hidden current state
        state_candidate = getattr(env, "_current_state", None)
        if state_candidate is not None:
            world = getattr(state_candidate, "world", None)
    if world is None:
        raise RuntimeError("Could not locate CraftWorld instance in the environment.")

    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal: make an arrow
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Determine primitive requirements for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if necessary)
    # ------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        # Reset returns an observation dict; the state is stored internally
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)          # (x, y) current position
    grid = state.grid                # (W, H, n_kinds)

    actions = []                     # final action sequence
    harvested = set()                # primitive cells already collected

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ------------------------------------------------------------------
    for prim_idx, needed_qty in primitives_needed.items():
        # Locate all cells currently containing this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position
        locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed_qty:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive location
            path = _bfs_path(pos, [loc])
            actions.extend(path)
            # Update agent position according to the path taken
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use action to pick up the primitive (assumes facing the target)
            actions.append(USE)
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at the appropriate workshop (if required)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be name or already int)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key
        # Find all workshop cells of the required type
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop
            workshop_cells.sort(key=lambda w: abs(w[0] - pos[0]) + abs(w[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use action to craft at the workshop
            actions.append(USE)

    # Return the compiled list of action indices
    return actions


    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: 4‑connected BFS that avoids any occupied cell.
    # Returns a list of actions moving from `start` to a position adjacent to
    # any cell in `targets`.  If `start` is already adjacent, returns [].
    # ----------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where something blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency (Manhattan distance 1)
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path

            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacency – return empty list (caller may handle)
        return []

    # ----------------------------------------------------------------------
    # Retrieve world and cookbook information
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = state_obj.world
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance inside env.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Goal: hard‑coded to the primitive name "arrow"
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive counts needed for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # ----------------------------------------------------------------------
    # Ensure we have a fresh state; reset if necessary
    # ----------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    grid = state.grid                # (W, H, n_kinds)

    actions = []                     # final action list
    harvested = set()                # cells already used for collection

    # ----------------------------------------------------------------------
    # Collect required primitives (greedy nearest‑first)
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locate all cells currently holding this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position
        locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive location
            path = _bfs_to_adjacent(pos, [loc])
            actions.extend(path)
            # Update internal position tracking
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Perform USE to pick up the primitive (must be facing it)
            actions.append(USE)
            harvested.add(loc)
            gathered += 1

    # ----------------------------------------------------------------------
    # Craft the target at its required workshop (if any)
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (name → int) if needed
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        # Find all workshop cells of this type
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop
            path = _bfs_to_adjacent(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use to craft
            actions.append(USE)

    return actions

