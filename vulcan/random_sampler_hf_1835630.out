    """Generate a sequence of actions that makes an arrow in the given CraftLab env.

    The function:
      1. Queries the goal index from the environment task.
      2. Determines the primitive resources required for that goal.
      3. For each required primitive, finds the nearest occurrence on the map,
         plans a shortest Manhattan‑free path to it, moves there and picks it up.
      4. Finally moves to the appropriate workshop (if any) and crafts the item.

    The returned list contains action indices compatible with the env's
    `action_specs` (DOWN, UP, LEFT, RIGHT, USE).
    """
    actions: list[int] = []

    # Action spec mapping
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"],
        spec["UP"],
        spec["LEFT"],
        spec["RIGHT"],
        spec["USE"],
    )

    # Goal index and required primitives
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Current observable state (grid, position)
    state = env._current_state
    grid = state.grid
    cur_pos = tuple(state.pos)  # (x, y)

    # Helper: Manhattan movement actions from one cell to the next
    def _delta_to_action(dx: int, dy: int) -> int:
        if dx == 1:
            return DOWN
        if dx == -1:
            return UP
        if dy == 1:
            return RIGHT
        if dy == -1:
            return LEFT
        raise ValueError("Invalid delta for movement")

    # Helper: BFS to find shortest path to any of the target cells.
    # `allow_target` lets us step onto a cell that is otherwise occupied.
    def _bfs_path(start, targets, allow_target=False):
        from collections import deque

        H, W = grid.shape[0], grid.shape[1]
        visited = np.full((H, W), False, dtype=bool)
        prev = np.empty((H, W), dtype=object)

        q = deque()
        q.append(start)
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) in targets:
                # reconstruct path
                path = []
                while (x, y) != start:
                    path.append((x, y))
                    x, y = prev[x, y]
                path.reverse()
                return path
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:
                    occupied = grid[nx, ny].any()
                    if occupied and not (allow_target and (nx, ny) in targets):
                        continue
                    visited[nx, ny] = True
                    prev[nx, ny] = (x, y)
                    q.append((nx, ny))
        return None  # no path found

    # ---- Collect each needed primitive ----
    for prim_idx, count in needed.items():
        for _ in range(count):
            # locate all cells that still contain this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # nothing left on the map; break early
                break

            # choose the nearest reachable location
            path = _bfs_path(cur_pos, set(locations), allow_target=True)
            if path is None:
                # fallback to Manhattan moves (may fail if blocked)
                target = locations[0]
                path = []
                tx, ty = target
                cx, cy = cur_pos
                while cx < tx:
                    path.append((cx + 1, cy))
                    cx += 1
                while cx > tx:
                    path.append((cx - 1, cy))
                    cx -= 1
                while cy < ty:
                    path.append((cx, cy + 1))
                    cy += 1
                while cy > ty:
                    path.append((cx, cy - 1))
                    cy -= 1
            # translate path positions into movement actions
            for nxt in path:
                dx = nxt[0] - cur_pos[0]
                dy = nxt[1] - cur_pos[1]
                actions.append(_delta_to_action(dx, dy))
                cur_pos = nxt
            # pick up the primitive
            actions.append(USE)
            # update internal grid representation (optional, for subsequent searches)
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ---- Move to workshop and craft ----
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            # pick the first workshop location
            target = ws_locs[0]
            path = _bfs_path(cur_pos, {target}, allow_target=True)
            if path is None:
                # simple Manhattan fallback
                path = []
                tx, ty = target
                cx, cy = cur_pos
                while cx < tx:
                    path.append((cx + 1, cy))
                    cx += 1
                while cx > tx:
                    path.append((cx - 1, cy))
                    cx -= 1
                while cy < ty:
                    path.append((cx, cy + 1))
                    cy += 1
                while cy > ty:
                    path.append((cx, cy - 1))
                    cy -= 1
            for nxt in path:
                dx = nxt[0] - cur_pos[0]
                dy = nxt[1] - cur_pos[1]
                actions.append(_delta_to_action(dx, dy))
                cur_pos = nxt
            # craft at the workshop
            actions.append(USE)

    return actions


    # Get action indices
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )
    # Goal item index
    goal = env.task.goal
    # Primitive requirements for the goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}
    # Current state and position
    state = env._current_state
    pos = tuple(state.pos)  # (x, y)

    # Helper: Manhattan move sequence (fallback)
    def _manhattan(cur, tgt):
        moves = []
        x, y = cur
        tx, ty = tgt
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    # Helper: BFS path finder returning list of actions
    def _bfs_path(start, goal_pos, allow_goal=True):
        width, height = state.grid.shape[:2]
        # blocked cells = any non‑grabbable entity present
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(state.grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Goal cell may be blocked (e.g., workshop); allow stepping onto it if requested
        if allow_goal:
            blocked[goal_pos[0], goal_pos[1]] = False

        q = collections.deque()
        q.append(start)
        came_from = {start: None}
        action_from = {}
        while q:
            cur = q.popleft()
            if cur == goal_pos:
                break
            x, y = cur
            for a, (dx, dy) in (
                (DOWN, (1, 0)),
                (UP, (-1, 0)),
                (RIGHT, (0, 1)),
                (LEFT, (0, -1)),
            ):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    if blocked[nx, ny]:
                        continue
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_from[nxt] = a
                        q.append(nxt)

        # Reconstruct path
        if goal_pos not in came_from:
            return None  # no path found
        path_actions = []
        cur = goal_pos
        while cur != start:
            a = action_from[cur]
            path_actions.append(a)
            cur = came_from[cur]
        path_actions.reverse()
        return path_actions

    actions = []

    # ---- Collect each required primitive ----
    for prim_idx, cnt in needed.items():
        # Find all locations currently holding this primitive
        prim_locs = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
        # Simple safety: if not enough locations, break early
        if len(prim_locs) < cnt:
            cnt = len(prim_locs)
        for _ in range(cnt):
            # Choose the closest remaining location (Manhattan distance)
            if not prim_locs:
                break
            distances = [abs(pos[0] - lx) + abs(pos[1] - ly) for (lx, ly) in prim_locs]
            target = prim_locs.pop(distances.index(min(distances)))

            # Compute path
            path = _bfs_path(pos, target, allow_goal=True)
            if path is None:
                path = _manhattan(pos, target)
            actions.extend(path)
            pos = target

            # Pick up the primitive
            actions.append(USE)

    # ---- Move to workshop and craft ----
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            # Choose nearest workshop
            distances = [abs(pos[0] - lx) + abs(pos[1] - ly) for (lx, ly) in ws_locs]
            target_ws = ws_locs[distances.index(min(distances))]

            # Path to workshop
            path = _bfs_path(pos, target_ws, allow_goal=True)
            if path is None:
                path = _manhattan(pos, target_ws)
            actions.extend(path)
            pos = target_ws

            # Craft at workshop
            actions.append(USE)

    return actions

