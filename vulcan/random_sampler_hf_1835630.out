    import collections, numpy as np

    # action ids (default ordering in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_path(start, targets, grid):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    def _move(pos, act):
        if act == RIGHT:
            return (pos[0] + 1, pos[1])
        if act == LEFT:
            return (pos[0] - 1, pos[1])
        if act == DOWN:
            return (pos[0], pos[1] + 1)
        if act == UP:
            return (pos[0], pos[1] - 1)
        return pos

    # locate world and cookbook
    world = getattr(env, "world", None)
    if world is None:
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = state_tmp.world
    if world is None:
        raise RuntimeError("World object not found in environment.")
    cookbook = world.cookbook

    # ensure we have a state
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    goal_idx = cookbook.index["arrow"]
    needed_prims = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    pos = tuple(state.pos)
    grid = state.grid.copy()
    actions = []
    harvested = set()

    # collect each primitive
    for prim_idx, count in needed_prims.items():
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= count:
                break
            if loc in harvested:
                continue
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            for a in path:
                pos = _move(pos, a)
            actions.append(USE)          # pick up
            harvested.add(loc)
            collected += 1
            grid[loc[0], loc[1], prim_idx] = 0   # mark empty

    # craft at required workshop if any
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else workshop_key)
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = ws_cells[0]
            path = _bfs_path(pos, [target], grid)
            actions.extend(path)
            for a in path:
                pos = _move(pos, a)
        actions.append(USE)   # craft

    return actions


    import collections
    import numpy as np

    # Action indices – default ordering in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell adjacent (Manhattan distance ≤ 1) to any coordinate
    # in `targets`. Cells containing any entity are treated as blocked.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, grid):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where cell is non‑empty
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop if adjacent (or on) any target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Explore neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable position.
        return []

    # ------------------------------------------------------------------
    # Helper: apply an action to a position.
    # ------------------------------------------------------------------
    def _apply(pos, act):
        if act == RIGHT:
            return (pos[0] + 1, pos[1])
        if act == LEFT:
            return (pos[0] - 1, pos[1])
        if act == DOWN:
            return (pos[0], pos[1] + 1)
        if act == UP:
            return (pos[0], pos[1] - 1)
        return pos

    # ------------------------------------------------------------------
    # Locate the world and cookbook objects inside the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers keep the world inside the current state.
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = state_tmp.world
    if world is None:
        raise RuntimeError("Could not locate the world object in the environment.")

    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Goal is hard‑coded to "arrow".
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Initialise mutable copies of position and grid.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)               # (x, y)
    cur_grid = state.grid.copy()         # (W, H, n_kinds)

    actions = []
    harvested = set()                    # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells currently holding this primitive.
        locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], cur_grid)
            actions.extend(path)
            for act in path:
                pos = _apply(pos, act)
            # Pick it up.
            actions.append(USE)
            # Mark the cell as empty for future navigation.
            cur_grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name or already an int).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else workshop_key)
        # Locate workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop.
            path = _bfs_path(pos, [target_ws], cur_grid)
            actions.extend(path)
            for act in path:
                pos = _apply(pos, act)
            # Use the workshop to craft the arrow.
            actions.append(USE)
        else:
            # No workshop present – attempt to craft at current location.
            actions.append(USE)

    # Return the full action list.
    return actions

