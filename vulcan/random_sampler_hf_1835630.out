    from collections import deque
    import numpy as np

    # Map movement deltas to actions
    MOVE_MAP = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    def bfs_path(start, goal):
        """Return list of movement actions from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        W, H = grid.shape[0], grid.shape[1]
        blocked_kinds = list(world.non_grabbable_indices)

        visited = np.full((W, H), False, dtype=bool)
        prev = {}  # (y,x) -> (prev_y, prev_x, action)

        q = deque()
        q.append(start)
        visited[start] = True

        while q:
            y, x = q.popleft()
            for (dy, dx), act in MOVE_MAP.items():
                ny, nx = y + dy, x + dx
                if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:
                    # cell is free if none of the blocked kinds are present
                    if not np.any(grid[ny, nx, blocked_kinds] > 0):
                        visited[ny, nx] = True
                        prev[(ny, nx)] = (y, x, act)
                        if (ny, nx) == goal:
                            # reconstruct path
                            actions = []
                            cur = (ny, nx)
                            while cur != start:
                                py, px, a = prev[cur]
                                actions.append(a)
                                cur = (py, px)
                            actions.reverse()
                            return actions
                        q.append((ny, nx))
        return []  # no path found

    def find_nearest(kind_idx, from_pos):
        """Locate nearest cell containing kind_idx."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return (int(nearest[0]), int(nearest[1]))

    # Identify arrow and its recipe
    arrow_idx = world.cookbook.index.index("arrow")
    primitive_req = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    actions = []
    cur_pos = state.pos

    # Collect required primitives
    for prim_idx, cnt in primitive_req.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                return actions  # cannot find required primitive
            actions.extend(bfs_path(cur_pos, target))
            cur_pos = target
            actions.append(USE)

    # Move to workshop if needed and craft
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions.extend(bfs_path(cur_pos, ws_cell))
            cur_pos = ws_cell

    actions.append(USE)
    return actions

