    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:
                pos = (pos[0], pos[1] + 1)
            elif a == 1:
                pos = (pos[0], pos[1] - 1)
            elif a == 2:
                pos = (pos[0] - 1, pos[1])
            elif a == 3:
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(prim_idx, needed):
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                break
            path = None
            target_loc = None
            for loc in locations:
                p = bfs(pos, {loc})
                if p is not None:
                    path = p
                    target_loc = loc
                    break
            if path is None:
                break
            actions.extend(path)
            move_along(path)
            actions.append(4)  # USE
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            needed -= 1

    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives_set:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    p = bfs(pos, {ws_cells[0]})
                    if p:
                        actions.extend(p)
                        move_along(p)

            actions.append(4)  # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    ensure_item(target_idx, 1)

    return actions


    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # mutable copies of the environment state
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return a list of movement actions to reach any cell in *goals*."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat occupied cells as walls unless they are goal cells
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update the local position according to a sequence of actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ------------------------------------------------------------------
    # Primitive collection helper
    def collect_primitive(prim_idx, needed):
        """Collect *needed* units of primitive *prim_idx* from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                break  # no more primitives left
            chosen_path = None
            chosen_loc = None
            for loc in locations:
                p = bfs(pos, {loc})
                if p is not None:
                    chosen_path = p
                    chosen_loc = loc
                    break
            if chosen_path is None:
                break  # unreachable primitive
            actions.extend(chosen_path)
            move_along(chosen_path)
            actions.append(4)  # USE
            grid[chosen_loc[0], chosen_loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            needed -= 1

    # ------------------------------------------------------------------
    # Recursive crafting helper
    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        """Guarantee that inventory[item_idx] >= amount, crafting if needed."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives_set:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            # ensure all ingredients are present
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to the required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    p = bfs(pos, {ws_cells[0]})
                    if p:
                        actions.extend(p)
                        move_along(p)

            # perform the craft action
            actions.append(4)  # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions

