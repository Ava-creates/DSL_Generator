    # Reset environment to a clean start
    env.reset()
    # Action name → index mapping (e.g. {"UP":0, "DOWN":1, ...})
    act_map = env.action_specs()
    # Movement deltas for cardinal actions
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of action *names* that moves the agent
    # from `start` to a cell that is adjacent (Chebyshev distance ≤ 1)
    # to any cell in `targets`.  The search walks only through empty cells.
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_to_adjacent(start, targets, grid):
        W, H = grid.shape[:2]
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)

        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # Check adjacency to any target cell
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # Expand neighbours (cardinal moves only)
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                    # Walk only through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    # ------------------------------------------------------------------
    # Identify the goal and its recipe
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    actions: list[int] = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives (respecting required counts)
    # ------------------------------------------------------------------
    while True:
        state = env._current_state
        inventory = state.inventory
        # If we already have everything, break
        if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):
            break

        # Find a primitive we are still missing
        missing = [(p_idx, cnt - inventory[p_idx])
                   for p_idx, cnt in needed_prims.items()
                   if inventory[p_idx] < cnt]
        prim_idx, _ = missing[0]   # pick the first missing primitive

        # Locate all cells currently holding this primitive
        prim_cells = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
        if not prim_cells:
            raise RuntimeError(f"Required primitive {prim_idx} not found on the map.")

        # Plan a path to an adjacent cell of the nearest primitive
        path = bfs_to_adjacent(state.pos, prim_cells, state.grid)
        if path is None:
            raise RuntimeError(f"Primitive {prim_idx} is unreachable from position {state.pos}.")

        # Execute movement actions
        for act_name in path:
            act_id = act_map[act_name]
            actions.append(act_id)
            env.step(act_id)

        # Pick up the primitive with the USE action
        use_id = act_map["USE"]
        actions.append(use_id)
        env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Workshop required for crafting not found on the map.")
        path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")
        for act_name in path:
            act_id = act_map[act_name]
            actions.append(act_id)
            env.step(act_id)

    # Final USE to craft (or to pick up if no workshop is needed)
    actions.append(act_map["USE"])
    env.step(act_map["USE"])

    return actions


    import numpy as np
    from collections import deque

    # Reset environment to start fresh
    env.reset()
    act_map = env.action_specs()                     # e.g. {"UP":0, "DOWN":1, ...}
    move_delta = {"UP": (-1, 0), "DOWN": (1, 0),
                  "LEFT": (0, -1), "RIGHT": (0, 1)}

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action *names* moving the agent
    # from `start` to a cell that is adjacent (Chebyshev distance ≤ 1)
    # to any cell in `targets`.  Traverses only empty cells.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start: tuple[int, int],
                        targets: list[tuple[int, int]],
                        grid: np.ndarray) -> list[str] | None:
        W, H = grid.shape[:2]
        visited: set[tuple[int, int]] = set()
        q: deque[tuple[tuple[int, int], list[str]]] = deque()
        q.append((start, []))
        visited.add(start)
        target_set = set(targets)

        while q:
            pos, path = q.popleft()
            # Check adjacency to any target cell
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path
            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                    # Walk only through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    # ------------------------------------------------------------------
    # Identify the goal and its recipe
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    actions: list[int] = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives (respecting counts)
    # ------------------------------------------------------------------
    while True:
        state = env._current_state
        inventory = state.inventory
        # Check if we already have everything we need
        if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):
            break

        # Find a primitive that is still lacking
        missing = [(p_idx, cnt - inventory[p_idx])
                   for p_idx, cnt in needed_prims.items()
                   if inventory[p_idx] < cnt]
        # Choose the first missing primitive
        prim_idx, _ = missing[0]

        # Locate all cells currently holding this primitive
        prim_cells = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
        if not prim_cells:
            raise RuntimeError(f"Required primitive {prim_idx} not found on the map.")

        # Plan a path to an adjacent cell of the nearest primitive
        path = bfs_to_adjacent(state.pos, prim_cells, state.grid)
        if path is None:
            raise RuntimeError(f"Primitive {prim_idx} is unreachable from position {state.pos}.")

        # Execute movement actions
        for act_name in path:
            act_id = act_map[act_name]
            actions.append(act_id)
            env.step(act_id)

        # Pick up the primitive with the USE action
        use_id = act_map["USE"]
        actions.append(use_id)
        env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Workshop required for crafting not found on the map.")
        path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")
        for act_name in path:
            act_id = act_map[act_name]
            actions.append(act_id)
            env.step(act_id)

    # Final USE to craft (or to pick up if no workshop is needed)
    actions.append(act_map["USE"])
    env.step(act_map["USE"])

    return actions

