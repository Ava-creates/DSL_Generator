    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action / direction helpers
    # ----------------------------------------------------------------------
    # Action indices as defined by CraftLab.
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    # Mapping movement vectors (dx, dy) → action index.
    DIR2ACT = {
        (0, 1): ACTION_DOWN,   # y+ (down)
        (0, -1): ACTION_UP,    # y- (up)
        (-1, 0): ACTION_LEFT,  # x- (left)
        (1, 0): ACTION_RIGHT,  # x+ (right)
    }
    # Reverse mapping for updating simulated position.
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search returning a list of actions that moves the agent
    # from ``start`` to a cell adjacent to any cell in ``targets``.
    # ----------------------------------------------------------------------
    def bfs(start, targets, grid):
        """
        Parameters
        ----------
        start : tuple (x, y)
            Current agent position.
        targets : list of (x, y)
            Cells we want to become adjacent to.
        grid : np.ndarray (H, W, K)
            Current world grid. Any non‑zero entry in the last axis counts as
            an obstacle for movement.

        Returns
        -------
        list[int]
            Sequence of action indices that brings the agent adjacent to a
            target cell. May be empty if already adjacent or if no path exists.
        """
        H, W = grid.shape[:2]
        # Cells occupied by any entity are blocked.
        blocked = np.any(grid > 0, axis=2)

        sx, sy = start
        # Quick check: already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((H, W), False, dtype=bool)
        visited[sy, sx] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:
                    if blocked[ny, nx]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[ny, nx] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    # Current state (the environment holds a CraftLab wrapper around a CraftState).
    state = env._current_state
    grid = state.grid.copy()               # mutable copy of the world grid
    pos = tuple(state.pos)                 # (x, y)

    # Goal item index (the task stores a ``goal`` attribute – may be an int or a struct).
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal not found in env.task")

    # ------------------------------------------------------------------
    # 1. Determine which primitive resources are needed to craft the goal.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []  # final list of actions to return

    # ------------------------------------------------------------------
    # 2. Collect each primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        while needed > 0:
            # Locate all cells that currently contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present – cannot continue planning.
                return plan

            # Find a path to the nearest primitive (adjacent cell).
            path = bfs(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Simulate the movement so that ``pos`` stays in sync.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use (collect) the primitive.
            plan.append(ACTION_USE)

            # Determine which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update our local grid copy (remove one instance) and decrement counter.
            grid[adj_cell[1], adj_cell[0], prim_idx] -= 1
            needed -= 1

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft (use) at the workshop.
            plan.append(ACTION_USE)

    return plan


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helper: BFS to a cell adjacent to any target cell
    # ----------------------------------------------------------------------
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs(start, targets, grid):
        """Return a list of actions moving from ``start`` to a position
        adjacent (Manhattan distance 1) to any cell in ``targets``.
        ``grid`` is (H, W, K); any non‑zero entry in the last axis is
        considered blocked for movement.
        """
        H, W = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)

        sx, sy = start
        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((H, W), False, dtype=bool)
        visited[sy, sx] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:
                    if blocked[ny, nx]:
                        continue
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[ny, nx] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)          # (x, y)

    # Goal index from the task.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # Primitive requirements for the goal (flattened to primitives only).
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, count_needed in primitives_needed.items():
        while count_needed > 0:
            # Locate cells that still contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more of this primitive on the map – abort planning.
                return plan

            # Find a path to the nearest reachable primitive (adjacent).
            path = bfs(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to update ``pos``.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Perform USE to pick up the primitive.
            plan.append(4)   # USE action

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Should not happen; break to avoid infinite loop.
                break

            # Update local grid copy (remove one instance) and decrement need.
            grid[adj_cell[1], adj_cell[0], prim_idx] -= 1
            count_needed -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be string name or int).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft by using the workshop.
            plan.append(4)   # USE action

    return plan

