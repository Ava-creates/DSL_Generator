    actions = []

    def bfs_path(start, target):
        """Return a list of actions to move from start to target avoiding occupied cells."""
        w, h = grid.shape[:2]
        occupied = np.any(grid > 0, axis=2)
        occupied[target[0], target[1]] = False  # target cell is allowed

        q = collections.deque([start])
        parent = {start: None}
        act_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        seq = []
        cur = target
        while cur != start:
            seq.append(act_to[cur])
            cur = parent[cur]
        seq.reverse()
        return seq

    def move_to(tgt):
        nonlocal pos
        if pos == tgt:
            return
        path = bfs_path(pos, tgt)
        if path is None:
            # fallback simple Manhattan moves (ignores obstacles)
            dx = tgt[0] - pos[0]
            dy = tgt[1] - pos[1]
            path = []
            if dx > 0:
                path.extend([DOWN] * dx)
            elif dx < 0:
                path.extend([UP] * (-dx))
            if dy > 0:
                path.extend([RIGHT] * dy)
            elif dy < 0:
                path.extend([LEFT] * (-dy))
        actions.extend(path)
        pos = tgt

    # Collect required primitives
    for kind_idx, cnt_needed in needed.items():
        have = int(inventory[kind_idx])
        to_collect = max(0, cnt_needed - have)
        for _ in range(to_collect):
            locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))
            if not locations:
                break
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            move_to(target)
            actions.append(USE)
            grid[target[0], target[1], kind_idx] = 0
