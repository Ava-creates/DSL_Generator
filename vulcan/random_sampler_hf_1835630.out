    # Action identifiers.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions taking the
    # agent from `start` to a cell adjacent to any cell in `targets`.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # blocked cells
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent (or on) a target?
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable path.
        return []

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive, greedily taking the nearest one.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
