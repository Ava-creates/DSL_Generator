    frontier = deque([Node(start_state, [])])
    visited = {_state_key(start_state)}
    MAX_PLAN_LEN = 600                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # typically 5 (4 moves + USE)

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: have an arrow in inventory
        if cur_state.satisfies("", target_idx):
            return cur_actions

        if len(cur_actions) >= MAX_PLAN_LEN:
            continue

        # Expand all possible actions
