    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    # ----------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of action indices
    # ----------------------------------------------------------------------
    def bfs(start, targets, blocked):
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # should not happen in valid scenarios

    # ----------------------------------------------------------------------
    # Helper: move to a cell containing a given kind and USE it `cnt` times
    # ----------------------------------------------------------------------
    def acquire(kind_idx, cnt):
        nonlocal pos, actions
        for _ in range(cnt):
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)   # USE to pick up

    # ----------------------------------------------------------------------
    # Gather world / recipe information
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    # ----------------------------------------------------------------------
    # Resolve full crafting plan: primitives needed + ordered craft steps
    # ----------------------------------------------------------------------
    needed_prims = {}          # primitive idx → total count
    craft_steps = []           # (item_idx, count) in dependency order

    def resolve(item_idx, mul):
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul
            return
        # first resolve ingredients (ignore special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mul)
        # schedule this item to be crafted after its ingredients
        craft_steps.append((item_idx, mul))

    resolve(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # Prepare static data: grid, blocked cells, dimensions
    # ----------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Build action sequence
    # ----------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Collect all primitive resources
    for kind, cnt in needed_prims.items():
        acquire(kind, cnt)

    # 2) Perform crafting steps at required workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * cnt)   # USE at workshop

    return actions


    import collections
    import numpy as np

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) from start to
    # any cell in `targets`, avoiding cells marked as blocked.
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # actions: 0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT

    def bfs(start, targets, blocked):
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # If we get here the target is unreachable; return empty list.
        return []

    # ----------------------------------------------------------------------
    # Helper: move to a cell that currently contains `kind_idx` and USE it
    # `cnt` times (collect primitive or craft at a workshop).
    # ----------------------------------------------------------------------
    def acquire(kind_idx, cnt):
        nonlocal pos, actions
        for _ in range(cnt):
            # recompute set of cells that still contain the required kind
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            if not cells:
                # nothing left of this kind – break early
                break
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)   # USE

    # ----------------------------------------------------------------------
    # Gather world / recipe information
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    # ----------------------------------------------------------------------
    # Resolve full list of primitive requirements and ordered crafting steps.
    # `needed_prims` maps primitive kind -> total count.
    # `craft_steps` is a list of (item_idx, count) in dependency order.
    # ----------------------------------------------------------------------
    needed_prims = {}
    craft_steps = []

    def resolve(item_idx, mult):
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # Resolve all ingredient items first (ignore special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # After ingredients, schedule this item to be crafted
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # Static data: current grid, blocked cells, dimensions
    # ----------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Build the action sequence
    # ----------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Collect every required primitive resource
    for prim_idx, qty in needed_prims.items():
        acquire(prim_idx, qty)

    # 2) Perform the crafting steps at their respective workshops
    for item_idx, qty in craft_steps:
        rec = cookbook.recipes[item_idx]
        # workshop key can be stored under "_at" or legacy "_key"
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        # locate any workshop cell of the required type
        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * qty)   # USE at workshop the needed number of times

    return actions

