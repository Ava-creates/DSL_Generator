            actions.extend(best_seq)
            cur_pos = best_adj
            dy = best_target[0] - cur_pos[0]
            dx = best_target[1] - cur_pos[1]
            if dy > 0:
                actions.append(DOWN)
            elif dy < 0:
                actions.append(UP)
            elif dx > 0:
                actions.append(RIGHT)
            elif dx < 0:
                actions.append(LEFT)
            actions.append(USE)
            grid[best_target[0], best_target[1], prim_idx] = 0

    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cells = positions_of(ws_idx)
        if ws_cells:
            ws_target = min(ws_cells, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            ws_path = bfs(cur_pos, ws_target)
            if ws_path is not None:
                actions.extend(ws_path)
                cur_pos = ws_target

    actions.append(USE)
    return actions

