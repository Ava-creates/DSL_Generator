    # Reset the environment to obtain the initial observation.
    obs = env.reset()

    # Access world and cookbook objects.
    world = env.world
    cookbook = world.cookbook

    # Determine the goal item name from the task description.
    task_name = obs.get("task_name", "")
    if "[" in task_name and "]" in task_name:
        goal_name = task_name.split("[")[1].split("]")[0]
    else:
        goal_name = task_name

    # Resolve the goal index using the cookbook's name→index mapping.
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for the goal (primitive_index → count).
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Retrieve the recipe for the goal to find the required workshop.
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name is not None:
        workshop_idx = cookbook.index[workshop_name]

    # Helper to locate all positions of a given kind in the global grid.
    def get_positions(kind):
        grid = obs["features_dict"]["features_global"]
        xs, ys = np.where(grid[:, :, kind] == 1)
        return list(zip(xs.tolist(), ys.tolist()))

    # Current agent position (convert normalized coordinates to grid indices).
    pos_norm = obs["features_dict"]["pos"]
    width, height = obs["features_dict"]["features_global"].shape[:2]
    cur_pos = (
        int(round(pos_norm[0] * (width - 1))),
        int(round(pos_norm[1] * (height - 1))),
    )

    actions = []

    # Simple Manhattan movement helper (updates cur_pos).
    def move_to(target):
        nonlocal cur_pos, actions
        tx, ty = target
        while cur_pos[0] < tx:
            actions.append(3)  # RIGHT
            cur_pos = (cur_pos[0] + 1, cur_pos[1])
        while cur_pos[0] > tx:
            actions.append(2)  # LEFT
            cur_pos = (cur_pos[0] - 1, cur_pos[1])
        while cur_pos[1] < ty:
            actions.append(0)  # DOWN
            cur_pos = (cur_pos[0], cur_pos[1] + 1)
        while cur_pos[1] > ty:
            actions.append(1)  # UP
            cur_pos = (cur_pos[0], cur_pos[1] - 1)

    # Collect each required primitive.
    for prim_idx, needed in primitives_needed.items():
        positions = get_positions(prim_idx)
        # Use the first `needed` instances found.
        for i in range(min(needed, len(positions))):
            px, py = positions[i]

            # Choose a neighbouring cell to stand on (prefer left, then right, then up, then down).
            if px > 0:
                adj = (px - 1, py)
            elif px < width - 1:
                adj = (px + 1, py)
            elif py > 0:
                adj = (px, py - 1)
            else:
                adj = (px, py + 1)

            move_to(adj)
            actions.append(4)  # USE to pick up the primitive.

    # Move to the appropriate workshop and craft the goal item.
    if workshop_idx is not None:
        wk_positions = get_positions(workshop_idx)
        if wk_positions:
            wx, wy = wk_positions[0]
            # Stand next to the workshop (prefer left side if possible).
            if wx > 0:
                adj_w = (wx - 1, wy)
            else:
                adj_w = (wx + 1, wy)
            move_to(adj_w)
            actions.append(4)  # USE to craft the item.

    return actions

