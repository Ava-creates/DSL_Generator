        workshop_pos = tuple(ws_positions[0].tolist())
        move_to(workshop_pos)
        _, _ = env.step(4)  # USE to craft
        actions.append(4)

    return actions


def make_arrow_vn(env):
    """
    Simple planner that repeatedly tries to use (craft/collect) the
    item in front of the agent and moves around the map in a fixed
    pattern until an ``arrow`` appears in the inventory.

    The function works with a ``CraftLab`` environment instance.
    """
    actions = []
    # index of the target item
    try:
        goal_idx = env.world.cookbook.index["arrow"]
    except Exception:
        # fallback: if the index mapping is not directly accessible,
        # try to obtain it from the underlying CraftWorld.
        goal_idx = env._current_state.world.cookbook.index["arrow"]

    # safety limit to avoid infinite loops
    MAX_STEPS = 2000
    step_counter = 0

    while step_counter < MAX_STEPS:
        # check if goal already achieved
        if env._current_state.inventory[goal_idx] > 0:
            break

        # 1. try to use the cell in front (collect / craft)
        actions.append(4)            # 4 == USE
        env.step(4)                  # ignore returned values
        step_counter += 1

        # 2. move in a simple deterministic pattern (right, down, left, up)
        move_action = step_counter % 4   # cycles through 0‑3
        actions.append(move_action)
        env.step(move_action)
        step_counter += 1

    return actions

