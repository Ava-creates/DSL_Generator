    import collections
    from collections import deque, namedtuple

    # Get the scenario and world objects from the environment (CraftLab or raw scenario)
    scenario = getattr(env, "scenario", None) or env
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # Index of the target item "arrow" in the cookbook
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # Helper to create a hashable representation of a state for visited‑set tracking
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    Node = namedtuple("Node", ["state", "actions"])
    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    # Search parameters
    MAX_STEPS = 500                     # safety limit on plan length
    n_actions = getattr(world, "n_actions", 5)   # typical actions: 0‑4 (UP/DOWN/LEFT/RIGHT/USE)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long candidate plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    # No plan found within the search budget
    return []


    import collections

    # Obtain scenario and world objects
    scenario = getattr(env, "scenario", None) or env
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting state
    try:
        start_state = scenario.init()
    except Exception:
        return []

    # Helper to create a hashable representation of a state
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    Node = collections.namedtuple("Node", ["state", "actions"])
    visited = {_state_hash(start_state)}
    frontier = collections.deque([Node(start_state, [])])

    MAX_STEPS = 300                     # safety limit on plan length
    n_actions = getattr(world, "n_actions", 5)   # typical actions: 0‑4

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    # No plan found within the limits
    return []

