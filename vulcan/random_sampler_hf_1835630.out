    # implementation...


    # --------------------------------------------------------------
    # Setup and helper definitions
    # --------------------------------------------------------------
    import numpy as np
    from collections import deque

    # Action indices as defined in CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # BFS that returns a list of movement actions (0‑3) from start to the
    # nearest cell in *goals*. Cells that contain any entity are treated as
    # blocked unless they are one of the goal cells.
    # ------------------------------------------------------------------
    def _bfs(start, goals, grid):
        width, height = grid.shape[:2]
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in goals:
                return path
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow stepping onto a goal cell even if occupied.
                if np.any(grid[nx, ny, :]) and (nx, ny) not in goals:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        return None

    # ------------------------------------------------------------------
    # Apply a sequence of movement actions to update the current position.
    # ------------------------------------------------------------------
    def _apply_path(path, pos):
        x, y = pos
        for a in path:
            if a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
            elif a == LEFT:
                x -= 1
            elif a == RIGHT:
                x += 1
        return (x, y)

    # --------------------------------------------------------------
    # Access the current world, state and cookbook.
    # --------------------------------------------------------------
    world = env.world
    state = env._current_state
    cookbook = world.cookbook

    # --------------------------------------------------------------
    # Identify the goal item ("arrow") and its recipe.
    # --------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    recipe = cookbook.recipes.get(goal_idx, {})

    # --------------------------------------------------------------
    # Determine primitive requirements for the goal.
    # --------------------------------------------------------------
    primitive_requirements = cookbook.primitives_for(goal_idx)

    # --------------------------------------------------------------
    # Work on a copy of the grid so we can simulate pickups.
    # --------------------------------------------------------------
    grid = state.grid.copy()
    pos = tuple(state.pos)          # current agent position (x, y)
    actions = []                    # planned action sequence

    # --------------------------------------------------------------
    # Helper: collect a given primitive until the needed amount is met.
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        while needed > 0:
            # Locate all cells that still contain this primitive.
            locations = [(x, y) for x in range(grid.shape[0])
                         for y in range(grid.shape[1])
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                # No more instances on the map – abort collection.
                break

            # Choose the nearest location (Manhattan distance) as a heuristic.
            dists = [abs(x - pos[0]) + abs(y - pos[1]) for (x, y) in locations]
            target = locations[int(np.argmin(dists))]

            # Find a path to the target cell.
            path = _bfs(pos, {target}, grid)
            if path is None:
                # Unreachable – remove this cell from future consideration.
                locations.remove(target)
                continue

            # Append movement actions and update position.
            actions.extend(path)
            pos = _apply_path(path, pos)

            # Use action to pick up the primitive (may need multiple USEs if count >1).
            available = int(grid[target[0], target[1], prim_idx])
            take = min(available, needed)
            for _ in range(take):
                actions.append(USE)

            # Update simulated grid and remaining need.
            grid[target[0], target[1], prim_idx] -= take
            needed -= take

    # --------------------------------------------------------------
    # After gathering all primitives, go to the appropriate workshop
    # (if any) and craft the arrow.
    # --------------------------------------------------------------
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        # Resolve workshop index (could be a string name or already an int).
        if isinstance(workshop_name, int):
            workshop_idx = workshop_name
        else:
            workshop_idx = cookbook.index[workshop_name]

        # Locate workshop cells.
        workshop_cells = [(x, y) for x in range(grid.shape[0])
                          for y in range(grid.shape[1])
                          if grid[x, y, workshop_idx] > 0]

        if workshop_cells:
            # Choose the nearest workshop cell.
            dists = [abs(x - pos[0]) + abs(y - pos[1]) for (x, y) in workshop_cells]
            ws_target = workshop_cells[int(np.argmin(dists))]

            # Move to the workshop.
            path = _bfs(pos, {ws_target}, grid)
            if path is not None:
                actions.extend(path)
                pos = _apply_path(path, pos)

    # Final USE to perform the crafting at the workshop (or in place).
    actions.append(USE)

    return actions

