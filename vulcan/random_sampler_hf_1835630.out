    def _move_to(pos, tgt, seq):
        """Append actions to move from pos to tgt (both [x, y] lists)."""
        while pos[0] != tgt[0] or pos[1] != tgt[1]:
            if pos[0] < tgt[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > tgt[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < tgt[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > tgt[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos, g):
        """Return [x, y] of the nearest cell containing kind_idx, or None."""
        ys, xs = np.where(g[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

