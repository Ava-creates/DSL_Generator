    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Possible moves with associated action IDs
    _MOVES = [((0, 1), DOWN),   # down (y+1)
              ((0, -1), UP),   # up   (y-1)
              ((-1, 0), LEFT), # left (x-1)
              ((1, 0), RIGHT)] # right(x+1)

    def _bfs_path(start, goal, grid):
        """Return a list of actions moving from start to goal using BFS.
        Cells that contain any entity are blocked, except the goal cell itself."""
        from collections import deque

        w, h = grid.shape[0], grid.shape[1]
        start = tuple(start)
        goal = tuple(goal)
        q = deque([start])
        # maps position -> (prev_position, action_taken_to_reach)
        prev = {start: (None, None)}

        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for (dx, dy), act in _MOVES:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # Allow stepping onto the goal even if occupied
                if (nx, ny) != goal and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if goal not in prev:
            # No path found
            return []

        # Reconstruct actions backwards
        actions = []
        cur = goal
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            actions.append(act)
        actions.reverse()
        return actions

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell (Manhattan) that contains the given kind.
        Returns [x, y] or None if not present."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Planning starts here
    # ------------------------------------------------------------------
    actions = []

    # Determine current position (live state if available, else initial)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the static grid for planning purposes
    grid = env.scenario.init_grid.copy()

    # Goal item index
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal
    # ------------------------------------------------------------------
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, needed in primitive_requirements.items():
        for _ in range(needed):
            target = _nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Required primitive not found – abort planning
                return actions
            # Move to the primitive
            actions.extend(_bfs_path(cur_pos, target, grid))
            # Pick it up
            actions.append(USE)
            # Update simulated grid and position
            grid[target[0], target[1], prim_kind] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(_bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)   # perform crafting at the workshop
            cur_pos = workshop_pos

    # Return the complete action sequence
    return actions


