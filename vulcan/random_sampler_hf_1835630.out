    # code...


    import collections, numpy as np

    # Action indices as defined by the environment
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to any cell in `targets`.  Cells that contain any entity are
    # treated as blocked (except the target cells themselves).
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, occupied):
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            if (x, y) in target_set:
                return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    # allow stepping onto a target even if it is currently occupied
                    if not occupied[nx, ny] or (nx, ny) in target_set:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No path found – return empty list (the caller will fail later)
        return []

    # ------------------------------------------------------------------
    # Identify world, cookbook and the hard‑coded goal "arrow".
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers keep the world inside the current state.
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = state_tmp.world
    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary) and fetch grid.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state
    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()              # mutable copy of the world grid
    occupied = np.any(grid, axis=2)       # bool mask of occupied cells

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive, greedily taking the nearest one
    # that is still available.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        gathered = 0
        while gathered < needed:
            # Locations that still contain this primitive.
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                raise RuntimeError(f"Not enough of primitive {prim_idx} to craft arrow")
            # Choose the nearest location.
            locations.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = locations[0]

            # Move to the target cell.
            path = _bfs_path(pos, [target], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick up the primitive.
            actions.append(USE)
            # Simulate the pickup in our local copy.
            grid[target[0], target[1], prim_idx] = 0
            occupied[target[0], target[1]] = False
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).  If the
    # recipe does not specify a workshop we simply issue a USE action
    # at the current location.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else workshop_key)
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = ws_cells[0]
            path = _bfs_path(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
        else:
            # No workshop cell found – fall back to using current position.
            actions.append(USE)
    else:
        # Recipe does not require a specific workshop.
        actions.append(USE)

    return actions

