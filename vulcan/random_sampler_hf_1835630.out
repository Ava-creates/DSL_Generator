    state = env._current_state
    world = env.world
    cookbook = world.cookbook
    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return a list of actions that moves from start to any cell in goals."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # allow stepping onto a goal even if occupied
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update simulated position after following a list of actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(p_idx, needed):
        """Collect `needed` units of a primitive from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, p_idx] > 0]
            if not locations:
                raise RuntimeError("Required primitive not found on map")
            best_path = None
            best_loc = None
            for loc in locations:
                path = bfs(pos, {loc})
                if path is not None:
                    best_path = path
                    best_loc = loc
                    break
            if best_path is None:
                raise RuntimeError("No reachable primitive found")
            actions.extend(best_path)
            move_along(best_path)
            actions.append(4)          # USE to pick up
            grid[best_loc[0], best_loc[1], p_idx] = 0
            inventory[p_idx] += 1
            needed -= 1

    recipes = cookbook.recipes
    primitives = cookbook.primitives

    def ensure(item_idx, amount):
        """Make sure `inventory[item_idx]` >= amount by collecting/crafting."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            # first, guarantee all ingredients
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure(ing_idx, cnt)

            # move to required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if not ws_cells:
                    raise RuntimeError("Required workshop not present on map")
                path = bfs(pos, {ws_cells[0]})
                if path is None:
                    raise RuntimeError("Cannot reach required workshop")
                actions.extend(path)
                move_along(path)

            # perform the craft action
            actions.append(4)  # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    ensure(target_idx, 1)
    return actions


