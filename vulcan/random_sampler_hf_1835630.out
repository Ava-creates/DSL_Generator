    """Generate a sequence of actions that makes an ``arrow`` in the given CraftWorld env.
    
    The implementation performs a breadth‑first search over the deterministic
    ``CraftState`` dynamics until the inventory contains at least one ``arrow``.
    It works for any environment that follows the interface described in the
    provided code base.
    
    Args:
        env: Either a ``CraftLab`` instance or a raw ``CraftScenario``/``CraftWorld``.
    
    Returns:
        List[int]: Action indices (0‑4) that achieve the goal, or an empty list if
        no plan is found within the search limits.
    """
    # -------------------------------------------------------------------------
    # Resolve the underlying scenario and world objects from the possibly wrapped
    # environment instance.
    # -------------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # -------------------------------------------------------------------------
    # Identify the index of the target item ``arrow`` using the cookbook.
    # -------------------------------------------------------------------------
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        # The recipe set does not contain an arrow; nothing to do.
        return []

    # -------------------------------------------------------------------------
    # Obtain the initial state of the episode.
    # -------------------------------------------------------------------------
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # -------------------------------------------------------------------------
    # Helper to produce a hashable representation of a state.  The grid can be
    # large, but ``tobytes`` provides a compact immutable view suitable for a set.
    # -------------------------------------------------------------------------
    def _hash_state(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # -------------------------------------------------------------------------
    # Breadth‑first search over the deterministic transition graph.
    # -------------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])
    frontier = deque([Node(init_state, [])])
    visited = {_hash_state(init_state)}

    # Safety limits – these can be tuned for larger maps.
    MAX_STEPS = 400          # maximum length of a candidate plan
    MAX_EXPANSIONS = 10000   # total number of states examined

    n_actions = getattr(world, "n_actions", 5)  # usually 5 (4 moves + USE)
    expansions = 0

    while frontier and expansions < MAX_EXPANSIONS:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: does the inventory contain the arrow?
        if cur_state.satisfies("", target_idx):
            return cur_actions

        if len(cur_actions) >= MAX_STEPS:
            continue  # prune overly long branches

        # Expand all possible actions.
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _hash_state(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, cur_actions + [a]))
        expansions += 1

    # No viable plan found within the limits.
    return []

