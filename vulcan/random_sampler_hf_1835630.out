                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    def _apply(pos, actions):
        """Apply a list of actions to a position and return the new position."""
        x, y = pos
        for a in actions:
            if a == RIGHT:
