        while parent[cur][0] is not None:
            prev, act = parent[cur]
            actions_rev.append(act)
            cur = prev
        actions_rev.reverse()
        return actions_rev

    def turn_towards(src, dst):
        """Return a single turn action that makes `src` face `dst`
        (must be orthogonal). Returns None if same cell or not orthogonal."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing an entity of `kind_idx`."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
