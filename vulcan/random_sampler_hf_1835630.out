    # Action indices: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    ACTION_USE = 4

    def bfs(start, targets, blocked):
        """Bread‑first search returning a list of action indices that reaches any cell in *targets*."""
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable in well‑formed scenarios

    def go_to_kind(kind_idx, times):
        """Move to a cell containing *kind_idx* and press USE *times*."""
        nonlocal pos, actions
        for _ in range(times):
            cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 1) Extract recipe information for the goal item "arrow"
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    target_idx = cookbook.index["arrow"]

    primitive_needs = {}          # primitive kind → total count required
    craft_sequence = []           # (item_idx, count) in order of crafting

    def resolve(item_idx, mult):
        """Recursively collect primitive requirements and schedule crafts."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:  # primitive (no recipe entry)
            primitive_needs[item_idx] = primitive_needs.get(item_idx, 0) + mult
            return
        for ing, cnt in rec.items():
            if isinstance(ing, int):          # ignore special keys like "_at"
                resolve(ing, cnt * mult)
        craft_sequence.append((item_idx, mult))

    resolve(target_idx, 1)

    # ------------------------------------------------------------------
    # 2) Static environment data
    # ------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ------------------------------------------------------------------
    # 3) Build the action list
    # ------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 3a) Gather all required primitive resources
    for kind_idx, cnt in primitive_needs.items():
        go_to_kind(kind_idx, cnt)

    # 3b) Perform the crafting steps at their respective workshops
    for item_idx, cnt in craft_sequence:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([ACTION_USE] * cnt)

    return actions


    # Directions: DOWN, UP, LEFT, RIGHT
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    ACTION_USE = 4

    # ------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of action indices that
    # reaches any cell in `targets` while avoiding cells marked in `blocked`.
    # ------------------------------------------------------------------
    def bfs(start, targets, blocked):
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # No reachable target – should not happen in valid scenarios
        return []

    # ------------------------------------------------------------------
    # Helper: move to a cell containing `kind_idx` and perform the USE
    # action `count` times (collecting primitives or using a workshop).
    # ------------------------------------------------------------------
    def go_to_kind(kind_idx, count):
        nonlocal pos, actions
        for _ in range(count):
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 1) Gather recipe information for the target item "arrow"
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}          # primitive kind -> total count required
    craft_steps = []           # ordered list of (item_idx, count) to craft

    def resolve(item_idx, mult):
        """Recursively collect primitive requirements and schedule crafting."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe entry)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # Resolve ingredient items first (ignore special keys like "_at" or "_key")
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # Schedule this item to be crafted after its ingredients are ready
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ------------------------------------------------------------------
    # 2) Static environment data: grid, blocked cells, dimensions
    # ------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ------------------------------------------------------------------
    # 3) Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 3a) Collect all required primitive resources
    for kind_idx, cnt in needed_prims.items():
        go_to_kind(kind_idx, cnt)

    # 3b) Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        # Locate any workshop cell of the required type
        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        # Use the workshop the necessary number of times to craft the item
        actions.extend([ACTION_USE] * cnt)

    return actions

