    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from
        `start` to `goal` while avoiding non‑grabbable cells."""
        if start == goal:
            return []
        from collections import deque
        queue = deque([start])
        parent = {start: (None, None)}   # pos -> (prev_pos, action)

        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            y, x = cur
            for (dy, dx), act in [((-1, 0), UP), ((1, 0), DOWN),
                                  ((0, -1), LEFT), ((0, 1), RIGHT)]:
                ny, nx = y + dy, x + dx
                nxt = (ny, nx)
                if not is_free(nxt):
                    continue
                if nxt not in parent:
                    parent[nxt] = (cur, act)
                    queue.append(nxt)

        if goal not in parent:
            return []   # unreachable

        # reconstruct actions
        actions_rev = []
        cur = goal
        while parent[cur][0] is not None:
            prev, act = parent[cur]
            actions_rev.append(act)
            cur = prev
        actions_rev.reverse()
