    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Action → (dx, dy) mapping (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def walkable(grid, x, y):
        """True if (x,y) is inside the grid and contains no entities."""
        W, H = grid.shape[:2]
        if not (0 <= x < W and 0 <= y < H):
            return False
        return not np.any(grid[x, y, :])

    def target_ahead(cur_state, kind):
        """Check whether the cell directly in front of the agent contains `kind`."""
        x, y = cur_state.pos
        d = cur_state.dir
        dx, dy = deltas[d]
        fx, fy = x + dx, y + dy
        W, H = cur_state.grid.shape[:2]
        return (0 <= fx < W and 0 <= fy < H and cur_state.grid[fx, fy, kind] > 0)

    def bfs_to_target(cur_state, target_kind):
        """
        BFS that returns a list of movement actions (0‑3) which ends with the
        agent facing a cell that contains `target_kind`. Returns [] if already
        facing the target, or None if the target cannot be reached.
        """
        grid = cur_state.grid
        W, H = grid.shape[:2]
        sx, sy = cur_state.pos
        sdir = cur_state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
                return acts  # already facing the target

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return None  # unreachable

    actions = []

    # ------------------------------------------------------------------
    # 1) Gather all primitive resources needed for a single arrow.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    if not primitive_needs:
        # Arrow itself is a primitive; just need to pick it up.
        primitive_needs = {arrow_idx: 1}

    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            # Move to a cell where the primitive is directly in front.
            move_seq = bfs_to_target(state, prim_idx)
            if move_seq is None:
                # Unreachable primitive – abort planning.
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up

            # Simulate the actions to keep `state` up‑to‑date.
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(state, workshop_idx)
        if move_seq is None:
            # Unreachable workshop – abort planning.
            return actions
        actions.extend(move_seq)
        actions.append(4)  # USE to craft

        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop; craft in place.
        actions.append(4)
        _, state = state.step(4)

    return actions


    # Reset the environment and fetch the initial state and world objects
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:  # arrow not defined in this world
        return []

    # ------------------------------------------------------------------
    # Helper structures and functions
    # ------------------------------------------------------------------
    # Action → (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def in_bounds(x, y, W, H):
        return 0 <= x < W and 0 <= y < H

    def walkable(grid, x, y):
        W, H = grid.shape[:2]
        return in_bounds(x, y, W, H) and not np.any(grid[x, y, :])

    from collections import deque

    def bfs_to_target(cur_state, target_kind):
        """Return a list of movement actions (0‑3) that makes the agent
        face a cell containing `target_kind`.  Returns None if unreachable."""
        grid = cur_state.grid
        W, H = grid.shape[:2]
        sx, sy = cur_state.pos
        sdir = cur_state.dir
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}
        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy, W, H) and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return None

    # ------------------------------------------------------------------
    # 1) Gather all primitive resources needed for a single arrow
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    if not needed:  # arrow itself is primitive
        needed = {arrow_idx: 1}

    plan = []

    for kind_idx, count in needed.items():
        for _ in range(count):
            move_seq = bfs_to_target(state, kind_idx)
            if move_seq is None:          # unreachable primitive → abort planning
                return plan
            plan.extend(move_seq)
            plan.append(4)                # USE to pick up
            # Simulate the actions so that `state` stays up‑to‑date
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(state, workshop_idx)
        if move_seq is None:              # unreachable workshop → abort
            return plan
        plan.extend(move_seq)
        plan.append(4)                    # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop; craft in place
        plan.append(4)
        _, state = state.step(4)

