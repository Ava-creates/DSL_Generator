    # Reset environment and get mapping from action names to indices
    env.reset()
    act_map = env.action_specs()

    # Cardinal movement deltas (grid indexed as (x, y))
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    from collections import deque
    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action *names* moving the agent
    # from `start` to a cell that is adjacent (including diagonally) to
    # any cell in `targets`.  It only walks through empty cells.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, targets, grid):
        W, H = grid.shape[:2]
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)

        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # If we are adjacent (including diagonal) to any target cell,
            # we have reached a usable location.
            for tx, ty in target_set:
                if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:
                    return path

            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H:
                    # Only walk through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    # ------------------------------------------------------------------
    # Goal information
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Current state
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Locate all cells that currently contain the needed primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Primitive not present – skip this instance
                continue

            # Plan a path to an adjacent cell of the nearest primitive
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # Unreachable primitive – skip
                continue

            # Execute movement actions
            for act_name in path:
                a = act_map[act_name]
                actions.append(a)
                env.step(a)

            # Use action to pick up the primitive
            a = act_map["USE"]
            actions.append(a)
            env.step(a)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        # Refresh state after collecting primitives
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    a = act_map[act_name]
                    actions.append(a)
                    env.step(a)

            # Use action at the workshop to craft the item
            a = act_map["USE"]
            actions.append(a)
            env.step(a)

    # Return the complete action sequence
    return actions


    env.reset()
    # Map action names to their integer indices.
    act_map = env.action_specs()
    # Cardinal movement deltas.
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    from collections import deque
    actions = []

    def bfs_to_adjacent(start, targets, grid):
        """Return a list of action *names* moving the agent from `start`
        to a cell adjacent (including diagonally) to any cell in `targets`.
        The search only walks through empty cells (no entity present)."""
        W, H = grid.shape[:2]
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)

        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # If we are adjacent (including diagonal) to a target, stop.
            for tx, ty in target_set:
                if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:
                    return path

            # Expand neighbours.
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H:
                    # Walk only through empty cells.
                    if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell.

    # ------------------------------------------------------------------
    # Goal information.
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Locate all cells that currently contain this primitive.
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                continue  # Primitive not present; skip.

            # Plan a path to an adjacent cell of the nearest primitive.
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                continue  # Unreachable; skip.

            # Execute movement actions.
            for act_name in path:
                a = act_map[act_name]
                actions.append(a)
                env.step(a)

            # Use action to pick up the primitive.
            a = act_map["USE"]
            actions.append(a)
            env.step(a)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    a = act_map[act_name]
                    actions.append(a)
                    env.step(a)

            # Use action at the workshop to craft the item.
            a = act_map["USE"]
            actions.append(a)
            env.step(a)

    return actions

