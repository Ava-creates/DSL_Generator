            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (a blocked move updates direction).
            dy = ty - cur_pos[0]
            dx = tx - cur_pos[1]
            if dy > 0:
                actions.append(DOWN)
            elif dy < 0:
                actions.append(UP)
            elif dx > 0:
                actions.append(RIGHT)
            elif dx < 0:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions


    # ----------------------------------------------------------------------
    # Initialise environment and retrieve useful objects
    # ----------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)

    # Action indices (consistent with CraftLab.action_specs)
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    # Directions used for movement and BFS
    _DIRS = [
        (1, 0, DOWN),   # down
        (-1, 0, UP),    # up
        (0, -1, LEFT),  # left
        (0, 1, RIGHT),  # right
    ]

    def _blocked_cells():
        """Return a 2‑D bool array where True indicates a cell that cannot be walked through."""
        if not world.non_grabbable_indices:
            return np.zeros(grid.shape[:2], dtype=bool)
        idxs = list(world.non_grabbable_indices)
        return np.any(grid[:, :, idxs] > 0, axis=2)

    _blocked = _blocked_cells()

    def _bfs(start, goals, allow_goal_on_block=False):
        """
        Bread‑first search from ``start`` to any cell in ``goals``.
        Returns a list of actions (DOWN/UP/LEFT/RIGHT) that lead to the goal,
        or an empty list if no path is found.
        """
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        q = collections.deque()
        q.append((start, []))
        visited[start] = True
        goal_set = set(goals)

        while q:
            (y, x), path = q.popleft()
            if (y, x) in goal_set:
                return path
            for dy, dx, act in _DIRS:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # If the neighbour is blocked we may still enter it if it is the goal
                    if _blocked[ny, nx] and not (allow_goal_on_block and (ny, nx) in goal_set):
                        continue
                    visited[ny, nx] = True
                    q.append(((ny, nx), path + [act]))
        return []  # no path found

    def _nearest_primitive(kind, from_pos):
        """Find the coordinate of the closest cell containing ``kind``."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[dists.argmin()]
        return tuple(nearest)

    def _adjacent_free_cells(y, x):
        """Return a list of free neighbour coordinates around (y, x)."""
        H, W = grid.shape[:2]
        cells = []
        for dy, dx, _ in _DIRS:
            ny, nx = y + dy, x + dx
            if 0 <= ny < H and 0 <= nx < W and not _blocked[ny, nx]:
                cells.append((ny, nx))
        return cells

    # ----------------------------------------------------------------------
    # Determine the goal (arrow) and its primitive requirements
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ----------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            prim_loc = _nearest_primitive(prim_idx, cur_pos)
            if prim_loc is None:
                # Primitive not present – abort early.
                return actions
            py, px = prim_loc

            # Choose a free adjacent cell to stand on before using.
            free_adj = _adjacent_free_cells(py, px)
            if not free_adj:
                # No free neighbour; fall back to standing on the primitive cell itself.
                target_cell = (py, px)
                allow_block = True
            else:
                # Pick the adjacent cell with the shortest Manhattan distance.
                dists = [abs(py - cy) + abs(px - cx) for cy, cx in free_adj]
                target_cell = free_adj[int(np.argmin(dists))]
                allow_block = False

            # Move to the chosen cell.
            path = _bfs(cur_pos, [target_cell], allow_goal_on_block=allow_block)
            actions.extend(path)
            cur_pos = target_cell

            # Face the primitive (a movement action that will be blocked updates direction).
            dy, dx = py - cur_pos[0], px - cur_pos[1]
            if dy > 0:
                actions.append(DOWN)
            elif dy < 0:
                actions.append(UP)
            elif dx > 0:
                actions.append(RIGHT)
            elif dx < 0:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update the local grid copy so that the same primitive is not reused.
            grid[py, px, prim_idx] = 0
            # Re‑compute blocked cells after removal (primitives are grabbable, so they were already blocked).
            # No need to change _blocked because primitives are not in non_grabbable_indices.

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)
        if ws_locs.size > 0:
            # Choose the nearest workshop cell.
            dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])
            ws_y, ws_x = ws_locs[dists.argmin()]
            # Allow stepping onto the workshop cell even if it is marked as blocked.
            path = _bfs(cur_pos, [(ws_y, ws_x)], allow_goal_on_block=True)
            actions.extend(path)
            cur_pos = (ws_y, ws_x)

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions

