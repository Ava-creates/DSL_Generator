    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS path finder that treats any occupied cell as blocked,
    # except the goal cell itself (which may hold the target item).
    # ------------------------------------------------------------------
    moves = [((0, 1), DOWN),   # down  (y+1)
             ((0, -1), UP),    # up    (y-1)
             ((-1, 0), LEFT),  # left  (x-1)
             ((1, 0), RIGHT)]  # right (x+1)

    def bfs_path(start, goal, grid):
        """Return a list of actions moving from start to goal."""
        w, h = grid.shape[0], grid.shape[1]
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal cell even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []  # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell containing at least one instance of
    # the specified kind index.
    # ------------------------------------------------------------------
    def nearest_kind(kind_idx, cur_pos, grid):
        xs, ys = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Determine the agent's current position.
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the initial grid for planning.
    grid = env.scenario.init_grid.copy()

    actions = []
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the goal.
    # ------------------------------------------------------------------
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)
    # If the goal itself is a primitive, we also need to pick it up.
    if goal_idx in env.world.cookbook.primitives:
        primitive_requirements[goal_idx] = primitive_requirements.get(goal_idx, 0) + 1

    for prim_kind, needed in primitive_requirements.items():
        for _ in range(needed):
            target = nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Required primitive not found; abort planning.
                return actions
            actions.extend(bfs_path(cur_pos, target, grid))
            actions.append(USE)  # pick up the primitive
            # Mark the primitive as taken in the planning grid.
            grid[target[0], target[1], prim_kind] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)  # craft at the workshop
            cur_pos = workshop_pos
    else:
        # No specific workshop; craft at current location.
        actions.append(USE)

    return actions


    # action indices (same order as CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: Manhattan‑nearest cell that currently contains at least one
    # instance of the given kind (primitive or workshop). Returns [x, y] or
    # None if not present.
    # ------------------------------------------------------------------
    def _nearest_kind(kind_idx, cur_pos, grid):
        xs, ys = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Helper: BFS shortest path (in actions) from start to goal while
    # treating any occupied cell as blocked, except the goal cell itself.
    # ------------------------------------------------------------------
    from collections import deque
    _moves = [((0, 1), DOWN),   # down  (y+1)
              ((0, -1), UP),    # up    (y-1)
              ((-1, 0), LEFT),  # left  (x-1)
              ((1, 0), RIGHT)]  # right (x+1)

    def _bfs_path(start, goal, grid):
        w, h = grid.shape[0], grid.shape[1]

        start_t = tuple(start)
        goal_t = tuple(goal)
        if start_t == goal_t:
            return []

        q = deque([start_t])
        prev = {start_t: (None, None)}          # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if (x, y) == goal_t:
                break
            for (dx, dy), act in _moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                npos = (nx, ny)
                if npos in prev:
                    continue
                # allow stepping onto the goal cell even if occupied
                if npos != goal_t and grid[nx, ny].sum() != 0:
                    continue
                prev[npos] = ((x, y), act)
                q.append(npos)

        if goal_t not in prev:
            # unreachable – return empty path
            return []

        # reconstruct path
        path = []
        cur = goal_t
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Determine current position (use live state if available)
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the static grid for planning purposes.
    grid = env.scenario.init_grid.copy()

    actions = []
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal.
    # ------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx)
    for prim_kind, count in primitive_needs.items():
        for _ in range(count):
            target = _nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive missing – abort planning and return what we have.
                return actions
            # move to the primitive
            actions.extend(_bfs_path(cur_pos, target, grid))
            # pick it up
            actions.append(USE)
            # update planning grid and current position
            grid[target[0], target[1], prim_kind] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Craft the goal item at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(_bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)               # craft at the workshop
            cur_pos = workshop_pos
    else:
        # No specific workshop – craft in place.
        actions.append(USE)

    return actions

