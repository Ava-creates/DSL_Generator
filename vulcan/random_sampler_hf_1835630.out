        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Get initial state
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # Helper to hash state
    def _hash_state(st):
        # Use bytes representation of inventory and grid for hashing
        return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())

    from collections import deque, namedtuple
    Node = namedtuple("Node", ["state", "actions"])

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_hash_state(init_state))

    MAX_PLAN_LEN = 300  # safety limit
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: have at least one arrow
        if cur_state.satisfies("", target_idx):
            return cur_actions

        # Prune long plans
        if len(cur_actions) >= MAX_PLAN_LEN:
            continue

        # Expand actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _hash_state(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, cur_actions + [a]))

    # No plan found
    return []


