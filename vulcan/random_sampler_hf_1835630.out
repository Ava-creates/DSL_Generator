    primitives_needed = cookbook.primitives_for(goal_idx)

    # ----------------------------------------------------------------------
    # Ensure we start with a fresh episode.
    # ----------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)                # current (x, y)
    grid = state.grid                      # (W, H, n_kinds)

    # Occupancy map – True where any entity blocks movement.
    occupied = np.any(grid > 0, axis=2)

    actions = []               # final action list
    harvested = set()          # cells already collected from

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells that currently contain this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed:
                break
            if cell in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_to_adjacent(pos, [cell], occupied)
            actions.extend(path)
            # Update our internal position according to the path.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Mark the cell as empty for future path‑finding.
            if grid[cell[0], cell[1], prim_idx] == 1:
                occupied[cell[0], cell[1]] = False
            harvested.add(cell)
            collected += 1

