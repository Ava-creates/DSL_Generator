    # ----------------------------------------------------------------------
    # Setup: reset environment and retrieve necessary objects
    # ----------------------------------------------------------------------
    # Action indices as defined in CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and pull out the current state and world objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Work on a mutable copy of the grid for planning purposes
    grid = state.grid.copy()

    # ----------------------------------------------------------------------
    # Goal information: index of the target item and its primitive needs
    # ----------------------------------------------------------------------
    goal_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Set of entity kinds that block movement (non‑grabbable)
    non_grabbable = list(world.non_grabbable_indices)

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def is_blocked(pos):
        """Return True if a non‑grabbable entity occupies the cell."""
        y, x = pos
        return np.any(grid[y, x, non_grabbable] > 0)

    def bfs_path(start, goal):
        """Return the shortest walkable path (list of positions) from start to goal."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        from collections import deque
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            return []  # unreachable

        # Reconstruct the path backwards from goal to start
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions (including start) to movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the closest cell containing the given kind (Manhattan distance)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of ``target`` (preferring N,S,W,E)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target  # fallback to the target itself if surrounded

    # ----------------------------------------------------------------------
    # Build the action sequence
    # ----------------------------------------------------------------------
    actions = []
    cur = tuple(state.pos)   # current agent position (y, x)

    # --------------------------------------------------------------
    # 1) Collect all required primitives the necessary number of times
    # --------------------------------------------------------------
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive not present; abort planning.
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur, stand_pos)
            if not path and cur != stand_pos:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive cell itself
            path = bfs_path(cur, prim_loc)
            if not path and cur != prim_loc:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid to reflect that the primitive has been taken
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # --------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            if path:
                actions.extend(path_to_actions([cur] + path))
                cur = ws_loc

    # Final USE to perform the crafting action
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Action indices used by CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and get the current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Goal: arrow
    goal_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    non_grab = list(world.non_grabbable_indices)

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def is_blocked(pos):
        """True if a non‑grabbable entity occupies the cell."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs_path(start, goal):
        """Return shortest walkable path from start to goal (excluding start)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            return []  # unreachable

        # reconstruct path (excluding start)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions (including start) to movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the closest cell containing ``kind`` (Manhattan distance)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = tuple(state.pos)   # current agent position (y, x)

    # Collect each required primitive the needed number of times
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive missing – abort early
                return actions

            # Move to the primitive cell
            path = bfs_path(cur, prim_loc)
            if not path and cur != prim_loc:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid to reflect that the primitive has been taken
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # If the recipe specifies a workshop, move there before crafting
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            if path:
                actions.extend(path_to_actions([cur] + path))
                cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions

