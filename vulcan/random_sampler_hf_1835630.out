  # ----------------------------------------------------------------------
  # Setup world, cookbook and target index
  # ----------------------------------------------------------------------
  world = env.world
  cookbook = world.cookbook
  try:
    target_idx = cookbook.index["arrow"]
  except Exception:
    return []  # arrow not defined in this world

  # ----------------------------------------------------------------------
  # Resolve recipe: collect primitive requirements and crafting order
  # ----------------------------------------------------------------------
  needed_prims = {}          # primitive kind → total count needed
  craft_steps = []           # list of (item_idx, count) in order

  def resolve(item_idx, mult):
    """Recursively gather primitive counts and schedule crafting steps."""
    rec = cookbook.recipes.get(item_idx)
    if rec is None:  # primitive (no recipe)
      needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
      return
    # Resolve ingredients first
    for ing, cnt in rec.items():
      if isinstance(ing, int):
        resolve(ing, cnt * mult)
    # After ingredients, schedule this item to be crafted
    craft_steps.append((item_idx, mult))

  resolve(target_idx, 1)

  # ----------------------------------------------------------------------
  # Extract current grid, position and build static blocked map
  # ----------------------------------------------------------------------
  grid = env._current_state.grid.copy()          # mutable copy for planning
  w, h, _ = grid.shape
  pos = tuple(env._current_state.pos)

  blocked = np.zeros((w, h), dtype=bool)
  for idx in world.non_grabbable_indices:
    blocked |= grid[:, :, idx] > 0

  # Directions: action index → (dx, dy)
  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT

  # ----------------------------------------------------------------------
  # Bread‑first search returning a list of actions to the nearest target cell
  # ----------------------------------------------------------------------
  def bfs(start, targets):
    q = collections.deque([(start, [])])
    visited = {start}
    while q:
      (x, y), path = q.popleft()
      if (x, y) in targets:
        return path
      for a, (dx, dy) in enumerate(DIRS):
        nx, ny = x + dx, y + dy
        if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
          if not blocked[nx, ny]:
            visited.add((nx, ny))
            q.append(((nx, ny), path + [a]))
    return []  # no path (should not happen in solvable scenarios)

  # ----------------------------------------------------------------------
  # Helpers to move along a path and update current position
  # ----------------------------------------------------------------------
  actions = []

  def move_along(path):
    nonlocal pos
    for a in path:
      dx, dy = DIRS[a]
      pos = (pos[0] + dx, pos[1] + dy)
      actions.append(a)

  # ----------------------------------------------------------------------
  # 1) Collect all required primitive resources
  # ----------------------------------------------------------------------
  for kind_idx, cnt in needed_prims.items():
    for _ in range(cnt):
      # Locate cells that currently hold the required primitive
      cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
      if not cells:
        # Primitive not present; skip (environment may already have it)
        continue
      if pos in cells:
        # Already on a cell with the item
        actions.append(4)          # USE
        grid[pos[0], pos[1], kind_idx] = max(0, grid[pos[0], pos[1], kind_idx] - 1)
        continue
      path = bfs(pos, cells)
      move_along(path)
      actions.append(4)            # USE
      # Simulate picking up the item
      grid[pos[0], pos[1], kind_idx] = max(0, grid[pos[0], pos[1], kind_idx] - 1)

  # ----------------------------------------------------------------------
  # 2) Perform crafting steps at the appropriate workshops
  # ----------------------------------------------------------------------
  for item_idx, cnt in craft_steps:
    rec = cookbook.recipes[item_idx]
    wk_key = rec.get("_at", rec.get("_key"))
    wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

    # Locate workshop cells of the required type
    wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}
    if not wk_cells:
      continue  # no workshop found; skip (should not happen)

    if pos not in wk_cells:
      path = bfs(pos, wk_cells)
      move_along(path)

    # Use the workshop the required number of times
    actions.extend([4] * cnt)   # USE

  return actions


    import collections
    import numpy as np

    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # actions 0‑3: down, up, left, right

    def bfs(start, targets, blocked):
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # no path found (should not happen)

    def go_to_and_use(kind_idx, count):
        nonlocal pos, actions
        for _ in range(count):
            cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)  # USE action

    # ------------------------------------------------------------------
    # Gather recipe information for the target item "arrow"
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}      # primitive kind -> total count required
    craft_steps = []       # list of (item_idx, count) in order

    def resolve(item_idx, mult):
        """Recursively collect primitive requirements and schedule crafting."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ------------------------------------------------------------------
    # Prepare static data: grid, blocked cells, dimensions
    # ------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Collect all primitive resources needed
    for kind_idx, cnt in needed_prims.items():
        go_to_and_use(kind_idx, cnt)

    # 2) Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at") or rec.get("_key")
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * cnt)   # USE action repeated for each craft

    return actions

