    grid = state.grid.copy()             # mutable copy for planning

    # Goal index: use the task's goal if available, otherwise fall back to 'arrow'
    try:
        goal_idx = env.task.goal
    except Exception:
        goal_idx = world.cookbook.index.index('arrow')

    # Primitive requirements for the goal
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    non_grab = list(world.non_grabbable_indices)

    h, w = grid.shape[:2]

    def is_blocked(pos):
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs(start, goal):
        """Return shortest walkable path (list of positions) from start to goal inclusive."""
        if start == goal:
            return [start]
        q = deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in prev and not is_blocked(nxt):
                        prev[nxt] = cur
                        q.append(nxt)
        else:
            return []  # unreachable

        # reconstruct path
        path = []
        cur = goal
        while cur is not None:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Translate a list of positions into movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find nearest cell containing `kind` (Manhattan distance)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    actions = []
    cur = tuple(state.pos)

    # Collect all required primitives
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(prim_idx, cur)
            if target is None:
                return actions
            path = bfs(cur, target)
            if not path:
                return actions
            actions.extend(path_to_actions(path))
            cur = target
            actions.append(USE)
            # Remove the collected primitive from the planning grid
            grid[target[0], target[1], prim_idx] = 0

    # Move to the workshop if the recipe specifies one
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs(cur, ws_loc)
            if path:
                actions.extend(path_to_actions(path))
                cur = ws_loc

    # Final craft action
    actions.append(USE)

    return actions

