    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    # Mapping from direction vectors to action indices
    DIRS = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding non‑grabbable cells.
        If no path is found, returns an empty list."""
        if start == goal:
            return []
        H, W = grid.shape[:2]   # note: grid shape is (W, H, n_kinds) but we treat first two as rows, cols
        blocked = list(world.non_grabbable_indices)

        visited = np.full((H, W), False, dtype=bool)
        prev = {}   # (y, x) -> (prev_y, prev_x, action)

        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            for (dy, dx), act in DIRS.items():
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    if np.any(grid[ny, nx, blocked] > 0):
                        continue   # cell occupied by a non‑grabbable entity
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x, act)
                    if (ny, nx) == goal:
                        # reconstruct path
                        actions = []
                        cur = (ny, nx)
                        while cur != start:
                            py, px, a = prev[cur]
                            actions.append(a)
                            cur = (py, px)
                        actions.reverse()
                        return actions
                    q.append((ny, nx))
        # No path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell that contains ``kind_idx`` (primitive or workshop).
        Returns a tuple (y, x) or ``None`` if the kind does not appear anywhere."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Move to the primitive cell (standing on it is sufficient for USE)
            move_actions = bfs_path(cur_pos, target)
            actions.extend(move_actions)
            cur_pos = target

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if the recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions.extend(bfs_path(cur_pos, ws_cell))
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions


    # Reset environment and fetch current state information
    env.reset()
    state = env._current_state                # CraftState
    world = env.world                         # CraftWorld
    grid = state.grid.copy()                  # mutable copy for bookkeeping

