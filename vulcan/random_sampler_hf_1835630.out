            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sd = state.dir
        q = deque()
        q.append((sx, sy, sd, []))
