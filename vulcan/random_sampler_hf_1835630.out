    # Cardinal movement deltas
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action *names* moving the agent
    # from `start` to a cell that is adjacent (Chebyshev distance ≤ 1)
    # to any cell in `targets`. Only empty cells may be traversed.
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_to_adjacent(start, targets, grid):
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # Check adjacency to any target cell
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # Walk only through completely empty cells
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    # ------------------------------------------------------------------
    # 1) Collect all required primitives (respecting required counts)
    # ------------------------------------------------------------------
    while True:
        state = env._current_state
        inventory = state.inventory
        # Check if we already have enough of each primitive
        if all(inventory[p_idx] >= cnt for p_idx, cnt in needed.items()):
            break

        # Find a primitive we still need more of
        missing_idx = None
        for p_idx, cnt in needed.items():
            if inventory[p_idx] < cnt:
                missing_idx = p_idx
                break
        if missing_idx is None:
            break

        # Locate cells that currently contain this primitive
        prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))
        if not prim_cells:
            raise RuntimeError(f"Required primitive {missing_idx} not found on the map.")

        # Plan a path to an adjacent cell of the nearest primitive
        path = bfs_to_adjacent(state.pos, prim_cells, state.grid)
        if path is None:
            raise RuntimeError(f"Primitive {missing_idx} is unreachable from position {state.pos}.")

        # Execute movement actions
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

        # Pick up the primitive with the USE action
        use_aid = act_map["USE"]
        actions.append(use_aid)
        env.step(use_aid)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not found on the map.")
        path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

    # Final USE to craft (or to pick up if no workshop needed)
    final_use = act_map["USE"]
    actions.append(final_use)
    env.step(final_use)

    return actions

