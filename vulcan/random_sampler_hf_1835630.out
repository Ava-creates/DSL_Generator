    # Reset environment and obtain initial state/world
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []  # arrow not defined in this world

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions which leaves the
    # agent in a cell where the cell directly in front contains `target_kind`.
    # Returns None if no such position is reachable.
    # ------------------------------------------------------------------
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}  # DOWN,UP,LEFT,RIGHT

    def bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = cur_state.pos
        sdir = cur_state.dir
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, path = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine which primitive resources are needed for one arrow.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:               # arrow itself may be a primitive
        needed = {arrow_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            seq = bfs_to_target(state, kind_idx)
            if seq is None:
                # Primitive unreachable – abort planning.
                return actions
            actions.extend(seq)
            actions.append(4)          # USE to pick up
            # Simulate the actions to keep the state up‑to‑date
            for a in seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = bfs_to_target(state, workshop_idx)
        if seq is None:
            # Workshop unreachable – still attempt a USE (will fail harmlessly)
            actions.append(4)
            _, state = state.step(4)
        else:
            actions.extend(seq)
            actions.append(4)          # USE to craft
            for a in seq + [4]:
                _, state = state.step(a)
    else:
        # No specific workshop; craft in place.
        actions.append(4)
        _, state = state.step(4)

    return actions


    # Reset environment and get initial state/world
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    if goal_idx == 0:
        return []  # goal not present in this world

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions which end with the
    # agent facing a cell that contains `target_kind`. If already facing,
    # returns an empty list. Returns None if no such position exists.
    # ------------------------------------------------------------------
    def _bfs_to_face(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # movement deltas for actions 0‑3 (DOWN, UP, LEFT, RIGHT)
        deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = state.pos
        sdir = state.dir
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, path = q.popleft()
            # cell directly in front of the agent
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path
            # explore four movement actions
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine which primitives are needed for one arrow.
    # If the recipe dict is empty, the arrow itself is primitive.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(goal_idx)
    if not needed:
        needed = {goal_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            move_seq = _bfs_to_face(state, prim_idx)
            if move_seq is None:
                # unreachable primitive – abort planning
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            # apply the actions to keep state up‑to‑date
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its workshop (if any) or in place.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_face(state, workshop_idx)
        if move_seq is None:
            # workshop unreachable – just try USE (will fail gracefully)
            actions.append(4)
            _, state = state.step(4)
        else:
            actions.extend(move_seq)
            actions.append(4)  # USE to craft
            for a in move_seq + [4]:
                _, state = state.step(a)
    else:
        # No specific workshop required.
        actions.append(4)
        _, state = state.step(4)

    return actions

