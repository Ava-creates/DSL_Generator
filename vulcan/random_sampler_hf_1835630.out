            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    # ----------------------------------------------------------------------
    # Planning parameters
    # ----------------------------------------------------------------------
    MAX_PLAN_LENGTH = 800               # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # default: 0‑4 (UP,DOWN,LEFT,RIGHT,USE)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test – inventory contains at least one arrow
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_PLAN_LENGTH:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the limits – return empty action list
    return []

