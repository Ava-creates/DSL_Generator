def make_arrow_vn(env):
    # Get action indices from the environment
    act_map = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        act_map["DOWN"],
        act_map["UP"],
        act_map["LEFT"],
        act_map["RIGHT"],
        act_map["USE"],
    )

    # Resolve the goal index for the item "arrow"
    arrow_name = "arrow"
    arrow_idx = env.world.cookbook.index[arrow_name]

    # Primitive requirements for a single arrow
    primitive_needs = env.world.cookbook.primitives_for(arrow_idx)

    # Helper to move the agent towards a target position (Manhattan moves)
    def move_towards(cur_pos, target_pos):
        seq = []
        cur = list(cur_pos)
        while abs(cur[0] - target_pos[0]) + abs(cur[1] - target_pos[1]) > 1:
            if cur[0] < target_pos[0]:
                seq.append(RIGHT)
                cur[0] += 1
            elif cur[0] > target_pos[0]:
                seq.append(LEFT)
                cur[0] -= 1
            elif cur[1] < target_pos[1]:
                seq.append(DOWN)
                cur[1] += 1
            else:  # cur[1] > target_pos[1]
                seq.append(UP)
                cur[1] -= 1
        return seq, tuple(cur)

    # Main planning loop
    actions = []
    state = env._current_state  # initial state

    while not state.satisfies("", arrow_idx):
        # ------------------------------------------------------------------
        # 1. Determine which primitives are still missing.
        # ------------------------------------------------------------------
        missing = {}
        for p_idx, cnt in primitive_needs.items():
            have = state.inventory[p_idx]
            if have < cnt:
                missing[p_idx] = cnt - have

        if missing:
            # ------------------------------------------------------------------
            # 2. Choose a missing primitive (first one) and go collect it.
            # ------------------------------------------------------------------
            p_idx = next(iter(missing))

            # Locate any cell that still holds this primitive
            locations = np.argwhere(state.grid[:, :, p_idx] > 0)
            if locations.size == 0:
                raise RuntimeError(f"Required primitive {p_idx} not found in the world.")
            # Choose the nearest one (Manhattan distance)
            cur_pos = np.array(state.pos)
            dists = np.sum(np.abs(locations - cur_pos), axis=1)
            target_cell = tuple(locations[dists.argmin()])

            # Move adjacent to the primitive
            move_seq, new_pos = move_towards(state.pos, target_cell)
            for a in move_seq:
                actions.append(a)
                _, state = state.step(a)  # update state
            # Use action to pick it up
            actions.append(USE)
            _, state = state.step(USE)

        else:
            # ------------------------------------------------------------------
            # 3. All primitives are in inventory – go to the required workshop.
            # ------------------------------------------------------------------
            workshop_idx = env.world.cookbook.recipes[arrow_idx]["_at"]
            workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
            if workshop_cells.size == 0:
                raise RuntimeError("Workshop for arrow not found in the world.")
            # Take the first workshop location
            workshop_pos = tuple(workshop_cells[0])

            move_seq, new_pos = move_towards(state.pos, workshop_pos)
            for a in move_seq:
                actions.append(a)
                _, state = state.step(a)
            # Use action to craft the arrow
            actions.append(USE)
            _, state = state.step(USE)

    # Return the full action list
    return actions

