    env.reset()
    state = env._current_state
    world = env.world

    # index of the goal item "arrow"
    goal_idx = world.cookbook.index.index("arrow")
    if goal_idx == 0:
        return []  # arrow not present in this world

    # ------------------------------------------------------------------
    # BFS that returns a list of movement actions which end with the
    # agent facing a cell that contains `target_kind`. Returns None if
    # no such position exists.
    # ------------------------------------------------------------------
    def _bfs_to_face(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)
        deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = cur_state.pos
        sdir = cur_state.dir
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, path = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine primitive resources required for a single arrow.
    # If the recipe dict is empty, treat the arrow itself as a primitive.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(goal_idx)
    if not needed:
        needed = {goal_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            move_seq = _bfs_to_face(state, prim_idx)
            if move_seq is None:
                # unreachable primitive – abort planning
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its workshop (if any) or in place.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_face(state, workshop_idx)
        if move_seq is None:
            actions.append(4)
            _, state = state.step(4)
        else:
            actions.extend(move_seq)
            actions.append(4)  # USE to craft
            for a in move_seq + [4]:
                _, state = state.step(a)
    else:
        actions.append(4)  # USE to craft in place
        _, state = state.step(4)

    return actions


    # Reset environment and get initial state/world references
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify the index of the goal item "arrow". If not present, return.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    if goal_idx == 0:
        return []   # arrow not defined in this world

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) which
    # position the agent so that the cell directly in front contains
    # `target_kind`. Returns None if unreachable.
    # ------------------------------------------------------------------
    def _bfs_to_face(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # Action → (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)
        deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            # walkable iff inside bounds and no entity occupies the cell
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = cur_state.pos
        sdir = cur_state.dir
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, path = q.popleft()
            # Check the cell directly in front of the agent
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path
            # Explore four movement actions
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # If the recipe dict is empty, treat the arrow itself as primitive.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(goal_idx)
    if not primitive_needs:
        primitive_needs = {goal_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = _bfs_to_face(state, prim_idx)
            if move_seq is None:
                # Primitive unreachable – abort planning and return what we have.
                return actions
            actions.extend(move_seq)
            actions.append(4)          # USE action to pick up / interact
            # Apply the actions to keep the internal state up‑to‑date.
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its workshop (if any) or directly with USE.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_face(state, workshop_idx)
        if move_seq is None:
            # Workshop unreachable – still try a USE (will simply do nothing).
            actions.append(4)
            _, state = state.step(4)
        else:
            actions.extend(move_seq)
            actions.append(4)          # USE to craft at the workshop
            for a in move_seq + [4]:
                _, state = state.step(a)
    else:
        # No specific workshop required.
        actions.append(4)
        _, state = state.step(4)

    return actions

