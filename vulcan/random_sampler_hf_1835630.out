    # Retrieve scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Find the index for the target item “arrow”
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        # Hash based on position, direction, inventory and grid contents
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 500                     # safety bound for search depth
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal reached?
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Skip overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    # No plan found within the search budget
    return []


    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 500
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        if cur_state.satisfies("", target_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    return []

