        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return cur_actions

        # Depth and node limits
        if len(cur_actions) >= MAX_STEPS:
            continue
        if nodes_expanded >= MAX_NODES:
            break
        nodes_expanded += 1

        # Expand possible actions
        for a in action_order[:n_actions]:
