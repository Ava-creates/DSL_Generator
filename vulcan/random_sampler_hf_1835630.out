INFO 10-28 15:15:45 [llm.py:306] Supported_tasks: ['generate']

    # Reset environment to obtain a fresh state
    env.reset()
    state = env._current_state

    # Goal index and recipe information
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # Action mapping (e.g. {'DOWN':0, 'UP':1, ...})
    act_map = env.action_specs()

    # Movement deltas for the four cardinal actions
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  ( 1, 0),
        "LEFT":  ( 0,-1),
        "RIGHT": ( 0, 1),
    }

    actions = []

    # Helper: BFS that returns a list of action names moving the agent from `start`
    # to a cell that is *adjacent* (including diagonally) to any cell in `targets`.
    def bfs_to_adjacent(start, targets, grid):
        from collections import deque
        W, H = grid.shape[:2]
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)

        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # Check adjacency to any target cell
            for tx, ty in target_set:
                if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:
                    return path

            # Expand neighbours
            for act, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H:
                    # cell must be empty (no entity present)
                    if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return None  # no path found

    # ----------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Refresh current state information
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Locate all cells that currently contain the needed primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Primitive not present – cannot continue; break early
                break

            # Plan a path to the nearest primitive (adjacent cell)
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                break  # no reachable primitive

            # Execute movement actions
            for act_name in path:
                actions.append(act_map[act_name])
                env.step(act_map[act_name])

            # Use action to pick up the primitive
            actions.append(act_map["USE"])
            env.step(act_map["USE"])

    # ----------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        # Refresh state after collecting primitives
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    actions.append(act_map[act_name])
                    env.step(act_map[act_name])

            # Use action at the workshop to craft the item
            actions.append(act_map["USE"])
            env.step(act_map["USE"])

    # Return the complete action sequence
    return actions


    # Reset the environment to start a fresh episode
    env.reset()

    # Helper to get action indices from the environment spec
    action_map = env.action_specs()          # e.g. {'DOWN':0,'UP':1,'LEFT':2,'RIGHT':3,'USE':4}
    DOWN = action_map['DOWN']
    UP   = action_map['UP']
    LEFT = action_map['LEFT']
    RIGHT= action_map['RIGHT']
    USE  = action_map['USE']

    # Shortcut to the world and cookbook for recipe information
    world = env.world
    cookbook = world.cookbook

    # Goal item index (the arrow) comes from the task definition
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1) Determine the primitive ingredients required for the goal
    # ------------------------------------------------------------------
    # primitives_for returns a dict {primitive_idx: count_needed}
    needed = dict(cookbook.primitives_for(goal_idx))

    # ------------------------------------------------------------------
    # 2) Helper: navigate from current position to a target cell
    # ------------------------------------------------------------------
    def navigate_to(state, target):
        """Return a list of actions that moves the agent from its current
        position to the target cell using Manhattan moves."""
        actions = []
        y, x = state.pos          # note: grid is (y, x)
        ty, tx = target
        # vertical moves
        while y < ty:
            actions.append(DOWN); y += 1
        while y > ty:
            actions.append(UP);   y -= 1
        # horizontal moves
        while x < tx:
            actions.append(RIGHT); x += 1
        while x > tx:
            actions.append(LEFT);  x -= 1
        return actions

    # ------------------------------------------------------------------
    # 3) Collect all required primitive items
    # ------------------------------------------------------------------
    action_seq = []
    # keep a reference to the mutable state after each step
    state = env._current_state

    for prim_idx, count_needed in list(needed.items()):
        while count_needed > 0:
            # locate any cell that still holds this primitive
            locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if locations.shape[0] == 0:
                raise RuntimeError(f"Cannot find required primitive {prim_idx}")
            # pick the first occurrence
            target_y, target_x = locations[0]

            # move to that cell
            action_seq.extend(navigate_to(state, (target_y, target_x)))

            # attempt to pick it up
            action_seq.append(USE)

            # apply the actions to keep the state up‑to‑date
            for a in action_seq[-(len(navigate_to(state,(target_y,target_x)))+1):]:
                _, new_state = state.step(a)
                state = new_state

            # decrement the needed count (the inventory should now have one more)
            count_needed -= 1

    # ------------------------------------------------------------------
    # 4) Go to the appropriate workshop and craft the goal item
    # ------------------------------------------------------------------
    # The workshop kind is stored under the special key "_at" in the recipe dict
    workshop_kind = cookbook.recipes[goal_idx].get('_at')
    if workshop_kind is None:
        raise RuntimeError("Goal recipe does not specify a workshop")

    # locate any workshop of that kind
    workshop_locs = np.argwhere(state.grid[:, :, workshop_kind] > 0)
    if workshop_locs.shape[0] == 0:
        raise RuntimeError("No workshop of required type found")
    wy, wx = workshop_locs[0]

    # navigate to the workshop and use it to craft
    action_seq.extend(navigate_to(state, (wy, wx)))
    action_seq.append(USE)

    # (optional) update the state one final time – not strictly needed for the
    # returned action list but keeps the internal env consistent if called
    for a in action_seq[-(len(navigate_to(state,(wy,wx)))+1):]:
        _, new_state = state.step(a)
        state = new_state

    # Return the complete action list
    return action_seq

