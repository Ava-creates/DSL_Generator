    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item
    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # make local mutable copies of the world state
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return a list of movement actions to reach any cell in *goals*."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat any occupied cell as a wall unless it is a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update *pos* according to a sequence of movement actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ----------------------------------------------------------------------
    # Primitive collection helper
    def collect_primitive(prim_idx, needed):
        """Collect *needed* units of primitive *prim_idx* from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate all cells that still contain the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                break  # no more primitives available
            # find the first reachable one (BFS is cheap enough)
            chosen_path = None
            chosen_loc = None
            for loc in locations:
                p = bfs(pos, {loc})
                if p is not None:
                    chosen_path = p
                    chosen_loc = loc
                    break
            if chosen_path is None:
                break  # unreachable
            # move to the primitive and pick it up
            actions.extend(chosen_path)
            move_along(chosen_path)
            actions.append(4)  # USE
            grid[chosen_loc[0], chosen_loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            needed -= 1

    # ----------------------------------------------------------------------
    # Recursive crafting helper
    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        """Guarantee that inventory[item_idx] >= amount, crafting if needed."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives_set:
                # primitive: just collect the missing amount
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # non‑primitive: use its recipe
            recipe = recipes.get(item_idx, {})
            # first ensure all ingredient quantities are present
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to the required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # perform the crafting action
            actions.append(4)  # USE
            # update simulated inventory
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions


    # ----------------------------------------------------------------------
    # Setup
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item name (arrow) – fallback to first recipe output if not present
    target_name = "arrow"
    if target_name not in cookbook.index.contents:
        # pick an arbitrary craftable item (first key in recipes)
        target_name = next(iter(cookbook.recipes))
    target_idx = cookbook.index[target_name]

    # mutable copies of the world state for planning
    grid = state.grid.copy()
    pos = tuple(state.pos)                     # (x, y)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    # ----------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions to reach any goal cell
    def bfs(start, goal_set):
        """Bread‑first search on the grid returning a list of actions."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goal_set:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat any occupied cell as a wall unless it is a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goal_set:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    # ----------------------------------------------------------------------
    # Helper: update simulated position according to a sequence of actions
    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:      # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1:    # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2:    # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3:    # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ----------------------------------------------------------------------
    # Primitive collection
    def collect_primitive(prim_idx, needed):
        """Collect `needed` units of primitive `prim_idx` from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate all cells that still contain the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                break  # no more primitives available

            # find the first reachable primitive
            chosen_path = None
            chosen_loc = None
            for loc in locations:
                p = bfs(pos, {loc})
                if p is not None:
                    chosen_path = p
                    chosen_loc = loc
                    break
            if chosen_path is None:
                break  # unreachable

            # move there and pick up
            actions.extend(chosen_path)
            move_along(chosen_path)
            actions.append(4)                     # USE
            grid[chosen_loc[0], chosen_loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            needed -= 1

    # ----------------------------------------------------------------------
    # Recursive crafting helper
    recipes = cookbook.recipes
    primitive_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        """Make sure `inventory[item_idx]` >= `amount` (crafting if needed)."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitive_set:
                # primitive – just collect the missing amount
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # non‑primitive – craft using its recipe
            recipe = recipes.get(item_idx, {})
            # first ensure all ingredients are present
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to the required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                # locate workshop cells
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                # pick the first workshop and move to an adjacent empty cell
                for ws in ws_cells:
                    adjacents = [(ws[0] + dx, ws[1] + dy) for dx, dy in
                                 ((0, 1), (0, -1), (-1, 0), (1, 0))]
                    reachable = [a for a in adjacents
                                 if 0 <= a[0] < width and 0 <= a[1] < height
                                 and not np.any(grid[a[0], a[1], :])]
                    if reachable:
                        path = bfs(pos, set(reachable))
                        if path is not None:
                            actions.extend(path)
                            move_along(path)
                        break  # stop after reaching one workshop

            # perform the crafting action
            actions.append(4)                     # USE
            # update simulated inventory
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Build the target item (arrow)
    ensure_item(target_idx, 1)

    return actions

