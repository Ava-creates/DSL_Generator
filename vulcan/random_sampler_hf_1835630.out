    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS to find a path (as actions) from start to a cell
    # adjacent to any target location, avoiding occupied cells.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        width, height, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # any non‑zero kind blocks movement
        from collections import deque
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path
            # Explore 4‑connected neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No path found – return empty list
        return []

    # ------------------------------------------------------------------
    # Retrieve world and cookbook objects
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook

    # Goal information (hard‑coded to "arrow")
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    grid = state.grid                # (W, H, n_kinds)

    actions = []
    harvested = set()                # cells already used for collection

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locations currently containing this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Order by Manhattan distance from current position
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive
            path = _bfs_path(pos, [loc])
            actions.extend(path)
            # Update agent position following the path
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive
            actions.append(USE)
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        # Locate workshop cells
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft using the workshop
            actions.append(USE)

    return actions


    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: move one step and update position + direction
    # ------------------------------------------------------------------
    def _step(pos, direction, act):
        x, y = pos
        if act == RIGHT:
            return (x + 1, y), act
        if act == LEFT:
            return (x - 1, y), act
        if act == DOWN:
            return (x, y + 1), act
        if act == UP:
            return (x, y - 1), act
        return pos, direction

    # ------------------------------------------------------------------
    # Helper: BFS to a free cell adjacent to any target cell.
    # Returns (list_of_actions, final_position)
    # ------------------------------------------------------------------
    def _bfs_adj(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path, (x, y)
            for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),
                                   (DOWN, (0, 1)), (UP, (0, -1))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return [], start

    # ------------------------------------------------------------------
    # Identify world, cookbook and goal
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Get current state (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state
    pos = tuple(state.pos)
    direction = int(state.dir)
    grid = state.grid

    actions = []

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count_needed in primitives_needed.items():
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= count_needed:
                break
            # Move adjacent to the primitive
            path, pos = _bfs_adj(pos, [loc])
            actions.extend(path)
            for act in path:
                pos, direction = _step(pos, direction, act)

            # Face the primitive
            needed_dir = None
            if loc[0] > pos[0]:
                needed_dir = RIGHT
            elif loc[0] < pos[0]:
                needed_dir = LEFT
            elif loc[1] > pos[1]:
                needed_dir = DOWN
            elif loc[1] < pos[1]:
                needed_dir = UP

            if needed_dir is not None and direction != needed_dir:
                opposite = {RIGHT: LEFT, LEFT: RIGHT, DOWN: UP, UP: DOWN}[needed_dir]
                w, h, _ = grid.shape
                opp_dx, opp_dy = {RIGHT: (1, 0), LEFT: (-1, 0),
                                  DOWN: (0, 1), UP: (0, -1)}[opposite]
                opp_x, opp_y = pos[0] + opp_dx, pos[1] + opp_dy
                if 0 <= opp_x < w and 0 <= opp_y < h and not np.any(grid[opp_x, opp_y] > 0):
                    actions.append(opposite)
                    pos, direction = _step(pos, direction, opposite)
                    actions.append(needed_dir)
                    pos, direction = _step(pos, direction, needed_dir)
                else:
                    actions.append(needed_dir)
                    pos, direction = _step(pos, direction, needed_dir)

            # Pick up the primitive
            actions.append(USE)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft at the required workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_locs:
            workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_locs[0]
            path, pos = _bfs_adj(pos, [target_ws])
            actions.extend(path)
            for act in path:
                pos, direction = _step(pos, direction, act)

            # Face the workshop
            needed_dir = None
            if target_ws[0] > pos[0]:
                needed_dir = RIGHT
            elif target_ws[0] < pos[0]:
                needed_dir = LEFT
            elif target_ws[1] > pos[1]:
                needed_dir = DOWN
            elif target_ws[1] < pos[1]:
                needed_dir = UP

            if needed_dir is not None and direction != needed_dir:
                opposite = {RIGHT: LEFT, LEFT: RIGHT, DOWN: UP, UP: DOWN}[needed_dir]
                w, h, _ = grid.shape
                opp_dx, opp_dy = {RIGHT: (1, 0), LEFT: (-1, 0),
                                  DOWN: (0, 1), UP: (0, -1)}[opposite]
                opp_x, opp_y = pos[0] + opp_dx, pos[1] + opp_dy
                if 0 <= opp_x < w and 0 <= opp_y < h and not np.any(grid[opp_x, opp_y] > 0):
                    actions.append(opposite)
                    pos, direction = _step(pos, direction, opposite)
                    actions.append(needed_dir)
                    pos, direction = _step(pos, direction, needed_dir)
                else:
                    actions.append(needed_dir)
                    pos, direction = _step(pos, direction, needed_dir)

            # Craft the arrow
            actions.append(USE)

    return actions

