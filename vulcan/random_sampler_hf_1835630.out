    # Reset environment and get initial state
    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # Find the index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # not defined
        return []

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that brings
    # the agent to a position where the cell directly in front contains
    # `target_kind`. Returns None if the target is unreachable.
    # ----------------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        import numpy as np
        from collections import deque

        grid = state.grid
        W, H = grid.shape[:2]

        # Action -> (dx, dy) mapping
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            if not in_bounds(x, y):
                return False
            # walkable iff the cell is completely empty
            return not np.any(grid[x, y, :])

        start_x, start_y = state.pos
        start_dir = state.dir
        queue = deque()
        queue.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while queue:
            x, y, d, actions = queue.popleft()
            # Check the cell directly ahead
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            # Expand neighbours (movement actions also set direction)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, actions + [a]))

        # Unreachable
        return None

    # ----------------------------------------------------------------------
    # Recursive production helper: ensure `item_idx` is present at least
    # `needed` times in the inventory, collecting primitives or crafting
    # intermediate items as required.
    # ----------------------------------------------------------------------
    actions = []

    def _ensure(item_idx, needed):
        nonlocal cur_state, actions
        # Loop until we have enough of the item
        while cur_state.inventory[item_idx] < needed:
            # Primitive items can be collected directly
            if item_idx in world.cookbook.primitives:
                seq = _bfs_to_target(cur_state, item_idx)
                if seq is None:
                    # Cannot reach the primitive – abort
                    return False
                actions.extend(seq)
                actions.append(4)          # USE to pick up
                for a in seq + [4]:
                    _, cur_state = cur_state.step(a)
                continue

            # Non‑primitive: need to craft it using its recipe
            recipe = world.cookbook.recipes.get(item_idx)
            if not recipe:
                # No way to produce this item
                return False

            # First ensure all ingredient counts are satisfied (one craft at a time)
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                # Ensure we have at least `cnt` of this ingredient
                if not _ensure(ing_idx, cnt):
                    return False

            # Move to required workshop (if any) before crafting
            workshop_name = recipe.get('_at')
            if workshop_name is not None:
                ws_idx = world.cookbook.index.index(workshop_name)
                seq = _bfs_to_target(cur_state, ws_idx)
                if seq is None:
                    return False
                actions.extend(seq)
                actions.append(4)          # USE to craft
                for a in seq + [4]:
                    _, cur_state = cur_state.step(a)
            else:
                # Craft in place
                actions.append(4)          # USE to craft
                _, cur_state = cur_state.step(4)

        return True

    # ----------------------------------------------------------------------
    # Produce a single arrow
    # ----------------------------------------------------------------------
    _ensure(arrow_idx, 1)

    return actions


    env.reset()
    cur_state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Primitive requirements for one arrow (recursively expanded)
    prim_req = world.cookbook.primitives_for(arrow_idx)
    if not prim_req:
        # Arrow itself is a primitive that must be picked up
        prim_req = {arrow_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # BFS that returns a list of movement actions (0‑3) that brings the
    # agent to a cell where the cell directly in front contains
    # `target_kind`. Returns None if the target cannot be reached.
    # ------------------------------------------------------------------
    def bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # action index → (dx, dy) displacement (also sets direction)
        deltas = {0: (0, 1),   # DOWN
                  1: (0, -1),  # UP
                  2: (-1, 0),  # LEFT
                  3: (1, 0)}   # RIGHT

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        start_x, start_y = state.pos
        start_dir = state.dir

        from collections import deque
        q = deque()
        q.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while q:
            x, y, d, acts = q.popleft()

            # Check cell directly ahead
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts

            # Expand neighbours (moving also sets direction)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))

        # Unreachable
        return None

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for kind_idx, total_needed in prim_req.items():
        # Account for any already‑present items in the inventory
        already_have = int(cur_state.inventory[kind_idx])
        need = max(0, total_needed - already_have)

        for _ in range(need):
            move_seq = bfs_to_target(cur_state, kind_idx)
            if move_seq is None:
                # Target cannot be reached – abort early.
                return actions
            actions.extend(move_seq)
            actions.append(4)                     # USE to pick up / interact

            # Apply actions to keep the simulated state in sync
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(cur_state, workshop_idx)
        if move_seq is None:
            return actions
        actions.extend(move_seq)
        actions.append(4)                     # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – just attempt crafting in place.
        actions.append(4)                     # USE to craft
        _, cur_state = cur_state.step(4)

    return actions

