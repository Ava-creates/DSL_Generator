    # ----------------------------------------------------------------------
    # Retrieve the scenario and world objects from the provided environment.
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # ----------------------------------------------------------------------
    # Identify the integer index of the target item "arrow" using the
    # cookbook's Index mapping. If the name is not present we cannot plan.
    # ----------------------------------------------------------------------
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Obtain the initial CraftState for the episode.  This represents the
    # starting grid, agent position, direction and empty inventory.
    # ----------------------------------------------------------------------
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Helper structures for breadth‑first search (BFS) over the state space.
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory contents and the full grid layout.
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    # ----------------------------------------------------------------------
    # Planning parameters.
    # ----------------------------------------------------------------------
    MAX_STEPS = 800                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # default: 0‑4 (move+use)

    # ----------------------------------------------------------------------
    # Breadth‑first search loop.
    # ----------------------------------------------------------------------
    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: does the inventory contain at least one arrow?
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long candidate plans.
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions from the current state.
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # ----------------------------------------------------------------------
    # No plan found within the allowed search budget.
    # ----------------------------------------------------------------------
    return []


    # ----------------------------------------------------------------------
    # Helper to safely extract scenario and world objects from the env wrapper
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", None) or env
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # ----------------------------------------------------------------------
