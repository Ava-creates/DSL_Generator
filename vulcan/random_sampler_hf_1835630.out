    # Reset environment and obtain initial state and world reference
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify the index of the goal item "arrow". If not present, abort.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for one arrow.
    # If there is no recipe, the arrow itself must be collected.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    actions = []   # final action list to be returned

    # ------------------------------------------------------------------
    # Helper: BFS that finds a sequence of movement actions (0‑3) that
    # brings the agent to a cell where the *front* cell contains
    # `target_kind`. Returns None if the target cannot be reached.
    # ------------------------------------------------------------------
    def _bfs_to_front(st, target_kind):
        grid = st.grid
        W, H = grid.shape[:2]

        # action → (dx, dy) for moving forward in that direction
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            # A cell is walkable if it is inside the grid and empty
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        start_x, start_y = st.pos
        start_dir = st.dir
        q.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while q:
            x, y, d, seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return seq

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))

        return None

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            move_seq = _bfs_to_front(state, prim_idx)
            if move_seq is None:
                # Target unreachable – return what we have so far.
                return actions
            actions.extend(move_seq)
            actions.append(4)          # USE to pick up / interact

            # Keep simulated state in sync with the actions we added.
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_front(state, workshop_idx)
        if move_seq is None:
            return actions
        actions.extend(move_seq)
        actions.append(4)              # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop – just attempt to craft in place.
        actions.append(4)              # USE to craft
        _, state = state.step(4)

    return actions


