    import numpy as np
    from collections import deque

    # Action constants (match CraftWorld ordering)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions that moves from `start` to a cell
        adjacent (Manhattan distance 1) to any of the `targets`.
        `occupied` is a bool mask where True means the cell cannot be entered.
        """
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                # Check adjacency after the move
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        # No reachable adjacent cell
        return []

    # ------------------------------------------------------------------
    # Retrieve the world and current state from the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # env might be a CraftLab wrapper.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    # If the recipe has no primitive components, we just need to use the workshop.
    if not primitives_needed:
        primitives_needed = {}

    # ------------------------------------------------------------------
    # Current observation.
    # ------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # bool mask of any entity

    actions = []
    harvested = set()                     # cells we have already collected from

    # ------------------------------------------------------------------
    # Collect required primitives (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # Find all remaining cells that contain this primitive.
            candidates = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not candidates:
                # No more of this primitive on the map – give up.
                break

            # Choose the closest candidate (Manhattan distance).
            candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = candidates[0]

            # Plan a path to an adjacent cell.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement.
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # Update occupancy: the cell becomes empty after pickup.
            occupied[target] = False

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name).
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key

        # Locate workshop cells.
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Choose nearest workshop.
            workshop_cells.sort(
                key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])
            )
            ws_target = workshop_cells[0]

            # Move adjacent to the workshop.
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft at the workshop.
            actions.append(USE)
        else:
            # No workshop present; just attempt to craft where we are.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


