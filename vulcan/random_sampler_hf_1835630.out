    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_to(pos, target, seq):
        """Append moves to bring mutable list ``pos`` (x, y) to ``target``."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Return [x, y] of the nearest cell containing ``kind_idx``."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Initialise mutable state
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # static grid copy – we clear cells as we pick up items
    grid = env.scenario.init_grid.copy()

    # inventory tracking (item index -> count)
    inventory = collections.defaultdict(int)

    actions = []
    goal_idx = env.task.goal
    cookbook = env.world.cookbook

    # ------------------------------------------------------------------
    # Core recursive planner
    # ------------------------------------------------------------------
    def _ensure(item_idx, needed):
        """Make sure ``inventory[item_idx]`` reaches at least ``needed``."""
        while inventory[item_idx] < needed:
            # Primitive – just pick it up
            if item_idx in cookbook.primitives:
                target = _nearest_kind(item_idx, cur_pos, grid)
                if target is None:
                    # cannot find required primitive – abort planning
                    return False
                _move_to(cur_pos, target, actions)
                actions.append(USE)                     # pick up
                grid[target[1], target[0], item_idx] = 0
                inventory[item_idx] += 1
                continue

            # Non‑primitive – need to craft according to its recipe
            recipe = cookbook.recipes.get(item_idx, {})
            # First, ensure all ingredients are available
            for ing_idx, ing_cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                total_needed = ing_cnt
                if not _ensure(ing_idx, total_needed):
                    return False
                inventory[ing_idx] -= total_needed

            # Move to the required workshop (if any)
            workshop_kind = recipe.get("_at")
            if workshop_kind is not None:
                workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
                if workshop_pos is None:
                    # No workshop found – cannot craft
                    return False
                _move_to(cur_pos, workshop_pos, actions)

            # Craft the item
            actions.append(USE)
            inventory[item_idx] += 1
        return True

    # ------------------------------------------------------------------
    # Plan to obtain the goal item
    # ------------------------------------------------------------------
    _ensure(goal_idx, 1)

    return actions

