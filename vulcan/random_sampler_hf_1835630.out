            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # Bread‑first search over the state space
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])
    frontier = deque([Node(start_state, [])])
    visited = { _hash_state(start_state) }

    # Upper bound on plan length to keep search tractable
    MAX_STEPS = 250

    # Number of possible actions (default to 5 if not exposed)
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
