    # reset env and get references
    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid

    # resolve action indices, fallback to defaults
    try:
        specs = env.action_specs()
        DOWN = specs.get('DOWN', 0)
        UP = specs.get('UP', 1)
        LEFT = specs.get('LEFT', 2)
        RIGHT = specs.get('RIGHT', 3)
        USE = specs.get('USE', 4)
    except Exception:
        DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # helper to test if a cell is blocked (non‑grabbable entity present)
    def is_blocked(pos):
        y, x = pos
        return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    # BFS shortest path avoiding blocked cells
    def bfs(start, goal):
        if start == goal:
            return [start]
        h, w = grid.shape[:2]
        visited = np.full((h, w), False, dtype=bool)
        prev = {}
        q = collections.deque([start])
        visited[start] = True
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            cy, cx = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = cy + dy, cx + dx
                if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx] and not is_blocked((ny, nx)):
                    visited[ny, nx] = True
                    prev[(ny, nx)] = cur
                    q.append((ny, nx))
        else:
            return None
        # reconstruct
        path = [goal]
        while path[-1] != start:
            path.append(prev[path[-1]])
        path.reverse()
        return path

    # translate a position path into action list
    def path_to_actions(path):
        act = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            if y1 == y0 + 1:
                act.append(DOWN)
            elif y1 == y0 - 1:
                act.append(UP)
            elif x1 == x0 + 1:
                act.append(RIGHT)
            elif x1 == x0 - 1:
                act.append(LEFT)
        return act

    # locate nearest cell containing a given kind index
    def nearest(kind_idx, from_pos):
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        best = locs[np.argmin(dists)]
        return tuple(best)

    # pick a free orthogonal neighbour of a cell (or the cell itself)
    def stand_adjacent(cell):
        y, x = cell
        for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked((ny, nx)):
                return (ny, nx)
        return cell

    # orient the agent towards a target cell (adds a single turn action)
    def turn_towards(src, dst):
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # --------------------------------------------------------------
    # Determine the goal (arrow) and its primitive requirements
    # --------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # --------------------------------------------------------------
    # Collect all required primitives
    # --------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = nearest(prim_idx, cur_pos)
            if target is None:
                # primitive not present – abort early
                return actions
            stand = stand_adjacent(target)
            path = bfs(cur_pos, stand)
            if path is None:
                return actions
            actions += path_to_actions(path)
            cur_pos = stand

            turn = turn_towards(cur_pos, target)
            if turn is not None:
                actions.append(turn)

            actions.append(USE)

    # --------------------------------------------------------------
    # Move to the workshop (if recipe specifies one) and craft
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            path = bfs(cur_pos, ws_cell)
            if path is not None:
                actions += path_to_actions(path)
                cur_pos = ws_cell

    # final use to trigger crafting
    actions.append(USE)

    return actions


