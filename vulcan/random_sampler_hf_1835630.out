            elif dx < 0:
                actions.append(LEFT)
            # Pick up the primitive.
            actions.append(USE)
            # Update grid to reflect that the primitive has been collected.
            grid[target[0], target[1], prim_idx] = 0
            collected_cells.add(target)

    # ------------------------------------------------------------------
