    import numpy as np
    import collections

    # Action identifiers – match the default CraftWorld ordering.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions moving from `start` to a cell adjacent to any target."""
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # No reachable adjacent cell

    # ----------------------------------------------------------------------
    # Retrieve world / state objects from the environment.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ----------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    if not primitives_needed:
        return []

    # ----------------------------------------------------------------------
    # Current grid, position and occupancy mask.
    # ----------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # Cells already collected from

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # Locate all cells that currently contain this primitive.
            prim_locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            prim_locs = [loc for loc in prim_locs if loc not in harvested]
            if not prim_locs:
                break  # cannot find more of this primitive

            # Choose the nearest one (Manhattan distance).
            prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = prim_locs[0]

            # Plan a path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement.
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # Update occupancy mask (the cell becomes empty after pickup).
            occupied[target] = False

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index.
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key
        # Find workshop locations.
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = ws_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)
        else:
            # No workshop found; attempt to use current location.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    import numpy as np
    import collections

    # ----------------------------------------------------------------------
    # Action identifiers (match CraftWorld defaults)
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ----------------------------------------------------------------------
    # Helper: BFS returning a list of actions that moves the agent from
    # `start` to a cell adjacent (Manhattan distance = 1) to any cell in
    # `targets`.  Cells occupied by any entity are treated as blocked.
    # ----------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ----------------------------------------------------------------------
    # Retrieve world / state objects from the environment (handle wrappers)
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ----------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    if not primitives_needed:
        # Arrow itself is a primitive – nothing to collect or craft
        return []

    # ----------------------------------------------------------------------
    # Current grid, position and occupancy mask
    # ----------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # cells already collected from

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # Locate all cells that currently contain this primitive
            prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            prim_cells = [c for c in prim_cells if c not in harvested]
            if not prim_cells:
                # No more of this primitive on the map – give up on this type
                break

            # Choose the nearest primitive (Manhattan distance)
            prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = prim_cells[0]

            # Plan a path to a cell adjacent to the primitive
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement to update position
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # Update occupancy mask (cell becomes empty after pickup)
            occupied[target] = False

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or an integer)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str)
            else workshop_key
        )
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = ws_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)
        else:
            # No workshop found – attempt to use current cell
            actions.append(USE)
    else:
        # No specific workshop required
        actions.append(USE)

    return actions

