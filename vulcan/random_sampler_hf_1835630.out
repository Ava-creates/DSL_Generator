    # Retrieve scenario and world objects (handle possible wrappers)
    try:
        scenario = env.scenario
    except Exception:
        scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        arrow_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # Bread‑first search over (state, action‑history) pairs
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _hash_state(st):
        # Position, direction, inventory and full grid uniquely identify a state
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_hash_state(init_state)}
    frontier = deque([Node(init_state, [])])

    # Search limits
    MAX_STEPS = 400
    n_actions = getattr(world, "n_actions", 5)  # default to standard 5 actions

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", arrow_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _hash_state(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the depth limit
    return []


    # ----------------------------------------------------------------------
    # Obtain scenario and world objects (the environment may be wrapped)
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # ----------------------------------------------------------------------
    # Index of the target item ("arrow")
    # ----------------------------------------------------------------------
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Initial state of the episode
    # ----------------------------------------------------------------------
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Bread‑first search over (state, action‑sequence) pairs.
    # A simple heuristic ordering prefers the USE action before movement.
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _hash_state(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory (as tuple), and full grid bytes.
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_hash_state(init_state))

    MAX_STEPS = 300                     # safety bound to keep search tractable
    n_actions = getattr(world, "n_actions", 5)   # default to 5 (including USE)

    # Action ordering: try USE first, then the four movement actions.
    # The exact index of USE is assumed to be the last one (common in CraftWorld).
    ordered_actions = list(range(n_actions - 1, -1, -1))

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test – have at least one arrow in inventory.
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Depth limit.
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand neighbours.
        for a in ordered_actions:
            # Guard against out‑of‑range indices (in case world reports a different count).
            if a >= n_actions:
                continue
            _, nxt_state = cur_state.step(a)
            key = _hash_state(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If we exhaust the search without finding a plan, return an empty list.
    return []

