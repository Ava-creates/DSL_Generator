    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Action constants (as defined by CraftLab)
    # ------------------------------------------------------------------
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR_TO_ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    # ------------------------------------------------------------------
    # Bread‑first search: returns a list of actions that moves the agent
    # from ``start`` to a cell adjacent (Manhattan distance 1) to any
    # cell in ``targets`` while avoiding blocked cells.
    # ------------------------------------------------------------------
    def bfs(start, targets, grid):
        W, H = grid.shape[:2]
        # A cell is blocked if any kind occupies it (including obstacles)
        blocked = np.any(grid > 0, axis=2)

        sx, sy = start

        # Already adjacent to a target?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency
        return []

    # ------------------------------------------------------------------
    # Initialise state information
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()                     # mutable copy of world grid
    pos = tuple(state.pos)                       # (x, y)

    # Goal index is stored in the task definition
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive requirements for the goal (recursive expansion)
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        while cnt > 0:
            # Find all cells that currently contain this primitive
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive unavailable – abort planning
                return plan

            # Compute path to the nearest reachable primitive (adjacent)
            path = bfs(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to keep ``pos`` up‑to‑date
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop
                break

            # Update local grid copy and decrement needed count
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or an integer)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            # Simulate final movement
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop
            plan.append(ACTION_USE)

    return plan


    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,
        (0, -1): ACTION_UP,
        (-1, 0): ACTION_LEFT,
        (1, 0): ACTION_RIGHT,
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs(start, targets, grid):
        """Return a list of actions moving from ``start`` to a cell adjacent
        (Manhattan distance 1) to any cell in ``targets`` while avoiding blocked
        cells (any occupied cell in ``grid``)."""
        W, H = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)  # True where any entity occupies the cell
        sx, sy = start

        # Already adjacent to a target?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency
        return []

    # ----------------------------------------------------------------------
    # Extract current world information
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)  # (x, y)

    # Goal index (stored in env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive requirements for the goal (including intermediate items)
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # ----------------------------------------------------------------------
    # 1. Collect required primitives
    # ----------------------------------------------------------------------
    for kind_idx, remaining in needed.items():
        while remaining > 0:
            # Locate cells that still contain this primitive
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive unavailable – abort planning
                return plan

            # Find a path to a position adjacent to the nearest reachable primitive
            path = bfs(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to keep ``pos`` up‑to‑date
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to
            adj = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                # Should not happen; break to avoid infinite loop
                break

            # Update local grid copy and decrement needed count
            grid[adj[0], adj[1], kind_idx] -= 1
            remaining -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or an integer)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft by using the workshop
            plan.append(ACTION_USE)

    return plan

