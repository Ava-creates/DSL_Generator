    from collections import deque
    import numpy as np

    def _bfs_to_adjacent(start_pos, target_cells, grid):
        """Return a list of actions that moves the agent from ``start_pos`` to a
        cell that is Manhattan‑distance 1 from any cell in ``target_cells``.
        Cells containing any non‑grabbable entity are treated as blocked.
        """
        W, H = grid.shape[:2]

        # Build blocked mask from non‑grabbable indices.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start_pos

        # If already adjacent to a target, no movement needed.
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacent cell.
        return []

    # ------------------------------------------------------------------
