    # Mapping from action index to movement delta (DOWN,UP,LEFT,RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions that ends with the
    # agent facing a cell containing `target_kind`. Returns None if not reachable.
    # ------------------------------------------------------------------
    def bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = cur_state.pos
        sdir = cur_state.dir
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, path = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine which primitive resources are needed for one arrow.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:               # arrow itself may be primitive
        needed = {arrow_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            seq = bfs_to_target(state, kind_idx)
            if seq is None:
                # Primitive unreachable – abort planning.
                return actions
            actions.extend(seq)
            actions.append(4)          # USE to pick up
            # Simulate the actions to keep the state up‑to‑date
            for a in seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = bfs_to_target(state, workshop_idx)
        if seq is None:
            # Workshop unreachable – still attempt a USE (will fail harmlessly)
            actions.append(4)
            _, state = state.step(4)
        else:
            actions.extend(seq)
            actions.append(4)          # USE to craft
            for a in seq + [4]:
                _, state = state.step(a)
    else:
        # No specific workshop; craft in place.
        actions.append(4)
        _, state = state.step(4)

    return actions

