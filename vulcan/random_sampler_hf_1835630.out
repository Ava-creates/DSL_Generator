    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVES = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    def _bfs_path(grid, start, goal, allow_occupied=False):
        """Return a list of actions to move from start to goal.
        If allow_occupied is True we may step onto the goal cell even if it
        contains an entity; otherwise only empty cells are traversable."""
        h, w, _ = grid.shape
        from collections import deque
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (r, c), path = q.popleft()
            if (r, c) == goal:
                return path
            for act, (dr, dc) in MOVES:
                nr, nc = r + dr, c + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if (nr, nc) in visited:
                    continue
                # cell empty?
                if np.all(grid[nr, nc, :] == 0):
                    visited.add((nr, nc))
                    q.append(((nr, nc), path + [act]))
                elif allow_occupied and (nr, nc) == goal:
                    # we are allowed to step onto the goal even if occupied
                    visited.add((nr, nc))
                    q.append(((nr, nc), path + [act]))
        return None

    def _nearest_of_kind(grid, kind_idx, start):
        """BFS search for the closest cell that contains `kind_idx`.
        Returns (position, path) where `path` leads from `start` to that cell.
        Traversal is only through empty cells."""
        h, w, _ = grid.shape
        from collections import deque
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (r, c), path = q.popleft()
            if grid[r, c, kind_idx] > 0:
                return (r, c), path
            for act, (dr, dc) in MOVES:
                nr, nc = r + dr, c + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if (nr, nc) in visited:
                    continue
                if np.all(grid[nr, nc, :] == 0):
                    visited.add((nr, nc))
                    q.append(((nr, nc), path + [act]))
        return None, None

    # ------------------------------------------------------------------
    # Initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # ------------------------------------------------------------------
    # Identify the goal (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # not present in this world
        return []

    # ------------------------------------------------------------------
    # Determine which primitives (and how many) are needed for ONE arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Gather each required primitive (respecting multiplicity)
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            target_pos, path = _nearest_of_kind(state.grid, prim_idx, state.pos)
            if target_pos is None:
                # primitive not found – abort early
                return action_seq

            # move to the primitive (allow stepping onto its cell)
            move_path = _bfs_path(state.grid, state.pos, target_pos, allow_occupied=True)
            if move_path is None:
                move_path = []  # fallback: already adjacent / cannot move

            for a in move_path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq

            # pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # Craft the arrow – possibly at a specific workshop
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_pos, ws_path = _nearest_of_kind(state.grid, workshop_idx, state.pos)
        if ws_pos is not None:
            # move to workshop (can step onto it)
            move_path = _bfs_path(state.grid, state.pos, ws_pos, allow_occupied=True)
            if move_path is None:
                move_path = ws_path if ws_path is not None else []
            for a in move_path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # craft
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
    else:
        # no specific workshop – just use on current cell
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq


    # Reset environment and get initial objects
    env.reset()
