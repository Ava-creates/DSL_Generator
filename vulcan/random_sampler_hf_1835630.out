    import numpy as np
    from collections import deque

    # Reset environment and extract useful objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # planning copy

    # Action indices
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    MOVE_MAP = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    W, H = grid.shape[0], grid.shape[1]
    blocked_kinds = list(world.non_grabbable_indices)

    def is_blocked(y, x):
        """Return True if the cell contains any non‑grabbable entity."""
        return np.any(grid[y, x, blocked_kinds] > 0)

    def bfs_path(start, goal):
        """Return list of movement actions from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        q = deque([start])
        visited = np.full((W, H), False, dtype=bool)
        visited[start] = True
        parent = {}   # (y,x) -> (prev_y, prev_x, action)

        while q:
            y, x = q.popleft()
            for (dy, dx), act in MOVE_MAP.items():
                ny, nx = y + dy, x + dx
                if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:
                    if not is_blocked(ny, nx):
                        visited[ny, nx] = True
                        parent[(ny, nx)] = (y, x, act)
                        if (ny, nx) == goal:
                            # reconstruct
                            actions = []
                            cur = (ny, nx)
                            while cur != start:
                                py, px, a = parent[cur]
                                actions.append(a)
                                cur = (py, px)
                            actions.reverse()
                            return actions
                        q.append((ny, nx))
        # No path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell that contains the given kind."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # Determine goal (arrow) and its requirements
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    primitive_req = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_req.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Required primitive not present – abort planning
                return actions
            # Move to the primitive cell
            actions += bfs_path(cur_pos, target)
            cur_pos = target
            # Pick it up
            actions.append(USE)
            # Update planning grid (primitive removed)
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Go to workshop (if needed) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to craft
    actions.append(USE)

    return actions


    # reset environment and get current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # planning copy

    # action indices
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    H, W, _ = grid.shape  # note: grid shape is (WIDTH, HEIGHT, n_kinds)

    def in_bounds(y, x):
        return 0 <= y < H and 0 <= x < W

    def is_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return grid[y, x].any()

    # direction vectors with corresponding action
    DIRS = [
        (1, 0, DOWN),   # down
        (-1, 0, UP),    # up
        (0, -1, LEFT),  # left
        (0, 1, RIGHT),  # right
    ]
    DIR_MAP = {(dy, dx): act for dy, dx, act in DIRS}

    from collections import deque

    def bfs_path(start, goal):
        """Return a list of movement actions from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    dy, dx = cur[0] - py, cur[1] - px
                    rev.append(DIR_MAP[(dy, dx)])
                    cur = (py, px)
                rev.reverse()
                return rev
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if is_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # no path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Return coordinates of the nearest cell containing kind_idx."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    def adjacent_free(cell, forbidden=set()):
        """Return a free cell adjacent to `cell` that is not in `forbidden`."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in forbidden:
                continue
            if not is_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal (arrow) and its required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos
    collected = set()       # positions of primitives already taken

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, qty in needed_prims.items():
        for _ in range(qty):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # primitive not present – abort planning
                return actions
            # choose a free adjacent cell to stand on
            stand = adjacent_free(target, forbidden=collected)
            if stand is None:
                # fallback: stand on the primitive cell itself if reachable
                stand = target
            # move to standing position
            actions += bfs_path(cur_pos, stand)
            cur_pos = stand

            # set facing direction toward the primitive
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if (dy, dx) in DIR_MAP:
                actions.append(DIR_MAP[(dy, dx)])

            # pick up the primitive
            actions.append(USE)

            # update planning grid (primitive removed) and record position
            grid[target[0], target[1], prim_idx] = 0
            collected.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, forbidden=collected)
            if ws_adj is None:
                ws_adj = ws_cell
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # face the workshop
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if (dy, dx) in DIR_MAP:
                actions.append(DIR_MAP[(dy, dx)])

    # final USE to craft the arrow
    actions.append(USE)

    return actions

