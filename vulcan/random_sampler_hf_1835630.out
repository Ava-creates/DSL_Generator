    import numpy as np
    import collections

    # Action IDs (as defined in CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Initialise environment and obtain current world information
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = np.copy(state.grid)           # mutable copy of the grid

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_free(pos, cur_grid):
        """Return True if the cell at ``pos`` has no entities (including
        primitives and non‑grabbable objects)."""
        y, x = pos
        return not np.any(cur_grid[y, x, :] > 0)

    def is_blocked(pos, cur_grid):
        """Return True if the cell contains any non‑grabbable entity."""
        y, x = pos
        return np.any(cur_grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs_path(start, goal, cur_grid):
        """Shortest path from ``start`` to ``goal`` avoiding blocked cells.
        Returns a list of movement actions (DOWN/UP/LEFT/RIGHT)."""
        if start == goal:
            return []
        h, w = cur_grid.shape[:2]
        q = collections.deque([start])
        prev = {start: None}
        while q:
            y, x = q.popleft()
            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not is_blocked((ny, nx), cur_grid):
                    if (ny, nx) not in prev:
                        prev[(ny, nx)] = (y, x, act)
                        if (ny, nx) == goal:
                            # Reconstruct actions
                            actions_rev = []
                            cur = (ny, nx)
                            while prev[cur] is not None:
                                py, px, a = prev[cur]
                                actions_rev.append(a)
                                cur = (py, px)
                            actions_rev.reverse()
                            return actions_rev
                        q.append((ny, nx))
        # No path found – return empty list (will likely fail later)
        return []

    def find_nearest(kind_idx, from_pos, cur_grid):
        """Find coordinates of the nearest cell containing ``kind_idx``."""
        locs = np.argwhere(cur_grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    def choose_adjacent(target, cur_grid):
        """Choose a free cell adjacent to ``target`` to stand on.
        Returns (adjacent_pos, facing_action) where ``facing_action`` is the
        action that will make the agent face the target after a dummy turn."""
        ty, tx = target
        h, w = cur_grid.shape[:2]
        # Candidate neighbours with the action that would face the target
        candidates = [
            ((ty - 1, tx), DOWN),   # stand above, need to face DOWN
            ((ty + 1, tx), UP),     # stand below, need to face UP
            ((ty, tx - 1), RIGHT),  # stand left, need to face RIGHT
            ((ty, tx + 1), LEFT)    # stand right, need to face LEFT
        ]
        for (ny, nx), face_act in candidates:
            if 0 <= ny < h and 0 <= nx < w and is_free((ny, nx), cur_grid):
                # Check that we can perform a dummy turn: the cell opposite to the target
                # (i.e., one step further away) must be free so we can step away
                # and back to set direction without colliding.
                opp = {
                    DOWN: (ny + 1, nx),
                    UP: (ny - 1, nx),
                    RIGHT: (ny, nx + 1),
                    LEFT: (ny, nx - 1)
                }[face_act]
                oy, ox = opp
                if 0 <= oy < h and 0 <= ox < w and is_free((oy, ox), cur_grid):
                    return (ny, nx), face_act
        # Fallback: any free neighbour without dummy‑turn guarantee
        for (ny, nx), face_act in candidates:
            if 0 <= ny < h and 0 <= nx < w and is_free((ny, nx), cur_grid):
                return (ny, nx), face_act
        # If no free neighbour, return None (should not happen for reachable items)
        return None, None

    # ------------------------------------------------------------------
    # Identify the recipe for ``arrow`` and the required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos, grid)
            if target is None:
                # Primitive missing – abort planning.
                return actions

            # Choose a free adjacent cell to stand on and a facing action.
            adj, face_act = choose_adjacent(target, grid)
            if adj is None:
                # No accessible adjacent cell – abort.
                return actions

            # Move to the adjacent cell.
            actions += bfs_path(cur_pos, adj, grid)
            cur_pos = adj

            # Perform a dummy turn: step away opposite direction then back.
            # This guarantees the final direction faces the target.
            # Determine the opposite direction of ``face_act``.
            opposite = {DOWN: UP, UP: DOWN, LEFT: RIGHT, RIGHT: LEFT}[face_act]
            # Compute the cell one step opposite from current position.
            dy_op, dx_op = {
                DOWN: (-1, 0), UP: (1, 0),
                LEFT: (0, 1), RIGHT: (0, -1)
            }[face_act]
            opp_cell = (cur_pos[0] + dy_op, cur_pos[1] + dx_op)
            # Verify the opposite cell is free (it should be, as checked earlier).
            if is_free(opp_cell, grid):
                actions.append(opposite)          # move away
                actions.append(face_act)          # move back, now facing target
                cur_pos = adj  # back to original adjacent cell
            else:
                # If we cannot step away, just issue the facing action
                # (may move onto the primitive cell but we accept it).
                actions.append(face_act)
                # Update position if we actually moved onto a free cell.
                dy_f, dx_f = {
                    DOWN: (1, 0), UP: (-1, 0),
                    LEFT: (0, -1), RIGHT: (0, 1)
                }[face_act]
                new_pos = (cur_pos[0] + dy_f, cur_pos[1] + dx_f)
                if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1] and is_free(new_pos, grid):
                    cur_pos = new_pos

            # Use action to pick up the primitive.
            actions.append(USE)

            # Update local grid copy: remove the collected primitive.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos, grid)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell, grid)
            cur_pos = ws_cell

    # Final USE action to trigger crafting at the workshop (or anywhere if no workshop)
    actions.append(USE)

    return actions


    # Reset environment and get initial state information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    # Work on a mutable copy of the grid so we can update it after pickups
    grid = np.copy(state.grid)

    # Action identifiers (as defined in CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(y, x):
        """Return True if cell (y, x) contains any entity (including primitives)."""
        return np.any(grid[y, x, :] > 0)

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) for the shortest
        path from start to goal avoiding blocked cells. Empty list if no path."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = collections.deque([start])
        prev = {start: None}
        while q:
            y, x = q.popleft()
            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not is_blocked(ny, nx):
                    if (ny, nx) not in prev:
                        prev[(ny, nx)] = (y, x, act)
                        if (ny, nx) == goal:
                            # reconstruct actions
                            actions = []
                            cur = (ny, nx)
                            while prev[cur] is not None:
                                py, px, a = prev[cur]
                                actions.append(a)
                                cur = (py, px)
                            actions.reverse()
                            return actions
                        q.append((ny, nx))
        return []  # no path found

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine which primitives are needed for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort planning.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on before using.
            adj = None
            adj_facing = None
            for ny, nx, facing in (
                (ty - 1, tx, DOWN),   # stand above, face down
                (ty + 1, tx, UP),     # stand below, face up
                (ty, tx - 1, RIGHT),  # stand left, face right
                (ty, tx + 1, LEFT)    # stand right, face left
            ):
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked(ny, nx):
                    adj = (ny, nx)
                    adj_facing = facing
                    break

            if adj is None:
                # No free neighbour – stand on the primitive cell itself.
                adj = (ty, tx)
                adj_facing = None

            # Move to the chosen adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Adjust facing direction if a preferred orientation exists.
            if adj_facing is not None:
                actions.append(adj_facing)

            # Pick up the primitive.
            actions.append(USE)

            # Update local grid copy: remove the collected primitive.
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions

