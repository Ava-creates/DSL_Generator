    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {(0, 1): ACTION_DOWN,
               (0, -1): ACTION_UP,
               (-1, 0): ACTION_LEFT,
               (1, 0): ACTION_RIGHT}
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs_to_adjacent(start, targets, occupied):
        """Return a list of actions that moves from ``start`` to a cell adjacent
        to any cell in ``targets`` while avoiding cells where ``occupied`` is True.
        If already adjacent, returns an empty list."""
        W, H = occupied.shape
        # Already adjacent?
        for tx, ty in targets:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = deque()
        q.append((start[0], start[1], []))
        visited = np.zeros((W, H), dtype=bool)
        visited[start[0], start[1]] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not occupied[nx, ny]:
                    new_path = path + [act]
                    # Check adjacency from the new cell
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return new_path
                    visited[nx, ny] = True
                    q.append((nx, ny, new_path))
        # No reachable adjacent cell
        return []

    # ------------------------------------------------------------------
    # Extract current world information
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()               # mutable copy of the grid
    pos = tuple(state.pos)                 # (x, y)

    # Goal index stored in the task (may be an int or a string name)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        # Nothing to do
        return []

    # If the goal is a name, resolve it via the world index
    if isinstance(goal_idx, str):
        goal_idx = env.world.cookbook.index[goal_idx]

    # Primitive (and intermediate) requirements for the goal.
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, count in needed.items():
        while count > 0:
            # Locate cells that still contain this primitive.
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive not available – abort planning.
                return plan

            # Cells occupied by any entity block movement.
            occupied = np.any(grid > 0, axis=2)

            # Find a path to a position adjacent to one of the primitive cells.
            path = bfs_to_adjacent(pos, cells.tolist(), occupied)
            plan.extend(path)

            # Simulate movement to keep ``pos`` up‑to‑date.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Safety break to avoid infinite loop.
                break

            # Update local grid copy and decrement remaining count.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            count -= 1

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            occupied = np.any(grid > 0, axis=2)
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), occupied)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(ACTION_USE)

    return plan

