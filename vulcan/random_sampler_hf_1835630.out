    # ------------------------------------------------------------------
    # Constants for actions as defined in CraftWorld.
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell orthogonally adjacent to any cell in `targets`.
    # Cells where `blocked` is True are treated as impassable.
    # ------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets, blocked):
        w, h = blocked.shape
        queue = collections.deque()
        queue.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while queue:
            x, y, path = queue.popleft()
            # Stop if we are adjacent (Manhattan distance == 1) to a target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        queue.append((nx, ny, path + [act]))
        # No reachable adjacent cell.
        return []

    # ------------------------------------------------------------------
    # Helper: apply a sequence of actions to a position.
    # ------------------------------------------------------------------
    def _apply_actions(pos, actions):
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate the underlying CraftWorld and its Cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world through the current state.
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("Could not locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Determine the goal index for "arrow".
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not present in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements: {primitive_index: count}
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Planning state copies.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    blocked = np.any(grid, axis=2)             # occupied cells (bool)
    plan = []                                   # accumulated actions
    harvested_cells = set()                     # primitives already taken

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        # Locate all cells currently containing this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by distance to current position to reduce travel.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= required_cnt:
                break
            if cell in harvested_cells:
                continue
            # Move to a cell adjacent to the primitive.
            path = _bfs_to_adjacent(pos, [cell], blocked)
            plan.extend(path)
            pos = _apply_actions(pos, path)

            # Pick up the primitive.
            plan.append(USE)

            # Update planning structures: remove the primitive from the grid.
            grid[cell[0], cell[1], prim_idx] = 0
            blocked = np.any(grid, axis=2)    # recompute blocked mask
            harvested_cells.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # Locate the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be name or integer).
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_to_adjacent(pos, [target_ws], blocked)
            plan.extend(path)
            pos = _apply_actions(pos, path)
            plan.append(USE)   # craft at the workshop
        else:
            # No visible workshop; attempt to craft in place.
            plan.append(USE)
    else:
        # No specific workshop required.
        plan.append(USE)

    return plan


    import numpy as np
    import collections

    # Action indices as defined in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell orthogonally adjacent to any cell in `targets`.
    # `blocked` is a boolean mask where True means the cell cannot be entered.
    # ------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets, blocked):
        w, h = blocked.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are adjacent (Manhattan distance == 1) to any target, stop.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Explore neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell.
        return []

    # ------------------------------------------------------------------
    # Helper: update position according to a list of actions.
    # ------------------------------------------------------------------
    def _move(pos, actions):
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate the underlying CraftWorld and its Cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers keep the world inside the current state.
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state; reset the environment if needed.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal: make an "arrow".
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for the goal (primitive index → count).
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Planning state copies.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    blocked = np.any(grid, axis=2)             # occupied cells (bool)

    plan = []                                   # accumulated actions
    harvested = set()                           # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        # Find all cells that currently contain this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position to reduce travel.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0

        for cell in cells:
            if collected >= required_cnt:
                break
            if cell in harvested:
                continue

            # Move adjacent to the primitive cell.
            path = _bfs_to_adjacent(pos, [cell], blocked)
            plan.extend(path)
            pos = _move(pos, path)

            # Pick up the primitive.
            plan.append(USE)

            # Update planning structures: remove the primitive from the cell.
            grid[cell[0], cell[1], prim_idx] = 0
            # Recompute blocked mask for this cell (it may become empty).
            blocked[cell[0], cell[1]] = np.any(grid[cell[0], cell[1], :])
            harvested.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string or already an int).
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            # Choose the nearest workshop cell.
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_to_adjacent(pos, [target_ws], blocked)
            plan.extend(path)
            pos = _move(pos, path)
            plan.append(USE)   # craft at workshop
        else:
            # No visible workshop; attempt to craft in place.
            plan.append(USE)
    else:
        # No specific workshop required.
        plan.append(USE)

    return plan

