    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Determine current position (use live state if available)
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)          # [x, y]
    else:
        cur_pos = list(env.scenario.init_pos)           # [x, y]

    # Work on a mutable copy of the static grid to keep track of taken items
    grid = env.scenario.init_grid.copy()

    actions = []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_to(pos, target, seq):
        """Append actions moving from `pos` (list) to `target` (list)."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur, g):
        """Return coordinates [x, y] of the nearest cell containing `kind_idx`."""
        ys, xs = np.where(g[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the final goal.
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()

    # If the goal itself is a primitive, we also need to pick it up.
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for prim_kind, count in primitive_needs.items():
        for _ in range(count):
            target = _nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive not found; abort planning.
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)                         # pick up primitive
            grid[target[1], target[0], prim_kind] = 0   # mark cell as empty

    # ------------------------------------------------------------------
    # 2. Determine crafting order for intermediate items (post‑order).
    # ------------------------------------------------------------------
    recipes = env.world.cookbook.recipes
    primitives_set = env.world.cookbook.primitives

    craft_order = []
    visited = set()

    def _dfs(item):
        if item in visited:
            return
        visited.add(item)
        rec = recipes.get(item, {})
        for ing, cnt in rec.items():
            if ing == "_at":
                continue
            if ing not in primitives_set:
                _dfs(ing)
        craft_order.append(item)

    _dfs(goal_idx)

    # ------------------------------------------------------------------
    # 3. Execute crafting steps at required workshops.
    # ------------------------------------------------------------------
    for item in craft_order:
        # Primitives are already in inventory; skip them.
        if item in primitives_set:
            continue
        rec = recipes.get(item, {})
        workshop_kind = rec.get("_at")
        if workshop_kind is None:
            continue
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is None:
            # No workshop found; abort further planning.
            return actions
        _move_to(cur_pos, workshop_pos, actions)
        actions.append(USE)  # craft the item at the workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_to(pos, target, seq):
        """Append actions that move the agent from `pos` to `target`."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur, g):
        """Return coordinates [x, y] of the nearest cell containing `kind_idx`."""
        ys, xs = np.where(g[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Determine current position.
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)          # [x, y]
    else:
        cur_pos = list(env.scenario.init_pos)           # [x, y]

    # Copy of the static grid so we can mark items as taken.
    grid = env.scenario.init_grid.copy()

    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal.
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
