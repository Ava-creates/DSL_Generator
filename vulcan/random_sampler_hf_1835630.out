    from collections import deque
    import numpy as np

    # -----------------------------------------------------------------
    # Helper: BFS path planning avoiding non‑grabbable entities
    # -----------------------------------------------------------------
    def bfs(start, target):
        w, h = grid.shape[:2]

        # Determine blocked cells (any non‑grabbable entity present)
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((w, h), dtype=bool)

        # Allow stepping onto the target even if it would otherwise be blocked
        blocked[target[0], target[1]] = False

        q = deque([start])
        parent = {start: None}
        act_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        # Reconstruct action list
        path = []
        cur = target
        while cur != start:
            path.append(act_to[cur])
            cur = parent[cur]
        path.reverse()
        return path

    # -----------------------------------------------------------------
    # Helper: move agent (updates pos and records actions)
    # -----------------------------------------------------------------
    def move_to(target):
        nonlocal pos
        if pos == target:
            return
        path = bfs(pos, target)
        if path is None:
            # Fallback: simple Manhattan moves ignoring obstacles
            dx, dy = target[0] - pos[0], target[1] - pos[1]
            path = []
            while dx > 0:
                path.append(DOWN); dx -= 1
            while dx < 0:
                path.append(UP); dx += 1
            while dy > 0:
                path.append(RIGHT); dy -= 1
            while dy < 0:
                path.append(LEFT); dy += 1
        actions.extend(path)
        pos = target

    # -----------------------------------------------------------------
    # Collect required primitives (respecting current inventory)
    # -----------------------------------------------------------------
    for prim_idx, req_cnt in needed.items():
        have = int(inventory[prim_idx])
        need = max(0, req_cnt - have)

        for _ in range(need):
            # Locate remaining instances of this primitive on the map
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more instances available; give up further collection
                break

            # Choose the nearest instance (Manhattan distance)
            target = min(locations, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))

            move_to(target)
            actions.append(USE)  # pick up the primitive

            # Update simulated world state
            grid[target[0], target[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # -----------------------------------------------------------------
    # Move to workshop (if recipe specifies one) and craft the goal item
    # -----------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locations:
            # Choose nearest workshop
            target_ws = min(ws_locations, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            move_to(target_ws)
            actions.append(USE)  # craft at workshop

    return actions

