    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action mapping
    # ----------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _in_bounds(pos, shape):
        x, y = pos
        w, h = shape
        return 0 <= x < w and 0 <= y < h

    def _neighbors(pos, shape):
        x, y = pos
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if _in_bounds((nx, ny), shape):
                yield (nx, ny)

    def _bfs(start, goal_set, blocked):
        """
        Bread‑first search from ``start`` to any cell in ``goal_set``.
        ``blocked`` is a 2‑D bool array where True means the cell cannot be entered.
        Returns a list of positions (including start) representing the path,
        or ``None`` if no path exists.
        """
        w, h = blocked.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        dq = deque([start])
        visited[start] = True
        while dq:
            cur = dq.popleft()
            if cur in goal_set:
                # reconstruct path
                path = [cur]
                while path[-1] != start:
                    path.append(prev[path[-1]])
                path.reverse()
                return path
            for nb in _neighbors(cur, (w, h)):
                if not visited[nb] and not blocked[nb]:
                    visited[nb] = True
                    prev[nb] = cur
                    dq.append(nb)
        return None

    def _path_to_actions(path):
        """Convert a list of positions (including start) into a list of movement actions."""
        act_list = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 > x0:
                act_list.append(RIGHT)
            elif x1 < x0:
                act_list.append(LEFT)
            elif y1 > y0:
                act_list.append(DOWN)
            elif y1 < y0:
                act_list.append(UP)
        return act_list

    # ----------------------------------------------------------------------
    # Main logic
    # ----------------------------------------------------------------------
    world = env.world
    state = env._current_state
    grid = state.grid
    shape = grid.shape[:2]                     # (WIDTH, HEIGHT)

    # --------------------------------------------------------------
    # Determine goal index for "arrow"
    # --------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        try:
            goal_idx = world.cookbook.index["arrow"]
        except Exception as e:
            raise RuntimeError("Could not locate goal index for 'arrow'") from e

    # --------------------------------------------------------------
    # Primitive requirements for the goal (expanded)
    # --------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    # --------------------------------------------------------------
    # Build blocked map (cells that cannot be stepped on)
    # --------------------------------------------------------------
    blocked = np.zeros(shape, dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    actions = []
    cur_pos = tuple(state.pos)

    # --------------------------------------------------------------
    # Helper: move to a target cell (any reachable cell)
    # --------------------------------------------------------------
    def _move_to(target):
        nonlocal cur_pos, actions, blocked
        path = _bfs(cur_pos, {target}, blocked)
        if path is None:
            # unreachable – skip
            return cur_pos
        actions.extend(_path_to_actions(path))
        cur_pos = target
        return cur_pos

    # --------------------------------------------------------------
    # Collect required primitives
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        # locate all cells containing this primitive
        locs = np.argwhere(grid[:, :, prim_idx] > 0)
        if locs.size == 0:
            continue
        # pick the first occurrence (any is fine)
        prim_pos = tuple(locs[0])
        _move_to(prim_pos)
        actions.extend([USE] * needed)
        # after picking up, the cell becomes empty – unblock it
        blocked[prim_pos] = False

    # --------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index
        if isinstance(workshop_key, int):
            workshop_idx = workshop_key
        else:
            workshop_idx = world.cookbook.index.get(workshop_key)
        if workshop_idx is not None:
            ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
            if ws_locs.size > 0:
                ws_pos = tuple(ws_locs[0])
                # Find a free adjacent cell
                adj_cells = [nb for nb in _neighbors(ws_pos, shape) if not blocked[nb]]
                if adj_cells:
                    # Choose the closest adjacent cell to current position
                    adj_cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
                    target_adj = adj_cells[0]
                    _move_to(target_adj)

    # Finally, use the workshop (or current cell) to craft the arrow
    actions.append(USE)

    return actions


    # --------------------------------------------------------------
    # Setup
    # --------------------------------------------------------------
    import numpy as np
    from collections import deque

    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    world = env.world
    state = env._current_state
    grid = state.grid                # shape (W, H, n_kinds)
    shape = grid.shape[:2]           # (W, H)

    # --------------------------------------------------------------
    # Goal index for the item "arrow"
    # --------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        goal_idx = world.cookbook.index.get("arrow")
    if goal_idx is None:
        raise RuntimeError("Unable to locate goal index for 'arrow'")

    # --------------------------------------------------------------
    # Primitive requirements (flattened)
    # --------------------------------------------------------------
    primitive_reqs = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # --------------------------------------------------------------
    # Blocked cells – cannot step on non‑grabbable entities
    # --------------------------------------------------------------
    blocked = np.zeros(shape, dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    actions = []
    cur_pos = tuple(state.pos)

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    def _in_bounds(p):
        x, y = p
        w, h = shape
        return 0 <= x < w and 0 <= y < h

    def _neighbors(p):
        x, y = p
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if _in_bounds((nx, ny)):
                yield (nx, ny)

    def _bfs(start, target_set):
        """Return list of positions from start to any cell in target_set."""
        w, h = shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        dq = deque([start])
        visited[start] = True
        while dq:
            cur = dq.popleft()
            if cur in target_set:
                # reconstruct path
                path = [cur]
                while path[-1] != start:
                    path.append(prev[path[-1]])
                path.reverse()
                return path
            for nb in _neighbors(cur):
                if not visited[nb] and not blocked[nb]:
                    visited[nb] = True
                    prev[nb] = cur
                    dq.append(nb)
        return None

    def _path_to_actions(path):
        act = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 > x0:
                act.append(RIGHT)
            elif x1 < x0:
                act.append(LEFT)
            elif y1 > y0:
                act.append(DOWN)
            elif y1 < y0:
                act.append(UP)
        return act

    def _move_to(target):
        nonlocal cur_pos, actions
        path = _bfs(cur_pos, {target})
        if path is None:
            return False
        actions.extend(_path_to_actions(path))
        cur_pos = target
        return True

    # --------------------------------------------------------------
    # Collect all required primitives (greedy nearest search)
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_reqs.items():
        while needed > 0:
            # locate cells that still contain this primitive
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.size == 0:
                # no more sources – break out (should not happen in valid scenarios)
                break
            # find the nearest candidate using BFS (stop at first found)
            target_path = _bfs(cur_pos, {tuple(tuple(c) for c in candidates)})
            if target_path is None:
                # unreachable – abort remaining collection for this primitive
                break
            target = target_path[-1]
            # move there
            actions.extend(_path_to_actions(target_path))
            cur_pos = target
            # pick up one item
            actions.append(USE)
            needed -= 1
            # update our internal view of the grid / blocked map
            grid[target[0], target[1], prim_idx] = 0
            blocked[target] = False

    # --------------------------------------------------------------
    # Move to workshop (if recipe specifies one) and craft the goal
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index
        if isinstance(workshop_key, int):
            ws_idx = workshop_key
        else:
            ws_idx = world.cookbook.index.get(workshop_key)
        if ws_idx is not None:
            ws_cells = np.argwhere(grid[:, :, ws_idx] > 0)
            if ws_cells.size > 0:
                ws_pos = tuple(ws_cells[0])
                # Choose a free adjacent cell to stand on
                adj = [nb for nb in _neighbors(ws_pos) if not blocked[nb]]
                if adj:
                    # pick the adjacent cell closest to current position
                    adj.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
                    _move_to(adj[0])
    # finally use (craft) at the current location
    actions.append(USE)

    return actions

