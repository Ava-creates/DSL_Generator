    def _state_hash(st):
        # hash includes position, direction, inventory, and full grid layout
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 400                         # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)  # default action count (0‑4)

    # primitive requirements for the goal (used only for possible heuristics)
    needed_prims = world.cookbook.primitives_for(target_idx)
    needed_prim_idxs = set(needed_prims.keys())

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within limits
    return []

