    # Reset environment and fetch current state and world info
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # ------------------------------------------------------------------
    # Action identifiers (consistent with CraftLab.action_specs)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    H, W = grid.shape[:2]

    def in_bounds(y, x):
        return 0 <= y < H and 0 <= x < W

    def is_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return grid[y, x].any()

    def bfs_path(start, goal):
        """Return shortest list of movement actions from start to goal."""
        if start == goal:
            return []
        visited = np.full((H, W), False, dtype=bool)
        parent = {}
        q = deque([start])
        visited[start] = True
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                actions_rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        actions_rev.append(DOWN)
                    elif cur[0] == py - 1:
                        actions_rev.append(UP)
                    elif cur[1] == px + 1:
                        actions_rev.append(RIGHT)
                    elif cur[1] == px - 1:
                        actions_rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(actions_rev))
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if visited[ny, nx]:
                    continue
                if is_blocked(ny, nx):
                    continue
                visited[ny, nx] = True
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        return []  # No path found

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing the given kind."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Return a free neighbour of `cell` not in `avoid`."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not is_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal (arrow) and its recipe requirements
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos                     # (y, x)
    harvested = set()                       # cells already collected

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing; abort early.
                return actions

            # Choose a free adjacent cell to stand on while picking up.
            adj = adjacent_free(target, avoid=harvested)
            if adj is None:
                adj = target  # fallback to standing directly on the primitive

            # Move to the chosen adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (blocked move to set direction)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update internal grid model.
            grid[target[0], target[1], prim_idx] = 0
            harvested.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, avoid=harvested)
            if ws_adj is None:
                ws_adj = cur_pos  # stay where we are if no free neighbour
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop.
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting.
    actions.append(USE)

    return actions


    # Reset environment and get current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Action indices (consistent with CraftLab.action_specs)
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    H, W = grid.shape[:2]

    def in_bounds(y, x):
        return 0 <= y < H and 0 <= x < W

    def is_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return np.any(grid[y, x])

    def bfs_path(start, goal):
        """Shortest path (as a list of actions) from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        visited = np.full((H, W), False, dtype=bool)
        parent = {}
        q = deque([start])
        visited[start] = True
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                actions_rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        actions_rev.append(DOWN)
                    elif cur[0] == py - 1:
                        actions_rev.append(UP)
                    elif cur[1] == px + 1:
                        actions_rev.append(RIGHT)
                    elif cur[1] == px - 1:
                        actions_rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(actions_rev))
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if visited[ny, nx]:
                    continue
                if is_blocked(ny, nx):
                    continue
                visited[ny, nx] = True
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # No path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Return coordinates of the nearest cell containing the given kind."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Find a free neighbour of `cell` not in `avoid`."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not is_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos                     # (y, x)
    collected = set()                       # cells already emptied

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early
                return actions

            # Choose a free adjacent cell to stand on while picking up
            adj = adjacent_free(target, avoid=collected)
            if adj is None:
                # No free neighbour; fallback to standing directly on the primitive cell
                adj = target

            # Move to the adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (perform a blocked move to set direction)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update internal grid model: primitive disappears
            grid[target[0], target[1], prim_idx] = 0
            collected.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, avoid=collected)
            if ws_adj is None:
                ws_adj = ws_cell
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop (optional blocked move)
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting
    actions.append(USE)

    return actions

