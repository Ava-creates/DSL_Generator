    # --------------------------------------------------------------
    # Basic utilities: directions and BFS pathfinder
    # --------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT

    def bfs(start, targets, blocked):
        """Return a list of action ids that moves from ``start`` to the
        nearest cell in ``targets`` while avoiding ``blocked`` cells."""
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # No reachable target – should not happen for a solvable scenario
        return []

    # --------------------------------------------------------------
    # Helper to move to a cell containing ``kind_idx`` and USE it ``cnt`` times
    # --------------------------------------------------------------
    def acquire(kind_idx, cnt):
        """Collect ``cnt`` items of type ``kind_idx`` from the grid."""
        nonlocal pos, actions, grid
        for _ in range(cnt):
            # locate all cells that currently hold this kind
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            # find shortest path to the nearest such cell
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            # update position while walking
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # pick up the item
            actions.append(4)          # USE
            # remove it from our mutable copy of the grid
            grid[pos[0], pos[1], kind_idx] -= 1

    # --------------------------------------------------------------
    # Gather recipe information for the target item "arrow"
    # --------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    # ------------------------------------------------------------------
    # Resolve full dependency tree:
    #   * needed_prims – total primitive counts required
    #   * craft_steps  – ordered list of (item_idx, count) to craft
    # ------------------------------------------------------------------
    needed_prims = {}          # primitive idx → total count
    craft_steps = []           # (item_idx, count) in dependency order

    def resolve(item_idx, mul):
        """Recursively expand ``item_idx`` multiplying required count by ``mul``."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul
            return
        # Resolve ingredients first (ignore special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mul)
        # Schedule this item to be crafted after its ingredients
        craft_steps.append((item_idx, mul))

    resolve(arrow_idx, 1)

    # --------------------------------------------------------------
    # Static data: mutable copy of the grid, blocked cells, dimensions
    # --------------------------------------------------------------
    grid = env._current_state.grid.copy()
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # --------------------------------------------------------------
    # Build the final action sequence
    # --------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Collect every primitive required by the whole recipe tree
    for prim_idx, cnt in needed_prims.items():
        acquire(prim_idx, cnt)

    # 2) Perform crafting steps in the order produced by ``resolve``
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        workshop_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        # locate workshop cells
        workshop_cells = {(x, y) for x in range(w) for y in range(h)
                          if grid[x, y, workshop_idx] > 0}
        path = bfs(pos, workshop_cells, blocked)
        actions.extend(path)
        # update position after walking
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        # use the workshop the required number of times
        actions.extend([4] * cnt)   # USE

    return actions


