    actions = []
    spec = env.action_specs()
    DOWN = spec['DOWN']
    UP = spec['UP']
    LEFT = spec['LEFT']
    RIGHT = spec['RIGHT']
    USE = spec['USE']

    state = env._current_state
    pos = tuple(state.pos)

    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}

    # Work on a copy of the grid so we can “remove” items as we pick them up.
    grid = state.grid.copy()

    def _move(cur, tgt):
        """Return a list of actions to walk from cur to tgt using Manhattan steps."""
        moves = []
        dx = tgt[0] - cur[0]
        dy = tgt[1] - cur[1]
        while dx:
            if dx > 0:
                moves.append(DOWN)
                dx -= 1
            else:
                moves.append(UP)
                dx += 1
        while dy:
            if dy > 0:
                moves.append(RIGHT)
                dy -= 1
            else:
                moves.append(LEFT)
                dy += 1
        return moves

    # Collect each required primitive the required number of times.
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more of this primitive on the map; abort early.
                break
            # Choose the closest occurrence (Manhattan distance).
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1])
            )
            actions.extend(_move(pos, target))
            pos = target
            actions.append(USE)
            # Simulate picking up the item.
            grid[pos[0], pos[1], prim_idx] = 0

    # After gathering primitives, go to the appropriate workshop and craft.
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target = ws_locs[0]
            actions.extend(_move(pos, target))
            actions.append(USE)

    return actions


