    import numpy as np
    from collections import deque

    # Action indices as defined in CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Reset environment and obtain current state/world information
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # ------------------------------------------------------------------
    # Goal information: index of "arrow" and its primitive requirements
    # ------------------------------------------------------------------
    goal_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """Return True if the cell at ``pos`` contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs_path(start, goal):
        """
        Return the shortest walkable path from ``start`` to ``goal`` as a list
        of positions **including** both endpoints.  If no path exists, returns
        a list containing only ``start``.
        """
        if start == goal:
            return [start]
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            # No path found – return trivial path
            return [start]

        # reconstruct path (goal -> start)
        path = [goal]
        while path[-1] != start:
            path.append(visited[path[-1]])
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a position path (including start) to a list of movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the nearest cell (Manhattan) that contains ``kind``."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """
        Return a walkable neighbour of ``target`` (preferring N, S, W, E).
        If none are free, return ``target`` itself.
        """
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos  # current (y, x)

    # --------------------------------------------------------------
    # Collect all required primitive items
    # --------------------------------------------------------------
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive missing – abort early
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur, stand_pos)
            actions.extend(path_to_actions(path))
            cur = stand_pos

            # Step onto the primitive cell itself (may be same as stand_pos)
            path = bfs_path(cur, prim_loc)
            actions.extend(path_to_actions(path))
            cur = prim_loc

            # Pick up the primitive
            actions.append(USE)

            # Update local grid to reflect that the primitive has been taken
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # --------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            actions.extend(path_to_actions(path))
            cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Action indices (as defined in CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Initialise environment and obtain world information
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Goal item index and required primitive counts
    goal_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """True if cell contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs_path(start, goal):
        """Shortest walkable path from start to goal (excluding start)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            return []  # no path found

        # reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions to movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Return location of the nearest cell containing `kind` (Manhattan)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Find a walkable neighbour of `target` (prefer N,S,W,E)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target  # fallback (target itself is assumed walkable)

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos  # current (y, x)

    # Collect each required primitive the required number of times
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive missing – abort early
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur, stand_pos)
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive cell itself
            path = bfs_path(cur, prim_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid to reflect that the primitive has been taken
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # If the recipe specifies a workshop, travel there before crafting
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions

