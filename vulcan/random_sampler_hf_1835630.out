    import collections, numpy as np

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    world = getattr(env, "world", None)
    if world is None:
        state_wrap = getattr(env, "_current_state", None)
        if state_wrap is not None:
            world = getattr(state_wrap, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld not found in environment")
    cookbook = world.cookbook

    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)

    pos = tuple(state.pos)
    grid = state.grid.copy()
    occ = np.any(grid > 0, axis=2)

    actions = []
    harvested = set()

    for prim_idx, needed in primitives_needed.items():
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        gathered = 0
        for cell in cells:
            if gathered >= needed:
                break
            if cell in harvested:
                continue
            path = _bfs(pos, [cell], occ)
            actions.extend(path)
            for a in path:
                if a == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif a == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif a == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif a == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
            grid[cell[0], cell[1], prim_idx] = 0
            occ[cell[0], cell[1]] = False
            harvested.add(cell)
            gathered += 1

    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs(pos, [target_ws], occ)
            actions.extend(path)
            for a in path:
                if a == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif a == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif a == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif a == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)

    return actions


    import collections, numpy as np

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def bfs(start, targets, occupied):
        """Return a list of actions that brings the agent from *start* to a cell
        adjacent to any position in *targets* while avoiding occupied cells."""
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # stop when adjacent to a target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # explore neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no reachable target
        return []

    # ------------------------------------------------------------------
    # Locate world / cookbook objects (they may be stored in different places
    # depending on the wrapper used for the environment).
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        tmp_state = getattr(env, "_current_state", None)
        if tmp_state is not None:
            world = getattr(tmp_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state; reset the env if necessary.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal is the item named “arrow”.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Working copies of position and grid for planning.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)               # (x, y)
    cur_grid = state.grid.copy()         # (W, H, n_kinds)
    occupied = np.any(cur_grid > 0, axis=2)   # boolean mask of blocked cells

    actions = []
    harvested = set()                    # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells that currently contain this primitive.
        locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Greedy order: nearest first.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = bfs(pos, [loc], occupied)
            actions.extend(path)
            # Update position following the path.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Mark the cell empty for future planning.
            cur_grid[loc[0], loc[1], prim_idx] = 0
            occupied[loc[0], loc[1]] = False
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index – may be a string name.
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str) else workshop_key)
        # Locate workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop.
            path = bfs(pos, [target_ws], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use the workshop to craft the arrow.
            actions.append(USE)

    return actions

