    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _move_to(pos, target, seq):
        """Append moves to bring `pos` (list [x, y]) to `target` (list [x, y])."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Return the (x, y) of the nearest cell containing `kind_idx`."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # Determine starting position.
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Copy the initial grid to track collected items.
    grid = env.scenario.init_grid.copy()

    # Goal index.
    goal_idx = env.task.goal

    actions = []

    # Collect primitives needed for the goal.
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Primitive not found; abort planning.
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)                         # pick up the item
            grid[target[1], target[0], kind_idx] = 0    # mark as taken

    # Move to workshop (if required) and craft the goal.
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)                         # craft at workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _move_to(pos, target, seq):
        """Append moves that bring mutable ``pos`` (list [x, y]) to ``target``."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Return the (x, y) of the nearest cell containing ``kind_idx``."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Determine starting position.
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the static grid to keep track of collected items.
    grid = env.scenario.init_grid.copy()

    # Goal index comes from the task stored in the environment.
    goal_idx = env.task.goal

    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal.
    # ------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()

    # If the goal itself is a primitive, we also need to pick it up.
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Primitive not found – abort planning.
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)                         # pick up the item
            grid[target[1], target[0], kind_idx] = 0    # mark as taken

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)                         # craft at workshop
        else:
            # No workshop found; attempt to craft at current location.
            actions.append(USE)
    else:
        # No specific workshop required – just use the action to craft.
        actions.append(USE)

    return actions

