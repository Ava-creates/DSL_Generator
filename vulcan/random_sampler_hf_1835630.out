    # --------------------------------------------------------------
    # Bread‑first search over the (state, action‑sequence) graph
    # --------------------------------------------------------------
    from collections import deque, namedtuple

    # a compact hashable representation of a CraftState
    def _state_key(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    Node = namedtuple("Node", ["state", "actions"])
    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 400                         # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # default action space size

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long candidates
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # ------------------------------------------------------------------
    # No plan found within the search budget – return empty plan.
    # ------------------------------------------------------------------
    return []

