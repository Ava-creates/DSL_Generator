    import collections, numpy as np

    # Action indices as defined in CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs(start, targets, occ):
        """Return a list of actions that moves the agent from *start* to a cell
        adjacent to any position in *targets* while avoiding occupied cells."""
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop when adjacent to a target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Explore neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Locate the world / cookbook objects (they may be stored in different
    # places depending on the environment wrapper).
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        tmp_state = getattr(env, "_current_state", None)
        if tmp_state is not None:
            world = getattr(tmp_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state; reset the env if necessary.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal is the item named “arrow”.
    # ------------------------------------------------------------------
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Working copies of position and grid for planning.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)               # (x, y)
    cur_grid = state.grid.copy()         # (W, H, n_kinds)
    occupied = np.any(cur_grid > 0, axis=2)   # boolean mask of blocked cells

    actions = []
    harvested = set()                    # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells that currently contain this primitive.
        locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Greedy order: nearest first.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs(pos, [loc], occupied)
            actions.extend(path)
            # Update position following the path.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Mark the cell empty for future planning.
            cur_grid[loc[0], loc[1], prim_idx] = 0
            occupied[loc[0], loc[1]] = False
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index – may be a string name.
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str) else workshop_key)
        # Locate workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop.
            path = _bfs(pos, [target_ws], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use the workshop to craft the arrow.
            actions.append(USE)

    return actions


    import collections
    import numpy as np

    # Action indices as defined in CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: shortest‑path (BFS) that stops when the agent is adjacent to any
    # target cell.  It avoids cells that are occupied (any non‑zero kind).
    # ----------------------------------------------------------------------
    def _bfs(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable target
        return []

    # ----------------------------------------------------------------------
    # Locate the world / cookbook objects (may be stored in different places
    # depending on the wrapper used for the environment).
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        tmp_state = getattr(env, "_current_state", None)
        if tmp_state is not None:
            world = getattr(tmp_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Ensure we have a current state; reset the env if necessary.
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ----------------------------------------------------------------------
    # Goal is the item named “arrow”.
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Working copies for planning.
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    occupied = np.any(grid > 0, axis=2)        # bool mask of blocked cells
    inventory = state.inventory.copy()         # current counts

    actions = []
    harvested = set()                          # cells already used for collection

    # ----------------------------------------------------------------------
    # Collect each required primitive, taking into account what we already
    # have in the inventory.
    # ----------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        already_have = int(inventory[prim_idx])
        need = required_cnt - already_have
        if need <= 0:
            continue

        # All locations that currently contain this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Greedy order: nearest first.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))

        gathered = 0
        for loc in locations:
            if gathered >= need:
                break
            if loc in harvested:
                continue

            # Move adjacent to the primitive.
            path = _bfs(pos, [loc], occupied)
            actions.extend(path)

            # Update position following the path.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick it up.
            actions.append(USE)

            # Mark cell empty for future planning.
            grid[loc[0], loc[1], prim_idx] = 0
            occupied[loc[0], loc[1]] = False
            harvested.add(loc)
            gathered += 1

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index – may be a string name.
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str) else workshop_key)

        # Locate workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]

            # Move adjacent to the workshop.
            path = _bfs(pos, [target_ws], occupied)
            actions.extend(path)

            # Update position.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Craft at the workshop.
            actions.append(USE)

    else:
        # No specific workshop required – just use to craft.
        actions.append(USE)

    return actions

