    actions = []
    # Reset the environment to obtain the initial state.
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Identify the index for the target item "arrow".
    arrow_idx = cookbook.index["arrow"]

    # Determine which primitive resources are required to craft an arrow.
    primitives_needed = cookbook.primitives_for(arrow_idx)  # {kind_idx: count}

    # Locate the workshop index required for crafting the arrow (if any).
    recipe = cookbook.recipes.get(arrow_idx, {})
    workshop_idx = recipe.get("_at")

    # Helper: find all positions on the grid that currently contain a given kind.
    def find_positions(kind_idx):
        coords = np.argwhere(state.grid[:, :, kind_idx] > 0)
        return [tuple(coord) for coord in coords]

    # Helper: move the agent step‑by‑step towards a target cell using Manhattan moves.
    def move_towards(target):
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move down (increase row index)
                act = 0  # DOWN
            elif x > tx:        # need to move up
                act = 1  # UP
            elif y < ty:        # need to move right (increase column index)
                act = 3  # RIGHT
            else:               # y > ty, move left
                act = 2  # LEFT
            actions.append(act)
            _, new_state = state.step(act)
            state = new_state

    # Collect each required primitive the necessary number of times.
    for kind_idx, count in primitives_needed.items():
        for _ in range(count):
            positions = find_positions(kind_idx)
            if not positions:
                # Primitive not present; abort early.
                return actions
            # Choose the closest instance (Manhattan distance).
            cur_x, cur_y = state.pos
            distances = [abs(px - cur_x) + abs(py - cur_y) for (px, py) in positions]
            target = positions[int(np.argmin(distances))]
            move_towards(target)
            # Pick up the primitive.
            actions.append(4)  # USE
            _, new_state = state.step(4)
            state = new_state

    # After gathering all primitives, go to the appropriate workshop and craft.
    if workshop_idx is not None:
        workshop_positions = find_positions(workshop_idx)
        if workshop_positions:
            cur_x, cur_y = state.pos
            distances = [abs(px - cur_x) + abs(py - cur_y) for (px, py) in workshop_positions]
            target = workshop_positions[int(np.argmin(distances))]
            move_towards(target)
            # Perform the crafting action.
            actions.append(4)  # USE
            _, new_state = state.step(4)
            state = new_state

    return actions


