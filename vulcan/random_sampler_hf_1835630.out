    # Reset environment and obtain initial references
    env.reset()
    state = env._current_state
    world = env.world

    # Action constants as defined by CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _manhattan_path(src, dst):
        """Return a list of actions that moves from src to dst using a simple
        Manhattan walk (first vertical, then horizontal)."""
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    def _nearest(grid, kind_idx, start):
        """Find the Manhattan‑closest cell containing the given kind."""
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    def _any(grid, kind_idx):
        """Return any cell that contains the given kind (used for workshops)."""
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        # Arrow not defined in the cookbook – nothing to do.
        return []

    # Primitive requirements for a single arrow
    needed = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ----------------------------------------------------------------------
    # Collect all required primitives (respecting multiplicities)
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = _nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # Primitive missing from the map – abort early.
                return action_seq

            # Move to the primitive location.
            for a in _manhattan_path(state.pos, target):
                _, _, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)

            # Pick it up.
            _, _, _ = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    # ----------------------------------------------------------------------
    # If the recipe requires a specific workshop, go there before crafting.
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _manhattan_path(state.pos, workshop_pos):
                _, _, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)

    # ----------------------------------------------------------------------
    # Final craft action (USE) at the current location (workshop or open ground)
    # ----------------------------------------------------------------------
    _, _, _ = env.step(USE)
    action_seq.append(USE)

    return action_seq


    # Reset the environment and obtain the initial state.
    env.reset()
    state = env._current_state
    world = env.world

    # Action indices as defined by CraftLab.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: Manhattan‑distance path (list of actions) from src to dst.
    # ----------------------------------------------------------------------
    def _manhattan_path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ----------------------------------------------------------------------
    # Helper: Find the nearest cell (Manhattan distance) containing a kind.
    # ----------------------------------------------------------------------
    def _nearest_cell(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ----------------------------------------------------------------------
    # Helper: Return any cell containing a given kind (used for workshops).
    # ----------------------------------------------------------------------
    def _any_cell(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ----------------------------------------------------------------------
    # Identify the index for the goal item ("arrow").
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # Arrow not defined in the recipe set.
        return []

    # ----------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ----------------------------------------------------------------------
    required = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    plan = []

    # ----------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ----------------------------------------------------------------------
    for prim_idx, count in required.items():
        for _ in range(count):
            target = _nearest_cell(state.grid, prim_idx, state.pos)
            if target is None:
                # Primitive missing from the world – abort early.
                return plan
            for a in _manhattan_path(state.pos, target):
                _, _, _ = env.step(a)
                state = env._current_state
                plan.append(a)
            # Pick up the primitive.
            _, _, _ = env.step(USE)
            state = env._current_state
            plan.append(USE)

    # ----------------------------------------------------------------------
    # If the recipe specifies a workshop, move to it before crafting.
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any_cell(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _manhattan_path(state.pos, workshop_pos):
                _, _, _ = env.step(a)
                state = env._current_state
                plan.append(a)

    # ----------------------------------------------------------------------
    # Final craft action (USE) at the current location (workshop or open ground).
    # ----------------------------------------------------------------------
    _, _, _ = env.step(USE)
    plan.append(USE)

    return plan

