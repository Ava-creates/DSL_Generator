    import numpy as np

    # ----------------------------------------------------------------------
    # Helper to move from current position to a target cell using Manhattan steps
    # ----------------------------------------------------------------------
    def _move_actions(cur_pos, target, act_map):
        cx, cy = cur_pos
        tx, ty = target
        acts = []
        # horizontal moves (x axis)
        while cx < tx:
            acts.append(act_map["RIGHT"])
            cx += 1
        while cx > tx:
            acts.append(act_map["LEFT"])
            cx -= 1
        # vertical moves (y axis)
        while cy < ty:
            acts.append(act_map["DOWN"])
            cy += 1
        while cy > ty:
            acts.append(act_map["UP"])
            cy -= 1
        return acts, (cx, cy)

    # ----------------------------------------------------------------------
    # Retrieve action index mapping from the environment
    # ----------------------------------------------------------------------
    action_map = {k: v for k, v in env.action_specs().items()}

    # ----------------------------------------------------------------------
    # Get the underlying world objects and recipe information
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Identify the goal item ("arrow") and its recipe
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # primitives required to craft one arrow (primitive_idx -> count)
    needed_prims = cookbook.primitives_for(goal_idx)

    # ----------------------------------------------------------------------
    # Track simulated position and inventory while building the plan
    # ----------------------------------------------------------------------
    # reset the environment to obtain a fresh state (but do NOT step it)
    _ = env.reset()
    state = env._current_state          # current CraftState after reset
    cur_pos = tuple(state.pos)          # (x, y)
    inventory = np.copy(state.inventory)  # mutable copy

    # ----------------------------------------------------------------------
    # Function to locate the nearest cell containing a given kind index
    # ----------------------------------------------------------------------
    def _nearest_position(kind_idx, cur):
        grid_layer = state.grid[..., kind_idx]
        positions = np.argwhere(grid_layer > 0)
        if positions.size == 0:
            return None
        dists = np.sum(np.abs(positions - np.array(cur)), axis=1)
        return tuple(positions[dists.argmin()])

    # ----------------------------------------------------------------------
    # 1) Collect all required primitives
    # ----------------------------------------------------------------------
    plan_actions = []

    for prim_idx, required_cnt in needed_prims.items():
        while inventory[prim_idx] < required_cnt:
            # locate nearest primitive of this type
            target_pos = _nearest_position(prim_idx, cur_pos)
            if target_pos is None:
                # No more primitives of this type on the map – abort planning
                return plan_actions
            # move to the primitive
            move_acts, cur_pos = _move_actions(cur_pos, target_pos, action_map)
            plan_actions.extend(move_acts)
            # pick it up
            plan_actions.append(action_map["USE"])
            inventory[prim_idx] += 1  # simulate successful pickup

    # ----------------------------------------------------------------------
    # 2) Go to the appropriate workshop and craft the arrow
    # ----------------------------------------------------------------------
    # The workshop type is stored under the special key "_at" in the recipe
    workshop_kind = None
    recipe_dict = cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe_dict:
        workshop_kind = recipe_dict["_at"]
    else:
        # fallback: some recipes store the workshop as an integer directly
        for k, v in recipe_dict.items():
            if isinstance(k, int) and k not in needed_prims:
                workshop_kind = k
                break

    if workshop_kind is not None:
        target_ws = _nearest_position(workshop_kind, cur_pos)
        if target_ws is not None:
            move_acts, cur_pos = _move_actions(cur_pos, target_ws, action_map)
            plan_actions.extend(move_acts)
            # craft at the workshop
            plan_actions.append(action_map["USE"])
            inventory[goal_idx] += 1  # simulate successful crafting

    # ----------------------------------------------------------------------
    # Return the complete list of action indices
    # ----------------------------------------------------------------------
    return plan_actions


    # reset environment
    obs = env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # index of the target item and its recipe
    arrow_idx = cookbook.index["arrow"]
    req = cookbook.primitives_for(arrow_idx)          # primitive -> count
    recipe = cookbook.recipes[arrow_idx]

    # find workshop index from the recipe
    workshop_idx = None
    for k, v in recipe.items():
        if isinstance(k, str):                         # usually the "_at" key
            if isinstance(v, str):
                workshop_idx = cookbook.index.get(v, None)
            else:
                workshop_idx = v

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
    # that brings the agent from start to any cell in `targets`.
    # ------------------------------------------------------------------
    def bfs(start, targets):
        from collections import deque
        w, h, _ = state.grid.shape
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate([(0, 1), (0, -1), (-1, 0), (1, 0)]):  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    blocked = state.grid[nx, ny, :].sum() != 0
                    if not blocked or (nx, ny) in targets:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return None

    # ------------------------------------------------------------------
    # Collect all required primitives.
    # ------------------------------------------------------------------
    while True:
        inv = state.inventory
        need = None
        for p_idx, cnt in req.items():
            if inv[p_idx] < cnt:
                need = p_idx
                break
        if need is None:
            break

        # locate a cell that contains the needed primitive
        positions = np.argwhere(state.grid[..., need] > 0)
        if len(positions) == 0:
            raise RuntimeError("Required primitive not found on the map")
        tx, ty = positions[0]

        # compute empty neighbours of that cell (where we can stand)
        w, h, _ = state.grid.shape
        adj = []
        for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:
            ax, ay = tx + dx, ty + dy
            if 0 <= ax < w and 0 <= ay < h and state.grid[ax, ay, :].sum() == 0:
                adj.append((ax, ay))

        path = bfs(state.pos, set(adj))
        if path is None:
            raise RuntimeError("No path to required primitive")

        # walk to the neighbour cell
        for a in path:
            reward, done, _ = env.step(a)
            actions.append(a)
            state = env._current_state

        # pick up the primitive (USE)
        reward, done, _ = env.step(4)
        actions.append(4)
        state = env._current_state

    # ------------------------------------------------------------------
    # Go to the workshop and craft the arrow.
    # ------------------------------------------------------------------
    if workshop_idx is None:
        raise RuntimeError("Workshop index not found for arrow")

    workshop_cells = np.argwhere(state.grid[..., workshop_idx] > 0)
    if len(workshop_cells) == 0:
        raise RuntimeError("Workshop cell not present in the map")
    wx, wy = workshop_cells[0]

    adj = []
    w, h, _ = state.grid.shape
    for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:
        ax, ay = wx + dx, wy + dy
        if 0 <= ax < w and 0 <= ay < h and state.grid[ax, ay, :].sum() == 0:
            adj.append((ax, ay))

    path = bfs(state.pos, set(adj))
    if path is None:
        raise RuntimeError("No path to workshop")

    for a in path:
        reward, done, _ = env.step(a)
        actions.append(a)
        state = env._current_state

    # craft the arrow (USE at workshop)
    reward, done, _ = env.step(4)
    actions.append(4)

    return actions

