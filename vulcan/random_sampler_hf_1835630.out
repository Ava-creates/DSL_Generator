    # -----------------------------------------------------------------
    # Helper: BFS path planning avoiding non‑grabbable entities.
    # Returns a list of actions moving from start → target.
    # -----------------------------------------------------------------
    import collections

    def bfs(start, target):
        """Return list of actions from start to target (inclusive of target cell)."""
        width, height = grid.shape[:2]

        # Cells occupied by any non‑grabbable entity are blocked.
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Allow stepping onto the target even if it contains a non‑grabbable
        # (e.g., a workshop). This does not affect the BFS expansion.
        blocked[target[0], target[1]] = False

        # BFS structures
        q = collections.deque([start])
        parent = {start: None}
        act_to = {}

        # Direction vectors paired with action constants
        directions = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in directions:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        # Reconstruct action list
        path = []
        cur = target
        while cur != start:
            path.append(act_to[cur])
            cur = parent[cur]
        path.reverse()
        return path

