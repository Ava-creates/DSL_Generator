    # Safety limits
    MAX_STEPS = 300
    n_actions = getattr(world, "n_actions", 5)  # default to 5 actions (including USE)

    # Prefer the USE action first, then movement actions (order may vary)
    # Assuming USE is the last action index (common in CraftWorld)
    ordered_actions = list(range(n_actions - 1, -1, -1))

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Depth limit to keep search tractable
        if len(node.actions) >= MAX_STEPS:
