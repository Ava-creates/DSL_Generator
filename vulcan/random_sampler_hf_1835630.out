    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Resolve action indices (use defaults if missing)
    # ----------------------------------------------------------------------
    spec = getattr(env, "action_specs", lambda: {})()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _in_bounds(pos, shape):
        x, y = pos
        w, h = shape
        return 0 <= x < w and 0 <= y < h

    def _neighbors(pos, shape):
        x, y = pos
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if _in_bounds((nx, ny), shape):
                yield (nx, ny)

    def _bfs(start, goal_set, blocked):
        """
        Bread‑first search from ``start`` to any cell in ``goal_set``.
        ``blocked`` is a 2‑D bool array where True means the cell cannot be entered.
        Returns a list of positions (including start) representing the path,
        or ``None`` if no path exists.
        """
        w, h = blocked.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        dq = deque([start])
        visited[start] = True
        while dq:
            cur = dq.popleft()
            if cur in goal_set:
                # reconstruct path (list of positions)
                path = [cur]
                while path[-1] != start:
                    path.append(prev[path[-1]])
                path.reverse()
                return path
            for nb in _neighbors(cur, (w, h)):
                if not visited[nb] and not blocked[nb]:
                    visited[nb] = True
                    prev[nb] = cur
                    dq.append(nb)
        return None

    def _positions_to_actions(path):
        """
        Convert a list of positions (including the starting cell) into a list
        of movement actions using the resolved action indices.
        """
        act_list = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 > x0:
                act_list.append(RIGHT)
            elif x1 < x0:
                act_list.append(LEFT)
            elif y1 > y0:
                act_list.append(DOWN)
            elif y1 < y0:
                act_list.append(UP)
        return act_list

    # ----------------------------------------------------------------------
    # Access world, current state and cookbook
    # ----------------------------------------------------------------------
    world = env.world
    state = env._current_state
    grid = state.grid.copy()                     # copy to simulate pickups
    shape = grid.shape[:2]                       # (WIDTH, HEIGHT)

    # ----------------------------------------------------------------------
    # Identify the goal item ("arrow") and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = world.cookbook.index["arrow"]
    except Exception as e:
        raise RuntimeError("Could not locate goal index for 'arrow'") from e

    recipe = world.cookbook.recipes.get(goal_idx, {})

    # ----------------------------------------------------------------------
    # Determine primitive requirements (expanded to base primitives)
    # ----------------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    # ----------------------------------------------------------------------
    # Build a blocked map (cells that cannot be entered)
    # ----------------------------------------------------------------------
    blocked = np.zeros(shape, dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Planning helpers
    # ----------------------------------------------------------------------
    cur_pos = tuple(state.pos)   # (x, y)
    actions = []                 # final action list

    def _move_to(target):
        """Move the agent from cur_pos to target, updating actions & cur_pos."""
        nonlocal cur_pos, actions
        if cur_pos == target:
            return True
        path = _bfs(cur_pos, {target}, blocked)
        if path is None:
            return False
        actions.extend(_positions_to_actions(path))
        cur_pos = target
        return True

    # ----------------------------------------------------------------------
    # Collect each required primitive
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        while needed > 0:
            # locate all cells still containing this primitive
            locs = np.argwhere(grid[:, :, prim_idx] > 0)
            if locs.size == 0:
                # no more of this primitive on the map – abort collection
                break
            # pick the nearest location (Manhattan distance heuristic)
            dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])
            nearest_idx = int(np.argmin(dists))
            target = tuple(locs[nearest_idx])

            # move to the primitive cell (it is traversable)
            if not _move_to(target):
                # unreachable – remove this cell from consideration and continue
                grid[target[0], target[1], prim_idx] = 0
                continue

            # pick up as many as needed (one USE per unit)
            available = int(grid[target[0], target[1], prim_idx])
            take = min(available, needed)
            actions.extend([USE] * take)

            # update simulated grid and remaining count
            grid[target[0], target[1], prim_idx] -= take
            needed -= take

    # ----------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    workshop_name = recipe.get("_at") or recipe.get("_key")
    if workshop_name is not None:
        # resolve workshop index (string name or already an int)
        if isinstance(workshop_name, int):
            workshop_idx = workshop_name
        else:
            workshop_idx = world.cookbook.index.get(workshop_name)
        if workshop_idx is not None:
            ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
            if ws_cells.size > 0:
                # choose the nearest workshop cell
                dists = np.abs(ws_cells[:, 0] - cur_pos[0]) + np.abs(ws_cells[:, 1] - cur_pos[1])
                ws_target = tuple(ws_cells[int(np.argmin(dists))])
                # move onto the workshop cell (it is not blocked)
                _move_to(ws_target)

    # ----------------------------------------------------------------------
    # Final USE to perform the crafting
    # ----------------------------------------------------------------------
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action mapping from the environment (fallback to default indices)
    # ----------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions from start to the
    # nearest cell in *targets*. Cells that contain any entity are treated as
    # blocked unless they are one of the target cells.
    # ----------------------------------------------------------------------
    def _bfs(start, targets, grid):
        width, height = grid.shape[:2]
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                # Blocked if any kind occupies the cell and it's not a target.
                if np.any(grid[nx, ny, :]) and (nx, ny) not in targets:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        return None

    # ----------------------------------------------------------------------
    # Helper: apply a movement path to a position (used for simulation)
    # ----------------------------------------------------------------------
    def _apply_path(path, pos):
        x, y = pos
        for a in path:
            if a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
            elif a == LEFT:
                x -= 1
            elif a == RIGHT:
                x += 1
        return (x, y)

    # ----------------------------------------------------------------------
    # Access world, current state and cookbook
    # ----------------------------------------------------------------------
    world = env.world
    state = env._current_state
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Identify the goal ("arrow") and its recipe
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    recipe = cookbook.recipes.get(goal_idx, {})

    # ----------------------------------------------------------------------
    # Determine primitive requirements for the goal
    # ----------------------------------------------------------------------
    primitive_requirements = cookbook.primitives_for(goal_idx)

    # ----------------------------------------------------------------------
    # Work on a copy of the grid for planning purposes
    # ----------------------------------------------------------------------
    grid = state.grid.copy()
    pos = tuple(state.pos)          # (x, y)
    actions = []                    # final action list

    # ----------------------------------------------------------------------
    # Collect each required primitive
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        while needed > 0:
            # Find all cells that still contain this primitive
            locations = [(x, y) for x in range(grid.shape[0])
                         for y in range(grid.shape[1])
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                # No more of this primitive on the map; give up.
                break

            # Choose the nearest location (Manhattan distance)
            dists = [abs(x - pos[0]) + abs(y - pos[1]) for (x, y) in locations]
            target = locations[int(np.argmin(dists))]

            # Path to the target cell
            path = _bfs(pos, {target}, grid)
            if path is None:
                # Unreachable – remove this cell from future consideration
                locations.remove(target)
                continue

            # Record movement and update simulated position
            actions.extend(path)
            pos = _apply_path(path, pos)

            # Pick up the needed amount (may need multiple USEs)
            available = int(grid[target[0], target[1], prim_idx])
            take = min(available, needed)
            actions.extend([USE] * take)

            # Update simulated grid and remaining need
            grid[target[0], target[1], prim_idx] -= take
            needed -= take

    # ----------------------------------------------------------------------
    # Move to the appropriate workshop (if the recipe specifies one) and craft
    # ----------------------------------------------------------------------
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        # Resolve workshop index (string name or integer)
        if isinstance(workshop_name, int):
            workshop_idx = workshop_name
        else:
            workshop_idx = cookbook.index[workshop_name]

        # Locate all workshop cells
        workshop_cells = [(x, y) for x in range(grid.shape[0])
                          for y in range(grid.shape[1])
                          if grid[x, y, workshop_idx] > 0]

        if workshop_cells:
            # Choose nearest workshop cell
            dists = [abs(x - pos[0]) + abs(y - pos[1]) for (x, y) in workshop_cells]
            ws_target = workshop_cells[int(np.argmin(dists))]

            # Move to the workshop cell
            path = _bfs(pos, {ws_target}, grid)
            if path is not None:
                actions.extend(path)
                pos = _apply_path(path, pos)

    # Final USE to perform the crafting (at workshop or current location)
    actions.append(USE)

    return actions

