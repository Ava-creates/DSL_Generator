    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: Manhattan path (fallback when no obstacle‑aware path found)
    # ------------------------------------------------------------------
    def _manhattan_path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # Helper: BFS that respects passable kinds (empty cells + allowed kinds)
    # ------------------------------------------------------------------
    def _bfs_path(grid, start, goal, allowed_kinds):
        h, w, _ = grid.shape
        queue = collections.deque()
        queue.append((start, []))
        visited = {start}
        while queue:
            (r, c), path = queue.popleft()
            if (r, c) == goal:
                return path
            for act, (dr, dc) in ((DOWN, (1, 0)), (UP, (-1, 0)),
                                  (LEFT, (0, -1)), (RIGHT, (0, 1))):
                nr, nc = r + dr, c + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if (nr, nc) in visited:
                    continue
                cell_kinds = np.where(grid[nr, nc, :] > 0)[0]
                if cell_kinds.size == 0:
                    passable = True
                else:
                    # cell is passable if any of its kinds are in allowed_kinds
                    passable = any(k in allowed_kinds for k in cell_kinds)
                if passable:
                    visited.add((nr, nc))
                    queue.append(((nr, nc), path + [act]))
        return None

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a specific kind (Manhattan)
    # ------------------------------------------------------------------
    def _find_nearest(grid, kind_idx, start_pos):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start_pos[0]) + abs(j - start_pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: locate any cell containing a specific kind
    # ------------------------------------------------------------------
    def _find_any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Begin episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # ------------------------------------------------------------------
    # Identify arrow index
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []  # unknown goal

    # ------------------------------------------------------------------
    # Determine primitive requirements for one arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, need_cnt in primitive_needs.items():
        for _ in range(need_cnt):
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # cannot find the primitive – abort
                return action_seq

            # compute path respecting obstacles, allowing stepping on the target primitive
            path = _bfs_path(state.grid, state.pos, target, {prim_idx})
            if path is None:
                path = _manhattan_path(state.pos, target)

            # execute movement actions
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq

            # pick up the primitive
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # Craft the arrow at its workshop (if required)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_any(state.grid, workshop_idx)
        if workshop_pos is not None:
            path = _bfs_path(state.grid, state.pos, workshop_pos, {workshop_idx})
            if path is None:
                path = _manhattan_path(state.pos, workshop_pos)
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # perform crafting
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
    else:
        # No specific workshop – just attempt to craft in place
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # reset environment to start a new episode
    env.reset()
    state = env._current_state
    world = env.world

    # locate the index of the target item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # primitives needed for a single arrow
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    action_seq: list[int] = []

    # helper to find nearest cell containing a kind
    def _find_nearest(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # helper to find any cell containing a kind (used for workshop)
    def _find_any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # helper to generate Manhattan path actions from src to dst
    def _path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, qty in primitive_needs.items():
        for _ in range(qty):
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # primitive not present; abort
                return action_seq
            for a in _path(state.pos, target):
                _, _, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)
            # pick up the primitive
            _, _, _ = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _path(state.pos, workshop_pos):
                _, _, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)
    # perform the crafting action
    _, _, _ = env.step(USE)
    state = env._current_state
    action_seq.append(USE)

    return action_seq

