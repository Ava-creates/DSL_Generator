        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Allow stepping onto the target even if it is otherwise blocked
        blocked[target[0], target[1]] = False

        q = collections.deque([start])
        parent = {start: None}
        act_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        # Reconstruct action sequence.
        seq = []
        cur = target
        while cur != start:
            seq.append(act_to[cur])
            cur = parent[cur]
        seq.reverse()
        return seq

    # -----------------------------------------------------------------
    # Simple Manhattan fallback (ignores obstacles).
    # -----------------------------------------------------------------
    def manhattan_path(start, target):
        seq = []
        dx = target[0] - start[0]
        dy = target[1] - start[1]
        while dx > 0:
            seq.append(DOWN)
            dx -= 1
        while dx < 0:
            seq.append(UP)
            dx += 1
        while dy > 0:
            seq.append(RIGHT)
            dy -= 1
        while dy < 0:
            seq.append(LEFT)
            dy += 1
        return seq

    # -----------------------------------------------------------------
    # Helper to move to a location, updating pos and actions.
    # -----------------------------------------------------------------
    def move_to(target):
        nonlocal pos
        if pos == target:
            return
        path = bfs(pos, target)
        if path is None:
            path = manhattan_path(pos, target)
        actions.extend(path)
        pos = target

    # -----------------------------------------------------------------
    # Collect each required primitive the needed number of times,
    # taking current inventory into account.
    # -----------------------------------------------------------------
    for prim_idx, needed_cnt in required.items():
        have = int(inventory[prim_idx])
        to_collect = max(0, needed_cnt - have)

        for _ in range(to_collect):
            # Find all remaining instances of this primitive on the map
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more instances; assume we already have enough (or impossible)
                break

            # Choose the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            move_to(target)
            actions.append(USE)            # pick up the primitive

            # Update simulated world state
            grid[target[0], target[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # -----------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the goal.
    # -----------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target_ws = min(
                ws_locs,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            move_to(target_ws)
            actions.append(USE)            # craft at workshop
    else:
        # No specific workshop: just use the craft action at current location
        actions.append(USE)

    return actions

