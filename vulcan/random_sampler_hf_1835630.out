    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (DOWN/UP/LEFT/RIGHT)
    #         which ends with the agent standing next to *target_kind* and
    #         facing it, ready for a USE action.
    # ----------------------------------------------------------------------
    # Direction order matches the action constants used by CraftWorld:
    #   0: DOWN, 1: UP, 2: LEFT, 3: RIGHT
    deltas = [(1, 0), (-1, 0), (0, -1), (0, 1)]

    def _bfs_to_target(state, target_kind):
        grid = state.grid
        h, w, _ = grid.shape
        non_grab = env.world.non_grabbable_indices

        def in_bounds(r, c):
            return 0 <= r < h and 0 <= c < w

        def walkable(r, c):
            if not in_bounds(r, c):
                return False
            # a cell is blocked only by non‑grabbable entities
            return not np.any(grid[r, c, list(non_grab)])

        from collections import deque
        q = deque()
        start_r, start_c = state.pos
        start_dir = state.dir
        q.append((start_r, start_c, start_dir, []))
        visited = {(start_r, start_c, start_dir)}

        while q:
            r, c, d, acts = q.popleft()
            dr, dc = deltas[d]
            fr, fc = r + dr, c + dc
            if in_bounds(fr, fc) and grid[fr, fc, target_kind] > 0:
                return acts
            for a in range(4):
                nr, nc = r + deltas[a][0], c + deltas[a][1]
                if not walkable(nr, nc):
                    continue
                if (nr, nc, a) in visited:
                    continue
                visited.add((nr, nc, a))
                q.append((nr, nc, a, acts + [a]))
        # target not reachable
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    actions = []
    cur_state = env._current_state
    world = env.world
    goal_idx = env.task.goal

    # Primitive requirements for the goal (e.g., arrow)
    primitive_needs = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine workshop (if the recipe specifies one)
    workshop_kind = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    if isinstance(recipe, dict):
        workshop_name = recipe.get('_at')
        if workshop_name is not None:
            workshop_kind = world.cookbook.index.index(workshop_name)

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # --------------------------------------------------------------
    for prim_kind, count in primitive_needs.items():
        for _ in range(count):
            path = _bfs_to_target(cur_state, prim_kind)
            # If BFS failed, abort early – whatever actions we have are returned
            if path is None:
                return actions
            actions.extend(path)
            # Apply movement actions to keep cur_state in sync
            for a in path:
                _, cur_state = cur_state.step(a)
            # Use to pick up the primitive
            actions.append(4)          # USE
            _, cur_state = cur_state.step(4)

    # --------------------------------------------------------------
    # Move to the workshop (if any) and craft the goal item
    # --------------------------------------------------------------
    if workshop_kind is not None:
        path = _bfs_to_target(cur_state, workshop_kind)
        actions.extend(path)
        for a in path:
            _, cur_state = cur_state.step(a)
        actions.append(4)              # USE to craft at the workshop
        _, cur_state = cur_state.step(4)
    else:
        # No specific workshop – try crafting in place
        actions.append(4)              # USE
        _, cur_state = cur_state.step(4)

    return actions


    # Reset environment and get initial mutable state
    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # not defined
        return []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a sequence of actions (0‑4) moving the
    # agent so that the cell directly in front contains `target_kind`.
    # ------------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]          # width, height
        # direction deltas matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }
        non_grab = env.world.non_grabbable_indices

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            if not in_bounds(x, y):
                return False
            # cell must be completely empty (no entities of any kind)
            return not np.any(grid[x, y, :])

        start_pos = state.pos
        start_dir = state.dir
        from collections import deque
        queue = deque()
        queue.append((start_pos[0], start_pos[1], start_dir, []))
        visited = {(start_pos[0], start_pos[1], start_dir)}

        while queue:
            x, y, d, acts = queue.popleft()
            # Check if the cell directly ahead contains the target
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts
            # Expand possible movement actions (0‑3)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))
        # No reachable target
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_actions = _bfs_to_target(cur_state, prim_idx)
            if not move_actions and not cur_state.next_to(prim_idx):
                # Unable to reach the primitive – abort early
                return actions
            actions.extend(move_actions)
            actions.append(4)                     # USE to pick up
            # Apply actions to keep cur_state in sync
            for a in move_actions + [4]:
                _, cur_state = cur_state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        # workshop_name is a string; get its index
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_actions = _bfs_to_target(cur_state, workshop_idx)
        if move_actions:
            actions.extend(move_actions)
            actions.append(4)                     # USE to craft
            for a in move_actions + [4]:
                _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – just attempt crafting in place
        actions.append(4)                         # USE to craft
        _, cur_state = cur_state.step(4)

    return actions

