    # Initialise environment and obtain current state/world
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid.copy()             # mutable copy for planning

    # Action identifiers (as defined in CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """Return True if a non‑grabbable entity occupies ``pos``."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def heuristic(a, b):
        """Manhattan distance – admissible heuristic for A*."""
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    def a_star(start, goal):
        """Return a list of positions from start to goal (inclusive)."""
        if start == goal:
            return [start]
        h, w = grid.shape[:2]
        open_set = {start}
        came_from = {}
        g_score = {start: 0}
        f_score = {start: heuristic(start, goal)}
        while open_set:
            current = min(open_set, key=lambda p: f_score.get(p, np.inf))
            if current == goal:
                # reconstruct path
                path = [current]
                while current in came_from:
                    current = came_from[current]
                    path.append(current)
                path.reverse()
                return path
            open_set.remove(current)
            y, x = current
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    neighbor = (ny, nx)
                    if is_blocked(neighbor):
                        continue
                    tentative_g = g_score[current] + 1
                    if tentative_g < g_score.get(neighbor, np.inf):
                        came_from[neighbor] = current
                        g_score[neighbor] = tentative_g
                        f_score[neighbor] = tentative_g + heuristic(neighbor, goal)
                        open_set.add(neighbor)
        # unreachable
        return []

    def path_to_actions(path):
        """Translate a list of positions into movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the closest cell containing ``kind`` (Manhattan distance)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of ``target`` (N, S, W, E order)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target  # fallback (may be blocked)

    # --------------------------------------------------------------
    # Build the action sequence
    # --------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)   # current (y, x)

    # Goal item and its primitive requirements
    goal_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Collect each required primitive the needed number of times
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            prim_loc = nearest_cell(prim_idx, cur_pos)
            if prim_loc is None:
                # Primitive not present – abort early
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = a_star(cur_pos, stand_pos)
            if not path:
                return actions
            actions.extend(path_to_actions(path))
            cur_pos = stand_pos

            # Move onto the primitive cell itself
            path = a_star(cur_pos, prim_loc)
            if not path:
                return actions
            actions.extend(path_to_actions(path))
            cur_pos = prim_loc

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid – primitive has been collected
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # If the recipe specifies a workshop, travel there before crafting
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur_pos)
        if ws_loc is not None:
            path = a_star(cur_pos, ws_loc)
            if path:
                actions.extend(path_to_actions(path))
                cur_pos = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions

