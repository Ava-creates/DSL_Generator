    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    actions = []

    # Starting position (use live state if available)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Working copy of the static grid (to mark collected primitives)
    grid = env.scenario.init_grid.copy()

    cookbook = env.world.cookbook
    # Simulated inventory for planning purposes
    inventory = np.zeros(cookbook.n_kinds, dtype=int)

    def _move_to(target):
        """Append Manhattan moves that bring ``cur_pos`` to ``target``."""
        while cur_pos[0] != target[0] or cur_pos[1] != target[1]:
            if cur_pos[0] < target[0]:
                actions.append(RIGHT)
                cur_pos[0] += 1
            elif cur_pos[0] > target[0]:
                actions.append(LEFT)
                cur_pos[0] -= 1
            elif cur_pos[1] < target[1]:
                actions.append(DOWN)
                cur_pos[1] += 1
            elif cur_pos[1] > target[1]:
                actions.append(UP)
                cur_pos[1] -= 1

    def _nearest_kind(kind_idx):
        """Return coordinates of the nearest cell containing ``kind_idx``."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    def _ensure_primitive(kind_idx):
        """Collect one instance of a primitive ``kind_idx``."""
        target = _nearest_kind(kind_idx)
        if target is None:
            return False
        _move_to(target)
        actions.append(USE)                     # pick up
        grid[target[1], target[0], kind_idx] = 0  # mark as taken
        inventory[kind_idx] += 1
        return True

    def _craft_item(item_idx):
        """Recursively ensure ``item_idx`` is in inventory, crafting as needed."""
        if inventory[item_idx] > 0:
            return

        recipe = cookbook.recipes.get(item_idx, {})
        # Gather all ingredient items first
        for ing_idx, cnt in recipe.items():
            if ing_idx == "_at":
                continue
            for _ in range(cnt):
                if ing_idx in cookbook.primitives:
                    if not _ensure_primitive(ing_idx):
                        return
                else:
                    _craft_item(ing_idx)

        # Move to the required workshop (if any) and craft
        workshop = recipe.get("_at")
        if workshop is not None:
            wk_pos = _nearest_kind(workshop)
            if wk_pos is not None:
                _move_to(wk_pos)
        actions.append(USE)                     # craft at current location
        inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Plan for the goal item
    # ----------------------------------------------------------------------
    goal_idx = env.task.goal
    _craft_item(goal_idx)

    return actions

