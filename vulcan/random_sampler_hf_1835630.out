                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)   # USE to pick up the primitive

    # 2) Perform crafting steps at their respective workshops
    for item_idx, cnt in craft_steps:
        recipe = cookbook.recipes[item_idx]
        wk_key = recipe.get("_at", recipe.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        workshop_cells = {(x, y) for x in range(w) for y in range(h)
                          if grid[x, y, wk_idx] > 0}
        path = bfs(pos, workshop_cells)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * cnt)   # USE at workshop to craft the item

    return actions


    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}
    craft_steps = []

    def resolve(item_idx: int, mult: int) -> None:
        recipe = cookbook.recipes.get(item_idx)
        if recipe is None:  # primitive
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        for ing, cnt in recipe.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    grid = env._current_state.grid
    w, h, _ = grid.shape

    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT

    from collections import deque

    def bfs(start, targets):
        q = deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    actions = []
    pos = tuple(env._current_state.pos)

    # Collect primitives
    for kind_idx, count in needed_prims.items():
        for _ in range(count):
            primitive_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            path = bfs(pos, primitive_cells)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)  # USE to pick up

    # Perform crafting at workshops
    for item_idx, count in craft_steps:
        recipe = cookbook.recipes[item_idx]
        wk_key = recipe.get("_at", recipe.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        workshop_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}
        path = bfs(pos, workshop_cells)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * count)  # USE at workshop to craft

    return actions

