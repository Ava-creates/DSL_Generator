        return []

    # Initialise the start state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    # Helper that produces a hashable representation of a state
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_state_hash(init_state))

    # Search parameters
    MAX_STEPS = 2000                     # hard limit on plan length
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test – does the inventory contain at least one arrow?
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune paths that are already too long
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all primitive actions (movement + USE)
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If we exhaust the search without finding a solution, return empty plan
    return []

