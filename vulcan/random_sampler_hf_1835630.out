    # ------------------------------------------------------------------
    # Constants for actions
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    ACTION_DELTAS = {
        DOWN: (1, 0),
        UP: (-1, 0),
        LEFT: (0, -1),
        RIGHT: (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper: Breadth‑first search for a walkable path (ignoring the target
    # cell if it is occupied by the desired primitive or workshop)
    # ------------------------------------------------------------------
    def _bfs_path(src, dst, grid, allow_target=False):
        """Return a list of actions moving from src to dst avoiding blocked cells.

        If allow_target is False the destination cell itself must be empty;
        otherwise it may be occupied (used when we need to stand on a workshop
        or a primitive cell)."""
        h, w, _ = grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev = np.empty((h, w), dtype=object)

        q = collections.deque()
        q.append(src)
        visited[src] = True
        while q:
            r, c = q.popleft()
            if (r, c) == dst:
                break
            for act, (dr, dc) in ACTION_DELTAS.items():
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc]:
                    # cell is walkable if empty or (allow_target and it is the dst)
                    blocked = grid[nr, nc].sum() > 0
                    if blocked and not (allow_target and (nr, nc) == dst):
                        continue
                    visited[nr, nc] = True
                    prev[nr, nc] = (r, c, act)
                    q.append((nr, nc))
        else:
            # No path found
            return None

        # reconstruct actions
        actions = []
        cur = dst
        while cur != src:
            r, c, act = prev[cur]
            actions.append(act)
            cur = (r, c)
        actions.reverse()
        return actions

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind (Manhattan distance)
    # ------------------------------------------------------------------
    def _nearest_cell(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: locate any cell containing a given kind (used for workshops)
    # ------------------------------------------------------------------
    def _any_cell(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify goal index for 'arrow'
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # not defined in recipes
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting multiplicities)
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            target = _nearest_cell(state.grid, prim_idx, state.pos)
            if target is None:
                # Primitive not present – abort early
                return action_seq

            # Compute path to a cell adjacent to the primitive (or onto it if walkable)
            # Prefer standing on the primitive cell if it is walkable; otherwise stop next to it.
            path = _bfs_path(state.pos, target, state.grid, allow_target=True)
            if path is None:
                # try to get adjacent cell
                adj_found = False
                for act, (dr, dc) in ACTION_DELTAS.items():
                    adj = (target[0] + dr, target[1] + dc)
                    if 0 <= adj[0] < state.grid.shape[0] and 0 <= adj[1] < state.grid.shape[1]:
                        if state.grid[adj].sum() == 0:
                            path = _bfs_path(state.pos, adj, state.grid, allow_target=False)
                            if path is not None:
                                adj_found = True
                                break
                if not adj_found:
                    return action_seq

            # Execute movement actions
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq

            # Use action to pick up the primitive
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # Craft the arrow (move to workshop if required)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)

    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any_cell(state.grid, workshop_idx)
        if workshop_pos is not None:
            path = _bfs_path(state.pos, workshop_pos, state.grid, allow_target=True)
            if path is not None:
                for a in path:
                    reward, done, obs = env.step(a)
                    state = env._current_state
                    action_seq.append(a)
                    if done:
                        return action_seq
            # Craft at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
    else:
        # No specific workshop – attempt crafting in place
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq


    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: Manhattan path (list of actions) from src to dst
    # ----------------------------------------------------------------------
    def _path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ----------------------------------------------------------------------
    # Helper: locate the nearest cell (Manhattan) containing a given kind
    # ----------------------------------------------------------------------
    def _nearest(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ----------------------------------------------------------------------
    # Helper: locate any cell containing a given kind (used for workshops)
    # ----------------------------------------------------------------------
    def _any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ----------------------------------------------------------------------
    # Initialise episode
    # ----------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # ----------------------------------------------------------------------
    # Identify the goal index for "arrow"
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # arrow not defined in the recipe file
        return []

    # ----------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ----------------------------------------------------------------------
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ----------------------------------------------------------------------
    # Collect each required primitive (respecting multiplicities)
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = _nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # Primitive missing from the map – abort early
                return action_seq
            # Move to the primitive cell
            for a in _path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick up the primitive
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ----------------------------------------------------------------------
    # Craft the arrow: move to workshop if the recipe specifies one
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Use the workshop to craft
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
    else:
        # No specific workshop – attempt crafting in place
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq

