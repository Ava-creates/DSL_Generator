    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action / direction helpers (as defined by CraftLab)
    # ----------------------------------------------------------------------
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR_TO_ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search returning a list of actions that moves the agent
    # from ``start`` to a cell adjacent to any cell in ``targets``.
    # ----------------------------------------------------------------------
    def bfs(start, targets, grid):
        """
        Parameters
        ----------
        start : tuple (x, y)
            Current agent position.
        targets : list of (x, y)
            Cells we want to become adjacent to.
        grid : np.ndarray (W, H, K)
            Current world grid. Any non‑zero entry in the last axis counts as
            an obstacle for movement.

        Returns
        -------
        list[int]
            Sequence of action indices that brings the agent adjacent to a
            target cell. May be empty if already adjacent or if no path exists.
        """
        W, H = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)

        sx, sy = start

        # Quick check: already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    # Current state (the environment holds a CraftLab wrapper around a CraftState).
    state = env._current_state
    grid = state.grid.copy()               # mutable copy of the world grid
    pos = tuple(state.pos)                 # (x, y)

    # Goal item index (the task stores a ``goal`` attribute – may be an int or a struct).
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal not found in env.task")

    # ------------------------------------------------------------------
    # 1. Determine which primitive resources are needed to craft the goal.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []  # final list of actions to return

    # ------------------------------------------------------------------
    # 2. Collect each primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        while needed > 0:
            # Locate all cells that currently contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present – cannot continue planning.
                return plan

            # Find a path to the nearest primitive (adjacent cell).
            path = bfs(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Simulate the movement so that ``pos`` stays in sync.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use (collect) the primitive.
            plan.append(ACTION_USE)

            # Determine which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update our local grid copy (remove one instance) and decrement counter.
            grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
            needed -= 1

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (could be name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            # Simulate final movement.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(ACTION_USE)

    return plan


    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Action / direction helpers (as defined in CraftLab)
    # ------------------------------------------------------------------
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ------------------------------------------------------------------
    # Bread‑first search: returns a list of actions that moves the agent
    # from ``start`` to a cell adjacent (Manhattan distance 1) to any
    # cell in ``targets`` while avoiding blocked cells.
    # ------------------------------------------------------------------
    def bfs(start, targets, grid):
        W, H = grid.shape[:2]          # grid dimensions (width, height)
        blocked = np.any(grid > 0, axis=2)   # any occupied cell is blocked

        sx, sy = start

        # already adjacent to a target?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # check adjacency to any target
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # no reachable adjacency
        return []

    # ------------------------------------------------------------------
    # Initialise state information
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()                 # mutable copy of world grid
    pos = tuple(state.pos)                   # (x, y)

    # Goal index is stored in the task definition
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive requirements for the goal (recursive expansion)
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        while cnt > 0:
            # locate all cells that currently contain this primitive
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # primitive unavailable – abort planning
                return plan

            # compute path to the nearest reachable primitive (adjacent)
            path = bfs(pos, cells.tolist(), grid)
            plan.extend(path)

            # simulate movement to keep ``pos`` up‑to‑date
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # pick up the primitive
            plan.append(ACTION_USE)

            # find which primitive cell we are now adjacent to
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                break   # unexpected; avoid infinite loop

            # update local grid copy and decrement needed count
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # resolve workshop index (may be a name or an integer)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # craft by using the workshop
            plan.append(ACTION_USE)

    return plan

