    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """Hashable representation of a CraftState for visited checking."""
        # Position, direction, inventory contents and the entire grid layout
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_PLAN_LEN = 500                     # safety cutoff
    n_actions = getattr(world, "n_actions", 5)   # typically 4 moves + USE

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: do we already have an arrow?
        if cur_state.satisfies("", target_idx):
            return cur_actions

        # Prune overly long trajectories
        if len(cur_actions) >= MAX_PLAN_LEN:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, cur_actions + [a]))

    # No plan found within the search budget
    return []


