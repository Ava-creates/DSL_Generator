    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helper: map movement vectors to action indices (as defined in CraftLab)
    # ----------------------------------------------------------------------
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }

    # ----------------------------------------------------------------------
    # Bread‑first search that returns a list of actions moving from `start`
    # to a cell that is adjacent to any cell in `target_cells`.
    # ----------------------------------------------------------------------
    def bfs(start, target_cells, grid):
        """Return actions to reach a neighbour of one of `target_cells`."""
        w, h = grid.shape[:2]                     # width, height
        blocked = np.any(grid > 0, axis=2)        # any occupied cell blocks movement
        sx, sy = start

        # already adjacent?
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((w, h), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # check adjacency to any target cell
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # no reachable neighbour – return empty list (fallback)
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy for planning
    pos = state.pos                   # (x, y)

    # Goal index (the item we must make)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Cannot determine goal index from environment.")

    # ------------------------------------------------------------------
    # 1. Determine primitive requirements for the goal.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    # If the recipe is empty, the goal itself may be a primitive we just need to pick up.
    if not primitives_needed:
        primitives_needed = {goal_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # 2. Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        while needed_cnt > 0:
            # locate cells that currently contain this primitive
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # cannot find required primitive – abort planning
                break

            # find path to a neighbour of the nearest primitive cell
            path = bfs(pos, prim_cells.tolist(), grid)
            actions.extend(path)

            # update simulated position
            for a in path:
                dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # use the primitive (pick it up)
            actions.append(4)   # USE

            # remove one instance from the simulated grid and decrement counter
            # find a primitive cell adjacent to current position
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is not None:
                grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
                needed_cnt -= 1
            else:
                # should not happen; break to avoid infinite loop
                break

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")   # support both possible keys

    if workshop_key is not None:
        # workshop may be given as a name (string) – resolve to index
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            actions.extend(path)

            # update simulated position
            for a in path:
                dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # finally use the workshop to craft the item
            actions.append(4)   # USE

    return actions


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helper: map movement vectors to the action indices used by CraftLab
    # ----------------------------------------------------------------------
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }

    # ----------------------------------------------------------------------
    # Bread‑first search that returns a list of actions moving the agent from
    # `start` to a cell that is *adjacent* (Manhattan distance 1) to any cell
    # in `targets`.  Cells occupied by any entity are considered blocked.
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, targets, grid):
        H, W = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)

        # Early exit if already adjacent
        sx, sy = start
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((H, W), False, dtype=bool)
        visited[sy, sx] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:
                    if blocked[ny, nx]:
                        continue
                    new_path = path + [act]
                    # check adjacency to any target cell
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return new_path
                    visited[ny, nx] = True
                    q.append((nx, ny, new_path))
        # No reachable adjacent cell
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    # Reset (or just read) the current state
    state = env._current_state
    grid = state.grid.copy()          # mutable copy for planning
    pos = state.pos                   # (x, y)

    # Goal: make an arrow
    arrow_idx = env.world.cookbook.index.get('arrow')
    if arrow_idx is None:
        raise ValueError("Arrow item not found in cookbook index.")

    # Primitive requirements for ONE arrow (expanded recursively)
    needed = env.world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        while count > 0:
            # locate all cells that currently hold this primitive
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                raise RuntimeError(f"Required primitive {prim_idx} not present on the map.")
            # choose the nearest primitive (Manhattan distance)
            dists = np.abs(prim_cells - np.array(pos)).sum(axis=1)
            target_cell = tuple(prim_cells[dists.argmin()])   # (x, y)

            # move adjacent to the chosen primitive
            path = bfs_adjacent(pos, [target_cell], grid)
            actions.extend(path)
            # update simulated position
            for a in path:
                dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # use action to pick up the primitive
            actions.append(4)   # USE
            # update simulated grid: remove one instance from the primitive cell
            grid[target_cell[1], target_cell[0], prim_idx] -= 1
            count -= 1

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(arrow_idx, {})
    workshop_key = recipe.get('_at')
    if workshop_key is None:
        # No explicit workshop – nothing else to do
        return actions

    # Resolve workshop index (may be a string name)
    if isinstance(workshop_key, str):
        workshop_idx = env.world.cookbook.index[workshop_key]
    else:
        workshop_idx = workshop_key

    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        raise RuntimeError("Workshop for arrow not found on the map.")

    # pick the nearest workshop cell
    dists = np.abs(workshop_cells - np.array(pos)).sum(axis=1)
    target_ws = tuple(workshop_cells[dists.argmin()])

    # move adjacent to the workshop
    path = bfs_adjacent(pos, [target_ws], grid)
    actions.extend(path)
    for a in path:
        dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]
        pos = (pos[0] + dx, pos[1] + dy)

    # final USE to craft the arrow
    actions.append(4)   # USE

    return actions

