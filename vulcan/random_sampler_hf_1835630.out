    import collections
    import numpy as np

    # Action indices (as defined in the environment)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `start`
    # to a cell adjacent (Manhattan distance ≤ 1) to any cell in `targets`.
    # `blocked` is a boolean mask where True means the cell cannot be entered.
    # ----------------------------------------------------------------------
    def _bfs_path(start, targets, blocked):
        w, h = blocked.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop if we are adjacent (or on) any target cell.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand 4‑connected neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable position – return empty list (will cause failure later).
        return []

    # ----------------------------------------------------------------------
    # Locate the underlying CraftWorld instance.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers keep the world inside the current state.
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = getattr(state_tmp, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")

    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Goal is fixed to the item named "arrow".
    # ----------------------------------------------------------------------
    if "arrow" not in cookbook.index.contents:
        raise ValueError("Goal item 'arrow' not defined in the recipe file.")
    goal_idx = cookbook.index["arrow"]
    primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary).
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        if hasattr(env, "reset"):
            env.reset()
        state = getattr(env, "_current_state", None)
        if state is None:
            raise RuntimeError("Environment does not expose a current state after reset.")

    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()              # mutable copy of the world grid
    blocked = np.any(grid > 0, axis=2)    # True = occupied / non‑walkable

    actions = []
    harvested = set()                     # cells already used for collection

    # ----------------------------------------------------------------------
    # Collect each required primitive, nearest‑first.
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        # All cells currently holding this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive cell.
            path = _bfs_path(pos, [loc], blocked)
            actions.extend(path)
            # Update internal position.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Mark the cell as empty for future navigation.
            grid[loc[0], loc[1], prim_idx] = 0
            blocked[loc[0], loc[1]] = False
            harvested.add(loc)
            collected += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or int).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        # Locate workshop cells currently present.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            path = _bfs_path(pos, [target_ws], blocked)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
        else:
            # No visible workshop – just use at current location.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions that moves the agent from
    # `start` to a cell adjacent (Manhattan distance == 1) to any cell in
    # `targets`. `occupied` is a boolean mask where True means the cell
    # cannot be entered.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, occupied):
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop if we are adjacent to any target cell.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable position.
        return []

    # ------------------------------------------------------------------
    # Locate the underlying CraftWorld instance.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = getattr(state_tmp, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")

    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal is the item named "arrow".
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal item '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]
    primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        if hasattr(env, "reset"):
            env.reset()
        state = getattr(env, "_current_state", None)
        if state is None:
            raise RuntimeError("Environment does not expose a current state after reset.")

    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()              # mutable copy of the world grid
    occupied = np.any(grid > 0, axis=2)   # True = blocked cell

    actions = []
    harvested = set()                     # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            path = _bfs_path(pos, [loc], occupied)
            actions.extend(path)
            # Update simulated position.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Mark cell as empty for future navigation.
            grid[loc[0], loc[1], prim_idx] = 0
            occupied[loc[0], loc[1]] = False
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            path = _bfs_path(pos, [target_ws], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
        else:
            # No visible workshop; attempt to craft in place.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions

