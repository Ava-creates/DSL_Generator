    # reset environment and get handles
    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid

    # action indices
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    from collections import deque

    H, W = grid.shape[:2]
    non_grab = list(world.non_grabbable_indices)

    def bfs_path(start, goal):
        """Shortest path avoiding non‑grabbable cells."""
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                actions = []
                cur = goal
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        actions.append(DOWN)
                    elif py == cur[0] + 1:
                        actions.append(UP)
                    elif px == cur[1] - 1:
                        actions.append(RIGHT)
                    elif px == cur[1] + 1:
                        actions.append(LEFT)
                    cur = (py, px)
                return list(reversed(actions))
            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    if np.any(grid[ny, nx, non_grab] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        return []  # no path found

    def find_nearest(kind, from_pos):
        """Coordinates of the nearest cell containing ``kind``."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        idx = int(np.argmin(dists))
        return tuple(locs[idx])

    # ------------------------------------------------------------------
    # Determine goal and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                return actions
            ty, tx = target

            # pick a free adjacent cell
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < H and 0 <= nx < W:
                    if not np.any(grid[ny, nx, non_grab] > 0):
                        adj = (ny, nx)
                        break
            if adj is None:
                adj = target

            # move to adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # set direction towards the primitive
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # pick up
            actions.append(USE)

            # update grid to reflect that the primitive has been taken
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # craft
    actions.append(USE)

    return actions


    # Reset the environment and obtain current state information.
    env.reset()
    state = env._current_state
    world = env.world
    # Work on a copy of the grid so we can update it as items are collected.
    grid = state.grid.copy()
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    # Indices of entities that block movement (cannot be grabbed).
    non_grab = list(world.non_grabbable_indices)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque

    def bfs(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding non‑grabbable
        obstacles. ``start`` and ``goal`` are (y, x) tuples."""
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # Reconstruct actions from start to goal.
                actions = []
                cur = goal
                while cur != start:
                    py, px = prev[cur]
                    dy, dx = cur[0] - py, cur[1] - px
                    if dy == 1:
                        actions.append(DOWN)
                    elif dy == -1:
                        actions.append(UP)
                    elif dx == 1:
                        actions.append(RIGHT)
                    elif dx == -1:
                        actions.append(LEFT)
                    cur = (py, px)
                actions.reverse()
                return actions

            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                 (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # Cell is blocked if any non‑grabbable entity occupies it.
                    if np.any(grid[ny, nx, non_grab] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list (should not happen for valid tasks).
        return []

    def find_nearest(kind, from_pos):
        """Return the coordinates (y, x) of the nearest cell that contains
        ``kind`` (primitive or workshop). If none exists, return None."""
        locations = np.argwhere(grid[:, :, kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = int(np.argmin(dists))
        return tuple(locations[nearest_idx])

    # ------------------------------------------------------------------
    # Determine goal index for 'arrow' and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the appropriate number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on before using.
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    if not np.any(grid[ny, nx, non_grab] > 0):
                        adj = (ny, nx)
                        break
            if adj is None:
                # Fallback: stand directly on the primitive cell.
                adj = target

            # Move to the chosen adjacent cell.
            actions += bfs(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (issue a movement action that will be blocked).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update the grid to reflect that the primitive has been collected.
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions

