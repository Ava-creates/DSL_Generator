    # Reset environment and get initial state
    env.reset()
    act_map = env.action_specs()
    move_delta = {"UP": (-1, 0), "DOWN": (1, 0), "LEFT": (0, -1), "RIGHT": (0, 1)}
    actions = []

    # Helper BFS to find path (list of action names) to a cell adjacent to any target cell
    def bfs_to_adjacent(start, targets, grid):
        from collections import deque
        W, H = grid.shape[:2]
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        target_set = set(targets)
        while q:
            pos, path = q.popleft()
            # check adjacency (Chebyshev distance <=1)
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path
            for act, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                    if grid[nx, ny].sum() == 0:  # empty cell
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return None

    # Goal and recipe information
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # Collect each required primitive the required number of times
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            state = env._current_state
            grid = state.grid
            pos = state.pos
            # locate all cells containing the primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                raise RuntimeError(f"Primitive {prim_idx} not found on map.")
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                raise RuntimeError(f"Cannot reach primitive {prim_idx} from {pos}.")
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)
            # pick up
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # Move to workshop if needed and craft
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not found.")
        path = bfs_to_adjacent(pos, workshop_cells, grid)
        if path is None:
            raise RuntimeError("Workshop unreachable.")
        for act_name in path:
            act_id = act_map[act_name]
            actions.append(act_id)
            env.step(act_id)

    # Final USE to craft (or to pick up if no workshop)
    actions.append(act_map["USE"])
    env.step(act_map["USE"])
    return actions


    # Reset the environment and prepare helpers
    env.reset()
    act_map = env.action_specs()  # e.g. {"UP":0, "DOWN":1, ...}
    move_delta = {"UP": (-1, 0), "DOWN": (1, 0), "LEFT": (0, -1), "RIGHT": (0, 1)}
    goal_idx = env.task.goal
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    actions: list[int] = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving the agent
    # from `start` to a cell adjacent (Chebyshev distance ≤ 1) to any
    # cell in `targets`.  Walks only through empty cells.
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_to_adjacent(start: tuple[int, int],
                        targets: list[tuple[int, int]],
                        grid: np.ndarray) -> list[str] | None:
        W, H = grid.shape[:2]
        visited: set[tuple[int, int]] = {start}
        q: deque[tuple[tuple[int, int], list[str]]] = deque()
        q.append((start, []))
        target_set = set(targets)

        while q:
            pos, path = q.popleft()
            # Check adjacency to any target cell
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path
            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                    # Walk only through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    # ------------------------------------------------------------------
    # 1) Collect all required primitives (respecting counts)
    # ------------------------------------------------------------------
    while True:
        state = env._current_state
        inventory = state.inventory
        # Done when we have at least the required amount of each primitive
        if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):
            break

        # Find a primitive that is still missing
        for p_idx, cnt in needed_prims.items():
            if inventory[p_idx] < cnt:
                missing_idx = p_idx
                break

        # Locate all cells that currently contain this primitive
        prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))
        if not prim_cells:
            raise RuntimeError(f"Required primitive {missing_idx} not found on the map.")

        # Plan a path to an adjacent cell of the nearest primitive
        path = bfs_to_adjacent(state.pos, prim_cells, state.grid)
        if path is None:
            raise RuntimeError(f"Primitive {missing_idx} is unreachable from position {state.pos}.")

        # Execute movement actions
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

        # Pick up the primitive with the USE action
        use_aid = act_map["USE"]
        actions.append(use_aid)
        env.step(use_aid)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not found on the map.")
        path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

    # Final USE to craft (or to pick up if no workshop is needed)
    final_use = act_map["USE"]
    actions.append(final_use)
    env.step(final_use)

    return actions

