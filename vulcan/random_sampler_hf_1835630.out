    import collections, numpy as np

    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from start to the
    # nearest cell adjacent to any goal cell, avoiding occupied squares.
    # ----------------------------------------------------------------------
    def _bfs(start, goals, occ):
        """Return action list to reach a cell adjacent to a goal.

        Args:
            start: (x, y) tuple of current position.
            goals: iterable of (x, y) goal positions.
            occ: 2‑D bool array where True == blocked.

        Returns:
            List[int] of actions (may be empty if already adjacent).
        """
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        goal_set = set(goals)

        # If already adjacent to a goal, no movement needed.
        for gx, gy in goal_set:
            if abs(start[0] - gx) + abs(start[1] - gy) == 1:
                return []

        while q:
            x, y, path = q.popleft()
            # Check adjacency to any goal
            for gx, gy in goal_set:
                if abs(x - gx) + abs(y - gy) == 1:
                    return path
            # Explore neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:          # free cell
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No path found – return empty list (will likely fail later)
        return []

    # ----------------------------------------------------------------------
    # Extract world, cookbook and current state
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # env may be a CraftWorld directly
        world = env
    cookbook = world.cookbook

    # Ensure we have a current CraftState; reset if necessary
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Goal information
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Current position and static grid
    pos = tuple(state.pos)
    grid = state.grid.copy()               # (W, H, n_kinds)
    occupied = np.any(grid > 0, axis=2)    # True where any entity exists

    actions = []
    harvested = set()                      # cells already collected

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest first)
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # Locate all cells that currently contain this primitive
        prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position
        prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        gathered = 0
        for cell in prim_cells:
            if gathered >= needed_cnt:
                break
            if cell in harvested:
                continue
            # Path to a square adjacent to the primitive cell
            path = _bfs(pos, [cell], occupied)
            actions.extend(path)
            # Update position following the path
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use action to pick up the primitive
            actions.append(USE)
            # Mark the cell as empty for subsequent navigation
            grid[cell[0], cell[1], prim_idx] = 0
            occupied[cell[0], cell[1]] = False
            harvested.add(cell)
            gathered += 1

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
