    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )

    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    state = env._current_state
    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()              # occupancy tensor
    inventory = state.inventory.copy()    # current inventory
    actions = []

    from collections import deque

    def bfs(start, target):
        """Return a list of movement actions from start to target, or None."""
        w, h = grid.shape[:2]

        # Cells that cannot be entered: any non‑grabbable entity present
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((w, h), dtype=bool)

        # Allow stepping on the target even if it would otherwise be blocked
        blocked[target[0], target[1]] = False

        q = deque([start])
        parent = {start: None}
        action_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        action_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        # Reconstruct actions
        path = []
        cur = target
        while cur != start:
            path.append(action_to[cur])
            cur = parent[cur]
        path.reverse()
        return path

    def move_to(target):
        """Move the simulated agent to *target*, updating pos and actions."""
        nonlocal pos
        if pos == target:
            return
        path = bfs(pos, target)
        if path is None:
            # Fallback: simple Manhattan moves (ignores obstacles)
            dx, dy = target[0] - pos[0], target[1] - pos[1]
            path = []
            while dx > 0:
                path.append(DOWN)
                dx -= 1
            while dx < 0:
                path.append(UP)
                dx += 1
            while dy > 0:
                path.append(RIGHT)
                dy -= 1
            while dy < 0:
                path.append(LEFT)
                dy += 1
        actions.extend(path)
        pos = target

    # --------------------------------------------------------------------- #
    # Collect required primitives (taking inventory into account)
    # --------------------------------------------------------------------- #
    for prim_idx, req_cnt in needed.items():
        have = int(inventory[prim_idx])
        need = max(0, req_cnt - have)

        for _ in range(need):
            # Locate remaining instances of the primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more instances on the map; stop trying for this primitive
                break

            # Choose the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            # Move to it and pick it up
            move_to(target)
            actions.append(USE)  # pick up

            # Update simulated world state
            grid[target[0], target[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # --------------------------------------------------------------------- #
    # Move to the appropriate workshop (if any) and craft the goal item.
    # --------------------------------------------------------------------- #
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            # Choose nearest workshop
            target_ws = min(
                ws_locs,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            move_to(target_ws)
            actions.append(USE)  # craft at workshop

    return actions


    import numpy as np
    import collections

    # --------------------------------------------------------------------- #
    # Action indices
    # --------------------------------------------------------------------- #
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )

    # --------------------------------------------------------------------- #
    # Goal and required primitive counts
    # --------------------------------------------------------------------- #
    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    # --------------------------------------------------------------------- #
    # Current state snapshot
    # --------------------------------------------------------------------- #
    state = env._current_state
    pos = tuple(state.pos)                 # (x, y)
    grid = state.grid.copy()                # occupancy tensor (W, H, n_kinds)
    inventory = state.inventory.copy()
    actions = []

    # --------------------------------------------------------------------- #
    # Helper: BFS path finder returning a list of movement actions.
    # --------------------------------------------------------------------- #
    def bfs(start, target):
        """Return list of movement actions from start to target, or None."""
        width, height = grid.shape[:2]

        # Cells occupied by non‑grabbable entities cannot be entered.
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # The target cell is allowed even if it is otherwise blocked
        blocked[target[0], target[1]] = False

        q = collections.deque([start])
        came_from = {start: None}
        action_to = {}

        # (action, (dx, dy))
        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_to[nxt] = act
                        q.append(nxt)

        if target not in came_from:
            return None

        # Reconstruct the action list
        path = []
        cur = target
        while cur != start:
            path.append(action_to[cur])
            cur = came_from[cur]
        path.reverse()
        return path

    # --------------------------------------------------------------------- #
    # Determine which primitives are still missing (inventory may already hold some)
    # --------------------------------------------------------------------- #
    missing = {}
    for prim_idx, cnt in needed.items():
        have = int(inventory[prim_idx]) if prim_idx < len(inventory) else 0
        if cnt > have:
            missing[prim_idx] = cnt - have

    # --------------------------------------------------------------------- #
    # Collect each missing primitive
    # --------------------------------------------------------------------- #
    for prim_idx, count in missing.items():
        for _ in range(count):
            # Locate all remaining instances of this primitive on the grid
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # Primitive not found – give up on this item
                break

            # Choose the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            # Plan a path to the target
            path = bfs(pos, target)
            if path is None:
                # Fallback: simple Manhattan moves (ignores obstacles)
                dx, dy = target[0] - pos[0], target[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1

            # Execute movement and pick‑up
            actions.extend(path)
            actions.append(USE)

            # Update simulated state
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0
            # (inventory update not required for planning)

    # --------------------------------------------------------------------- #
    # Move to the workshop (if the recipe specifies one) and craft the goal
    # --------------------------------------------------------------------- #
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locations:
            # Choose nearest workshop
            target_ws = min(
                ws_locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = bfs(pos, target_ws)
            if path is None:
                # Manhattan fallback
                dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1
            actions.extend(path)
            actions.append(USE)  # craft at the workshop

    return actions

