    import numpy as np

    # Action indices as defined in the environment
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Helper to move from one cell to another using Manhattan moves
    def _move(cur, target, act_list):
        x, y = cur
        tx, ty = target
        # move in x direction
        while x < tx:
            act_list.append(RIGHT)
            x += 1
        while x > tx:
            act_list.append(LEFT)
            x -= 1
        # move in y direction
        while y < ty:
            act_list.append(DOWN)
            y += 1
        while y > ty:
            act_list.append(UP)
            y -= 1
        return (x, y)

    # Access world and current state
    world = env.world
    state = env._current_state

    # Identify the index of the goal item (arrow)
    try:
        goal_idx = world.cookbook.index["arrow"]
    except Exception:
        # fallback to the goal stored in the task, if available
        goal_idx = getattr(getattr(env, "task", None), "goal", None)
        if goal_idx is None:
            raise RuntimeError("Could not determine goal index for arrow.")

    # Determine which primitive resources are needed for the arrow
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    actions = []
    cur_pos = tuple(state.pos)

    # Collect each required primitive
    for prim_idx, needed in primitive_requirements.items():
        # Find at least one cell that contains this primitive
        locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
        if locations.size == 0:
            # Primitive not present – cannot craft, skip
            continue
        target = tuple(locations[0])
        cur_pos = _move(cur_pos, target, actions)
        # Pick up the required amount (use action once per unit)
        for _ in range(needed):
            actions.append(USE)

    # Finally move to the workshop where the arrow can be crafted
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_key")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.get(workshop_name)
        if workshop_idx is not None:
            ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
            if ws_locs.size > 0:
                workshop_pos = tuple(ws_locs[0])
                cur_pos = _move(cur_pos, workshop_pos, actions)
                actions.append(USE)  # craft the arrow

    return actions


    # Reset the environment to start a new episode
    env.reset()
    actions = []

    # Determine a reasonable step limit (fallback to 1000 if not defined)
    max_steps = getattr(env, "max_steps", 1000)

    # Main loop: keep acting until the task is completed or we hit the step limit
    while len(actions) < max_steps:
        # First try the USE action (index 4) which handles both collection and crafting
        actions.append(4)  # USE
        reward, done, _ = env.step(4)
        if done:
            break

        # Obtain the current state to decide a simple exploration move
        state = env._current_state
        x, y = state.pos
        width, height = state.grid.shape[0], state.grid.shape[1]

        # Simple deterministic movement: head towards the centre of the map
        # Choose horizontal direction
        if x < width // 2:
            move = 3  # RIGHT
        else:
            move = 2  # LEFT

        actions.append(move)
        reward, done, _ = env.step(move)
        if done:
            break

        # Choose vertical direction on the next iteration
        # (alternating moves helps cover the area without getting stuck)
        if y < height // 2:
            move = 0  # DOWN
        else:
            move = 1  # UP

        actions.append(move)
        reward, done, _ = env.step(move)
        if done:
            break

    return actions

