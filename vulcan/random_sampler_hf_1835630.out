    # Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions
            # Choose a free adjacent cell to stand on before using.
            adj = adjacent_free(target, avoid=collected_cells)
            if adj is None:
                # No free neighbor; fall back to standing on the primitive cell
                # (only possible if the cell itself becomes free after previous pickups).
                adj = target
                if is_blocked(*adj):
                    return actions
            # Move to the adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj
