    # ------------------------------------------------------------------
    # Helper: move the agent from its current position (list [x, y])
    # towards a target position (list [x, y]), appending actions to `seq`.
    # ------------------------------------------------------------------
    def _move_to(cur, target, seq):
        while cur[0] != target[0] or cur[1] != target[1]:
            if cur[0] < target[0]:
                seq.append(RIGHT)
                cur[0] += 1
            elif cur[0] > target[0]:
                seq.append(LEFT)
                cur[0] -= 1
            elif cur[1] < target[1]:
                seq.append(DOWN)
                cur[1] += 1
            elif cur[1] > target[1]:
                seq.append(UP)
                cur[1] -= 1

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell that currently contains at least one
    # instance of the specified `kind_idx`. Returns [x, y] or None.
    # ------------------------------------------------------------------
    def _nearest_kind(kind_idx, cur_pos, grid):
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

