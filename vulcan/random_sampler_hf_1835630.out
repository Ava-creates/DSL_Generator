    # ------------------------------------------------------------------
    # Determine which primitive kinds and how many of each are needed to
    # craft a single arrow.  `primitives_for` expands recipes recursively.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:                     # arrow itself may be a primitive
        needed = {arrow_idx: 1}

    plan = []

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, amount in needed.items():
        for _ in range(amount):
            seq = _bfs_to_target(state, prim_idx)
            if seq is None:            # cannot reach this primitive
                return plan
            plan.extend(seq)
            plan.append(4)              # USE to pick it up
            # Apply the actions to keep `state` up‑to‑date
            for a in seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).  If the recipe
    # does not specify a workshop, we can craft in place.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = _bfs_to_target(state, workshop_idx)
        if seq is None:                # cannot reach workshop
            return plan
        plan.extend(seq)
        plan.append(4)                 # USE to craft
        for a in seq + [4]:
            _, state = state.step(a)
    else:
        plan.append(4)                 # USE to craft in place
        _, state = state.step(4)

    return plan

