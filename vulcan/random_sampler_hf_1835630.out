    world = env.world                   # CraftWorld
    # Work on a mutable copy of the grid so we can “remove” collected primitives locally
    grid = np.copy(state.grid)

    # Action indices (standard ordering in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions that walk from ``start`` to ``goal`` using
        a simple Manhattan walk (ignoring obstacles)."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell that currently contains ``kind_idx``."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def find_adjacent_free(cell):
        """Return a free (non‑blocked) orthogonal neighbour of ``cell`` if one exists,
        otherwise ``None``."""
        y, x = cell
        for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                # A cell is blocked if any non‑grabbable entity occupies it
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine the goal index and the primitive requirements for 'arrow'
    # ------------------------------------------------------------------
    goal_idx = world.cookbook.index.index('arrow')
    required_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos   # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in required_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early
                return actions

            # Choose a free adjacent cell to stand on; if none, stand on the primitive cell itself
            stand = find_adjacent_free(target)
            if stand is None:
                stand = target

            # Move to the chosen standing cell
            actions += manhattan_path(cur_pos, stand)
            cur_pos = stand

            # Face the primitive by taking one step towards it (the step may be blocked but sets direction)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Use action to pick up the primitive
            actions.append(USE)

            # Update our local copy of the grid to reflect that the primitive has been taken
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow
    actions.append(USE)

    return actions


    # Reset the environment and grab the current state/world.
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    # Work on a mutable copy of the grid so we can “remove” primitives once collected.
    grid = np.copy(state.grid)

    # Action indices (standard ordering in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions that walk from ``start`` to ``goal``."""
        actions = []
        y, x = start
        gy, gx = goal
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def nearest_cell(kind_idx, from_pos):
        """Find the nearest cell that currently contains ``kind_idx``."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a free (non‑blocked) neighbour of ``cell`` if one exists, else None."""
        y, x = cell
        for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                # A cell is considered blocked if any non‑grabbable entity occupies it
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        return None

    # ----------------------------------------------------------------------
    # Determine primitives required for the goal item ('arrow')
    # ----------------------------------------------------------------------
    goal_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ----------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ----------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = nearest_cell(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Choose a free adjacent cell to stand on (prefer a neighbour, else the cell itself)
            stand = free_adjacent(target)
            if stand is None:
                stand = target

            # Move to the chosen standing cell
            actions += manhattan_path(cur_pos, stand)
            cur_pos = stand

            # Face the primitive: add a single step towards it to set direction
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Remove the primitive from our local copy of the grid
            grid[target[0], target[1], prim_idx] = 0

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest_cell(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow
    actions.append(USE)

    return actions

