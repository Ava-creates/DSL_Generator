    import numpy as np
    from collections import deque

    # Reset the environment to a fresh state
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                    # (WIDTH, HEIGHT, n_kinds)
    H, W = grid.shape[:2]

    # Action indices (fallback to defaults if not present)
    specs = env.action_specs()
    DOWN = specs.get("DOWN", 0)
    UP = specs.get("UP", 1)
    LEFT = specs.get("LEFT", 2)
    RIGHT = specs.get("RIGHT", 3)
    USE = specs.get("USE", 4)

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal,
        avoiding cells occupied by non‑grabbable entities. The goal cell itself is
        allowed even if it contains a non‑grabbable entity (e.g., a workshop)."""
        if start == goal:
            return []
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        rev.append(DOWN)
                    elif py == cur[0] + 1:
                        rev.append(UP)
                    elif px == cur[1] - 1:
                        rev.append(RIGHT)
                    elif px == cur[1] + 1:
                        rev.append(LEFT)
                    cur = (py, px)
                rev.reverse()
                return rev
            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # If the neighbour is the goal we allow stepping onto it
                    if (ny, nx) != goal:
                        # Blocked if any non‑grabbable entity occupies the cell
                        if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                            continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – fall back to Manhattan moves (may hit obstacles)
        y0, x0 = start
        y1, x1 = goal
        actions = []
        dy = y1 - y0
        dx = x1 - x0
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing the given kind index."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine goal (arrow) and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort planning early
                return actions

            ty, tx = target

            # Choose a free adjacent cell to stand on before using
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < H and 0 <= nx < W:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; stand on the primitive cell itself
                adj = (ty, tx)

            # Move to the adjacent (or same) cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (add a movement direction towards it)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update the grid to reflect that the primitive has been taken
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions


