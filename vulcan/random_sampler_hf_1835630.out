    env.reset()
    cur_state = env._current_state
    world = env.world

    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sdir = state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    plan = []

    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            if move_seq is None:
                return plan
            plan.extend(move_seq)
            plan.append(4)
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        if move_seq is None:
            return plan
        plan.extend(move_seq)
        plan.append(4)
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        plan.append(4)
        _, cur_state = cur_state.step(4)

    return plan


