    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                    # (W, H, n_kinds)

    # Action IDs (as defined in CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(y, x):
        """Return True if cell (y,x) contains any non‑grabbable entity."""
        return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs_path(start, goal):
        """Shortest path from start to goal avoiding blocked cells.
        Returns a list of movement actions (DOWN/UP/LEFT/RIGHT)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = collections.deque([start])
        prev = {start: None}
        while q:
            y, x = q.popleft()
            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not is_blocked(ny, nx):
                    if (ny, nx) not in prev:
                        prev[(ny, nx)] = (y, x, act)
                        if (ny, nx) == goal:
                            # reconstruct actions
                            actions = []
                            cur = (ny, nx)
                            while prev[cur] is not None:
                                py, px, a = prev[cur]
                                actions.append(a)
                                cur = (py, px)
                            actions.reverse()
                            return actions
                        q.append((ny, nx))
        return []  # no path found

    def find_nearest(kind_idx, from_pos):
        """Coordinates of the nearest cell containing kind_idx."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine primitives needed for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the appropriate number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on before using.
            adj = None
            adj_facing = None
            for ny, nx, facing in (
                (ty - 1, tx, DOWN),   # stand above, face down
                (ty + 1, tx, UP),     # stand below, face up
                (ty, tx - 1, RIGHT),  # stand left, face right
                (ty, tx + 1, LEFT)    # stand right, face left
            ):
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked(ny, nx):
                    adj = (ny, nx)
                    adj_facing = facing
                    break

            if adj is None:
                # No free neighbour – stand on the primitive cell itself.
                adj = (ty, tx)
                adj_facing = None

            # Move to the chosen adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Adjust facing direction if we have a preferred orientation.
            if adj_facing is not None:
                actions.append(adj_facing)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions

