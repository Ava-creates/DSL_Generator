    # Action identifiers – match the default CraftWorld ordering.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions moving from `start` to a cell adjacent to any target."""
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        from collections import deque
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ----------------------------------------------------------------------
    # Retrieve world / state objects from the environment.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ----------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    if not primitives_needed:
        # Goal is a primitive – just use the current cell.
        return [USE]

    # ----------------------------------------------------------------------
    # Current grid, position and occupancy mask.
    # ----------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # Cells already collected from

    # ----------------------------------------------------------------------
    # Adjust for primitives already present in inventory.
    # ----------------------------------------------------------------------
    inv = state.inventory
    for prim_idx, need in list(primitives_needed.items()):
        have = int(inv[prim_idx]) if inv is not None else 0
        if have >= need:
            primitives_needed.pop(prim_idx)
        else:
            primitives_needed[prim_idx] = need - have

    # ----------------------------------------------------------------------
    # Collect each required primitive (nearest‑first).
    # ----------------------------------------------------------------------
    for prim_idx, need_cnt in primitives_needed.items():
        gathered = 0
        while gathered < need_cnt:
            # Locate remaining instances of this primitive not yet harvested.
            candidates = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not candidates:
                # No more of this primitive on the map; abort early.
                break

            # Choose the closest candidate (Manhattan distance).
            candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = candidates[0]

            # Plan path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # Update occupancy mask (cell becomes empty after pickup).
            occupied[target] = False

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string or int).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        # Find all workshop cells of the required type.
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Move to the nearest workshop.
            workshop_cells.sort(
                key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])
            )
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)  # craft at workshop
        else:
            # No workshop found – fallback to using current cell.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Action identifiers – match CraftWorld defaults.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions moving from `start` to a cell adjacent to any target."""
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Retrieve world / state objects from the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ------------------------------------------------------------------
    # Determine primitive requirements for one arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    if not primitives_needed:
        # Arrow itself is a primitive – just use it.
        return [USE]

    # ------------------------------------------------------------------
    # Current grid, position and occupancy mask.
    # ------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # locations already collected from

    # ------------------------------------------------------------------
    # Adjust for primitives already present in inventory.
    # ------------------------------------------------------------------
    inv = state.inventory
    for prim_idx, need in list(primitives_needed.items()):
        have = int(inv[prim_idx]) if inv is not None else 0
        if have >= need:
            primitives_needed.pop(prim_idx)
        else:
            primitives_needed[prim_idx] = need - have

    # ------------------------------------------------------------------
    # Collect each required primitive (nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        collected = 0
        while collected < required_cnt:
            # Locate remaining instances of this primitive not yet harvested.
            candidates = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not candidates:
                # No more of this primitive on the map; abort early.
                break

            # Choose the closest candidate (Manhattan distance).
            candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = candidates[0]

            # Plan path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement to keep `pos` up‑to‑date.
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            collected += 1

            # Update occupancy mask (cell becomes empty after pickup).
            occupied[target] = False

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string or int).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        # Find all workshop cells of the required type.
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Move to the nearest workshop.
            workshop_cells.sort(
                key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])
            )
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)  # craft at workshop
        else:
            # No workshop found – fallback to using current cell.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions

