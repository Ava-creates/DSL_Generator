    def is_free(y, x):
        """Return True if the cell (y, x) is traversable (no non‑grabbable entity)."""
        if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):
            return False
        return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs(start, goal, allow_goal_blocked=False):
        """
        Bread‑first search from start to goal returning a list of movement actions.
        If allow_goal_blocked is False the goal cell must also be free.
        """
        from collections import deque
        sy, sx = start
        gy, gx = goal
        if not allow_goal_blocked and not is_free(gy, gx):
            return None

        visited = set()
        visited.add((sy, sx))
        queue = deque()
        queue.append((sy, sx, []))

        while queue:
            y, x, path = queue.popleft()
            if (y, x) == (gy, gx):
                return path
            for act, (dy, dx) in MOVE_DELTAS.items():
                ny, nx = y + dy, x + dx
                if (0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and
                        (ny, nx) not in visited and is_free(ny, nx)):
                    visited.add((ny, nx))
                    queue.append((ny, nx, path + [act]))
        return None  # no path found

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a free orthogonal neighbour of `cell` (or None if none exists)."""
        y, x = cell
        for dy, dx in [( -1, 0), (1, 0), (0, -1), (0, 1)]:
            ny, nx = y + dy, x + dx
            if is_free(ny, nx):
                return (ny, nx)
        return None

    def direction_to(src, dst):
        """Return the movement action that moves one step from src towards dst."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1 and dx == 0:
            return DOWN
        if dy == -1 and dx == 0:
            return UP
        if dy == 0 and dx == 1:
            return RIGHT
        if dy == 0 and dx == -1:
            return LEFT
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives for ``arrow``
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort planning.
                return actions

            # Choose a free adjacent cell to stand on; fall back to the primitive cell itself.
            stand = free_adjacent(target) or target

            # Plan a path to the chosen standing position.
            path_to_stand = bfs(cur_pos, stand, allow_goal_blocked=False)
            if path_to_stand is None:
                # No reachable path – abort.
                return actions
            actions.extend(path_to_stand)
            cur_pos = stand

            # Face the primitive (optional but helpful for USE).
            turn = direction_to(cur_pos, target)
            if turn is not None:
                actions.append(turn)
                # Update current position if the turn action actually moves onto the primitive.
                dy, dx = MOVE_DELTAS[turn]
                cur_pos = (cur_pos[0] + dy, cur_pos[1] + dx)

            # Pick up the primitive.
            actions.append(USE)

            # Mark the primitive as collected in the planning grid.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            path_to_ws = bfs(cur_pos, ws_cell, allow_goal_blocked=False)
            if path_to_ws is not None:
                actions.extend(path_to_ws)
                cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions

