    # ----------------------------------------------------------------------
    # Helper utilities -------------------------------------------------------
    # ----------------------------------------------------------------------
    import collections

    # direction mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    def bfs(start, goal_cells, blocked):
        """Return list of direction indices to reach any cell in goal_cells."""
        w, h = start_grid.shape[:2]
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # should not happen for reachable goals

    # ----------------------------------------------------------------------
    # Access world / recipe information --------------------------------------
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    # index for the target item "arrow"
    arrow_idx = cookbook.index["arrow"]
    # recipe dict for arrow
    recipe = cookbook.recipes[arrow_idx]

    # workshop where arrow must be crafted (key "_at" or "_key")
    workshop_key = recipe.get("_at", recipe.get("_key"))
    workshop_idx = workshop_key if isinstance(workshop_key, int) else cookbook.index[workshop_key]

    # ----------------------------------------------------------------------
    # Determine required primitives -----------------------------------------
    # ----------------------------------------------------------------------
    needed = {}
    for k, v in recipe.items():
        if isinstance(k, int):          # ingredient (primitive or intermediate)
            needed[k] = needed.get(k, 0) + v

    # ----------------------------------------------------------------------
    # Prepare grid and blocked‑cell mask ------------------------------------
    # ----------------------------------------------------------------------
    start_grid = env._current_state.grid
    w, h, _ = start_grid.shape
    # cells that cannot be entered (non‑grabbable entities)
    blocked_mask = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked_mask |= start_grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Build the action sequence ---------------------------------------------
    # ----------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)

    # Helper to move to the nearest cell containing a given kind
    def move_to_kind(kind_idx, count):
        nonlocal cur_pos, actions, blocked_mask
        for _ in range(count):
            # locate all cells that contain the required kind
            cells = {(x, y) for x in range(w) for y in range(h)
                     if start_grid[x, y, kind_idx] > 0}
            # BFS to the closest such cell
            path = bfs(cur_pos, cells, blocked_mask)
            actions.extend(path)
            # update current position
            for a in path:
                dx, dy = DIRS[a]
                cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)
            # pick up the item
            actions.append(4)   # USE
    # ----------------------------------------------------------------------
    # Collect all needed primitives -----------------------------------------
    # ----------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        move_to_kind(kind_idx, cnt)

    # ----------------------------------------------------------------------
    # Go to the workshop and craft -----------------------------------------
    # ----------------------------------------------------------------------
    # locate any workshop cell
    workshop_cells = {(x, y) for x in range(w) for y in range(h)
                      if start_grid[x, y, workshop_idx] > 0}
    path = bfs(cur_pos, workshop_cells, blocked_mask)
    actions.extend(path)
    for a in path:
        dx, dy = DIRS[a]
        cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)
    # craft the arrow
    actions.append(4)   # USE

    return actions


    actions = []
    max_steps = 2000  # safety limit
    rng = np.random.default_rng()
    for _ in range(max_steps):
        # stop if the task has already been completed
        if hasattr(env, "_is_done") and env._is_done():
            break
        # sample a random action from the available action space (0‑4)
        act = int(rng.integers(0, 5))
        actions.append(act)
        # perform the action; ignore returned values except for termination flag
        _, done, _ = env.step(act)
        if done:
            break
    return actions

