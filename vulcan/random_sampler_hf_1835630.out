    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk
        from ``start`` to ``goal`` using a simple Manhattan route."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

