    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions that brings the agent from
    #   start (x, y) to a cell adjacent to any target location.
    #   The search avoids cells that are occupied in the provided grid.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, cur_grid):
        width, height, _ = cur_grid.shape
        occupied = np.any(cur_grid > 0, axis=2)          # any non‑zero kind blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Are we adjacent (or on) a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable path
        return []

    # ------------------------------------------------------------------
    # Retrieve world and cookbook from the environment
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = state_wrapper.world
    cookbook = world.cookbook

    # Goal is hard‑coded to "arrow"
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if needed)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    # Work on a mutable copy of the grid so we can mark collected cells as empty
    cur_grid = state.grid.copy()    # (W, H, n_kinds)

    actions = []
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells that currently contain this primitive
        locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive (or onto it if possible)
            path = _bfs_path(pos, [loc], cur_grid)
            actions.extend(path)
            # Update position following the path
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive
            actions.append(USE)
            # Mark the cell as empty for future path‑finding
            cur_grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a string name)
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        # Locate workshop cells in the current grid
        workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws], cur_grid)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use the workshop to craft the arrow
            actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Action indices (standard for CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # Mapping from action to coordinate delta
    _DELTA = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions taking the agent from
    # `start` to a cell adjacent to any of `targets`.  Cells that contain
    # any non‑zero kind are treated as obstacles.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, cur_grid):
        w, h, _ = cur_grid.shape
        occupied = np.any(cur_grid > 0, axis=2)  # True where any entity blocks movement
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path
            # Expand neighbours
            for act, (dx, dy) in _DELTA.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell
        return []

    # ------------------------------------------------------------------
    # Retrieve world and cookbook objects
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = state_wrapper.world
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance from the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Identify goal (hard‑coded to "arrow") and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in cookbook.")
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if needed)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    grid = state.grid.copy()        # mutable copy for planning

    actions = []
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells currently containing this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position for efficiency
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue
            # Plan a path to a cell adjacent to the primitive
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            # Simulate moving along the path to update `pos`
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use action to pick up the primitive
            actions.append(USE)
            harvested.add(loc)
            gathered += 1
            # Update the planning grid: the primitive is now removed
            grid[loc[0], loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be string name or integer id)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)
        # Locate workshop cells
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if not workshop_cells:
            # No workshop visible – fall back to using current location
            actions.append(USE)
        else:
            # Choose the nearest workshop cell
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use action to craft the arrow
            actions.append(USE)
    else:
        # No specific workshop required – simply use at current location
        actions.append(USE)

    return actions

