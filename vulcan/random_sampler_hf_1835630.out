    # Retrieve scenario and world objects (handles possible wrappers)
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Starting state of the episode
    try:
        start_state = scenario.init()
    except Exception:
        return []

    # Helper to create a hashable representation of a state
    def _state_key(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    from collections import deque, namedtuple
    Node = namedtuple("Node", ["state", "actions"])

    frontier = deque([Node(start_state, [])])
    visited = {_state_key(start_state)}

    # Limit search depth to keep computation tractable
    MAX_STEPS = 400
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return cur_actions

        if len(cur_actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, cur_actions + [a]))

    # No plan found within the limit
    return []


