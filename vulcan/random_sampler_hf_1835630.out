    import numpy as np

    actions = []
    spec = env.action_specs()
    DOWN = spec['DOWN']
    UP = spec['UP']
    LEFT = spec['LEFT']
    RIGHT = spec['RIGHT']
    USE = spec['USE']

    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}
    state = env._current_state
    pos = tuple(state.pos)

    def _move(cur, tgt):
        """Manhattan moves from cur (x,y) to tgt (x,y)."""
        moves = []
        x, y = cur
        tx, ty = tgt
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    # Collect all required primitives
    for prim_idx, cnt in needed.items():
        # find all cells that currently contain this primitive
        locations = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
        for _ in range(cnt):
            if not locations:
                break
            target = locations.pop(0)
            actions.extend(_move(pos, target))
            pos = target
            actions.append(USE)

    # Move to the workshop (if the recipe specifies one) and craft
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target = ws_locs[0]
            actions.extend(_move(pos, target))
            pos = target
            actions.append(USE)

    return actions


    # Get action indices
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec['DOWN'],
        spec['UP'],
        spec['LEFT'],
        spec['RIGHT'],
        spec['USE'],
    )

    # Goal item index
    goal_idx = env.task.goal

    # Primitive requirements for the goal
    needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Current state snapshot (used for locating entities)
    state = env._current_state
    pos = tuple(state.pos)  # (x, y)

    actions = []

    def _move(cur, tgt):
        """Generate Manhattan moves from cur to tgt."""
        moves = []
        x, y = cur
        tx, ty = tgt
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    def _nearest(cur, locs):
        """Return the nearest location to cur and remove it from locs."""
        if not locs:
            return None
        best = None
        best_dist = None
        for i, (lx, ly) in enumerate(locs):
            d = abs(lx - cur[0]) + abs(ly - cur[1])
            if best_dist is None or d < best_dist:
                best_dist = d
                best = i
        return locs.pop(best)

    # ---- Collect each required primitive ----
    for prim_idx, count in needed.items():
        # Find all cells currently containing this primitive
        prim_locs = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
        for _ in range(count):
            if not prim_locs:
                # No more instances; abort early
                break
            target = _nearest(pos, prim_locs)
            # Move to the primitive
            actions.extend(_move(pos, target))
            pos = target
            # Pick it up
            actions.append(USE)

    # ---- Go to the appropriate workshop and craft ----
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target_ws = _nearest(pos, ws_locs)
            actions.extend(_move(pos, target_ws))
            pos = target_ws
            actions.append(USE)  # craft at the workshop

    return actions

