    # ----------------------------------------------------------------------
    # Helper mappings between movement directions and action indices.
    # (DOWN,UP,LEFT,RIGHT) correspond to action IDs 0‑4 in CraftLab.
    # ----------------------------------------------------------------------
    DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search returning a list of actions that moves the agent
    # from ``start`` to a cell that is Manhattan‑adjacent to any cell in
    # ``targets``.  Cells occupied by any entity are considered blocked.
    # ----------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs(start, targets, grid):
        """Return actions to reach a neighbour of one of ``targets``."""
        W, H = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)          # any occupied cell blocks movement
        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Initialise state information.
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()               # mutable copy for planning
    pos = tuple(state.pos)                 # (x, y)

    # Goal item index.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # Primitive requirements for the goal.
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)
    if not primitives_needed:
        # Goal itself may be a primitive we just need to pick up.
        primitives_needed = {goal_idx: 1}

    plan = []  # List of action indices to be returned.

    # ----------------------------------------------------------------------
    # 1. Collect all required primitive resources.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        while needed_cnt > 0:
            # Locate cells that still contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more of this primitive on the map – abort planning.
                return plan

            # Find a path to a neighbour of the nearest primitive cell.
            path = bfs(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Update simulated position.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive (USE action = 4).
            plan.append(4)

            # Identify which primitive cell we are now adjacent to.
            adj = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                break  # Unexpected; avoid infinite loop.

            # Remove one instance from the simulated grid and decrement counter.
            grid[adj[0], adj[1], prim_idx] -= 1
            needed_cnt -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (may be string name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            # Update simulated position.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(4)

    return plan


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Mapping between movement vectors and action indices (as defined in CraftLab)
    # ----------------------------------------------------------------------
    DIR_TO_ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search returning a list of actions that moves the agent
    # from ``start`` to a cell that is Manhattan‑adjacent to any cell in
    # ``targets``.  Cells occupied by any entity are considered blocked.
    # ----------------------------------------------------------------------
    def bfs(start, targets, grid):
        """Return a list of actions to reach a neighbour of one of ``targets``."""
        W, H = grid.shape[:2]
        blocked = np.any(grid, axis=2)            # any kind present blocks movement
        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency – return empty list.
        return []

    # ----------------------------------------------------------------------
    # Extract current state information.
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()               # mutable copy for planning
    pos = tuple(state.pos)                 # (x, y)

    # Goal index is stored in the task object.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in the environment's task.")

    # Primitive requirements for the goal (primitive kind → count).
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    plan = []  # List of action indices to be returned.

    # ----------------------------------------------------------------------
    # 1. Collect all required primitive resources.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        while needed_cnt > 0:
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more of this primitive on the map – abort planning.
                return plan

            path = bfs(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Update simulated position.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use the primitive (action index 4 corresponds to USE).
            plan.append(4)

            # Find the primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                break  # unexpected; safeguard against infinite loop

            # Remove one instance from the simulated grid and decrement counter.
            grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
            needed_cnt -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get('_at') or recipe.get('_key')
    if workshop_key is not None:
        # Resolve workshop kind index (string name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            # Update simulated position.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft the item by using the workshop.
            plan.append(4)

    return plan

