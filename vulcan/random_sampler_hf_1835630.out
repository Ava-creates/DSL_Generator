    # ----------------------------------------------------------------------
    # Helper functions
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _move_to(pos, target, seq):
        """Append actions that move the agent from `pos` to `target`."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell containing `kind_idx` (Manhattan distance)."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Planning start
    # ----------------------------------------------------------------------
    actions = []

    # Determine current position (use env's current state if it exists)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the initial grid so we can mark primitives as taken
    grid = env.scenario.init_grid.copy()

    # Goal item index (the environment's task goal)
    goal_idx = env.task.goal

    # ----------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal
    # ----------------------------------------------------------------------
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, needed in primitive_requirements.items():
        for _ in range(needed):
            target = _nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive not present – abort planning (return what we have)
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)          # pick up the primitive
            grid[target[1], target[0], prim_kind] = 0   # remove from our copy

    # ----------------------------------------------------------------------
    # 2. Go to the appropriate workshop (if any) and craft the goal item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)          # craft at the workshop

    # Return the full action sequence
    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _move_to(pos, tgt, seq):
        """Append actions to move from pos to tgt (both [x, y] lists)."""
        while pos[0] != tgt[0] or pos[1] != tgt[1]:
            if pos[0] < tgt[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > tgt[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < tgt[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > tgt[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos, g):
        """Return [x, y] of the nearest cell containing kind_idx, or None."""
        ys, xs = np.where(g[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Begin planning
    # ----------------------------------------------------------------------
    actions = []

    # Determine current position (use internal state if present)
    if hasattr(env, "_current_state"):
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the grid to track taken items
    grid = env.scenario.init_grid.copy()

    # Index of the goal item
    goal_idx = env.task.goal

    # ----------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal
    # ----------------------------------------------------------------------
    primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, count in primitive_reqs.items():
        for _ in range(count):
            target = _nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive not found – abort planning
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)  # pick up primitive
            # Mark the primitive as collected in our grid copy
            grid[target[1], target[0], prim_kind] = 0

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)  # craft at the workshop

    # Return the planned sequence of actions
    return actions

