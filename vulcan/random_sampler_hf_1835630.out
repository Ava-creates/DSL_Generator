    # Reset environment and fetch initial state and world configuration
    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # item not defined in this world
        return []

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # brings the agent to a position where the cell directly in front
    # contains `target_kind`. Returns [] if already adjacent/facing,
    # or None if unreachable.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # Mapping from action index to (dx, dy) movement
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            if not in_bounds(x, y):
                return False
            # a cell is walkable if it contains no entities at all
            return not np.any(grid[x, y, :])

        start_x, start_y = state.pos
        start_dir = state.dir
        from collections import deque
        queue = deque()
        queue.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while queue:
            x, y, d, actions = queue.popleft()
            # Check the cell directly in front of the agent
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            # Expand with the four movement actions (which also set direction)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, actions + [a]))

        # Unreachable
        return None

    # --------------------------------------------------------------
    # Determine which primitives are required to craft one arrow.
    # If the recipe is empty, the arrow itself is a primitive that must
    # be collected directly.
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    # If no primitives are needed, treat the arrow itself as the target to pick up
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    actions = []

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # --------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            if move_seq is None:
                # Cannot reach the required primitive – abort early.
                return actions
            actions.extend(move_seq)
            actions.append(4)   # USE to pick up / interact

            # Apply the actions to keep cur_state in sync.
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        if move_seq is None:
            # Workshop unreachable – abort.
            return actions
        actions.extend(move_seq)
        actions.append(4)   # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – just try to craft in place.
        actions.append(4)   # USE to craft
        _, cur_state = cur_state.step(4)

    return actions


    # Reset environment and get initial state/world
    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # arrow not defined in this world
        return []

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # brings the agent to a position where the cell directly in front
    # contains `target_kind`. Returns [] if unreachable.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # direction deltas matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            if not in_bounds(x, y):
                return False
            # a cell is walkable if it contains no entities at all
            return not np.any(grid[x, y, :])

        start_x, start_y = state.pos
        start_dir = state.dir
        from collections import deque
        queue = deque()
        queue.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while queue:
            x, y, d, acts = queue.popleft()
            # Is the target directly ahead?
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts

            # Explore movement actions (0‑3)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))

        # Unreachable
        return []

    # --------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    actions = []

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_actions = _bfs_to_target(cur_state, prim_idx)
            # If BFS failed but we are already adjacent, we can still pick up
            if not move_actions and not cur_state.next_to(prim_idx):
                # cannot reach this primitive – abort early
                return actions
            actions.extend(move_actions)
            actions.append(4)                     # USE to pick up
            # Apply actions to keep cur_state in sync
            for a in move_actions + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_actions = _bfs_to_target(cur_state, workshop_idx)
        actions.extend(move_actions)
        actions.append(4)                     # USE to craft
        for a in move_actions + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – just attempt crafting in place
        actions.append(4)                     # USE to craft
        _, cur_state = cur_state.step(4)

    return actions

