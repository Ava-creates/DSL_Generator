    # Reset environment and initialise variables
    env.reset()
    actions: list[int] = []
    act_map = env.action_specs()          # name → id
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx → count
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at', None)

    # Movement deltas for cardinal actions
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    # Helper BFS: returns a list of action names that moves the agent from `start`
    # to a cell that is Chebyshev‑adjacent (≤1 in both axes) to any target cell.
    # Traversal is allowed only through completely empty cells.
    def bfs_to_adjacent(start, targets, grid):
        from collections import deque
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # adjacency test
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # cell must be empty (no entity)
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None  # unreachable

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # locate all cells currently holding this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # primitive no longer present – stop trying
                break

            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # unreachable – give up on this primitive
                break

            # execute movement actions
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # pick up the primitive
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # craft using the workshop
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # Return the full sequence of action IDs
    return actions


