    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                    # (WIDTH, HEIGHT, n_kinds)

    # ------------------------------------------------------------------
    # Action indices (as defined by CraftLab.action_specs)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    # movement delta → action
    MOVE_DELTAS = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    def bfs_path(start, goal):
        """Return a list of movement actions that brings the agent from
        ``start`` (y, x) to ``goal`` while avoiding non‑grabbable obstacles."""
        if start == goal:
            return []
        H, W = grid.shape[:2]
        blocked = list(world.non_grabbable_indices)

        visited = np.full((H, W), False, dtype=bool)
        prev = {}                     # (y,x) → (prev_y, prev_x, action)
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            for (dy, dx), act in MOVE_DELTAS.items():
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    if np.any(grid[ny, nx, blocked] > 0):
                        continue          # cell occupied by a non‑grabbable entity
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x, act)
                    if (ny, nx) == goal:
                        # reconstruct path
                        actions = []
                        cur = (ny, nx)
                        while cur != start:
                            py, px, a = prev[cur]
                            actions.append(a)
                            cur = (py, px)
                        actions.reverse()
                        return actions
                    q.append((ny, nx))
        # No path found – return empty list (should not happen for valid tasks)
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing ``kind_idx`` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # Determine goal index for 'arrow' and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    primitive_requirements = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")   # may be None

    actions = []
    cur_pos = state.pos   # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in primitive_requirements.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early
                return actions
            # Move to the primitive cell
            actions += bfs_path(cur_pos, target)
            cur_pos = target
            # Pick it up
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting at the current location
    actions.append(USE)

    return actions


    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # Action indices (dynamic, as defined by the environment)
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    # Directions mapped to actions
    DIRS = [
        (1, 0, DOWN),   # down
        (-1, 0, UP),    # up
        (0, 1, RIGHT),  # right
        (0, -1, LEFT),  # left
    ]

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding non‑grabbable
        obstacles. ``start`` and ``goal`` are (y, x) tuples."""
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}                     # (y,x) -> (prev_y, prev_x, action)
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct path
                actions = []
                cur = (y, x)
                while cur != start:
                    py, px, act = prev[cur]
                    actions.append(act)
                    cur = (py, px)
                actions.reverse()
                return actions

            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # cell is blocked if any non‑grabbable entity occupies it
                    if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x, act)
                    q.append((ny, nx))
        # No path found – return empty list (should not happen for valid tasks)
        return []

    def find_nearest(kind_idx, from_pos):
        """Return the coordinates (y, x) of the nearest cell that contains
        ``kind_idx``. If none exists, return None."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # Determine goal index for 'arrow' and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the appropriate number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early
                return actions

            # Move to a free cell adjacent to the primitive (if possible)
            ty, tx = target
            adj = None
            for dy, dx, _ in DIRS:
                ny, nx = ty + dy, tx + dx
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; stand on the primitive cell itself
                adj = target

            # Move to chosen adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (issue a movement that will be blocked)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions

