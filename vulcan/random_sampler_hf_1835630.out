    # Retrieve the underlying scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Get the initial state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    # Helper to produce a hashable representation of a state
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque()
    frontier.append(Node(init_state, []))
    visited.add(_state_hash(init_state))

    # Limit on plan length to keep search tractable
    MAX_STEPS = 500
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: does inventory contain at least one arrow?
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Do not expand paths that are already too long
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible primitive actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If we exit the loop no plan was found within the limits
    return []


