        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for kind_idx, count in primitive_needs.items():
        for _ in range(count):
            target = nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Required primitive not present; abort planning.
                return actions
            actions += bfs_path(cur_pos, target, grid)
            actions.append(USE)  # pick up the primitive
            # Mark the item as taken in our copy of the grid.
            grid[target[0], target[1], kind_idx] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. If the recipe specifies a workshop, go there and craft the item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions += bfs_path(cur_pos, workshop_pos, grid)
            actions.append(USE)  # craft at the workshop
            cur_pos = workshop_pos

    # ------------------------------------------------------------------
    # Return the planned sequence of actions
    # ------------------------------------------------------------------
    return actions


