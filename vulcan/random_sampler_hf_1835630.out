    # Reset environment and obtain core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy of the grid

    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def cell_blocked(y, x):
        """A cell is considered blocked for movement if any entity occupies it."""
        return np.any(grid[y, x, :])

    def bfs_path(start, goal, allow_goal_occupied=False):
        """Breadth‑first search returning a list of movement actions from start to goal.
        If allow_goal_occupied is True the goal cell may be occupied."""
        if start == goal:
            return []
        from collections import deque
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        while q:
            y, x, path = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                # If the neighbour is the goal we may ignore occupancy if allowed
                if (ny, nx) == goal:
                    return path + [act]
                if cell_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                q.append((ny, nx, path + [act]))
        # No path found – return empty list
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing the specified kind."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Return a free orthogonal neighbour of *cell* that is not in *avoid*."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not cell_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos
    taken_primitive_cells = set()   # to avoid revisiting already collected spots

    # ------------------------------------------------------------------
    # Collect each primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early
                return actions

            # Choose a free neighbour to stand on while picking up the primitive
            adj = adjacent_free(target, avoid=taken_primitive_cells)
            if adj is None:
                # If no free neighbour, try to stand on the primitive cell itself after collection
                adj = target

            # Move to the chosen adjacent cell
            actions += bfs_path(cur_pos, adj, allow_goal_occupied=False)
            cur_pos = adj

            # Face the primitive (by issuing a movement action towards it)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update internal grid representation: primitive is now gone
            grid[target[0], target[1], prim_idx] = 0
            taken_primitive_cells.add(target)

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            # Prefer an adjacent free cell; if none, attempt to stand on the workshop cell itself
            ws_adj = adjacent_free(ws_cell, avoid=taken_primitive_cells)
            if ws_adj is None:
                ws_adj = ws_cell if not cell_blocked(ws_cell[0], ws_cell[1]) else cur_pos
            actions += bfs_path(cur_pos, ws_adj, allow_goal_occupied=False)
            cur_pos = ws_adj

            # Face the workshop
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Final USE to trigger crafting
    actions.append(USE)

    return actions


