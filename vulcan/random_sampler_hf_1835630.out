                acts.append(DOWN)
            elif y1 < y0:
                acts.append(UP)
        return acts

    actions = []

    # ----------------------------------------------------------------------
    # Collect each required primitive
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        collected = 0
        # list all cells containing this primitive
        prim_cells = [(x, y) for x in range(width) for y in range(height)
                      if grid[x, y, prim_idx] > 0]
        cell_ptr = 0
        while collected < needed and cell_ptr < len(prim_cells):
            cell = prim_cells[cell_ptr]
            cell_ptr += 1

            # Determine free adjacent positions (or the cell itself if free)
            candidate_spots = []
            if not blocked[cell]:
                candidate_spots.append(cell)
            for nb in neighbors(cell):
                if not blocked[nb]:
                    candidate_spots.append(nb)

            if not candidate_spots:
                continue  # cannot reach this primitive instance

            # Choose the closest candidate to current position
            candidate_spots.sort(key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            target_spot = candidate_spots[0]

            # Find path to the chosen spot
            path = bfs(pos, {target_spot})
            if path is None:
                continue  # unreachable, try next primitive instance

            actions.extend(path_to_actions(path))
            pos = target_spot

            # Pick up as many as needed from this cell
            available = int(grid[cell[0], cell[1], prim_idx])
            take = min(needed - collected, available)
            actions.extend([USE] * take)
            inventory[prim_idx] += take
            grid[cell[0], cell[1], prim_idx] -= take
            if grid[cell[0], cell[1], prim_idx] == 0:
                blocked[cell] = False   # cell becomes free after collection
            collected += take

        if collected < needed:
            raise RuntimeError(f"Insufficient primitive {prim_idx} for crafting arrow")

    # ----------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    workshop_idx = None
    if workshop_key is not None:
        if isinstance(workshop_key, int):
            workshop_idx = workshop_key
        else:
            workshop_idx = world.cookbook.index.get(workshop_key)

    if workshop_idx is not None:
        # locate any workshop cell
        ws_cells = [(x, y) for x in range(width) for y in range(height)
                    if grid[x, y, workshop_idx] > 0]
        if not ws_cells:
            raise RuntimeError("No workshop cell found on the map")
        ws_cell = ws_cells[0]

        # find a free adjacent spot (or the cell itself if free)
        ws_targets = []
        if not blocked[ws_cell]:
            ws_targets.append(ws_cell)
        for nb in neighbors(ws_cell):
            if not blocked[nb]:
                ws_targets.append(nb)

        if ws_targets:
            ws_targets.sort(key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            ws_goal = ws_targets[0]
            path = bfs(pos, {ws_goal})
            if path is not None:
                actions.extend(path_to_actions(path))
                pos = ws_goal

    # final USE to craft the arrow
    actions.append(USE)

    return actions

