    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def manhattan_path(start, goal):
        """Return a list of movement actions that walk from ``start`` to ``goal``.
        Simple planner that moves vertically then horizontally."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x

        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)

        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)

        return actions

    def find_nearest(kind_idx, from_pos):
        """Linear scan for the nearest cell containing ``kind_idx``."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine what primitives are needed for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in required_prims.items():
        for _ in range(needed_cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present on the map – abort early.
                return actions

            ty, tx = target

            # Choose an adjacent free cell to stand on before using.
            # Preference order: above, below, left, right.
            adj = None
            for ny, nx, facing in [
                (ty - 1, tx, DOWN),   # stand above, face downwards
                (ty + 1, tx, UP),     # stand below, face upwards
                (ty, tx - 1, RIGHT),  # stand left, face rightwards
                (ty, tx + 1, LEFT)    # stand right, face leftwards
            ]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx, facing)
                        break

            # If no free neighbour, we will stand on the primitive cell itself.
            if adj is None:
                adj = (ty, tx, None)

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj[:2])
            cur_pos = adj[:2]

            # Adjust direction if needed.
            if adj[2] is not None:
                actions.append(adj[2])

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger the crafting action.
    actions.append(USE)

    return actions


