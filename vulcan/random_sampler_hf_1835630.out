    # ----------------------------------------------------------------------
    # Primitive requirements for the goal (used for heuristic)
    # ----------------------------------------------------------------------
    needed_prims = world.cookbook.primitives_for(target_idx)  # dict {prim_idx: count}
    needed_prim_idxs = set(needed_prims.keys())

    # ----------------------------------------------------------------------
    # Helper: hash a state for visited‑set bookkeeping
    # ----------------------------------------------------------------------
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # ----------------------------------------------------------------------
    # Heuristic: estimate remaining distance to collect missing primitives
    # ----------------------------------------------------------------------
    import numpy as np

    def _heuristic(st):
        # count missing primitives
        missing = {
            idx: needed_prims[idx] - int(st.inventory[idx])
            for idx in needed_prim_idxs
            if needed_prims[idx] > int(st.inventory[idx])
        }
        if not missing:
            return 0

        pos_r, pos_c = st.pos
        # for each missing primitive, find the closest cell that currently holds it
        total = 0
        for idx, need in missing.items():
            # cells where the primitive exists (grid slice > 0)
            locs = np.argwhere(st.grid[:, :, idx] > 0)
            if locs.size == 0:
                # no visible instance – give a large penalty
                total += 10 * need
                continue
            # Manhattan distance to the nearest such cell
            d = min(abs(r - pos_r) + abs(c - pos_c) for r, c in locs)
            total += d * need
        return total

    # ----------------------------------------------------------------------
    # A* search over deterministic state transitions
    # ----------------------------------------------------------------------
    import heapq
    from collections import namedtuple

    Node = namedtuple("Node", ["state", "actions", "cost"])

    start_node = Node(state=init_state, actions=[], cost=0)
    start_f = _heuristic(init_state)

    frontier = [(start_f, 0, start_node)]  # (priority, tie‑breaker, node)
    visited = {_state_hash(init_state)}

    MAX_PLAN_LENGTH = 600                     # safety bound
    n_actions = getattr(world, "n_actions", 5)  # default action space size

    while frontier:
        _, _, cur_node = heapq.heappop(frontier)
        cur_state = cur_node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return cur_node.actions

        # Prune overly long plans
        if len(cur_node.actions) >= MAX_PLAN_LENGTH:
            continue

        # Expand neighbours
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h in visited:
                continue
            visited.add(h)
            new_cost = cur_node.cost + 1
            priority = new_cost + _heuristic(nxt_state)
            nxt_node = Node(state=nxt_state,
                            actions=cur_node.actions + [a],
                            cost=new_cost)
            heapq.heappush(frontier, (priority, new_cost, nxt_node))

    # No feasible plan found within the search budget
    return []


