        if cur_state.satisfies("", target_idx):
            return cur_actions

        # Depth/size limits
        if len(cur_actions) >= MAX_STEPS:
            continue
        if nodes_expanded >= MAX_NODES:
            break
        nodes_expanded += 1

        # Expand neighbours by trying every possible action
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _hash_state(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, cur_actions + [a]))

    # No plan found within the limits – return empty list as a fallback
    return []

