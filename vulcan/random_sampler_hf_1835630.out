    env.reset()
    actions = []
    # get goal and recipe info
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    act_map = env.action_specs()
    move_delta = {
        "UP": (-1, 0),
        "DOWN": (1, 0),
        "LEFT": (0, -1),
        "RIGHT": (0, 1),
    }

    from collections import deque

    def bfs_to_adjacent(start, targets, grid):
        """Return list of action names moving from start to a cell adjacent (Chebyshev <=1) to any target."""
        W, H = grid.shape[:2]
        visited = np.zeros((W, H), dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()
            # check adjacency
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path
            # expand
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if grid[nx, ny].sum() == 0:  # empty cell
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None

    # collect primitives
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                continue
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                continue
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)
            # pick up
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # move to workshop and craft
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)
            # craft
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    return actions


    # Reset environment and fetch initial state
    env.reset()
    state = env._current_state

    # Goal index and its recipe information
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # Mapping from action name to integer ID
    act_map = env.action_specs()

    # Cardinal movement deltas (used by BFS)
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving the agent from
    # `start` to a cell that is adjacent (Chebyshev distance ≤ 1) to any cell
    # in `targets`. Only empty cells (no entity) may be traversed.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, targets, grid):
        from collections import deque
        W, H = grid.shape[:2]
        visited = np.zeros((W, H), dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # Check adjacency to any target cell
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # Walk only through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Refresh current state after each step
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Locate all cells that contain the needed primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Primitive not present in the world – abort collection
                break

            # Plan a path to the nearest primitive (adjacent cell)
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # Unreachable primitive – abort collection
                break

            # Execute movement actions
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # Use action to pick up the primitive
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        # Refresh state after primitive collection
        state = env._current_state
        grid = state.grid
        pos = state.pos

        # Locate workshop cells of the required kind
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # Use action at the workshop to craft the item
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # Return the compiled sequence of action IDs
    return actions

