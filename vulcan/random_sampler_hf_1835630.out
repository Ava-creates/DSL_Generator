    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        # Create a hashable representation of a state (position, direction,
        # inventory contents, and full grid layout)
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    # Depth/step limit to keep the search tractable
    MAX_STEPS = 500
    # Number of possible actions (typically 5: 4 moves + USE)
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in the inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Skip expanding nodes that exceed the step limit
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions from the current state
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    # No plan found within the step limit
    return []

