import numpy as np

def _navigate_and_use(env, target_pos):
    """Move the agent to target_pos (grid coordinates) and issue a USE action."""
    actions = []
    # current position
    cur_x, cur_y = env._current_state.pos
    tgt_x, tgt_y = target_pos

    # Horizontal moves
    while cur_x < tgt_x:
        actions.append(3)  # RIGHT
        cur_x += 1
    while cur_x > tgt_x:
        actions.append(2)  # LEFT
        cur_x -= 1
    # Vertical moves
    while cur_y < tgt_y:
        actions.append(0)  # DOWN
        cur_y += 1
    while cur_y > tgt_y:
        actions.append(1)  # UP
        cur_y -= 1

    # finally pick up / craft
    actions.append(4)  # USE
    for a in actions:
        env.step(a)
    return actions

def make_arrow_v0(env):
    """
    Simple planner that:
      1. Resets the environment.
      2. Collects all primitive resources needed for the `arrow` recipe.
      3. Moves to the required workshop and crafts the arrow.
    Returns the list of actions taken.
    """
    # reset and obtain initial state
    env.reset()
    actions_taken = []

    # goal index for the current task
    goal_idx = env.task.goal

    # primitive requirements for the goal
    primitive_dict = env.world.cookbook.primitives_for(goal_idx)

    # collect each required primitive the needed number of times
    for prim_idx, needed in primitive_dict.items():
        while needed > 0:
            # locate the nearest instance of this primitive
            locs = np.argwhere(env._current_state.grid[:, :, prim_idx] > 0)
            if locs.size == 0:
                # primitive not present – abort planning
                raise RuntimeError(f"Primitive {prim_idx} not found in the grid.")
            target = tuple(locs[0][:2])  # (x, y)
            actions_taken.extend(_navigate_and_use(env, target))
            needed -= 1

    # locate the workshop required for crafting the goal
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    if workshop_idx is None:
        raise RuntimeError("No workshop specified for the goal.")
    locs = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)
    if locs.size == 0:
        raise RuntimeError("Workshop not found in the grid.")
    workshop_pos = tuple(locs[0][:2])
    actions_taken.extend(_navigate_and_use(env, workshop_pos))

    return actions_taken

def make_arrow_v1(env):
    """
    Same logic as `make_arrow_v0` but with a tiny optimisation:
    after moving to a primitive location we re‑search for the same primitive
    to possibly pick a closer one for the next iteration.
    """
    env.reset()
    actions_taken = []

    goal_idx = env.task.goal
    primitive_dict = env.world.cookbook.primitives_for(goal_idx)

    for prim_idx, needed in primitive_dict.items():
        while needed > 0:
            # recompute locations each iteration (may have changed after picks)
            locs = np.argwhere(env._current_state.grid[:, :, prim_idx] > 0)
            if locs.size == 0:
                raise RuntimeError(f"Primitive {prim_idx} exhausted.")
            target = tuple(locs[0][:2])
            actions_taken.extend(_navigate_and_use(env, target))
            needed -= 1

    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    if workshop_idx is None:
        raise RuntimeError("No workshop for goal.")
    locs = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)
    if locs.size == 0:
        raise RuntimeError("Workshop missing.")
    workshop_pos = tuple(locs[0][:2])
    actions_taken.extend(_navigate_and_use(env, workshop_pos))

    return actions_taken

def make_arrow_v2(env):
    """
    Robust planner:
      * Handles multiple instances of the same primitive by always moving to the
        closest one (Manhattan distance).
      * Performs a sanity check after each USE to ensure the inventory was updated.
    Returns the complete action list.
    """
    env.reset()
    actions_taken = []

    goal_idx = env.task.goal
    primitive_dict = env.world.cookbook.primitives_for(goal_idx)

    for prim_idx, needed in primitive_dict.items():
        while needed > 0:
            # find all positions of this primitive
            locs = np.argwhere(env._current_state.grid[:, :, prim_idx] > 0)
            if locs.size == 0:
                raise RuntimeError(f"Cannot find required primitive {prim_idx}.")
            # compute Manhattan distances from current position
            cur_x, cur_y = env._current_state.pos
            dists = np.abs(locs[:, 0] - cur_x) + np.abs(locs[:, 1] - cur_y)
            nearest = locs[dists.argmin()]
            target = (int(nearest[0]), int(nearest[1]))
            actions_taken.extend(_navigate_and_use(env, target))
            # verify we actually picked up the primitive
            if env._current_state.inventory[prim_idx] == 0:
                raise RuntimeError("Pickup failed.")
            needed -= 1

    # move to workshop and craft
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    if workshop_idx is None:
        raise RuntimeError("Goal has no associated workshop.")
    locs = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)
    if locs.size == 0:
        raise RuntimeError("Workshop not present.")
    # choose closest workshop
    cur_x, cur_y = env._current_state.pos
    dists = np.abs(locs[:, 0] - cur_x) + np.abs(locs[:, 1] - cur_y)
    nearest = locs[dists.argmin()]
    workshop_pos = (int(nearest[0]), int(nearest[1]))
    actions_taken.extend(_navigate_and_use(env, workshop_pos))

    return actions_taken


    import numpy as np

    actions = []
    # current state and grid
    state = env._current_state
    grid = state.grid
    cur_pos = list(state.pos)  # mutable [x, y]

    world = env.world
    idx = world.cookbook.index

    # index of the target item "arrow"
    arrow_idx = idx["arrow"]
    recipe = world.cookbook.recipes.get(arrow_idx, {})

    # separate workshop and primitive requirements
    workshop_idx = None
    primitives = {}
    for k, v in recipe.items():
        if isinstance(k, str) and k.startswith("_"):
            workshop_idx = v
        else:
            primitives[int(k)] = v

    # helper: find all positions that currently contain a given kind
    def positions_of(kind):
        pts = np.argwhere(grid[:, :, kind] > 0)
        return [tuple(p) for p in pts]

    # helper: generate moves from cur_pos to target (Manhattan moves)
    def moves_to(target):
        moves = []
        dx = target[0] - cur_pos[0]
        dy = target[1] - cur_pos[1]

        while dx > 0:
            moves.append(0)          # DOWN
            cur_pos[0] += 1
            dx -= 1
        while dx < 0:
            moves.append(1)          # UP
            cur_pos[0] -= 1
            dx += 1
        while dy > 0:
            moves.append(3)          # RIGHT
            cur_pos[1] += 1
            dy -= 1
        while dy < 0:
            moves.append(2)          # LEFT
            cur_pos[1] -= 1
            dy += 1
        return moves

    # -------------------------------------------------
    # 1. Collect required primitive items
    # -------------------------------------------------
    for prim_idx, cnt in primitives.items():
        for _ in range(cnt):
            # locate nearest available primitive of this kind
            cand = positions_of(prim_idx)
            if not cand:
                continue
            nearest = min(cand, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            actions.extend(moves_to(nearest))
            actions.append(4)                     # USE to pick up
            # remove it from the simulated grid so we don't try to collect it again
            grid[nearest[0], nearest[1], prim_idx] = 0

    # -------------------------------------------------
    # 2. Go to the appropriate workshop and craft
    # -------------------------------------------------
    if workshop_idx is not None:
        ws_cands = positions_of(workshop_idx)
        if ws_cands:
            nearest_ws = min(ws_cands, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            actions.extend(moves_to(nearest_ws))
            actions.append(4)                     # USE to craft

    return actions

