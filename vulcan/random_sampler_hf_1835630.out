    import numpy as np, collections

    # standard action ids
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # helper: BFS returning actions to reach a cell adjacent to any target
    # ------------------------------------------------------------------
    def _bfs_adj(start, targets, occ):
        w, h = occ.shape
        q = collections.deque([(start[0], start[1], [])])
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # adjacency test
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # locate world and cookbook
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        st = getattr(env, "_current_state", None)
        if st is not None:
            world = getattr(st, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in env.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # goal = arrow
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # primitive requirements for one arrow
    needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # ------------------------------------------------------------------
    # ensure fresh episode and fetch current state
    # ------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid                           # (W, H, n_kinds)
    occupied = np.any(grid > 0, axis=2)        # True where blocked

    actions = []
    collected = set()                          # cells already used

    # ------------------------------------------------------------------
    # collect required primitives (greedy nearest first)
    # ------------------------------------------------------------------
    for prim_idx, qty in needed.items():
        # locate all instances of this primitive
        locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from current pos
        locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        have = 0
        for loc in locs:
            if have >= qty:
                break
            if loc in collected:
                continue
            # move adjacent to primitive
            path = _bfs_adj(pos, [loc], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # pick it up
            actions.append(USE)
            occupied[loc[0], loc[1]] = False
            collected.add(loc)
            have += 1

    # ------------------------------------------------------------------
    # go to workshop (if recipe specifies) and craft
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve index (may be name string)
        ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if not ws_cells:
            raise RuntimeError(f"No workshop '{workshop_key}' found.")
        ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        target_ws = ws_cells[0]
        path = _bfs_adj(pos, [target_ws], occupied)
        actions.extend(path)
        for act in path:
            if act == RIGHT:
                pos = (pos[0] + 1, pos[1])
            elif act == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif act == DOWN:
                pos = (pos[0], pos[1] + 1)
            elif act == UP:
                pos = (pos[0], pos[1] - 1)
        actions.append(USE)

    return actions


