    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)  # (x, y)

    def _move(cur, tgt):
        """Return a list of actions moving Manhattan‑style from cur to tgt."""
        moves = []
        x, y = cur
        tx, ty = tgt
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    # ----------------------------------------------------------------------
    # 1) Collect required primitives
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # locate remaining instances of this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # primitive not present any more; abort early
                break
            # pick nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),
            )
            actions.extend(_move(pos, target))
            pos = target
            actions.append(USE)          # pick up the primitive
            grid[pos[0], pos[1], prim_idx] = 0   # remove from our copy

    # ----------------------------------------------------------------------
    # 2) Go to workshop (if any) and craft the goal item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locations:
            target = min(
                ws_locations,
                key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),
            )
            actions.extend(_move(pos, target))
            pos = target
            actions.append(USE)   # craft at the workshop
    else:
        # No specific workshop – just use the current cell to craft
        actions.append(USE)

    return actions


    actions = []
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"],
        spec["UP"],
        spec["LEFT"],
        spec["RIGHT"],
        spec["USE"],
    )

    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)

    # indices of entities that block movement (trees, water, etc.)
    non_grab = env.world.non_grabbable_indices
    width, height = grid.shape[0], grid.shape[1]

    # ------------------------------------------------------------------
    # helper: shortest Manhattan‑style path avoiding non‑grabbable cells
    # ------------------------------------------------------------------
    def bfs(start, target):
        """Return a list of actions moving from start to target."""
        if start == target:
            return []
        from collections import deque

        q = deque([start])
        parent = {start: None}  # maps position -> (prev_pos, action)
        while q:
            x, y = q.popleft()
            if (x, y) == target:
                break
            for act, (dx, dy) in (
                (DOWN, (1, 0)),
                (UP, (-1, 0)),
                (RIGHT, (0, 1)),
                (LEFT, (0, -1)),
            ):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                # check for blocking entities
                blocked = False
                for idx in non_grab:
                    if grid[nx, ny, idx] > 0:
                        blocked = True
                        break
                if blocked:
                    continue
                if (nx, ny) not in parent:
                    parent[(nx, ny)] = ((x, y), act)
                    q.append((nx, ny))
        else:
            # no path found – return empty list (will likely fail later)
            return []

        # reconstruct actions
        actions_path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            actions_path.append(act)
            cur = prev
        actions_path.reverse()
        return actions_path

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # locate remaining instances of this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # nothing left – break early
                break
            # choose the nearest one (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),
            )
            actions.extend(bfs(pos, target))
            pos = target
            actions.append(USE)  # pick up the primitive
            # remove it from our copy of the grid
            grid[pos[0], pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2) Go to the appropriate workshop and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locations:
            target = min(
                ws_locations,
                key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),
            )
            actions.extend(bfs(pos, target))
            pos = target
            actions.append(USE)  # craft at the workshop

    return actions

