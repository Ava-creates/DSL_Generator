    # reset environment and get handles
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # action constants (as defined in CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell (Manhattan distance) containing a kind
    # ------------------------------------------------------------------
    def _find_nearest(grid, kind_idx, start_pos):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start_pos[0]) + abs(j - start_pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: locate any cell containing a given kind (used for workshops)
    # ------------------------------------------------------------------
    def _find_any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Helper: generate a Manhattan path (list of actions) from src to dst
    # ------------------------------------------------------------------
    def _path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # Identify the goal item (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # arrow not defined in this world
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting required counts)
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # primitive missing – abort early
                return action_seq
            # move to the primitive location
            for a in _path(state.pos, target):
                _, _, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)
            # pick it up
            _, _, _ = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    # ------------------------------------------------------------------
    # If the recipe specifies a workshop, move there before crafting
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _path(state.pos, workshop_pos):
                _, _, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)

    # ------------------------------------------------------------------
    # Final craft action (USE) at current location (workshop or open ground)
    # ------------------------------------------------------------------
    _, _, _ = env.step(USE)
    action_seq.append(USE)

    return action_seq


    # Action constants as defined in CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: check if a cell is traversable (empty) or is the target cell
    # ------------------------------------------------------------------
    def _is_traversable(grid, pos, target):
        i, j = pos
        if pos == target:
            return True
        # cell is traversable if no kind occupies it
        return not grid[i, j, :].any()

    # ------------------------------------------------------------------
    # Helper: BFS to find a shortest path (list of positions) from src to dst
    # ------------------------------------------------------------------
    def _bfs_path(src, dst, grid):
        h, w, _ = grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev = dict()
        q = collections.deque()
        q.append(src)
        visited[src] = True
        while q:
            cur = q.popleft()
            if cur == dst:
                # reconstruct path
                path = []
                while cur != src:
                    path.append(cur)
                    cur = prev[cur]
                path.append(src)
                path.reverse()
                return path
            r, c = cur
            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w:
                    nxt = (nr, nc)
                    if not visited[nxt] and _is_traversable(grid, nxt, dst):
                        visited[nxt] = True
                        prev[nxt] = cur
                        q.append(nxt)
        return None  # no path found

    # ------------------------------------------------------------------
    # Helper: convert a list of positions into actions
    # ------------------------------------------------------------------
    def _positions_to_actions(path):
        actions = []
        for (r0, c0), (r1, c1) in zip(path, path[1:]):
            if r1 == r0 + 1:
                actions.append(DOWN)
            elif r1 == r0 - 1:
                actions.append(UP)
            elif c1 == c0 + 1:
                actions.append(RIGHT)
            elif c1 == c0 - 1:
                actions.append(LEFT)
            else:
                raise ValueError("Invalid step in path")
        return actions

    # ------------------------------------------------------------------
    # Initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # ------------------------------------------------------------------
    # Identify the goal item (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []  # arrow not defined

    # ------------------------------------------------------------------
    # Primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting counts)
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            target = None
            # locate nearest instance of the primitive
            min_dist = None
            h, w, _ = state.grid.shape
            for i in range(h):
                for j in range(w):
                    if state.grid[i, j, prim_idx] > 0:
                        d = abs(i - state.pos[0]) + abs(j - state.pos[1])
                        if min_dist is None or d < min_dist:
                            min_dist = d
                            target = (i, j)
            if target is None:
                # primitive missing; abort early
                return action_seq

            # find path to the primitive
            path = _bfs_path(state.pos, target, state.grid)
            if path is None:
                # cannot reach; abort
                return action_seq
            for a in _positions_to_actions(path):
                _, _, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)
            # pick it up
            _, _, _ = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    # ------------------------------------------------------------------
    # If recipe specifies a workshop, go there before crafting
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = None
        # locate any workshop cell
        for i in range(state.grid.shape[0]):
            for j in range(state.grid.shape[1]):
                if state.grid[i, j, workshop_idx] > 0:
                    workshop_pos = (i, j)
                    break
            if workshop_pos:
                break
        if workshop_pos is not None:
            path = _bfs_path(state.pos, workshop_pos, state.grid)
            if path is not None:
                for a in _positions_to_actions(path):
                    _, _, _ = env.step(a)
                    state = env._current_state
                    action_seq.append(a)

    # ------------------------------------------------------------------
    # Final craft action (USE) at current location
    # ------------------------------------------------------------------
    _, _, _ = env.step(USE)
    action_seq.append(USE)

    return action_seq

