    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid.copy()

    # Action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def manhattan_path(start, goal):
        """Return a list of movement actions from start to goal."""
        actions = []
        y, x = start
        gy, gx = goal
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the closest cell containing the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # Identify goal and its primitive requirements
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # Collect all required primitives
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not available; abort early.
                return actions
            actions += manhattan_path(cur_pos, target)
            cur_pos = target
            actions.append(USE)                     # pick up
            grid[target[0], target[1], prim_idx] = 0  # remove from planning grid

    # Move to the workshop (if the recipe specifies one) and craft
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow
    actions.append(USE)

    return actions


    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Action constants (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell (y, x) containing the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a free orthogonal neighbour of `cell` (or None if none)."""
        y, x = cell
        candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]
        for ny, nx in candidates:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        return None

    def direction_to(src, dst):
        """Return the movement action that makes the agent at src face dst (one step)."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives for an ``arrow``.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Choose a free adjacent cell to stand on; fall back to the primitive cell.
            stand = free_adjacent(target) or target

            # Move to the chosen standing position.
            actions += manhattan_path(cur_pos, stand)
            cur_pos = stand

            # Face the primitive (optional but helps USE).
            turn = direction_to(cur_pos, target)
            if turn is not None:
                actions.append(turn)

            # Pick up the primitive.
            actions.append(USE)

            # Update planning grid so we don't try to pick the same item again.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions

