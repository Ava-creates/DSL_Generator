    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_idx = cookbook.index["arrow"]

    # mutable copies for planning
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return list of movement actions (0=DOWN,1=UP,2=LEFT,3=RIGHT) to any goal."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat any occupied cell as blocked unless it's a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def apply_path(path):
        """Update simulated position according to a list of movement actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(kind_idx, amount):
        """Collect *amount* units of primitive *kind_idx* from the grid."""
        nonlocal actions, grid, inventory, pos
        while amount > 0:
            cells = [(x, y) for x in range(width) for y in range(height)
                     if grid[x, y, kind_idx] > 0]
            if not cells:
                raise RuntimeError("Not enough primitives on the map")
            path = None
            target = None
            for cell in cells:
                p = bfs(pos, {cell})
                if p is not None:
                    path, target = p, cell
                    break
            if path is None:
                raise RuntimeError("Primitive unreachable")
            actions.extend(path)
            apply_path(path)
            actions.append(4)  # USE
            grid[target[0], target[1], kind_idx] = 0
            inventory[kind_idx] += 1
            amount -= 1

    recipes = cookbook.recipes
    primitives = cookbook.primitives

    def ensure_item(item_idx, needed):
        """Make sure inventory[item_idx] >= needed by collecting/crafting."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < needed:
            if item_idx in primitives:
                collect_primitive(item_idx, needed - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            # first satisfy ingredient requirements
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to required workshop if any
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if not ws_cells:
                    raise RuntimeError("Required workshop missing")
                p = bfs(pos, {ws_cells[0]})
                if p is None:
                    raise RuntimeError("Workshop unreachable")
                actions.extend(p)
                apply_path(p)

            # craft action
            actions.append(4)  # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    ensure_item(target_idx, 1)

    return actions


