    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 1500
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        if cur_state.satisfies("", target_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    return []


    # ----------------------------------------------------------------------
    # make_arrow_v2: A* planner that uses recipe information to guide search
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # --------------------------------------------------------------
    # Identify the target item ("arrow") and its recipe information
    # --------------------------------------------------------------
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Primitive requirements for a single arrow (primitive → count)
    needed_prim = world.cookbook.primitives_for(target_idx)  # dict[int, int]

    # Workshop index where the arrow must be crafted (if any)
    recipe = world.cookbook.recipes.get(target_idx, {})
    workshop_idx = recipe.get("_at", None)

    # --------------------------------------------------------------
    # Initial state
    # --------------------------------------------------------------
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    import heapq
    from collections import namedtuple

    Node = namedtuple("Node", ["state", "actions", "g"])

    def _state_hash(st):
        """Hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    def _missing_primitives(st):
        """Return a dict primitive_idx → missing count for the current state."""
        miss = {}
        for p_idx, need_cnt in needed_prim.items():
            have = int(st.inventory[p_idx])
            if have < need_cnt:
                miss[p_idx] = need_cnt - have
        return miss

    def _manhattan(p1, p2):
        return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])

    def _heuristic(st):
        """
        Estimate remaining steps:
        - distance to the closest needed primitive (if any missing)
        - otherwise distance to the nearest workshop for the final craft
        """
        miss = _missing_primitives(st)
        if miss:
            # compute minimal Manhattan distance to any cell that currently holds a needed primitive
            min_dist = None
            for p_idx in miss:
                # positions where this primitive is present (>0)
                pos_arr = np.argwhere(st.grid[:, :, p_idx] > 0)
                if pos_arr.size == 0:
                    continue
                dists = np.abs(pos_arr - np.array(st.pos)).sum(axis=1)
                cur_min = int(dists.min())
                if (min_dist is None) or (cur_min < min_dist):
                    min_dist = cur_min
            # If no cells contain the needed primitive (maybe already picked up), fallback to 0
            return min_dist if min_dist is not None else 0
        else:
            # All primitives gathered; need to reach the workshop to craft the arrow
            if workshop_idx is None:
                return 0
            pos_arr = np.argwhere(st.grid[:, :, workshop_idx] > 0)
            if pos_arr.size == 0:
                return 0
            dists = np.abs(pos_arr - np.array(st.pos)).sum(axis=1)
            return int(dists.min())

    # --------------------------------------------------------------
    # A* search
    # --------------------------------------------------------------
    n_actions = getattr(world, "n_actions", 5)
    MAX_STEPS = 2000  # safety cap on plan length

    start_node = Node(state=init_state, actions=[], g=0)
    start_f = start_node.g + _heuristic(start_node.state)

    frontier = [(start_f, start_node)]
    heapq.heapify(frontier)

    visited = {_state_hash(init_state)}

    while frontier:
        _, cur = heapq.heappop(frontier)
        cur_state = cur.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return cur.actions

        # Prune overly long trajectories
        if cur.g >= MAX_STEPS:
            continue

        # Expand actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            hsh = _state_hash(nxt_state)
            if hsh in visited:
                continue
            visited.add(hsh)
            g2 = cur.g + 1
            f2 = g2 + _heuristic(nxt_state)
            nxt_node = Node(state=nxt_state, actions=cur.actions + [a], g=g2)
            heapq.heappush(frontier, (f2, nxt_node))

    # No feasible plan found within limits
    return []

