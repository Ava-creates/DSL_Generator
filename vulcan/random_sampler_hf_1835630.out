    # ----------------------------------------------------------------------
    # Helper to safely obtain the world and scenario objects
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # ----------------------------------------------------------------------
    # Identify the target item ("arrow") index in the cookbook
    # ----------------------------------------------------------------------
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:          # recipe missing or typo
        return []

    # ----------------------------------------------------------------------
    # Get the initial state of the episode (grid, position, direction, etc.)
    # ----------------------------------------------------------------------
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Breadth‑first search over the (state, action‑sequence) space.
    # The state space is huge but the built‑in CraftWorld dynamics are
    # deterministic and the number of meaningful actions is tiny
    # (4 moves + USE).  We therefore keep a visited set based on a compact
    # hash of the full state (position, direction, inventory, grid bytes).
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Return a hashable representation of a CraftState."""
        return (
            st.pos,                     # (x, y) tuple
            st.dir,                     # facing direction 0‑3
            tuple(st.inventory.tolist()),  # inventory counts
            st.grid.tobytes(),          # raw grid contents
        )

    visited = set()
    start_hash = _state_hash(init_state)
    visited.add(start_hash)

    frontier = deque([Node(init_state, [])])

    # Upper bound on plan length – prevents infinite search on pathological maps
    MAX_STEPS = 2000

    # Number of primitive actions the environment supports (normally 5)
    n_actions = getattr(world, "n_actions", 5)

    # Prefer the USE action (index 4) before movement to speed up crafting.
    # If the environment defines fewer actions we simply iterate over all.
    if n_actions > 4:
        action_order = [4, 0, 1, 2, 3]
    else:
        action_order = list(range(n_actions))

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: does the inventory contain at least one arrow?
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune paths that are already too long
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand successors
        for a in action_order:
            _, nxt_state = cur_state.step(a)      # reward is always 0.0 here
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If we exit the loop no plan was found within the limits.
    return []


