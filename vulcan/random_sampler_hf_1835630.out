    # ----------------------------------------------------------------------
    # Initialise state, world and cookbook
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    world = getattr(env, "world", None) or getattr(state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Goal definition
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow (includes nested primitives)
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Working copies of grid and agent position
    grid = state.grid.copy()
    pos = tuple(state.pos)

    # ----------------------------------------------------------------------
    # Action constants (as used by CraftLab)
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions bringing the agent
    # from `start` to a cell adjacent (or equal) to any cell in `targets`.
    # ----------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # any entity blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Success if we are on a target or directly adjacent
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable target
        return []

    actions = []

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            # Current locations of this primitive on the map
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                # Primitive unavailable – break early; the episode will later fail
                break

            # Choose the closest location by Manhattan distance
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_loc = locations[0]

            # Plan path to an adjacent cell
            path = _bfs_path(pos, [target_loc])
            # If BFS failed (e.g., blocked by obstacles), fallback to straight line moves
            if not path:
                dx = target_loc[0] - pos[0]
                dy = target_loc[1] - pos[1]
                # simple stepwise approach ignoring obstacles
                step_x = RIGHT if dx > 0 else LEFT
                step_y = DOWN if dy > 0 else UP
                path = ([step_x] * abs(dx)) + ([step_y] * abs(dy))

            # Execute movement actions and update simulated position
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Use action to pick up the primitive
            actions.append(USE)
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            collected += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str)
            else workshop_key
        )
        workshop_locs = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_locs:
            # Move to nearest workshop
            workshop_locs.sort(
                key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])
            )
            ws_target = workshop_locs[0]
            path = _bfs_path(pos, [ws_target])
            if not path:
                dx = ws_target[0] - pos[0]
                dy = ws_target[1] - pos[1]
                step_x = RIGHT if dx > 0 else LEFT
                step_y = DOWN if dy > 0 else UP
                path = ([step_x] * abs(dx)) + ([step_y] * abs(dy))
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft action
            actions.append(USE)
        else:
            # No workshop found – attempt crafting at current location
            actions.append(USE)
    else:
        # No workshop requirement – craft wherever we are
        actions.append(USE)

    return actions


