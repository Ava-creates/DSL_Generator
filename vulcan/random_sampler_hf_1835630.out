    # BFS to get movement actions to be adjacent with target in front
    def bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]
        deltas = {0:(0,1), 1:(0,-1), 2:(-1,0), 3:(1,0)}  # DOWN,UP,LEFT,RIGHT

        def in_bounds(x,y):
            return 0 <= x < W and 0 <= y < H
        def walkable(x,y):
            return in_bounds(x,y) and not np.any(grid[x,y,:])

        sx, sy = cur_state.pos
        sd = cur_state.dir
        from collections import deque
        q = deque()
        q.append((sx,sy,sd,[]))
        visited = {(sx,sy,sd)}
        while q:
            x,y,d,acts = q.popleft()
            dx,dy = deltas[d]
            fx,fy = x+dx, y+dy
            if in_bounds(fx,fy) and grid[fx,fy,target_kind] > 0:
                return acts
            for a in (0,1,2,3):
                ndx,ndy = deltas[a]
                nx,ny = x+ndx, y+ndy
                if not walkable(nx,ny):
                    continue
                if (nx,ny,a) in visited:
                    continue
                visited.add((nx,ny,a))
                q.append((nx,ny,a,acts+[a]))
        return []

