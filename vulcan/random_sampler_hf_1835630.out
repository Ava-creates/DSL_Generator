    # Action → (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def bfs_to_target(cur_state, target_kind):
        """Bread‑first search that returns a list of movement actions (0‑3)
        leading to a position where the cell directly in front contains
        `target_kind`. Returns None if the target is unreachable."""
        grid = cur_state.grid
        W, H = grid.shape[:2]
        sx, sy = cur_state.pos
        sdir = cur_state.dir

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # Determine primitive requirements (recursively expanded)
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:  # arrow itself may be primitive
        needed = {arrow_idx: 1}

    plan = []

    # ------------------------------------------------------------------
    # 1) Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            seq = bfs_to_target(state, prim_idx)
            if seq is None:
                # Unreachable primitive – abort planning
                return plan
            plan.extend(seq)
            plan.append(4)  # USE to pick up
            for a in seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its designated workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
