    import heapq
    from collections import namedtuple

    # ------------------------------------------------------------------
    # Helper to obtain world, scenario and target index
    # ------------------------------------------------------------------
    scenario = getattr(env, "scenario", None) or getattr(env, "scenario", env)
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # ------------------------------------------------------------------
    # Initial state
    # ------------------------------------------------------------------
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ------------------------------------------------------------------
    # Some useful constants / helpers
    # ------------------------------------------------------------------
    n_actions = getattr(world, "n_actions", 5)          # action space size
    MAX_STEPS = 800                                     # safety bound
    Node = namedtuple("Node", ["state", "actions", "g"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # ------------------------------------------------------------------
    # Heuristic for A*:
    #   - distance to nearest needed primitive (if missing)
    #   - otherwise distance to nearest workshop for the target
    # ------------------------------------------------------------------
    def _manhattan(p1, p2):
        return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])

    def _nearest_distance(pos, kind_idx):
        """Return Manhattan distance from pos to the closest cell containing kind_idx."""
        # grid is (W, H, K); we look where grid[:, :, kind_idx] > 0
        locs = (st.grid[:, :, kind_idx] > 0).nonzero()
        if len(locs[0]) == 0:
            return None
        dists = [_manhattan(pos, (int(x), int(y))) for x, y in zip(locs[0], locs[1])]
        return min(dists) if dists else None

    # Pre‑compute workshop index for the target (if any)
    workshop_idx = None
    try:
        recipe = world.cookbook.recipes[target_idx]
        workshop_idx = recipe.get("_at", None)
    except Exception:
        workshop_idx = None

    # Cache for primitive requirements (primitive kind → count)
    try:
        primitive_reqs = world.cookbook.primitives_for(target_idx)
    except Exception:
        primitive_reqs = {}

    def heuristic(st):
        """Estimate remaining cost to obtain an arrow."""
        # Goal already satisfied?
        if st.satisfies("", target_idx):
            return 0

        # Determine which primitives are still missing
        missing = {}
        for pk, cnt in primitive_reqs.items():
            have = int(st.inventory[pk])
            if have < cnt:
                missing[pk] = cnt - have

        # If there are missing primitives, compute distance to the closest one
        if missing:
            dlist = []
            for pk in missing:
                # locate any cell of this primitive kind
                locs = (st.grid[:, :, pk] > 0).nonzero()
                if len(locs[0]) == 0:
                    continue
                d = min(_manhattan(st.pos, (int(x), int(y))) for x, y in zip(locs[0], locs[1]))
                dlist.append(d)
            return min(dlist) if dlist else 0

        # All primitives present, need to reach workshop to craft
        if workshop_idx is not None:
            locs = (st.grid[:, :, workshop_idx] > 0).nonzero()
            if len(locs[0]) > 0:
                return min(_manhattan(st.pos, (int(x), int(y))) for x, y in zip(locs[0], locs[1]))
        return 0

    # ------------------------------------------------------------------
    # A* search
    # ------------------------------------------------------------------
    start_hash = _state_hash(init_state)
    visited = {start_hash}
    start_node = Node(init_state, [], 0)
    frontier = [(heuristic(init_state), 0, start_node)]   # (f, g, node)

    while frontier:
        f, g, node = heapq.heappop(frontier)
        cur_state = node.state

        # Goal test
        if cur_state.satisfies("", target_idx):
            return node.actions

        if g >= MAX_STEPS:
            continue

        # Expand actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            hsh = _state_hash(nxt_state)
            if hsh in visited:
                continue
            visited.add(hsh)
            g2 = g + 1
            f2 = g2 + heuristic(nxt_state)
            heapq.heappush(frontier, (f2, g2, Node(nxt_state, node.actions + [a], g2)))

    # No plan found within limits
    return []


    import collections

    # Retrieve scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Find the index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialize the start state
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # Helper to create a hashable representation of a CraftState
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    Node = collections.namedtuple("Node", ["state", "actions"])
    visited = {_state_hash(init_state)}
    frontier = collections.deque([Node(init_state, [])])

    MAX_STEPS = 500                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)  # default action space size

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long candidate plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    # No feasible plan found within the limits
    return []

