    import numpy as np, collections

    # Action constants (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_path(start, targets, grid):
        """Return a list of actions moving from start to a cell adjacent to any target."""
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)  # any non‑zero kind blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Explore neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    def _apply_path(pos, path):
        """Update a (x, y) position by applying a sequence of actions."""
        x, y = pos
        for act in path:
            if act == RIGHT:
                x += 1
            elif act == LEFT:
                x -= 1
            elif act == DOWN:
                y += 1
            elif act == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate world and cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Determine goal index for 'arrow'.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # ------------------------------------------------------------------
    # Primitive requirements.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    grid = state.grid.copy()        # mutable planning grid

    actions = []
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # All locations containing this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            pos = _apply_path(pos, path)

            # Pick it up.
            actions.append(USE)
            # Update planning grid.
            grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft at required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index.
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            pos = _apply_path(pos, path)
            actions.append(USE)
        else:
            # No visible workshop – attempt to craft in place.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    import numpy as np
    import collections

    # Action enums as defined in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_path(start, targets, grid):
        """Return a list of actions moving from start to a cell adjacent to any target."""
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)  # any non‑zero kind blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop when adjacent to a target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Explore neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # unreachable

    def _apply_path(pos, path):
        """Update (x, y) according to a sequence of movement actions."""
        x, y = pos
        for act in path:
            if act == RIGHT:
                x += 1
            elif act == LEFT:
                x -= 1
            elif act == DOWN:
                y += 1
            elif act == UP:
                y -= 1
        return (x, y)

    # ----------------------------------------------------------------------
    # Locate the world and cookbook objects inside the environment.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Determine the goal index for the item named "arrow".
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not present in the cookbook.")
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Retrieve primitive requirements for the goal.
    # ----------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Ensure we have a valid state (reset if the wrapper does not expose one).
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # current (x, y)
    grid = state.grid.copy()        # mutable copy for planning

    actions = []
    harvested = set()               # cells already used for collection

    # ----------------------------------------------------------------------
    # Collect each required primitive.
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locate all cells containing this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from the current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            pos = _apply_path(pos, path)

            # Pick up the primitive.
            actions.append(USE)
            grid[loc[0], loc[1], prim_idx] = 0   # cell becomes empty
            harvested.add(loc)
            collected += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string or already an int).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            pos = _apply_path(pos, path)
            actions.append(USE)   # craft at the workshop
        else:
            # No visible workshop; attempt to craft at current location.
            actions.append(USE)
    else:
        # No specific workshop required; simply use to craft.
        actions.append(USE)

    return actions

