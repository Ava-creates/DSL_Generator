    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper to move from one grid cell to another using Manhattan moves
    # ------------------------------------------------------------------
    def _move_to(cur, target):
        cx, cy = cur
        tx, ty = target
        seq = []
        while cx < tx:
            seq.append(RIGHT)
            cx += 1
        while cx > tx:
            seq.append(LEFT)
            cx -= 1
        while cy < ty:
            seq.append(DOWN)
            cy += 1
        while cy > ty:
            seq.append(UP)
            cy -= 1
        return seq

    # ------------------------------------------------------------------
    # Extract world, cookbook and goal information
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # For raw CraftWorld instances the world is the env itself
        world = env
    cookbook = world.cookbook

    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for ONE arrow
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Get the current CraftState (reset if necessary)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        # Reset the environment to obtain an initial state
        # env.reset() returns an observation dict; the state is stored internally
        env.reset()
        state = env._current_state

    # Current position and static grid layout
    pos = tuple(state.pos)
    grid = state.grid  # shape (W, H, n_kinds)

    actions = []
    used_cells = set()   # cells already harvested

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # Find all cells that currently contain this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position (greedy nearest)
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed_cnt:
                break
            if loc in used_cells:
                continue
            # Move to the primitive cell
            actions.extend(_move_to(pos, loc))
            pos = loc
            # Pick it up
            actions.append(USE)
            used_cells.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or already an int)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key
        # Locate workshop cells on the grid
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_locs[0]
            actions.extend(_move_to(pos, target_ws))
            pos = target_ws
            actions.append(USE)   # craft at the workshop

    return actions


    # constants for actions
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    # ------------------------------------------------------------------
    # Helper: shortest path (BFS) returning list of action indices
    # ------------------------------------------------------------------
    def _bfs_path(start, goal, grid):
        """Return a list of actions to move from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        w, h, _ = grid.shape
        queue = collections.deque()
        queue.append((start, []))
        visited = {start}
        while queue:
            (x, y), path = queue.popleft()
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited:
                    continue
                # a cell is blocked if it contains any entity (non‑zero) except the goal cell
                if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:
                    continue
                new_path = path + [act]
                if (nx, ny) == goal:
                    return new_path
                visited.add((nx, ny))
                queue.append(((nx, ny), new_path))
        # if no path found, fall back to empty list (will likely fail later)
        return []

    # ------------------------------------------------------------------
    # Access world and cookbook (works for both CraftLab and raw env)
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # CraftLab stores the world inside the internal state
        world = getattr(env, "_current_state", None).world
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its primitive requirements
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Get current state (CraftLab keeps it in _current_state after reset)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        # fallback: initialise from the scenario directly
        state = env.scenario.init()
    pos = tuple(state.pos)          # (x, y)
    grid = state.grid.copy()        # mutable copy so we can “remove” collected items

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            # locate all remaining cells containing this primitive
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                # nothing left – abort (should not happen in a valid scenario)
                break
            # pick the location with the shortest Manhattan distance (good heuristic)
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locations[0]

            # move to the primitive
            actions.extend(_bfs_path(pos, target, grid))
            pos = target

            # pick it up
            actions.append(USE)

            # update grid to reflect that the primitive has been taken
            grid[pos[0], pos[1], prim_idx] = 0
            collected += 1

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and craft the item
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (could be a name or already an int)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key

        # locate workshop cells
        ws_locations = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locations:
            ws_locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = ws_locations[0]

            # move to workshop and use
            actions.extend(_bfs_path(pos, ws_target, grid))
            actions.append(USE)

    return actions

