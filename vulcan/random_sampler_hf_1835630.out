    import numpy as np

    # ------------------------------------------------------------------
    # Helper: Manhattan distance move towards a target cell.
    # ------------------------------------------------------------------
    def _move_towards(pos, target):
        """Return an action index that moves one step from pos toward target.

        Action indices (as used by CraftWorld):
            0 = DOWN  (increase x)
            1 = UP    (decrease x)
            2 = LEFT  (decrease y)
            3 = RIGHT (increase y)
        """
        x, y = pos
        tx, ty = target
        if x < tx:
            return 0          # DOWN
        if x > tx:
            return 1          # UP
        if y < ty:
            return 3          # RIGHT
        if y > ty:
            return 2          # LEFT
        return None           # already there

    # ------------------------------------------------------------------
    # Helper: find the nearest cell (Manhattan) that satisfies a predicate.
    # ------------------------------------------------------------------
    def _nearest_cell(state, predicate):
        """Search the whole grid for the cell closest (Manhattan) to the agent
        that satisfies `predicate(cell_coords)`. Returns None if not found."""
        h, w = state.grid.shape[:2]          # (WIDTH, HEIGHT)
        pos = state.pos
        best = None
        best_dist = None
        for ix in range(h):
            for iy in range(w):
                if predicate((ix, iy)):
                    d = abs(ix - pos[0]) + abs(iy - pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (ix, iy)
        return best

    # ------------------------------------------------------------------
    # Initialise / reset the environment.
    # ------------------------------------------------------------------
    obs = env.reset()                       # start a fresh episode
    world = env.world                       # CraftWorld instance
    idx = world.cookbook.index
    arrow_idx = idx["arrow"]                # integer id for the goal item

    # Primitive requirements for a single arrow (dict {prim_idx: count})
    needed_prims = world.cookbook.primitives_for(arrow_idx)

    actions = []                            # list of actions to return

    # ------------------------------------------------------------------
    # Main loop – keep acting until the environment reports done.
    # ------------------------------------------------------------------
    while not env._is_done():
        state = env._current_state           # current CraftState

        # ------------------------------------------------------------------
        # Determine which primitives are still missing.
        # ------------------------------------------------------------------
        missing = {}
        for p_idx, req_cnt in needed_prims.items():
            have = int(state.inventory[p_idx])
            if have < req_cnt:
                missing[p_idx] = req_cnt - have

        # ------------------------------------------------------------------
        # If we already have everything, head to the workshop that can craft
        # the arrow and use the crafting action.
        # ------------------------------------------------------------------
        if not missing:
            # Recipe dict contains an "_at" entry pointing to the workshop kind.
            workshop_kind = world.cookbook.recipes[arrow_idx]["_at"]
            # Locate nearest workshop cell.
            target = _nearest_cell(
                state,
                lambda c: state.grid[c][workshop_kind] > 0
            )
            # If we are already on the workshop, press USE to craft.
            if state.pos == target:
                actions.append(4)            # USE
                _, _ = env.step(4)
                continue
        else:
            # ----------------------------------------------------------------
            # We still need some primitive – pick one (arbitrary) and go collect.
            # ----------------------------------------------------------------
            prim_needed = next(iter(missing))
            target = _nearest_cell(
                state,
                lambda c: state.grid[c][prim_needed] > 0
            )
            # If we are already on the primitive, press USE to pick it up.
            if state.pos == target:
                actions.append(4)            # USE
                _, _ = env.step(4)
                continue

        # ------------------------------------------------------------------
        # Move one step towards the selected target cell.
        # ------------------------------------------------------------------
        if target is not None and state.pos != target:
            act = _move_towards(state.pos, target)
            if act is not None:
                actions.append(act)
                _, _ = env.step(act)
                continue

        # ------------------------------------------------------------------
        # Fallback: if we cannot find a target (should not happen), just break.
        # ------------------------------------------------------------------
        break

    # Return the complete action sequence that achieved the goal.
    return actions

