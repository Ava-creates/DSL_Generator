    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy of the grid

    # ------------------------------------------------------------------
    # Action indices (as defined by CraftLab.action_specs)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def is_blocked(y, x):
        """A cell is blocked if any kind occupies it."""
        return grid[y, x].any()

    def bfs_path(start, goal):
        """Return a list of movement actions that walks from start to goal
        while avoiding blocked cells."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        rev.append(DOWN)
                    elif cur[0] == py - 1:
                        rev.append(UP)
                    elif cur[1] == px + 1:
                        rev.append(RIGHT)
                    elif cur[1] == px - 1:
                        rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(rev))
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if is_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # No path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell that currently contains ``kind_idx``."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[dists.argmin()]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Return a free neighbour (y, x) of ``cell`` not in ``avoid``."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not is_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos                     # (y, x)
    collected = set()                       # cells already emptied

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort planning.
                return actions

            # Choose a free adjacent cell to stand on while picking up.
            adj = adjacent_free(target, avoid=collected)
            if adj is None:
                # Fallback: stand directly on the primitive cell.
                adj = target

            # Move to the adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (direction that would move into it).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update internal grid copy to reflect that the primitive is gone.
            grid[target[0], target[1], prim_idx] = 0
            collected.add(target)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, avoid=collected)
            if ws_adj is None:
                ws_adj = ws_cell  # stand directly on workshop if needed
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop (optional, for consistency).
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions


