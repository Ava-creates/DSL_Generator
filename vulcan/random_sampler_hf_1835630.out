    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:  # arrow not defined
        return []

    # Primitive requirements for one arrow
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:
        needed = {arrow_idx: 1}

    actions = []

    # Mapping from action index to movement delta
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    from collections import deque

    def bfs_to_target(cur_state, target_kind):
        """Return a list of movement actions that position the agent so that
        the cell directly in front contains `target_kind`. Returns None if
        unreachable."""
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = cur_state.pos
        sdir = cur_state.dir
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return seq
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))
        return None

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, count in needed.items():
        for _ in range(count):
            seq = bfs_to_target(state, kind_idx)
            if seq is None:
                # Primitive unreachable – abort planning.
                return actions
            actions.extend(seq)
            actions.append(4)  # USE to pick up / interact
            for a in seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = bfs_to_target(state, workshop_idx)
        if seq is None:
            # Workshop unreachable – still attempt a USE (will fail).
            actions.append(4)
            _, state = state.step(4)
        else:
            actions.extend(seq)
            actions.append(4)  # USE to craft
            for a in seq + [4]:
                _, state = state.step(a)
    else:
        # No specific workshop; craft in place.
        actions.append(4)
        _, state = state.step(4)

    return actions


    import numpy as np
    from collections import deque

    # Reset environment and get initial state/world
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Determine primitive requirements for one arrow
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:
        needed = {arrow_idx: 1}

    # Mapping action index -> movement delta (DOWN,UP,LEFT,RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def bfs_to_target(cur_state, target_kind):
        """Return a list of movement actions that positions the agent so that
        the cell directly in front contains `target_kind`. Returns None if
        unreachable."""
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            # Can walk on empty cells only
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = cur_state.pos
        sdir = cur_state.dir
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, path = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))
        return None

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect required primitives.
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            seq = bfs_to_target(state, kind_idx)
            if seq is None:
                # Target unreachable – abort planning.
                return actions
            actions.extend(seq)
            actions.append(4)          # USE to pick up
            for a in seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = bfs_to_target(state, workshop_idx)
        if seq is None:
            # Workshop unreachable – still try a USE (will fail harmlessly)
            actions.append(4)
            _, state = state.step(4)
        else:
            actions.extend(seq)
            actions.append(4)          # USE to craft
            for a in seq + [4]:
                _, state = state.step(a)
    else:
        # No specific workshop; craft in place.
        actions.append(4)
        _, state = state.step(4)

    return actions

