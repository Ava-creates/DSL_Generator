    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that finds a shortest sequence of movement actions that
    # brings the agent from `start` to a cell adjacent to any position in
    # `targets`.  Cells that contain any entity (grid[...,k] > 0) are
    # considered blocked, except the target cell itself (we only need to be
    # next to it).
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        width, height, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where something exists
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent (Manhattan distance 1) to any target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path
            # Explore 4‑connected neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:
                    # We may step onto empty cells only
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No path found – return empty list (will cause failure later)
        return []

    # ------------------------------------------------------------------
    # Identify world, cookbook and the goal (hard‑coded to "arrow")
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers keep the world inside the current state object
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = state_obj.world
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Obtain the current state (reset if the env hasn't been started)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    grid = state.grid                # (W, H, n_kinds)

    actions = []
    harvested = set()                # locations already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ------------------------------------------------------------------
    for prim_idx, cnt_needed in primitives_needed.items():
        # All cells that currently contain this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= cnt_needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive
            path = _bfs_path(pos, [loc])
            actions.extend(path)
            # Update our simulated position following the path
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick it up
            actions.append(USE)
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or already an int)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key
        # Locate all cells of that workshop type
        workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_locs:
            # Choose the nearest workshop
            workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_locs[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft using the USE action
            actions.append(USE)

    return actions


    # Determine which version of the arrow‑making policy to use.
    # Environments may expose a `version` attribute (or similar) that
    # indicates which implementation should be employed.  If the
    # attribute is missing we default to version 0.
    version = getattr(env, "version", getattr(env, "level", 0))

    # Dispatch to the appropriate helper.
    if version == 0:
        return make_arrow_v0(env)
    elif version == 1:
        return make_arrow_v1(env)
    else:
        # Unknown version – fall back to the simplest implementation.
        return make_arrow_v0(env)

