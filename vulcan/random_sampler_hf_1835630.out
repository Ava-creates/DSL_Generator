    # Ensure there is a current state; reset if necessary
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Obtain world and cookbook objects
    world = getattr(env, "world", None) or getattr(state, "world", None)
    if world is None:
        raise RuntimeError("World object not found in the environment.")
    cookbook = world.cookbook

    # Goal: make an arrow
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Working copies of grid and position for planning
    grid = state.grid.copy()
    pos = tuple(state.pos)          # (x, y)

    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions bringing the
    # agent from `start` to a cell adjacent (or on) any of `targets`.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # blocked cells
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check if we are adjacent to (or on) a target cell
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    # Allow stepping onto a target cell; otherwise must be free
                    if not occupied[nx, ny] or (nx, ny) in target_set:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []   # no path found

    actions = []

    # ------------------------------------------------------------------
    # Collect all required primitives (greedy nearest‑first)
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        collected = 0
        while collected < required_cnt:
            # Locate remaining instances of this primitive
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                # No more of this primitive on the map; stop trying
                break
            # Choose the closest one (Manhattan distance)
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_loc = locations[0]

            # Move adjacent to the primitive
            path = _bfs_path(pos, [target_loc])
            actions.extend(path)
            # Update simulated position
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick up the primitive
            actions.append(USE)
            # Mark the cell as empty in our simulated grid
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a string name)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str)
            else workshop_key
        )
        # Find workshop locations
        ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_locs:
            ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_locs[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft
            actions.append(USE)
    else:
        # No specific workshop; attempt crafting at current location
        actions.append(USE)

    return actions


