    # Reset environment and get the current state and world reference
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []  # arrow not defined in this world

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that brings
    # the agent to a position where the cell directly in front contains
    # `target_kind`. Returns None if the target cannot be reached.
    # ------------------------------------------------------------------
    deltas = {0: (0, 1),   # DOWN
              1: (0, -1),  # UP
              2: (-1, 0),  # LEFT
              3: (1, 0)}   # RIGHT

    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = cur_state.pos
        sdir = cur_state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:                         # arrow itself is primitive
        needed = {arrow_idx: 1}

    plan = []

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            move_seq = _bfs_to_target(state, prim_idx)
            if move_seq is None:          # unreachable primitive → abort planning
                return plan
            plan.extend(move_seq)
            plan.append(4)                # USE to pick up
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(state, workshop_idx)
        if move_seq is None:              # unreachable workshop → abort
            return plan
        plan.extend(move_seq)
        plan.append(4)                    # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        plan.append(4)                    # USE to craft in place
        _, state = state.step(4)

    return plan


    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:  # arrow not defined in this world
        return []

    # Determine which primitive resources are needed for one arrow.
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:  # arrow itself is a primitive
        needed = {arrow_idx: 1}

    actions = []

    # Mapping from action index to movement deltas (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def bfs_to_target(cur_state, target_kind):
        """Return a list of movement actions that positions the agent so that
        the cell directly in front contains `target_kind`. Returns None if
        unreachable."""
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = cur_state.pos
        sdir = cur_state.dir
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return seq
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))
        return None

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, count in needed.items():
        for _ in range(count):
            seq = bfs_to_target(state, kind_idx)
            if seq is None:
                # Primitive unreachable – abort planning.
                return actions
            actions.extend(seq)
            actions.append(4)  # USE to pick up / interact
            for a in seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = bfs_to_target(state, workshop_idx)
        if seq is None:
            # Workshop unreachable – still attempt a USE (will simply fail).
            actions.append(4)
            _, state = state.step(4)
        else:
            actions.extend(seq)
            actions.append(4)  # USE to craft
            for a in seq + [4]:
                _, state = state.step(a)
    else:
        # No specific workshop; craft in place.
        actions.append(4)
        _, state = state.step(4)

    return actions

