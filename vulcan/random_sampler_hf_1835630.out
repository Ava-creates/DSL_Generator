    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item and its recipe
    target_name = "arrow"
    target_idx = cookbook.index[target_name]
    recipe = cookbook.recipes.get(target_idx, {})
    ingredients = {k: v for k, v in recipe.items() if k != "_at"}

    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return a list of movement actions (0‑3) to reach any cell in *goals*."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat a cell as blocked if any entity occupies it and it is not a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update *pos* according to a list of actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ---- collect required primitives ---------------------------------------
    for ing_idx, needed in ingredients.items():
        # find all cells containing this ingredient
        locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ing_idx] > 0]
        collected = 0
        while collected < needed and locations:
            target = locations.pop(0)

            # move to the target cell
            path = bfs(pos, {target})
            if path is None:
                continue  # cannot reach this instance
            actions.extend(path)
            move_along(path)

            # pick up the item
            actions.append(4)          # USE
            grid[target[0], target[1], ing_idx] = 0
            inventory[ing_idx] += 1
            collected += 1

    # ---- go to the workshop and craft --------------------------------------
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        actions.append(4)   # USE directly if no workshop required
        return actions

    workshop_idx = workshop_name if isinstance(workshop_name, int) else cookbook.index[workshop_name]
    workshop_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, workshop_idx] > 0]

    if workshop_cells:
        ws_target = workshop_cells[0]
        path = bfs(pos, {ws_target})
        if path:
            actions.extend(path)
            move_along(path)

    # final USE to craft the arrow
    actions.append(4)  # USE

    return actions


    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item
    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # current representations
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Shortest path (list of actions) from start to any cell in goals."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # allow moving onto a goal cell even if occupied
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update *pos* according to a sequence of actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ----------------------------------------------------------------------
    # Primitive collection
    def collect_primitive(prim_idx, amount):
        """Collect *amount* of primitive *prim_idx* from the grid."""
        nonlocal actions, grid, inventory, pos
        while amount > 0:
            # find any remaining cell containing the primitive
            locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, prim_idx] > 0]
            if not locations:
                break
            # pick the closest reachable one
            best_path = None
            best_loc = None
            for loc in locations:
                path = bfs(pos, {loc})
                if path is not None:
                    best_path = path
                    best_loc = loc
                    break
            if best_path is None:
                break
            actions.extend(best_path)
            move_along(best_path)
            # pick up
            actions.append(4)          # USE
            grid[best_loc[0], best_loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            amount -= 1

    # ----------------------------------------------------------------------
    # Recursive crafting
    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, needed):
        """Make sure *inventory[item_idx]* >= needed."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < needed:
            # if primitive, just collect
            if item_idx in primitives_set:
                collect_primitive(item_idx, needed - inventory[item_idx])
                continue

            # otherwise we need to craft it using its recipe
            recipe = recipes.get(item_idx, {})
            # ensure all ingredients are available
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                req = cnt
                if inventory[ing_idx] < req:
                    ensure_item(ing_idx, req)

            # move to required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # craft one unit
            actions.append(4)   # USE
            # simulate inventory changes
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Build the arrow
    ensure_item(target_idx, 1)

    return actions

