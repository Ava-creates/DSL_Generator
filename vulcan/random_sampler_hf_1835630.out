    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return grid[y, x].any()

    from collections import deque

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding blocked cells."""
        if start == goal:
            return []
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        rev.append(DOWN)
                    elif cur[0] == py - 1:
                        rev.append(UP)
                    elif cur[1] == px + 1:
                        rev.append(RIGHT)
                    elif cur[1] == px - 1:
                        rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(rev))
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # No path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell (Manhattan distance) containing ``kind_idx``."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[dists.argmin()]
        return tuple(nearest)

    def free_adjacent(cell, forbidden=set()):
        """Return a free neighbour of ``cell`` not in ``forbidden``."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in forbidden:
                continue
            if not blocked(ny, nx):
                return (ny, nx)
        return None

    def face_action(src, dst):
        """Return the single action needed to face ``dst`` from ``src``."""
        dy, dx = dst[0] - src[0], dst[1] - src[1]
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # ----------------------------------------------------------------------
    # Identify the arrow goal and its recipe
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)      # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos                     # (y, x)
    taken = set()                           # cells already harvested

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early
                return actions

            # Choose a free adjacent cell to stand on while picking up
            adj = free_adjacent(target, forbidden=taken)
            if adj is None:
                # Fallback: stay where we are (might be sub‑optimal but avoids crash)
                adj = cur_pos

            # Move to that adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive and use
            fa = face_action(cur_pos, target)
            if fa is not None:
                actions.append(fa)
            actions.append(USE)

            # Update internal grid copy and record the collection
            grid[target[0], target[1], prim_idx] = 0
            taken.add(target)

    # ----------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = free_adjacent(ws_cell, forbidden=taken)
            if ws_adj is None:
                ws_adj = cur_pos
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop before using
            fa = face_action(cur_pos, ws_cell)
            if fa is not None:
                actions.append(fa)

    # Final USE to trigger crafting (or to craft directly if no workshop)
    actions.append(USE)

    return actions

