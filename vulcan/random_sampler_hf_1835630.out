            pos, path = q.popleft()

            # Check adjacency (including diagonal) to any target cell
            for tx, ty in target_set:
                if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:
                    return path

            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H:
                    # Walk only through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell found

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Refresh state after each action
            state = env._current_state
            grid = state.grid
