    actions = []

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count_needed in needed_prims.items():
        collected = 0
        while collected < count_needed:
            # recompute reachable locations of this primitive
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                # nothing left to collect – break to avoid infinite loop
                break
            # choose the nearest location (Manhattan)
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_loc = locations[0]

            # plan path to approach this primitive with correct facing
            path = _plan_path_to_kind(pos, prim_idx, grid, occ)
            if not path:
                # cannot reach, abort
                break
            actions.extend(path)
            # update position after following path
            for a in path:
                if a == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif a == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif a == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif a == UP:
                    pos = (pos[0], pos[1] - 1)

            # use action to pick up primitive
            actions.append(USE)
            # update grid/occupancy: remove the primitive from that cell
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            occ[target_loc[0], target_loc[1]] = np.any(grid[target_loc[0], target_loc[1], :] > 0)
