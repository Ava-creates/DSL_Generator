    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Reset environment and fetch current state/world information.
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    # Work on a mutable copy of the grid so we can update it after pickups.
    grid = state.grid.copy()             # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def bfs(start, goal, allow_goal_occupied=False):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding occupied cells.
        ``allow_goal_occupied`` lets the goal cell be occupied (used for
        reaching a primitive cell that we will later pick up)."""
        from collections import deque

        h, w = grid.shape[0], grid.shape[1]
        visited = np.full((h, w), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                actions = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    dy, dx = cur[0] - py, cur[1] - px
                    if dy == 1:
                        actions.append(DOWN)
                    elif dy == -1:
                        actions.append(UP)
                    elif dx == 1:
                        actions.append(RIGHT)
                    elif dx == -1:
                        actions.append(LEFT)
                    cur = (py, px)
                actions.reverse()
                return actions

            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:
                    occupied = np.any(grid[ny, nx, :] > 0)
                    if occupied and not (allow_goal_occupied and (ny, nx) == goal):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list.
        return []

    def nearest_cells(kind_idx, from_pos):
        """Return list of coordinates containing ``kind_idx`` sorted by
        Manhattan distance from ``from_pos``."""
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return []
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        order = np.argsort(dists)
        return [tuple(cells[i]) for i in order]

    def free_adjacent(cell, exclude=set()):
        """Return a free adjacent coordinate to ``cell`` (4‑neighbourhood).
        If several are free, pick the one with smallest Manhattan distance
        to the current position (computed later). Returns None if none are free."""
        y, x = cell
        candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]
        free = []
        for ny, nx in candidates:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if (ny, nx) in exclude:
                    continue
                if not np.any(grid[ny, nx, :] > 0):
                    free.append((ny, nx))
        return free if free else None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives.
    # ------------------------------------------------------------------
    goal_name = 'arrow'
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos   # (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Locate nearest primitive cell (dynamic, based on current grid)
            candidates = nearest_cells(prim_idx, cur_pos)
            if not candidates:
                # Primitive not present – abort early.
                return actions
            target = candidates[0]   # nearest

            # Choose a free adjacent cell to stand on (if possible)
            adj_options = free_adjacent(target)
            if adj_options:
                # Pick the adjacent cell with minimal distance from cur_pos
                adj = min(adj_options,
                          key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
                path = bfs(cur_pos, adj)
            else:
                # No free neighbour; we will step onto the primitive cell itself.
                # Allow the goal cell to be occupied for the purpose of pickup.
                path = bfs(cur_pos, target, allow_goal_occupied=True)
                adj = target

            actions.extend(path)
            cur_pos = adj

            # Determine facing direction towards the primitive (if not on same cell)
            if cur_pos != target:
                dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
                if dy == 1:
                    actions.append(DOWN)
                elif dy == -1:
                    actions.append(UP)
                elif dx == 1:
                    actions.append(RIGHT)
                elif dx == -1:
                    actions.append(LEFT)
                # Now we are facing the primitive.
            # Use action to pick it up.
            actions.append(USE)

            # Update grid to reflect that the primitive has been collected.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        # Find nearest workshop cell (static – workshops never disappear)
        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size > 0:
            dists = np.abs(ws_cells[:, 0] - cur_pos[0]) + np.abs(ws_cells[:, 1] - cur_pos[1])
            nearest_ws = tuple(ws_cells[np.argmin(dists)])
            path = bfs(cur_pos, nearest_ws)
            actions.extend(path)
            cur_pos = nearest_ws

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions


    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # Direction vectors corresponding to the above actions
    DIRS = {
        DOWN: (1, 0),
        UP: (-1, 0),
        LEFT: (0, -1),
        RIGHT: (0, 1),
    }

    # Reset environment and obtain the current state and world objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (H, W, n_kinds)

    H, W, _ = grid.shape
    cur_pos = tuple(state.pos)            # (y, x)
    cur_dir = int(state.dir)              # initial facing direction

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < H and 0 <= x < W

    def cell_free(y, x):
        """Return True if the cell is traversable (no non‑grabbable or any item)."""
        if not in_bounds(y, x):
            return False
        # Non‑grabbable entities block movement
        occupied = np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)
        # Any item (including primitives) also blocks movement
        occupied = occupied or np.any(grid[y, x, :] > 0)
        return not occupied

    def bfs_path(start, goal):
        """Return a list of movement actions from start to goal avoiding blocked cells.
        If no path is found, returns empty list."""
        if start == goal:
            return []
        queue = collections.deque()
        queue.append(start)
        came_from = {start: None}
        action_from = {}
        while queue:
            y, x = queue.popleft()
            for act, (dy, dx) in DIRS.items():
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if not cell_free(ny, nx):
                    continue
                if (ny, nx) not in came_from:
                    came_from[(ny, nx)] = (y, x)
                    action_from[(ny, nx)] = act
                    if (ny, nx) == goal:
                        # reconstruct path
                        path = []
                        cur = goal
                        while cur != start:
                            path.append(action_from[cur])
                            cur = came_from[cur]
                        return list(reversed(path))
                    queue.append((ny, nx))
        return []  # no path found

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing the given kind."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = np.argmin(dists)
        return tuple(locations[nearest_idx])

    def adjacent_free_cells(y, x):
        """Return list of free neighbour coordinates around (y,x)."""
        neigh = []
        for dy, dx in DIRS.values():
            ny, nx = y + dy, x + dx
            if in_bounds(ny, nx) and cell_free(ny, nx):
                neigh.append((ny, nx))
        return neigh

    # ------------------------------------------------------------------
    # Determine the goal index and the primitive requirements.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []

    # ------------------------------------------------------------------
    # Collect each needed primitive.
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # Locate the next instance of this primitive
            prim_cell = find_nearest(prim_idx, cur_pos)
            if prim_cell is None:
                # primitive not present – abort planning
                return actions

            # Choose a free adjacent cell to stand on
            adj_candidates = adjacent_free_cells(*prim_cell)
            if not adj_candidates:
                # cannot reach this primitive – abort
                return actions
            # pick the candidate with minimal Manhattan distance from current pos
            dists = [abs(cy - cur_pos[0]) + abs(cx - cur_pos[1]) for (cy, cx) in adj_candidates]
            adj = adj_candidates[int(np.argmin(dists))]

            # Move to the chosen adjacent cell
            move_seq = bfs_path(cur_pos, adj)
            actions.extend(move_seq)
            if move_seq:
                cur_dir = move_seq[-1]   # last movement sets facing direction
                cur_pos = adj

            # Determine direction we need to face to interact with the primitive
            dy = prim_cell[0] - cur_pos[0]
            dx = prim_cell[1] - cur_pos[1]
            needed_dir = None
            for act, (ady, adx) in DIRS.items():
                if (ady, adx) == (dy, dx):
                    needed_dir = act
                    break

            # If we are not already facing the primitive, perform a turn by stepping
            # temporarily to a neighbouring free cell and stepping back.
            if needed_dir is not None and cur_dir != needed_dir:
                # Compute a helper cell opposite to the needed direction relative to current pos
                opp_y, opp_x = cur_pos[0] - dy, cur_pos[1] - dx
                if in_bounds(opp_y, opp_x) and cell_free(opp_y, opp_x):
                    # move to opposite cell
                    turn_seq = bfs_path(cur_pos, (opp_y, opp_x))
                    actions.extend(turn_seq)
                    if turn_seq:
                        cur_dir = turn_seq[-1]
                        cur_pos = (opp_y, opp_x)
                    # move back to original adjacent cell (this sets direction correctly)
                    back_action = needed_dir
                    actions.append(back_action)
                    cur_dir = needed_dir
                    cur_pos = adj
                else:
                    # fallback: just append the needed direction as a move (may be blocked)
                    actions.append(needed_dir)
                    cur_dir = needed_dir
                    # position unchanged

            # Use action to pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            move_seq = bfs_path(cur_pos, ws_cell)
            actions.extend(move_seq)
            if move_seq:
                cur_dir = move_seq[-1]
                cur_pos = ws_cell

    # Final USE to trigger crafting
    actions.append(USE)

    return actions

