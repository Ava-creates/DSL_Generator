    # ----------------------------------------------------------------------
    # 1. Collect each required primitive the needed number of times.
    # ----------------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            # Locate any cell that currently holds this primitive.
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                raise RuntimeError(f"Required primitive {idx.get(prim_idx, prim_idx)} not found on map.")
            target = tuple(locations[0])  # (x, y)

