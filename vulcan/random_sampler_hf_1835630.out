    # Helper: move to a cell containing ``kind_idx`` and USE it ``cnt`` times
    # ----------------------------------------------------------------------
    def collect_kind(kind_idx, cnt):
        nonlocal pos, actions, grid
        for _ in range(cnt):
            # locate all cells that currently hold the required kind
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            # find shortest path to the nearest such cell
