    """Plan actions to craft the goal item (e.g., 'arrow') in the given CraftLab environment.

    The planner:
    1. Queries the cookbook for all primitive resources required for the goal.
    2. Repeatedly moves to the nearest instance of each needed primitive,
       uses the ``USE`` action to pick it up, and updates a local copy of the grid.
    3. After all primitives are collected, moves adjacent to the required workshop
       (if the recipe specifies one) and uses ``USE`` to craft the goal.

    The function returns a flat list of action indices that can be fed directly
    to the environment via ``env.step(action)``.
    """
    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action / direction helpers (as defined by CraftLab)
    # ----------------------------------------------------------------------
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search that returns a list of actions moving the agent
    # from ``start`` to a cell adjacent (Manhattan distance 1) to any of
    # the ``targets`` while avoiding blocked cells.
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, targets, grid):
        """Return actions to reach a cell adjacent to any target."""
        W, H = grid.shape[:2]

        # Cells occupied by any non‑grabbable entity are considered blocked.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Initialise state information
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()                 # mutable copy of the world grid
    pos = tuple(state.pos)                   # (x, y)

    # Goal index is stored in the task (env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Determine all primitive (and intermediate) requirements for the goal.
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives
    # ----------------------------------------------------------------------
    for kind_idx, remaining in needed.items():
        while remaining > 0:
            # Find cells that currently contain this primitive.
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive not present on the map – abort planning.
                return plan

            # Compute a path to the nearest reachable primitive (adjacent).
            path = bfs_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to update the agent's position.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update the simulated grid and decrement the requirement.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            remaining -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name or an integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        # Locate cells that contain the workshop.
        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to the workshop.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(ACTION_USE)

    # Return the full action sequence.
    return plan


    import numpy as np
    from collections import deque

    # Action indices as defined in CraftLab
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR_TO_ACT = {
        (0, 1): ACTION_DOWN,
        (0, -1): ACTION_UP,
        (-1, 0): ACTION_LEFT,
        (1, 0): ACTION_RIGHT,
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    def bfs(start, targets, grid):
        """Bread‑first search returning actions that move the agent from ``start``
        to a cell adjacent to any ``targets`` while avoiding blocked cells."""
        W, H = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)

        sx, sy = start
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []

    # ------------------------------------------------------------------
    # Gather current state information
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)

    # Goal index stored in env.task.goal (could be int or Struct)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal not found in env.task")

    # ------------------------------------------------------------------
    # Determine primitive resources required for the goal
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        while needed > 0:
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                return plan

            path = bfs(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            plan.append(ACTION_USE)

            adj = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                break

            grid[adj[0], adj[1], prim_idx] -= 1
            needed -= 1

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            plan.append(ACTION_USE)

    return plan

