    import collections
    import numpy as np

    # ----------------------------------------------------------------------
    # Action identifiers – match the default CraftWorld action ordering.
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `start`
    # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in
    # `targets`.  The search treats any non‑empty cell as blocked, except
    # the target cells themselves (we only need to get next to them).
    # ----------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        width, height = occupied.shape
        target_set = set(targets)

        # Quick check – already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                # Can step on the cell if it is empty
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                # Check adjacency to any target after the move
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        # No reachable adjacent cell – return empty list (caller may fail later)
        return []

    # ----------------------------------------------------------------------
    # Retrieve world / cookbook information.
    # ----------------------------------------------------------------------
    # The environment may expose the world directly or via the current state.
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers store the world inside the current state.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        # Ensure we have a state object for position / grid.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Determine primitive requirements for one arrow.
    # ----------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    # If the goal has no recipe (already primitive), just return an empty list.
    if not primitives_needed:
        return []

    # ----------------------------------------------------------------------
    # Current grid / position.
    # ----------------------------------------------------------------------
    grid = state.grid  # shape (W, H, n_kinds)
    pos = tuple(state.pos)  # (x, y)

    # Occupancy mask – True where any entity (including primitives) exists.
    occupied = np.any(grid > 0, axis=2)

    actions = []
    harvested = set()  # locations already collected from

    # ----------------------------------------------------------------------
    # Collect required primitives (greedy nearest‑first).
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # Find all cells currently containing this primitive.
            prim_locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            # Exclude locations already used.
            prim_locs = [loc for loc in prim_locs if loc not in harvested]
            if not prim_locs:
                # No more primitives of this type on the map – abort.
                break
            # Choose the nearest location (Manhattan distance).
            prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = prim_locs[0]

            # Plan path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement to update `pos`.
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Perform USE to pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # After picking up, the cell becomes empty – update occupancy.
            occupied[target] = False

    # ----------------------------------------------------------------------
    # Craft the arrow at the required workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name string).
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key
        # Locate workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = workshop_cells[0]
            # Move adjacent to the workshop.
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use to craft.
            actions.append(USE)
        else:
            # No workshop of required type found – fallback to using current cell.
            actions.append(USE)
    else:
        # Recipe does not specify a workshop; simply USE at current location.
        actions.append(USE)

    return actions

