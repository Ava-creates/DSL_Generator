    # --------------------------------------------------------------
    # Helper mappings between directions and action indices (CraftLab)
    # --------------------------------------------------------------
    DIR_TO_ACT = {(0, 1): 0,   # DOWN
                  (0, -1): 1,  # UP
                  (-1, 0): 2,  # LEFT
                  (1, 0): 3}   # RIGHT
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}
    ACTION_USE = 4

    # --------------------------------------------------------------
    # Bread‑first search that returns a list of actions moving from
    # ``start`` to a cell adjacent (Manhattan distance 1) to any cell in
    # ``targets`` while avoiding blocked cells.
    # --------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs(start, targets, grid, block_set):
        """Return actions to reach a position adjacent to any target cell.

        Args:
            start (tuple): (x, y) current position.
            targets (list of tuple): list of (x, y) cells we want to be adjacent to.
            grid (np.ndarray): (W, H, K) world grid.
            block_set (set[int]): kind indices that are non‑grabbable (treated as obstacles).

        Returns:
            list[int]: sequence of movement actions; empty if already adjacent or unreachable.
        """
        W, H = grid.shape[:2]

        # pre‑compute blocked boolean map
        blocked = np.zeros((W, H), dtype=bool)
        for b in block_set:
            blocked |= grid[:, :, b] > 0

        sx, sy = start

        # already adjacent to a target?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # check adjacency to any target
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []   # no reachable adjacency

    # --------------------------------------------------------------
    # Extract current state information
    # --------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)                     # (x, y)

    # Goal index is stored in the task (env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive requirements for the goal (including counts)
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    block_set = env.world.non_grabbable_indices

    plan = []

    # --------------------------------------------------------------
    # 1. Collect all required primitives
    # --------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        while cnt > 0:
            # Find cells that still contain this primitive
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive unavailable – abort planning
                return plan

            # Compute path to a position adjacent to the nearest primitive
            path = bfs(pos, cells.tolist(), grid, block_set)
            plan.extend(path)

            # Simulate movement to keep ``pos`` up‑to‑date
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to
            adj = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                # Unexpected – stop to avoid infinite loop
                break

            # Update local copy of the grid and decrement needed count
            grid[adj[0], adj[1], kind_idx] -= 1
            cnt -= 1

    # --------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid, block_set)
            plan.extend(path)

            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop
            plan.append(ACTION_USE)

    return plan


    # --------------------------------------------------------------
    # Helper constants and mappings for actions/directions.
    # --------------------------------------------------------------
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,
        (0, -1): ACTION_UP,
        (-1, 0): ACTION_LEFT,
        (1, 0): ACTION_RIGHT,
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # --------------------------------------------------------------
    # Bread‑first‑search returning a list of actions that brings the
    # agent to a cell adjacent (Manhattan distance 1) to any cell in
    # ``targets`` while avoiding blocked cells (any entity whose kind
    # is in ``block_set``).
    # --------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs(start, targets, grid, block_set):
        W, H = grid.shape[:2]

        # pre‑compute boolean map of blocked cells
        blocked = np.zeros((W, H), dtype=bool)
        for b in block_set:
            blocked |= grid[:, :, b] > 0

        sx, sy = start

        # already adjacent to a target?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # check adjacency to any target
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency
        return []

    # --------------------------------------------------------------
    # Extract current world state and task information.
    # --------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()                     # (W, H, K)
    pos = tuple(state.pos)                       # (x, y)

    # Goal index is stored in the task object.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive requirements for the goal (only primitives, counts).
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    block_set = env.world.non_grabbable_indices

    plan = []

    # --------------------------------------------------------------
    # 1. Collect all required primitives.
    # --------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        while cnt > 0:
            # Find all cells that still contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not available – abort planning.
                return plan

            # Compute a path to a cell adjacent to the nearest reachable primitive.
            path = bfs(pos, prim_cells.tolist(), grid, block_set)
            plan.extend(path)

            # Simulate the movement to keep ``pos`` up‑to‑date.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive.
            plan.append(ACTION_USE)

            # Determine which primitive cell we are now adjacent to.
            adj = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                # Unexpected – break to avoid infinite loop.
                break

            # Update local copy of the grid and decrement the required count.
            grid[adj[0], adj[1], prim_idx] -= 1
            cnt -= 1

    # --------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or an integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid, block_set)
            plan.extend(path)

            # Simulate movement to the workshop.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to craft at the workshop.
            plan.append(ACTION_USE)

    # --------------------------------------------------------------
    # Return the complete action sequence.
    # --------------------------------------------------------------
    return plan

