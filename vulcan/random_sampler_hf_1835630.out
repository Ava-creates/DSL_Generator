    from collections import deque

    def bfs(start, goals):
        """Shortest path of actions (0=DOWN,1=UP,2=LEFT,3=RIGHT) to any goal cell."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat any occupied cell as blocked unless it is a goal
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update simulated position according to a list of movement actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(kind_idx, amount):
        """Collect `amount` units of the primitive `kind_idx` from the grid."""
        nonlocal actions, grid, inventory, pos
        while amount > 0:
            # locate all cells that still contain the primitive
            cells = [(x, y) for x in range(width) for y in range(height)
                     if grid[x, y, kind_idx] > 0]
            if not cells:
                raise RuntimeError("Not enough primitive items on the map")
            # find a reachable cell
            path = None
            target = None
            for cell in cells:
                p = bfs(pos, {cell})
                if p is not None:
                    path, target = p, cell
                    break
            if path is None:
                raise RuntimeError("Primitive is unreachable")
            actions.extend(path)
            move_along(path)
            actions.append(4)  # USE to pick up
            grid[target[0], target[1], kind_idx] = 0
            inventory[kind_idx] += 1
            amount -= 1

    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, needed):
        """Make sure inventory[item_idx] >= needed by collecting/crafting."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < needed:
            if item_idx in primitives_set:
                collect_primitive(item_idx, needed - inventory[item_idx])
                continue

