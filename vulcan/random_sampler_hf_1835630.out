    import collections, numpy as np

    # Action indices (assumed standard in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions that moves the agent from
    # `start` (x, y) to a cell adjacent (Manhattan distance ≤ 1) to any
    # position in `targets`. Cells with any non‑zero kind are treated as
    # obstacles.
    # ------------------------------------------------------------------
    def _bfs(start, targets, occupied):
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop if we are already adjacent to a target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # Unreachable – return empty list.
        return []

    # ------------------------------------------------------------------
    # Locate world and cookbook objects.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state.
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = state_tmp.world
    if world is None:
        raise RuntimeError("World object not found in the environment.")

    cookbook = world.cookbook

    # Ensure we have a current state (reset if necessary).
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal is hard‑coded to "arrow".
    # ------------------------------------------------------------------
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Current position and a mutable copy of the grid.
    pos = tuple(state.pos)                # (x, y)
    cur_grid = state.grid.copy()          # (W, H, n_kinds)

    actions = []
    harvested = set()                     # cells already collected from

    # Helper to compute occupied map (any non‑empty cell).
    def occupied_map(g):
        return np.any(g > 0, axis=2)

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # All cells currently containing this primitive.
        locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Order by Manhattan distance from current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            occ = occupied_map(cur_grid)
            path = _bfs(pos, [loc], occ)
            actions.extend(path)
            # Update internal position tracker.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Clear the cell for future navigation.
            cur_grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or already an int).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else workshop_key)
        # Find all workshop cells currently present.
        workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop.
            occ = occupied_map(cur_grid)
            path = _bfs(pos, [target_ws], occ)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use the workshop to craft the arrow.
            actions.append(USE)

    return actions

