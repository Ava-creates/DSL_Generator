                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                    # Only walk through completely empty cells
                    if grid[nx, ny].sum() == 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell found

