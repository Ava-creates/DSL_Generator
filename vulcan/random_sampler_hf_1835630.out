        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    def bfs_path(start, goal):
        """Return a shortest sequence of actions (DOWN/UP/LEFT/RIGHT) from
        ``start`` to ``goal`` while avoiding non‑grabbable obstacles."""
        if start == goal:
            return []
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}                     # (y,x) -> (prev_y, prev_x, action)

        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            for (dy, dx), act in DIRS.items():
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # cell blocked if any non‑grabbable entity occupies it
                    if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x, act)
                    if (ny, nx) == goal:
                        # reconstruct path
                        actions = []
                        cur = (ny, nx)
                        while cur != start:
                            py, px, a = prev[cur]
                            actions.append(a)
                            cur = (py, px)
                        actions.reverse()
                        return actions
                    q.append((ny, nx))
        # No path found – should not happen in well‑formed scenarios
        return []

    def find_nearest(kind, from_pos):
        """Locate the nearest cell containing ``kind`` (primitive or workshop)
        using Manhattan distance. Returns (y, x) or None if not present."""
        locations = np.argwhere(grid[:, :, kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = int(np.argmin(dists))
        return tuple(locations[nearest_idx])

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Move to the primitive cell
            actions.extend(bfs_path(cur_pos, target))
            cur_pos = target

            # Pick up the primitive
            actions.append(USE)

            # Update local grid copy so we don't try to collect the same cell again
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions.extend(bfs_path(cur_pos, ws_cell))
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions

