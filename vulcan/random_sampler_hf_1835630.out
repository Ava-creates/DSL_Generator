    # constants for actions
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # helper: locate the nearest cell (Manhattan) containing a given kind
    # ------------------------------------------------------------------
    def _find_nearest(grid, kind_idx, start_pos):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start_pos[0]) + abs(j - start_pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # helper: locate any cell containing a given kind
    # ------------------------------------------------------------------
    def _find_any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # helper: produce a simple Manhattan path from src to dst
    # ------------------------------------------------------------------
    def _path(src, dst):
        actions = []
        cur_r, cur_c = src
        dst_r, dst_c = dst
        while cur_r != dst_r:
            if cur_r < dst_r:
                actions.append(DOWN)
                cur_r += 1
            else:
                actions.append(UP)
                cur_r -= 1
        while cur_c != dst_c:
            if cur_c < dst_c:
                actions.append(RIGHT)
                cur_c += 1
            else:
                actions.append(LEFT)
                cur_c -= 1
        return actions

    # ------------------------------------------------------------------
    # start episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # ------------------------------------------------------------------
    # identify the goal item (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        # unknown goal – nothing to do
        return []

    # ------------------------------------------------------------------
    # primitive requirements for one arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}

    action_seq = []

    # ------------------------------------------------------------------
    # collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            # locate nearest primitive of this kind
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # cannot find the primitive – abort
                return action_seq
            # move next to the cell (standing on the cell is fine for USE)
            moves = _path(state.pos, target)
            for a in moves:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = None
    for k, v in recipe.items():
        if k == "_at":
            workshop_name = v
            break

    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_any(state.grid, workshop_idx)
        if workshop_pos is not None:
            moves = _path(state.pos, workshop_pos)
            for a in moves:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # perform the crafting action
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    return action_seq

