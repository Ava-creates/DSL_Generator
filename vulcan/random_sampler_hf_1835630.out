    # ------------------------------------------------------------------
    # Bread‑first search over (state, action‑history) pairs.
    # ------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """Hashable representation of a CraftState."""
        inv_key = tuple(st.inventory.tolist())
        grid_key = st.grid.tobytes()
        return (st.pos, st.dir, inv_key, grid_key)

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_PLAN_LENGTH = 800                 # safety cap on trajectory length
    n_actions = getattr(world, "n_actions", 5)   # typically 5 (4 moves + USE)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: at least one arrow in the inventory.
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long sequences.
        if len(node.actions) >= MAX_PLAN_LENGTH:
            continue

        # Expand all primitive actions.
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the limits.
    return []


    # Retrieve scenario and world objects
    scenario = getattr(env, "scenario", None) or env
