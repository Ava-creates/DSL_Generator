    # ------------------------------------------------------------------
    # Bread‑first search over (state, action‑list) pairs
    # ------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory (as tuple), and grid layout (bytes)
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    visited.add(_state_hash(init_state))

    frontier = deque([Node(init_state, [])])

    # Safety limits
    MAX_STEPS = 250          # maximum length of a returned plan
    MAX_NODES = 20000        # cap on explored nodes to avoid blow‑up

    n_actions = getattr(world, "n_actions", 5)   # default actions: 0‑4

    explored = 0

    while frontier and explored < MAX_NODES:
        node = frontier.popleft()
        cur_state = node.state
        explored += 1

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", arrow_idx):
            return node.actions

        # Prune overly long plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If we exit the loop without finding a solution, return empty list
    return []


