        return []

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # positions the agent so that the cell directly in front contains
    # `target_kind`. Returns [] if unreachable.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        from collections import deque
        import numpy as np

        grid = state.grid
        W, H = grid.shape[:2]

        # direction deltas matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            # a cell is walkable if it is inside the grid and empty
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sd = state.dir
        q = deque()
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return []  # unreachable

    actions = []

    # --------------------------------------------------------------
    # 1) Collect required primitives for a single arrow.
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            # If we cannot move but are already adjacent, still allow a USE.
            if not move_seq and not cur_state.next_to(prim_idx):
                # Primitive unreachable – abort planning.
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            # Keep state in sync.
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # 2) Craft the arrow at its required workshop (if any).
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        actions.extend(move_seq)
        actions.append(4)  # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – attempt crafting in place.
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions


