    # Locate scenario and world objects
    try:
        scenario = env.scenario
    except Exception:
        scenario = getattr(env, "scenario", None)
    if scenario is None:
        # In some wrappers the env itself may be the scenario
        scenario = env
    world = getattr(scenario, "world", None)
    if world is None:
        world = getattr(env, "world", None)

    # Identify the index of the target item ("arrow")
    try:
        arrow_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting CraftState
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # Bread‑first search over state space to find a plan
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        # Combine position, direction, inventory and grid layout into a hashable key
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque()
    frontier.append(Node(init_state, []))
    visited.add(_state_hash(init_state))

    # Limit search depth to avoid infinite loops
    MAX_STEPS = 200

    # Number of possible actions (standard: 0‑4)
    try:
        n_actions = world.n_actions
    except Exception:
        n_actions = 5

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test
        if cur_state.satisfies("", arrow_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand neighbours
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If no plan found within the depth limit, return an empty list
    return []

