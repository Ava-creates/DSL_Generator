    # Breadth‑first search to find a path of actions from start to any target cell.
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    def bfs(start, targets, blocked):
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # Should never happen for a solvable scenario

    # Move to a cell containing a given kind and issue a USE action `cnt` times.
    def acquire(kind_idx, cnt):
        nonlocal pos, actions
        for _ in range(cnt):
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)   # USE

    # ----------------------------------------------------------------------
    # Gather world / recipe information
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    # ----------------------------------------------------------------------
    # Resolve full crafting plan: primitives needed + ordered craft steps
    # ----------------------------------------------------------------------
    needed_prims = {}          # primitive idx → total count
    craft_steps = []           # (item_idx, count) in dependency order

    def resolve(item_idx, mul):
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul
            return
        # Resolve ingredients first (ignore special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mul)
        # Schedule this item to be crafted after its ingredients
        craft_steps.append((item_idx, mul))

    resolve(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # Prepare static data: grid, blocked cells, dimensions
    # ----------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Build action sequence
    # ----------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Collect all primitive resources required by the recipe
    for kind, cnt in needed_prims.items():
        acquire(kind, cnt)

    # 2) Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * cnt)   # USE at workshop

    return actions


    # Gather world and recipe information
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    # ------------------------------------------------------------------
    # Resolve full dependency tree: primitives needed and craft order
    # ------------------------------------------------------------------
    needed_prims = {}          # primitive index -> total count required
    craft_steps = []           # list of (item_idx, count) in post‑order

    def resolve(item_idx: int, multiplier: int) -> None:
        """Populate needed_prims and craft_steps for `item_idx`."""
        recipe = cookbook.recipes.get(item_idx)
        if recipe is None:                     # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier
            return
        # Resolve ingredients first (ignore special keys)
        for ing, cnt in recipe.items():
            if isinstance(ing, int):
                resolve(ing, cnt * multiplier)
        # Schedule crafting of this item after its ingredients
        craft_steps.append((item_idx, multiplier))

    resolve(arrow_idx, 1)

    # ------------------------------------------------------------------
    # Static world data
    # ------------------------------------------------------------------
    grid = env._current_state.grid                     # (W, H, n_kinds)
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # Directions aligned with action indices: 0‑DOWN, 1‑UP, 2‑LEFT, 3‑RIGHT
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of action numbers that reaches any target cell
    # ------------------------------------------------------------------
    from collections import deque

    def bfs(start, targets):
        """Return list of actions to reach the nearest cell in `targets`."""
        q = deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []   # Should never happen in a solvable scenario

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)   # current (x, y)

    # 1) Collect all required primitive resources
    for kind_idx, count in needed_prims.items():
        # locate any cell that currently holds this primitive
        primitive_cells = {(x, y) for x in range(w) for y in range(h)
                           if grid[x, y, kind_idx] > 0}
        path = bfs(pos, primitive_cells)
        actions.extend(path)
        for a in path:                     # update simulated position
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        actions.extend([4] * count)        # USE action (index 4) to pick up

    # 2) Perform crafting steps at the appropriate workshops
    for item_idx, count in craft_steps:
        recipe = cookbook.recipes[item_idx]
        wk_key = recipe.get("_at", recipe.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        workshop_cells = {(x, y) for x in range(w) for y in range(h)
                          if grid[x, y, wk_idx] > 0}
        path = bfs(pos, workshop_cells)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * count)        # USE at workshop to craft

    return actions

