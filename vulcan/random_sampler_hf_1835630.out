    # reset environment and get handles
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # helper functions
    # ------------------------------------------------------------------
    def is_walkable(y, x):
        """Cell is walkable if inside bounds and either empty or a workshop."""
        if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):
            return False
        # workshop cells are allowed to stand on
        if world.cookbook.index.get('_at') and (y, x) in workshop_cells_set:
            return True
        # any non‑grabbable entity blocks movement
        if np.any(grid[y, x, list(world.non_grabbable_indices)] > 0):
            return False
        # any other entity (including primitives) also blocks movement
        if np.any(grid[y, x] > 0):
            return False
        return True

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.
        Uses 4‑connected BFS on walkable cells. If no path, returns empty list."""
        if start == goal:
            return []
        q = collections.deque()
        q.append(start)
        visited = {start: None}
        while q:
            y, x = q.popleft()
            for dy, dx, a in DIRS:
                ny, nx = y + dy, x + dx
                if not is_walkable(ny, nx):
                    continue
                if (ny, nx) not in visited:
                    visited[(ny, nx)] = (y, x, a)
                    if (ny, nx) == goal:
                        # reconstruct path
                        path_actions = []
                        cur = (ny, nx)
                        while visited[cur] is not None:
                            py, px, act = visited[cur]
                            path_actions.append(act)
                            cur = (py, px)
                        return list(reversed(path_actions))
                    q.append((ny, nx))
        return []  # no path found

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing `kind_idx` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_walkable(target, from_pos):
        """Pick a walkable neighbour of `target` (prefer the one closest to `from_pos`)."""
        candidates = []
        ty, tx = target
        for dy, dx, _ in DIRS:
            ny, nx = ty + dy, tx + dx
            if is_walkable(ny, nx):
                manh = abs(ny - from_pos[0]) + abs(nx - from_pos[1])
                candidates.append((manh, (ny, nx)))
        if not candidates:
            # fallback: maybe we can stand on the target itself (unlikely)
            if is_walkable(ty, tx):
                return (ty, tx)
            return None
        candidates.sort()
        return candidates[0][1]

    # ------------------------------------------------------------------
    # locate workshop cells once (used by is_walkable)
    # ------------------------------------------------------------------
    workshop_cells = []
    for ws_idx in world.workshop_indices:
        ws_cells = np.argwhere(grid[:, :, ws_idx] > 0)
        workshop_cells.extend([tuple(c) for c in ws_cells])
    workshop_cells_set = set(workshop_cells)

    # ------------------------------------------------------------------
    # recipe information for the arrow
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            prim_cell = find_nearest(prim_idx, cur_pos)
            if prim_cell is None:
                # primitive not present – give up early
                return actions
            # choose a walkable neighbour to stand on
            stand_cell = adjacent_walkable(prim_cell, cur_pos)
            if stand_cell is None:
                # cannot reach primitive, abort
                return actions
            # move to the chosen cell
            actions += bfs_path(cur_pos, stand_cell)
            cur_pos = stand_cell

            # face the primitive: issue a move towards it (will stay if blocked)
            dy = prim_cell[0] - cur_pos[0]
            dx = prim_cell[1] - cur_pos[1]
            if dy > 0:
                actions.append(DOWN)
            elif dy < 0:
                actions.append(UP)
            elif dx > 0:
                actions.append(RIGHT)
            elif dx < 0:
                actions.append(LEFT)

            # pick it up
            actions.append(USE)

    # ------------------------------------------------------------------
    # go to workshop (if required) and craft
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # final USE to trigger crafting of the arrow
    actions.append(USE)

    return actions

