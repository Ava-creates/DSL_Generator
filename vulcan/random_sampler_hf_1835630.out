    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                   # CraftWorld
    grid = state.grid                   # (H, W, n_kinds)

    # Resolve action identifiers (fallback to default ordering)
    specs = env.action_specs()
    DOWN = specs.get("DOWN", 0)
    UP = specs.get("UP", 1)
    LEFT = specs.get("LEFT", 2)
    RIGHT = specs.get("RIGHT", 3)
    USE = specs.get("USE", 4)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque

    # Indices of entities that block movement
    non_grab = list(world.non_grabbable_indices)

    def bfs_path(start, goal):
        """Breadth‑first search returning a list of movement actions from
        ``start`` to ``goal`` while avoiding non‑grabbable obstacles."""
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # Reconstruct action list
                rev = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        rev.append(DOWN)
                    elif py == cur[0] + 1:
                        rev.append(UP)
                    elif px == cur[1] - 1:
                        rev.append(RIGHT)
                    elif px == cur[1] + 1:
                        rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(rev))

            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # Cell is blocked if any non‑grabbable entity occupies it.
                    if np.any(grid[ny, nx, non_grab] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list
        return []

    def find_nearest(kind, from_pos):
        """Return coordinates of the nearest cell containing ``kind``."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = int(np.argmin(dists))
        return tuple(locs[nearest])

    # ------------------------------------------------------------------
    # Determine goal (arrow) and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on before using
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx),
                           (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    if not np.any(grid[ny, nx, non_grab] > 0):
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; fall back to the primitive cell itself
                adj = target

            # Move to the adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Turn to face the primitive (issue a move in that direction;
            # it may be blocked but direction will change)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Reset environment and get current state.
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                   # CraftWorld
    # Work on a mutable copy of the grid so we can update it as items are collected.
    grid = state.grid.copy()            # (W, H, n_kinds)

    # Resolve action indices (fallback to default ordering if not present).
    specs = env.action_specs()
    DOWN = specs.get("DOWN", 0)
    UP = specs.get("UP", 1)
    LEFT = specs.get("LEFT", 2)
    RIGHT = specs.get("RIGHT", 3)
    USE = specs.get("USE", 4)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def bfs_path(start, goal):
        """Return a list of movement actions that moves from start to goal
        while avoiding non‑grabbable obstacles."""
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # Reconstruct actions.
                rev = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        rev.append(DOWN)
                    elif py == cur[0] + 1:
                        rev.append(UP)
                    elif px == cur[1] - 1:
                        rev.append(RIGHT)
                    else:
                        rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(rev))

            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    if np.any(grid[ny, nx, non_grab] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        return []  # No path found.

    def find_nearest(kind, from_pos):
        """Find the nearest cell containing `kind` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = int(np.argmin(dists))
        return tuple(locs[nearest])

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on.
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx),
                           (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    if not np.any(grid[ny, nx, non_grab] > 0):
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour, fall back to the primitive cell itself.
                adj = target

            # Move to the chosen adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive.
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update the local grid to reflect that the primitive has been collected.
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting.
    actions.append(USE)

    return actions

