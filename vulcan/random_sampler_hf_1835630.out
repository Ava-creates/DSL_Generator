    # --------------------------------------------------------------
    # Helper: BFS to a cell adjacent to any target while avoiding
    # non‑grabbable entities.
    # --------------------------------------------------------------
    from collections import deque
    import numpy as np

    DIR_TO_ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    def bfs_adjacent(start, targets, grid, blocked_kinds):
        """Return a list of actions moving from ``start`` to a cell that is
        orthogonally adjacent to any cell in ``targets``. If already adjacent,
        returns an empty list. ``blocked_kinds`` is an iterable of kind indices
        that cannot be stepped on."""
        W, H = grid.shape[:2]

        # Pre‑compute blocked map.
        blocked = np.zeros((W, H), dtype=bool)
        for k in blocked_kinds:
            blocked |= grid[:, :, k] > 0

        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacent cell.
        return []

    # --------------------------------------------------------------
    # Initialise state.
    # --------------------------------------------------------------
    # Ensure the environment is in a fresh state.
    try:
        env.reset()
    except Exception:
        pass  # env may already be reset; ignore.

    state = env._current_state
    grid = state.grid.copy()          # mutable copy for planning
    pos = tuple(state.pos)            # (x, y)

    # Goal item index is stored in the task.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task.")

    # --------------------------------------------------------------
    # 1. Gather required primitives.
    # --------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    blocked_kinds = env.world.non_grabbable_indices

    for kind_idx, cnt in needed.items():
        while cnt > 0:
            # Locate all cells that still contain this primitive.
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive exhausted – abort planning.
                return plan

            # Find path to a cell adjacent to one of the primitives.
            path = bfs_adjacent(pos, cells.tolist(), grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(4)   # USE action.

            # Identify which primitive cell we just used (must be adjacent).
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Safety fallback – stop planning.
                return plan

            # Update local grid and decrement needed count.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt -= 1

    # --------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")   # some recipes use _key

    if workshop_key is not None:
        # Resolve workshop kind index.
        if isinstance(workshop_key, str):
