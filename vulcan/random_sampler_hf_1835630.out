    width, height, _ = grid.shape
    actions = []                               # list of action ints to return

    from collections import deque

    # ------------------------------------------------------------------
    # Breadth‑first search on the current grid.
    # Returns a list of actions (DOWN,UP,LEFT,RIGHT) that moves from *start*
    # to any cell in *goals*.  Cells occupied by any entity are treated as
    # blocked unless they are one of the goal cells.
    def bfs(start, goals):
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat any occupied cell as blocked unless it is a goal
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    # ------------------------------------------------------------------
    # Update the simulated position according to a sequence of actions.
    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:       # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1:     # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2:     # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3:     # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ------------------------------------------------------------------
    # Primitive collection: walk to the nearest cell containing the primitive,
    # execute USE, update simulated grid & inventory.
    def collect_primitive(kind_idx, needed):
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, kind_idx] > 0]
            if not locations:
                raise RuntimeError(f"Not enough of primitive {kind_idx} on the map")
            # find first reachable location
            path = None
            target = None
            for loc in locations:
                p = bfs(pos, {loc})
                if p is not None:
                    path = p
                    target = loc
                    break
            if path is None:
                raise RuntimeError("Primitive unreachable")
            actions.extend(path)
            move_along(path)
            actions.append(4)                     # USE
            grid[target[0], target[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    # ------------------------------------------------------------------
    # Recursive crafting helper: guarantee at least *amount* of *item_idx*
    # in the inventory, crafting intermediate items as needed.
    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives_set:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            # ensure all ingredients are available
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # perform the craft action
            actions.append(4)                     # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions

