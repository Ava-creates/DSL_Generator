    # ----------------------------------------------------------------------
    # Setup
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    grid = state.grid.copy()
    pos = tuple(state.pos)                     # (x, y)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions: list[int] = []

    from collections import deque

    # ----------------------------------------------------------------------
    # Helpers
    def bfs(start: tuple[int, int], goals: set[tuple[int, int]]) -> list[int] | None:
        """Return a list of movement actions to reach any cell in *goals*."""
        q = deque([(start, [])])
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # Blocked if occupied by a non‑workshop entity and not a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    # If the occupied cell is a workshop, we may step onto it
                    occupied_kinds = np.where(grid[nx, ny, :] > 0)[0]
                    if not any(k in world.workshop_indices for k in occupied_kinds):
                        continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path: list[int]) -> None:
        """Update simulated position according to a sequence of actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ----------------------------------------------------------------------
    # Primitive collection
    def collect_primitive(kind_idx: int, needed: int) -> None:
        """Collect *needed* units of a primitive from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate any cell that still contains this primitive
            cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, kind_idx] > 0]
            if not cells:
                raise RuntimeError(f"Not enough primitive {kind_idx} on the map")
            # find a reachable one (first reachable)
            chosen_path = None
            chosen_cell = None
            for cell in cells:
                p = bfs(pos, {cell})
                if p is not None:
                    chosen_path, chosen_cell = p, cell
                    break
            if chosen_path is None:
                raise RuntimeError("Primitive unreachable")
            # travel to the primitive
            actions.extend(chosen_path)
            move_along(chosen_path)
            # pick it up
            actions.append(4)   # USE
            grid[chosen_cell[0], chosen_cell[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    # ----------------------------------------------------------------------
    # Recursive crafting
    recipes = cookbook.recipes
    primitives = cookbook.primitives

    def ensure_item(item_idx: int, amount: int) -> None:
        """Make sure at least *amount* of *item_idx* are in the inventory."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            # Primitive – just collect
            if item_idx in primitives:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # Craft using its recipe
            recipe = recipes.get(item_idx, {})
            # First, ensure all ingredients are available
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # Move to required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ws_idx] > 0]
                if not ws_cells:
                    raise RuntimeError("Required workshop not present on the map")
                path = bfs(pos, {ws_cells[0]})
                if path is None:
                    raise RuntimeError("Workshop unreachable")
                actions.extend(path)
                move_along(path)

            # Perform the craft action
            actions.append(4)   # USE
            # Update simulated inventory
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions


    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Basic references
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Target item index (arrow)
    target_idx = cookbook.index["arrow"]

    # Local copies for planning
    grid = state.grid.copy()
    pos = tuple(state.pos)                     # (x, y)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions: list[int] = []

    # ------------------------------------------------------------------
    # Helper: breadth‑first search for a path of actions to any goal cell
    def bfs(start: tuple[int, int], goals: set[tuple[int, int]]) -> list[int] | None:
        q = deque([(start, [])])
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # cell is blocked if any kind is present, unless it is a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    # ------------------------------------------------------------------
    # Update simulated position according to a sequence of actions
    def apply_path(path: list[int]) -> None:
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ------------------------------------------------------------------
    # Collect a primitive from the map
    def collect_primitive(kind_idx: int, amount: int) -> None:
        nonlocal actions, grid, inventory, pos
        while amount > 0:
            # locate cells that still contain the primitive
            cells = [(x, y) for x in range(width) for y in range(height)
                     if grid[x, y, kind_idx] > 0]
            if not cells:
                raise RuntimeError(f"Not enough primitive {kind_idx} on the map")
            # find a reachable cell (first one found)
            path = None
            target = None
            for cell in cells:
                p = bfs(pos, {cell})
                if p is not None:
                    path, target = p, cell
                    break
            if path is None:
                raise RuntimeError("Primitive unreachable")
            actions.extend(path)
            apply_path(path)
            # pick up the primitive
            actions.append(4)                     # USE
            grid[target[0], target[1], kind_idx] = 0
            inventory[kind_idx] += 1
            amount -= 1

    # ------------------------------------------------------------------
    # Ensure we have at least `need` units of `item_idx` in inventory
    recipes = cookbook.recipes
    primitives = cookbook.primitives

    def ensure_item(item_idx: int, need: int) -> None:
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < need:
            # Primitive: just collect
            if item_idx in primitives:
                collect_primitive(item_idx, need - inventory[item_idx])
                continue

            # Craft using recipe
            recipe = recipes.get(item_idx, {})
            # Gather ingredients first
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # Move to required workshop, if any
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = (workshop if isinstance(workshop, int)
                          else cookbook.index[workshop])
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if not ws_cells:
                    raise RuntimeError("Required workshop not found on map")
                p = bfs(pos, {ws_cells[0]})
                if p is None:
                    raise RuntimeError("Workshop unreachable")
                actions.extend(p)
                apply_path(p)

            # Perform the craft action
            actions.append(4)                     # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions

