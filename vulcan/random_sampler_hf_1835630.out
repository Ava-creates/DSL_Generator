    # Cells with any non‑zero kind are treated as blocked.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, occ_grid):
        w, h, _ = occ_grid.shape
        occupied = np.any(occ_grid > 0, axis=2)          # bool mask of blocked cells
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
