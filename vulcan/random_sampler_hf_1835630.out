    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }
        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H
        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])
        from collections import deque
        q = deque()
        sx, sy = state.pos
        sd = state.dir
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}
        while q:
            x, y, d, path = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))
        return None

    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    actions = []

    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            if move_seq is None:
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        if move_seq is None:
            return actions
        actions.extend(move_seq)
        actions.append(4)
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions

