    # code...


    # Reset the environment and fetch initial objects
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # --------------------------------------------------------------
    # Action indices (as defined in CraftLab)
    # --------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # --------------------------------------------------------------
    # Helper: Manhattan path (list of actions) from src to dst
    # --------------------------------------------------------------
    def _path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # --------------------------------------------------------------
    # Helper: nearest cell (Manhattan) containing a given kind
    # --------------------------------------------------------------
    def _nearest(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # --------------------------------------------------------------
    # Helper: any cell containing a given kind (used for workshops)
    # --------------------------------------------------------------
    def _any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # --------------------------------------------------------------
    # Identify the index for the goal item ("arrow")
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # not defined → nothing to do
        return []

    # --------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # --------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # --------------------------------------------------------------
    # Collect each required primitive (respecting counts)
    # --------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = _nearest(state.grid, prim_idx, state.pos)
            if target is None:               # primitive missing → abort
                return action_seq
            # Move to the primitive cell
            for a in _path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # --------------------------------------------------------------
    # If the recipe specifies a workshop, go there before crafting
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq

    # --------------------------------------------------------------
    # Final craft action (USE) at current location (workshop or open ground)
    # --------------------------------------------------------------
    reward, done, obs = env.step(USE)
    action_seq.append(USE)

    return action_seq

