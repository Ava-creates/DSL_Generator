    import numpy as np, collections

    # action constants (matching CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # helper BFS to approach a target kind with correct orientation
    def _plan_path_to_kind(start_pos, kind_idx, grid, occ):
        """Return a list of actions that moves agent from start_pos to a cell
        adjacent to any cell containing `kind_idx` and faces that cell.
        If no reachable target, returns empty list."""
        w, h = occ.shape
        # locate all target cells of this kind
        target_cells = [tuple(p) for p in np.argwhere(grid[:, :, kind_idx] > 0)]
        if not target_cells:
            return []

        # map of approach cell -> required incoming action
        approach = {}
        for tx, ty in target_cells:
            # left side (agent must be at (tx-1,ty) and move RIGHT)
            ax, ay = tx - 1, ty
            if 0 <= ax < w and 0 <= ay < h and not occ[ax, ay]:
                approach[(ax, ay)] = RIGHT
            # right side (agent at (tx+1,ty) moving LEFT)
            ax, ay = tx + 1, ty
            if 0 <= ax < w and 0 <= ay < h and not occ[ax, ay]:
                approach[(ax, ay)] = LEFT
            # above (agent at (tx,ty-1) moving DOWN)
            ax, ay = tx, ty - 1
            if 0 <= ax < w and 0 <= ay < h and not occ[ax, ay]:
                approach[(ax, ay)] = DOWN
            # below (agent at (tx,ty+1) moving UP)
            ax, ay = tx, ty + 1
            if 0 <= ax < w and 0 <= ay < h and not occ[ax, ay]:
                approach[(ax, ay)] = UP

        if not approach:
            return []

        # BFS
        q = collections.deque()
        q.append((start_pos[0], start_pos[1], [], None))  # x, y, path, last_action
        visited = {(start_pos[0], start_pos[1])}
        while q:
            x, y, path, last_act = q.popleft()
            # check if this cell is a valid approach with correct orientation
            if (x, y) in approach and approach[(x, y)] == last_act:
                return path
            # expand neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act], act))
        # unreachable
        return []

