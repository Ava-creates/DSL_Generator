    import numpy as np
    from collections import deque

    def _bfs_to_target(state, target_kind):
        """Return a list of movement actions (0‑3) that ends with the agent
        facing a cell containing `target_kind`. Empty list means already
        facing the target or unreachable."""
        grid = state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        start_x, start_y = state.pos
        start_dir = state.dir
        q = deque()
        q.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return []  # unreachable

    actions = []

    # ------------------------------------------------------------------
    # 1) Gather all primitive resources required for a single arrow.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    if not primitive_needs:
        primitive_needs = {goal_idx: 1}
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            # If BFS failed but we are already adjacent, still allow a USE.
            if not move_seq and not cur_state.next_to(prim_idx):
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        actions.extend(move_seq)
        actions.append(4)  # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – craft in place.
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions

