    # Reset the environment to obtain a fresh initial state.
    env.reset()
    # The current internal CraftState after reset.
    init_state = env._current_state

    # Goal index for the current task (e.g., "arrow").
    goal_idx = env.task.goal

    # Breadth‑first search over state space with a modest depth limit.
    from collections import deque

    max_depth = 50                     # safety bound on plan length
    n_actions = env.world.n_actions    # number of possible actions

    # Helper to create a hashable representation of a state.
    def _state_key(st):
        return (
            st.grid.tobytes(),
            st.pos,
            st.dir,
            st.inventory.tobytes()
        )

    start_key = _state_key(init_state)
    visited = {start_key}
    queue = deque()
    queue.append((init_state, []))

    while queue:
        cur_state, cur_actions = queue.popleft()

        # Goal reached?
        if cur_state.satisfies("", goal_idx):
            return cur_actions

        # Depth limit.
        if len(cur_actions) >= max_depth:
            continue

        # Expand all possible actions.
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            key = _state_key(next_state)
            if key in visited:
                continue
            visited.add(key)
            queue.append((next_state, cur_actions + [a]))

    # If no plan found within the depth limit, return an empty list.
    return []


    import numpy as np

    actions = []
    # Get the goal index for the current task
    goal = env.task.goal

    # Determine which primitive resources are required for this goal
    needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}

    # Current state information
    state = env._current_state
    pos = tuple(state.pos)  # (x, y)

    # Helper to translate a delta into action indices using the env's spec
    spec = env.action_specs()
    DOWN = spec['DOWN']
    UP = spec['UP']
    LEFT = spec['LEFT']
    RIGHT = spec['RIGHT']
    USE = spec['USE']

    def _move_actions(cur, tgt):
        """Return a list of movement actions to go from cur to tgt."""
        moves = []
        dx = tgt[0] - cur[0]
        dy = tgt[1] - cur[1]
        while dx != 0:
            if dx > 0:
                moves.append(DOWN)
                dx -= 1
            else:
                moves.append(UP)
                dx += 1
        while dy != 0:
            if dy > 0:
                moves.append(RIGHT)
                dy -= 1
            else:
                moves.append(LEFT)
                dy += 1
        return moves

    # Collect each required primitive
    for prim_idx, cnt in needed.items():
        # Find all cells that currently contain this primitive
        locations = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
        for _ in range(cnt):
            if not locations:
                break  # safety – no more of this primitive on the map
            target = locations.pop(0)

            # Move next to the primitive (simple Manhattan walk)
            actions.extend(_move_actions(pos, target))
            pos = target

            # Pick it up
            actions.append(USE)

    # After having the ingredients, go to the appropriate workshop and craft
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target = ws_locs[0]
            actions.extend(_move_actions(pos, target))
            actions.append(USE)

    return actions

