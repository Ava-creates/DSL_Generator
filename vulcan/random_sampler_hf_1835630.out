    grid = state.grid.copy()              # occupancy tensor
    actions = []

    # --------------------------------------------------------------------- #
    # Helper: BFS path finder that returns a list of movement actions.
    # --------------------------------------------------------------------- #
    def bfs(start, target):
        """Return list of movement actions from start to target, or None."""
        width, height = grid.shape[:2]

        # Cells that cannot be entered: any non‑grabbable entity present
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Allow stepping on the target cell even if it is otherwise blocked
        blocked[target[0], target[1]] = False

        # BFS structures
        q = collections.deque([start])
        came_from = {start: None}
        action_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_to[nxt] = a
                        q.append(nxt)

        if target not in came_from:
            return None

        # Reconstruct actions
        path = []
        cur = target
        while cur != start:
            path.append(action_to[cur])
            cur = came_from[cur]
        path.reverse()
        return path

    # --------------------------------------------------------------------- #
    # Collect each required primitive (may need multiple copies)
    # --------------------------------------------------------------------- #
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Locate all remaining instances of this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more instances; give up on this primitive
                break

            # Choose the nearest by Manhattan distance
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            # Plan a path to the target cell
            path = bfs(pos, target)
            if path is None:
                # Fallback: simple Manhattan moves (ignores obstacles)
                dx, dy = target[0] - pos[0], target[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1

            actions.extend(path)
            actions.append(USE)               # pick up the primitive

            # Update simulated position and grid
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0

    # --------------------------------------------------------------------- #
    # Move to the workshop (if any) and craft the final item
    # --------------------------------------------------------------------- #
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target_ws = min(
                ws_locs,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = bfs(pos, target_ws)
            if path is None:
                dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1
            actions.extend(path)
            actions.append(USE)               # craft at the workshop

    return actions


    # Get action indices
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )

    # Goal index and primitive requirements
    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    # Current state snapshot
    state = env._current_state
    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()              # keep a local copy we can modify
    actions = []                           # list of action ids to return

    # --------------------------------------------------------------------- #
    # Helper: breadth‑first search on the current grid layout.
    # Returns a list of actions that moves from start → target.
    # --------------------------------------------------------------------- #
    import collections

    def bfs(start, target):
        """Return a list of actions moving from start to target, avoiding
        non‑grabbable entities.  The target cell may be occupied (e.g. a
        workshop) – it is allowed to step onto it."""
        width, height = grid.shape[:2]

        # Build blocked map: any cell that contains a non‑grabbable entity.
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Target cell is allowed even if blocked (used for workshops).
        blocked[target[0], target[1]] = False

        # BFS structures
        q = collections.deque([start])
        parent = {start: None}
        action_to = {}

        # Directions paired with actions
        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        action_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        # Reconstruct actions backwards
        path = []
        cur = target
        while cur != start:
            path.append(action_to[cur])
            cur = parent[cur]
        path.reverse()
        return path

    # --------------------------------------------------------------------- #
    # Collect all required primitive items.
    # --------------------------------------------------------------------- #
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Find all cells containing this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # Primitive not present – assume it is already in inventory or
                # unreachable; break out to avoid infinite loop.
                break

            # Choose the nearest primitive (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            # Compute a path to the target
            path = bfs(pos, target)
            if path is None:
                # Fallback: direct Manhattan moves (may fail on obstacles)
                dx, dy = target[0] - pos[0], target[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1

            # Append movement actions and the USE action to pick up the primitive
            actions.extend(path)
            actions.append(USE)

            # Update our local state: move the agent and remove the item
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0

    # --------------------------------------------------------------------- #
    # Move to the appropriate workshop (if any) and craft the goal item.
    # --------------------------------------------------------------------- #
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        workshop_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if workshop_locs:
            # Choose nearest workshop
            target_ws = min(
                workshop_locs,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = bfs(pos, target_ws)
            if path is None:
                # Simple Manhattan fallback
                dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1

            actions.extend(path)
            actions.append(USE)  # craft at the workshop

    return actions

