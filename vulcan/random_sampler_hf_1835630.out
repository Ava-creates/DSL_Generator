    if arrow_idx is None:
        return actions

    # Primitive requirements for the goal
    needed = world.cookbook.primitives_for(arrow_idx)  # {primitive_idx: count}
    pos = list(state.pos)  # mutable copy of current position (x, y)

    # Helper to move from current position to a target cell using Manhattan moves
    def move_to(target):
        nonlocal pos, actions
        tx, ty = target

        # Move in x direction (LEFT/RIGHT)
        while pos[0] < tx:
            actions.append(3)          # RIGHT
            pos[0] += 1
        while pos[0] > tx:
            actions.append(2)          # LEFT
            pos[0] -= 1

        # Move in y direction (DOWN/UP) – assuming y increases downwards
        while pos[1] < ty:
            actions.append(0)          # DOWN
            pos[1] += 1
        while pos[1] > ty:
            actions.append(1)          # UP
            pos[1] -= 1

    # ----------------------------------------------------------------------
    # 1. Collect all required primitive resources
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        # Find all cells that contain this primitive
        primitive_cells = np.argwhere(grid[:, :, prim_idx] == 1)
        primitive_cells = [tuple(cell) for cell in primitive_cells]

        # Greedy nearest‑first collection
        while count > 0 and primitive_cells:
            # Choose the nearest primitive cell
            distances = [abs(pos[0] - x) + abs(pos[1] - y) for (x, y) in primitive_cells]
            nearest_idx = int(np.argmin(distances))
            target = primitive_cells.pop(nearest_idx)

            # Move to the primitive and pick it up
            move_to(target)
            actions.append(4)          # USE (collect)
            count -= 1

    # ----------------------------------------------------------------------
    # 2. Go to the appropriate workshop and craft the arrow
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.get(workshop_name)
        if workshop_idx is not None:
            workshop_cells = np.argwhere(grid[:, :, workshop_idx] == 1)
            if workshop_cells.size:
                wk_target = tuple(workshop_cells[0])
                move_to(wk_target)
                actions.append(4)      # USE (craft)

    return actions

