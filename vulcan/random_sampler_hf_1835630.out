    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action mapping
    # ----------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _in_bounds(pos, shape):
        x, y = pos
        w, h = shape
        return 0 <= x < w and 0 <= y < h

    def _neighbors(pos, shape):
        x, y = pos
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if _in_bounds((nx, ny), shape):
                yield (nx, ny)

    def _bfs(start, goal_set, blocked):
        """
        Bread‑first search from ``start`` to any cell in ``goal_set``.
        ``blocked`` is a 2‑D bool array where True means the cell cannot be entered.
        Returns a list of positions (including start) representing the path,
        or ``None`` if no path exists.
        """
        w, h = blocked.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = dict()
        dq = deque([start])
        visited[start] = True
        while dq:
            cur = dq.popleft()
            if cur in goal_set:
                # reconstruct path
                path = [cur]
                while path[-1] != start:
                    path.append(prev[path[-1]])
                path.reverse()
                return path
            for nb in _neighbors(cur, (w, h)):
                if not visited[nb] and not blocked[nb]:
                    visited[nb] = True
                    prev[nb] = cur
                    dq.append(nb)
        return None

    def _pos_to_actions(path):
        """
        Convert a list of positions (including the starting cell) into a list
        of movement actions.
        """
        act_list = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 > x0:
                act_list.append(RIGHT)
            elif x1 < x0:
                act_list.append(LEFT)
            elif y1 > y0:
                act_list.append(DOWN)
            elif y1 < y0:
                act_list.append(UP)
        return act_list

    # ----------------------------------------------------------------------
    # Main logic
    # ----------------------------------------------------------------------
    world = env.world
    state = env._current_state
    grid = state.grid
    shape = grid.shape[:2]                     # (WIDTH, HEIGHT)

    # --------------------------------------------------------------
    # Determine goal index for "arrow"
    # --------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        try:
            goal_idx = world.cookbook.index["arrow"]
        except Exception as e:
            raise RuntimeError("Could not locate goal index for 'arrow'") from e

    # --------------------------------------------------------------
    # Primitive requirements for the goal (expanded)
    # --------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    # --------------------------------------------------------------
    # Build blocked map (cells that cannot be stepped on)
    # --------------------------------------------------------------
    blocked = np.zeros(shape, dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    actions = []
    cur_pos = tuple(state.pos)

    # --------------------------------------------------------------
    # Helper: move to a target cell (any reachable cell)
    # --------------------------------------------------------------
    def _move_to(target):
        nonlocal cur_pos, actions, blocked
        path = _bfs(cur_pos, {target}, blocked)
        if path is None:
            # If unreachable, give up silently
            return cur_pos
        actions.extend(_pos_to_actions(path))
        cur_pos = target
        return cur_pos

    # --------------------------------------------------------------
    # Collect required primitives
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        # Find any cell containing this primitive
        locs = np.argwhere(grid[:, :, prim_idx] > 0)
        if locs.size == 0:
            # Primitive absent – cannot collect; skip
            continue
        prim_pos = tuple(locs[0])
        # Move onto the primitive cell (primitives are traversable)
        _move_to(prim_pos)
        # Pick up the required amount
        actions.extend([USE] * needed)
        # After picking up, the cell becomes empty – update blocked map
        blocked[prim_pos] = False

    # --------------------------------------------------------------
    # Move to workshop (if any) and craft the arrow
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_key") or recipe.get("_at")
    if workshop_name is not None:
        # Resolve workshop index
        if isinstance(workshop_name, int):
            workshop_idx = workshop_name
        else:
            workshop_idx = world.cookbook.index.get(workshop_name)
        if workshop_idx is not None:
            ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
            if ws_locs.size > 0:
                ws_pos = tuple(ws_locs[0])
                # Find a free adjacent cell to the workshop
                adj_candidates = [
                    nb for nb in _neighbors(ws_pos, shape) if not blocked[nb]
                ]
                if adj_candidates:
                    # Choose the closest candidate
                    adj_candidates.sort(
                        key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
                    )
                    target_adj = adj_candidates[0]
                    _move_to(target_adj)
    # Finally, use the workshop (or current cell) to craft the arrow
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action mapping
    # ----------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ----------------------------------------------------------------------
    # World / state shortcuts
    # ----------------------------------------------------------------------
    world = env.world
    state = env._current_state
    grid = state.grid
    shape = grid.shape[:2]  # (WIDTH, HEIGHT)

    # ----------------------------------------------------------------------
    # Determine goal index for "arrow"
    # ----------------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        goal_idx = world.cookbook.index.get("arrow")
    if goal_idx is None:
        raise RuntimeError("Could not locate goal index for 'arrow'")

    # ----------------------------------------------------------------------
    # Primitive requirements (expanded)
    # ----------------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _blocked_cells(g):
        """Boolean 2‑D array: True where any entity occupies the cell."""
        return np.any(g > 0, axis=2)

    blocked = _blocked_cells(grid)

    def _in_bounds(pos):
        x, y = pos
        w, h = shape
        return 0 <= x < w and 0 <= y < h

    def _neighbors(pos):
        x, y = pos
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if _in_bounds((nx, ny)):
                yield (nx, ny)

    def _bfs(start, goals):
        """Breadth‑first search from start to any cell in goals."""
        visited = np.full(shape, False, dtype=bool)
        prev = {}
        dq = deque([start])
        visited[start] = True
        while dq:
            cur = dq.popleft()
            if cur in goals:
                # reconstruct path
                path = [cur]
                while path[-1] != start:
                    path.append(prev[path[-1]])
                path.reverse()
                return path
            for nb in _neighbors(cur):
                if not visited[nb] and not blocked[nb]:
                    visited[nb] = True
                    prev[nb] = cur
                    dq.append(nb)
        return None

    def _path_to_actions(path):
        """Convert a list of positions into movement actions."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 > x0:
                acts.append(RIGHT)
            elif x1 < x0:
                acts.append(LEFT)
            elif y1 > y0:
                acts.append(DOWN)
            elif y1 < y0:
                acts.append(UP)
        return acts

    # ----------------------------------------------------------------------
    # Main plan construction
    # ----------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)

    # --------------------------------------------------------------
    # Collect each required primitive.
    # --------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_requirements.items():
        # Find any cell that currently holds this primitive.
        locs = np.argwhere(grid[:, :, prim_idx] > 0)
        if locs.size == 0:
            # Primitive not present – skip.
            continue
        prim_pos = tuple(locs[0])

        # Choose a free cell adjacent (or the cell itself if free) to stand on.
        candidate_cells = []
        if not blocked[prim_pos]:
            candidate_cells.append(prim_pos)
        for nb in _neighbors(prim_pos):
            if not blocked[nb]:
                candidate_cells.append(nb)

        if not candidate_cells:
            # No reachable adjacent cell – give up on this primitive.
            continue

        # Pick the candidate with minimal Manhattan distance from current pos.
        candidate_cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
        dest = candidate_cells[0]

        # Find path to the chosen destination.
        path = _bfs(cur_pos, {dest})
        if path is None:
            continue
        actions.extend(_path_to_actions(path))
        cur_pos = dest

        # Perform USE actions to pick up the required amount.
        actions.extend([USE] * needed_cnt)

        # Update blocked map: after picking up the primitive the cell becomes empty.
        blocked[prim_pos] = False

    # --------------------------------------------------------------
    # Move to the appropriate workshop and craft the arrow.
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_key") or recipe.get("_at")
    workshop_idx = None
    if workshop_key is not None:
        if isinstance(workshop_key, int):
            workshop_idx = workshop_key
        else:
            workshop_idx = world.cookbook.index.get(workshop_key)

    if workshop_idx is not None:
        ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_locs.size > 0:
            ws_pos = tuple(ws_locs[0])

            # Choose a free adjacent cell (or the cell itself if free).
            ws_candidates = []
            if not blocked[ws_pos]:
                ws_candidates.append(ws_pos)
            for nb in _neighbors(ws_pos):
                if not blocked[nb]:
                    ws_candidates.append(nb)

            if ws_candidates:
                ws_candidates.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
                ws_dest = ws_candidates[0]
                ws_path = _bfs(cur_pos, {ws_dest})
                if ws_path is not None:
                    actions.extend(_path_to_actions(ws_path))
                    cur_pos = ws_dest

    # Final USE to craft the arrow.
    actions.append(USE)

    return actions

