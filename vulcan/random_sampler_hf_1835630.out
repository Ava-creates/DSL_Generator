    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = np.copy(state.grid)           # mutable copy of the grid

    # Action indices (consistent with CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk
        from ``start`` to ``goal`` using a simple Manhattan route."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell that currently contains ``kind_idx``.
        Returns a tuple (y, x) or ``None`` if no such cell exists."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a free (non‑non‑grabbable) adjacent coordinate to ``cell``.
        Preference order: up, down, left, right. If none are free, return the
        original cell."""
        y, x = cell
        candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]
        for ny, nx in candidates:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        return cell

    # ------------------------------------------------------------------
    # Determine primitives needed for an arrow
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Choose a free adjacent cell to stand on before using.
            stand_pos = free_adjacent(target)

            # Move to the chosen standing position.
            actions += manhattan_path(cur_pos, stand_pos)
            cur_pos = stand_pos

            # Adjust direction to face the primitive (if not standing on it).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update the mutable grid to reflect that the primitive has been taken.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions


    env.reset()
    state = env._current_state
    world = env.world
    grid = np.copy(state.grid)

    # Action indices as defined in CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Mapping from movement delta to action index
    delta_to_action = {(1, 0): DOWN, (-1, 0): UP, (0, -1): LEFT, (0, 1): RIGHT}

    from collections import deque

    def is_walkable(pos):
        """A cell is walkable if it is inside the grid and does not contain any
        non‑grabbable entity (obstacle)."""
        y, x = pos
        if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):
            return False
        return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs(start, goal):
        """Breadth‑first search returning a list of positions from start to goal
        (inclusive). Returns None if no path exists."""
        if start == goal:
            return [start]
        visited = {start}
        prev = {}
        q = deque([start])
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                nxt = (ny, nx)
                if not (0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]):
                    continue
                if not is_walkable(nxt):
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                prev[nxt] = cur
                q.append(nxt)
        else:
            return None  # no path

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(prev[path[-1]])
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions to the corresponding movement actions."""
        acts = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            dy, dx = y1 - y0, x1 - x0
            acts.append(delta_to_action[(dy, dx)])
        return acts

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell that currently contains the given kind."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a walkable cell adjacent to ``cell`` (preferring up, down,
        left, right). If none are walkable, return None."""
        y, x = cell
        for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            ny, nx = y + dy, x + dx
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if is_walkable((ny, nx)):
                    return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine which primitives are required to craft an ``arrow``.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            stand = free_adjacent(target)
            if stand is None:
                # No free neighbour; stand on the primitive cell itself.
                stand = target

            path = bfs(cur_pos, stand)
            if path is None:
                return actions
            actions += path_to_actions(path)
            cur_pos = stand

            # Face the primitive (best‑effort direction).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if (dy, dx) in delta_to_action:
                actions.append(delta_to_action[(dy, dx)])
                # Simulate the step into the primitive cell (optional).
                cur_pos = (cur_pos[0] + dy, cur_pos[1] + dx)

            # Pick up the primitive.
            actions.append(USE)

            # Update our mutable copy of the grid.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            path = bfs(cur_pos, ws_cell)
            if path is not None:
                actions += path_to_actions(path)
                cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions

