    from collections import namedtuple
    import heapq
    import numpy as np

    Node = namedtuple("Node", ["state", "actions", "cost"])

    # Helper: hash a state for visited checking
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # Pre‑compute primitive requirements for the goal
    primitives_needed = world.cookbook.primitives_for(target_idx)  # {kind_idx: count}
    # If the goal has no recipe (i.e., is primitive) we still treat it as a craft
    # that may be obtained by simply picking it up.
    if not primitives_needed:
        primitives_needed = {target_idx: 1}

    # Heuristic: sum of Manhattan distances to the nearest needed primitive that we
    # still lack (ignoring obstacles). If a needed primitive is not present on the
    # grid we give a large penalty.
    def heuristic(st):
        pos = np.array(st.pos)
        missing = 0
        total_dist = 0
        for kind, cnt in primitives_needed.items():
            have = st.inventory[kind]
            need = max(0, cnt - have)
            if need == 0:
                continue
            # locate all cells containing this kind
            locations = np.argwhere(st.grid[:, :, kind] > 0)
            if locations.size == 0:
                # primitive not currently on the map – give a penalty
                total_dist += 10 * need
                missing += need
            else:
                # compute Manhattan distance to the closest instance
                dists = np.abs(locations - pos).sum(axis=1)
                total_dist += dists.min() * need
                missing += need
        # add a small cost for the eventual crafting action(s)
        return total_dist + missing
    # Priority queue for A* (cost = g + h)
    frontier = []
    start_node = Node(init_state, [], 0)
    heapq.heappush(frontier, (heuristic(init_state), start_node))

    visited = {_state_hash(init_state)}
    MAX_STEPS = 400
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        _, node = heapq.heappop(frontier)
        cur_state = node.state

        # Goal test
        if cur_state.satisfies("", target_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand successors
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h in visited:
                continue
            visited.add(h)
            g = len(node.actions) + 1
            f = g + heuristic(nxt_state)
            heapq.heappush(frontier, (f, Node(nxt_state, node.actions + [a], g)))

    # No plan found within budget
    return []

