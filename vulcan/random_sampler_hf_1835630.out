    import collections
    import numpy as np

    spec = env.action_specs()
    DOWN = spec["DOWN"]
    UP = spec["UP"]
    LEFT = spec["LEFT"]
    RIGHT = spec["RIGHT"]
    USE = spec["USE"]

    actions = []
    goal = env.task.goal
    cookbook = env.world.cookbook

    # current state snapshot (will be mutated locally)
    state = env._current_state
    pos = tuple(state.pos)
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    width, height = grid.shape[:2]

    non_grabbable = list(env.world.non_grabbable_indices)

    def _blocked_cells():
        """Return a boolean mask of cells that cannot be stepped on."""
        if non_grabbable:
            return np.any(grid[:, :, non_grabbable] > 0, axis=2)
        return np.zeros((width, height), dtype=bool)

    def bfs(start, target):
        """Bread‑first search avoiding non‑grabbable cells."""
        blocked = _blocked_cells()
        # we are allowed to step onto the target even if it would otherwise be blocked
        blocked[target[0], target[1]] = False

        q = collections.deque([start])
        parent = {start: None}
        action_to = {}

        moves = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in moves:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        action_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        # reconstruct path
        seq = []
        cur = target
        while cur != start:
            seq.append(action_to[cur])
            cur = parent[cur]
        seq.reverse()
        return seq

    def manhattan_path(start, target):
        """Fallback path that ignores obstacles."""
        seq = []
        x, y = start
        tx, ty = target
        while x < tx:
            seq.append(DOWN)
            x += 1
        while x > tx:
            seq.append(UP)
            x -= 1
        while y < ty:
            seq.append(RIGHT)
            y += 1
        while y > ty:
            seq.append(LEFT)
            y -= 1
        return seq

    def move_to(tgt):
        """Move the agent to `tgt`, updating `pos` and `actions`."""
        nonlocal pos
        if pos == tgt:
            return
        path = bfs(pos, tgt)
        if path is None:
            path = manhattan_path(pos, tgt)
        actions.extend(path)
        pos = tgt

    # -----------------------------------------------------------------
    # Determine primitive requirements for the goal.
    # -----------------------------------------------------------------
    required = cookbook.primitives_for(goal).copy()
    # If the goal itself is a primitive (no recipe), we need one of it.
    if not required and goal in cookbook.primitives:
        required = {goal: 1}

    # -----------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # -----------------------------------------------------------------
    for prim_idx, need_cnt in required.items():
        have = int(inventory[prim_idx])
        to_collect = max(0, need_cnt - have)

        for _ in range(to_collect):
            # locate remaining instances of this primitive on the map
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more instances left; break early.
                break

            # choose the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            move_to(target)
            actions.append(USE)  # pick up the primitive

            # update simulated world state
            grid[target[0], target[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # -----------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the goal.
    # -----------------------------------------------------------------
    recipe = cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(state.grid[:, :, ws_idx] > 0)))
        if ws_locations:
            target_ws = min(
                ws_locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            move_to(target_ws)
            actions.append(USE)  # craft at the workshop
    else:
        # No specific workshop required; just use the craft action here.
        actions.append(USE)

    return actions


    spec = env.action_specs()
    DOWN = spec["DOWN"]
    UP = spec["UP"]
    LEFT = spec["LEFT"]
    RIGHT = spec["RIGHT"]
    USE = spec["USE"]

    state = env._current_state
    pos = tuple(state.pos)
    goal = env.task.goal
    cookbook = env.world.cookbook

    # Determine required primitives (handle primitive goal)
    required = cookbook.primitives_for(goal).copy()
    if not required and goal in getattr(cookbook, "primitives", set()):
        required = {goal: 1}

    # Simulated mutable copies of grid and inventory
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    width, height = grid.shape[:2]

    # Pre‑compute blocked cells (non‑grabbable entities)
    non_grab = list(env.world.non_grabbable_indices)
    if non_grab:
        base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
    else:
        base_blocked = np.zeros((width, height), dtype=bool)

    # -----------------------------------------------------------------
    # BFS pathfinder that avoids blocked cells; optionally allow stepping
    # onto the target even if it would normally be blocked.
    # -----------------------------------------------------------------
    def bfs(start, target, allow_target=False):
        blocked = base_blocked.copy()
        if allow_target:
            blocked[target[0], target[1]] = False
        q = collections.deque([start])
        parent = {start: None}
        act_to = {}
        moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (RIGHT, (0, 1)), (LEFT, (0, -1))]
        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in moves:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = a
                        q.append(nxt)
        if target not in parent:
            return None
        path = []
        cur = target
        while cur != start:
            path.append(act_to[cur])
            cur = parent[cur]
        path.reverse()
        return path

    # Simple Manhattan fallback (ignores obstacles)
    def manhattan(start, target):
        seq = []
        dx = target[0] - start[0]
        dy = target[1] - start[1]
        if dx > 0:
            seq += [DOWN] * dx
        elif dx < 0:
            seq += [UP] * (-dx)
        if dy > 0:
            seq += [RIGHT] * dy
        elif dy < 0:
            seq += [LEFT] * (-dy)
        return seq

    actions = []

    # -----------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # -----------------------------------------------------------------
    for prim_idx, need_cnt in required.items():
        have = int(inventory[prim_idx])
        to_collect = max(0, need_cnt - have)
        for _ in range(to_collect):
            # Find remaining instances of this primitive on the map
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                break  # none left
            # Choose the nearest instance (Manhattan distance)
            target = min(locations, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            path = bfs(pos, target, allow_target=True)
            if path is None:
                path = manhattan(pos, target)
            actions.extend(path)
            actions.append(USE)  # pick up the primitive
            # Update simulated world state
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # -----------------------------------------------------------------
    # Move to workshop (if any) and craft the goal item.
    # -----------------------------------------------------------------
    recipe = cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(state.grid[:, :, ws_idx] > 0)))
        if ws_locations:
            target_ws = min(ws_locations, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            path = bfs(pos, target_ws, allow_target=True)
            if path is None:
                path = manhattan(pos, target_ws)
            actions.extend(path)
            actions.append(USE)  # craft at workshop
    else:
        # No specific workshop required; just use the craft action here.
        actions.append(USE)

    return actions

