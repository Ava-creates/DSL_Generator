                break

            # Choose the nearest location (Manhattan distance).
            prim_locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_loc = prim_locations[0]

            # Plan a path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target_loc], occupied)
            actions.extend(path)

            # Simulate movement to update current position.
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive (USE action while facing it).
            actions.append(USE)
