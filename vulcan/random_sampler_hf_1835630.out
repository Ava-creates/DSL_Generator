            actions.extend(path)
            pos = _apply_path(pos, path)
        actions.append(USE)
    else:
        # no specific workshop, just use
        actions.append(USE)

    return actions


    import collections, numpy as np

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_path(start, targets, grid):
        """Return a list of actions moving from start to a cell adjacent to any target."""
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # any non‑zero kind blocks movement
        q = collections.deque([(start[0], start[1], [])])
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # stop if adjacent (Manhattan distance ≤ 1) to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # explore neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # unreachable – return empty list
        return []

    def _apply_path(pos, path):
        """Update a (x, y) position by applying a sequence of actions."""
        x, y = pos
        for act in path:
            if act == RIGHT:
                x += 1
            elif act == LEFT:
                x -= 1
            elif act == DOWN:
                y += 1
            elif act == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate the world and cookbook objects (they may be stored in different
    # attributes depending on the wrapper used around the environment).
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers keep the world inside the current state.
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal is hard‑coded to the item named "arrow".
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Working copies of position and grid for planning.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)          # (x, y)
    cur_grid = state.grid.copy()    # (W, H, n_kinds)

    actions = []
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells that currently contain this primitive.
        locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Greedy order: nearest first.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive (or stay if already adjacent).
            path = _bfs_path(pos, [loc], cur_grid)
            actions.extend(path)
            pos = _apply_path(pos, path)

            # Pick up the primitive.
            actions.append(USE)

            # Mark the cell empty for future planning.
            cur_grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index – may be a string name.
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str) else int(workshop_key))
        # Locate workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            path = _bfs_path(pos, [target_ws], cur_grid)
            actions.extend(path)
            pos = _apply_path(pos, path)

    # Use (craft) at the final position.
    actions.append(USE)

    return actions

