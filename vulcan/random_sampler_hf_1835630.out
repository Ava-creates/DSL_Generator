    # Retrieve scenario and world objects (handles both raw env and wrapped envs)
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the desired output item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
