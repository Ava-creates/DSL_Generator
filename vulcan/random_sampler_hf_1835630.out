    # reset environment and get initial state
    env.reset()
    state = env._current_state
    world = env.world

    # action constants (as defined in CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # helpers -------------------------------------------------------------
    def _bfs_path(grid, start, goal):
        """Return list of actions to move from start to goal avoiding blocked cells.
        Goal cell may be non‑empty (e.g., contains the target item)."""
        h, w, _ = grid.shape
        from collections import deque
        visited = set()
        queue = deque()
        queue.append((start, []))
        visited.add(start)
        # movement vectors
        moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]
        while queue:
            (r, c), path = queue.popleft()
            if (r, c) == goal:
                return path
            for act, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:
                    # allow stepping on the goal even if it is occupied
                    if (nr, nc) == goal or np.all(grid[nr, nc, :] == 0):
                        visited.add((nr, nc))
                        queue.append(((nr, nc), path + [act]))
        # no path found
        return None

    def _nearest_of_kind(grid, kind_idx, start):
        """BFS search for the closest cell containing kind_idx."""
        h, w, _ = grid.shape
        from collections import deque
        visited = set()
        queue = deque()
        queue.append((start, []))
        visited.add(start)
        moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]
        while queue:
            (r, c), path = queue.popleft()
            if grid[r, c, kind_idx] > 0:
                return (r, c), path
            for act, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:
                    # can walk through empty cells only
                    if np.all(grid[nr, nc, :] == 0):
                        visited.add((nr, nc))
                        queue.append(((nr, nc), path + [act]))
        return None, None

    # --------------------------------------------------------------------
    # Identify goal index (arrow)
    # --------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        # arrow not defined in this world
        return []

    # --------------------------------------------------------------------
    # Primitive requirements for a single arrow (expanded)
    # --------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # --------------------------------------------------------------------
    # Collect each required primitive (respecting required count)
    # --------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            target, path_to_target = _nearest_of_kind(state.grid, prim_idx, state.pos)
            if target is None:
                # cannot find required primitive – abort
                return action_seq
            # follow the path
            for a in path_to_target:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # pick up the primitive (USE)
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # --------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the arrow
    # --------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        # locate nearest workshop
        workshop_pos, path_to_ws = _nearest_of_kind(state.grid, workshop_idx, state.pos)
        if workshop_pos is not None:
            for a in path_to_ws:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # craft at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    # --------------------------------------------------------------------
    # Return the complete action list
    # --------------------------------------------------------------------
    return action_seq


    import collections

    # Action indices (assumed standard mapping)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # helpers
    # ------------------------------------------------------------------
    def _is_blocked(grid, pos):
        i, j = pos
        for idx in env.world.non_grabbable_indices:
            if grid[i, j, idx] > 0:
                return True
        return False

    def _neighbors(pos):
        i, j = pos
        h, w, _ = env._current_state.grid.shape
        for action, (di, dj) in ((UP, (-1, 0)), (DOWN, (1, 0)),
                                 (LEFT, (0, -1)), (RIGHT, (0, 1))):
            ni, nj = i + di, j + dj
            if 0 <= ni < h and 0 <= nj < w:
                yield (ni, nj), action

    def _bfs_to_kind(grid, kind_idx, start):
        """Return list of actions to reach a cell containing kind_idx."""
        if grid[start[0], start[1], kind_idx] > 0:
            return []
        visited = set()
        q = collections.deque()
        q.append((start, []))
        visited.add(start)
        while q:
            pos, acts = q.popleft()
            for (npos, act) in _neighbors(pos):
                if npos in visited:
                    continue
                if _is_blocked(grid, npos):
                    continue
                if grid[npos[0], npos[1], kind_idx] > 0:
                    return acts + [act]
                visited.add(npos)
                q.append((npos, acts + [act]))
        return None

    # ------------------------------------------------------------------
    # initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # ------------------------------------------------------------------
    # locate goal (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # primitives needed for one arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    actions = []

    # ------------------------------------------------------------------
    # collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            path = _bfs_to_kind(state.grid, prim_idx, state.pos)
            if path is None:
                return actions
            for a in path:
                _, _, _ = env.step(a)
                state = env._current_state
                actions.append(a)
            # pick up the primitive
            _, _, _ = env.step(USE)
            state = env._current_state
            actions.append(USE)

    # ------------------------------------------------------------------
    # craft at the appropriate workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        path = _bfs_to_kind(state.grid, workshop_idx, state.pos)
        if path is not None:
            for a in path:
                _, _, _ = env.step(a)
                state = env._current_state
                actions.append(a)
            # craft the arrow
            _, _, _ = env.step(USE)
            state = env._current_state
            actions.append(USE)

    return actions

