    # Reset the environment and obtain useful references
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Action constants from the environment
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # Mapping from movement vector to action id
    DIRS = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    from collections import deque
    import numpy as np

    def bfs_path(start, goal):
        """Return a list of movement actions from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return []

        W, H = grid.shape[0], grid.shape[1]
        blocked_kinds = list(world.non_grabbable_indices)

        visited = np.full((W, H), False, dtype=bool)
        prev = {}  # (y,x) -> (prev_y, prev_x, action)

        q = deque()
        q.append(start)
        visited[start] = True

        while q:
            y, x = q.popleft()
            for (dy, dx), act in DIRS.items():
                ny, nx = y + dy, x + dx
                if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:
                    # cell is blocked if any non‑grabbable entity occupies it
                    if blocked_kinds and np.any(grid[ny, nx, blocked_kinds] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x, act)
                    if (ny, nx) == goal:
                        # reconstruct path
                        actions = []
                        cur = (ny, nx)
                        while cur != start:
                            py, px, a = prev[cur]
                            actions.append(a)
                            cur = (py, px)
                        actions.reverse()
                        return actions
                    q.append((ny, nx))
        # No path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell that currently contains an entity of kind_idx."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return (int(nearest[0]), int(nearest[1]))

    # --------------------------------------------------------------
    # Determine the index of the target item and its primitive needs
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    primitive_reqs = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos  # (y, x)

    # --------------------------------------------------------------
    # Collect required primitives
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_reqs.items():
        for _ in range(needed):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # primitive not present; abort early
                return actions

            # Move to the primitive cell
            actions += bfs_path(cur_pos, target)
            cur_pos = target

            # Pick it up
            actions.append(USE)

            # Update planning grid so we don't try to collect the same instance again
            grid[target[0], target[1], prim_idx] = 0

    # --------------------------------------------------------------
    # Go to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting at current location (or at workshop)
    actions.append(USE)

    return actions


