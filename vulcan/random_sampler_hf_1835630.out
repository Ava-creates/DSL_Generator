        workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_locs:
            workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_locs[0]
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
    else:
        # No specific workshop; attempt crafting at current position
        actions.append(USE)

    return actions


