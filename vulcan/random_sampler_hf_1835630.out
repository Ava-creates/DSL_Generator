    # ----------------------------------------------------------------------
    # Generic planner for the "make arrow" task.
    # Returns a list of action indices that (approximately) collect the
    # required primitives and then attempts to craft the arrow.
    # ----------------------------------------------------------------------
    import numpy as np

    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment to get a fresh state.
    # The reset call returns an observation dict; the underlying state is
    # stored inside the env instance as ``_current_state``.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that
        moves the agent from ``start`` to ``goal`` using a simple
        Manhattan walk.  The function does NOT check for obstacles – it
        is a best‑effort path that works in most open maps."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x

        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)

        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)

        return actions

    def find_nearest(cell_kind, from_pos):
        """Find the nearest cell that contains ``cell_kind`` (primitive)
        using a simple linear scan.  Returns the cell coordinate (y, x)
        or ``None`` if not found."""
        locations = np.argwhere(grid[:, :, cell_kind] > 0)
        if locations.size == 0:
            return None
        # Manhattan distance to each candidate
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = np.argmin(dists)
        return tuple(locations[nearest_idx])

    # ------------------------------------------------------------------
    # Determine the index of the goal item ("arrow") and the primitives
    # required to craft it.
    # ------------------------------------------------------------------
    # ``world.cookbook.index`` maps names → integer IDs.
    arrow_idx = world.cookbook.index.index('arrow')
    # ``primitives_for`` returns a dict {primitive_idx: count}
    needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos  # (y, x)

    # Collect each required primitive the required number of times.
    for prim_idx, count in needed.items():
        for _ in range(count):
            target_cell = find_nearest(prim_idx, cur_pos)
            if target_cell is None:
                # Primitive not found – give up early.
                return actions

            # Choose an adjacent cell that is inside the map bounds.
            # Prefer the cell that is directly next to the primitive in the
            # direction we will approach from.
            ty, tx = target_cell
            # Try the four neighbours in a fixed order.
            neighbours = [
                (ty - 1, tx),  # above (face DOWN)
                (ty + 1, tx),  # below (face UP)
                (ty, tx - 1),  # left  (face RIGHT)
                (ty, tx + 1),  # right (face LEFT)
            ]
            adj = None
            for n in neighbours:
                ny, nx = n
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    # A cell is considered free if no non‑grabbable entity occupies it.
                    # ``world.non_grabbable_indices`` holds those kinds.
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # If no free neighbour, just move onto the primitive cell itself.
                adj = target_cell

            # Move to the adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # After arriving, ensure we are facing the primitive.
            # Determine required facing direction.
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)   # face down towards primitive
            elif dy == -1:
                actions.append(UP)     # face up
            elif dx == 1:
                actions.append(RIGHT)  # face right
            elif dx == -1:
                actions.append(LEFT)   # face left
            else:
                # Already on the same cell; just use without turning.
                pass

            # Use action to pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Finally, attempt to craft the arrow.
    # The recipe typically specifies a workshop via the special key "_at".
    # We look it up and move to the nearest workshop of that type (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        # Find nearest workshop cell.
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell
    # Use action to trigger crafting at the current location.
    actions.append(USE)

    return actions


    # ----------------------------------------------------------------------
    # Helper functions used inside the body
    # ----------------------------------------------------------------------
    def _bfs_path(grid, start, target):
        """Return a list of movement actions (0‑3) that brings the agent from
        ``start`` to a cell adjacent to ``target`` while avoiding blocked cells.
        The grid is a (W, H, K) array; a cell is blocked if any kind is present.
        """
        from collections import deque

        W, H, _ = grid.shape
        # Directions: 0‑DOWN, 1‑UP, 2‑LEFT, 3‑RIGHT
        moves = [(0, 1), (0, -1), (-1, 0), (1, 0)]

        # Check adjacency
        def adjacent(p, q):
            return abs(p[0] - q[0]) + abs(p[1] - q[1]) == 1

        # BFS over empty cells
        visited = np.full((W, H), False, dtype=bool)
        prev = dict()               # (x, y) -> (prev_pos, action)

        q = deque()
        q.append(start)
        visited[start] = True

        while q:
            cur = q.popleft()
            if adjacent(cur, target):
                # reconstruct path
                path = []
                while cur != start:
                    cur, act = prev[cur]
                    path.append(act)
                return list(reversed(path))

            for a, (dx, dy) in enumerate(moves):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H:
                    if not visited[nx, ny]:
                        # a cell is traversable iff it is completely empty
                        if not grid[nx, ny].any():
                            visited[nx, ny] = True
                            prev[(nx, ny)] = (cur, a)
                            q.append((nx, ny))
        # No path found – return empty list (caller will treat as failure)
        return []

    # ----------------------------------------------------------------------
    # Begin actual planning
    # ----------------------------------------------------------------------
    # reset the environment to a fresh state and obtain the initial observation
    env.reset()
    obs = env.observations()
    state = env._current_state           # internal CraftState (accessible here)

    world = state.world                  # CraftWorld instance
    goal_idx = env.task.goal             # integer index of the desired item

    # ------------------------------------------------------------------
    # Determine which primitives are required and the workshop where
    # the final crafting must happen.
    # ------------------------------------------------------------------
    # full recipe dict (ingredients + optional "_at")
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at", None)

    # map primitive indices to required counts
    primitives_needed = {
        k: v for k, v in recipe.items() if k != "_at"
    }

    # Resolve workshop index (if any)
    workshop_idx = None
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []          # final action sequence to be returned

    # ------------------------------------------------------------------
    # Helper to collect a single primitive until we have enough copies.
    # ------------------------------------------------------------------
    def _collect_primitive(kind, needed):
        nonlocal actions, state

        while state.inventory[kind] < needed:
            # locate any cell that currently contains the primitive
            locations = np.argwhere(state.grid[:, :, kind] > 0)
            if locations.size == 0:
                # nothing left on the map – break to avoid infinite loop
                break
            # pick the closest location (Manhattan distance) to current pos
            dists = np.abs(locations[:, 0] - state.pos[0]) + \
                    np.abs(locations[:, 1] - state.pos[1])
            target = tuple(locations[dists.argmin()])

            # compute movement actions to get adjacent to the primitive
            move_seq = _bfs_path(state.grid, state.pos, target)
            for a in move_seq:
                reward, new_state = state.step(a)
                actions.append(a)
                state = new_state

            # now we are adjacent – use action 4 to pick it up
            reward, new_state = state.step(4)   # USE
            actions.append(4)
            state = new_state

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        _collect_primitive(prim_idx, cnt)

    # ------------------------------------------------------------------
    # If a workshop is needed, move there and issue a USE action to craft.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        # locate any workshop cell of the required type
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - state.pos[0]) + \
                    np.abs(workshop_cells[:, 1] - state.pos[1])
            w_target = tuple(workshop_cells[dists.argmin()])

            move_seq = _bfs_path(state.grid, state.pos, w_target)
            for a in move_seq:
                reward, new_state = state.step(a)
                actions.append(a)
                state = new_state

            # final USE to craft the goal item
            reward, new_state = state.step(4)   # USE
            actions.append(4)
            state = new_state

    # Return the compiled action list
    return actions

