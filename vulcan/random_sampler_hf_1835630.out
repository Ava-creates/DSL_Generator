        target_ws = ws_cells[0]
        path = _bfs_to_adjacent(pos, [target_ws], occupied)
        actions.extend(path)
        for act in path:
            if act == RIGHT:
                pos = (pos[0] + 1, pos[1])
            elif act == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif act == DOWN:
