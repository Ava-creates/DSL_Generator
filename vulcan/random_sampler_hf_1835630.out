    # ------------------------------------------------------------------
    def _bfs_to_target(st, target_kind):
        grid = st.grid
        W, H = grid.shape[:2]

        # direction → (dx, dy) matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        start_x, start_y = st.pos
        start_dir = st.dir
        from collections import deque
        q = deque()
        q.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while q:
            x, y, d, seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return seq

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))

        return []

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
