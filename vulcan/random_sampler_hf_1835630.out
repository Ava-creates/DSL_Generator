    # Helper: BFS that returns a list of movement actions (0‑3) that brings
    # the agent to a cell whose *front* contains `target_kind`. Returns None
    # if the target cannot be reached.
    # ------------------------------------------------------------------
    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)
        deltas = {0: (0, 1),   # DOWN
                  1: (0, -1),  # UP
                  2: (-1, 0),  # LEFT
                  3: (1, 0)}   # RIGHT

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = cur_state.pos
        sdir = cur_state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:                         # arrow itself may be primitive
