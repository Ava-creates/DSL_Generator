    # Helper: hashable representation of a CraftState for visited checking
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # Heuristic: underestimate of remaining steps – sum of missing primitive counts
    def _heuristic(st):
        missing = 0
        inv = st.inventory
        for kind, need in primitive_req.items():
            have = inv[kind] if kind < len(inv) else 0
            if have < need:
                missing += need - have
        return missing

