    # Helper: BFS returning a list of movement actions (0‑3) that places
    # the agent so that the cell directly in front contains `target_kind`.
    # Returns None if the target cannot be reached.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        from collections import deque
        grid = state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy) matching the environment's action ordering
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sdir = state.dir

        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # --------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # If the recipe dict is empty, the arrow itself is a primitive.
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    plan = []

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # --------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            if move_seq is None:
                # Primitive unreachable – abort planning.
                return plan
            plan.extend(move_seq)
            plan.append(4)                     # USE to pick up

            # Keep the internal state up‑to‑date.
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        if move_seq is None:
            # Workshop unreachable – abort planning.
            return plan
        plan.extend(move_seq)
        plan.append(4)                         # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – craft in place.
        plan.append(4)                         # USE to craft
        _, cur_state = cur_state.step(4)

    return plan

