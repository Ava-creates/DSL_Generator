    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and fetch current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that
        walks from ``start`` to ``goal`` using a simple Manhattan walk.
        No obstacle checking – works on open maps."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x

        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)

        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)

        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing ``kind_idx`` (primitive or workshop)
        using a linear scan. Returns (y, x) or ``None`` if not found."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine what we need to collect to craft an arrow
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Choose a free neighbouring cell to stand on.
            ty, tx = target
            neighbours = [
                (ty - 1, tx),  # above (face DOWN)
                (ty + 1, tx),  # below (face UP)
                (ty, tx - 1),  # left  (face RIGHT)
                (ty, tx + 1),  # right (face LEFT)
            ]
            adj = None
            for ny, nx in neighbours:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # Fall back to standing on the primitive cell itself.
                adj = target

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Ensure we are facing the primitive (best‑effort).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)
            # If already on the same cell, direction is irrelevant.

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions


    # Action indices (as defined by CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset env and grab current state / world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that
        walks from start to goal using a simple Manhattan walk."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def locate_cells(kind):
        """Return a list of (y,x) coordinates where `kind` is present."""
        return [tuple(coord) for coord in np.argwhere(grid[:, :, kind] > 0)]

    def nearest_cell(cells, from_pos):
        """Pick the cell with smallest Manhattan distance from `from_pos`."""
        if not cells:
            return None
        dists = [abs(y - from_pos[0]) + abs(x - from_pos[1]) for (y, x) in cells]
        return cells[int(np.argmin(dists))]

    def free_adjacent(cell, from_pos):
        """Find a free adjacent cell to `cell` that is reachable from `from_pos`.
        Preference is given to cells that are orthogonally adjacent.
        Returns None if none found."""
        y, x = cell
        candidates = [
            (y - 1, x),  # above
            (y + 1, x),  # below
            (y, x - 1),  # left
            (y, x + 1),  # right
        ]
        for ny, nx in candidates:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                # cell must be empty of non‑grabbable entities
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        return None

    def face_dir(src, dst):
        """Return the movement action that makes the agent at `src` face `dst`."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        # already on same cell – no turn needed
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect required primitives (including possible multiples)
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            prim_cells = locate_cells(prim_idx)
            target = nearest_cell(prim_cells, cur_pos)
            if target is None:
                # primitive not present – abort early
                return actions

            # Choose a free adjacent cell to stand on
            adj = free_adjacent(target, cur_pos)
            if adj is None:
                # fallback: stand on the primitive cell itself
                adj = target

            # Move to the adjacent cell
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Turn to face the primitive (may involve a move that fails)
            turn_action = face_dir(cur_pos, target)
            if turn_action is not None:
                actions.append(turn_action)

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cells = locate_cells(ws_idx)
        ws_target = nearest_cell(ws_cells, cur_pos)
        if ws_target is not None:
            actions += manhattan_path(cur_pos, ws_target)
            cur_pos = ws_target

    # Final USE to trigger crafting
    actions.append(USE)

    return actions

