    # reset environment and fetch useful objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy of the grid

    # action indices (DOWN,UP,LEFT,RIGHT,USE)
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIR2ACT = {(1, 0): DOWN, (-1, 0): UP, (0, 1): RIGHT, (0, -1): LEFT}
    DIRS = [(1, 0), (-1, 0), (0, 1), (0, -1)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def is_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return np.any(grid[y, x])

    def bfs_path(start, goal):
        """Return a list of movement actions that walks from start to goal
        while avoiding blocked cells (including the goal cell itself if it is
        blocked – in that case the path will stop at a neighbour)."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    dy, dx = cur[0] - py, cur[1] - px
                    rev.append(DIR2ACT[(dy, dx)])
                    cur = (py, px)
                return list(reversed(rev))
            for dy, dx in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if is_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # no path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing `kind_idx`."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, forbid=set()):
        """Return a free neighbour of `cell` that is not in `forbid`."""
        y, x = cell
        for dy, dx in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in forbid:
                continue
            if not is_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos                       # (y, x)
    taken = set()                             # cells already harvested

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # primitive missing – abort early
                return actions

            # choose a free neighbour to stand on while picking up
            adj = adjacent_free(target, forbid=taken)
            if adj is None:
                # fallback: stand on the primitive cell itself if free
                if not is_blocked(*target):
                    adj = target
                else:
                    return actions

            # move to the chosen adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # turn to face the primitive (a blocked move changes direction)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if (dy, dx) in DIR2ACT:
                actions.append(DIR2ACT[(dy, dx)])

            # pick it up
            actions.append(USE)

            # update internal grid copy and record the cell as taken
            grid[target[0], target[1], prim_idx] = 0
            taken.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, forbid=taken)
            if ws_adj is None:
                ws_adj = ws_cell if not is_blocked(*ws_cell) else None
            if ws_adj is not None:
                actions += bfs_path(cur_pos, ws_adj)
                cur_pos = ws_adj

                # optionally turn towards the workshop
                dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
                if (dy, dx) in DIR2ACT:
                    actions.append(DIR2ACT[(dy, dx)])

    # final crafting action
    actions.append(USE)

    return actions


    # Reset the environment and obtain current state information
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    # Work on a mutable copy of the grid so we can mark collected items
    grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)

    # Action indices from the environment specification
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # Directions together with corresponding action codes
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def cell_blocked(y, x):
        """A cell is blocked if any kind occupies it."""
        return np.any(grid[y, x])

    def bfs_path(start, goal):
        """Return a list of movement actions that walks from start to goal
        while avoiding blocked cells. The returned actions are the movement
        codes (DOWN/UP/LEFT/RIGHT)."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}  # child -> (parent, action)
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                break
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = ((y, x), act)
                q.append((ny, nx))
        else:
            # No path found
            return []

        # Reconstruct actions from goal back to start
        actions_rev = []
        cur = goal
        while cur != start:
            prev, act = parent[cur]
            actions_rev.append(act)
            cur = prev
        return list(reversed(actions_rev))

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell that contains the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, forbidden=set()):
        """Return a free neighbour of *cell* that is not in *forbidden*.
        If none exists, return None."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in forbidden:
                continue
            if not cell_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []          # final action sequence to return
    cur_pos = state.pos   # current agent position (y, x)
    taken_cells = set()   # cells from which primitives have been collected

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present on map – abort early.
                return actions

            # Choose a free adjacent cell to stand on while picking up.
            adj = adjacent_free(target, forbidden=taken_cells)
            if adj is None:
                # No free neighbour; abort.
                return actions

            # Move to the adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Turn to face the primitive (attempt a move into the blocked cell).
            dy = target[0] - cur_pos[0]
            dx = target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update internal grid copy and remember the cell as taken.
            grid[target[0], target[1], prim_idx] = 0
            taken_cells.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, forbidden=taken_cells)
            if ws_adj is None:
                # Fallback: stand directly on the workshop cell if no free neighbour.
                ws_adj = ws_cell
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Turn to face the workshop.
            dy = ws_cell[0] - cur_pos[0]
            dx = ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting of the arrow.
    actions.append(USE)

    return actions

