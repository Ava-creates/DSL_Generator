    return actions


    # Reset environment and get handles
    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid

    # Action constants (as used by CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    ACTION_DELTAS = {
        DOWN: (1, 0),
        UP: (-1, 0),
        LEFT: (0, -1),
        RIGHT: (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(pos):
        """Return True if the cell at ``pos`` is occupied by any entity."""
        y, x = pos
        return np.any(grid[y, x, :] > 0)

    def bfs_path(start, goal):
        """
        Bread‑first search returning a list of positions (excluding ``start``)
        that leads from ``start`` to ``goal`` while avoiding blocked cells.
        Returns empty list if no path exists.
        """
        h, w = grid.shape[0], grid.shape[1]
        queue = collections.deque()
        queue.append(start)
        came_from = {start: None}
        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            cy, cx = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = cy + dy, cx + dx
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in came_from and not is_blocked(nxt):
                        came_from[nxt] = cur
                        queue.append(nxt)
        # Reconstruct path
        if goal not in came_from:
            return []
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions to a list of movement actions."""
        actions = []
        for (y0, x0), (y1, x1) in zip([state.pos] + path[:-1], path):
            dy, dx = y1 - y0, x1 - x0
            for act, (ady, adx) in ACTION_DELTAS.items():
                if (dy, dx) == (ady, adx):
                    actions.append(act)
                    break
        return actions

    def direction_action(to_pos, from_pos):
        """Return the action that points from ``from_pos`` towards ``to_pos``."""
        dy = to_pos[0] - from_pos[0]
        dx = to_pos[1] - from_pos[1]
        if dy > 0:
            return DOWN
        if dy < 0:
            return UP
        if dx > 0:
            return RIGHT
        if dx < 0:
            return LEFT
        return None  # same cell

    def nearest_cell(kind_idx, from_pos):
        """Find the nearest cell containing ``kind_idx``."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a free neighbour of ``cell`` (or None if none)."""
        y, x = cell
        h, w = grid.shape[0], grid.shape[1]
        for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:
            if 0 <= ny < h and 0 <= nx < w and not is_blocked((ny, nx)):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine required primitives for the goal item 'arrow'
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect each primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = nearest_cell(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Choose a free cell adjacent to the primitive to stand on.
            stand = free_adjacent(target)
            if stand is None:
                # No free neighbour; cannot pick up this primitive.
                return actions

            # Move to the chosen standing cell.
            path = bfs_path(cur_pos, stand)
            if not path and cur_pos != stand:
                # No path found – abort.
                return actions
            actions += path_to_actions(path)
            cur_pos = stand

            # Face the primitive (add a direction action; if blocked it only changes direction).
            dir_act = direction_action(target, cur_pos)
            if dir_act is not None:
                actions.append(dir_act)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest_cell(workshop_idx, cur_pos)
        if ws_cell is not None:
            # Prefer to stand on the workshop cell itself if it is free.
            if not is_blocked(ws_cell):
                target_ws = ws_cell
            else:
                # otherwise stand on a free neighbour.
                target_ws = free_adjacent(ws_cell) or ws_cell
            path = bfs_path(cur_pos, target_ws)
            if path:
                actions += path_to_actions(path)
                cur_pos = target_ws

    # Final USE triggers crafting of the arrow.
    actions.append(USE)

    return actions

