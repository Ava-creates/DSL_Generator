    while frontier:
        node = frontier.popleft()
        state, actions = node.state, node.actions

        # Goal test
        if state.satisfies("", target_idx):
            return actions

        if len(actions) >= MAX_STEPS:
            continue

        # Expand possible actions
        for a in range(n_actions):
            _, nxt = state.step(a)
            h = _hash_state(nxt)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt, actions + [a]))

    # No plan found within the limit
    return []

