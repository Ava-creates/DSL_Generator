    # ------------------------------------------------------------------
    # Bread‑first search over the deterministic state transition graph.
    # ------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory tuple, and a bytes view of the grid.
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque()
    frontier.append(Node(start_state, []))
    visited.add(_state_hash(start_state))

    # Safety limits to keep the search tractable.
    MAX_STEPS = 400          # maximum plan length we are willing to explore
    MAX_VISITED = 200_000    # cap on the number of explored states

    # Number of possible actions (standard actions are 0‑4).
    n_actions = getattr(world, "n_actions", 5)

    while frontier and len(visited) < MAX_VISITED:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test – we succeed as soon as the inventory contains an arrow.
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long partial plans.
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all legal actions from the current state.
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    # If we exit the loop without finding a solution we return an empty plan.
    return []

