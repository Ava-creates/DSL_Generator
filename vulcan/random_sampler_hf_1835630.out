    # Retrieve scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Get the index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting CraftState
    try:
        start_state = scenario.init()
    except Exception:
        return []

    # Bread‑first search over state space to find a plan
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        # Combine position, direction, inventory and grid layout into a hashable key
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(start_state)}
    frontier = deque([Node(start_state, [])])

    # Search limits
    MAX_STEPS = 300
    n_actions = getattr(world, "n_actions", 5)  # typical actions: 0‑4

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: does the inventory contain the arrow?
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Depth limit
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand neighbours
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the depth limit
    return []


