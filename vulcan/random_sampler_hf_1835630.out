    # Resolve world and target index
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Starting state
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _hash(st):
        """Create a hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_hash(init_state))

    MAX_STEPS = 2000                     # safety cap on plan length
    n_actions = getattr(world, "n_actions", 5)

    # Prefer USE (action 4) before movement to speed up crafting when possible
    action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal reached?
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand successors
        for a in action_order:
            _, nxt_state = cur_state.step(a)   # reward is irrelevant here
            h = _hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If we exit the loop no plan was found within the limits
    return []


    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # target item index
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # initial state
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_state_hash(init_state))

    MAX_STEPS = 2000
    n_actions = getattr(world, "n_actions", 5)
    # Prefer USE (usually index 4) before movement actions
    action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        if cur_state.satisfies("", target_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        for a in action_order:
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    return []

