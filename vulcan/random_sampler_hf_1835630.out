    import numpy as np

    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and fetch current state/world information
    env.reset()
    state = env._current_state
    world = env.world
    # Work on a mutable copy of the grid so we can mark collected items
    grid = state.grid.copy()

    # Index of the goal item (arrow) and the primitive requirements for one arrow
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # Helper: Manhattan‑distance path (vertical then horizontal)
    def manhattan_path(start, goal):
        y, x = start
        gy, gx = goal
        actions = []
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    # Helper: locate the nearest cell containing a given kind
    def nearest_cell(kind, from_pos):
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    # Helper: pick a free adjacent cell (not occupied by non‑grabbable entities)
    def free_adjacent(target):
        ty, tx = target
        for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        # Fallback: use the target cell itself (assumed walkable)
        return target

    actions = []
    cur = state.pos  # current agent position (y, x)

    # ------------------------------------------------------------------
    # Collect all required primitive items
    # ------------------------------------------------------------------
    for prim_idx, count in required.items():
        for _ in range(count):
            # Find nearest remaining primitive of this type
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # No more items of this kind – abort early
                return actions

            # Choose a free cell next to the primitive to stand on
            stand_pos = free_adjacent(prim_loc)

            # Move to the standing position
            actions += manhattan_path(cur, stand_pos)
            cur = stand_pos

            # Determine the direction needed to step onto the primitive cell
            dy = prim_loc[0] - cur[0]
            dx = prim_loc[1] - cur[1]
            if dy == 1:
                actions.append(DOWN)
                cur = (cur[0] + 1, cur[1])
            elif dy == -1:
                actions.append(UP)
                cur = (cur[0] - 1, cur[1])
            elif dx == 1:
                actions.append(RIGHT)
                cur = (cur[0], cur[1] + 1)
            elif dx == -1:
                actions.append(LEFT)
                cur = (cur[0], cur[1] - 1)
            else:
                # Already on the primitive cell (unlikely but handled)
                pass

            # Pick up the primitive
            actions.append(USE)

            # Mark the primitive as collected in our local grid copy
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            actions += manhattan_path(cur, ws_loc)
            cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions


    import numpy as np
    # action indices (consistent with CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # reset environment to start fresh
    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid

    # index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index('arrow')
    # primitive requirements for one arrow
    needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------
    # helper functions
    # ------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of actions moving from start to goal using Manhattan moves."""
        actions = []
        y, x = start
        gy, gx = goal
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def locate_all(kind):
        """Return a list of (y,x) positions where `kind` is present in the grid."""
        positions = np.argwhere(grid[:, :, kind] > 0)
        return [tuple(p) for p in positions]

    def nearest_position(positions, from_pos):
        """Select the position with minimal Manhattan distance from `from_pos`."""
        if not positions:
            return None
        dists = [abs(p[0] - from_pos[0]) + abs(p[1] - from_pos[1]) for p in positions]
        return positions[int(np.argmin(dists))]

    def free_adjacent(cell):
        """Return a free (empty) neighbour of `cell` if any, else None."""
        y, x = cell
        h, w = grid.shape[0], grid.shape[1]
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < h and 0 <= nx < w:
                if not np.any(grid[ny, nx, :]):  # completely empty
                    return (ny, nx)
        return None

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------
    # collect each required primitive
    # ------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # locate nearest instance of the primitive
            prim_positions = locate_all(prim_idx)
            target = nearest_position(prim_positions, cur_pos)
            if target is None:
                # cannot find required primitive – stop early
                return actions
            # move to a free cell adjacent to the primitive
            adj = free_adjacent(target)
            if adj is None:
                # fallback: stand on the primitive cell itself (may be impossible)
                adj = target
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj
            # after arriving, the last movement direction points toward the primitive,
            # so a single USE is sufficient
            actions.append(USE)

    # ------------------------------------------------------------
    # move to the workshop (if the recipe specifies one) and craft
    # ------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_positions = locate_all(ws_idx)
        ws_target = nearest_position(ws_positions, cur_pos)
        if ws_target is not None:
            ws_adj = free_adjacent(ws_target)
            if ws_adj is None:
                ws_adj = ws_target
            actions += manhattan_path(cur_pos, ws_adj)
            cur_pos = ws_adj
    # final USE to perform the crafting action
    actions.append(USE)

    return actions

