    import numpy as np
    import collections

    # Action indices as defined in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of actions that brings
    # the agent from `start` to any cell adjacent (Manhattan distance ≤ 1)
    # to one of `targets`.  `occ` is a 2‑D boolean array where True means
    # the cell is blocked for movement.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are already adjacent to any target, stop.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Explore neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell.
        return []

    # ------------------------------------------------------------------
    # Locate the world (CraftWorld) and the cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state.
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance in the environment.")

    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if necessary) and fetch the
    # current position and grid.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()              # mutable copy for planning

    # ------------------------------------------------------------------
    # Identify the goal index for "arrow" and the primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in the recipe index.")
    goal_idx = cookbook.index[goal_name]

    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []          # final action sequence
    harvested = set()     # cells already used for collection

    # ------------------------------------------------------------------
    # Helper to compute the occupied mask (any non‑zero kind blocks movement).
    # ------------------------------------------------------------------
    def _occupied(g):
        return np.any(g > 0, axis=2)

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locate all cells containing this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position to reduce travel.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))

        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue

            occ = _occupied(grid)
            path = _bfs_path(pos, [loc], occ)
            actions.extend(path)

            # Update position according to the path taken.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Use action to pick up the primitive.
            actions.append(USE)

            # Mark the cell as empty for future planning.
            grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or already an int).
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        # Find all workshop cells of the required type.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]

            occ = _occupied(grid)
            path = _bfs_path(pos, [target_ws], occ)
            actions.extend(path)

            # Update position.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Craft at the workshop.
            actions.append(USE)
        else:
            # No visible workshop; attempt to craft at current location.
            actions.append(USE)
    else:
        # No specific workshop required; craft wherever we are.
        actions.append(USE)

    return actions


    import numpy as np, collections

    # Action indices as defined in CraftWorld (order may differ but typical mapping)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from `start` to a cell
    # that is Manhattan‑adjacent to any cell in `targets`.  Cells that are
    # occupied (any non‑zero kind) are treated as walls.
    # ----------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # stop if we are already adjacent to a target cell
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # explore 4‑neighbourhood
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no reachable adjacent cell
        return []

    # ----------------------------------------------------------------------
    # Locate world and cookbook objects inside the environment.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # some wrappers expose the state directly
        _state = getattr(env, "_current_state", None)
        if _state is not None:
            world = getattr(_state, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the provided env.")

    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Ensure we have a fresh state (reset if needed) and fetch current info.
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Current position and mutable copy of the grid for planning.
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # shape (W, H, n_kinds)

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in cookbook.")
    goal_idx = cookbook.index[goal_name]

    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []                         # final action sequence
    harvested = set()                    # locations already collected from

    # ----------------------------------------------------------------------
    # Function to update position after applying a list of actions.
    # ----------------------------------------------------------------------
    def _apply_path(start, path):
        x, y = start
        for a in path:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ----------------------------------------------------------------------
    # Collect each required primitive.
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells currently containing this primitive.
        locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position to reduce travel.
        locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locs:
            if collected >= needed:
                break
            if loc in harvested:
                continue

            # Occupancy mask for planning (any non‑zero kind blocks movement)
            occupied = np.any(grid > 0, axis=2)

            # Compute path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [loc], occupied)
            actions.extend(path)
            pos = _apply_path(pos, path)

            # Pick up the primitive.
            actions.append(USE)

            # Update planning grid: primitive is now removed.
            grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name or already an int)
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop cell.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            occupied = np.any(grid > 0, axis=2)
            path = _bfs_adjacent(pos, [target_ws], occupied)
            actions.extend(path)
            pos = _apply_path(pos, path)
            actions.append(USE)          # craft at the workshop
        else:
            # No visible workshop – attempt to craft in place.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions

