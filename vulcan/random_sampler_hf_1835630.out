    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Reset environment and obtain core objects
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Action indices (as defined by the environment)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    height, width = grid.shape[0], grid.shape[1]

    def in_bounds(y, x):
        return 0 <= y < height and 0 <= x < width

    def is_blocked(y, x, planning_grid):
        """Cell is blocked if any non‑grabbable entity occupies it."""
        if not in_bounds(y, x):
            return True
        # world.non_grabbable_indices is a set of kind indices
        return np.any(planning_grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs_path(start, goal, planning_grid):
        """Return a list of movement actions from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if is_blocked(ny, nx, planning_grid):
                    continue
                new_path = path + [act]
                if (ny, nx) == goal:
                    return new_path
                visited.add((ny, nx))
                q.append(((ny, nx), new_path))
        # No path found – return empty list (caller may handle)
        return []

    def find_nearest(kind_idx, from_pos, planning_grid):
        """Locate the closest cell containing ``kind_idx``."""
        locs = np.argwhere(planning_grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[dists.argmin()]
        return tuple(nearest)

    def free_adjacent(cell, planning_grid, avoid=set()):
        """Return a free neighbour of ``cell`` not in ``avoid``."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not is_blocked(ny, nx, planning_grid):
                return (ny, nx)
        return None

    def direction_to(target, src):
        """Return the action that would move from src towards target (one step)."""
        dy = target[0] - src[0]
        dx = target[1] - src[1]
        if dy > 0:
            return DOWN
        if dy < 0:
            return UP
        if dx > 0:
            return RIGHT
        if dx < 0:
            return LEFT
        return None  # already on target

    # ------------------------------------------------------------------
    # Determine the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    # ------------------------------------------------------------------
    # Planning grid – mutable copy of the world grid
    # ------------------------------------------------------------------
    planning_grid = grid.copy()

    actions = []
    cur_pos = state.pos  # (y, x)
    harvested = set()    # keep track of cells we already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos, planning_grid)
            if target is None:
                # Primitive not available – abort planning.
                return actions

            # Choose a free adjacent cell to stand on before using.
            adj = free_adjacent(target, planning_grid, avoid=harvested)
            if adj is None:
                # No free neighbour; cannot collect this primitive.
                return actions

            # Move to the adjacent cell.
            actions += bfs_path(cur_pos, adj, planning_grid)
            cur_pos = adj

            # Face the primitive (add a direction action if needed).
            dir_act = direction_to(target, cur_pos)
            if dir_act is not None:
                actions.append(dir_act)

            # Pick up the primitive.
            actions.append(USE)

            # Update planning grid and record that this cell has been harvested.
            planning_grid[target[0], target[1], prim_idx] = 0
            harvested.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos, planning_grid)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell, planning_grid)
            cur_pos = ws_cell

    # Final USE to trigger crafting at the current location.
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Reset and obtain core objects
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Action indices
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    height, width = grid.shape[0], grid.shape[1]

    def in_bounds(y, x):
        return 0 <= y < height and 0 <= x < width

    def cell_blocked(y, x, g):
        """Cell is blocked if any non‑grabbable entity occupies it."""
        return np.any(g[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs_path(start, goal, g):
        """Return list of movement actions from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_blocked(ny, nx, g):
                    continue
                new_path = path + [act]
                if (ny, nx) == goal:
                    return new_path
                visited.add((ny, nx))
                q.append(((ny, nx), new_path))
        # No path found – return empty list (will cause planning to abort)
        return []

    def find_nearest(kind_idx, from_pos, g):
        """Locate nearest cell containing kind_idx."""
        locs = np.argwhere(g[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[dists.argmin()]
        return tuple(nearest)

    def free_adjacent(cell, g, avoid=set()):
        """Return a free neighbour of cell not in avoid set."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not cell_blocked(ny, nx, g):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify goal and recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)  # dict {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos
    harvested = set()

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos, grid)
            if target is None:
                return actions  # cannot find required primitive

            # Choose a free adjacent cell to stand on before using
            adj = free_adjacent(target, grid, avoid=harvested)
            if adj is None:
                # fallback: stand on the primitive cell itself if it is free
                if not cell_blocked(*target, grid):
                    adj = target
                else:
                    return actions

            # Move to the adjacent cell
            actions += bfs_path(cur_pos, adj, grid)
            cur_pos = adj

            # Face the primitive (direction towards target)
            dy = target[0] - cur_pos[0]
            dx = target[1] - cur_pos[1]
            if dy > 0:
                actions.append(DOWN)
            elif dy < 0:
                actions.append(UP)
            elif dx > 0:
                actions.append(RIGHT)
            elif dx < 0:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid and record harvested location
            grid[target[0], target[1], prim_idx] = 0
            harvested.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos, grid)
        if ws_cell is not None:
            # Move to a free adjacent cell next to the workshop
            ws_adj = free_adjacent(ws_cell, grid, avoid=harvested)
            if ws_adj is not None:
                actions += bfs_path(cur_pos, ws_adj, grid)
                cur_pos = ws_adj
            else:
                # If no free neighbour, stand on the workshop cell itself (if free)
                if not cell_blocked(*ws_cell, grid):
                    actions += bfs_path(cur_pos, ws_cell, grid)
                    cur_pos = ws_cell

    # Final USE to trigger crafting
    actions.append(USE)
    return actions

