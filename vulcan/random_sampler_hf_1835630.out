    import collections
    from collections import deque, namedtuple

    # ----- obtain scenario and world objects (handle wrappers) -----
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # ----- index of the target item (arrow) -----
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # ----- initial state of the episode -----
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ----- BFS planner over CraftState space -----
    Node = namedtuple("Node", ["state", "actions"])

    def _hash_state(st):
        """Create a hashable representation of a CraftState."""
        # inventory and grid are numpy arrays; convert to bytes for fast hashing
        return (
            st.pos,
            st.dir,
            st.inventory.tobytes(),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_hash_state(init_state))

    MAX_PLAN_LEN = 300                     # safety cutoff
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return cur_actions

        if len(cur_actions) >= MAX_PLAN_LEN:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _hash_state(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, cur_actions + [a]))

    # No plan found within limits
    return []


