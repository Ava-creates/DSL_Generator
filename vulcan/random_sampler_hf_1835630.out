    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # Collect required primitives
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            prim_loc = nearest_cell(prim_idx, cur_pos)
            if prim_loc is None:
                return actions  # missing primitive

            # Move to a free cell adjacent to the primitive
            stand = free_adjacent(prim_loc)
            path = bfs_path(cur_pos, stand)
            if not path:
                return actions
            actions.extend(path_to_actions(path))
            cur_pos = stand

            # Step onto the primitive cell (if not blocked)
            if not is_blocked(prim_loc):
                path = bfs_path(cur_pos, prim_loc)
                if not path:
                    return actions
                actions.extend(path_to_actions(path))
                cur_pos = prim_loc

            # Pick up
            actions.append(USE)

            # Update planning grid
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # Go to workshop if recipe specifies one
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur_pos)
        if ws_loc is not None:
            path = bfs_path(cur_pos, ws_loc)
            if path:
                actions.extend(path_to_actions(path))
                cur_pos = ws_loc

    # Final craft action
    actions.append(USE)
    return actions


    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Initialise environment and obtain world information
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid.copy()             # mutable copy for planning

    # Goal: make an arrow
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)

    # Primitive requirements for one arrow (expanded recursively)
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """Return True if the cell contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs(start, goal):
        """Return a list of positions from start to goal (inclusive) avoiding blocked cells."""
        if start == goal:
            return [start]
        h, w = grid.shape[:2]
        q = deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in prev and not is_blocked(nxt):
                        prev[nxt] = cur
                        q.append(nxt)
        else:
            return []  # no path found

        # reconstruct path
        path = []
        cur = goal
        while cur is not None:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Translate a list of positions into movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest(kind, from_pos):
        """Find the nearest cell containing the given kind (Manhattan distance)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos  # (y, x)

    # Collect each required primitive the needed number of times
    for prim_idx, count in needed.items():
        for _ in range(count):
            prim_loc = nearest(prim_idx, cur_pos)
            if prim_loc is None:
                # Primitive not present – abort early
                return actions

            # Move to the primitive cell
            path = bfs(cur_pos, prim_loc)
            if not path:
                return actions
            actions.extend(path_to_actions(path))
            cur_pos = prim_loc

            # Pick it up
            actions.append(USE)

            # Update planning grid (primitive has been taken)
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # If the recipe requires a specific workshop, move there
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest(ws_idx, cur_pos)
        if ws_loc is not None:
            path = bfs(cur_pos, ws_loc)
            if path:
                actions.extend(path_to_actions(path))
                cur_pos = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)
    return actions

