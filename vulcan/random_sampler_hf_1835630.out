        occupied = np.any(grid > 0, axis=2)          # blocked cells
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop if we are already adjacent to a target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable path.
        return []

    # ------------------------------------------------------------------
    # Helper: update a (x, y) position according to an action.
    # ------------------------------------------------------------------
    def _move(pos, act):
        if act == RIGHT:
            return (pos[0] + 1, pos[1])
        if act == LEFT:
            return (pos[0] - 1, pos[1])
        if act == DOWN:
            return (pos[0], pos[1] + 1)
        if act == UP:
            return (pos[0], pos[1] - 1)
        return pos

    # ------------------------------------------------------------------
    # Locate the CraftWorld and Cookbook objects inside the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state.
        tmp_state = getattr(env, "_current_state", None)
        if tmp_state is not None:
            world = getattr(tmp_state, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")

    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a reset state.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Goal is the item named "arrow".
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in the cookbook.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for one arrow (primitive index → count).
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Planning state (mutable copies of position and grid).
    # ------------------------------------------------------------------
    pos = tuple(state.pos)               # current (x, y)
    grid = state.grid.copy()             # mutable copy for planning
    actions = []                         # final action sequence
    harvested = set()                    # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # All cells currently containing this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)
            # Pick up the primitive.
            actions.append(USE)
            harvested.add(loc)
            collected += 1
            # Mark the cell empty for future planning.
            grid[loc[0], loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer).
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str)
                  else int(workshop_key))
        # Find all workshop cells.
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            # Choose the nearest workshop.
            ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_cells[0]
            # Move adjacent to the workshop.
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)
        # Use (craft) at the workshop or current location.
        actions.append(USE)
    else:
        # No specific workshop required – just use.
        actions.append(USE)

    return actions

