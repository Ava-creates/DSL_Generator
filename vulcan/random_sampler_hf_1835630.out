        if not ws_cells:
            raise RuntimeError(f"No workshop '{workshop_key}' found in the scenario.")
        # pick nearest workshop
        ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        target_ws = ws_cells[0]
        path = _bfs_adjacent(pos, [target_ws], occupied)
        actions.extend(path)
        for act in path:
            if act == RIGHT:
                pos = (pos[0] + 1, pos[1])
            elif act == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif act == DOWN:
                pos = (pos[0], pos[1] + 1)
            elif act == UP:
                pos = (pos[0], pos[1] - 1)
        # craft
        actions.append(USE)
    else:
        # no specific workshop required
        actions.append(USE)

    return actions


    import collections, numpy as np

    # ----- helpers ---------------------------------------------------------
    def _bfs_adjacent(start, targets, occ):
        """Return list of actions moving from start to a cell adjacent to any target."""
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # unreachable

    # ----- locate world and cookbook ---------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in env.")
    cookbook = world.cookbook

    # ----- goal setup -------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # ----- ensure fresh episode ---------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)
    grid = state.grid
    occupied = np.any(grid > 0, axis=2)          # blocked cells

    actions = []
    harvested = set()

    # ----- collect required primitives ---------------------------------------
    for prim_idx, count in needed.items():
        # locate all cells containing this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from current position
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= count:
                break
            if cell in harvested:
                continue
            # move adjacent to the primitive
            path = _bfs_adjacent(pos, [cell], occupied)
            actions.extend(path)
            # update simulated position
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # pick it up
            actions.append(USE)
            occupied[cell[0], cell[1]] = False
            harvested.add(cell)
            collected += 1

    # ----- go to workshop and craft -----------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if not ws_cells:
            raise RuntimeError(f"No workshop of type '{workshop_key}' found.")
        ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        target_ws = ws_cells[0]
        path = _bfs_adjacent(pos, [target_ws], occupied)
        actions.extend(path)
        for act in path:
            if act == RIGHT:
                pos = (pos[0] + 1, pos[1])
            elif act == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif act == DOWN:
                pos = (pos[0], pos[1] + 1)
            elif act == UP:
                pos = (pos[0], pos[1] - 1)
    # craft (use action at current location)
    actions.append(USE)

    return actions

