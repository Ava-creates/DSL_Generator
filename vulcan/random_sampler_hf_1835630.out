    # reset environment and get handles
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # action constants as defined in CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    # --------------------------------------------------------------------
    # Helper: BFS to the nearest cell containing a given kind.
    # The search walks only through empty cells, but it may step onto the
    # goal cell even if that cell is occupied (e.g. contains the primitive).
    # Returns (target_position, action_path) or (None, None) if not found.
    # --------------------------------------------------------------------
    def _nearest_of_kind(grid, kind_idx, start):
        h, w, _ = grid.shape
        from collections import deque
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        while q:
            (r, c), path = q.popleft()
            if grid[r, c, kind_idx] > 0:          # found the item
                return (r, c), path
            for act, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:
                    # can walk on empty cells; can also step onto the goal later
                    if np.all(grid[nr, nc, :] == 0):
                        visited.add((nr, nc))
                        q.append(((nr, nc), path + [act]))
        return None, None

    # --------------------------------------------------------------------
    # Helper: BFS path from current position to a specific target cell.
    # Allows stepping onto the target even if it is occupied.
    # Returns a list of actions or None if unreachable.
    # --------------------------------------------------------------------
    def _bfs_path(grid, start, goal):
        if start == goal:
            return []
        h, w, _ = grid.shape
        from collections import deque
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        while q:
            (r, c), path = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:
                    # allow moving onto the goal cell regardless of occupancy
                    if (nr, nc) == goal or np.all(grid[nr, nc, :] == 0):
                        if (nr, nc) == goal:
                            return path + [act]
                        visited.add((nr, nc))
                        q.append(((nr, nc), path + [act]))
        return None

    # --------------------------------------------------------------------
    # Identify the index of the target item ("arrow").
    # --------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # not present in this world
        return []

    # --------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # --------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # --------------------------------------------------------------------
    # Collect each required primitive, respecting the required count.
    # --------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            target_pos, path_to_target = _nearest_of_kind(state.grid, prim_idx, state.pos)
            if target_pos is None:
                # primitive not found – abort early
                return action_seq
            # move to the primitive
            for a in path_to_target:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # --------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the arrow.
    # --------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)

    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_pos, path_to_ws = _nearest_of_kind(state.grid, workshop_idx, state.pos)
        if ws_pos is not None:
            for a in path_to_ws:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # craft at workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
    else:
        # No specific workshop – attempt crafting in place
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq


    # Reset the environment and obtain the initial state/world handles.
    env.reset()
    state = env._current_state
    world = env.world

    # Action identifiers as defined in CraftLab.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    ACTIONS = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    def bfs_path(start, target_kind):
        """Return a list of actions that moves the agent from ``start`` to the
        nearest cell containing ``target_kind``.  The search walks through empty
        cells and may step onto the goal cell even if it is occupied."""
        h, w, _ = state.grid.shape
        from collections import deque
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (r, c), path = q.popleft()
            if state.grid[r, c, target_kind] > 0:
                return path
            for act, (dr, dc) in ACTIONS:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:
                    # Allow stepping onto the target even if occupied.
                    if state.grid[nr, nc, target_kind] > 0 or np.all(state.grid[nr, nc, :] == 0):
                        visited.add((nr, nc))
                        q.append(((nr, nc), path + [act]))
        return None

    def bfs_to_workshop(start, workshop_kind):
        """Return actions to the nearest workshop cell (may be occupied)."""
        h, w, _ = state.grid.shape
        from collections import deque
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (r, c), path = q.popleft()
            if state.grid[r, c, workshop_kind] > 0:
                return path
            for act, (dr, dc) in ACTIONS:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:
                    if state.grid[nr, nc, workshop_kind] > 0 or np.all(state.grid[nr, nc, :] == 0):
                        visited.add((nr, nc))
                        q.append(((nr, nc), path + [act]))
        return None

    # --------------------------------------------------------------------
    # Identify the index of the target item 'arrow'.
    # --------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # Arrow not defined in this world.
        return []

    # --------------------------------------------------------------------
    # Determine primitive resources required for a single arrow.
    # --------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    actions_taken = []

    # --------------------------------------------------------------------
    # Collect each required primitive, respecting the needed count.
    # --------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            path = bfs_path(state.pos, prim_idx)
            if path is None:                # Primitive unreachable – abort.
                return actions_taken
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                actions_taken.append(a)
                if done:
                    return actions_taken
            # Pick up the primitive.
            reward, done, obs = env.step(USE)
            state = env._current_state
            actions_taken.append(USE)
            if done:
                return actions_taken

    # --------------------------------------------------------------------
    # Move to the appropriate workshop (if required) and craft the arrow.
    # --------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        path = bfs_to_workshop(state.pos, workshop_idx)
        if path is not None:
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                actions_taken.append(a)
                if done:
                    return actions_taken
        # Craft at the workshop.
        reward, done, obs = env.step(USE)
        state = env._current_state
        actions_taken.append(USE)
    else:
        # No specific workshop; attempt crafting in place.
        reward, done, obs = env.step(USE)
        state = env._current_state
        actions_taken.append(USE)

    return actions_taken

