    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    state = env._current_state
    pos = tuple(state.pos)          # (row, col)
    grid = state.grid.copy()        # occupancy tensor
    actions = []

    # indices of entities that block movement (cannot be entered)
    non_grab = list(env.world.non_grabbable_indices)

    # ------------------------------------------------------------------
    # Path‑finding: A* (Manhattan heuristic) avoiding non‑grabbable cells
    # ------------------------------------------------------------------
    from heapq import heappush, heappop

    def find_path(start, target):
        """Return a list of movement actions from *start* to *target* while
        avoiding cells that contain any non‑grabbable entity.
        Returns None if no path exists."""
        if start == target:
            return []

        width, height = grid.shape[:2]

        # Build a boolean mask of blocked cells
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # The target cell is allowed even if it would otherwise be blocked
        blocked[target[0], target[1]] = False

        # A* priority queue
        open_q = []
        heappush(open_q, (0 + abs(start[0] - target[0]) + abs(start[1] - target[1]), 0, start))
        came_from = {start: None}
        action_from = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while open_q:
            _, cost, cur = heappop(open_q)
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if blocked[nx, ny]:
                    continue
                nxt = (nx, ny)
                new_cost = cost + 1
                if nxt not in came_from:
                    came_from[nxt] = cur
                    action_from[nxt] = a
                    priority = new_cost + abs(nx - target[0]) + abs(ny - target[1])
                    heappush(open_q, (priority, new_cost, nxt))

        if target not in came_from:
            return None

        # Reconstruct action list
        rev_actions = []
        cur = target
        while cur != start:
            rev_actions.append(action_from[cur])
            cur = came_from[cur]
        rev_actions.reverse()
        return rev_actions

    # ------------------------------------------------------------------
    # 1. Collect all required primitives (may need multiple copies)
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Find all remaining instances of this primitive on the map
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more instances; abort collection of this primitive
                break

            # Choose the nearest instance by Manhattan distance (fast heuristic)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            path = find_path(pos, target)
            if path is None:
                # Fallback: direct Manhattan moves ignoring obstacles
                path = []
                dx, dy = target[0] - pos[0], target[1] - pos[1]
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1

            actions.extend(path)
            actions.append(USE)  # pick up the primitive

            # Update simulated position and clear the primitive from the grid copy
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            # Choose the nearest workshop
            target_ws = min(
                ws_locs,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = find_path(pos, target_ws)
            if path is None:
                # Fallback Manhattan moves
                path = []
                dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1

            actions.extend(path)
            actions.append(USE)   # craft at the workshop

    return actions


