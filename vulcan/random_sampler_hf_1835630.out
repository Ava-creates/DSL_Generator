    # --- helper functions -------------------------------------------------
    def _action_map():
        """Return dict mapping action names to integer codes."""
        return env.action_specs()

    def _blocked_cells(state):
        """Boolean array of shape (W, H) where True means the cell cannot be entered."""
        # any non‑grabbable entity present blocks movement
        non_grabbable = list(env.world.non_grabbable_indices)
        if not non_grabbable:
            return np.zeros(state.grid.shape[:2], dtype=bool)
        return np.any(state.grid[:, :, non_grabbable] > 0, axis=2)

    def _nearest_target(state, kind_idx):
        """Find the closest cell containing the given kind."""
        positions = np.argwhere(state.grid[:, :, kind_idx] > 0)
        if positions.size == 0:
            return None
        start = state.pos
        blocked = _blocked_cells(state)
        # BFS over positions
        visited = np.full(state.grid.shape[:2], False, dtype=bool)
        q = collections.deque()
        q.append((start[0], start[1], []))  # (x, y, path_of_positions)
        visited[start[0], start[1]] = True
        while q:
            x, y, path = q.popleft()
            # check if this cell holds the target
            if any((x == tx and y == ty) for tx, ty in positions):
                return path + [(x, y)]
            # explore neighbours
            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nx, ny = x + dx, y + dy
                if (0 <= nx < state.grid.shape[0] and
                    0 <= ny < state.grid.shape[1] and
                    not visited[nx, ny] and
                    not blocked[nx, ny]):
                    visited[nx, ny] = True
                    q.append((nx, ny, path + [(x, y)]))
        return None

    def _positions_to_actions(path):
        """Convert a list of positions [(x0,y0),(x1,y1),...] into a list of action ints."""
        act_map = _action_map()
        diff_to_act = {
            (0, -1): act_map['UP'],
            (0,  1): act_map['DOWN'],
            (-1, 0): act_map['LEFT'],
            (1,  0): act_map['RIGHT'],
        }
        actions = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            dx, dy = x1 - x0, y1 - y0
            actions.append(diff_to_act[(dx, dy)])
        return actions

    # --------------------------------------------------------------------
    # initialise environment
    env.reset()
    state = env._current_state

    # goal information
    goal_name = 'arrow'
    try:
        goal_idx = env.world.cookbook.index[goal_name]
    except Exception:
        raise ValueError(f"Goal '{goal_name}' not found in cookbook index.")

    # primitives required for the goal
    needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    action_sequence = []

    # --- collect each required primitive ---------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # locate nearest instance of this primitive
            target_path = _nearest_target(state, prim_idx)
            if target_path is None:
                raise RuntimeError(f"Could not locate primitive index {prim_idx} in the world.")
            # convert movement to actions (skip the first position which is current)
            move_actions = _positions_to_actions(target_path)
            for a in move_actions:
                reward, done, _ = env.step(a)
                action_sequence.append(a)
                state = env._current_state
            # finally use the item
            use_act = _action_map()['USE']
            reward, done, _ = env.step(use_act)
            action_sequence.append(use_act)
            state = env._current_state

    # --- go to the appropriate workshop (if any) -----------------------
    workshop_idx = None
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    if isinstance(recipe, dict):
        workshop_idx = recipe.get('_at')
    if workshop_idx is not None:
        target_path = _nearest_target(state, workshop_idx)
        if target_path is None:
            raise RuntimeError("Workshop for crafting not found or unreachable.")
        move_actions = _positions_to_actions(target_path)
        for a in move_actions:
            reward, done, _ = env.step(a)
            action_sequence.append(a)
            state = env._current_state
        # craft using the workshop
        use_act = _action_map()['USE']
        reward, done, _ = env.step(use_act)
        action_sequence.append(use_act)
        state = env._current_state
    else:
        # no specific workshop – just use the current cell to craft
        use_act = _action_map()['USE']
        reward, done, _ = env.step(use_act)
        action_sequence.append(use_act)
        state = env._current_state

    return action_sequence

