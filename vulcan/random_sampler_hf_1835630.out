    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    moves = [
        ((0, 1), DOWN),   # down  (y+1)
        ((0, -1), UP),    # up    (y-1)
        ((-1, 0), LEFT),  # left  (x-1)
        ((1, 0), RIGHT),  # right (x+1)
    ]

    def bfs_path(start, goal, grid):
        """Return a list of actions to move from start to goal using BFS.
        Cells containing any non‑zero kind are treated as blocked,
        except the goal cell itself (which may be occupied by the target item)."""
        from collections import deque
        w, h = grid.shape[0], grid.shape[1]  # width (x), height (y)
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}   # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal cell even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []  # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell (Manhattan) containing the given kind."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)   # y rows, x cols
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    # Determine current position (use live state if available)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Copy of the static grid for planning (so we can mark collected items)
    grid = env.scenario.init_grid.copy()

    actions = []

    # Goal item index
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Collect required primitive resources
    # ------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, count in primitive_needs.items():
        for _ in range(count):
            target = nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive not found; abort planning.
                return actions
            # Move to the primitive
            actions.extend(bfs_path(cur_pos, target, grid))
            # Pick it up
            actions.append(USE)
            # Mark it as collected in the planning grid
            grid[target[0], target[1], prim_kind] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Go to workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)  # craft at the workshop
            cur_pos = workshop_pos

    return actions


