    from collections import deque, namedtuple
    import heapq
    import numpy as np

    Node = namedtuple("Node", ["state", "actions", "g"])

    def state_hash(st):
        """Hash a state for visited‑set lookup."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    def manhattan(p1, p2):
        return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])

    def heuristic(st):
        """
        Simple admissible heuristic:
        distance to the closest missing primitive (if any are still needed).
        Returns 0 when all required primitives are already in inventory.
        """
        # Find which primitives we still lack
        missing = []
        for kind, need in required_primitives.items():
            have = st.inventory[kind]
            if have < need:
                missing.append((kind, need - have))

        if not missing:
            return 0  # all required primitives are in inventory; crafting can be done in place

        # Compute Manhattan distance to the nearest cell containing any missing primitive
        min_dist = None
        for kind, _ in missing:
            ys, xs = np.where(st.grid[:, :, kind] > 0)
            for y, x in zip(ys, xs):
                d = manhattan(st.pos, (x, y))
                if (min_dist is None) or (d < min_dist):
                    min_dist = d
        return min_dist if min_dist is not None else 0

    # A* search structures
    n_actions = getattr(world, "n_actions", 5)  # default action space size
    start_h = heuristic(init_state)
    frontier = [(start_h, 0, Node(init_state, [], 0))]  # (f = g+h, g, Node)
    visited = {state_hash(init_state): 0}  # map hash -> best g seen

    MAX_STEPS = 400  # safety cap on plan length

    while frontier:
        f, g, node = heapq.heappop(frontier)
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        if g >= MAX_STEPS:
            continue

        # Expand possible actions (typically 0‑4 where 4 == USE)
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            nxt_hash = state_hash(nxt_state)
            nxt_g = g + 1

            # If we have seen this state with a lower or equal cost, skip it
            if nxt_hash in visited and visited[nxt_hash] <= nxt_g:
                continue

            visited[nxt_hash] = nxt_g
            nxt_h = heuristic(nxt_state)
            heapq.heappush(frontier, (nxt_g + nxt_h, nxt_g, Node(nxt_state, node.actions + [a], nxt_g)))

    # No plan found within limits
    return []


    # ----------------------------------------------------------------------
    # Retrieve scenario and world objects from the provided environment.
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # ----------------------------------------------------------------------
    # Identify the index of the target item "arrow".
    # ----------------------------------------------------------------------
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Obtain the initial state of the episode.
    # ----------------------------------------------------------------------
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Bread‑first search over the state space to find a sequence of actions
    # that yields at least one "arrow" in the inventory.
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory contents, and full grid layout.
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 400                     # safety cap on plan length
    n_actions = getattr(world, "n_actions", 5)   # default action space size

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory.
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune paths that exceed the step limit.
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible primitive actions.
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If no plan was found within the search budget, return an empty list.
    return []

