    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of movement actions
    def bfs(start, goal_set):
        """Return a list of actions (0‑4) to reach any cell in goal_set."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goal_set:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat any occupied cell as blocked unless it is a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goal_set:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    # ----------------------------------------------------------------------
    # Helper: update simulated position according to a series of actions
    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:      # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1:    # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2:    # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3:    # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ----------------------------------------------------------------------
    # Primitive collection
    def collect_primitive(kind_idx, needed):
        """Collect `needed` units of primitive `kind_idx` from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate all cells that still contain the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, kind_idx] > 0]
            if not locations:
                break  # nothing left
            # find the first reachable primitive
            chosen_path = None
            chosen_loc = None
            for loc in locations:
                p = bfs(pos, {loc})
                if p is not None:
                    chosen_path = p
                    chosen_loc = loc
                    break
            if chosen_path is None:
                break  # unreachable
            actions.extend(chosen_path)
            move_along(chosen_path)
            actions.append(4)                     # USE
            grid[chosen_loc[0], chosen_loc[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    # ----------------------------------------------------------------------
    # Recursive crafting helper
    def ensure_item(item_idx, amount):
        """Guarantee at least `amount` of `item_idx` in inventory."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives:
                # primitive – just collect the missing amount
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # non‑primitive – craft using its recipe
            recipe = recipes.get(item_idx, {})
            # first ensure all ingredients are present
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to the required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                # pick a workshop and move adjacent to it
                for ws in ws_cells:
                    adj = [(ws[0] + dx, ws[1] + dy) for dx, dy in
                           ((0, 1), (0, -1), (-1, 0), (1, 0))]
                    reachable = [a for a in adj
                                 if 0 <= a[0] < width and 0 <= a[1] < height
                                 and not np.any(grid[a[0], a[1], :])]
                    if reachable:
                        p = bfs(pos, set(reachable))
                        if p is not None:
                            actions.extend(p)
                            move_along(p)
                        break

            # perform the crafting action
            actions.append(4)                     # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Main planning
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item – default to "arrow" if present, otherwise any craftable item
    target_name = "arrow"
    if target_name not in cookbook.index.contents:
        target_name = next(iter(cookbook.recipes))
    target_idx = cookbook.index[target_name]

    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape

    actions = []
    recipes = cookbook.recipes
    primitives = cookbook.primitives

    ensure_item(target_idx, 1)

    return actions


