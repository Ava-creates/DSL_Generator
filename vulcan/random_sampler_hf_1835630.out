    # implementation...


    # Retrieve the scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # Bread‑first search over the state space
    from collections import deque, namedtuple
    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        # Hash based on position, direction, inventory and full grid layout
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 300  # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)  # default to 5 actions (0‑4)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within limits
    return []

