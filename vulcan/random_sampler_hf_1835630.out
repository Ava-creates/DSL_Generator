    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions (0‑3) that brings
    # the agent to a position where the cell directly in front contains
    # `target_kind`. Returns None if unreachable.
    # ------------------------------------------------------------------
    def _bfs_to_target(st, target_kind):
        grid = st.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = st.pos
        sd = st.dir
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, path = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))
        return None

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            move_seq = _bfs_to_target(state, prim_idx)
            if move_seq is None:
                # Unreachable primitive – abort planning.
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up / interact

            # Simulate actions on internal state.
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(state, workshop_idx)
        if move_seq is None:
            # Unreachable workshop – abort planning.
            return actions
        actions.extend(move_seq)
        actions.append(4)  # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop; craft in place.
        actions.append(4)
        _, state = state.step(4)

    return actions

