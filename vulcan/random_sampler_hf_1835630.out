    import collections
    import numpy as np

    # Action indices as defined by CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions that moves the agent from
    # `start` to a cell adjacent (Manhattan distance ≤ 1) to any target.
    # Cells that contain any entity are treated as blocked.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, grid):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where a cell is non‑empty
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are adjacent (including same cell) to a target, stop.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Explore 4‑connected neighbours.
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable path.
        return []

    # ------------------------------------------------------------------
    # Helper: apply an action to a position, returning the new position.
    # ------------------------------------------------------------------
    def _apply_action(pos, act):
        if act == RIGHT:
            return (pos[0] + 1, pos[1])
        if act == LEFT:
            return (pos[0] - 1, pos[1])
        if act == DOWN:
            return (pos[0], pos[1] + 1)
        if act == UP:
            return (pos[0], pos[1] - 1)
        return pos

    # ------------------------------------------------------------------
    # Retrieve world and cookbook (may be wrapped differently).
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        wrapper_state = getattr(env, "_current_state", None)
        if wrapper_state is not None:
            world = wrapper_state.world
    if world is None:
        raise RuntimeError("World object not found in the environment")
    cookbook = world.cookbook

    # Goal is hard‑coded to "arrow".
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Ensure we have a current state; reset if necessary.
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)               # current (x, y)
    cur_grid = state.grid.copy()         # mutable copy for planning

    actions = []
    harvested = set()                    # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # All cells currently holding this primitive.
        locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Order by Manhattan distance from the current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], cur_grid)
            actions.extend(path)
            for act in path:
                pos = _apply_action(pos, act)
            # Pick it up.
            actions.append(USE)
            # Update planning grid: the primitive cell becomes empty.
            cur_grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or already an int).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else workshop_key)
        # Locate all workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop.
            path = _bfs_path(pos, [target_ws], cur_grid)
            actions.extend(path)
            for act in path:
                pos = _apply_action(pos, act)
            # Use the workshop to craft the arrow.
            actions.append(USE)
        else:
            # No workshop cell found – attempt to craft at current location.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    # Return the complete action list.
    return actions


    # --------------------------------------------------------------
    # Action constants – match the indices used by CraftWorld.
    # --------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # --------------------------------------------------------------
    # Helper: Bread‑first‑search returning a list of actions that moves
    # from `start` to any cell that is orthogonally adjacent to one of
    # the cells in `targets`.  Cells that contain any entity are treated
    # as blocked.
    # --------------------------------------------------------------
    def _bfs_path(start, targets, occ_mask):
        from collections import deque
        w, h = occ_mask.shape
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop when we are next to a target (Manhattan distance 1).
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand 4‑connected neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ_mask[nx, ny]:          # free cell
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable position – return empty list.
        return []

    # --------------------------------------------------------------
    # Helper: Update a (x, y) position according to an action.
    # --------------------------------------------------------------
    def _apply(pos, act):
        if act == RIGHT:
            return (pos[0] + 1, pos[1])
        if act == LEFT:
            return (pos[0] - 1, pos[1])
        if act == DOWN:
            return (pos[0], pos[1] + 1)
        if act == UP:
            return (pos[0], pos[1] - 1)
        return pos

    # --------------------------------------------------------------
    # Retrieve world, cookbook and the goal index (hard‑coded to “arrow”).
    # --------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state.
        state_wrap = getattr(env, "_current_state", None)
        if state_wrap is not None:
            world = state_wrap.world
    if world is None:
        raise RuntimeError("World object not found in the environment")
    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]

    # --------------------------------------------------------------
    # Determine which primitive items are required for the goal.
    # --------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # --------------------------------------------------------------
    # Ensure we have a fresh state (reset if necessary) and copy the grid.
    # --------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)                 # current (x, y)
    grid = state.grid.copy()               # mutable copy for planning
    occ = np.any(grid > 0, axis=2)         # occupied‑cell mask

    actions = []
    harvested = set()                      # cells already collected from

    # --------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # --------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # All locations that currently hold this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from the agent.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], occ)
            actions.extend(path)
            for act in path:
                pos = _apply(pos, act)
            # Pick it up.
            actions.append(USE)
            # Update planner's view of the world.
            occ[loc[0], loc[1]] = False
            grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # --------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # --------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve the workshop index (may be a name or already an int).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else workshop_key)
        # Locate all workshop cells.
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_cells:
            # Choose the nearest workshop.
            ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_path(pos, [target_ws], occ)
            actions.extend(path)
            for act in path:
                pos = _apply(pos, act)
            actions.append(USE)          # craft at the workshop
        else:
            # No workshop cell present – try to craft at current location.
            actions.append(USE)
    else:
        # Goal does not require a specific workshop.
        actions.append(USE)

    return actions

