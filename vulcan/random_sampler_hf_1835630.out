    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    deltas = {
        0: (0, 1),   # DOWN
        1: (0, -1),  # UP
        2: (-1, 0),  # LEFT
        3: (1, 0),   # RIGHT
    }

    def walkable(grid, x, y):
        """Return True if (x, y) is inside the grid and contains no entities."""
        W, H = grid.shape[:2]
        if not (0 <= x < W and 0 <= y < H):
            return False
        return not np.any(grid[x, y, :])

    from collections import deque

    def bfs_to_target(cur_state, target_kind):
        """
        Bread‑first search that returns a list of movement actions (0‑3)
        ending with the agent facing a cell that contains `target_kind`.
        Returns [] if already facing the target or if unreachable.
        """
        grid = cur_state.grid
        W, H = grid.shape[:2]
        sx, sy = cur_state.pos
        sdir = cur_state.dir
        queue = deque()
        queue.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while queue:
            x, y, d, acts = queue.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))
        return []

    def target_ahead(cur_state, kind):
        """True if the cell directly in front of the agent contains `kind`."""
        x, y = cur_state.pos
        d = cur_state.dir
        dx, dy = deltas[d]
        fx, fy = x + dx, y + dy
        W, H = cur_state.grid.shape[:2]
        return (0 <= fx < W and 0 <= fy < H and cur_state.grid[fx, fy, kind] > 0)

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []

    # 1) Gather all primitive resources needed for a single arrow
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = bfs_to_target(state, prim_idx)
            if not move_seq and not target_ahead(state, prim_idx):
                # Primitive unreachable – abort planning
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up / interact
            # Simulate actions to keep internal state up‑to‑date
            for a in move_seq + [4]:
                _, state = state.step(a)

    # 2) Craft the arrow at its required workshop (if any)
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(state, workshop_idx)
        if not move_seq and not target_ahead(state, workshop_idx):
            # Workshop unreachable – still attempt a USE (harmless)
            actions.append(4)
            _, state = state.step(4)
        else:
            actions.extend(move_seq)
            actions.append(4)  # USE to craft
            for a in move_seq + [4]:
                _, state = state.step(a)
    else:
        # No dedicated workshop – craft in place
        actions.append(4)
        _, state = state.step(4)

    return actions


