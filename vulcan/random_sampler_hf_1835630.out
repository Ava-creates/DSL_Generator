    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs_adjacent(start, targets, grid):
        """Bread‑first search returning actions that move the agent from ``start``
        to a cell adjacent (Manhattan distance 1) to any cell in ``targets`` while
        avoiding non‑grabbable obstacles."""
        W, H = grid.shape[:2]

        # Cells occupied by any non‑grabbable entity block movement.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Initialise mutable copies of the current state.
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy for simulation
    pos = tuple(state.pos)            # (x, y)

    # Goal index stored in the task (env.task.goal).
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive requirements for the goal (expanded recursively).
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ----------------------------------------------------------------------
    for kind_idx, cnt_needed in needed.items():
        while cnt_needed > 0:
            # Locate cells that currently contain this primitive.
            prim_cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if prim_cells.size == 0:
                # Primitive missing – abort planning.
                return plan

            # Move adjacent to the nearest reachable primitive.
            path = bfs_adjacent(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to keep ``pos`` in sync.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update simulated grid and decrement needed count.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt_needed -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the required workshop (if any) and craft the goal item.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or an integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size:
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(ACTION_USE)

    return plan


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (as defined by CraftLab)
    # ----------------------------------------------------------------------
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ----------------------------------------------------------------------
    # Bread‑first search that moves the agent to a cell adjacent to any
    # target cell while avoiding non‑grabbable obstacles.
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, targets, grid):
        """
        Parameters
        ----------
        start : tuple (x, y)
            Current agent position.
        targets : list of (x, y)
            Cells we want to become adjacent to.
        grid : np.ndarray (W, H, K)
            Current world grid.

        Returns
        -------
        list[int]
            Sequence of actions that brings the agent adjacent to a target.
            May be empty if already adjacent or if no path exists.
        """
        W, H = grid.shape[:2]

        # Build a blocked mask from all non‑grabbable entity kinds.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start

        # Quick check: already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Initialise mutable copies of the current environment state.
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy for planning
    pos = tuple(state.pos)            # (x, y)

    # Goal index is stored in the task (env.task.goal).
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # ----------------------------------------------------------------------
    # Determine primitive requirements for the goal (expanded recursively).
    # ----------------------------------------------------------------------
    needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ----------------------------------------------------------------------
    for kind_idx, cnt_needed in needed_prims.items():
        while cnt_needed > 0:
            # Find all cells currently containing this primitive.
            prim_cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present – abort planning.
                return plan

            # Move adjacent to the nearest reachable primitive.
            path = bfs_adjacent(pos, prim_cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to keep `pos` up‑to‑date.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected; stop to avoid infinite loop.
                break

            # Update simulated grid and decrement needed count.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt_needed -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the required workshop (if any) and craft the goal item.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (name → int or already int).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop.
            plan.append(ACTION_USE)
    else:
        # No specific workshop – simply use the current cell to craft.
        plan.append(ACTION_USE)

    return plan

