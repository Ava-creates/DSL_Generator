    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid.copy()
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    H, W = grid.shape[:2]
    non_grab = list(world.non_grabbable_indices)

    def bfs_path(start, goal):
        """Return list of movement actions from start to goal avoiding non‑grabbable cells."""
        from collections import deque
        if start == goal:
            return []
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                actions = []
                cur = goal
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        actions.append(DOWN)
                    elif py == cur[0] + 1:
                        actions.append(UP)
                    elif px == cur[1] - 1:
                        actions.append(RIGHT)
                    elif px == cur[1] + 1:
                        actions.append(LEFT)
                    cur = (py, px)
                return list(reversed(actions))
            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    if np.any(grid[ny, nx, non_grab] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing kind_idx."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        idx = int(np.argmin(dists))
        return tuple(locs[idx])

    # Goal information
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos

    # Collect required primitives
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on
            adj = None
            for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
                if 0 <= ny < H and 0 <= nx < W and not np.any(grid[ny, nx, non_grab] > 0):
                    adj = (ny, nx)
                    break
            if adj is None:
                adj = (ty, tx)

            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick it up
            actions.append(USE)
            grid[ty, tx, prim_idx] = 0

    # Move to workshop if required
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Craft the arrow
    actions.append(USE)
    return actions


