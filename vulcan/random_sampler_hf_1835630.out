        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(prim_idx, amount):
