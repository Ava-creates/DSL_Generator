    import numpy as np
    from collections import deque

    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    def bfs(start, goals):
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:      # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1:    # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2:    # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3:    # RIGHT
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(kind_idx, needed):
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, kind_idx] > 0]
            if not locations:
                break
            path = None
            target_loc = None
            for loc in locations:
                cand = bfs(pos, {loc})
                if cand is not None:
                    path = cand
                    target_loc = loc
                    break
            if path is None:
                break
            actions.extend(path)
            move_along(path)
            actions.append(4)                     # USE
            grid[target_loc[0], target_loc[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives_set:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            actions.append(4)                     # USE (craft)
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    ensure_item(target_idx, 1)
    return actions


    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Identify target item (arrow)
    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # Local mutable copies of the environment state
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    # ------------------------------------------------------------------
    # BFS path finder: returns list of movement actions to reach any goal cell
    def bfs(start, goals):
        """Find shortest path (as action list) from start to any cell in goals."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat any occupied cell as blocked unless it's a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    # ------------------------------------------------------------------
    # Update simulated position according to movement actions
    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ------------------------------------------------------------------
    # Primitive collection routine
    def collect_primitive(kind_idx, needed):
        """Collect *needed* units of primitive *kind_idx* from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate all remaining cells containing the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, kind_idx] > 0]
            if not locations:
                break  # no more of this primitive available
            # find first reachable primitive cell
            chosen_path = None
            chosen_loc = None
            for loc in locations:
                p = bfs(pos, {loc})
                if p is not None:
                    chosen_path = p
                    chosen_loc = loc
                    break
            if chosen_path is None:
                break  # cannot reach any remaining primitive
            # move to it and pick up
            actions.extend(chosen_path)
            move_along(chosen_path)
            actions.append(4)                     # USE
            grid[chosen_loc[0], chosen_loc[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    # ------------------------------------------------------------------
    # Recursive crafting helper
    recipes = cookbook.recipes
    primitive_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        """Guarantee that inventory[item_idx] >= amount by collecting/crafting."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitive_set:
                # primitive: collect the missing amount
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # need to craft the item using its recipe
            recipe = recipes.get(item_idx, {})
            # first ensure all ingredient quantities are present
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to the required workshop, if any
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # perform the craft action
            actions.append(4)                     # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions

