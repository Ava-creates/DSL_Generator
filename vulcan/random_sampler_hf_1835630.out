    # Reset the environment and initialise helpers
    env.reset()
    actions = []
    act_map = env.action_specs()
    move_delta = {
        "UP": (-1, 0),
        "DOWN": (1, 0),
        "LEFT": (0, -1),
        "RIGHT": (0, 1),
    }

    from collections import deque

    # ------------------------------------------------------------------
    # Bread‑first search that returns a list of *action names* moving the
    # agent from `start` to any cell that is adjacent (including diagonally)
    # to one of the cells in `targets`.  It walks only through empty cells.
    # ------------------------------------------------------------------
    def bfs_adjacent(start, targets, grid):
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # If we are adjacent (Chebyshev distance ≤ 1) to any target, stop.
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # Expand neighbours.
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # Walk only through empty cells (no entity present).
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell.

    # ------------------------------------------------------------------
    # Goal information.
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at', None)

    # ------------------------------------------------------------------
    # 1) Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Locate all cells that currently contain the primitive.
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Primitive unavailable – skip this instance.
                continue

            path = bfs_adjacent(pos, prim_cells, grid)
            if path is None:
                # Unreachable – skip.
                continue

            # Execute the movement actions.
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # Pick up the primitive.
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the goal item.
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # Craft the item at the workshop.
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # Return the full action list.
    return actions


