    import collections
    import numpy as np

    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )

    goal = env.task.goal
    needed_prims = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    state = env._current_state
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # mutable copy of occupancy
    inventory = state.inventory.copy()         # mutable copy of inventory
    actions = []

    def bfs(start, target):
        """Return a list of movement actions from start to target avoiding non‑grabbable entities."""
        w, h = grid.shape[:2]
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((w, h), dtype=bool)
        blocked[target[0], target[1]] = False  # allow stepping onto target

        q = collections.deque([start])
        parent = {start: None}
        act_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for act, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in parent:
                        parent[nxt] = cur
                        act_to[nxt] = act
                        q.append(nxt)

        if target not in parent:
            return None

        path = []
        cur = target
        while cur != start:
            path.append(act_to[cur])
            cur = parent[cur]
        path.reverse()
        return path

    def move_to(target):
        """Move simulated agent to *target*, updating pos and actions."""
        nonlocal pos
        if pos == target:
            return
        path = bfs(pos, target)
        if path is None:
            # Fallback: Manhattan moves ignoring obstacles
            dx, dy = target[0] - pos[0], target[1] - pos[1]
            path = []
            while dx > 0:
                path.append(DOWN); dx -= 1
            while dx < 0:
                path.append(UP); dx += 1
            while dy > 0:
                path.append(RIGHT); dy -= 1
            while dy < 0:
                path.append(LEFT); dy += 1
        actions.extend(path)
        pos = target

    # -----------------------------------------------------------------
    # Collect required primitives (taking current inventory into account)
    # -----------------------------------------------------------------
    for prim_idx, req_cnt in needed_prims.items():
        have = int(inventory[prim_idx])
        need = max(0, req_cnt - have)

        for _ in range(need):
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                break  # no more instances on the map

            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            move_to(target)
            actions.append(USE)  # pick up

            grid[target[0], target[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # -----------------------------------------------------------------
    # Move to workshop (if required) and craft the goal item
    # -----------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locations:
            target_ws = min(
                ws_locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            move_to(target_ws)
            actions.append(USE)  # craft at workshop

    return actions


