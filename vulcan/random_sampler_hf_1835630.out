    import numpy as np
    import collections

    # Action indices (consistent with CraftWorld defaults)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions that moves from ``start`` to a cell
        adjacent (Manhattan distance 1) to any cell in ``targets`` while
        avoiding occupied cells.
        """
        width, height = occupied.shape
        target_set = set(targets)

        # If already adjacent, no movement needed.
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        queue = collections.deque()
        queue.append((start[0], start[1], []))
        visited = {start}

        while queue:
            x, y, path = queue.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                # Check adjacency to any target.
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                queue.append((nx, ny, new_path))
        # If no reachable adjacent cell, return empty list.
        return []

    # ------------------------------------------------------------------
    # Retrieve the underlying world and current state from the (possibly
    # wrapped) environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # env might be a CraftLab wrapper.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        # env is likely a raw CraftWorld.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    need_collection = bool(primitives_needed)

    # ------------------------------------------------------------------
    # Initial grid, position and occupancy mask.
    # ------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # Cells already collected from

    # ------------------------------------------------------------------
    # Collect required primitives (greedy nearest‑first).
    # ------------------------------------------------------------------
    if need_collection:
        for prim_idx, needed_cnt in primitives_needed.items():
            gathered = 0
            while gathered < needed_cnt:
                # Find all cells that still contain this primitive.
                candidates = [
                    tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                    if tuple(p) not in harvested
                ]
                if not candidates:
                    # No more of this primitive left on the map.
                    break

                # Choose the closest candidate (Manhattan distance).
                candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
                target = candidates[0]

                # Plan a path to a cell adjacent to the target.
                path = _bfs_adjacent(pos, [target], occupied)
                actions.extend(path)

                # Simulate movement to update ``pos``.
                for a in path:
                    dx, dy = MOVE_DELTAS[a]
                    pos = (pos[0] + dx, pos[1] + dy)

                # Use (pick up) the primitive.
                actions.append(USE)
                harvested.add(target)
                gathered += 1

                # Update occupancy: the cell becomes empty after pickup.
                occupied[target] = False
                grid[:, :, prim_idx][target] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Choose nearest workshop.
            workshop_cells.sort(
                key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])
            )
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)  # craft at workshop
        else:
            # No workshop found; attempt to craft at current location.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    import collections
    import numpy as np

    # ------------------------------------------------------------------
    # Action constants (match CraftWorld defaults)
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that stops when we reach a cell adjacent to any target
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions moving from `start` to a cell adjacent to any
        coordinate in `targets`.  `occupied` is a 2‑D bool array where True means
        the cell cannot be entered."""
        width, height = occupied.shape
        target_set = set(targets)

        # If already adjacent, no movement needed.
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        # No reachable adjacent cell (should not happen in well‑formed maps)
        return []

    # ------------------------------------------------------------------
    # Retrieve the underlying world and current state from the env.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Likely a CraftLab wrapper.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ------------------------------------------------------------------
    # Determine which primitive items are needed for a single arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    need_collection = bool(primitives_needed)

    # ------------------------------------------------------------------
    # Snapshot of the current grid, position and occupancy mask.
    # ------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # Cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    if need_collection:
        for prim_idx, required_cnt in primitives_needed.items():
            gathered = 0
            while gathered < required_cnt:
                # Find all remaining cells containing this primitive.
                candidates = [
                    tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                    if tuple(p) not in harvested
                ]
                if not candidates:
                    # No more instances left on the map – give up early.
                    break

                # Choose the closest candidate (Manhattan distance).
                candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
                target = candidates[0]

                # Plan a path to a cell adjacent to the target.
                path = _bfs_adjacent(pos, [target], occupied)
                actions.extend(path)

                # Simulate the movement to update `pos`.
                for act in path:
                    dx, dy = MOVE_DELTAS[act]
                    pos = (pos[0] + dx, pos[1] + dy)

                # Pick up the primitive.
                actions.append(USE)
                harvested.add(target)
                gathered += 1

                # Update occupancy – the cell becomes empty after collection.
                occupied[target] = False

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name or already an int).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Pick the nearest workshop.
            workshop_cells.sort(
                key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])
            )
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)  # craft at workshop
        else:
            # No workshop present – just attempt to use current cell.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions

