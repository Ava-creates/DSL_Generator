    # Constants for actions
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _path(src, dst):
        """Manhattan path from src to dst as a list of actions."""
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    def _nearest(grid, kind_idx, start):
        """Find nearest cell (Manhattan) containing the given kind."""
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    def _any(grid, kind_idx):
        """Return any cell containing the given kind (used for workshops)."""
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ----------------------------------------------------------------------
    # Action execution wrappers that record actions
    # ----------------------------------------------------------------------
    action_seq = []

    def _step(action):
        """Execute an action, record it, and update the local state."""
        nonlocal state
        reward, done, obs = env.step(action)
        state = env._current_state
        action_seq.append(action)
        return reward, done, obs

    def _move_to(target):
        """Move from current position to target cell using Manhattan steps."""
        for a in _path(state.pos, target):
            _, done, _ = _step(a)
            if done:
                return True
        return False

    def _use():
        """Perform USE action."""
        _, done, _ = _step(USE)
        return done

    # ----------------------------------------------------------------------
    # Initialise environment and retrieve world information
    # ----------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # Index for the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []  # Arrow not defined in the recipe set

    # ----------------------------------------------------------------------
    # Recursive acquisition / crafting routine
    # ----------------------------------------------------------------------
    primitives_set = world.cookbook.primitives

    def _ensure(item_idx, needed):
        """Make sure the inventory contains at least `needed` of `item_idx`."""
        while state.inventory[item_idx] < needed:
            # Primitive handling: just collect from the map
            if item_idx in primitives_set:
                target = _nearest(state.grid, item_idx, state.pos)
                if target is None:
                    # Primitive not present – cannot continue
                    return False
                _move_to(target)
                _use()
                continue

            # Non‑primitive: need to craft it using its recipe
            recipe = world.cookbook.recipes.get(item_idx, {})
            # First, gather all ingredient items
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                # Ensure we have enough of each ingredient
                if not _ensure(ing_idx, cnt):
                    return False

            # Move to the required workshop (if any) before crafting
            workshop_name = recipe.get("_at", None)
            if workshop_name is not None:
                workshop_idx = world.cookbook.index.index(workshop_name)
                workshop_pos = _any(state.grid, workshop_idx)
                if workshop_pos is not None:
                    _move_to(workshop_pos)

            # Craft the item
            _use()
        return True

    # ----------------------------------------------------------------------
    # Execute the plan to obtain a single arrow
    # ----------------------------------------------------------------------
    _ensure(arrow_idx, 1)

    return action_seq


    # Action constants (match CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # --------------------------------------------------------------
    # Helper: BFS shortest path avoiding non‑grabbable entities
    # --------------------------------------------------------------
    def _bfs_path(src, dst, grid):
        h, w, _ = grid.shape
        blocked = env.world.non_grabbable_indices
        # a cell is blocked if any non‑grabbable kind is present (>0)
        def is_free(r, c):
            if not (0 <= r < h and 0 <= c < w):
                return False
            return not any(grid[r, c, k] > 0 for k in blocked)

        from collections import deque
        q = deque()
        q.append(src)
        visited = {src: None}
        while q:
            r, c = q.popleft()
            if (r, c) == dst:
                break
            for dr, dc, act in DIRS:
                nr, nc = r + dr, c + dc
                if (nr, nc) not in visited and is_free(nr, nc):
                    visited[(nr, nc)] = (r, c, act)
                    q.append((nr, nc))
        # reconstruct actions
        if dst not in visited:
            return []  # no path found
        actions = []
        cur = dst
        while visited[cur] is not None:
            pr, pc, act = visited[cur]
            actions.append(act)
            cur = (pr, pc)
        actions.reverse()
        return actions

    # --------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind (Manhattan)
    # --------------------------------------------------------------
    def _nearest(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # --------------------------------------------------------------
    # Helper: locate any cell containing a given kind (used for workshops)
    # --------------------------------------------------------------
    def _any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # --------------------------------------------------------------
    # Initialise episode
    # --------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # --------------------------------------------------------------
    # Identify goal index for "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # arrow not defined in recipes
        return []

    # --------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # --------------------------------------------------------------
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # --------------------------------------------------------------
    # Collect required primitives (respecting counts)
    # --------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = _nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # primitive missing – abort early
                return action_seq
            # Move to the primitive cell using BFS path
            for a in _bfs_path(state.pos, target, state.grid):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick up the primitive
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # --------------------------------------------------------------
    # Craft the arrow (possibly at a workshop)
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _bfs_path(state.pos, workshop_pos, state.grid):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Perform crafting at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
    else:
        # No specific workshop – craft in place
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq

