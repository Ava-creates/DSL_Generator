            goal_idx = world.cookbook.index["arrow"]
        except Exception as e:
            raise RuntimeError("Unable to locate goal index for 'arrow'") from e

    # ------------------------------------------------------------------
    # Find the primitive resources required for the goal (expanded to raw
    # resources).  The cookbook already returns a dict mapping primitive
    # kind indices to the quantity needed for a single instance.
    # ------------------------------------------------------------------
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Helper: move from the current position to a target cell using
    # Manhattan moves.  The function updates cur_pos and appends the
    # appropriate actions to the action list.
    # ------------------------------------------------------------------
    cur_pos = tuple(state.pos)
    actions = []

    def _move_to(target):
        nonlocal cur_pos
        tx, ty = target
        # move in x direction
        while cur_pos[0] < tx:
            actions.append(RIGHT)
            cur_pos = (cur_pos[0] + 1, cur_pos[1])
        while cur_pos[0] > tx:
            actions.append(LEFT)
            cur_pos = (cur_pos[0] - 1, cur_pos[1])
        # move in y direction
        while cur_pos[1] < ty:
            actions.append(DOWN)
            cur_pos = (cur_pos[0], cur_pos[1] + 1)
        while cur_pos[1] > ty:
            actions.append(UP)
            cur_pos = (cur_pos[0], cur_pos[1] - 1)

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        # Find all cells that currently contain this primitive.
        locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
        if locations.size == 0:
            # Primitive not present on the map – cannot collect it.
            # In a well‑formed scenario this should not happen.
            continue
        # Choose the first occurrence as the target.
        target = tuple(locations[0])
        _move_to(target)
        # Pick up the required amount (one USE per unit).
        for _ in range(needed):
            actions.append(USE)

    # ------------------------------------------------------------------
    # Locate the workshop (if any) where the final crafting must happen.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    # The workshop can be stored under "_key" or "_at" according to the
    # schema described in the prompt.
    workshop_name = recipe.get("_key") or recipe.get("_at")
    if workshop_name is not None:
        # Convert workshop name to its index in the global kind dictionary.
        workshop_idx = (
            world.cookbook.index.get(workshop_name)
            if isinstance(workshop_name, str)
            else workshop_name
        )
        if workshop_idx is not None:
            ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
            if ws_locs.size > 0:
                ws_pos = tuple(ws_locs[0])
                _move_to(ws_pos)

    # ------------------------------------------------------------------
    # Finally, use the workshop (or the current cell) to craft the arrow.
    # ------------------------------------------------------------------
    actions.append(USE)

    return actions

