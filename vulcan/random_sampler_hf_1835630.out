    # reset environment and get handles
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = np.copy(state.grid)          # mutable copy of the grid

    # action constants (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(pos):
        """Return True if any entity occupies the cell at `pos`."""
        y, x = pos
        return np.any(grid[y, x, :] > 0)

    def bfs_path(start, goal):
        """Shortest path from start to goal avoiding blocked cells.
        Returns a list of positions (including start and goal) or None."""
        if start == goal:
            return [start]
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = collections.deque([start])
        visited[start] = True
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx] and not is_blocked((ny, nx)):
                    visited[ny, nx] = True
                    prev[(ny, nx)] = cur
                    q.append((ny, nx))
        else:
            return None  # unreachable

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(prev[path[-1]])
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions to a list of movement actions."""
        acts = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            if y1 == y0 + 1:
                acts.append(DOWN)
            elif y1 == y0 - 1:
                acts.append(UP)
            elif x1 == x0 + 1:
                acts.append(RIGHT)
            elif x1 == x0 - 1:
                acts.append(LEFT)
        return acts

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell that currently contains `kind_idx`."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a free orthogonal neighbour of `cell` (or None)."""
        y, x = cell
        for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked((ny, nx)):
                return (ny, nx)
        return None

    def face_towards(src, dst):
        """Return a single movement action that makes `src` face `dst`."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early
                return actions

            stand = free_adjacent(target) or target
            path = bfs_path(cur_pos, stand)
            if path is None:
                return actions
            actions += path_to_actions(path)
            cur_pos = stand

            turn = face_towards(cur_pos, target)
            if turn is not None:
                actions.append(turn)

            actions.append(USE)   # pick up the primitive

            # update internal grid copy
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            path = bfs_path(cur_pos, ws_cell)
            if path is not None:
                actions += path_to_actions(path)
                cur_pos = ws_cell

    # final USE triggers crafting
    actions.append(USE)

    return actions


    # Reset environment and fetch current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = np.copy(state.grid)           # (WIDTH, HEIGHT, n_kinds)

    # Action constants (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_walkable(pos):
        """Return True if the agent can occupy `pos` (i.e., not blocked by any
        non‑workshop entity)."""
        y, x = pos
        # Any kind present at the cell?
        present = np.where(grid[y, x, :] > 0)[0]
        if present.size == 0:
            return True
        # If every present kind is a workshop, the cell is walkable.
        for k in present:
            if k not in world.workshop_indices:
                return False
        return True

    def bfs_path(start, goal):
        """Breadth‑first search returning a list of positions from `start`
        to `goal` (inclusive). Returns None if no path exists."""
        if start == goal:
            return [start]
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = collections.deque()
        q.append(start)
        visited[start] = True
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    if is_walkable((ny, nx)):
                        visited[ny, nx] = True
                        prev[(ny, nx)] = cur
                        q.append((ny, nx))
        else:
            return None  # goal not reached

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(prev[path[-1]])
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions (including start) to a list of action
        indices that move the agent along the path."""
        acts = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            if y1 == y0 + 1:
                acts.append(DOWN)
            elif y1 == y0 - 1:
                acts.append(UP)
            elif x1 == x0 + 1:
                acts.append(RIGHT)
            elif x1 == x0 - 1:
                acts.append(LEFT)
        return acts

    def find_nearest(kind_idx, from_pos):
        """Return coordinates of the nearest cell containing `kind_idx`."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a walkable orthogonal neighbour of `cell`. If none exists,
        return None."""
        y, x = cell
        for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if is_walkable((ny, nx)):
                    return (ny, nx)
        return None

    def direction_to(src, dst):
        """Return the action that makes the agent at `src` face `dst`
        (one step away)."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on.
            stand = free_adjacent(target)
            if stand is None:
                # No free neighbour; cannot pick up this primitive.
                return actions

            # Move to the standing cell.
            path = bfs_path(cur_pos, stand)
            if path is None:
                return actions
            actions += path_to_actions(path)
            cur_pos = stand

            # Face the primitive and pick it up.
            turn = direction_to(cur_pos, target)
            if turn is not None:
                actions.append(turn)
            actions.append(USE)

            # Update internal grid copy to reflect collection.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            path = bfs_path(cur_pos, ws_cell)
            if path is not None:
                actions += path_to_actions(path)
                cur_pos = ws_cell

    # Final USE to trigger crafting
    actions.append(USE)

    return actions

