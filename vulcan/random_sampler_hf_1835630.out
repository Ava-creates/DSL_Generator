                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # Only walk through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    actions = []

    # ----------------------------------------------------------------------
    # 1) Collect each required primitive the needed number of times
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
