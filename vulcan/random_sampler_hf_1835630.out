    # reset environment and get initial references
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # arrow not defined in this world
        return []

    actions = []

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # brings the agent to a position where the cell directly in front
    # contains `target_kind`. Returns None if target unreachable.
    # --------------------------------------------------------------
    deltas = {0: (0, 1),   # DOWN
              1: (0, -1),  # UP
              2: (-1, 0),  # LEFT
              3: (1, 0)}   # RIGHT

    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = cur_state.pos
        sdir = cur_state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, act_seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return act_seq

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, act_seq + [a]))
        return None

    # --------------------------------------------------------------
    # Recursive collector: ensures one unit of `item_idx` ends up in
    # the inventory (or on the ground ready to be picked up). Handles
    # both primitive gathering and crafting of intermediate items.
    # --------------------------------------------------------------
    primitives_set = world.cookbook.primitives

    def _ensure_item(item_idx):
        """Collect or craft a single unit of `item_idx`."""
        # If we already have it in inventory, nothing to do.
        if state.inventory[item_idx] > 0:
            return

        # Primitive items are directly pick‑upable from the world.
        if item_idx in primitives_set:
            move_seq = _bfs_to_target(state, item_idx)
            if move_seq is None:
                raise RuntimeError(f"Cannot reach primitive {item_idx}")
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            for a in move_seq + [4]:
                _, new_state = state.step(a)
                nonlocal state
                state = new_state
            return

        # Otherwise we need to craft it using its recipe.
        recipe = world.cookbook.recipes.get(item_idx, {})
        # Gather all required ingredients first.
        for ing_idx, cnt in recipe.items():
            if ing_idx == "_at":
                continue
            for _ in range(cnt):
                _ensure_item(ing_idx)

        # Move to the appropriate workshop (if any) and craft.
        workshop_name = recipe.get('_at')
        if workshop_name is not None:
            wk_idx = world.cookbook.index.index(workshop_name)
            move_seq = _bfs_to_target(state, wk_idx)
            if move_seq is None:
                raise RuntimeError(f"Cannot reach workshop {workshop_name}")
            actions.extend(move_seq)
            actions.append(4)  # USE to craft
            for a in move_seq + [4]:
                _, new_state = state.step(a)
                nonlocal state
                state = new_state
        else:
            # No specific workshop; just use the current cell.
            actions.append(4)
            _, new_state = state.step(4)
            nonlocal state
            state = new_state

    # --------------------------------------------------------------
    # Ensure we have (and thus craft) one arrow.
    # --------------------------------------------------------------
    try:
        _ensure_item(arrow_idx)
    except RuntimeError:
        # Planning failed – return whatever actions have been built so far.
        return actions

    return actions


    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:                   # arrow not defined in this world
        return []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that brings
    # the agent to a cell whose *front* contains `target_kind`. Returns
    # None if the target cannot be reached.
    # ------------------------------------------------------------------
    deltas = {0: (0, 1),   # DOWN
              1: (0, -1),  # UP
              2: (-1, 0),  # LEFT
              3: (1, 0)}   # RIGHT

    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = cur_state.pos
        sdir = cur_state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:                         # arrow itself is primitive
        needed = {arrow_idx: 1}

    plan = []

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            move_seq = _bfs_to_target(state, prim_idx)
            if move_seq is None:          # unreachable primitive → abort planning
                return plan
            plan.extend(move_seq)
            plan.append(4)                # USE to pick up
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(state, workshop_idx)
        if move_seq is None:              # unreachable workshop → abort
            return plan
        plan.extend(move_seq)
        plan.append(4)                    # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        plan.append(4)                    # USE to craft in place
        _, state = state.step(4)

    return plan

