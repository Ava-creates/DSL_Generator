    # Reset environment and get initial state references
    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify goal index for "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # arrow not defined in this world
        return []

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # positions the agent so that the cell directly in front contains
    # `target_kind`. Returns [] if unreachable.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        import numpy as np
        from collections import deque

        grid = state.grid
        W, H = grid.shape[:2]

        # direction deltas matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sd = state.dir
        q = deque()
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return []  # unreachable

    actions = []

    # --------------------------------------------------------------
    # 1) Collect required primitives for a single arrow.
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            # If we cannot move but are already adjacent, still allow a USE.
            if not move_seq and not cur_state.next_to(prim_idx):
                # Primitive unreachable – abort planning.
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            # Keep state in sync.
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # 2) Craft the arrow at its required workshop (if any).
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        actions.extend(move_seq)
        actions.append(4)  # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – attempt crafting in place.
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions


    # Reset the environment and get the current state and world objects
    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:       # arrow not defined in this world
        return []

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # brings the agent to a position where the cell directly in front
    # contains `target_kind`. Returns [] if the target is already in
    # front, or [] if unreachable (handled later).
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # direction deltas matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        start_x, start_y = state.pos
        start_dir = state.dir

        from collections import deque
        q = deque()
        q.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return []   # unreachable

    # --------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    plan_actions = []

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # --------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            # If BFS failed and we are not already facing the primitive, abort.
            if not move_seq:
                # Check whether the cell in front already holds the primitive.
                dir_dx, dir_dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[cur_state.dir]
                fx, fy = cur_state.pos[0] + dir_dx, cur_state.pos[1] + dir_dy
                if not (0 <= fx < cur_state.grid.shape[0] and
                        0 <= fy < cur_state.grid.shape[1] and
                        cur_state.grid[fx, fy, prim_idx] > 0):
                    return plan_actions   # unreachable primitive
            plan_actions.extend(move_seq)
            plan_actions.append(4)   # USE to pick up

            # Apply actions to keep cur_state up‑to‑date.
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        plan_actions.extend(move_seq)
        plan_actions.append(4)   # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – attempt crafting in place.
        plan_actions.append(4)   # USE to craft
        _, cur_state = cur_state.step(4)

    return plan_actions

