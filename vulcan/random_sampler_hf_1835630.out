    # Reset environment and fetch useful objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                    # (WIDTH, HEIGHT, n_kinds)

    # Action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    ACTIONS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_free(y, x):
        """Return True if the cell (y,x) does not contain any non‑grabbable entity."""
        if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):
            return False
        return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def free_adjacent(cell):
        """Return a free orthogonal neighbour of `cell` (or None if none)."""
        y, x = cell
        for dy, dx, _ in ACTIONS:
            ny, nx = y + dy, x + dx
            if is_free(ny, nx):
                return (ny, nx)
        return None

    def bfs_path(start, goal):
        """Shortest path (list of actions) from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return []
        from collections import deque
        queue = deque([start])
        visited = {start: None}
        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            cy, cx = cur
            for dy, dx, act in ACTIONS:
                ny, nx = cy + dy, cx + dx
                if not is_free(ny, nx):
                    continue
                nxt = (ny, nx)
                if nxt not in visited:
                    visited[nxt] = (cur, act)
                    queue.append(nxt)
        else:
            # No path found
            return []

        # reconstruct actions
        path_actions = []
        node = goal
        while visited[node] is not None:
            prev, act = visited[node]
            path_actions.append(act)
            node = prev
        path_actions.reverse()
        return path_actions

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def direction_action(src, dst):
        """Return the action that would make the agent at src face dst (one step)."""
        dy, dx = dst[0] - src[0], dst[1] - src[1]
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Choose a free adjacent cell to stand on (prefer one, else stay on target)
            adj = free_adjacent(target) or target

            # Move to the chosen cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (optional turn)
            turn = direction_action(cur_pos, target)
            if turn is not None:
                actions.append(turn)

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if recipe specifies one) and craft the goal
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            # Stand on a free neighbour of the workshop
            ws_adj = free_adjacent(ws_cell) or ws_cell
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

    # Final USE to trigger crafting of the arrow
    actions.append(USE)

    return actions


    # Reset environment and fetch current state/world information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # Action constants (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(pos):
        """Return True if a non‑grabbable entity occupies the cell."""
        y, x = pos
        return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs_path(start, goal):
        """Find a shortest path (list of positions) from start to goal
        avoiding blocked cells. Returns None if no path exists."""
        if start == goal:
            return [start]
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = dict()
        q = collections.deque()
        q.append(start)
        visited[start] = True
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx] and not is_blocked((ny, nx)):
                    visited[ny, nx] = True
                    prev[(ny, nx)] = cur
                    q.append((ny, nx))
        else:
            return None  # goal not reached

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(prev[path[-1]])
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions (including start) to action indices."""
        actions = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            if y1 == y0 + 1:
                actions.append(DOWN)
            elif y1 == y0 - 1:
                actions.append(UP)
            elif x1 == x0 + 1:
                actions.append(RIGHT)
            elif x1 == x0 - 1:
                actions.append(LEFT)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a free orthogonal neighbour of `cell`, or None."""
        y, x = cell
        for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked((ny, nx)):
                return (ny, nx)
        return None

    def face_towards(src, dst):
        """Append a single movement action that makes the agent at src face dst."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on; if none, stand on the primitive cell itself.
            stand = free_adjacent(target) or target

            # Compute path to the standing cell.
            path = bfs_path(cur_pos, stand)
            if path is None:
                # No viable path – abort.
                return actions
            actions += path_to_actions(path)
            cur_pos = stand

            # Face the primitive (optional but helps USE)
            turn = face_towards(cur_pos, target)
            if turn is not None:
                actions.append(turn)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            path = bfs_path(cur_pos, ws_cell)
            if path is not None:
                actions += path_to_actions(path)
                cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions

