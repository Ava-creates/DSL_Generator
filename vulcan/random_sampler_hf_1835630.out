    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory contents, and full grid bytes.
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

