    import collections, numpy as np

    # Action indices (match CraftWorld definitions)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # BFS that returns a list of actions moving the agent from `start`
    # to a cell adjacent (Manhattan distance ≤ 1) to any cell in `targets`.
    # `occ` is a boolean 2‑D array where True marks a blocked cell.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # Unreachable – return empty path.
        return []

    # ------------------------------------------------------------------
    # Retrieve world, cookbook and a current state (reset if needed).
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state.
        tmp_state = getattr(env, "_current_state", None)
        if tmp_state is not None:
            world = getattr(tmp_state, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate the world object in the environment.")
    cookbook = world.cookbook

    # Ensure we have a valid state.
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal is the primitive “arrow”.
    # ------------------------------------------------------------------
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Current position and a mutable copy of the grid.
    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()              # (W, H, n_kinds)

    # Occupancy mask – any non‑empty cell blocks movement.
    occupied = np.any(grid > 0, axis=2)

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # All cells containing this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Greedy nearest‑first ordering.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            # Find a path to a cell adjacent to the primitive.
            path = _bfs_path(pos, [loc], occupied)
            actions.extend(path)
            # Simulate movement to update `pos`.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Mark the cell as free for subsequent planning.
            occupied[loc[0], loc[1]] = False
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (name → int or already int).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else workshop_key)
        # Locate all workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            path = _bfs_path(pos, [target_ws], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use the workshop to craft the arrow.
            actions.append(USE)

    return actions


    import collections
    import numpy as np

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs(start, targets, occ):
        """Return list of actions moving from start to a cell adjacent to any target."""
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # unreachable

    # locate world and cookbook
    world = getattr(env, "world", None)
    if world is None:
        state_wrap = getattr(env, "_current_state", None)
        if state_wrap is not None:
            world = getattr(state_wrap, "world", None)
    if world is None:
        raise RuntimeError("World object not found in environment")
    cookbook = world.cookbook

    # ensure we have a current state
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    goal_idx = cookbook.index["arrow"]
    needed_prims = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    pos = tuple(state.pos)
    grid = state.grid.copy()
    occ = np.any(grid > 0, axis=2)

    actions = []
    visited_cells = set()

    # collect primitives
    for prim_idx, count in needed_prims.items():
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= count:
                break
            if loc in visited_cells:
                continue
            path = _bfs(pos, [loc], occ)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
            occ[loc[0], loc[1]] = False
            visited_cells.add(loc)
            collected += 1

    # craft at workshop if required
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs(pos, [target_ws], occ)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)

    return actions

