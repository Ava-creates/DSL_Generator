    # ------------------------------------------------------------------
    # 3. Helper functions for navigation and interaction
    # ------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    ACTION_USE = 4

    def bfs(start, targets):
        """Return a list of actions to reach the nearest cell in `targets`."""
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []   # should not happen for solvable tasks

    def go_to_and_use(kind_idx, count):
        """Move to a cell containing `kind_idx` and apply USE `count` times."""
        nonlocal pos, actions
        for _ in range(count):
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 4. Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 4a) Collect all required primitive resources
    for prim_idx, cnt in needed_prims.items():
        go_to_and_use(prim_idx, cnt)

    # 4b) Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([ACTION_USE] * cnt)

    return actions

