    # Reset the environment and obtain the underlying objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Action indices
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    non_grabbable = list(world.non_grabbable_indices)

    from collections import deque

    def bfs(start, goal):
        """Return a list of movement actions from start to goal while avoiding
        cells that contain any non‑grabbable entity."""
        H, W = grid.shape[:2]
        visited = np.zeros((H, W), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct path
                actions = []
                cur = goal
                while cur != start:
                    py, px = prev[cur]
                    dy, dx = cur[0] - py, cur[1] - px
                    if dy == 1:
                        actions.append(DOWN)
                    elif dy == -1:
                        actions.append(UP)
                    elif dx == 1:
                        actions.append(RIGHT)
                    elif dx == -1:
                        actions.append(LEFT)
                    cur = (py, px)
                actions.reverse()
                return actions
            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # block movement if any non‑grabbable entity occupies the cell
                    if np.any(grid[ny, nx, non_grabbable] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        return []  # no path found

    def nearest(kind, from_pos):
        """Return coordinates of the nearest cell containing the given kind."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    # ------------------------------------------------------------------
    # Determine goal index for 'arrow' and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = nearest(prim_idx, cur_pos)
            if target is None:
                # primitive not present – abort early
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on (prefer one that lets us face the primitive)
            adj = None
            for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    if not grid[ny, nx].any():   # completely empty cell
                        adj = (ny, nx)
                        break
            if adj is None:
                # fall back to the primitive cell itself
                adj = (ty, tx)

            # Move to the chosen adjacent cell
            actions += bfs(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (add one movement action that will be blocked)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update internal grid representation to reflect that the primitive has been collected
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if the recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions

