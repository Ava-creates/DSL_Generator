    import collections, numpy as np

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_path(start, targets, grid):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # any non‑empty cell blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # Stop when we are adjacent (Manhattan distance 1) to any target cell
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand 4‑connected neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell – return empty path
        return []

    def _move(pos, act):
        if act == RIGHT:
            return (pos[0] + 1, pos[1])
        if act == LEFT:
            return (pos[0] - 1, pos[1])
        if act == DOWN:
            return (pos[0], pos[1] + 1)
        if act == UP:
            return (pos[0], pos[1] - 1)
        return pos

    # ------------------------------------------------------------------
    # Locate the world and its cookbook (different wrappers expose them
    # in slightly different attributes).
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        tmp_state = getattr(env, "_current_state", None)
        if tmp_state is not None:
            world = getattr(tmp_state, "world", None)
    if world is None:
        raise RuntimeError("Cannot find CraftWorld instance inside the environment.")

    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have an initial state (reset if necessary) to obtain the
    # starting grid and agent position.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Goal is the item named "arrow".
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    pos = tuple(state.pos)          # (x, y)
    grid = state.grid.copy()        # mutable copy for planning
    actions = []
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locate all cells that currently contain this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Greedy ordering by Manhattan distance from current position.
        locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)
            # Pick up the primitive.
            actions.append(USE)
            harvested.add(loc)
            collected += 1
            # Mark the cell empty for subsequent planning.
            grid[loc[0], loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if the recipe specifies one).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else workshop_key)
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)

    # Use (craft) – works both at a workshop and anywhere else.
    actions.append(USE)

    return actions


    # ----------------------------------------------------------------------
    # Helper functions
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_path(start, targets, grid):
        """Return a list of actions moving from `start` to a cell adjacent to any
        position in `targets`.  Cells with any non‑zero kind are treated as blocked.
        """
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # blocked cells mask
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacency – return empty list
        return []

    def _move(pos, act):
        """Return new position after applying action `act`."""
        if act == RIGHT:
            return (pos[0] + 1, pos[1])
        if act == LEFT:
            return (pos[0] - 1, pos[1])
        if act == DOWN:
            return (pos[0], pos[1] + 1)
        if act == UP:
            return (pos[0], pos[1] - 1)
        return pos

    # ----------------------------------------------------------------------
    # Locate world and cookbook objects (different wrappers expose them differently)
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # try the wrapper used by CraftLab
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Ensure we have a fresh state (reset if needed)
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ----------------------------------------------------------------------
    # Goal information
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Planning state
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                 # (x, y)
    grid = state.grid.copy()               # mutable copy for path‑finding
    actions = []
    harvested = set()                      # cells already used for collection

    # ----------------------------------------------------------------------
    # Collect each required primitive
    # ----------------------------------------------------------------------
    for prim_idx, required in primitives_needed.items():
        # Find all cells that currently contain this primitive
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Greedy order by Manhattan distance from current position
        locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= required:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)
            # Pick it up
            actions.append(USE)
            harvested.add(loc)
            collected += 1
            # Mark the cell empty for later planning
            grid[loc[0], loc[1], prim_idx] = 0

    # ----------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a string name or already an int)
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str) else workshop_key)
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop cell
            workshop_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            target_ws = workshop_cells[0]
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)
    # Use action to craft (whether at a workshop or anywhere)
    actions.append(USE)

    return actions

