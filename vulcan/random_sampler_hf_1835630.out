    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that
        walks from ``start`` to ``goal`` using Manhattan distance."""
        actions = []
        y, x = start
        gy, gx = goal
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind, from_pos):
        """Find the nearest cell that contains ``kind`` (primitive or workshop)."""
        locations = np.argwhere(grid[:, :, kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = dists.argmin()
        return tuple(locations[nearest_idx])

