    # Retrieve the underlying scenario and world objects
    scenario = getattr(env, "scenario", None) or env
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # Resolve the index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Obtain the initial state from which planning will start
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory contents, and grid occupancy
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_PLAN_LENGTH = 500                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # default: 4 moves + USE

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: already have an arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_PLAN_LENGTH:
            continue

        # Expand all possible primitive actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)

            # If this action yields the goal, return the full action list
            if next_state.satisfies("", target_idx):
                return node.actions + [a]

            key = _state_key(next_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(next_state, node.actions + [a]))

    # No feasible plan found within the search budget
    return []


    # Resolve scenario and world objects from the environment
    scenario = getattr(env, "scenario", None) or env
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state for planning
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """Hashable representation of a CraftState."""
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 800                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # usually 4 moves + USE

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            key = _state_key(next_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(next_state, node.actions + [a]))

    # No plan found within the search budget
    return []

