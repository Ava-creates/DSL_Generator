    import numpy as np
    import collections

    # Action indices
    spec = env.action_specs()
    DOWN = spec["DOWN"]
    UP = spec["UP"]
    LEFT = spec["LEFT"]
    RIGHT = spec["RIGHT"]
    USE = spec["USE"]

    # Goal and required primitives
    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    # Current state snapshot
    state = env._current_state
    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()             # (W, H, n_kinds)

    actions = []

    # -----------------------------------------------------------------
    # BFS path finder that avoids non‑grabbable entities
    # -----------------------------------------------------------------
    def bfs(start, target):
        W, H = grid.shape[:2]

        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((W, H), dtype=bool)

        # The target cell may be occupied by a required item; allow stepping onto it
        blocked[target[0], target[1]] = False

        q = collections.deque([start])
        came_from = {start: None}
        action_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_to[nxt] = a
                        q.append(nxt)

        if target not in came_from:
            return None

        # Reconstruct actions
        path = []
        cur = target
        while cur != start:
            path.append(action_to[cur])
            cur = came_from[cur]
        path.reverse()
        return path

    # -----------------------------------------------------------------
    # Collect all required primitives
    # -----------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                break  # no more copies left on the map
            # Choose the nearest location (Manhattan)
            target = min(locations,
                         key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            path = bfs(pos, target)
            if path is None:
                # Fallback to simple Manhattan moves
                dx, dy = target[0] - pos[0], target[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1
            actions.extend(path)
            actions.append(USE)                     # pick up primitive
            # Update simulated position and grid
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0

    # -----------------------------------------------------------------
    # Move to workshop (if required) and craft the final item
    # -----------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locations:
            target_ws = min(ws_locations,
                            key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            path = bfs(pos, target_ws)
            if path is None:
                dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1
            actions.extend(path)
            actions.append(USE)                     # craft at workshop

    return actions

