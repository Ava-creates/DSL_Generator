    import numpy as np

    # Action indices (as defined in CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Helper to execute an action and keep the internal state in sync
    def _do_action(action):
        nonlocal state, actions
        actions.append(action)
        # CraftState.step returns (reward, new_state)
        _, state = state.step(action)

    # Start from the current state inside the environment
    state = env._current_state
    world = env.world

    # Index of the target item ("arrow")
    arrow_idx = world.cookbook.index.index("arrow")

    # Primitive requirements for one arrow
    needed = dict(world.cookbook.primitives_for(arrow_idx))

    # Workshop where the arrow must be crafted (if any)
    workshop_idx = None
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    while needed:
        # Choose a primitive that is still needed
        prim_idx, count_needed = next(iter(needed.items()))

        # Locate all cells containing this primitive
        positions = np.argwhere(state.grid[:, :, prim_idx] > 0)
        if positions.size == 0:
            # No more of this primitive on the map – cannot continue
            raise RuntimeError("Required primitive not found on the grid")

        # Pick the closest one (Manhattan distance)
        cur_x, cur_y = state.pos
        dists = np.abs(positions[:, 0] - cur_x) + np.abs(positions[:, 1] - cur_y)
        target_pos = positions[dists.argmin()]
        tx, ty = target_pos.tolist()

        # Move horizontally then vertically towards the target cell
        while state.pos[0] < tx:
            _do_action(RIGHT)
        while state.pos[0] > tx:
            _do_action(LEFT)
        while state.pos[1] < ty:
            _do_action(DOWN)
        while state.pos[1] > ty:
            _do_action(UP)

        # Pick up the primitive (USE)
        _do_action(USE)

        # Update bookkeeping
        count_needed -= 1
        if count_needed == 0:
            del needed[prim_idx]
        else:
            needed[prim_idx] = count_needed

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        # Find any workshop cell
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            raise RuntimeError("Workshop required for arrow not present")
        # Choose the closest workshop
        cur_x, cur_y = state.pos
        dists = np.abs(workshop_cells[:, 0] - cur_x) + np.abs(workshop_cells[:, 1] - cur_y)
        wx, wy = workshop_cells[dists.argmin()].tolist()

        # Move to the workshop cell
        while state.pos[0] < wx:
            _do_action(RIGHT)
        while state.pos[0] > wx:
            _do_action(LEFT)
        while state.pos[1] < wy:
            _do_action(DOWN)
        while state.pos[1] > wy:
            _do_action(UP)

    # Use the workshop to craft the arrow
    _do_action(USE)

    return actions

