    import collections, numpy as np

    # Action indices used by CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell adjacent (Manhattan distance ≤ 1) to any position
    # in `targets`. All cells that contain any non‑zero kind are treated
    # as obstacles.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, occ_grid):
        w, h = occ_grid.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ_grid[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []  # no reachable target

    # ------------------------------------------------------------------
    # Locate the world and cookbook objects inside the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_wrap = getattr(env, "_current_state", None)
        if state_wrap is not None:
            world = getattr(state_wrap, "world", None)
    if world is None:
        raise RuntimeError("Could not find CraftWorld instance in env.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if needed).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal is the hard‑coded item “arrow”.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not present in the cookbook.")
    goal_idx = cookbook.index[goal_name]

    # Primitives (and required counts) needed to craft the goal.
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Planning state (mutable copy of the grid, simulated position, etc.).
    # ------------------------------------------------------------------
    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()             # mutable copy for planning
    occupied = np.any(grid > 0, axis=2)  # boolean mask of blocked cells
    actions = []                         # final action list to return
    harvested = set()                    # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive, one by one, using a greedy nearest‑first strategy.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        collected = 0
        while collected < needed:
            # Find all cells that currently contain this primitive and are not yet harvested.
            candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                          if tuple(p) not in harvested]
            if not candidates:
                break  # no more of this primitive reachable; exit loop

            # Choose the closest candidate.
            candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = candidates[0]

            # Move adjacent to the target primitive.
            path = _bfs_path(pos, [target], occupied)
            actions.extend(path)

            # Update simulated position after following the path.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick up the primitive.
            actions.append(USE)
            # Mark the cell empty for subsequent planning.
            grid[target[0], target[1], prim_idx] = 0
            occupied[target[0], target[1]] = False
            harvested.add(target)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or an integer).
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        # Find workshop cells still present in the grid.
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = ws_cells[0]

            # Move adjacent to the workshop.
            path = _bfs_path(pos, [ws_target], occupied)
            actions.extend(path)

            # Update simulated position.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Use the workshop to craft the arrow.
            actions.append(USE)
        else:
            # No visible workshop – attempt to craft in place.
            actions.append(USE)
    else:
        # No specific workshop required; just use.
        actions.append(USE)

    # ------------------------------------------------------------------
    # Return the compiled list of actions.
    # ------------------------------------------------------------------
    return actions


