    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `start`
    # to a cell adjacent (Manhattan distance ≤ 1) to any coordinate in `targets`.
    # Cells containing any entity are treated as blocked.
    # ----------------------------------------------------------------------
    def _bfs_path(start, targets, grid):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where cell is non‑empty
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop if adjacent to any target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Explore neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
