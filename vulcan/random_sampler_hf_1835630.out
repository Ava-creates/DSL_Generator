            target = locations.pop(0)

            # move to the target cell
            path = bfs(pos, {target})
            if path is None:
                # cannot reach this instance; skip it
                continue
            actions.extend(path)
            move_along(path)

            # pick up the item
            actions.append(4)          # USE
            grid[target[0], target[1], ing_idx] = 0
            inventory[ing_idx] += 1
            collected += 1

    # ---- go to the workshop and craft --------------------------------------
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        # no workshop needed; just use the item if it can be crafted in place
        actions.append(4)
        return actions

    workshop_idx = workshop_name if isinstance(workshop_name, int) else cookbook.index[workshop_name]
    workshop_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, workshop_idx] > 0]

    if workshop_cells:
        ws_target = workshop_cells[0]
        path = bfs(pos, {ws_target})
        if path:
            actions.extend(path)
            move_along(path)

    # final USE to craft the arrow
    actions.append(4)  # USE

    return actions


