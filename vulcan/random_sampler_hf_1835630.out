    # Reset the environment to get a fresh state
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Identify the index for the target item "arrow"
    arrow_idx = cookbook.index.index("arrow")
    recipe = cookbook.recipes.get(arrow_idx, {})

    # Extract required primitive ingredients (ignore special keys)
    required_prims = {
        kind_idx: cnt
        for kind_idx, cnt in recipe.items()
        if kind_idx not in ("_key", "_at")
    }
    # Index of the workshop where the arrow must be crafted
    workshop_idx = recipe.get("_at", None)

    # Mapping from action name to integer code
    action_map = env.action_specs()

    actions = []

    # Helper to move the agent from its current position to a target cell.
    def _move_to(target_pos):
        nonlocal actions, state
        cur_x, cur_y = state.pos
        tgt_x, tgt_y = target_pos
        while (cur_x, cur_y) != (tgt_x, tgt_y):
            if cur_x < tgt_x:
                actions.append(action_map["RIGHT"])
                cur_x += 1
            elif cur_x > tgt_x:
                actions.append(action_map["LEFT"])
                cur_x -= 1
            elif cur_y < tgt_y:
                actions.append(action_map["DOWN"])
                cur_y += 1
            elif cur_y > tgt_y:
                actions.append(action_map["UP"])
                cur_y -= 1
        # Update the state's position to reflect the moves we just recorded.
        state.pos = (cur_x, cur_y)

    # ----------------------------------------------------------------------
    # Collect each required primitive.
    # ----------------------------------------------------------------------
    grid = state.grid
    for prim_idx, needed_cnt in required_prims.items():
        # Find all cells that currently contain this primitive.
        locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
        if not locations:
            # If the primitive is not present, skip (the environment may
            # generate it later after other actions, but for this simple
            # planner we assume it is initially available).
            continue

        # For simplicity, just go to the first discovered location.
        target_loc = locations[0]

        # Move to the primitive's cell and pick it up with USE.
        _move_to(target_loc)
        actions.append(action_map["USE"])

        # Note: we do not update the inventory or the grid here because the
        # planner only needs to output a plausible sequence of actions.
        # The environment will handle the actual state changes when the
        # actions are executed.

    # ----------------------------------------------------------------------
    # Go to the appropriate workshop and craft the arrow.
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if workshop_locs:
            workshop_pos = workshop_locs[0]
            _move_to(workshop_pos)
            actions.append(action_map["USE"])

    return actions


    # Reset the environment to start a new episode and obtain the initial state.
    env.reset()
    state = env._current_state
    world = env.world

    # Resolve the index for the target item "arrow".
    arrow_idx = world.cookbook.index.get("arrow")
    if arrow_idx is None:
        return []

    # Retrieve the recipe for the arrow, separating primitive requirements
    # and the workshop where the item must be crafted.
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_idx = recipe.get("_at")
    primitive_requirements = {
        ing: cnt
        for ing, cnt in recipe.items()
        if ing not in ("_key", "_at")
    }

    # Helper: map movement direction (0:down,1:up,2:left,3:right) to action id.
    action_map = env.action_specs()
    dir_to_action = {
        0: action_map["DOWN"],
        1: action_map["UP"],
        2: action_map["LEFT"],
        3: action_map["RIGHT"],
    }
    use_action = action_map["USE"]

    # Helper: compute a boolean mask of blocked cells (non‑grabbable entities).
    def blocked_cells(grid):
        blocked = np.zeros(grid.shape[:2], dtype=bool)
        for idx in world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0
        return blocked

    # Helper: Breadth‑first search returning a list of movement directions
    # (using the 0‑3 encoding above) from start to the nearest cell in target_set.
    from collections import deque

    def bfs(start, target_set, blocked):
        q = deque()
        q.append((start, []))
        visited = {start}
        # direction vectors correspond to the 0‑3 encoding order used above.
        deltas = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # down, up, left, right
        max_x, max_y = blocked.shape
        while q:
            pos, path = q.popleft()
            if pos in target_set:
                return path
            for d, (dx, dy) in enumerate(deltas):
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < max_x and 0 <= ny < max_y:
                    if not blocked[nx, ny] and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [d]))
        return None

    actions = []

    # ----------------------------------------------------------------------
    # Collect all required primitive items.
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitive_requirements.items():
        for _ in range(needed):
            # Continue until we have at least one of the required primitive.
            while state.inventory[prim_idx] < 1:
                grid = state.grid
                blocked = blocked_cells(grid)

                # Locate all cells that currently contain the primitive.
                prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
                if prim_cells.size == 0:
                    # No more primitives of this type are present; abort.
                    break

                # Find a path to the closest such cell.
                target_set = {tuple(p) for p in prim_cells}
                path_dirs = bfs(state.pos, target_set, blocked)
                if path_dirs is None:
                    # Unable to reach any primitive; abort.
                    break

                # Execute the movement actions.
                for d in path_dirs:
                    act = dir_to_action[d]
                    _, new_state = state.step(act)
                    actions.append(act)
                    state = new_state

                # Pick up the primitive with the USE action.
                _, new_state = state.step(use_action)
                actions.append(use_action)
                state = new_state

    # ----------------------------------------------------------------------
    # Move to the appropriate workshop and craft the arrow.
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        # Find any workshop cell of the required type.
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            blocked = blocked_cells(state.grid)
            target_set = {tuple(p) for p in workshop_cells}
            path_dirs = bfs(state.pos, target_set, blocked)
            if path_dirs:
                for d in path_dirs:
                    act = dir_to_action[d]
                    _, new_state = state.step(act)
                    actions.append(act)
                    state = new_state
                # Use the workshop to craft the arrow.
                _, new_state = state.step(use_action)
                actions.append(use_action)
                state = new_state

    return actions

