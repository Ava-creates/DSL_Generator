    # Reset the environment and fetch the current state/world.
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid.copy()             # mutable copy for local bookkeeping

    # Identify the goal item ("arrow") and the primitives required to craft it.
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    import collections

    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """True if ``pos`` contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs_path(start, goal):
        """Shortest walkable path from ``start`` to ``goal`` avoiding blocked cells.
        Returns a list of positions (excluding ``start``, including ``goal``)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in prev and not is_blocked(nxt):
                        prev[nxt] = cur
                        q.append(nxt)
        else:
            return []  # no path found

        # reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions into movement actions."""
        actions = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                actions.append(DOWN)
            elif y2 == y1 - 1:
                actions.append(UP)
            elif x2 == x1 + 1:
                actions.append(RIGHT)
            elif x2 == x1 - 1:
                actions.append(LEFT)
        return actions

    def nearest_cell(kind, from_pos):
        """Find the nearest cell containing ``kind`` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of ``target`` (preferring N,S,W,E)."""
        ty, tx = target
        for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked((ny, nx)):
                return (ny, nx)
        return target  # fallback (may be blocked but used as last resort)

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos  # current agent position (y, x)

    # Collect each required primitive the needed number of times.
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive not found – abort early.
                return actions

            # Move to a free cell adjacent to the primitive.
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur, stand_pos)
            if not path and cur != stand_pos:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive cell itself.
            path = bfs_path(cur, prim_loc)
            if not path and cur != prim_loc:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick up the primitive.
            actions.append(USE)

            # Update local grid copy to reflect that the primitive has been taken.
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # Move to the workshop required by the recipe (if any).
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            if path:
                actions.extend(path_to_actions([cur] + path))
                cur = ws_loc

    # Final USE to craft the arrow.
    actions.append(USE)

    return actions


