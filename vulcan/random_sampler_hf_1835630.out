    import numpy as np
    from collections import deque

    # Action indices (consistent with CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Reset and obtain core objects
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def cell_occupied(y, x):
        """True if the cell contains any entity (including primitives)."""
        return grid[y, x].any()

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that
        moves the agent from ``start`` to ``goal`` using BFS avoiding
        occupied cells. ``goal`` must be free."""
        if start == goal:
            return []
        q = deque()
        q.append((start[0], start[1], []))
        visited = set()
        visited.add(start)
        while q:
            y, x, path = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_occupied(ny, nx):
                    continue
                new_path = path + [act]
                if (ny, nx) == goal:
                    return new_path
                visited.add((ny, nx))
                q.append((ny, nx, new_path))
        # No path found – fall back to empty list (will likely fail later)
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing ``kind_idx`` (primitive or workshop)."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Return a free neighbouring cell (y,x) to ``cell``.
        ``avoid`` is a set of coordinates that should not be used."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not cell_occupied(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives for 'arrow'
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos                     # (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    collected_primitives = set()            # cells already taken

    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # primitive not present – abort early
                return actions

            # Choose a free adjacent cell to stand on while picking up
            adj = adjacent_free(target, avoid=collected_primitives)
            if adj is None:
                # No free neighbour; cannot collect safely – abort
                return actions

            # Move to the adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (add a movement action that will be blocked)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pickup
            actions.append(USE)

            # Update internal grid representation: primitive disappears
            grid[target[0], target[1], prim_idx] = 0
            collected_primitives.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            # Stand on a free neighbour of the workshop
            ws_adj = adjacent_free(ws_cell, avoid=collected_primitives)
            if ws_adj is None:
                ws_adj = cur_pos  # fallback – stay where we are
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj
            # Face the workshop (optional – a blocked move)
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting
    actions.append(USE)

    return actions

