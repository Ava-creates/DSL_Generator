def make_arrow_v2(env):
    actions = []
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = spec['DOWN'], spec['UP'], spec['LEFT'], spec['RIGHT'], spec['USE']
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)
    state = env._current_state
    grid = state.grid.copy()   # copy to modify locally
    cur_pos = tuple(state.pos)

    def delta_to_action(dx, dy):
        if dx == 1:
            return DOWN
        if dx == -1:
            return UP
        if dy == 1:
            return RIGHT
        if dy == -1:
            return LEFT
        raise ValueError

    def bfs(start, targets, allow_target=False):
        from collections import deque
        H, W = grid.shape[0], grid.shape[1]
        visited = np.full((H, W), False, dtype=bool)
        prev = np.empty((H, W), dtype=object)
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) in targets:
                # reconstruct
                path = []
                while (x, y) != start:
                    path.append((x, y))
                    x, y = prev[x, y]
                path.reverse()
                return path
            for dx, dy in [(1,0),(-1,0),(0,1),(0,-1)]:
                nx, ny = x+dx, y+dy
                if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:
                    occupied = grid[nx, ny].any()
                    if occupied and not (allow_target and (nx, ny) in targets):
                        continue
                    visited[nx, ny] = True
                    prev[nx, ny] = (x, y)
                    q.append((nx, ny))
        return None

    # collect primitives
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # find locations currently containing primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # no more on map, break
                break
            path = bfs(cur_pos, set(locations), allow_target=True)
            if path is None:
                # fallback Manhattan
                target = locations[0]
                path = []
                tx, ty = target
                cx, cy = cur_pos
                while cx < tx:
                    path.append((cx+1, cy)); cx+=1
                while cx > tx:
                    path.append((cx-1, cy)); cx-=1
                while cy < ty:
                    path.append((cx, cy+1)); cy+=1
                while cy > ty:
                    path.append((cx, cy-1)); cy-=1
            # translate path to actions
            for nxt in path:
                dx = nxt[0] - cur_pos[0]
                dy = nxt[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = nxt
            # use to pick up
            actions.append(USE)
            # remove primitive from grid
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # move to workshop
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target = ws_locs[0]
            path = bfs(cur_pos, {target}, allow_target=True)
            if path is None:
                # Manhattan fallback
                tx, ty = target
                cx, cy = cur_pos
                path = []
                while cx < tx:
                    path.append((cx+1, cy)); cx+=1
                while cx > tx:
                    path.append((cx-1, cy)); cx-=1
                while cy < ty:
                    path.append((cx, cy+1)); cy+=1
                while cy > ty:
                    path.append((cx, cy-1)); cy-=1
            for nxt in path:
                dx = nxt[0] - cur_pos[0]
                dy = nxt[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = nxt
            actions.append(USE)
    return actions


    actions = []
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"],
        spec["UP"],
        spec["LEFT"],
        spec["RIGHT"],
        spec["USE"],
    )

    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}
    state = env._current_state
    grid = state.grid
    pos = tuple(state.pos)  # (x, y)

    def _move(cur, tgt):
        """Return a list of movement actions (Manhattan) from cur to tgt."""
        moves = []
        x, y = cur
        tx, ty = tgt
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    # ---- Collect primitives ----
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # Find all remaining cells containing this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                break  # no more of this primitive on the map
            # Choose the nearest by Manhattan distance
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),
            )
            actions.extend(_move(pos, target))
            pos = target
            actions.append(USE)
            # Remove the primitive from our internal copy of the grid
            grid[pos[0], pos[1], prim_idx] = 0

    # ---- Move to workshop and craft ----
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target = min(
                ws_locs,
                key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),
            )
            actions.extend(_move(pos, target))
            pos = target
            actions.append(USE)

    return actions

