    import numpy as np

    # Action indices (match CraftLab's action specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Helper to move from current position to target using Manhattan moves
    def _move(cur, target, act_list):
        x, y = cur
        tx, ty = target
        # move in x direction
        while x < tx:
            act_list.append(RIGHT)
            x += 1
        while x > tx:
            act_list.append(LEFT)
            x -= 1
        # move in y direction
        while y < ty:
            act_list.append(DOWN)
            y += 1
        while y > ty:
            act_list.append(UP)
            y -= 1
        return (x, y)

    world = env.world
    state = env._current_state

    # Determine goal index (arrow). Prefer task goal if present, otherwise look up by name.
    goal_idx = None
    task = getattr(env, "task", None)
    if task is not None:
        goal_idx = getattr(task, "goal", None)
    if goal_idx is None:
        # fallback to name lookup
        try:
            goal_idx = world.cookbook.index["arrow"]
        except Exception:
            raise RuntimeError("Unable to determine goal index for arrow.")

    # Primitive requirements for the goal (recursive expansion)
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    actions = []
    cur_pos = tuple(state.pos)

    # Collect each required primitive
    for prim_idx, needed in primitive_requirements.items():
        # Find any location that currently contains this primitive
        locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
        if locations.size == 0:
            # Primitive not present in the current grid – cannot collect
            continue
        target = tuple(locations[0])
        cur_pos = _move(cur_pos, target, actions)
        # Pick up the required amount (one USE per unit)
        for _ in range(needed):
            actions.append(USE)

    # Move to the appropriate workshop and craft the item
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_key") or recipe.get("_at")
    workshop_idx = None
    if workshop_name is not None:
        if isinstance(workshop_name, str):
            workshop_idx = world.cookbook.index.get(workshop_name)
        else:
            workshop_idx = workshop_name  # assume already an index

    if workshop_idx is not None:
        ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if ws_locs.size > 0:
            workshop_pos = tuple(ws_locs[0])
            cur_pos = _move(cur_pos, workshop_pos, actions)

    # Use the workshop (or current cell) to craft the goal item
    actions.append(USE)

    return actions


