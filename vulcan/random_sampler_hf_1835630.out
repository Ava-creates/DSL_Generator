    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid.copy()             # Local mutable copy for planning

    # Action indices as defined by the environment's action specs
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
