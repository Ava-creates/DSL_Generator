    import numpy as np
    from collections import deque

    # Standard action indices for CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # Mapping from action to coordinate delta (grid indexed as [x, y])
    _DELTA = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of actions that brings
    # the agent from `start` to a cell adjacent to any cell in `targets`.
    # Cells that contain any non‑zero entity are treated as obstacles.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, cur_grid):
        w, h, _ = cur_grid.shape
        occupied = np.any(cur_grid > 0, axis=2)          # True where any kind blocks movement
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path
            # Expand neighbours
            for act, (dx, dy) in _DELTA.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell
        return []

    # ------------------------------------------------------------------
    # Retrieve the underlying CraftWorld and its cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world through the current state.
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = state_wrapper.world
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance from the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal identification (hard‑coded to the item named "arrow").
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in the cookbook.")
    goal_idx = cookbook.index[goal_name]

    # Mapping primitive index → count needed to craft one arrow.
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Ensure we have a fresh state; reset the environment if necessary.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)               # Current (x, y) position
    grid = state.grid.copy()             # Mutable copy for planning

    actions = []                          # Accumulated action sequence
    used_cells = set()                    # Cells already harvested

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, count_needed in primitives_needed.items():
        # Locate all cells that currently contain this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position for efficiency.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= count_needed:
                break
            if loc in used_cells:
                continue
            # Plan a path to a cell adjacent to the primitive.
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            # Simulate movement to update `pos`.
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Pick up the primitive.
            actions.append(USE)
            used_cells.add(loc)
            gathered += 1
            # Update planning grid – the primitive is now removed.
            grid[loc[0], loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a string name or integer id).
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)
        # Find all workshop cells currently present.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop.
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft the arrow.
            actions.append(USE)
        else:
            # No visible workshop – attempt to craft at current location.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    # Action indices for CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # Mapping from action to coordinate delta (x, y)
    _DELTA = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: breadth‑first search that returns a list of actions moving the
    # agent from `start` to a cell adjacent to any of `targets`.  Cells that
    # contain any non‑zero kind are treated as obstacles.
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def _bfs_path(start, targets, cur_grid):
        w, h, _ = cur_grid.shape
        occupied = np.any(cur_grid > 0, axis=2)          # True where any entity blocks movement
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are already adjacent (Manhattan distance 1) to any target, stop.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path
            # Expand neighbours
            for act, (dx, dy) in _DELTA.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell – return empty path (caller may handle)
        return []

    # ------------------------------------------------------------------
    # Retrieve the underlying CraftWorld and its cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # In many wrappers the world lives inside the current state.
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance from the environment.")

    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Determine the goal – hard‑coded to the item named "arrow".
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in the cookbook.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for one arrow.
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state to read position / grid.
    # ------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    pos = tuple(state.pos)          # (x, y)
    grid = state.grid.copy()        # mutable copy for planning

    actions = []
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locate all cells containing this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position for efficiency.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed:
                break
            if loc in harvested:
                continue
            # Plan a path to a cell adjacent to the primitive.
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            # Simulate movement to update `pos`.
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use action to pick up the primitive.
            actions.append(USE)
            harvested.add(loc)
            gathered += 1
            # Update planning grid – primitive is now removed.
            grid[loc[0], loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or an integer).
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)
        # Find workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                dx, dy = _DELTA[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use action to craft.
            actions.append(USE)
        else:
            # No visible workshop – just attempt to craft at current location.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions

