    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a sequence of actions moving the agent from
    # start position to a cell adjacent (or on) any of the target cells.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, occupied):
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable path
        return []

