    # Direction deltas matching action indices (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def walkable(grid, x, y):
        W, H = grid.shape[:2]
        if not (0 <= x < W and 0 <= y < H):
            return False
        # a cell is walkable if it contains no entities at all
        return not np.any(grid[x, y, :])

    from collections import deque

    def bfs_to_target(state, target_kind):
        """Return a list of movement actions (0‑3) that ends with the agent
        facing a cell containing `target_kind`. Returns None if unreachable."""
        grid = state.grid
        W, H = grid.shape[:2]
        sx, sy = state.pos
        sdir = state.dir
        queue = deque()
        queue.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}
        while queue:
            x, y, d, acts = queue.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))
        return None

    # ------------------------------------------------------------------
    # Collect all primitive resources required for one arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    if not primitive_needs:
        # Arrow itself is a primitive
        primitive_needs = {arrow_idx: 1}

    actions = []

    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_seq = bfs_to_target(cur_state, prim_idx)
            if move_seq is None:
                # Cannot reach this primitive; abort planning
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(cur_state, workshop_idx)
        if move_seq is None:
            # Workshop unreachable – still try a USE (will fail harmlessly)
            actions.append(4)
            _, cur_state = cur_state.step(4)
        else:
            actions.extend(move_seq)
            actions.append(4)  # USE to craft
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)
    else:
        # No specific workshop; craft in place
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions


    import numpy as np
    from collections import deque

    # Reset the environment and fetch the current state/world.
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow". 0 means not found.
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Action → (dx, dy) mapping for the four movement actions.
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def walkable(grid, x, y):
        """Return True if (x, y) is inside the map and contains no entities."""
        W, H = grid.shape[:2]
        if not (0 <= x < W and 0 <= y < H):
            return False
        return not np.any(grid[x, y, :])

    def bfs_to_target(cur_state, target_kind):
        """
        Bread‑first search for a sequence of movement actions (0‑3) that ends
        with the agent facing a cell containing `target_kind`.  Returns None
        if no such sequence exists.
        """
        grid = cur_state.grid
        W, H = grid.shape[:2]
        sx, sy = cur_state.pos
        sdir = cur_state.dir
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
                return seq
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine which primitive resources are needed for one arrow.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:
        # Arrow itself may be a primitive (no recipe).
        primitive_needs = {arrow_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            move_seq = bfs_to_target(state, prim_idx)
            if move_seq is None:
                # Primitive unreachable – abort planning.
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up / interact
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(state, workshop_idx)
        if move_seq is None:
            # Workshop unreachable – abort planning.
            return actions
        actions.extend(move_seq)
        actions.append(4)  # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop; craft in place.
        actions.append(4)
        _, state = state.step(4)

    return actions

