    # Reset the environment to a fresh state and obtain the initial state
    env.reset()
    cur_state = env._current_state
    world = env.world

    # Goal item index (the arrow or whatever the task specifies)
    goal_idx = env.task.goal

    # Mapping of action indices to movement deltas (DOWN, UP, LEFT, RIGHT)
    deltas = {
        0: (0, 1),   # DOWN
        1: (0, -1),  # UP
        2: (-1, 0),  # LEFT
        3: (1, 0)    # RIGHT
    }

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def walkable(grid, x, y):
        """Return True if (x, y) is inside the grid and not blocked by a non‑grabbable entity."""
        W, H = grid.shape[:2]
        if not (0 <= x < W and 0 <= y < H):
            return False
        # a cell is blocked if any non‑grabbable kind is present there
        non_grab = world.non_grabbable_indices
        if not non_grab:
            return True
        return not np.any(grid[x, y, list(non_grab)])

    from collections import deque

    def bfs_to_target(state, target_kind):
        """
        Bread‑first search for a sequence of movement actions (0‑3) that ends
        with the agent facing a cell containing `target_kind`. Returns the
        action list, or an empty list if already facing the target or unreachable.
        """
        grid = state.grid
        W, H = grid.shape[:2]
        sx, sy = state.pos
        sdir = state.dir

        # Check if we are already facing the target
        dx, dy = deltas[sdir]
        fx, fy = sx + dx, sy + dy
        if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
            return []

        queue = deque()
        queue.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while queue:
            x, y, d, acts = queue.popleft()
            # Look ahead from current orientation
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
                return acts

            # Expand neighbours (move in any of the four directions)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))
        # Unreachable
        return []

    def target_ahead(state, kind):
        """True if the cell directly in front of the agent contains `kind`."""
        x, y = state.pos
        d = state.dir
        dx, dy = deltas[d]
        fx, fy = x + dx, y + dy
        W, H = state.grid.shape[:2]
        return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)

    # ----------------------------------------------------------------------
    # Planning
    # ----------------------------------------------------------------------
    actions = []

    # 1) Gather all primitive resources required for the goal
    primitive_needs = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_seq = bfs_to_target(cur_state, prim_idx)
            # If we cannot reach the primitive, abort planning
            if not move_seq and not target_ahead(cur_state, prim_idx):
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up the primitive

            # Update the simulated state so subsequent searches are accurate
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # 2) Move to the required workshop (if any) and craft the goal item
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(cur_state, workshop_idx)
        if not move_seq and not target_ahead(cur_state, workshop_idx):
            # Workshop unreachable – still issue a USE (will simply do nothing)
            actions.append(4)
            _, cur_state = cur_state.step(4)
        else:
            actions.extend(move_seq)
            actions.append(4)  # USE to craft at the workshop
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)
    else:
        # No dedicated workshop – craft in place
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions


    # Reset environment to a clean start and fetch initial state
    env.reset()
    cur_state = env._current_state
    world = env.world

    # Goal item index (provided by the task)
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    # Direction vectors: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT
    deltas = [(1, 0), (-1, 0), (0, -1), (0, 1)]

    def in_bounds(r, c, h, w):
        return 0 <= r < h and 0 <= c < w

    def walkable(grid, r, c):
        """A cell is walkable if it is inside the grid and does not contain any
        non‑grabbable entity."""
        h, w, _ = grid.shape
        if not in_bounds(r, c, h, w):
            return False
        # non‑grabbable indices are stored in the world object
        non_grab = world.non_grabbable_indices
        return not np.any(grid[r, c, list(non_grab)])

    from collections import deque

    def bfs_to_target(state, target_kind):
        """
        Bread‑first search that returns a list of movement actions (0‑3) which
        ends with the agent facing a cell that contains `target_kind`.
        Returns an empty list if already facing the target or if the target is
        unreachable.
        """
        grid = state.grid
        h, w, _ = grid.shape
        sr, sc = state.pos
        sdir = state.dir

        # check if we are already facing the target
        dr, dc = deltas[sdir]
        fr, fc = sr + dr, sc + dc
        if in_bounds(fr, fc, h, w) and grid[fr, fc, target_kind] > 0:
            return []

        # BFS over (row, col, direction)
        q = deque()
        q.append((sr, sc, sdir, []))
        visited = {(sr, sc, sdir)}

        while q:
            r, c, d, acts = q.popleft()
            # look ahead from current orientation
            dr, dc = deltas[d]
            nr, nc = r + dr, c + dc
            if in_bounds(nr, nc, h, w) and grid[nr, nc, target_kind] > 0:
                return acts
            # expand to four possible movement actions
            for a in range(4):
                ar, ac = deltas[a]
                rr, cc = r + ar, c + ac
                if not walkable(grid, rr, cc):
                    continue
                if (rr, cc, a) in visited:
                    continue
                visited.add((rr, cc, a))
                q.append((rr, cc, a, acts + [a]))
        # unreachable
        return []

    def cell_ahead_contains(state, kind):
        """True if the cell directly in front of the agent contains `kind`."""
        r, c = state.pos
        d = state.dir
        dr, dc = deltas[d]
        nr, nc = r + dr, c + dc
        h, w, _ = state.grid.shape
        return in_bounds(nr, nc, h, w) and state.grid[nr, nc, kind] > 0

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []

    # 1) Gather all primitive resources required for the goal item
    primitive_needs = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    for prim_kind, count in primitive_needs.items():
        for _ in range(count):
            move_seq = bfs_to_target(cur_state, prim_kind)
            # If BFS failed and we are not already facing the primitive, abort
            if not move_seq and not cell_ahead_contains(cur_state, prim_kind):
                return actions
            actions.extend(move_seq)
            actions.append(4)          # USE to pick up
            # Update current state by executing the actions we just added
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # 2) Move to the required workshop (if any) and craft the item
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(cur_state, workshop_idx)
        if not move_seq and not cell_ahead_contains(cur_state, workshop_idx):
            # Workshop unreachable – still issue a USE (will have no effect)
            actions.append(4)
            _, cur_state = cur_state.step(4)
        else:
            actions.extend(move_seq)
            actions.append(4)          # USE to craft
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)
    else:
        # No dedicated workshop – craft in place
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions

