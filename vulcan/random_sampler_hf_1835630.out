    from collections import deque

    # --------------------------------------------------------------
    # BFS that returns a list of movement actions to reach any cell in
    # ``goals``. Cells that contain any entity are treated as obstacles
    # unless they are a goal cell.
    def bfs(start, goals):
        q = deque()
