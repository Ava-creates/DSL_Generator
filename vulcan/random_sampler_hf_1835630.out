    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        # Hash based on position, direction, inventory, and grid layout.
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 800        # generous bound to avoid infinite search
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory.
        if cur_state.satisfies("", target_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions.
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the search budget.
    return []


    # Resolve the scenario and world objects.
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Identify the integer index for the target item "arrow".
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Obtain the initial state of the episode.
    try:
        init_state = scenario.init()
    except Exception:
        init_state = getattr(env, "_current_state", None)
        if init_state is None:
            return []

    # Bread‑first search over the state space.
    from collections import deque, namedtuple
    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Compact hash for a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_PLAN_LEN = 1000                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)  # typical action space size

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test – have at least one arrow in inventory.
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories.
        if len(node.actions) >= MAX_PLAN_LEN:
            continue

        # Expand all possible primitive actions.
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the search budget.
    return []

