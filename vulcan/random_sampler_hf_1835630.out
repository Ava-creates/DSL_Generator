    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    # Action → (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def in_bounds(x, y, W, H):
        return 0 <= x < W and 0 <= y < H

    def walkable(grid, x, y):
        """A cell is walkable if it is inside the grid and contains no entities."""
        W, H = grid.shape[:2]
        if not in_bounds(x, y, W, H):
            return False
        return not np.any(grid[x, y, :])

    from collections import deque

    def bfs_to_target(cur_state, target_kind):
        """
        Bread‑first search for a sequence of movement actions (0‑3) that ends
        with the agent facing a cell containing `target_kind`. Returns the
        action list (may be empty if already facing the target) or `None`
        if the target is unreachable.
        """
        grid = cur_state.grid
        W, H = grid.shape[:2]
        sx, sy = cur_state.pos
        sdir = cur_state.dir

        # Check if we are already facing the target
        dx, dy = deltas[sdir]
        fx, fy = sx + dx, sy + dy
        if in_bounds(fx, fy, W, H) and grid[fx, fy, target_kind] > 0:
            return []

        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, acts = q.popleft()
            # Look ahead from current orientation
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy, W, H) and grid[fx, fy, target_kind] > 0:
                return acts

            # Expand to four possible movement actions
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        # Unreachable
        return None

    # ------------------------------------------------------------------
    # 1) Collect all primitive resources required for one arrow
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    if not needed:                                      # arrow itself is primitive
        needed = {arrow_idx: 1}

    plan = []

    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            move_seq = bfs_to_target(state, kind_idx)
            if move_seq is None:        # unreachable primitive → abort planning
                return plan
            plan.extend(move_seq)
            plan.append(4)               # USE to pick up

            # Simulate actions so that `state` stays up‑to‑date
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(state, workshop_idx)
        if move_seq is None:            # unreachable workshop → abort
            return plan
        plan.extend(move_seq)
        plan.append(4)                  # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No dedicated workshop – craft in place
        plan.append(4)
        _, state = state.step(4)

    return plan

