    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid.copy()

    # Action indices
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # Non‑grabbable entity indices block movement
    non_grab = list(world.non_grabbable_indices)

    H, W = grid.shape[:2]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]

    def bfs(start, goal):
        """Return a list of movement actions from start to goal avoiding
        non‑grabbable obstacles."""
        from collections import deque
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                actions = []
                cur = goal
                while cur != start:
                    py, px = prev[cur]
                    dy, dx = cur[0] - py, cur[1] - px
                    if dy == 1:
                        actions.append(DOWN)
                    elif dy == -1:
                        actions.append(UP)
                    elif dx == 1:
                        actions.append(RIGHT)
                    elif dx == -1:
                        actions.append(LEFT)
                    cur = (py, px)
                actions.reverse()
                return actions

            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    if np.any(grid[ny, nx, non_grab] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing ``kind_idx``."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(cell):
        """Return a free neighbour of *cell* (or None)."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if 0 <= ny < H and 0 <= nx < W:
                if not np.any(grid[ny, nx, non_grab] > 0):
                    return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = world.cookbook.index.index(recipe["_at"])

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            adj = free_adjacent(target)
            if adj is None:
                # No free neighbour; stand on the primitive cell itself.
                adj = target

            actions += bfs(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (issue a blocked move in that direction).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update internal grid (primitive disappears).
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE triggers crafting.
    actions.append(USE)

    return actions


    # Reset environment and get current state/world
    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid.copy()                     # mutable copy for bookkeeping

    # Action indices from the environment
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # Set of indices that block movement (non‑grabbable entities)
    non_grab = list(world.non_grabbable_indices)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque

    H, W = grid.shape[:2]

    def bfs(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding non‑grabbable
        obstacles. ``start`` and ``goal`` are (y, x) tuples."""
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct path
                actions = []
                cur = goal
                while cur != start:
                    py, px = prev[cur]
                    dy, dx = cur[0] - py, cur[1] - px
                    if dy == 1:
                        actions.append(DOWN)
                    elif dy == -1:
                        actions.append(UP)
                    elif dx == 1:
                        actions.append(RIGHT)
                    elif dx == -1:
                        actions.append(LEFT)
                    cur = (py, px)
                actions.reverse()
                return actions

            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # blocked if any non‑grabbable entity occupies the cell
                    if np.any(grid[ny, nx, non_grab] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list (should not happen for valid tasks)
        return []

    def nearest_cell(kind, from_pos):
        """Find the coordinates (y, x) of the nearest cell that contains ``kind``."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    # ------------------------------------------------------------------
    # Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on while picking up
            adj = None
            for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
                if 0 <= ny < H and 0 <= nx < W:
                    if not np.any(grid[ny, nx, non_grab] > 0):
                        adj = (ny, nx)
                        break
            if adj is None:
                # If no free neighbour, stand on the primitive cell itself
                adj = (ty, tx)

            # Move to the chosen adjacent cell
            actions += bfs(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (issue a blocked move in the correct direction)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update bookkeeping grid (primitive disappears)
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if recipe specifies one) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest_cell(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE triggers crafting
    actions.append(USE)

    return actions

