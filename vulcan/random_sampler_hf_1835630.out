    import numpy as np

    actions = []
    spec = env.action_specs()
    DOWN = spec['DOWN']
    UP = spec['UP']
    LEFT = spec['LEFT']
    RIGHT = spec['RIGHT']
    USE = spec['USE']

    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}
    state = env._current_state
    pos = tuple(state.pos)  # (x, y)

    def _move_actions(cur, tgt):
        """Return a list of movement actions to go from cur to tgt (Manhattan)."""
        moves = []
        x, y = cur
        tx, ty = tgt
        dx = tx - x
        dy = ty - y
        while dx != 0:
            if dx > 0:
                moves.append(DOWN)
                x += 1
                dx -= 1
            else:
                moves.append(UP)
                x -= 1
                dx += 1
        while dy != 0:
            if dy > 0:
                moves.append(RIGHT)
                y += 1
                dy -= 1
            else:
                moves.append(LEFT)
                y -= 1
                dy += 1
        return moves

    # Cache locations of each primitive kind on the map
    kind_locs = {}
    for kind in needed:
        coords = list(zip(*np.where(state.grid[:, :, kind] > 0)))
        kind_locs[kind] = coords

    # Collect required primitives
    for kind, count_needed in needed.items():
        while count_needed > 0:
            if not kind_locs[kind]:
                # No more instances of this primitive; abort collection for safety
                break
            # Choose the nearest location (Manhattan distance)
            cur = pos
            target = min(kind_locs[kind],
                         key=lambda c: abs(c[0] - cur[0]) + abs(c[1] - cur[1]))
            # Move to the target cell
            actions.extend(_move_actions(pos, target))
            pos = target
            # Pick up one unit
            actions.append(USE)
            # Update bookkeeping: if the cell had only one unit, remove it from list
            cell_amount = int(state.grid[target[0], target[1], kind])
            if cell_amount <= 1:
                kind_locs[kind].remove(target)
            # Otherwise keep the location for potential further pickups
            count_needed -= 1

    # Go to the appropriate workshop and craft the goal item
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        workshop_coords = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
        if workshop_coords:
            target_ws = workshop_coords[0]
            actions.extend(_move_actions(pos, target_ws))
            pos = target_ws
            actions.append(USE)

    return actions


    actions = []
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec['DOWN'],
        spec['UP'],
        spec['LEFT'],
        spec['RIGHT'],
        spec['USE'],
    )
    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}
    state = env._current_state
    pos = tuple(state.pos)  # current (x, y)

    def _move(cur, tgt):
        """Return a list of movement actions to go from cur to tgt (Manhattan walk)."""
        moves = []
        x, y = cur
        tx, ty = tgt
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    # ---- Collect required primitives ----
    for prim_idx, cnt in needed.items():
        # locate all cells that currently contain this primitive
        locations = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
        for _ in range(cnt):
            if not locations:
                break  # safety: no more of this primitive on the map
            target = locations.pop(0)

            # move to the cell
            actions.extend(_move(pos, target))
            pos = target

            # pick it up
            actions.append(USE)

    # ---- Go to the appropriate workshop and craft ----
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target = ws_locs[0]
            actions.extend(_move(pos, target))
            pos = target
            actions.append(USE)

    return actions

