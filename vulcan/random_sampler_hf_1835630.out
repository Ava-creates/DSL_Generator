    # Retrieve the scenario and world objects from the environment.
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Find the integer index for the target item "arrow".
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Get the initial state of the episode.
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory tuple, and raw grid bytes.
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_PLAN_LEN = 500               # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # default actions (4 moves + USE)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory.
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories.
        if len(node.actions) >= MAX_PLAN_LEN:
            continue

        # Expand all possible actions.
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No feasible plan found within the search budget.
    return []


    # Retrieve the CraftWorld instance from the environment / scenario.
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
