    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # Resolve the index for the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Obtain the initial CraftState for the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    # Helper to create a hashable representation of a CraftState (for visited set)
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    Node = namedtuple("Node", ["state", "actions"])
    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 500                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)  # default action space size

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long candidate plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    # No feasible plan found within the limits
    return []


