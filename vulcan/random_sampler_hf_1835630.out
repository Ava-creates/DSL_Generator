    import collections, numpy as np

    # ----------------------------------------------------------------------
    # Action indices (standard for CraftWorld)
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `start`
    # to any cell adjacent (Manhattan distance == 1) to one of `targets`.
    # `blocked` is a 2‑D bool array where True indicates an occupied cell.
    # ----------------------------------------------------------------------
    def _bfs_adjacent(start, targets, blocked):
        w, h = blocked.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency to any target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell.
        return []

    # ----------------------------------------------------------------------
    # Helper: apply a list of actions to a position tuple.
    # ----------------------------------------------------------------------
    def _apply_actions(pos, actions):
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ----------------------------------------------------------------------
    # Locate the CraftWorld instance and its Cookbook.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world through the current state.
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Ensure we have a valid current state (reset if necessary).
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ----------------------------------------------------------------------
    # Identify the goal (hard‑coded to "arrow") and retrieve its recipe.
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' is not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitive resources required to craft one arrow.
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Planning state.
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                 # current agent position (x, y)
    grid = state.grid.copy()               # (W, H, n_kinds)
    blocked = np.any(grid, axis=2)         # True where any entity occupies a cell
    plan = []                              # accumulated list of action indices
    harvested = set()                      # cells already collected from

    # ----------------------------------------------------------------------
    # Collect each required primitive.
    # ----------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        # Locate all cells that currently contain this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance to reduce travel overhead.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0

        for cell in cells:
            if collected >= required_cnt:
                break
            if cell in harvested:
                continue

            # Move to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [cell], blocked)
            plan.extend(path)
            pos = _apply_actions(pos, path)

            # Pick up the primitive.
            plan.append(USE)

            # Update planning structures: remove the primitive from the grid,
            # recompute blocked map, and record that this cell has been harvested.
            grid[cell[0], cell[1], prim_idx] = 0
            blocked = np.any(grid, axis=2)
            harvested.add(cell)
            collected += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")          # may be a string name or an int index

    if workshop_key is not None:
        # Resolve workshop index.
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))

        # Find all workshop cells present in the current grid.
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]

        if ws_cells:
            # Choose the nearest workshop.
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]

            # Move adjacent to the workshop.
            path = _bfs_adjacent(pos, [target_ws], blocked)
            plan.extend(path)
            pos = _apply_actions(pos, path)

            # Perform the crafting action.
            plan.append(USE)
        else:
            # No visible workshop – attempt to craft in place (some recipes may allow it).
            plan.append(USE)
    else:
        # No specific workshop required; simply use the USE action to craft.
        plan.append(USE)

    return plan


    import collections, numpy as np

    # Action indices (standard in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from `start`
    # to a cell adjacent (Manhattan distance == 1) to any of `targets`.
    # `blocked` is a 2‑D bool array where True means the cell cannot be entered.
    # ------------------------------------------------------------------
    def bfs_adjacent(start, targets, blocked):
        w, h = blocked.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # Check adjacency to any target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No path found.
        return []

    # ------------------------------------------------------------------
    # Helper: apply a list of actions to a position, returning the new position.
    # ------------------------------------------------------------------
    def apply_actions(pos, actions):
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

