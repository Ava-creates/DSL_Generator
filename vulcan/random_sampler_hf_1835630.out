    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    import collections
    import numpy as np

    # Action indices as defined in the environment
    # 0 = DOWN, 1 = UP, 2 = LEFT, 3 = RIGHT, 4 = USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    def bfs(start, targets, blocked):
        """Return a list of actions that moves from start to any cell in targets."""
        w, h = blocked.shape
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # Should never happen for solvable tasks
        return []

    def go_to_and_use(kind_idx, count):
        """Move to cells containing `kind_idx` and USE them `count` times."""
        nonlocal pos, actions, grid, w, h, blocked
        for _ in range(count):
            # locate all cells that currently hold the required kind
            cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)  # USE action
            # after picking up the primitive the cell becomes empty;
            # primitives are grabbable, so `blocked` does not need to be updated

    # ----------------------------------------------------------------------
    # Gather recipe information for the target item "arrow"
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}          # primitive kind -> total count required
    craft_steps = []           # list of (item_idx, count) in correct order

    def resolve(item_idx, mult):
        """Recursively collect primitive needs and schedule crafting steps."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:
            # No recipe → primitive resource
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # Resolve ingredients first (ignore special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # Schedule this item to be crafted after its ingredients
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # Static environment data
    # ----------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Build the action sequence
    # ----------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Collect all required primitive resources
    for kind_idx, cnt in needed_prims.items():
        go_to_and_use(kind_idx, cnt)

    # 2) Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        # workshop identifier may be stored under "_at" or "_key"
        wk_key = rec.get("_at", rec.get("_key"))
        if isinstance(wk_key, int):
            wk_idx = wk_key
        else:
            wk_idx = cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        # Use the workshop the required number of times
        actions.extend([4] * cnt)

    return actions


    import collections, numpy as np

    # ----------------------------------------------------------------------
    # Helper: BFS path planning (returns list of action indices)
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN,UP,LEFT,RIGHT as in env
    def bfs(start, targets, blocked):
        w, h = blocked.shape
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # should not happen for solvable tasks

    # ----------------------------------------------------------------------
    # Move to a cell containing a given kind and USE it `cnt` times
    # ----------------------------------------------------------------------
    def go_to_and_use(kind_idx, cnt, grid, blocked, pos, actions):
        w, h, _ = grid.shape
        for _ in range(cnt):
            cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)          # USE
        return pos

    # ----------------------------------------------------------------------
    # Gather recipe information for the target item "arrow"
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}          # primitive kind -> total count needed
    craft_steps = []           # list of (item_idx, count) in crafting order

    def resolve(item_idx, mult):
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # first resolve ingredients (ignore special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # then schedule this item to be crafted
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # Static environment data
