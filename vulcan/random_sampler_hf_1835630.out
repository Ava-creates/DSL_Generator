    env.reset()
    state = env._current_state
    world = env.world

    # Index of the target item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # BFS that returns a list of movement actions (0‑3) which bring the
    # agent to a cell whose *front* contains `target_kind`. Returns [] if
    # already adjacent, or None if unreachable.
    # ------------------------------------------------------------------
    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)
        deltas = {0: (0, 1),   # DOWN
                  1: (0, -1),  # UP
                  2: (-1, 0),  # LEFT
                  3: (1, 0)}   # RIGHT

        def _in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def _walkable(x, y):
            return _in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        sx, sy = cur_state.pos
        sd = cur_state.dir
        q = deque()
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts  # target is directly in front

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not _walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:          # arrow itself may be primitive
        needed = {arrow_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            path = _bfs_to_target(state, prim_idx)
            if path is None:
                return actions  # cannot reach required primitive
            actions.extend(path)
            actions.append(4)                 # USE to pick up
            for a in path + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its workshop (if any), otherwise craft in place.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        path = _bfs_to_target(state, workshop_idx)
        if path is None:
            return actions
        actions.extend(path)
        actions.append(4)                     # USE to craft
        for a in path + [4]:
            _, state = state.step(a)
    else:
        actions.append(4)                     # USE to craft in place
        _, state = state.step(4)

    return actions


    # Reset environment and get initial references
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the target item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ----------------------------------------------------------------------
    # Helper: Bread‑first search that returns a list of movement actions
    # (0‑3) which brings the agent to a cell where the tile directly in front
    # of the agent contains `target_kind`.  Returns [] if already adjacent,
    # and None if the target cannot be reached.
    # ----------------------------------------------------------------------
    def _bfs_to_target(cur_state, target_kind):
        grid = cur_state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def _in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def _walkable(x, y):
            # a cell is walkable if it is inside the grid and empty
            return _in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = cur_state.pos
        sd = cur_state.dir
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts  # target is directly in front

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not _walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return None

    # ----------------------------------------------------------------------
    # Determine which primitive resources are required for a single arrow.
    # ----------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)
    if not needed:               # arrow itself is a primitive resource
        needed = {arrow_idx: 1}

    plan = []

    # ----------------------------------------------------------------------
    # 1) Collect each required primitive the needed number of times.
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            path = _bfs_to_target(state, prim_idx)
            if path is None:          # unreachable primitive – abort
                return plan
            plan.extend(path)
            plan.append(4)            # USE to pick it up
            for a in path + [4]:
                _, state = state.step(a)

    # ----------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        path = _bfs_to_target(state, workshop_idx)
        if path is None:              # unreachable workshop – abort
            return plan
        plan.extend(path)
        plan.append(4)                # USE to craft
        for a in path + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop – craft in place
        plan.append(4)
        _, state = state.step(4)

    return plan

