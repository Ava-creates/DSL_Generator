    from collections import deque

    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    def bfs(start, goals):
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(kind_idx, amount):
        nonlocal actions, grid, inventory, pos
        while amount > 0:
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, kind_idx] > 0]
            if not locations:
                raise RuntimeError("Required primitive not found on map")
            chosen_path = None
            chosen_loc = None
            for loc in locations:
                path = bfs(pos, {loc})
                if path is not None:
                    chosen_path = path
                    chosen_loc = loc
                    break
            if chosen_path is None:
                raise RuntimeError("Primitive is unreachable")
            actions.extend(chosen_path)
            move_along(chosen_path)
            actions.append(4)  # USE
            grid[chosen_loc[0], chosen_loc[1], kind_idx] = 0
            inventory[kind_idx] += 1
            amount -= 1

    recipes = cookbook.recipes
    primitives = cookbook.primitives

    def ensure_item(item_idx, needed):
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < needed:
            if item_idx in primitives:
                collect_primitive(item_idx, needed - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if not ws_cells:
                    raise RuntimeError("Required workshop not present on map")
                path = bfs(pos, {ws_cells[0]})
                if path is None:
                    raise RuntimeError("Workshop is unreachable")
                actions.extend(path)
                move_along(path)

            actions.append(4)  # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    ensure_item(target_idx, 1)

    return actions

