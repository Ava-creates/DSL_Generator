    # Reset environment and extract underlying objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for bookkeeping

    # Action indices according to the environment's spec
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # Indices that block movement (non‑grabbable entities)
    non_grab = list(world.non_grabbable_indices)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque

    def bfs(start, goal):
        """Return a list of movement actions that moves the agent from
        ``start`` to ``goal`` while avoiding occupied or non‑grabbable cells.
        The goal cell itself is allowed even if it is occupied (used for
        reaching a workshop)."""
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}                     # maps cell -> previous cell
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct path
                actions = []
                cur = goal
                while cur != start:
                    py, px = prev[cur]
                    dy, dx = cur[0] - py, cur[1] - px
                    if dy == 1:
                        actions.append(DOWN)
                    elif dy == -1:
                        actions.append(UP)
                    elif dx == 1:
                        actions.append(RIGHT)
                    elif dx == -1:
                        actions.append(LEFT)
                    cur = (py, px)
                actions.reverse()
                return actions

            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # Goal cell may be occupied (e.g., workshop)
                    if (ny, nx) != goal:
                        # block if any non‑grabbable entity occupies the cell
                        if np.any(grid[ny, nx, non_grab] > 0):
                            continue
                        # block if any entity occupies the cell
                        if np.any(grid[ny, nx, :] > 0):
                            continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list (should not happen for valid tasks)
        return []

    def nearest_cell(kind_idx, from_pos):
        """Find the coordinates of the nearest cell containing ``kind_idx``.
        Returns None if the kind does not appear on the grid."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def empty_adjacent(pos):
        """Return an empty neighbour of ``pos`` (or None)."""
        y, x = pos
        H, W = grid.shape[:2]
        for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            ny, nx = y + dy, x + dx
            if 0 <= ny < H and 0 <= nx < W:
                # cell must be completely empty (no entities)
                if not np.any(grid[ny, nx, :] > 0):
                    return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = nearest_cell(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort planning.
                return actions

            # Choose a free adjacent cell to stand on (fallback to the target cell itself)
            adj = empty_adjacent(target)
            if adj is None:
                adj = target

            # Move to the chosen adjacent cell
            actions += bfs(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (issue a move that would be blocked if adjacent)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update bookkeeping grid (primitive removed)
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest_cell(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE triggers crafting
    actions.append(USE)

    return actions

