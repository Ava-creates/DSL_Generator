    # Action indices (as defined in CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions to move from start to goal.
    # The goal cell may be occupied (e.g., contains the needed item), but
    # all intermediate cells must be empty.
    # ------------------------------------------------------------------
    def _bfs_path(grid, start, goal):
        h, w, _ = grid.shape
        from collections import deque
        q = deque()
        q.append((start, []))
        visited = {start}
        moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]
        while q:
            (r, c), path = q.popleft()
            if (r, c) == goal:
                return path
            for act, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if (nr, nc) in visited:
                    continue
                # allow stepping onto the goal even if it is occupied
                if (nr, nc) == goal or np.all(grid[nr, nc, :] == 0):
                    visited.add((nr, nc))
                    q.append(((nr, nc), path + [act]))
        return None  # no path found

    # ------------------------------------------------------------------
    # Helper: Find the nearest cell that contains a given kind (BFS).
    # Returns (position, path_to_position) or (None, None) if not found.
    # ------------------------------------------------------------------
    def _nearest_of_kind(grid, kind_idx, start):
        h, w, _ = grid.shape
        from collections import deque
        q = deque()
        q.append((start, []))
        visited = {start}
        moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]
        while q:
            (r, c), path = q.popleft()
            if grid[r, c, kind_idx] > 0:
                return (r, c), path
            for act, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if (nr, nc) in visited:
                    continue
                if np.all(grid[nr, nc, :] == 0):  # walk only through empty cells
                    visited.add((nr, nc))
                    q.append(((nr, nc), path + [act]))
        return None, None

    # ------------------------------------------------------------------
    # Identify the index of the target item "arrow"
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        # Arrow not defined in this world
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting multiplicities)
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            target_pos, path = _nearest_of_kind(state.grid, prim_idx, state.pos)
            if target_pos is None:
                # required primitive not found – abort early
                return action_seq
            # Follow the path to the primitive
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick up the primitive
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos, path = _nearest_of_kind(state.grid, workshop_idx, state.pos)
        if workshop_pos is not None:
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Craft at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
    else:
        # No specific workshop required – attempt to craft in place
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq

