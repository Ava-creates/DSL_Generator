    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world
    idx = world.cookbook.index
    recipes = world.cookbook.recipes
    primitives = world.cookbook.primitives

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # brings the agent to a position where the cell directly in front
    # contains `target_kind`. Returns None if unreachable.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sd = state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # --------------------------------------------------------------
    # Recursive planner that ensures `item_idx` is present `need` times
    # in the inventory, updating `cur_state` and appending actions to
    # `plan`.
    # --------------------------------------------------------------
    plan = []

    def _ensure(item_idx, need):
        # Loop until we have enough of the item.
        while cur_state.inventory[item_idx] < need:
            # Primitive: just go pick it up.
            if item_idx in primitives:
                seq = _bfs_to_target(cur_state, item_idx)
                if seq is None:
                    return False
                plan.extend(seq)
                plan.append(4)          # USE to pick up
                for a in seq + [4]:
                    _, cur_state = cur_state.step(a)
                continue

            # Non‑primitive: we must craft it.
            recipe = recipes.get(item_idx, {})
            # First, guarantee all ingredients.
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                # Need `cnt` of each ingredient for ONE craft.
                # Ensure we have at least current + cnt.
                target = cur_state.inventory[ing_idx] + cnt
                if not _ensure(ing_idx, target):
                    return False

            # Move to the required workshop (if any).
            workshop_name = recipe.get("_at")
            if workshop_name is not None:
                workshop_idx = idx.index(workshop_name)
                seq = _bfs_to_target(cur_state, workshop_idx)
                if seq is None:
                    return False
                plan.extend(seq)
                for a in seq:
                    _, cur_state = cur_state.step(a)

            # Perform the crafting action.
            plan.append(4)                # USE to craft
            _, cur_state = cur_state.step(4)
        return True

    # --------------------------------------------------------------
    # Start planning for the goal item "arrow".
    # --------------------------------------------------------------
    arrow_idx = idx.index("arrow")
    if arrow_idx == 0:          # Arrow not defined in this world.
        return []

    if not _ensure(arrow_idx, 1):
        # Planning failed – return whatever we have gathered so far.
        return plan

    return plan


    env.reset()
    cur_state = env._current_state
    world = env.world
    ...
    return actions

