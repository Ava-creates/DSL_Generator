    # Helper: map direction vectors to action indices (assumes standard ordering)
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ----------------------------------------------------------------------
    # BFS: find actions to reach a cell adjacent (Manhattan distance 1) to any
    # target cell while avoiding non‑grabbable obstacles.
    # ----------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_to_adjacent(start, targets, grid):
        """Return list of actions moving from ``start`` to a position adjacent
        to any cell in ``targets``. ``grid`` is (W, H, K); a cell is blocked if
        any non‑grabbable kind is present."""
        W, H = grid.shape[:2]
        # blocked if any non‑grabbable kind has a positive count in that cell
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start
        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency
        return []

    # ----------------------------------------------------------------------
    # Main planning logic
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()            # local mutable copy
    pos = tuple(state.pos)              # (x, y)

    # Goal index (environment task stores it in env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # Primitive requirements for the goal (including intermediate items)
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives (including intermediates).
    # ------------------------------------------------------------------
    for kind_idx, cnt_needed in needed.items():
        while cnt_needed > 0:
            # Locate all cells that currently contain this kind
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # No more of this primitive on the map – abort planning.
                return plan

            # Find path to nearest reachable primitive (adjacent)
            path = bfs_to_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to update position
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive
            plan.append(4)   # USE
            # Identify which primitive cell we are now adjacent to
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Should not happen; break to avoid infinite loop.
                break

            # Update local grid copy (remove one instance) and decrement need
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt_needed -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a string name)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft by using the workshop
            plan.append(4)   # USE

    return plan


    # Helper to map movement delta to action index (matches CraftLab spec)
    DIR_TO_ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}

    # ------------------------------------------------------------------
    # BFS returning actions to reach a cell adjacent to any target cell.
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs(start_pos, target_cells, grid, block_set):
        """Return list of actions moving from ``start_pos`` to a position
        adjacent (Manhattan distance 1) to any cell in ``target_cells``.
        ``grid`` shape (W, H, K). Cells containing any index in ``block_set``
        are considered blocked.
        """
        W, H = grid.shape[:2]
        # pre‑compute blocked boolean map
        blocked = np.zeros((W, H), dtype=bool)
        for b in block_set:
            blocked |= grid[:, :, b] > 0

        sx, sy = start_pos
        # already adjacent?
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR_TO_ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # check adjacency to any target
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []  # no reachable adjacency

    # ------------------------------------------------------------------
    # Initialise environment and extract task information.
    # ------------------------------------------------------------------
    obs = env.reset()
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)                     # (x, y)

    # Goal index from the task definition.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # Primitive requirements for the goal (only primitives, counts).
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    block_set = env.world.non_grabbable_indices

    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        while needed_cnt > 0:
            # Locate remaining instances of this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more of this primitive on the map – abort planning.
                return plan

            # Compute path to the nearest reachable primitive (adjacent).
            path = bfs(pos, prim_cells.tolist(), grid, block_set)
            plan.extend(path)

            # Simulate movement to update ``pos``.
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive.
            plan.append(4)   # USE
            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected – break to avoid infinite loop.
                break

            # Update local grid copy (remove one instance) and decrement need.
            grid[adj_cell[0], adj_cell[1], prim_idx] -= 1
            needed_cnt -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get('_at') or recipe.get('_key')
    if workshop_key is not None:
        # Resolve workshop index (may be string name or int).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid, block_set)
            plan.extend(path)
            for a in path:
                dx, dy = ACT_TO_DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft by using the workshop.
            plan.append(4)   # USE

    return plan

