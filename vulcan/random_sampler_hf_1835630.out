    # Reset the environment to obtain a fresh state.
    env.reset()
    state = env._current_state
    grid = state.grid
    pos = tuple(state.pos)

    # Action indices: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE
    ACTION_USE = 4
    # Direction vectors matching the above order.
    dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    # ------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of action indices that
    # moves the agent from `start` to `goal` while avoiding occupied cells.
    # ------------------------------------------------------------------
    def bfs(start, goal, occupied):
        from collections import deque
        W, H = occupied.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) == goal:
                return path
            for a, (dx, dy) in enumerate(dirs):
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not occupied[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [a]))
        return None

    # Cells that contain *any* entity are considered blocked.
    occupied = np.any(grid, axis=2)

    # ------------------------------------------------------------------
    # Retrieve the recipe for the target item "arrow".
    # ------------------------------------------------------------------
    idx = env.world.cookbook.index
    try:
        arrow_idx = idx['arrow']
    except Exception:
        return []
    recipe = env.world.cookbook.recipes.get(arrow_idx, {})
    if not recipe:
        return []
    workshop_idx = recipe['_at']
    ingredients = {k: v for k, v in recipe.items() if k != '_at'}

    actions = []

    # ------------------------------------------------------------------
    # Move to a free cell adjacent to `target_pos` and make sure the
    # agent ends up facing the target (direction `need_dir`).
    # ------------------------------------------------------------------
    def go_adjacent(target_pos, need_dir):
        nonlocal pos, occupied, actions
        for a_idx, (dx, dy) in enumerate(dirs):
            ax, ay = target_pos[0] - dx, target_pos[1] - dy
            if 0 <= ax < occupied.shape[0] and 0 <= ay < occupied.shape[1] and not occupied[ax, ay]:
                path = bfs(pos, (ax, ay), occupied)
                if path is None:
                    continue
                # follow the path
                actions.extend(path)
                for a in path:
                    dxp, dyp = dirs[a]
                    pos = (pos[0] + dxp, pos[1] + dyp)

                # Ensure we are facing the target.
                # Desired facing direction is `need_dir`. If we are not already
                # facing it, perform a tiny detour: step opposite then step back.
                opp = need_dir ^ 1                     # 0↔1, 2↔3
                ox, oy = pos[0] - dirs[need_dir][0], pos[1] - dirs[need_dir][1]
                if 0 <= ox < occupied.shape[0] and 0 <= oy < occupied.shape[1] and not occupied[ox, oy]:
                    actions.append(opp)
                    pos = (ox, oy)
                    actions.append(need_dir)
                    pos = (pos[0] + dirs[need_dir][0], pos[1] + dirs[need_dir][1])
                else:
                    # Fallback: try any other free neighbour then the needed direction.
                    for alt in range(4):
                        if alt == need_dir:
                            continue
                        nx, ny = pos[0] + dirs[alt][0], pos[1] + dirs[alt][1]
                        if 0 <= nx < occupied.shape[0] and 0 <= ny < occupied.shape[1] and not occupied[nx, ny]:
                            actions.append(alt)
                            pos = (nx, ny)
                            actions.append(need_dir)
                            pos = (pos[0] + dirs[need_dir][0], pos[1] + dirs[need_dir][1])
                            break
                return True
        return False

    # ------------------------------------------------------------------
    # Gather all required primitive ingredients.
    # ------------------------------------------------------------------
    for ing_idx, cnt in ingredients.items():
        for _ in range(cnt):
            # locate any remaining instance of this ingredient
            locs = np.argwhere(grid[:, :, ing_idx] > 0)
            if len(locs) == 0:
                return actions
            # pick the closest one (Manhattan distance)
            dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])
            target = tuple(locs[dists.argmin()])

            # Find a direction that gives a free adjacent cell.
            collected = False
            for dir_idx, (dx, dy) in enumerate(dirs):
                adj = (target[0] - dx, target[1] - dy)
                if 0 <= adj[0] < occupied.shape[0] and 0 <= adj[1] < occupied.shape[1] and not occupied[adj[0], adj[1]]:
                    if go_adjacent(target, dir_idx):
                        actions.append(ACTION_USE)   # pick up the primitive
                        occupied[target[0], target[1]] = False   # cell becomes free
                        collected = True
                        break
            if not collected:
                return actions

    # ------------------------------------------------------------------
    # Go to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if len(workshop_cells) == 0:
        return actions
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop = tuple(workshop_cells[dists.argmin()])

    for dir_idx, (dx, dy) in enumerate(dirs):
        adj = (workshop[0] - dx, workshop[1] - dy)
        if 0 <= adj[0] < occupied.shape[0] and 0 <= adj[1] < occupied.shape[1] and not occupied[adj[0], adj[1]]:
            if go_adjacent(workshop, dir_idx):
                actions.append(ACTION_USE)   # craft the arrow
                break

    return actions


    # Retrieve world and goal information
    world = env.world
    # Index of the target item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    # Primitive requirements for one arrow
    primitive_needs = world.cookbook.primitives_for(arrow_idx)

    # Identify the workshop where the arrow must be crafted
    workshop_idx = None
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    if "_at" in recipe:
        workshop_idx = recipe["_at"]

    # Action mapping (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4 in default specs)
    action_map = env.action_specs()
    # Helper to generate a straight‑line move sequence
    def _move_actions(start, target):
        sx, sy = start
        tx, ty = target
        seq = []
        while sx < tx:
            seq.append(action_map["DOWN"])
            sx += 1
        while sx > tx:
            seq.append(action_map["UP"])
            sx -= 1
        while sy < ty:
            seq.append(action_map["RIGHT"])
            sy += 1
        while sy > ty:
            seq.append(action_map["LEFT"])
            sy -= 1
        return seq

    # Current state information
    state = env._current_state
    cur_pos = tuple(state.pos)
    grid = state.grid
    actions = []

    # Collect each required primitive (respecting the required count)
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # Find any cell that still contains the primitive
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # No more of this primitive on the map – give up early
                break
            # Choose the first available location
            target = tuple(locations[0])
            # Move to that cell
            actions.extend(_move_actions(cur_pos, target))
            cur_pos = target
            # Pick it up (USE interacts with the cell the agent is on)
            actions.append(action_map["USE"])
            # Update our simulated view of the grid so we don't try to pick the same item again
            grid[target[0], target[1], prim_idx] = max(0, grid[target[0], target[1], prim_idx] - 1)

    # Finally move to the appropriate workshop and craft the arrow
    if workshop_idx is not None:
        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            workshop_pos = tuple(workshop_cells[0])
            actions.extend(_move_actions(cur_pos, workshop_pos))
            cur_pos = workshop_pos
            # Use the workshop to craft the arrow
            actions.append(action_map["USE"])

    return actions

