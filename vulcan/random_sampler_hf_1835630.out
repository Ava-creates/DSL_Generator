    # 1. Collect all primitive resources required for the goal item
    # ------------------------------------------------------------------
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, needed in primitive_requirements.items():
        for _ in range(needed):
            target = nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive not found – abort planning
                return actions
            actions.extend(bfs_path(cur_pos, target, grid))
            actions.append(USE)                     # pick up the primitive
            grid[target[0], target[1], prim_kind] = 0   # remove from simulated grid
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)   # perform crafting at the workshop
            cur_pos = workshop_pos

    return actions


    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    moves = [
        ((0, 1), DOWN),   # down
        ((0, -1), UP),    # up
        ((-1, 0), LEFT),  # left
        ((1, 0), RIGHT),  # right
    ]

    def bfs_path(start, goal, grid):
        """Return list of actions to move from start to goal using BFS.
        Cells containing any non‑zero kind are treated as blocked, except the
        goal cell itself (which may be occupied by the target item or workshop)."""
        w, h = grid.shape[0], grid.shape[1]
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []   # unreachable
        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def nearest_kind(kind_idx, cur_pos, grid):
        """Find nearest cell (Manhattan) containing the given kind."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if len(xs) == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Initial state extraction
    # ----------------------------------------------------------------------
    # Current position (use live state if available)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Static grid copy for planning (we will modify it as we pick up items)
    grid = env.scenario.init_grid.copy()

    # Simulated inventory (starts empty)
    inv = np.zeros(env.world.cookbook.n_kinds, dtype=int)

    # Goal item index
    goal_idx = env.task.goal

    # ----------------------------------------------------------------------
    # Planning utilities
    # ----------------------------------------------------------------------
    primitives = env.world.cookbook.primitives
    recipes = env.world.cookbook.recipes

    actions = []

    def ensure_item(item_idx, count):
        """Make sure `inv[item_idx]` is at least `count`, updating actions."""
        nonlocal cur_pos, grid, inv, actions

        while inv[item_idx] < count:
            # If item is a primitive, just collect it
            if item_idx in primitives:
                target = nearest_kind(item_idx, cur_pos, grid)
                if target is None:
                    # cannot find required primitive – abort planning
                    return False
                actions.extend(bfs_path(cur_pos, target, grid))
                actions.append(USE)                     # pick up
                grid[target[0], target[1], item_idx] = 0   # remove from world
                inv[item_idx] += 1
                cur_pos = target
                continue

            # Otherwise we need to craft it using its recipe
            recipe = recipes.get(item_idx, {})
            if not recipe:
                # No recipe and not primitive – impossible
                return False

            # First ensure all ingredient counts
            for ing_idx, ing_cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                if not ensure_item(ing_idx, ing_cnt):
                    return False

            # Move to the required workshop (if any)
            workshop_kind = recipe.get("_at")
            if workshop_kind is not None:
                workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)
                if workshop_pos is None:
                    return False
                actions.extend(bfs_path(cur_pos, workshop_pos, grid))
                actions.append(USE)   # perform crafting
                cur_pos = workshop_pos
            else:
                # No specific workshop – just use current cell
                actions.append(USE)

            # Update simulated inventory: consume ingredients, add product
            for ing_idx, ing_cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inv[ing_idx] -= ing_cnt
            inv[item_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Execute planning for the final goal
    # ----------------------------------------------------------------------
    ensure_item(goal_idx, 1)

    # Return the assembled action sequence
    return actions

