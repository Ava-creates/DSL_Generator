    # ------------------------------------------------------------------
    from collections import deque

    def bfs_to_adjacent(start: tuple[int, int],
                        targets: list[tuple[int, int]],
                        grid: np.ndarray) -> list[str] | None:
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
