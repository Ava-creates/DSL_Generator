    # Resolve scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Identify the index of the target item ("arrow")
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting state
    try:
        start_state = scenario.init()
    except Exception:
        return []

    # Helper to create a hashable representation of a state
    def _state_key(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    from collections import deque

    Node = tuple  # (state, action_list)

    visited = set()
    frontier = deque()
    frontier.append((start_state, []))
    visited.add(_state_key(start_state))

    # Search parameters
    MAX_STEPS = 300
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        cur_state, actions = frontier.popleft()

        # Goal test
        if cur_state.satisfies("", target_idx):
            return actions

        if len(actions) >= MAX_STEPS:
            continue

        # Expand neighbours
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append((nxt_state, actions + [a]))

    # No plan found within limits
    return []


