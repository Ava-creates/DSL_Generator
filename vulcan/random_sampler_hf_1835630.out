    import numpy as np

    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Reset the environment and fetch core objects
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                    # (WIDTH, HEIGHT, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` using a simple Manhattan walk.
        No obstacle checking is performed."""
        y0, x0 = start
        y1, x1 = goal
        actions = []
        dy, dx = y1 - y0, x1 - x0
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing ``kind_idx``. Returns (y, x) or None."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine goal index for 'arrow' and its primitive requirements
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            ty, tx = target

            # Choose a free adjacent cell to stand on while picking up.
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour – stand on the primitive cell itself.
                adj = target

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (if not standing on it).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # If a specific workshop is required, move to it.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # ------------------------------------------------------------------
    # Trigger crafting of the arrow.
    # ------------------------------------------------------------------
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # Action constants as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # Reset the environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    # Make a mutable copy of the grid so we can update it after picking items
    grid = state.grid.copy()

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def cell_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return grid[y, x].any()

    def bfs(start, goal):
        """Return a list of actions to move from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        while q:
            y, x, path = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_blocked(ny, nx):
                    continue
                new_path = path + [act]
                if (ny, nx) == goal:
                    return new_path
                visited.add((ny, nx))
                q.append((ny, nx, new_path))
        # No path found – return empty list (caller may handle)
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell, forbidden=set()):
        """Return a free neighbour of ``cell`` not in ``forbidden``."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in forbidden:
                continue
            if not cell_blocked(ny, nx):
                return (ny, nx)
        return None

    def face_towards(src, dst):
        """Return a single movement action that makes src face dst (may be None if already aligned)."""
        dy, dx = dst[0] - src[0], dst[1] - src[1]
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None

    actions = []
    cur_pos = state.pos               # (y, x)
    harvested_cells = set()           # remember where we already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early
                return actions

            # Choose a free adjacent cell to stand on while picking up
            adj = free_adjacent(target, forbidden=harvested_cells)
            if adj is None:
                # No free neighbour; fall back to staying where we are
                adj = cur_pos

            # Move to the chosen adjacent cell
            actions += bfs(cur_pos, adj)
            cur_pos = adj

            # Face the primitive and pick it up
            face_act = face_towards(cur_pos, target)
            if face_act is not None:
                actions.append(face_act)
            actions.append(USE)

            # Update internal grid copy so future searches ignore this cell
            grid[target[0], target[1], prim_idx] = 0
            harvested_cells.add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = free_adjacent(ws_cell, forbidden=harvested_cells)
            if ws_adj is None:
                ws_adj = cur_pos
            actions += bfs(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop before using
            face_act = face_towards(cur_pos, ws_cell)
            if face_act is not None:
                actions.append(face_act)

    # Final USE to trigger crafting (or to craft directly if no workshop)
    actions.append(USE)

    return actions

