    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    actions = []

    # ------------------------------------------------------------------
    # Determine current position (use live state if available)
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)  # [x, y]
    else:
        cur_pos = list(env.scenario.init_pos)   # [x, y]

    # Work on a mutable copy of the static grid for planning
    grid = env.scenario.init_grid.copy()

    # Goal item index
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    _MOVES = [((0, 1), DOWN),   # down  (y+1)
              ((0, -1), UP),    # up    (y-1)
              ((-1, 0), LEFT),  # left  (x-1)
              ((1, 0), RIGHT)]  # right (x+1)

    def _bfs_path(start, goal, occ_grid):
        """Return a list of actions moving from start to goal using BFS.
        Cells containing any non‑zero kind are treated as blocked,
        except the goal cell itself."""
        w, h = occ_grid.shape[0], occ_grid.shape[1]   # width, height
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}           # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in _MOVES:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal cell even if occupied
                if (nx, ny) != tuple(goal) and occ_grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []   # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def _nearest_kind(kind_idx, cur, occ_grid):
        """Find the nearest cell containing the requested kind (Manhattan distance)."""
        xs, ys = np.where(occ_grid[:, :, kind_idx] > 0)   # xs: x‑coords, ys: y‑coords
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the goal.
    # ------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()

    # If the goal itself is a primitive we also need to pick it up.
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Primitive not found – abort planning.
                return actions
            actions.extend(_bfs_path(cur_pos, target, grid))
            actions.append(USE)                     # pick up the primitive
            # Mark the cell as empty for subsequent planning
            grid[target[1], target[0], kind_idx] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(_bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)                     # perform crafting at the workshop
            cur_pos = workshop_pos

    # Return the complete action sequence
    return actions


    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    # Movement vectors paired with their corresponding action index
    _MOVES = [
        ((0, 1), DOWN),   # down  (y+1)
        ((0, -1), UP),    # up    (y-1)
        ((-1, 0), LEFT),  # left  (x-1)
        ((1, 0), RIGHT),  # right (x+1)
    ]

    def _bfs_path(start, goal, grid):
        """Return a list of actions that moves from start to goal using BFS.
        Cells that contain any non‑zero kind are treated as blocked,
        except the goal cell itself (which may hold the target item)."""
        w, h = grid.shape[0], grid.shape[1]          # width (x), height (y)
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in _MOVES:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal cell even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []   # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell containing the requested kind (Manhattan)."""
        xs, ys = np.where(grid[:, :, kind_idx] > 0)   # xs: x‑coords, ys: y‑coords
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Planning start
    # ------------------------------------------------------------------
    actions = []

    # Determine current position (prefer live state if available)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Mutable copy of the static grid for planning (so we can “remove” items once taken)
    grid = env.scenario.init_grid.copy()

    # Goal item index
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the goal.
    # ------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()

    # If the goal itself is a primitive we also need to pick it up.
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Primitive not found – abort planning.
                return actions
            # Move to the primitive
            actions.extend(_bfs_path(cur_pos, target, grid))
            # Pick it up
            actions.append(USE)
            # Mark the cell as empty for subsequent planning
            grid[target[0], target[1], kind_idx] = 0
            # Update current position
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(_bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)          # perform crafting at the workshop
            cur_pos = workshop_pos

    # Return the complete action sequence
    return actions

