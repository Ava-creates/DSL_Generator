    # Reset environment and fetch initial state and world reference
    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # arrow not defined in this world
        return []

    # Determine primitive requirements for a single arrow.
    # If the recipe dict is empty, treat the arrow itself as a primitive to pick up.
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # BFS that returns a list of movement actions (0‑3) that brings the
    # agent to a position where the cell directly in front contains
    # `target_kind`. Returns None if unreachable.
    # ------------------------------------------------------------------
    def _bfs_to_target(st, target_kind):
        grid = st.grid
        W, H = grid.shape[:2]

        # action → (dx, dy) for movement actions
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        q.append((st.pos[0], st.pos[1], st.dir, []))
        visited = {(st.pos[0], st.pos[1], st.dir)}

        while q:
            x, y, d, seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return seq

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))
        return None

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            move_seq = _bfs_to_target(state, prim_idx)
            if move_seq is None:
                # Primitive unreachable – abort and return what we have.
                return actions
            actions.extend(move_seq)
            actions.append(4)            # USE to pick up / interact

            # Keep simulated state in sync.
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(state, workshop_idx)
        if move_seq is not None:
            actions.extend(move_seq)
            actions.append(4)            # USE to craft
            for a in move_seq + [4]:
                _, state = state.step(a)
    else:
        # No specific workshop – craft (or already have) in place.
        actions.append(4)                # USE to craft / finish
        _, state = state.step(4)

    return actions


    # Reset environment and get initial state / world reference
    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify the index for the goal item "arrow".  If not present, nothing
    # to do.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) which places
    # the agent so that the cell directly in front of it contains `target`.
    # Returns None if the target cannot be reached.
    # ------------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # Mapping from action id to (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        sx, sy = state.pos
        sdir = state.dir
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # ------------------------------------------------------------------
    # Recursive planner that ensures the inventory contains at least one
    # instance of `item_idx`.  Returns the updated state and the list of
    # actions performed to obtain the item.
    # ------------------------------------------------------------------
    def _obtain(item_idx, state):
        # If we already have the item, nothing to do.
        if state.inventory[item_idx] > 0:
            return state, []

        # ------------------------------------------------------------------
        # Primitive items are collected directly from the world.
        # ------------------------------------------------------------------
        if item_idx in world.cookbook.primitives:
            seq = _bfs_to_target(state, item_idx)
            if seq is None:
                # Unreachable primitive – abort planning for this branch.
                return state, []
            actions = seq + [4]          # 4 == USE
            for a in actions:
                _, state = state.step(a)
            return state, actions

        # ------------------------------------------------------------------
        # Craftable items: first obtain all ingredients, then craft at the
        # required workshop (if any).
        # ------------------------------------------------------------------
        recipe = world.cookbook.recipes.get(item_idx, {})
        plan_actions = []

        # Gather ingredients (skip the special "_at" key)
        for ing_idx, cnt in recipe.items():
            if ing_idx == "_at":
                continue
            for _ in range(cnt):
                state, sub_actions = _obtain(ing_idx, state)
                plan_actions.extend(sub_actions)

        # Move to workshop (if the recipe specifies one) and craft.
        workshop_name = recipe.get('_at')
        if workshop_name is not None:
            wk_idx = world.cookbook.index.index(workshop_name)
            seq = _bfs_to_target(state, wk_idx)
            if seq is None:
                return state, plan_actions
            actions = seq + [4]
        else:
            actions = [4]               # craft in place

        for a in actions:
            _, state = state.step(a)
        plan_actions.extend(actions)
        return state, plan_actions

    # ------------------------------------------------------------------
    # Build the complete plan for a single arrow.
    # ------------------------------------------------------------------
    final_state, action_plan = _obtain(arrow_idx, cur_state)
    return action_plan

