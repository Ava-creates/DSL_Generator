    # ----------------------------------------------------------------------
    # Retrieve world and target index
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Initial state
    # ----------------------------------------------------------------------
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    from collections import namedtuple
    import heapq

    Node = namedtuple("Node", ["f", "g", "state", "actions"])

    def _state_hash(st):
        """Hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    def _heuristic(st):
        """
        Simple admissible heuristic: total missing count of primitive
        resources that are directly required for the target item.
        """
        need = world.cookbook.primitives_for(target_idx)
        missing = 0
        for p_idx, cnt in need.items():
            have = int(st.inventory[p_idx])
            if have < cnt:
                missing += cnt - have
        return missing

    # ----------------------------------------------------------------------
    # Search (A* style)
    # ----------------------------------------------------------------------
    visited = {_state_hash(init_state)}
    start_node = Node(f=_heuristic(init_state), g=0, state=init_state, actions=[])
    frontier = [start_node]                     # heap queue

    MAX_EXPANSIONS = 8000                       # safety bound
    expansions = 0
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = heapq.heappop(frontier)
        cur_state = node.state
        expansions += 1
        if expansions > MAX_EXPANSIONS:
            break

        # Goal test
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Expand possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            hsh = _state_hash(nxt_state)
            if hsh in visited:
                continue
            visited.add(hsh)

            g2 = node.g + 1
            f2 = g2 + _heuristic(nxt_state)
            heapq.heappush(frontier, Node(f=f2, g=g2, state=nxt_state,
                                         actions=node.actions + [a]))

    # If we exit the loop without a plan, return an empty list.
    return []


    # ----------------------------------------------------------------------
    # Retrieve the world and target item index
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Get the initial state of the episode
    # ----------------------------------------------------------------------
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Helper: hash a CraftState for fast visited‑set lookup
    # ----------------------------------------------------------------------
    def _state_hash(st):
        # Position, direction, inventory (as a tuple) and the whole grid
        # (converted to bytes for immutability)
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # ----------------------------------------------------------------------
    # BFS over the state space
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    visited = set()
    visited.add(_state_hash(init_state))

    frontier = deque([Node(init_state, [])])

    # Limit search depth to keep computation tractable
    MAX_STEPS = 2000

    n_actions = getattr(world, "n_actions", 5)

    # Prefer the USE action (index 4) before movement actions.
    if n_actions > 4:
        action_order = [4, 0, 1, 2, 3]
    else:
        action_order = list(range(n_actions))

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand neighbours
        for a in action_order:
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the step limit
    return []

