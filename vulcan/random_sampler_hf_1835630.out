    import collections

    # direction mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    def bfs(start, goals, blocked):
        """Return list of action indices to reach any goal cell."""
        w, h = blocked.shape
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in goals:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # unreachable – return empty list
        return []

    # ----------------------------------------------------------------------
    # Access world and recipe information
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # ----------------------------------------------------------------------
    # Prepare mutable copies of grid, inventory and blocked mask
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    w, h, _ = grid.shape

    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Helpers to move and interact
    # ----------------------------------------------------------------------
    cur_pos = tuple(state.pos)
    actions = []

    def move_to_cells(kind_idx):
        """Move to the nearest cell containing `kind_idx` and update state."""
        nonlocal cur_pos, actions, grid
        # locate all cells that still contain the kind
        cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
        if not cells:
            return
        path = bfs(cur_pos, cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)
        # after arriving, use the item
        actions.append(4)  # USE
        # update local grid and inventory
        x, y = cur_pos
        grid[x, y, kind_idx] = 0
        inventory[kind_idx] += 1

    def move_to_workshop(workshop_idx):
        """Move to any cell of the given workshop."""
        nonlocal cur_pos, actions
        cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, workshop_idx] > 0}
        if not cells:
            return
        path = bfs(cur_pos, cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)

    # ----------------------------------------------------------------------
    # Recursive planner to ensure we have `count` of `item_idx`
    # ----------------------------------------------------------------------
    def ensure(item_idx, count):
        """Collect or craft enough of `item_idx` to reach at least `count`."""
        nonlocal inventory
        if inventory[item_idx] >= count:
            return
        need = count - inventory[item_idx]

        if item_idx in cookbook.primitives:
            for _ in range(need):
                move_to_cells(item_idx)
        else:
            # craftable item
            recipe = cookbook.recipes[item_idx]
            workshop_key = recipe.get("_at", recipe.get("_key"))
            workshop_idx = (workshop_key if isinstance(workshop_key, int)
                            else cookbook.index[workshop_key])
            ingredients = {k: v for k, v in recipe.items() if isinstance(k, int)}
            for _ in range(need):
                # ensure each ingredient is available for one craft
                for ing_idx, ing_cnt in ingredients.items():
                    ensure(ing_idx, ing_cnt)
                # go to workshop and craft
                move_to_workshop(workshop_idx)
                actions.append(4)  # USE to craft
                # update inventory after crafting
                for ing_idx, ing_cnt in ingredients.items():
                    inventory[ing_idx] -= ing_cnt
                inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Ensure we have at least one arrow
    # ----------------------------------------------------------------------
    ensure(target_idx, 1)

    # Return the planned action sequence
    return actions


    import collections
    import numpy as np

    # direction mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    def bfs(start, goal_cells, blocked):
        """Bread‑first search returning a list of direction indices from start to the
        nearest cell in ``goal_cells`` while avoiding ``blocked`` cells."""
        w, h = start_grid.shape[:2]
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable in well‑formed scenarios

    # ----------------------------------------------------------------------
    # Access world / recipe information
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]
    recipes = cookbook.recipes

    # ----------------------------------------------------------------------
    # Grid, blocked‑cell mask and initial state
    # ----------------------------------------------------------------------
    start_grid = env._current_state.grid
    w, h, _ = start_grid.shape
    blocked_mask = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked_mask |= start_grid[:, :, idx] > 0

    actions = []
    cur_pos = tuple(env._current_state.pos)
    inventory = env._current_state.inventory.copy()

    # ----------------------------------------------------------------------
    # Helper: move to the nearest cell that contains a given kind and pick it up
    # ----------------------------------------------------------------------
    def move_to_and_pick(kind_idx):
        nonlocal cur_pos, actions, inventory
        # locate all cells that currently hold the item
        cells = {(x, y) for x in range(w) for y in range(h)
                 if start_grid[x, y, kind_idx] > 0}
        if not cells:
            return  # nothing to collect; should not happen for valid tasks
        path = bfs(cur_pos, cells, blocked_mask)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)
        actions.append(4)               # USE to pick up
        inventory[kind_idx] += 1

    # ----------------------------------------------------------------------
    # Recursive planner: ensure we have ``need`` copies of ``item_idx`` in inventory
    # ----------------------------------------------------------------------
    def ensure(item_idx, need):
        nonlocal cur_pos, actions, inventory
        if need <= 0:
            return
        have = inventory[item_idx]
        if have >= need:
            return
        missing = need - have

        # Primitive resources are collected directly from the world.
        if item_idx in cookbook.primitives:
            for _ in range(missing):
                move_to_and_pick(item_idx)
            return

        # Otherwise we must craft the missing amount.
        recipe = recipes[item_idx]

        # First, make sure all ingredients are available.
        for ing_idx, cnt in recipe.items():
            if isinstance(ing_idx, int):          # ignore the workshop key
                total_needed = cnt * missing
                ensure(ing_idx, total_needed)

        # Move to the appropriate workshop.
        workshop_key = recipe.get("_at", recipe.get("_key"))
        workshop_idx = (workshop_key
                        if isinstance(workshop_key, int)
                        else cookbook.index[workshop_key])
        workshop_cells = {(x, y) for x in range(w) for y in range(h)
                          if start_grid[x, y, workshop_idx] > 0}
        path = bfs(cur_pos, workshop_cells, blocked_mask)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)

        # Perform the crafting actions.
        for _ in range(missing):
            actions.append(4)               # USE at the workshop
            # Consume ingredients.
            for ing_idx, cnt in recipe.items():
                if isinstance(ing_idx, int):
                    inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Plan to create a single arrow.
    # ----------------------------------------------------------------------
    ensure(arrow_idx, 1)

    return actions

