    # action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    moves = [
        ((0, 1), DOWN),   # down  (y+1)
        ((0, -1), UP),    # up    (y-1)
        ((-1, 0), LEFT),  # left  (x-1)
        ((1, 0), RIGHT),  # right (x+1)
    ]

    def bfs_path(start, goal, grid):
        """Return a list of actions that moves from start to goal using BFS.
        Cells that contain any non‑zero kind are treated as blocked,
        except the goal cell itself (which may hold the target item)."""
        w, h = grid.shape[0], grid.shape[1]          # x‑size, y‑size
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal cell even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []   # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell containing the requested kind (Manhattan)."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)   # y‑rows, x‑cols
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Planning start
    # ------------------------------------------------------------------
    actions = []

    # current position (prefer live state if available)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # make a mutable copy of the static grid for planning
    grid = env.scenario.init_grid.copy()

    # goal item index
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the goal
    # ------------------------------------------------------------------
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, needed in primitive_requirements.items():
        for _ in range(needed):
            target = nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # primitive not found – abort planning
                return actions
            actions.extend(bfs_path(cur_pos, target, grid))
            actions.append(USE)                     # pick up primitive
            # remove the primitive from our planning grid
            grid[target[0], target[1], prim_kind] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)   # perform crafting at the workshop
            cur_pos = workshop_pos

    # return the complete action sequence
    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # movement vectors
    moves = [
        ((0, 1), DOWN),
        ((0, -1), UP),
        ((-1, 0), LEFT),
        ((1, 0), RIGHT),
    ]

    def bfs_path(start, goal, grid):
        """Return list of actions from start to goal using BFS.
        Cells with any non‑zero kind are treated as blocked, except the goal cell."""
        w, h = grid.shape[0], grid.shape[1]
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []  # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def nearest_kind(kind_idx, cur_pos, grid):
        """Find nearest cell containing kind_idx (Manhattan distance)."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Planning
    # ----------------------------------------------------------------------
    actions = []

    # current position
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # copy of static grid for planning
    grid = env.scenario.init_grid.copy()

    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Collect required primitives
    # ------------------------------------------------------------------
    primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind: count}
    for kind, cnt in primitive_reqs.items():
        for _ in range(cnt):
            target = nearest_kind(kind, cur_pos, grid)
            if target is None:
                # cannot find required primitive – abort planning
                return actions
            # move to target
            actions.extend(bfs_path(cur_pos, target, grid))
            # pick up
            actions.append(USE)
            # update planning grid and position
            grid[target[0], target[1], kind] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Go to workshop and craft the goal
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)  # craft
            cur_pos = workshop_pos

    return actions

