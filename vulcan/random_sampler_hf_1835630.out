    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and fetch current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for bookkeeping

    # Goal information
    goal_name = 'arrow'
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """True if a cell contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs(start, goal):
        """Shortest walkable path from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in prev and not is_blocked(nxt):
                        prev[nxt] = cur
                        q.append(nxt)
        else:
            return []          # no path found

        # Reconstruct path (excluding start, including goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions into movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest(kind, from_pos):
        """Find the nearest cell containing the given kind."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of target (preferring N,S,W,E)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target   # fallback (assumed walkable for collection)

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos   # current agent position (y, x)

    # Collect each required primitive the needed number of times
    for prim_idx, count in needed.items():
        for _ in range(count):
            prim_loc = nearest(prim_idx, cur)
            if prim_loc is None:
                return actions   # primitive missing – abort early

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs(cur, stand_pos)
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive itself
            path = bfs(cur, prim_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick it up
            actions.append(USE)

            # Update local grid copy
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # Move to the appropriate workshop (if the recipe specifies one)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest(ws_idx, cur)
        if ws_loc is not None:
            path = bfs(cur, ws_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)
    return actions


    # Action indices as defined in CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and fetch current state/world
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid.copy()             # mutable copy for local bookkeeping

    # Identify the goal item ("arrow") and the primitives required to craft it
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """Return True if the cell at ``pos`` contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs_path(start, goal):
        """
        Find a shortest walkable path from ``start`` to ``goal`` avoiding
        non‑grabbable cells. Returns a list of positions (excluding ``start``,
        including ``goal``). If no path exists, returns an empty list.
        """
        if start == goal:
            return []
        h, w = grid.shape[:2]
        queue = collections.deque([start])
        visited = {start: None}
        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        queue.append(nxt)
        else:
            return []  # no path found

        # Reconstruct path backwards from goal to start
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions into a list of movement actions."""
        actions = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                actions.append(DOWN)
            elif y2 == y1 - 1:
                actions.append(UP)
            elif x2 == x1 + 1:
                actions.append(RIGHT)
            elif x2 == x1 - 1:
                actions.append(LEFT)
        return actions

    def nearest_cell(kind, from_pos):
        """Find the nearest cell containing ``kind`` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """
        Return a walkable neighbour of ``target`` that is not occupied by a
        non‑grabbable entity. Preference order: N, S, W, E. If none found,
        return the target itself (assumed walkable for collection purposes).
        """
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos  # current agent position (y, x)

    # Collect each required primitive the needed number of times
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive not found – abort early
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur, stand_pos)
            if not path and cur != stand_pos:
                # No viable path – abort
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive cell itself
            path = bfs_path(cur, prim_loc)
            if not path and cur != prim_loc:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick up the primitive
            actions.append(USE)

            # Update local copy of the grid to reflect collection
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # Move to the appropriate workshop (if the recipe specifies one)
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            if path:
                actions.extend(path_to_actions([cur] + path))
                cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)

    return actions

