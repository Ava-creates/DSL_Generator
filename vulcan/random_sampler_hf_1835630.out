    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # not defined in this world
        return []

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # brings the agent to a position where the cell directly in front
    # contains `target_kind`. Returns [] if unreachable.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # direction deltas matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            if not in_bounds(x, y):
                return False
            # a cell is walkable if it contains no entities at all
            return not np.any(grid[x, y, :])

        start_pos = state.pos
        start_dir = state.dir
        from collections import deque
        queue = deque()
        queue.append((start_pos[0], start_pos[1], start_dir, []))
        visited = {(start_pos[0], start_pos[1], start_dir)}

        while queue:
            x, y, d, acts = queue.popleft()
            # Check whether the cell directly ahead holds the target
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts

            # Explore movement actions (0‑3)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))

        # Unreachable
        return []

    # --------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    actions = []

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # --------------------------------------------------------------
    for prim_idx, count in primitive_needs.items():
        for _ in range(count):
            move_actions = _bfs_to_target(cur_state, prim_idx)
            # If BFS failed but we are already adjacent, we can still pick up
            if not move_actions and not cur_state.next_to(prim_idx):
                # cannot reach this primitive – abort early
                return actions
            actions.extend(move_actions)
            actions.append(4)                     # USE to pick up
            # Apply actions to keep cur_state in sync
            for a in move_actions + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_actions = _bfs_to_target(cur_state, workshop_idx)
        actions.extend(move_actions)
        actions.append(4)                     # USE to craft
        for a in move_actions + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – just attempt crafting in place
        actions.append(4)                     # USE to craft
        _, cur_state = cur_state.step(4)

    return actions


    # Reset environment and obtain the initial state
    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # not defined in the recipe set
        return []

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # moves the agent so that the cell directly in front contains
    # `target_kind`.  The returned actions also leave the agent facing
    # that cell.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # direction deltas matching action indices
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            if not in_bounds(x, y):
                return False
            # a cell is walkable if it contains no entities of any kind
            return not np.any(grid[x, y, :])

        start_x, start_y = state.pos
        start_dir = state.dir

        from collections import deque
        queue = deque()
        queue.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while queue:
            x, y, d, acts = queue.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))
        # Target not reachable
        return []

    # --------------------------------------------------------------
    # Determine which primitive resources are needed for one arrow
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    actions = []

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # --------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            # If we are already adjacent to the primitive, no movement needed
            if not cur_state.next_to(prim_idx):
                move_actions = _bfs_to_target(cur_state, prim_idx)
                if not move_actions:
                    # Unable to reach this primitive; abort early
                    return actions
                actions.extend(move_actions)
                for a in move_actions:
                    _, cur_state = cur_state.step(a)
            # Use action (index 4) to pick up the primitive
            actions.append(4)
            _, cur_state = cur_state.step(4)

    # --------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        if not cur_state.next_to(workshop_idx):
            move_actions = _bfs_to_target(cur_state, workshop_idx)
            if move_actions:
                actions.extend(move_actions)
                for a in move_actions:
                    _, cur_state = cur_state.step(a)
        actions.append(4)                 # USE to craft at the workshop
        _, cur_state = cur_state.step(4)
    else:
        # No specific workshop – just attempt crafting in place
        actions.append(4)                 # USE to craft
        _, cur_state = cur_state.step(4)

    return actions

