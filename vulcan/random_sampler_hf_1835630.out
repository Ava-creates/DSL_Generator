    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell adjacent (Manhattan distance = 1) to any cell in
    # `targets`. Occupied cells are treated as blocked.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        w, h = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        from collections import deque
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited or occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                # Check adjacency after this move
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Retrieve world / state objects from the environment (handle wrappers).
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # env may be a CraftLab wrapper
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    if not primitives_needed:
        # Arrow is a primitive itself – just use the current cell.
        return [USE]

    # ------------------------------------------------------------------
    # Current grid, agent position and occupancy mask.
    # ------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # bool mask of any entity

    actions = []
    harvested = set()                     # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            # Find all cells that currently contain this primitive and are unharvested.
            candidates = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not candidates:
                # No more of this primitive on the map – give up.
                break

            # Choose the closest candidate (Manhattan distance).
            candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = candidates[0]

            # Plan a path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement to update `pos`.
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            collected += 1

            # Update occupancy mask – the cell becomes empty after pickup.
            occupied[target] = False

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string or an integer id).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        # Locate all workshop cells of that type.
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Move to the nearest workshop.
            workshop_cells.sort(
                key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])
            )
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)          # craft at workshop
        else:
            # No workshop found – fall back to using current cell.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    import collections
    import numpy as np

    # ----- constants -------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ----- helper: BFS to a cell adjacent to any target --------------------
    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions moving from *start* to a cell adjacent
        (Manhattan distance = 1) to any cell in *targets*.
        *occupied* is a bool array where True means the cell cannot be entered.
        """
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                # check adjacency after the move
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        # unreachable
        return []

    # ----- obtain world / state -------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Env may be a CraftLab wrapper.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----- primitive requirements (expanded to primitives only) ----------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    # If the goal itself is primitive, nothing to collect.
    if not primitives_needed:
        # just try to craft/use at current location
        return [USE]

    # ----- current grid, position, occupancy -------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # bool mask of any entity

    actions = []
    harvested = set()                     # cells already collected from

    # ----- skip primitives already in inventory ----------------------------
    inv = state.inventory
    for prim_idx, need in list(primitives_needed.items()):
        have = int(inv[prim_idx]) if inv is not None else 0
        if have >= need:
            primitives_needed.pop(prim_idx)
        else:
            primitives_needed[prim_idx] = need - have

    # ----- collect each required primitive (nearest‑first) -----------------
    for prim_idx, need_cnt in primitives_needed.items():
        gathered = 0
        while gathered < need_cnt:
            # locate remaining instances of this primitive not yet harvested
            locations = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not locations:
                # no more of this primitive on the map; give up early
                break

            # choose nearest location (Manhattan)
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locations[0]

            # plan path to a cell adjacent to the primitive
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # simulate movement to update position
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # pick up the primitive (USE while facing it)
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # after pickup the cell becomes empty
            occupied[target] = False

    # ----- move to required workshop (if any) and craft --------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (could be name or int)
        if isinstance(workshop_key, str):
            workshop_idx = cookbook.index[workshop_key]
        else:
            workshop_idx = workshop_key

        # locate workshop cells
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            workshop_cells.sort(
                key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])
            )
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)   # craft at workshop
        else:
            # No workshop found; just use current cell
            actions.append(USE)
    else:
        # No specific workshop required
        actions.append(USE)

    return actions

