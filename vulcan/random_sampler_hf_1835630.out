    # Action constants (consistent with CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper functions
    # ----------------------------------------------------------------------
    def _bfs_path(start, goal, grid):
        """Return a list of actions to move from start to goal using BFS.
        start/goal are [x, y] lists.  Cells with any non‑zero kind are
        considered blocked, except the goal cell itself.
        """
        width, height = grid.shape[0], grid.shape[1]
        # direction vectors paired with action indices
        moves = [
            ((0, 1), DOWN),   # down  : +y
            ((0, -1), UP),    # up    : -y
            ((-1, 0), LEFT),  # left  : -x
            ((1, 0), RIGHT),  # right : +x
        ]

        from collections import deque
        q = deque()
        q.append(tuple(start))
        visited = {tuple(start): (None, None)}  # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                # allow stepping onto the goal even if occupied
                if (nx, ny) != tuple(goal):
                    if grid[nx, ny].sum() != 0:
                        continue
                visited[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        # reconstruct path
        if tuple(goal) not in visited:
            return []  # no path found
        path = []
        cur = tuple(goal)
        while visited[cur][0] is not None:
            prev, act = visited[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell (Manhattan) containing the given kind."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if len(xs) == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Begin planning
    # ----------------------------------------------------------------------
    actions = []

    # Current position (use the live state if available, else the init pos)
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the static grid so we can “remove” taken items
    grid = env.scenario.init_grid.copy()

    # Goal item index
    goal_idx = env.task.goal

    # ----------------------------------------------------------------------
    # 1. Collect required primitive resources
    # ----------------------------------------------------------------------
    primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, count in primitive_reqs.items():
        for _ in range(count):
            tgt = _nearest_kind(prim_kind, cur_pos, grid)
            if tgt is None:
                # No more of this primitive – abort planning
                return actions
            # Move to the primitive cell
            actions.extend(_bfs_path(cur_pos, tgt, grid))
            # Pick it up
            actions.append(USE)
            # Update simulated state
            grid[tgt[0], tgt[1], prim_kind] = 0
            cur_pos = tgt

    # ----------------------------------------------------------------------
    # 2. Move to workshop and craft the goal item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(_bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)  # craft at the workshop
            cur_pos = workshop_pos

    # Return the planned action sequence
    return actions


    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _move_to(pos, target, seq):
        """Append actions to `seq` that move `pos` (mutable [x, y]) to `target`."""
        while pos[0] != target[0] or pos[1] != target[1]:
            if pos[0] < target[0]:
                seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > target[0]:
                seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < target[1]:
                seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > target[1]:
                seq.append(UP)
                pos[1] -= 1

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Return the (x, y) of the nearest cell containing `kind_idx`."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if len(xs) == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Initialise planning state
    # ----------------------------------------------------------------------
    actions = []

    # Current position – use the environment's actual state if available,
    # otherwise fall back to the scenario's initial position.
    if hasattr(env, "_current_state"):
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a copy of the static grid so we can mark collected items.
    grid = env.scenario.init_grid.copy()

    # Goal item index (the recipe we ultimately want to craft)
    goal_idx = env.task.goal

    # ----------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal
    # ----------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # No more of this primitive available – abort planning.
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)          # pick up the primitive
            # Mark the primitive as taken in our local copy of the grid.
            grid[target[1], target[0], kind_idx] = 0

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)          # craft at the workshop

    # ----------------------------------------------------------------------
    # Return the complete action sequence
    # ----------------------------------------------------------------------
    return actions

