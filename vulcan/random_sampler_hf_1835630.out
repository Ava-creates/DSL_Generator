    # Reset the environment and fetch the underlying state/world objects.
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    # Work on a mutable copy of the grid so we can mark primitives as collected.
    grid = state.grid.copy()             # shape (WIDTH, HEIGHT, n_kinds)

    # Action indices as defined by CraftLab.action_specs.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def is_blocked(y, x):
        """A cell is blocked if any entity (including workshops, obstacles, etc.) occupies it."""
        return np.any(grid[y, x])

    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves the
        agent from ``start`` to ``goal`` while avoiding blocked cells.
        If no path is found, returns an empty list."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev_actions = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        rev_actions.append(DOWN)
                    elif cur[0] == py - 1:
                        rev_actions.append(UP)
                    elif cur[1] == px + 1:
                        rev_actions.append(RIGHT)
                    elif cur[1] == px - 1:
                        rev_actions.append(LEFT)
                    cur = (py, px)
                return list(reversed(rev_actions))
            for dy, dx, _ in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if is_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # No path found.
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the closest cell containing ``kind_idx`` (primitive or workshop)."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Return a free neighbouring cell (y, x) to ``cell`` that is not in ``avoid``."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not is_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its required primitives.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)          # {primitive_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos                                         # (y, x)
    collected = set()                                           # cells from which primitives have been taken

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            # Choose a free adjacent cell to stand on while picking up.
            adj = adjacent_free(target, avoid=collected)
            if adj is None:
                # No free neighbour; cannot safely collect – abort.
                return actions

            # Move to the adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (add a blocked movement action to set direction).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update internal grid representation: primitive disappears.
            grid[target[0], target[1], prim_idx] = 0
            collected.add(target)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            ws_adj = adjacent_free(ws_cell, avoid=collected)
            if ws_adj is None:
                # If no free neighbour, we cannot reach the workshop safely.
                return actions
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop (optional blocked move to set direction).
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions


