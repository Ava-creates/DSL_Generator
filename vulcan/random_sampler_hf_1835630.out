    import numpy as np
    from collections import deque

    # action constants (match CraftWorld's definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: move a position according to an action (assumes movement is legal)
    # ------------------------------------------------------------------
    def _move(pos, act):
        x, y = pos
        if act == RIGHT:
            return (x + 1, y)
        if act == LEFT:
            return (x - 1, y)
        if act == DOWN:
            return (x, y + 1)
        if act == UP:
            return (x, y - 1)
        return pos

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions leading to a free cell
    # adjacent to any of the target cells.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        w, h = occupied.shape
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path, (x, y)
            # expand neighbours
            for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),
                                  (DOWN, (0, 1)), (UP, (0, -1))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # unreachable – return empty path and original position
        return [], start

