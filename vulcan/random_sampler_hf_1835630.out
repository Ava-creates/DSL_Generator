        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of action names that moves the agent
    # from `start` to a cell adjacent (Chebyshev distance ≤ 1) to any
    # target cell in `targets`.  Only empty cells may be traversed.
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_to_adjacent(start, targets, grid):
        """Return list of action names to reach a cell adjacent to any target."""
        W, H = grid.shape[:2]
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        target_set = set(targets)

        while q:
