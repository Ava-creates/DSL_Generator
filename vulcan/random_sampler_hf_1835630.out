    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # Mapping from movement delta to action
    DIRS = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    from collections import deque
    import numpy as np

    # ------------------------------------------------------------------
    # Helper: BFS shortest path avoiding non‑grabbable entities
    # ------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return a list of movement actions from start to goal."""
        if start == goal:
            return []

        W, H = grid.shape[0], grid.shape[1]
        blocked = list(world.non_grabbable_indices)

        visited = np.full((W, H), False, dtype=bool)
        prev = {}                     # (y,x) -> (prev_y, prev_x, action)

        q = deque()
        q.append(start)
        visited[start] = True

        while q:
            y, x = q.popleft()
            for (dy, dx), act in DIRS.items():
                ny, nx = y + dy, x + dx
                if not (0 <= ny < W and 0 <= nx < H):
                    continue
                if visited[ny, nx]:
                    continue
                # cell is blocked if any non‑grabbable kind occupies it
                if blocked and np.any(grid[ny, nx, blocked] > 0):
                    continue
                visited[ny, nx] = True
                prev[(ny, nx)] = (y, x, act)
                if (ny, nx) == goal:
                    # reconstruct path
                    actions = []
                    cur = (ny, nx)
                    while cur != start:
                        py, px, a = prev[cur]
                        actions.append(a)
                        cur = (py, px)
                    actions.reverse()
                    return actions
                q.append((ny, nx))
        # No path found
        return []

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind index
    # ------------------------------------------------------------------
    def find_nearest(kind_idx, from_pos):
        """Return (y,x) of the closest cell that currently holds kind_idx."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # Determine the goal item ('arrow') and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    primitive_reqs = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_reqs.items():
        for _ in range(needed):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # required primitive not present; abort early
                return actions

            # Move to the primitive cell
            actions += bfs_path(cur_pos, target)
            cur_pos = target

            # Pick it up
            actions.append(USE)

            # Update planning grid so we don't try to collect the same instance again
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting (at current location or workshop)
    actions.append(USE)

    return actions


    # Reset environment and get current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Action indices
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIR_MAP = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    H, W = grid.shape[0], grid.shape[1]

    def in_bounds(y, x):
        return 0 <= y < H and 0 <= x < W

    def cell_blocked(y, x):
        """A cell is blocked if any non‑grabbable entity occupies it."""
        # world.non_grabbable_indices is a set of kind ids that cannot be stepped on
        if not world.non_grabbable_indices:
            return False
        ng = list(world.non_grabbable_indices)
        return np.any(grid[y, x, ng] > 0)

    from collections import deque

    def bfs_path(start, goal):
        """Return a list of movement actions from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct path
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    dy, dx = cur[0] - py, cur[1] - px
                    rev.append(DIR_MAP[(dy, dx)])
                    cur = (py, px)
                rev.reverse()
                return rev
            for dy, dx in DIR_MAP:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if cell_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # no path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Return coordinates of the closest cell containing `kind_idx`."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return (int(nearest[0]), int(nearest[1]))

    def adjacent_free(cell, avoid=set()):
        """Return a free neighbour of `cell` not in `avoid`."""
        y, x = cell
        for dy, dx in DIR_MAP:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not cell_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Determine goal (arrow) and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, count in primitive_needs.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # primitive missing; abort early
                return actions

            # Choose a free adjacent cell to stand on while picking up
            stand = adjacent_free(target, avoid=set())
            if stand is None:
                # If no free neighbour, stand on the primitive cell itself
                stand = target

            # Move to the chosen standing cell
            actions += bfs_path(cur_pos, stand)
            cur_pos = stand

            # Face the primitive (optional but helps deterministic USE)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if (dy, dx) in DIR_MAP:
                actions.append(DIR_MAP[(dy, dx)])
                cur_pos = (cur_pos[0] + dy, cur_pos[1] + dx)  # update direction only; position unchanged

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid: primitive is removed
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            # Stand next to workshop if possible
            ws_adj = adjacent_free(ws_cell, avoid=set())
            if ws_adj is None:
                ws_adj = ws_cell
            actions += bfs_path(cur_pos, ws_adj)
            cur_pos = ws_adj

            # Face the workshop
            dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
            if (dy, dx) in DIR_MAP:
                actions.append(DIR_MAP[(dy, dx)])

    # Final USE to trigger crafting (whether at workshop or anywhere if no workshop)
    actions.append(USE)

    return actions

