        ws_adj = adjacent_free(ws_cell)
        if ws_adj is None:
            # No free neighbour; try standing directly on the workshop cell.
            ws_adj = ws_cell
        actions += bfs_path(cur_pos, ws_adj)
        cur_pos = ws_adj

        # Optionally face the workshop (blocked move).
        dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
        if dy == 1:
            actions.append(DOWN)
        elif dy == -1:
            actions.append(UP)
        elif dx == 1:
            actions.append(RIGHT)
        elif dx == -1:
            actions.append(LEFT)

    # Trigger crafting.
    actions.append(USE)

    return actions

