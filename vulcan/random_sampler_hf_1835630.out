    from collections import deque
    import numpy as np

    def bfs_to_adjacent(start_pos, target_cells, grid):
        """Return a list of actions moving from start_pos to a cell adjacent
        (Manhattan distance 1) to any cell in target_cells. Blocked cells are
        those containing any non‑grabbable entity."""
        W, H = grid.shape[:2]

        # Compute blocked mask.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start_pos

        # Already adjacent?
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Main planning logic.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)

    # Goal index stored in env.task.goal (int). Fallback to env.task.goal if attribute missing.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # Determine primitive requirements for the goal.
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # --------------------------------------------------------------
    # 1. Collect each required primitive.
    # --------------------------------------------------------------
    for kind_idx, count in needed.items():
        while count > 0:
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive missing – abort planning.
                return plan

            path = bfs_to_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(4)   # USE

            # Find which primitive cell we are adjacent to.
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                break  # safety

            # Update local grid and decrement needed count.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            count -= 1

    # --------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be string name or int).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            plan.append(4)   # USE to craft

    return plan

