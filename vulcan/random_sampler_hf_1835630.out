    # action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from `start` to a cell
    # adjacent (Manhattan distance = 1) to any cell in `targets`.  Cells that
    # contain any entity (grid[..., k] > 0) are treated as obstacles.
    # ----------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no reachable adjacent cell
        return []

    # ----------------------------------------------------------------------
    # Retrieve the underlying CraftWorld and its cookbook.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # some wrappers keep the world inside the internal state
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Goal: craft an 'arrow'.
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow.
    prim_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # ----------------------------------------------------------------------
    # Ensure a fresh episode.
    # ----------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    # Current position, grid and occupancy map (True = blocked).
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid                           # (W, H, n_kinds)
    occupied = np.any(grid > 0, axis=2)         # bool array

    actions = []            # final action list
    harvested = set()       # cells already collected from

    # ----------------------------------------------------------------------
    # Collect required primitives (nearest‑first greedy).
    # ----------------------------------------------------------------------
    for prim_idx, qty in prim_needed.items():
        # all cells containing this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # order by Manhattan distance from current position
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= qty:
                break
            if cell in harvested:
                continue
            # move adjacent to the primitive
            path = _bfs_adjacent(pos, [cell], occupied)
            actions.extend(path)
            # update simulated position
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # pick it up
            actions.append(USE)
            # mark cell as empty for future planning
            occupied[cell[0], cell[1]] = False
            harvested.add(cell)
            collected += 1

    # ----------------------------------------------------------------------
    # Go to the required workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
