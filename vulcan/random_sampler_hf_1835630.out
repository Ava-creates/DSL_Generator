    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # Identify the index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # item not defined in this world
        return []

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that brings
    # the agent to a position where the cell directly in front contains
    # `target_kind`. Returns None if unreachable.
    # ----------------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # Mapping from action index to (dx, dy) movement
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            # A cell is walkable if it is inside the grid and empty
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        start_x, start_y = state.pos
        start_dir = state.dir

        from collections import deque
        queue = deque()
        queue.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while queue:
            x, y, d, actions = queue.popleft()
            # Is the cell directly in front the target?
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            # Expand neighbours (move + turn)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, actions + [a]))

        # Unreachable
        return None

    # ----------------------------------------------------------------------
    # Determine which primitives are required to craft one arrow.
    # If the recipe is empty, the arrow itself is a primitive that must be
    # collected directly.
    # ----------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    actions = []

    # ----------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            if move_seq is None:
                # Cannot reach the required primitive – abort early.
                return actions
            actions.extend(move_seq)
            actions.append(4)   # USE to pick up / interact

            # Keep cur_state in sync.
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # ----------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        if move_seq is None:
            # Workshop unreachable – abort.
            return actions
        actions.extend(move_seq)
        actions.append(4)   # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – just attempt to craft in place.
        actions.append(4)   # USE to craft
        _, cur_state = cur_state.step(4)

    return actions


    env.reset()
    cur_state = env._current_state          # CraftState
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the goal item "arrow"
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # item not defined
        return []

    # --------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that
    # brings the agent to a position where the cell directly in front
    # contains `target_kind`. Returns None if unreachable.
    # --------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sdir = state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, act_seq = q.popleft()
            # check cell in front
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return act_seq

            # expand moves (also turning implicitly by moving in that direction)
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, act_seq + [a]))

        return None

    # --------------------------------------------------------------
    # Determine primitive requirements for one arrow
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    # If recipe is empty, arrow itself is a primitive to pick up
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    actions = []

    # --------------------------------------------------------------
    # Collect each required primitive the required number of times
    # --------------------------------------------------------------
    for prim_idx, req_cnt in primitive_needs.items():
        for _ in range(req_cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            if move_seq is None:
                # cannot reach required primitive – abort early
                return actions
            actions.extend(move_seq)
            actions.append(4)          # USE to pick up / interact

            # keep cur_state in sync
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        if move_seq is None:
            return actions
        actions.extend(move_seq)
        actions.append(4)              # USE to craft

        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – just attempt crafting in place
        actions.append(4)              # USE to craft
        _, cur_state = cur_state.step(4)

    return actions

