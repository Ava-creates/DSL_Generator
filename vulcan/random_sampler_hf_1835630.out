    import heapq
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _a_star(start, goal, grid):
        """Return a list of actions moving from start to goal using A*."""
        width, height = grid.shape[0], grid.shape[1]
        moves = [((0, 1), DOWN), ((0, -1), UP), ((-1, 0), LEFT), ((1, 0), RIGHT)]
        open_set = []
        heapq.heappush(open_set, (0 + abs(start[0] - goal[0]) + abs(start[1] - goal[1]),
                                  0, tuple(start), None))
        came_from = {}
        g_score = {tuple(start): 0}
        while open_set:
            _, g, current, _ = heapq.heappop(open_set)
            if list(current) == goal:
                # reconstruct path
                path = []
                while current in came_from:
                    prev, act = came_from[current]
                    path.append(act)
                    current = prev
                path.reverse()
                return path
            for (dx, dy), act in moves:
                nx, ny = current[0] + dx, current[1] + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                neighbor = (nx, ny)
                # allow stepping onto the goal even if occupied
                if neighbor != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                tentative_g = g + 1
                if neighbor not in g_score or tentative_g < g_score[neighbor]:
                    g_score[neighbor] = tentative_g
                    f = tentative_g + abs(nx - goal[0]) + abs(ny - goal[1])
                    heapq.heappush(open_set, (f, tentative_g, neighbor, act))
                    came_from[neighbor] = (current, act)
        # No path found – return empty list (caller may handle)
        return []

    def _nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell containing the given kind."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Determine current position.
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the static grid to track collected items.
    grid = env.scenario.init_grid.copy()
    goal_idx = env.task.goal
    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal.
    # ------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx)
    for kind_idx, count in primitive_needs.items():
        for _ in range(count):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Primitive not found – abort planning.
                return actions
            path = _a_star(cur_pos, target, grid)
            actions.extend(path)
            actions.append(USE)                         # pick up the item
            grid[target[0], target[1], kind_idx] = 0    # mark as taken
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            path = _a_star(cur_pos, workshop_pos, grid)
            actions.extend(path)
            actions.append(USE)                         # craft at workshop
        else:
            # No workshop found – attempt to craft at current location.
            actions.append(USE)
    else:
        # No specific workshop required – just use the action to craft.
        actions.append(USE)

    return actions


    # Helper: BFS path planning avoiding occupied cells (except the goal)
    def _bfs_path(start, goal, grid):
        """Return a list of actions to move from start to goal using BFS.
        start/goal are [x, y] lists. Cells with any occupancy are blocked,
        except the goal cell itself.
        """
        width, height = grid.shape[0], grid.shape[1]
        moves = [((0, 1), 0),   # DOWN
                 ((0, -1), 1),  # UP
                 ((-1, 0), 2),  # LEFT
                 ((1, 0), 3)]   # RIGHT
        from collections import deque
        q = deque()
        q.append((start[0], start[1]))
        visited = {(start[0], start[1]): (None, None)}  # pos -> (prev_pos, action)
        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                # allow stepping onto the goal even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                visited[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))
        if tuple(goal) not in visited:
            return []  # no path found
        # reconstruct path
        path = []
        cur = tuple(goal)
        while visited[cur][0] is not None:
            prev, act = visited[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # Helper: find nearest cell containing a specific kind
    def _nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell containing ``kind_idx`` (Manhattan distance)."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Initialize position and mutable grid copy
    # ------------------------------------------------------------------
    USE = 4
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    grid = env.scenario.init_grid.copy()
    goal_idx = env.task.goal
    actions = []

    # ------------------------------------------------------------------
    # Determine primitive requirements (including goal if it is primitive)
    # ------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for kind_idx, count in primitive_needs.items():
        for _ in range(count):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                return actions  # primitive not found; abort planning
            actions.extend(_bfs_path(cur_pos, target, grid))
            actions.append(USE)                     # pick up
            grid[target[0], target[1], kind_idx] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # Move to workshop (if needed) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(_bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)                     # craft at workshop
            cur_pos = workshop_pos
        else:
            actions.append(USE)                     # fallback: craft where we are
    else:
        actions.append(USE)                         # craft without specific workshop

    return actions

