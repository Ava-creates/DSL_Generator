    # Action constants (match CraftWorld ordering)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ----------------------------------------------------------------------
    # Helper: BFS that finds a path to a cell adjacent to any target.
    # It treats any occupied cell (grid[...,k] > 0) as blocked.
    # Returns a list of actions; empty list if already adjacent.
    # ----------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        from collections import deque
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                # Check adjacency to any target after the move
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        # No reachable adjacent cell found
        return []

    # ----------------------------------------------------------------------
    # Obtain world, state and cookbook objects from the environment.
