def make_arrow_vn(env):
    """
    Generate a list of actions that makes the agent craft an ``arrow`` in the
    provided CraftWorld environment.  The function works for any recipe that
    can be built from primitive resources (no intermediate crafted items) and
    assumes that all required primitives and the needed workshop are reachable
    through empty cells.

    The returned list contains integer actions according to the mapping used
    by :class:`CraftLab` (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).
    """
    # ----------------------------------------------------------------------
    # Helper constants and utilities
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    ACTIONS = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    from collections import deque

    def bfs(start, targets, blocked):
        """Bread‑first search returning a list of movement actions that reaches
        any cell in *targets* while avoiding *blocked* cells.  If no path is
        found, an empty list is returned."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for act, (dx, dy) in ACTIONS:
                nx, ny = x + dx, y + dy
                if (
                    0 <= nx < blocked.shape[0]
                    and 0 <= ny < blocked.shape[1]
                    and not blocked[nx, ny]
                    and (nx, ny) not in visited
                ):
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # no path

    # ----------------------------------------------------------------------
    # Reset the environment to obtain the initial state.
    # ----------------------------------------------------------------------
    env.reset()
    state = env._current_state          # internal CraftState instance
    grid = state.grid.copy()            # (W, H, n_kinds) one‑hot layout
    pos = tuple(state.pos)              # (row, col)

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe.
    # ----------------------------------------------------------------------
    goal_idx = env.task.goal                         # integer index of arrow
    cookbook = env.world.cookbook
    recipe = cookbook.recipes.get(goal_idx, {})

    # ----------------------------------------------------------------------
    # Determine which primitive kinds are required and how many of each.
    # ----------------------------------------------------------------------
    primitives_needed = {}
    for kind, cnt in recipe.items():
        if kind == "_at":
            continue
        primitives_needed[int(kind)] = int(cnt)

    # ----------------------------------------------------------------------
    # Build a set of cells that are currently blocked (any non‑zero entry).
    # ----------------------------------------------------------------------
    blocked = grid.sum(axis=2) > 0                     # 2‑D bool array

    # ----------------------------------------------------------------------
    # Helper to locate all cells of a given kind.
    # ----------------------------------------------------------------------
    def locations_of(kind):
        coords = list(zip(*np.where(grid[:, :, kind] > 0)))
        return set(coords)

    # ----------------------------------------------------------------------
    # Collect each required primitive.
    # ----------------------------------------------------------------------
    plan = []                                           # final action list
    for prim_kind, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # locate all remaining instances of this primitive
            targets = locations_of(prim_kind)
            if not targets:
                # nothing left – abort planning
                return plan

            # find a path to the nearest instance
            path = bfs(pos, targets, blocked)
            plan.extend(path)

            # after moving, use the item
            plan.append(USE)

            # update internal bookkeeping as if the action succeeded
            # (move the agent, clear the primitive cell, mark it as empty)
            for a in path:
                dx, dy = dict(ACTIONS)[a][1]
                pos = (pos[0] + dx, pos[1] + dy)
            # clear the primitive from the grid and unblock the cell
            for (px, py) in targets:
                # we stop at the first target encountered by BFS, which is
                # the one we actually reached.
                if (px, py) == pos:
                    grid[px, py, prim_kind] = 0
                    blocked[px, py] = False
                    break

    # ----------------------------------------------------------------------
    # Move to the workshop required for crafting the arrow (if any).
    # ----------------------------------------------------------------------
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_cells = locations_of(workshop_kind)
        if workshop_cells:
            path = bfs(pos, workshop_cells, blocked)
            plan.extend(path)
            pos = pos  # final position after path (already updated in BFS loop)
            # once adjacent to the workshop (or on it), issue USE to craft.
            plan.append(USE)

    return plan

