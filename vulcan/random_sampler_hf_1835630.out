    import numpy as np
    from collections import deque

    # Action indices as defined in CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and fetch current objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Goal information
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Entities that block movement (non‑grabbable)
    blocked_kinds = list(world.non_grabbable_indices)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(pos):
        """Return True if a non‑grabbable entity occupies the cell."""
        y, x = pos
        return np.any(grid[y, x, blocked_kinds] > 0)

    def bfs_path(start, goal):
        """Shortest walkable path from start to goal (list of positions)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in prev and not is_blocked(nxt):
                        prev[nxt] = cur
                        q.append(nxt)
        else:
            return []          # unreachable

        # reconstruct path (excluding start, including goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions (including start) to action ints."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the closest cell containing the given kind (Manhattan)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of target (preferring N,S,W,E)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target  # fallback (assume target itself is reachable)

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = tuple(state.pos)   # current agent position (y, x)

    # 1) Collect all required primitives
    for prim_idx, count in needed.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive missing – abort planning.
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur, stand_pos)
            if not path and cur != stand_pos:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive itself
            path = bfs_path(cur, prim_loc)
            if not path and cur != prim_loc:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick it up
            actions.append(USE)

            # Update planning grid
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # 2) Move to the required workshop (if any) and craft the arrow
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            if path:
                actions.extend(path_to_actions([cur] + path))
                cur = ws_loc

    # Final USE to craft the arrow
    actions.append(USE)
    return actions


    # ----------------------------------------------------------------------
    # Initialise environment and extract useful objects
    # ----------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for planning

    # Action indices as defined by CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Goal information – we want to craft an “arrow”
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Determine which entity kinds block movement.
    # Workshops are walkable even though they are non‑grabbable, so exclude them.
    # ----------------------------------------------------------------------
    blocked_kinds = [
        i for i in world.non_grabbable_indices
        if i not in set(world.workshop_indices)
    ]

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def is_blocked(pos):
        """Return True if a non‑walkable (blocked) entity occupies the cell."""
        y, x = pos
        return np.any(grid[y, x, blocked_kinds] > 0)

    def bfs(start, goal):
        """Shortest walkable path from start to goal (list of positions, goal inclusive)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        from collections import deque
        q = deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in prev and not is_blocked(nxt):
                        prev[nxt] = cur
                        q.append(nxt)
        else:
            return []  # unreachable

        # Reconstruct path backwards from goal to start (excluding start)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions (including start) to a list of movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest(kind_idx, from_pos):
        """Return the location of the closest cell containing the given kind."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of target (preferring N, S, W, E)."""
        y, x = target
        for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        # If all neighbours are blocked, just return the target itself
        return target

    # ----------------------------------------------------------------------
    # Build the action sequence
    # ----------------------------------------------------------------------
    actions = []
    cur = tuple(state.pos)   # current agent position (y, x)

    # --------------------------------------------------------------
    # 1) Collect each required primitive the needed number of times
    # --------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            prim_loc = nearest(prim_idx, cur)
            if prim_loc is None:
                # Primitive missing – abort planning.
                return actions

            # Move to a free cell adjacent to the primitive
            stand_pos = free_adjacent(prim_loc)
            path = bfs(cur, stand_pos)
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive cell itself
            path = bfs(cur, prim_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick it up
            actions.append(USE)

            # Update planning grid to reflect that the primitive has been taken
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # --------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest(ws_idx, cur)
        if ws_loc is not None:
            path = bfs(cur, ws_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = ws_loc

    # Final USE to perform the crafting action
    actions.append(USE)

    return actions

