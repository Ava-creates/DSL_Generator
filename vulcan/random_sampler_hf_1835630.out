    # Retrieve the scenario and world objects (the env may be a CraftLab, a CraftScenario,
    # or directly a CraftWorld).  We gracefully handle any of these wrappers.
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []  # cannot locate the world → no plan

    # Index of the target item "arrow".  If the recipe file does not contain it,
    # we simply give up.
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the start state.  ``scenario.init()`` returns a CraftState.
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # Helper that creates a hashable representation of a CraftState.  We include
    # position, direction, inventory and the whole grid (as raw bytes).  This
    # gives a unique key for visited‑state checking while keeping the operation
    # reasonably fast.
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    # Safety limits – the state space can explode, so we cap the length of any
    # candidate plan and the total number of expanded nodes.
    MAX_PLAN_LEN = 800
    MAX_EXPANSIONS = 200_000

    n_actions = getattr(world, "n_actions", 5)  # default action space size

    expansions = 0
    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: we have at least one arrow in the inventory.
        if cur_state.satisfies("", target_idx):
            return node.actions

        if len(node.actions) >= MAX_PLAN_LEN:
            continue  # prune overly long candidates

        # Expand all possible primitive actions.
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))
                expansions += 1
                if expansions > MAX_EXPANSIONS:
                    # Give up early to avoid pathological runs.
                    return []

    # No plan found within the limits.
    return []


