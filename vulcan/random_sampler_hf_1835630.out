    # Reset environment to start a fresh episode
    env.reset()

    # Goal information and recipe details
    goal_idx = env.task.goal
    needed_prims = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # Action name → integer ID mapping
    act_map = env.action_specs()          # e.g. {"UP":0, "DOWN":1, "LEFT":2, "RIGHT":3, "USE":4}
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving the agent from
    # `start` to a cell that is adjacent (Chebyshev distance ≤ 1) to any cell
    # in `targets`.  Only empty cells (no entity present) may be traversed.
    # ----------------------------------------------------------------------
    from collections import deque

    def bfs_to_adjacent(start, targets, grid):
        """Return list of action names to reach a cell adjacent to any target."""
        W, H = grid.shape[:2]
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        target_set = set(targets)

        while q:
            pos, path = q.popleft()
            # If already adjacent to a target, we are done
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path
            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                    # Walk only through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell

    actions = []

    # ----------------------------------------------------------------------
    # 1) Collect all required primitive items (respecting required counts)
    # ----------------------------------------------------------------------
    while True:
        state = env._current_state
        inventory = state.inventory
        # Check if we already have all needed primitives
        if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):
            break

        # Identify a missing primitive
        missing_idx = None
        for p_idx, cnt in needed_prims.items():
            if inventory[p_idx] < cnt:
                missing_idx = p_idx
                break
        if missing_idx is None:
            break  # Should not happen

        # Locate cells that currently contain this primitive
        prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))
        if not prim_cells:
            raise RuntimeError(f"Primitive {missing_idx} not found on the map.")

        # Plan a path to an adjacent cell of the nearest primitive
        path = bfs_to_adjacent(state.pos, prim_cells, state.grid)
        if path is None:
            raise RuntimeError(f"Primitive {missing_idx} is unreachable from position {state.pos}.")

        # Execute movement actions
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

        # Pick up the primitive with the USE action
        use_aid = act_map["USE"]
        actions.append(use_aid)
        env.step(use_aid)

    # ----------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal item
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not found on the map.")
        path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

    # Final USE to craft (or to pick up if no workshop needed)
    final_use = act_map["USE"]
    actions.append(final_use)
    env.step(final_use)

    return actions


    # Reset environment and fetch useful maps
    env.reset()
    act_map = env.action_specs()                     # e.g. {"UP":0, "DOWN":1, ...}
    goal_idx = env.task.goal
    needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # Movement helpers
    move_delta = {"UP": (-1, 0), "DOWN": (1, 0), "LEFT": (0, -1), "RIGHT": (0, 1)}
    move_names = list(move_delta.keys())

    from collections import deque

    def bfs_to_adjacent(start, targets, grid):
        """Return a list of action names moving from `start` to a cell adjacent
        (Chebyshev distance ≤ 1) to any cell in `targets`. Walk only through empty cells."""
        W, H = grid.shape[:2]
        visited = np.zeros((W, H), dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # adjacency check
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # expand neighbours
            for name in move_names:
                dx, dy = move_delta[name]
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # can only walk through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [name]))
        return None  # unreachable

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives (respecting the required counts)
    # ------------------------------------------------------------------
    while True:
        state = env._current_state
        inv = state.inventory
        if all(inv[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):
            break  # all primitives gathered

        # pick a missing primitive (first that is insufficient)
        missing_idx = next(p for p, c in needed_prims.items() if inv[p] < c)

        # locate all cells containing this primitive
        prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))
        if not prim_cells:
            raise RuntimeError(f"Primitive {missing_idx} not present on the map.")

        # plan path to an adjacent cell of the nearest primitive
        path = bfs_to_adjacent(state.pos, prim_cells, state.grid)
        if path is None:
            raise RuntimeError(f"Primitive {missing_idx} is unreachable from {state.pos}.")

        # execute movement actions
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

        # pick up the primitive
        use_aid = act_map["USE"]
        actions.append(use_aid)
        env.step(use_aid)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not found on the map.")
        path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

    # Final USE to craft (or to pick up if no workshop needed)
    final_use = act_map["USE"]
    actions.append(final_use)
    env.step(final_use)

    return actions

