    # Resolve scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Get the index of the target item “arrow”
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialize the starting state of the episode
    try:
        start_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    # Helper to hash a state (position, direction, inventory, full grid)
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(start_state)}
    frontier = deque([Node(start_state, [])])

    # Search parameters
    MAX_STEPS = 800                     # depth limit to keep search tractable
    n_actions = getattr(world, "n_actions", 5)   # typically 5 (4 moves + USE)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: inventory contains at least one arrow
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Depth pruning
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within limits
    return []


