    # Helper: create a hashable representation of a state for visited tracking
    def _state_hash(st):
        # Position, direction, inventory (as tuple), and full grid bytes uniquely identify a state
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # Prepare BFS structures
    from collections import deque, namedtuple
    Node = namedtuple("Node", ["state", "actions"])
    visited = {_state_hash(start_state)}
    frontier = deque([Node(start_state, [])])

    # Search limits
    MAX_STEPS = 300          # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # typical actions: 0‑4 (DOWN,UP,LEFT,RIGHT,USE)

    # Optional: primitive requirements for pruning
    try:
        primitive_req = world.cookbook.primitives_for(target_idx)
    except Exception:
        primitive_req = {}

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: check if the arrow is in the inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Depth limit
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h in visited:
                continue

            # Simple pruning: if we have collected more of any required primitive
            # than needed and we do not already possess the target, discard the node.
            if primitive_req:
                inv = nxt_state.inventory
                over = False
                for prim_idx, needed in primitive_req.items():
                    if inv[prim_idx] > needed:
                        over = True
                        break
                if over and not nxt_state.satisfies("", target_idx):
                    # allow if we also have intermediate crafted items that might be useful
                    # (conservatively, we keep the node if any non‑primitive count > 0)
                    non_prim = any(
                        inv[i] > 0 and i not in primitive_req
                        for i in range(len(inv))
                    )
                    if not non_prim:
                        continue

            visited.add(h)
            frontier.append(Node(nxt_state, node.actions + [a]))

    # If no plan found within limits, return an empty list
    return []

