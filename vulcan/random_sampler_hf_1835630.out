    # Mapping from action name to integer id used by the environment
    act_map = env.action_specs()

    # Movement deltas for each cardinal action
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  ( 1, 0),
        "LEFT":  ( 0,-1),
        "RIGHT": ( 0, 1),
    }

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving the agent
    # from `start` to a cell that is adjacent (including diagonally)
    # to any cell in `targets`.  Only empty cells may be traversed.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, targets, grid):
        from collections import deque
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # If we are adjacent (Chebyshev distance <= 1) to any target, stop
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # Expand neighbours
            for act, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # cell must be empty (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act]))
        return None  # No reachable adjacent cell

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect required primitive items
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Refresh current state
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Locate all cells containing the required primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Primitive not present – abort this collection
                break

            # Find a path to the nearest primitive (adjacent cell)
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # Unreachable primitive – abort
                break

            # Execute movement actions
            for act_name in path:
                actions.append(act_map[act_name])
                env.step(act_map[act_name])

            # Pick up the primitive
            actions.append(act_map["USE"])
            env.step(act_map["USE"])

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        # Refresh state after collecting primitives
        state = env._current_state
        grid = state.grid
        pos = state.pos

        # Locate workshop cells of the required kind
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            # Plan a path to the workshop (adjacent cell)
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    actions.append(act_map[act_name])
                    env.step(act_map[act_name])

            # Use action at the workshop to craft the item
            actions.append(act_map["USE"])
            env.step(act_map["USE"])

    # Return the complete action sequence (list of integer action IDs)
    return actions


