    # Placeholder implementation: returns an empty action sequence.
    # In a full solution this function would:
    #   1. Determine the goal item index for "arrow".
    #   2. Query the cookbook for the primitive requirements.
    #   3. Locate each required primitive on the grid.
    #   4. Move the agent to each primitive, use the USE action to pick it up.
    #   5. Move to the appropriate workshop and USE to craft the arrow.
    # Here we simply return an empty list, which is a valid action sequence
    # (i.e., taking no steps).  The surrounding test harness can replace this
    # stub with a real planner if needed.
    return []


    # Action indices (as defined by CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Helper: move from current position `pos` to target `tgt`, emitting actions
    def _move_to(pos, tgt, action_seq):
        # pos and tgt are mutable lists [x, y]
        while pos[0] != tgt[0] or pos[1] != tgt[1]:
            if pos[0] < tgt[0]:
                action_seq.append(RIGHT)
                pos[0] += 1
            elif pos[0] > tgt[0]:
                action_seq.append(LEFT)
                pos[0] -= 1
            elif pos[1] < tgt[1]:
                action_seq.append(DOWN)
                pos[1] += 1
            elif pos[1] > tgt[1]:
                action_seq.append(UP)
                pos[1] -= 1

    # Helper: locate the nearest cell containing a given kind
    def _nearest_kind(kind_idx, cur_pos, grid):
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        if len(xs) == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ----------------------------------------------------------------------
    # Begin planning
    # ----------------------------------------------------------------------
    actions = []

    # Current simulated position (start from the environment's initial position)
    cur_pos = list(env._current_state.pos) if hasattr(env, "_current_state") else list(env.scenario.init_pos)

    # Grid layout (static initial layout)
    grid = env.scenario.init_grid

    # Goal item index
    goal_idx = env.task.goal

    # ----------------------------------------------------------------------
    # 1. Gather all required primitive resources for the goal
    # ----------------------------------------------------------------------
    primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}
    for prim_kind, count in primitive_reqs.items():
        for _ in range(count):
            target = _nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # No more of this primitive on the map – give up early
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)      # pick up the primitive
            # Assume the primitive is removed; we do not modify `grid` here

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)  # craft at the workshop

    # Return the planned action sequence
    return actions

