    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def delta_to_action(dy, dx):
        """Convert a (dy,dx) movement into the corresponding action index."""
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        raise ValueError("Invalid delta for action")

    def bfs_path(start, goal):
        """Return a list of actions that moves from start to goal while
        avoiding non‑grabbable obstacles. Goal cell itself may be occupied
        (e.g., a workshop) – it is allowed."""
        from collections import deque

        W, H, _ = grid.shape
        blocked_set = set(world.non_grabbable_indices)

        def is_blocked(y, x):
            # a cell is blocked if any non‑grabbable entity occupies it
            return np.any(grid[y, x, list(blocked_set)] > 0)

        queue = deque()
        queue.append(start)
        visited = {start: None}
        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < W and 0 <= nx < H and (ny, nx) not in visited:
                    # Allow stepping onto the goal even if it is blocked
                    if (ny, nx) != goal and is_blocked(ny, nx):
                        continue
                    visited[(ny, nx)] = (cur, act)
                    queue.append((ny, nx))
        else:
            # No path found
            return []

        # Reconstruct actions
        actions = []
        cur = goal
        while visited[cur] is not None:
            prev, act = visited[cur]
            actions.append(act)
            cur = prev
        actions.reverse()
        return actions

    def find_nearest(cell_kind, from_pos):
        """Locate the nearest cell containing `cell_kind`."""
        locations = np.argwhere(grid[:, :, cell_kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = np.argmin(dists)
        return tuple(locations[nearest_idx])

    # ------------------------------------------------------------------
    # Determine the goal index for 'arrow' and its primitive requirements
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not found – abort early
                return actions

            ty, tx = target

            # Choose a free neighbour of the primitive to stand on
            adj_candidates = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]
            adj = None
            for ny, nx in adj_candidates:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # Fallback: stand directly on the primitive cell itself
                adj = target

            # Move to the chosen adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (perform a move action towards it; direction changes even if blocked)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            actions.append(delta_to_action(dy, dx))

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions

