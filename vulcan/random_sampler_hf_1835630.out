    # Reset the environment to a fresh start
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def manhattan_path(start, goal):
        """Return a list of movement actions that walk from ``start`` to ``goal``.
        This simple planner ignores obstacles – it works when the map is largely
        open (which is the case for most CraftWorld levels)."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x

        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)

        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)

        return actions

    def find_nearest(kind_idx, from_pos):
        """Linear scan for the nearest cell containing ``kind_idx``.
        Returns (y, x) or ``None`` if the kind does not appear on the map."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine the primitive requirements for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in required_prims.items():
        for _ in range(needed_cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present on the map – give up early.
                return actions

            ty, tx = target

            # Choose an adjacent free cell to stand on before using.
            # Preference order: above, below, left, right.
            adj = None
            for ny, nx, facing in [
                (ty - 1, tx, DOWN),   # stand above, face downwards
                (ty + 1, tx, UP),     # stand below, face upwards
                (ty, tx - 1, RIGHT),  # stand left, face rightwards
                (ty, tx + 1, LEFT)    # stand right, face leftwards
            ]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    # Check that the cell is not occupied by any non‑grabbable entity.
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx, facing)
                        break

            # If no free neighbour, we will stand on the primitive cell itself.
            if adj is None:
                adj = (ty, tx, None)

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj[:2])
            cur_pos = adj[:2]

            # Adjust direction if needed.
            if adj[2] is not None:
                # The direction we need to face is encoded in the third element.
                if adj[2] == DOWN:
                    actions.append(DOWN)
                elif adj[2] == UP:
                    actions.append(UP)
                elif adj[2] == RIGHT:
                    actions.append(RIGHT)
                elif adj[2] == LEFT:
                    actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger the crafting action.
    actions.append(USE)

    return actions


    # Reset environment to start fresh
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks
        from ``start`` to ``goal`` using a simple Manhattan walk.  This ignores
        obstacles – the CraftWorld maps are typically open enough for this
        heuristic to succeed."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x

        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)

        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)

        return actions

    def find_nearest(kind_idx, from_pos):
        """Linear scan for the nearest cell containing ``kind_idx``.
        Returns (y, x) or ``None`` if the kind does not appear on the grid."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine the primitives required to craft an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            ty, tx = target

            # Choose a free neighboring cell to stand on (so we can USE).
            neighbours = [
                (ty - 1, tx),  # above (face DOWN)
                (ty + 1, tx),  # below (face UP)
                (ty, tx - 1),  # left  (face RIGHT)
                (ty, tx + 1),  # right (face LEFT)
            ]
            adj = None
            for ny, nx in neighbours:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # Fall back to standing directly on the primitive cell.
                adj = target

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (best‑effort direction change).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)
            # If already on the same cell, direction does not matter.

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE triggers crafting of the arrow.
    actions.append(USE)

    return actions

