    # ------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions that brings the
    # agent from `start` to a cell adjacent (Manhattan distance 1) to any
    # of the `targets`. The agent may only step on empty cells (no entity
    # present in any kind channel).
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where something exists
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check if we are adjacent (or on) any target cell
            for tx, ty in target_set:
                if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:          # can only walk on empty cells
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable target – return empty list (will cause failure later)
        return []

    # ------------------------------------------------------------------
    # Locate the CraftWorld instance and the recipe index for "arrow"
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("Unable to find CraftWorld instance in the environment.")

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow (primitive index -> count)
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if the environment hasn't started)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y) coordinates
    grid = state.grid.copy()        # work on a mutable copy

    # Action constants (matching CraftWorld's definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        collected = 0
        while collected < needed_cnt:
            # Find all remaining instances of this primitive on the map
            locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locs:
                # No more of this primitive left – abort early
                break
            # Choose the nearest location (Manhattan distance)
            locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locs[0]

            # Move adjacent to the primitive
            path = _bfs_path(pos, [target])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick it up
            actions.append(USE)
            # Remove it from the grid so we don't target it again
            grid[target[0], target[1], prim_idx] = 0
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or already an int)
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = workshop_cells[0]
            path = _bfs_path(pos, [ws_target])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Perform crafting action
            actions.append(USE)
        else:
            # No workshop found – still attempt a USE (will have no effect)
            actions.append(USE)
    else:
        # No specific workshop required; a final USE attempts crafting in place
        actions.append(USE)

    return actions


    # ----------------------------------------------------------------------
    # Retrieve the current CraftWorld instance and the recipe index for "arrow".
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers store the world inside the current state object.
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Determine which primitive resources are needed to craft a single arrow.
    # The cookbook returns a dict mapping primitive indices to required counts.
    # ----------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ----------------------------------------------------------------------
    # Ensure we have a valid state (reset the environment if necessary).
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Working copies of the grid and the agent's position.
    grid = state.grid.copy()
    pos = tuple(state.pos)          # (x, y) coordinates

    # Action constants (as defined by CraftWorld).
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]

    # ----------------------------------------------------------------------
    # Helper: Bread‑first search that returns a list of movement actions
    # taking the agent from `start` to a cell that is either the target
    # itself or orthogonally adjacent to it. The agent may only step on
    # empty cells (no entity present in any channel of the grid).
    # ----------------------------------------------------------------------
    def _bfs_path(start, target):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where any entity exists
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        tx, ty = target

        while q:
            x, y, path = q.popleft()
            # Success condition: standing on the target or next to it.
            if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:
                return path
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:          # can only walk on empty cells
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # If no path is found (should not happen on well‑formed maps) return empty.
        return []

    actions = []

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ----------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        collected = 0
        while collected < required_cnt:
            # Find all remaining cells containing this primitive.
            locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                # No more of this primitive on the map – abort early.
                break
            # Choose the nearest location (Manhattan distance).
            locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            target_loc = locations[0]

            # Move adjacent to the primitive.
            path = _bfs_path(pos, target_loc)
            actions.extend(path)
            # Simulate the movement to keep `pos` up‑to‑date.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick up the primitive.
            actions.append(USE)
            # Remove the primitive from the grid so we don't target it again.
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            collected += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str)
            else workshop_key
        )
        # Locate workshop cells on the map.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            ws_target = workshop_cells[0]
            # Move adjacent to the workshop.
            path = _bfs_path(pos, ws_target)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Perform the crafting action.
            actions.append(USE)
        else:
            # No workshop found – still attempt a USE (has no effect).
            actions.append(USE)
    else:
        # No specific workshop required; a final USE attempts crafting in place.
        actions.append(USE)

    return actions

