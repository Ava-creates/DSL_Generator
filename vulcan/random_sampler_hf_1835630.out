    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return a list of actions that moves from *start* to any cell in *goals*."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # cells with any entity are blocked unless they are a goal
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update *pos* following the actions in *path*."""
        nonlocal pos
        for a in path:
            if a == 0:      # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1:    # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2:    # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3:    # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ----------------------------------------------------------------------
    # Primitive collection
    def collect_primitive(kind_idx, needed):
        """Collect *needed* units of primitive *kind_idx* from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, kind_idx] > 0]
            if not locations:
                break
            best_path = None
            best_loc = None
            for loc in locations:
                path = bfs(pos, {loc})
                if path is not None:
                    best_path = path
                    best_loc = loc
                    break
            if best_path is None:
                break
            actions.extend(best_path)
            move_along(best_path)
            actions.append(4)                # USE
            grid[best_loc[0], best_loc[1], kind_idx] = 0
            inventory[kind_idx] += 1
            needed -= 1

    # ----------------------------------------------------------------------
    # Recursive crafting
    recipes = cookbook.recipes
    primitives = cookbook.primitives

    def ensure(item_idx, amount):
        """Make sure *inventory[item_idx]* >= *amount*."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            # obtain all ingredients first
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure(ing_idx, cnt)

            # move to required workshop if any
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # craft one unit
            actions.append(4)                # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Build the arrow
    ensure(target_idx, 1)

    return actions


    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item
    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # current representations
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return a list of actions (DOWN,UP,LEFT,RIGHT) to reach any cell in *goals*."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # treat any occupied cell as blocked, except if it is a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update *pos* according to a sequence of movement actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ----------------------------------------------------------------------
    # Primitive collection
    def collect_primitive(prim_idx, amount):
        """Collect *amount* units of primitive *prim_idx* from the grid."""
        nonlocal actions, grid, inventory, pos
        while amount > 0:
            # locate all cells that still contain the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                break  # nothing left to collect
            # pick the first reachable location (BFS guarantees shortest)
            path = None
            target_loc = None
            for loc in locations:
                cand = bfs(pos, {loc})
                if cand is not None:
                    path = cand
                    target_loc = loc
                    break
            if path is None:
                break  # cannot reach any remaining primitive
            actions.extend(path)
            move_along(path)
            # pick up the primitive
            actions.append(4)  # USE
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            amount -= 1

    # ----------------------------------------------------------------------
    # Recursive crafting helper
    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, needed):
        """Guarantee that *inventory[item_idx]* >= *needed* by collecting/crafting."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < needed:
            if item_idx in primitives_set:
                # Primitive: just collect the missing amount
                collect_primitive(item_idx, needed - inventory[item_idx])
                continue

            # Crafting path
            recipe = recipes.get(item_idx, {})
            # Ensure all ingredients are present
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # Move to the required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # Perform the craft
            actions.append(4)  # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions

