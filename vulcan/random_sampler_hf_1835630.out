    import numpy as np
    from collections import deque

    # Action IDs (match CraftWorld ordering)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions moving from `start` to a cell adjacent to any target."""
        width, height = occupied.shape
        target_set = set(targets)

        # already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited or occupied[nx, ny]:
                    continue
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                visited.add((nx, ny))
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Extract world and state from the possibly wrapped environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # likely a CraftLab wrapper
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        # CraftWorld / CraftScenario
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    need_collection = bool(primitives_needed)

    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity occupies the cell

    actions = []
    harvested = set()                     # cells already collected from

    # ------------------------------------------------------------------
    # Collect required primitives (greedy nearest‑first).
    # ------------------------------------------------------------------
    if need_collection:
        for prim_idx, needed_cnt in primitives_needed.items():
            collected = 0
            while collected < needed_cnt:
                # locate remaining instances of this primitive
                candidates = [
                    tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                    if tuple(p) not in harvested
                ]
                if not candidates:
                    # no more of this primitive on the map
                    break

                # choose the closest candidate (Manhattan distance)
                candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
                target = candidates[0]

                # move adjacent to the target
                path = _bfs_adjacent(pos, [target], occupied)
                actions.extend(path)
                for act in path:
                    dx, dy = MOVE_DELTAS[act]
                    pos = (pos[0] + dx, pos[1] + dy)

                # pick up the primitive
                actions.append(USE)
                harvested.add(target)
                collected += 1

                # update occupancy – the cell becomes empty after pickup
                occupied[target] = False

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be string name or int)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # choose nearest workshop
            workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)  # craft at workshop
        else:
            # no workshop present – try to craft in place
            actions.append(USE)
    else:
        # no specific workshop required
        actions.append(USE)

    return actions


    import numpy as np
    import collections

    # Action indices – must match CraftWorld ordering.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions moving from `start` to a cell adjacent to any target."""
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited or occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Retrieve world and state objects from the (potentially wrapped) env.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]

    # ------------------------------------------------------------------
    # Determine which primitives are required for a single arrow.
    # ------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    need_collection = bool(primitives_needed)

    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # Cells already collected from

    # ------------------------------------------------------------------
    # Collect required primitives (nearest‑first greedy).
    # ------------------------------------------------------------------
    if need_collection:
        for prim_idx, needed_cnt in primitives_needed.items():
            gathered = 0
            while gathered < needed_cnt:
                # Locate remaining instances of this primitive.
                candidates = [
                    tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                    if tuple(p) not in harvested
                ]
                if not candidates:
                    # No more of this primitive on the map – stop early.
                    break

                # Choose the closest candidate (Manhattan distance).
                candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
                target = candidates[0]

                # Plan a path to a cell adjacent to the target.
                path = _bfs_adjacent(pos, [target], occupied)
                actions.extend(path)

                # Simulate movement.
                for a in path:
                    dx, dy = MOVE_DELTAS[a]
                    pos = (pos[0] + dx, pos[1] + dy)

                # Pick up the primitive.
                actions.append(USE)
                harvested.add(target)
                gathered += 1

                # Update occupancy mask – the cell becomes empty after pickup.
                occupied[target] = False

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name or already an int).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for a in path:
                dx, dy = MOVE_DELTAS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)  # craft at workshop
        else:
            # No workshop present – just attempt to use current cell.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions

