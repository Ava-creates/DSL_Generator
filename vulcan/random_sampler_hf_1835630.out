    env.reset()
    cur_state = env._current_state
    world = env.world

    # Index of the target item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Action → (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def walkable(grid, x, y):
        """True if (x, y) lies inside the grid and the cell is empty."""
        W, H = grid.shape[:2]
        if not (0 <= x < W and 0 <= y < H):
            return False
        return not np.any(grid[x, y, :])

    from collections import deque

    def bfs_to_target(state, target_kind):
        """
        Bread‑first search that returns a list of movement actions (0‑3)
        ending with the agent facing a cell that contains `target_kind`.
        Empty list means either already facing the target or it is unreachable.
        """
        grid = state.grid
        W, H = grid.shape[:2]
        sx, sy = state.pos
        sdir = state.dir

        # Already facing the target?
        dx, dy = deltas[sdir]
        fx, fy = sx + dx, sy + dy
        if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
            return []

        queue = deque()
        queue.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while queue:
            x, y, d, acts = queue.popleft()
            # Look ahead from current orientation
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
                return acts

            # Expand to four possible movement actions
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))
        # Unreachable
        return []

    def target_ahead(state, kind):
        """Return True if the cell directly in front of the agent contains `kind`."""
        x, y = state.pos
        d = state.dir
        dx, dy = deltas[d]
        fx, fy = x + dx, y + dy
        W, H = state.grid.shape[:2]
        return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []

    # 1) Gather all primitive resources needed for a single arrow
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    for prim_idx, count in primitive_needs.items():
        for _ in range(count):
            move_seq = bfs_to_target(cur_state, prim_idx)
            if not move_seq and not target_ahead(cur_state, prim_idx):
                # Primitive not reachable – abort planning
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            # Update the simulated state
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # 2) Craft the arrow at its designated workshop (if any)
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(cur_state, workshop_idx)
        if not move_seq and not target_ahead(cur_state, workshop_idx):
            # Workshop unreachable – still issue a USE (harmless)
            actions.append(4)
            _, cur_state = cur_state.step(4)
        else:
            actions.extend(move_seq)
            actions.append(4)  # USE to craft
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)
    else:
        # No specific workshop; craft in place
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions


