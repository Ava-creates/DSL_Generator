    # ----------------------------------------------------------------------
    # Helper utilities (local to the function)
    # ----------------------------------------------------------------------
    # Mapping from action names to indices as defined in the environment.
    action_map = env.action_specs()
    USE = action_map["USE"]
    # Direction vectors and corresponding action indices.
    DIRS = [
        ((1, 0), action_map["DOWN"]),
        ((-1, 0), action_map["UP"]),
        ((0, -1), action_map["LEFT"]),
        ((0, 1), action_map["RIGHT"]),
    ]

    # ----------------------------------------------------------------------
    # Simple BFS that returns a list of actions to move from `start` to a cell
    # that is adjacent to `target` (including the final facing direction).
    # ----------------------------------------------------------------------
    def bfs_to_adjacent(start, target, grid, non_grabbable):
        """Return a list of action indices to reach a cell adjacent to target."""
        # pre‑compute blocked cells (non‑grabbable entities)
        blocked = np.any(grid[:, :, list(non_grabbable)] > 0, axis=2)

        # all cells that are walkable (including the target itself – we never step on it)
        walkable = ~blocked

        # BFS state
        from collections import deque

        q = deque()
        q.append((start, []))
        visited = set()
        visited.add(start)

        # Helper to test adjacency
        def is_adjacent(p):
            return abs(p[0] - target[0]) + abs(p[1] - target[1]) == 1

        while q:
            (x, y), path = q.popleft()
            if is_adjacent((x, y)):
                # ensure the last move points towards the target
                # (i.e., the direction from (x, y) to target)
                dx, dy = target[0] - x, target[1] - y
                for (vec, act) in DIRS:
                    if vec == (dx, dy):
                        return path + [act]
                # if for some reason the direction is not one of the four,
                # just return the path (will need an extra turn later)
                return path

            for (dx, dy), act in DIRS:
                nx, ny = x + dx, y + dy
                if (
                    0 <= nx < grid.shape[0]
                    and 0 <= ny < grid.shape[1]
                    and walkable[nx, ny]
                    and (nx, ny) not in visited
                ):
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        # No path found – return empty list (the caller will fail later)
        return []

    # ----------------------------------------------------------------------
    # Initialise the episode and extract useful structures.
    # ----------------------------------------------------------------------
    _ = env.reset()  # start a fresh episode
    state = env._current_state  # current CraftState (internal attribute)
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()

    # Goal item index
    goal = env.task.goal

    # Recipe for the goal
    recipe = env.world.cookbook.recipes[goal]

    # ----------------------------------------------------------------------
    # Determine which primitive kinds are needed and how many of each.
    # ----------------------------------------------------------------------
    needed = {}
    for k, v in recipe.items():
        if k == "_at":
            continue
        needed[int(k)] = int(v)  # ensure plain ints

    actions = []

    # ----------------------------------------------------------------------
    # Helper to update the simulated state after a move action.
    # ----------------------------------------------------------------------
    def apply_move(p, act):
        for (dx, dy), a in DIRS:
            if a == act:
                return (p[0] + dx, p[1] + dy)
        return p  # should never happen

    # ----------------------------------------------------------------------
    # Collect all required primitives.
    # ----------------------------------------------------------------------
    for kind, cnt in needed.items():
        while cnt > 0:
            # Locate all cells that currently contain this primitive.
            locs = np.argwhere(grid[:, :, kind] > 0)
            if locs.size == 0:
                # No more instances on the map – break to avoid infinite loop.
                break
            # Choose the nearest one (Manhattan distance).
            dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])
            nearest_idx = int(np.argmin(dists))
            target_cell = tuple(locs[nearest_idx])

            # Plan a path to a cell adjacent to the target.
            path = bfs_to_adjacent(pos, target_cell, grid, env.world.non_grabbable_indices)
            actions.extend(path)

            # Update simulated position after following the path.
            for a in path:
                pos = apply_move(pos, a)

            # Now we are adjacent and facing the target (by construction of bfs).
            actions.append(USE)  # pick up the primitive
            # Simulate the pick‑up.
            grid[target_cell[0], target_cell[1], kind] = 0
            inventory[kind] += 1
            cnt -= 1

    # ----------------------------------------------------------------------
    # Go to the appropriate workshop and craft the goal item.
    # ----------------------------------------------------------------------
    workshop_kind = int(recipe["_at"])
    workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
    if workshop_cells.size == 0:
        # No workshop on the map – nothing we can do.
        return actions

    # Choose the nearest workshop.
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    nearest_idx = int(np.argmin(dists))
    workshop_cell = tuple(workshop_cells[nearest_idx])

    # Plan path to an adjacent cell of the workshop.
    path = bfs_to_adjacent(pos, workshop_cell, grid, env.world.non_grabbable_indices)
    actions.extend(path)

    # Update simulated position.
    for a in path:
        pos = apply_move(pos, a)

    # Use the workshop to craft.
    actions.append(USE)

    # ----------------------------------------------------------------------
    # Return the complete action sequence.
    # ----------------------------------------------------------------------
    return actions

