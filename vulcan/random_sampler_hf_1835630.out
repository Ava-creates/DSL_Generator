    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item name and index
    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # copies of mutable state
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return a list of actions (DOWN,UP,LEFT,RIGHT) to reach any goal cell."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # allow stepping onto a goal cell even if occupied
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update the local position according to a sequence of actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ----------------------------------------------------------------------
    # Primitive collection
    def collect_primitive(prim_idx, needed):
        """Collect `needed` units of a primitive from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate all cells that still contain the primitive
            locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, prim_idx] > 0]
            if not locations:
                break  # nothing left
            # pick the first reachable location (BFS guarantees shortest)
            path = None
            target_loc = None
            for loc in locations:
                path = bfs(pos, {loc})
                if path is not None:
                    target_loc = loc
                    break
            if path is None:
                break  # cannot reach any remaining primitive
            actions.extend(path)
            move_along(path)
            # pick up the primitive
            actions.append(4)  # USE
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            needed -= 1

    # ----------------------------------------------------------------------
    # Recursive crafting helper
    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        """Guarantee at least `amount` of `item_idx` in inventory."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            # if the item is a primitive, just collect it
            if item_idx in primitives_set:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # otherwise we need to craft it using its recipe
            recipe = recipes.get(item_idx, {})
            # first ensure all ingredients are available
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to the required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # perform the craft action
            actions.append(4)  # USE
            # update simulated inventory
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Build the target arrow
    ensure_item(target_idx, 1)

    return actions

