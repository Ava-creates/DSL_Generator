    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item
    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # local copies of the environment state
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    from collections import deque

    def bfs(start, goals):
        """Return a shortest list of actions from start to any cell in *goals*."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # allow stepping onto a goal cell even if occupied
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update *pos* following a list of actions."""
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ----------------------------------------------------------------------
    # Primitive collection
    def collect_primitive(prim_idx, amount):
        """Collect *amount* of primitive *prim_idx* from the grid."""
        nonlocal actions, grid, inventory, pos
        while amount > 0:
            # locate all cells that still contain the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                break  # nothing left on the map
            # find the nearest reachable location
            best_path = None
            best_loc = None
            for loc in locations:
                path = bfs(pos, {loc})
                if path is not None:
                    best_path = path
                    best_loc = loc
                    break
            if best_path is None:
                break  # unreachable
            actions.extend(best_path)
            move_along(best_path)
            # pick up the primitive
            actions.append(4)  # USE
            grid[best_loc[0], best_loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            amount -= 1

    # ----------------------------------------------------------------------
    # Recursive crafting helper
    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, needed):
        """Guarantee that *inventory[item_idx]* >= *needed*."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < needed:
            # Primitives are collected directly
            if item_idx in primitives_set:
                collect_primitive(item_idx, needed - inventory[item_idx])
                continue

            # Otherwise craft using its recipe
            recipe = recipes.get(item_idx, {})
            # First make sure all ingredients are present
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # Move to the required workshop, if any
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    # pick the closest workshop cell
                    path = bfs(pos, set(ws_cells))
                    if path:
                        actions.extend(path)
                        move_along(path)

            # Perform the crafting action
            actions.append(4)   # USE
            # Update simulated inventory
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Build the arrow
    ensure_item(target_idx, 1)

    return actions

