    MAX_STEPS = 400          # maximum plan length
    MAX_NODES = 200_000      # maximum expanded nodes

    # Action space (default: 5 actions)
    n_actions = getattr(world, "n_actions", 5)

    # Prefer USE (4) before movement actions – may speed up crafting
    action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))

