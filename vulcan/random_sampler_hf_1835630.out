    # Reset environment and grab useful handles
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = np.copy(state.grid)           # mutable copy for planning

    # Action indices as defined in CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks
        from ``start`` to ``goal`` using a simple Manhattan route."""
        y, x = start
        gy, gx = goal
        actions = []
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos, cur_grid):
        """Linear scan for the nearest cell containing ``kind_idx``.
        Returns (y, x) or ``None`` if not present."""
        locs = np.argwhere(cur_grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    def choose_adjacent(target, cur_grid):
        """Pick a free orthogonal neighbour of ``target``; if none are free,
        return ``target`` itself."""
        ty, tx = target
        h, w = cur_grid.shape[:2]
        # check orthogonal neighbours in a fixed order
        for ny, nx, facing in [(ty - 1, tx, DOWN), (ty + 1, tx, UP),
                               (ty, tx - 1, RIGHT), (ty, tx + 1, LEFT)]:
            if 0 <= ny < h and 0 <= nx < w:
                # a cell is free if no non‑grabbable entity occupies it
                occupied = np.any(cur_grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx), facing
        return (ty, tx), None  # fallback: stand on the cell itself

    # ------------------------------------------------------------------
    # Determine which primitives are required for the 'arrow' item
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos, grid)
            if target is None:
                # primitive missing – abort planning
                return actions

            stand_pos, face_dir = choose_adjacent(target, grid)

            # Move to the chosen adjacent cell
            actions += manhattan_path(cur_pos, stand_pos)
            cur_pos = stand_pos

            # If we have a preferred facing direction, issue a dummy move
            # to set the direction before using.
            if face_dir is not None:
                actions.append(face_dir)
                # update cur_pos to reflect the dummy move (it may step onto the primitive)
                if face_dir == DOWN:
                    cur_pos = (cur_pos[0] + 1, cur_pos[1])
                elif face_dir == UP:
                    cur_pos = (cur_pos[0] - 1, cur_pos[1])
                elif face_dir == RIGHT:
                    cur_pos = (cur_pos[0], cur_pos[1] + 1)
                elif face_dir == LEFT:
                    cur_pos = (cur_pos[0], cur_pos[1] - 1)

            # Pick up the primitive
            actions.append(USE)

            # Update planning grid: remove the collected primitive
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the workshop required by the recipe (if any) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos, grid)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE triggers the crafting of the arrow
    actions.append(USE)

    return actions


    import numpy as np

    # Action identifiers (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and obtain the current state/world objects.
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    # Work on a mutable copy of the grid so we can “remove” collected items.
    grid = np.copy(state.grid)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions that walk from start to goal."""
        y, x = start
        gy, gx = goal
        actions = []
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos, cur_grid):
        """Linear scan for the nearest cell containing ``kind_idx``."""
        locations = np.argwhere(cur_grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def choose_adjacent(target, cur_grid):
        """Return a free orthogonal neighbour of ``target``; if none, return target."""
        ty, tx = target
        h, w = cur_grid.shape[:2]
        # Prefer neighbours in the order up, down, left, right.
        for ny, nx, face in [(ty - 1, tx, DOWN),
                             (ty + 1, tx, UP),
                             (ty, tx - 1, RIGHT),
                             (ty, tx + 1, LEFT)]:
            if 0 <= ny < h and 0 <= nx < w:
                # A cell is free if it does not contain any non‑grabbable entity.
                occupied = np.any(cur_grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx), face
        return target, None

    # ------------------------------------------------------------------
    # Determine the primitives required for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos     # (y, x)

    # ------------------------------------------------------------------
    # Collect each primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos, grid)
            if target is None:
                # Primitive missing – abort planning and return what we have.
                return actions

            stand_pos, face_dir = choose_adjacent(target, grid)

            # Move to the chosen standing position.
            actions += manhattan_path(cur_pos, stand_pos)
            cur_pos = stand_pos

            # If we have a preferred facing direction, emit a single move to face the primitive.
            if face_dir is not None:
                actions.append(face_dir)
                # Update cur_pos to reflect that tiny step (it puts us on the primitive cell).
                if face_dir == DOWN:
                    cur_pos = (cur_pos[0] + 1, cur_pos[1])
                elif face_dir == UP:
                    cur_pos = (cur_pos[0] - 1, cur_pos[1])
                elif face_dir == RIGHT:
                    cur_pos = (cur_pos[0], cur_pos[1] + 1)
                elif face_dir == LEFT:
                    cur_pos = (cur_pos[0], cur_pos[1] - 1)

            # Pick up the primitive.
            actions.append(USE)

            # Remove the primitive from our local copy of the grid.
            ty, tx = target
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Go to the workshop (if the recipe demands one) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos, grid)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE triggers the crafting of the arrow.
    actions.append(USE)

    return actions

