            if isinstance(workshop_key, str)
            else workshop_key
        )
        # Locate workshop cells of this type
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Choose the nearest workshop
            workshop_cells.sort(
                key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])
            )
            ws_target = workshop_cells[0]
            # Move adjacent to the workshop
            ws_path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(ws_path)
            for act in ws_path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use to craft
            actions.append(USE)
        else:
            # No workshop found – try to craft in place
            actions.append(USE)
    else:
        # No specific workshop required – just use (craft) at current location
        actions.append(USE)

    return actions


