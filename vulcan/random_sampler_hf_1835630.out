    from collections import deque

    def bfs_adjacent(start, targets, grid):
        """Shortest sequence of actions moving from *start* to a cell
        adjacent (Manhattan distance = 1) to any cell in *targets*.
        Cells occupied by non‑grabbable entities are treated as blocked."""
        W, H = grid.shape[:2]

        # Build blocked mask from non‑grabbable kinds.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        # If already adjacent, return empty path.
        for tx, ty in targets:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = deque()
        q.append((start[0], start[1], []))
        visited = np.full((W, H), False, dtype=bool)
        visited[start[0], start[1]] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacent cell.
        return []

    # ------------------------------------------------------------------
    # Planning.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)

    # Goal index is stored in env.task.goal (int).  Raise if not found.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive requirements for the goal.
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # --------------------------------------------------------------
    # 1. Collect each required primitive.
    # --------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        while cnt > 0:
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive not present – abort planning.
                return plan
            path = bfs_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive.
            plan.append(4)   # USE

            # Find which primitive cell we are adjacent to.
            adj = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                break  # safety

            # Update local copy of the grid and decrement need.
            grid[adj[0], adj[1], kind_idx] -= 1
            cnt -= 1

    # --------------------------------------------------------------
    # 2. Move to workshop (if required) and craft the goal item.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be name or int).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft action.
            plan.append(4)   # USE

    return plan

