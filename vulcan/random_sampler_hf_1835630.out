        state = env._current_state
        inventory = state.inventory
        # Stop when we have enough of each primitive
        if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):
            break

        # Find a primitive we are still missing
        missing_idx = None
        for p_idx, cnt in needed_prims.items():
            if inventory[p_idx] < cnt:
                missing_idx = p_idx
                break
        if missing_idx is None:
            break  # safety

        # Locate cells containing the missing primitive
        prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))
        if not prim_cells:
            raise RuntimeError(f"Primitive {missing_idx} not found in the world.")

        # Plan a path to an adjacent cell of one of those primitives
        path = bfs_to_adjacent(state.pos, prim_cells, state.grid)
        if path is None:
            raise RuntimeError(f"Primitive {missing_idx} is unreachable from position {state.pos}.")

        # Execute movement actions
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

        # Pick up the primitive
        use_aid = act_map["USE"]
        actions.append(use_aid)
        env.step(use_aid)

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not present in the world.")
        path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

    # Final USE to craft (or to pick up if no workshop needed)
    final_use = act_map["USE"]
    actions.append(final_use)
    env.step(final_use)

    return actions


    env.reset()
    actions = []
    act_map = env.action_specs()
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at', None)

    move_delta = {
        "UP": (-1, 0),
        "DOWN": (1, 0),
        "LEFT": (0, -1),
        "RIGHT": (0, 1),
    }

    from collections import deque

    def bfs_to_adjacent(start, targets, grid):
        """Return a list of action names to reach a cell adjacent to any target."""
        W, H = grid.shape[:2]
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        target_set = set(targets)

        while q:
            pos, path = q.popleft()
            # Check adjacency to any target
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path
            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                    # Walk only through empty cells
                    if grid[nx, ny].sum() == 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act_name]))
        return None

    # ----------------------------------------------------------------------
    # 1) Collect required primitive items
    # ----------------------------------------------------------------------
    while True:
        state = env._current_state
        inventory = state.inventory
        if all(inventory[p_idx] >= cnt for p_idx, cnt in needed.items()):
            break

        # Find a primitive we still need
        missing_idx = None
        for p_idx, cnt in needed.items():
            if inventory[p_idx] < cnt:
                missing_idx = p_idx
                break
        if missing_idx is None:
            break  # Should not happen

        # Locate cells containing this primitive
        prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))
        if not prim_cells:
            raise RuntimeError(f"Primitive {missing_idx} not found on the map.")

        # Plan path to an adjacent cell of the primitive
        path = bfs_to_adjacent(state.pos, prim_cells, state.grid)
        if path is None:
            raise RuntimeError(f"Primitive {missing_idx} is unreachable from position {state.pos}.")

        # Execute movement actions
        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

        # Pick up the primitive
        use_id = act_map["USE"]
        actions.append(use_id)
        env.step(use_id)

    # ----------------------------------------------------------------------
    # 2) Move to workshop (if required) and craft the goal item
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not found on the map.")

        path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)
        if path is None:
            raise RuntimeError("Workshop is unreachable from current position.")

        for act_name in path:
            aid = act_map[act_name]
            actions.append(aid)
            env.step(aid)

    # Final USE to craft (or to pick up if no workshop needed)
    final_use = act_map["USE"]
    actions.append(final_use)
    env.step(final_use)

    return actions

