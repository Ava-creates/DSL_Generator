    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid

    # Resolve action indices, falling back to defaults if not present.
    specs = env.action_specs()
    DOWN = specs.get("DOWN", 0)
    UP = specs.get("UP", 1)
    LEFT = specs.get("LEFT", 2)
    RIGHT = specs.get("RIGHT", 3)
    USE = specs.get("USE", 4)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque

    # Non‑grabbable indices are treated as obstacles for path‑finding.
    non_grab = list(world.non_grabbable_indices)

    def bfs_path(start, goal):
        """Breadth‑first search returning a list of movement actions from
        ``start`` to ``goal`` while avoiding non‑grabbable obstacles."""
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # Reconstruct action sequence.
                rev = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        rev.append(DOWN)
                    elif py == cur[0] + 1:
                        rev.append(UP)
                    elif px == cur[1] - 1:
                        rev.append(RIGHT)
                    elif px == cur[1] + 1:
                        rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(rev))

            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # Skip cells occupied by any non‑grabbable entity.
                    if np.any(grid[ny, nx, non_grab] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list (should not happen in valid scenarios).
        return []

    def find_nearest(kind, from_pos):
        """Return coordinates of the nearest cell containing ``kind``."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest_idx = int(np.argmin(dists))
        return tuple(locs[nearest_idx])

    # ------------------------------------------------------------------
    # Determine goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on before using.
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx),
                           (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    if not np.any(grid[ny, nx, non_grab] > 0):
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; fall back to the primitive cell itself.
                adj = target

            # Move to the adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (issue a move towards it; direction changes even if blocked).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions


    # Reset environment and get core objects
    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid

    # Resolve action indices (fallback to default ordering if not defined)
    specs = env.action_specs()
    DOWN = specs.get("DOWN", 0)
    UP = specs.get("UP", 1)
    LEFT = specs.get("LEFT", 2)
    RIGHT = specs.get("RIGHT", 3)
    USE = specs.get("USE", 4)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque

    # Indices of entities that block movement (non‑grabbable)
    non_grab = list(world.non_grabbable_indices)

    def bfs_path(start, goal):
        """Return a list of movement actions from start to goal avoiding obstacles."""
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # Reconstruct action list
                actions_rev = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        actions_rev.append(DOWN)
                    elif py == cur[0] + 1:
                        actions_rev.append(UP)
                    elif px == cur[1] - 1:
                        actions_rev.append(RIGHT)
                    elif px == cur[1] + 1:
                        actions_rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(actions_rev))

            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # Cell is blocked if any non‑grabbable entity occupies it
                    if np.any(grid[ny, nx, non_grab] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list
        return []

    def find_nearest(kind, from_pos):
        """Locate the nearest cell containing the given kind."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest_idx = int(np.argmin(dists))
        return tuple(locs[nearest_idx])

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing; abort early.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on before using.
            adj = None
            for ny, nx in [(ty - 1, tx), (ty + 1, tx),
                           (ty, tx - 1), (ty, tx + 1)]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    if not np.any(grid[ny, nx, non_grab] > 0):
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; fallback to the primitive cell itself.
                adj = target

            # Move to the chosen adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (issue a move in that direction; direction changes even if blocked).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # If the recipe requires a specific workshop, move there.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # ------------------------------------------------------------------
    # Craft the arrow.
    # ------------------------------------------------------------------
    actions.append(USE)

    return actions

