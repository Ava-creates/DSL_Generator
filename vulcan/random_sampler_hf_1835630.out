    # Reset environment and capture initial state
    env.reset()
    state = env._current_state
    world = env.world
    # Work on a mutable copy of the grid to reflect pickups
    grid = np.copy(state.grid)

    # Action constants (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    ACTION_DELTAS = {
        DOWN: (1, 0),
        UP: (-1, 0),
        LEFT: (0, -1),
        RIGHT: (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_walkable(pos):
        """Return True if the cell at `pos` is not occupied by a non‑grabbable entity."""
        y, x = pos
        return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs_path(start, goal):
        """Breadth‑first search returning a list of movement actions from start to goal."""
        if start == goal:
            return []
        H, W = grid.shape[:2]
        from collections import deque
        queue = deque([start])
        visited = {start}
        parent = {}
        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            for act, (dy, dx) in ACTION_DELTAS.items():
                ny, nx = cur[0] + dy, cur[1] + dx
                if 0 <= ny < H and 0 <= nx < W:
                    nxt = (ny, nx)
                    if nxt in visited or not is_walkable(nxt):
                        continue
                    visited.add(nxt)
                    parent[nxt] = (cur, act)
                    queue.append(nxt)
        else:
            # No path found – fall back to empty list
            return []

        # Reconstruct actions
        actions_rev = []
        cur = goal
        while cur != start:
            cur, act = parent[cur]
            actions_rev.append(act)
        actions_rev.reverse()
        return actions_rev

    def locate_all(kind_idx):
        """Return list of coordinates where `kind_idx` is present on the current grid."""
        return [tuple(coord) for coord in np.argwhere(grid[:, :, kind_idx] > 0)]

    def nearest_cell(cells, from_pos):
        """Select the cell with smallest Manhattan distance from `from_pos`."""
        if not cells:
            return None
        dists = [abs(y - from_pos[0]) + abs(x - from_pos[1]) for (y, x) in cells]
        return cells[int(np.argmin(dists))]

    def adjacent_free(cell):
        """Find a walkable orthogonal neighbour of `cell`. Return it or None."""
        y, x = cell
        H, W = grid.shape[:2]
        for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            ny, nx = y + dy, x + dx
            if 0 <= ny < H and 0 <= nx < W and is_walkable((ny, nx)):
                return (ny, nx)
        return None

    def direction_to(src, dst):
        """Return the action that makes the agent at `src` face `dst` (one step away)."""
        dy = dst[0] - src[0]
        dx = dst[1] - src[1]
        if dy == 1 and dx == 0:
            return DOWN
        if dy == -1 and dx == 0:
            return UP
        if dy == 0 and dx == 1:
            return RIGHT
        if dy == 0 and dx == -1:
            return LEFT
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    required = world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in required.items():
        for _ in range(needed_cnt):
            prim_cells = locate_all(prim_idx)
            target = nearest_cell(prim_cells, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free orthogonal neighbour to stand on, fallback to the primitive cell itself.
            stand_pos = adjacent_free(target) or target

            # Move to the chosen position.
            actions += bfs_path(cur_pos, stand_pos)
            cur_pos = stand_pos

            # Face the primitive if we are not standing on it.
            if stand_pos != target:
                face_act = direction_to(stand_pos, target)
                if face_act is not None:
                    actions.append(face_act)

            # Pick up the primitive.
            actions.append(USE)

            # Update our mutable grid copy to reflect the removal.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_cells = locate_all(workshop_idx)
        ws_target = nearest_cell(workshop_cells, cur_pos)
        if ws_target is not None:
            actions += bfs_path(cur_pos, ws_target)
            cur_pos = ws_target

    # Final USE triggers crafting of the arrow.
    actions.append(USE)

    return actions


    # Reset environment and fetch current state/world information
    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid

    # Action indices (consistent with CraftWorld)
