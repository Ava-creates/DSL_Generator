            move_actions = _bfs_to_target(cur_state, prim_idx)
            # If BFS failed but we are already adjacent, we can still pick up
            if not move_actions and not cur_state.next_to(prim_idx):
                # cannot reach this primitive – abort early
                return actions
            actions.extend(move_actions)
            actions.append(4)                     # USE to pick up
            # Apply actions to keep cur_state in sync
            for a in move_actions + [4]:
                _, cur_state = cur_state.step(a)

    # --------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_actions = _bfs_to_target(cur_state, workshop_idx)
        actions.extend(move_actions)
        actions.append(4)                     # USE to craft
        for a in move_actions + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – just attempt crafting in place
        actions.append(4)                     # USE to craft
        _, cur_state = cur_state.step(4)

    return actions


    env.reset()
    cur_state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Direction deltas matching action indices (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def walkable(grid, x, y):
        W, H = grid.shape[:2]
        if not (0 <= x < W and 0 <= y < H):
            return False
        # a cell is walkable if it contains no entities at all
        return not np.any(grid[x, y, :])

    from collections import deque

    def bfs_to_target(state, target_kind):
        """Return a list of movement actions (0‑3) that ends with the agent
        facing a cell containing `target_kind`. Empty list means already facing
        the target or unreachable."""
        grid = state.grid
        W, H = grid.shape[:2]
        start_x, start_y = state.pos
        start_dir = state.dir
        queue = deque()
        queue.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}
        while queue:
            x, y, d, acts = queue.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(grid, nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                queue.append((nx, ny, a, acts + [a]))
        return []

    def target_ahead(state, kind):
        """True if the cell directly in front of the agent contains `kind`."""
        x, y = state.pos
        d = state.dir
        dx, dy = deltas[d]
        fx, fy = x + dx, y + dy
        W, H = state.grid.shape[:2]
        return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)

    actions = []

    # ------------------------------------------------------------------
    # Collect all primitive resources required for one arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_seq = bfs_to_target(cur_state, prim_idx)
            if not move_seq and not target_ahead(cur_state, prim_idx):
                # Cannot reach this primitive; abort planning
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(cur_state, workshop_idx)
        if not move_seq and not target_ahead(cur_state, workshop_idx):
            # Workshop unreachable – still try a USE (will fail harmlessly)
            actions.append(4)
            _, cur_state = cur_state.step(4)
        else:
            actions.extend(move_seq)
            actions.append(4)  # USE to craft
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)
    else:
        # No specific workshop; craft in place
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions

