    # code indented 4 spaces (since after def line)


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action mapping
    # ----------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ----------------------------------------------------------------------
    # Shortcuts to world / state
    # ----------------------------------------------------------------------
    world = env.world
    state = env._current_state
    grid = state.grid.copy()                     # (W, H, K)
    width, height, n_kinds = grid.shape
    pos = tuple(state.pos)                       # current agent position
    inventory = state.inventory.copy()

    # ----------------------------------------------------------------------
    # Goal identification
    # ----------------------------------------------------------------------
    target_name = "arrow"
    target_idx = world.cookbook.index.get(target_name)
    if target_idx is None:
        raise RuntimeError("Goal 'arrow' not found in cookbook.")

    # ----------------------------------------------------------------------
    # Handy references
    # ----------------------------------------------------------------------
    recipes = world.cookbook.recipes
    primitives = world.cookbook.primitives

    # ----------------------------------------------------------------------
    # Utility functions
    # ----------------------------------------------------------------------
    def bfs(start, goals):
        """Bread‑first search returning a list of movement actions from *start*
        to any cell in *goals*. Cells occupied by any entity are treated as
        blocked, except the goal cells themselves."""
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                 (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # blocked unless it is a goal cell
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        """Update *pos* following a sequence of movement actions."""
        nonlocal pos
        for a in path:
            if a == DOWN:
                pos = (pos[0], pos[1] + 1)
            elif a == UP:
                pos = (pos[0], pos[1] - 1)
            elif a == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif a == RIGHT:
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(kind_idx, needed):
        """Collect *needed* units of a primitive item from the grid."""
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate cells that still contain the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, kind_idx] > 0]
            if not locations:
                raise RuntimeError("Required primitive not present on map.")
            # find a reachable cell (first one found)
            path = None
            target = None
            for loc in locations:
                path = bfs(pos, {loc})
                if path is not None:
                    target = loc
                    break
            if path is None:
                raise RuntimeError("Primitive is unreachable.")
            # move to the cell
            actions.extend(path)
            move_along(path)
            # pick up as many as we can / need
            available = int(grid[target[0], target[1], kind_idx])
            take = min(available, needed)
            actions.extend([USE] * take)
            # update simulated world state
            grid[target[0], target[1], kind_idx] -= take
            inventory[kind_idx] += take
            needed -= take

    def ensure(item_idx, amount):
        """Guarantee that *inventory[item_idx]* >= *amount*."""
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            # Primitive => just collect
            if item_idx in primitives:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # Otherwise we need to craft using its recipe
            recipe = recipes.get(item_idx, {})
            # First, obtain all ingredient quantities
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx in ("_at", "_key"):
                    continue
                if inventory[ing_idx] < cnt:
                    ensure(ing_idx, cnt)

            # Move to required workshop if the recipe specifies one
            workshop_key = recipe.get("_at") or recipe.get("_key")
            if workshop_key is not None:
                ws_idx = workshop_key if isinstance(workshop_key, int) else world.cookbook.index.get(workshop_key)
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if not ws_cells:
                    raise RuntimeError("Required workshop not present on map.")
                # choose the first reachable workshop cell
                ws_path = bfs(pos, {ws_cells[0]})
                if ws_path is None:
                    # try others if first is blocked
                    for cell in ws_cells[1:]:
                        ws_path = bfs(pos, {cell})
                        if ws_path is not None:
                            break
                if ws_path is None:
                    raise RuntimeError("Workshop is unreachable.")
                actions.extend(ws_path)
                move_along(ws_path)

            # Perform the crafting action
            actions.append(USE)
            # Update simulated inventory according to the recipe
            for ing_idx, cnt in recipe.items():
                if ing_idx in ("_at", "_key"):
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ----------------------------------------------------------------------
    # Build the plan
    # ----------------------------------------------------------------------
    actions = []
    ensure(target_idx, 1)

    # Return the complete action sequence
    return actions

