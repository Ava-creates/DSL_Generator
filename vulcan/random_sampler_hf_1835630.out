    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()            # mutable copy for bookkeeping

    # Resolve action indices (use env specs if present)
    try:
        specs = env.action_specs()
        DOWN = specs['DOWN']
        UP = specs['UP']
        LEFT = specs['LEFT']
        RIGHT = specs['RIGHT']
        USE = specs['USE']
    except Exception:
        DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk
        from ``start`` to ``goal`` using a simple Manhattan route."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing ``kind_idx`` (primitive or workshop).
        Returns a (y, x) tuple or ``None`` if not found."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(target):
        """Return a free adjacent coordinate to ``target`` (prefer empty).
        If none are free, return ``target`` itself."""
        ty, tx = target
        candidates = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]
        for ny, nx in candidates:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        return target

    # ------------------------------------------------------------------
    # Determine which primitives are needed for the 'arrow' item
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos   # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on (or the primitive cell itself)
            stand_pos = free_adjacent(target)

            # Move to the chosen position
            actions += manhattan_path(cur_pos, stand_pos)
            cur_pos = stand_pos

            # Face the primitive before using (direction update via a step)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update bookkeeping grid to reflect that the primitive was taken
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting of the arrow.
    actions.append(USE)

    return actions


    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    base_grid = state.grid               # immutable occupancy grid

    # Resolve action identifiers (fallback to default ordering)
    try:
        specs = env.action_specs()
        DOWN = specs['DOWN']
        UP = specs['UP']
        LEFT = specs['LEFT']
        RIGHT = specs['RIGHT']
        USE = specs['USE']
    except Exception:
        DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Mapping from coordinate delta to movement action
    delta_to_action = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, 1): RIGHT,
        (0, -1): LEFT,
    }

    # Helper: Manhattan path (used as fallback)
    def manhattan_path(start, goal):
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    # Helper: BFS shortest path avoiding non‑grabbable entities
    def bfs_path(start, goal):
        from collections import deque
        h, w = base_grid.shape[:2]
        non_grab = list(world.non_grabbable_indices)

        def occupied(pos):
            y, x = pos
            return np.any(base_grid[y, x, non_grab] > 0)

        if start == goal:
            return []

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    if occupied((ny, nx)):
                        continue
                    new_path = path + [(ny, nx, act)]
                    if (ny, nx) == goal:
                        return new_path
                    visited.add((ny, nx))
                    q.append(((ny, nx), new_path))
        # No path found – fallback to Manhattan (may hit obstacles)
        return [(None, None, a) for a in manhattan_path(start, goal)]

    # Helper: Convert a BFS‑style path (list of (y,x,action)) to action list
    def path_to_actions(path):
        return [act for _, _, act in path if act is not None]

    # Helper: Find nearest cell containing a given kind index (using a mutable copy)
    def find_nearest(kind_idx, from_pos, mutable_grid):
        locs = np.argwhere(mutable_grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest = locs[np.argmin(dists)]
        return tuple(nearest)

    # Helper: Choose a free adjacent cell (or the cell itself if none)
    def choose_adjacent(target, mutable_grid):
        ty, tx = target
        h, w = mutable_grid.shape[:2]
        for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:
            if 0 <= ny < h and 0 <= nx < w:
                occupied = np.any(mutable_grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        return target

    # ------------------------------------------------------------------
    # Determine which primitives are required for the 'arrow' item
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # Mutable copy of the grid to track collected primitives
    mutable_grid = base_grid.copy()

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in required_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos, mutable_grid)
            if target is None:
                # Primitive not present – abort early.
                return actions

            stand_pos = choose_adjacent(target, mutable_grid)

            # Compute movement actions to reach the standing position
            bfs_result = bfs_path(cur_pos, stand_pos)
            if bfs_result:
                actions += path_to_actions(bfs_result)
            else:
                actions += manhattan_path(cur_pos, stand_pos)

            cur_pos = stand_pos

            # Face the primitive (if not standing on it)
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if (dy, dx) in delta_to_action:
                actions.append(delta_to_action[(dy, dx)])

            # Pick up the primitive
            actions.append(USE)

            # Update mutable grid to reflect that the primitive was taken
            mutable_grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos, mutable_grid)
        if ws_cell is not None:
            bfs_result = bfs_path(cur_pos, ws_cell)
            if bfs_result:
                actions += path_to_actions(bfs_result)
            else:
                actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting
    actions.append(USE)

    return actions

