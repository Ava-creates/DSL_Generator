    import numpy as np

    # Helper: simple Manhattan move actions (0=DOWN,1=UP,2=LEFT,3=RIGHT,4=USE)
    def _move_actions(src, dst):
        actions = []
        x, y = src
        tx, ty = dst
        while x < tx:
            actions.append(0)  # DOWN
            x += 1
        while x > tx:
            actions.append(1)  # UP
            x -= 1
        while y < ty:
            actions.append(3)  # RIGHT
            y += 1
        while y > ty:
            actions.append(2)  # LEFT
            y -= 1
        return actions

    # Grab references to world and cookbook
    world = env.world
    cookbook = world.cookbook
    idx = cookbook.index

    # Identify the goal item "arrow"
    try:
        arrow_idx = idx["arrow"]
    except Exception:
        # If the name is not exactly "arrow", try lower‑case lookup
        arrow_idx = idx.get("arrow", None)
        if arrow_idx is None:
            raise ValueError("Arrow recipe not found in cookbook.")

    # Determine primitive requirements for one arrow
    primitives_needed = cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # Initial grid layout (static obstacles and item placements)
    grid = env.scenario.init_grid
    width, height = grid.shape[:2]

