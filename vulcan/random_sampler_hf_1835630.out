    # ----------------------------------------------------------------------
    # Resolve recipe for "arrow": collect primitive counts and crafting order
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}          # primitive kind -> total count needed
    craft_steps = []           # ordered list of (item_idx, count) to craft

    def resolve(item_idx, mult):
        """Recursively fill needed_prims and craft_steps."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:  # primitive (no recipe entry)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # Resolve ingredients first (ignore special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # Schedule crafting of this item after its ingredients
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # Static data: grid, blocked cells, dimensions
    # ----------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # actions: 0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT

    def bfs(start, targets):
        """Return a list of movement actions (0‑3) from start to any target."""
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable (should not happen in solvable scenarios)

    def go_to_and_use(kind_idx, count):
        """Move to a cell containing `kind_idx` and USE it `count` times."""
        nonlocal pos, actions
        for _ in range(count):
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            if not cells:
                break  # nothing left of this kind
            path = bfs(pos, cells)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)   # USE

    # ----------------------------------------------------------------------
    # Build the final action sequence
    # ----------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Collect all required primitive resources
    for prim_idx, qty in needed_prims.items():
        go_to_and_use(prim_idx, qty)

    # 2) Perform crafting steps at their respective workshops
    for item_idx, qty in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([4] * qty)   # USE at workshop the required number of times

    return actions

