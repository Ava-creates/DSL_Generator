    ACTIONS = {(1, 0): DOWN, (-1, 0): UP, (0, -1): LEFT, (0, 1): RIGHT}

    # ------------------------------------------------------------------
    # Helper: BFS path finder that avoids any non‑empty cell.
    # Returns a list of actions moving the agent from `start` to a position
    # adjacent to any of the `targets`. The returned path does **not**
    # include a final turn; direction handling is done separately.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        width, height, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # any non‑zero kind blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path

            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:
