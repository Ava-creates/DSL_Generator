    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: Manhattan path from src to dst as a list of actions
    # ------------------------------------------------------------------
    def _path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind (Manhattan)
    # ------------------------------------------------------------------
    def _nearest(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: locate any cell containing a given kind (used for workshops)
    # ------------------------------------------------------------------
    def _any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # ------------------------------------------------------------------
    # Identify goal index for "arrow"
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:  # not defined in this world
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect required primitives (respecting counts)
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = _nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # primitive not present on map – abort early
                return action_seq
            # Move to the primitive cell
            for a in _path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick up the primitive
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Craft at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    return action_seq


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _manhattan_path(src, dst):
        """Return a list of actions (DOWN/UP/LEFT/RIGHT) that moves from src to dst."""
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    def _nearest_cell(grid, kind_idx, start):
        """Find the nearest cell (Manhattan) that contains at least one of kind_idx."""
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    def _any_cell(grid, kind_idx):
        """Return any cell containing kind_idx, or None."""
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # ------------------------------------------------------------------
    # Identify the index of the target item ("arrow")
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:  # not defined in the cookbook
        return []

    # ------------------------------------------------------------------
    # Determine which primitives are needed for a single arrow
    # ------------------------------------------------------------------
    needed = world.cookbook.primitives_for(arrow_idx)  # dict {kind_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting multiplicities)
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = _nearest_cell(state.grid, prim_idx, state.pos)
            if target is None:
                # primitive absent – abort early
                return actions
            # Move to the primitive cell
            for a in _manhattan_path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                actions.append(a)
                if done:
                    return actions
            # Pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            actions.append(USE)
            if done:
                return actions

    # ------------------------------------------------------------------
    # If the recipe specifies a workshop, go there and craft the item
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any_cell(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _manhattan_path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                actions.append(a)
                if done:
                    return actions
            # Craft at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            actions.append(USE)

    return actions

