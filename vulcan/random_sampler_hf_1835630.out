    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    import numpy as np
    from collections import deque, namedtuple

    # Helper: hashable representation of a state for visited set
    def _state_hash(st):
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    # Helper: Manhattan distance
    def _manhattan(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    # Helper: locate all cells containing any of the given kind indices
    def _positions_of_kinds(grid, kind_idxs):
        coords = []
        for k in kind_idxs:
            locs = np.argwhere(grid[:, :, k] > 0)
            for (x, y) in locs:
                coords.append((int(x), int(y)))
        return coords

    # Helper: find nearest position (Manhattan) from current pos to any target in list
    def _nearest(pos, targets):
        if not targets:
            return None, None
        dists = [_manhattan(pos, t) for t in targets]
        idx = int(np.argmin(dists))
        return targets[idx], dists[idx]

    # Gather recipe information for the target
    recipe = world.cookbook.recipes.get(target_idx, {})
    workshop_kind = recipe.get("_at", None)

    # Primitive requirements for one arrow (may be empty if arrow is primitive)
    prim_req = world.cookbook.primitives_for(target_idx)  # dict {prim_idx: count}

    # Node container for BFS
    Node = namedtuple("Node", ["state", "actions"])

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 600                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)  # typical actions: 0‑4 (DOWN,UP,LEFT,RIGHT,USE)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        # Determine missing primitive counts
        missing = {}
        for p_idx, need_cnt in prim_req.items():
            have = int(cur_state.inventory[p_idx])
            if have < need_cnt:
                missing[p_idx] = need_cnt - have

        # Determine next relevant kind positions for heuristic ordering
        # 1) Positions of missing primitives
        prim_positions = _positions_of_kinds(cur_state.grid, list(missing.keys()))
        # 2) Positions of workshop (if we have all primitives)
        workshop_positions = []
        if workshop_kind is not None and not missing:
            workshop_positions = _positions_of_kinds(cur_state.grid, [workshop_kind])

        # Compute heuristic ordering of actions
        action_scores = {}
        for a in range(n_actions):
            # Simulate the action
            _, nxt_state = cur_state.step(a)
            # Base score: distance to nearest relevant target after action
            if missing:
                # try to get closer to any needed primitive
                nearest_prim, dist = _nearest(nxt_state.pos, prim_positions)
                score = dist if nearest_prim is not None else 1000
            else:
                # all primitives collected, go to workshop
                nearest_ws, dist = _nearest(nxt_state.pos, workshop_positions)
                score = dist if nearest_ws is not None else 1000
            # Prefer USE when adjacent to a needed thing
            if a == 4:  # USE action
                # check adjacency to needed primitive or workshop
                adjacent = False
                for k in (list(missing.keys()) if missing else [workshop_kind]):
                    if k is not None and nxt_state.next_to(k):
                        adjacent = True
                        break
                if adjacent:
                    score -= 5  # boost priority
            action_scores[a] = score

        # Sort actions by heuristic (lower score = higher priority)
        sorted_actions = sorted(range(n_actions), key=lambda x: action_scores[x])

        for a in sorted_actions:
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If we exit the loop without finding a plan
    return []


    # Resolve scenario and world objects
    scenario = getattr(env, "scenario", None) or getattr(env, "scenario", env)
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    # Find the index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting state
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    # Helper to create a hashable representation of a CraftState
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    Node = namedtuple("Node", ["state", "actions"])
    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 800                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)  # default action space size

    # Optional: get primitive requirements for the target (may be used for pruning)
    try:
        primitive_requirements = world.cookbook.primitives_for(target_idx)
    except Exception:
        primitive_requirements = {}

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long candidate plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    # No feasible plan found within the limits
    return []

