        """Create a hashable representation of a CraftState."""
        # inventory is a 1‑D numpy array; convert to tuple for hashing
        inv = tuple(st.inventory.tolist())
        # grid is a 3‑D numpy array; use its raw bytes
        grd = st.grid.tobytes()
        return (st.pos, st.dir, inv, grd)

    visited = {_state_key(start_state)}
    frontier = deque([Node(start_state, [])])

    # Safety limits
    MAX_STEPS = 600               # maximum plan length to explore
    n_actions = getattr(world, "n_actions", 5)   # usually 4 moves + USE

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return cur_actions

        # Prune long trajectories
        if len(cur_actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _state_key(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, cur_actions + [a]))

    # If we exit the loop, no plan was found within the limits
    return []


    # Obtain scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state for planning
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        # Hashable representation of a CraftState
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 600
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        state, actions = node.state, node.actions

        # Goal test: have at least one arrow in inventory
        if state.inventory[target_idx] > 0:
            return actions

        if len(actions) >= MAX_STEPS:
            continue

        for a in range(n_actions):
            _, nxt = state.step(a)
            key = _state_key(nxt)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt, actions + [a]))

    # No plan found within the search budget
    return []

