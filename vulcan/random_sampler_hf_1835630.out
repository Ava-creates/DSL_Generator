    # Action indices (standard ordering in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from `start` to a cell
    # that is Manhattan‑adjacent (distance 1) to any cell in `targets`.
    # Cells occupied by any entity are treated as walls.
    # ----------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets, occupied):
        w, h = occupied.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop if we are already adjacent to a target cell
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Expand neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell
        return []

    # ----------------------------------------------------------------------
    # Retrieve the underlying CraftWorld and its cookbook from the env.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers keep the world inside the current state.
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Ensure we have a fresh state and extract current position / grid.
    # ----------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()             # (W, H, n_kinds)

    # ----------------------------------------------------------------------
    # Identify the goal item ('arrow') and the primitive requirements.
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in the cookbook.")
    goal_idx = cookbook.index[goal_name]

    # Mapping primitive_kind_index -> count needed for one arrow.
    primitives_needed = cookbook.primitives_for(goal_idx)

    actions = []                         # final action list
    harvested = set()                    # cells already used for collection

    # ----------------------------------------------------------------------
    # Helper to update the internal position after following a path.
    # ----------------------------------------------------------------------
    def _move_pos(start, path):
        x, y = start
        for a in path:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ----------------------------------------------------------------------
    # Collect all required primitives.
    # ----------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all grid cells that currently contain this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from the current position to reduce travel.
        locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue

            occupied = np.any(grid > 0, axis=2)          # recompute occupancy mask
            path = _bfs_to_adjacent(pos, [loc], occupied)
            actions.extend(path)
            pos = _move_pos(pos, path)

            # Pick up the primitive.
            actions.append(USE)

            # Update planning grid: the primitive is now removed.
            grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            target_ws = workshop_cells[0]
            occupied = np.any(grid > 0, axis=2)
            path = _bfs_to_adjacent(pos, [target_ws], occupied)
            actions.extend(path)
            pos = _move_pos(pos, path)
            # Craft at the workshop.
            actions.append(USE)
        else:
            # No visible workshop; attempt to craft in place.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions

