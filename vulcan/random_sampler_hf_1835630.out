    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: Manhattan path (no obstacles considered)
    # ------------------------------------------------------------------
    def _move_to(cur, target):
        cx, cy = cur
        tx, ty = target
        seq = []
        while cx < tx:
            seq.append(RIGHT)
            cx += 1
        while cx > tx:
            seq.append(LEFT)
            cx -= 1
        while cy < ty:
            seq.append(DOWN)
            cy += 1
        while cy > ty:
            seq.append(UP)
            cy -= 1
        return seq

    # ------------------------------------------------------------------
    # Identify world and cookbook
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        world = env
