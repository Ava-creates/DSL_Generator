    # body code


    import numpy as np
    from collections import deque

    env.reset()
    state = env._current_state
    world = env.world

    # index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # primitive requirements for one arrow; treat arrow itself as primitive if no recipe
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    actions = []

    # movement deltas for actions DOWN=0, UP=1, LEFT=2, RIGHT=3
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def bfs_to_target(cur_state, target_kind):
        """Return a list of movement actions that ends with the agent facing a cell
        containing `target_kind`. Returns None if unreachable."""
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        q = deque()
        sx, sy = cur_state.pos
        sd = cur_state.dir
        q.append((sx, sy, sd, []))
        visited = {(sx, sy, sd)}

        while q:
            x, y, d, seq = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return seq
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, seq + [a]))
        return None

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            move_seq = bfs_to_target(state, prim_idx)
            if move_seq is None:
                # cannot reach the required primitive; abort early
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up / interact
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(state, workshop_idx)
        if move_seq is None:
            return actions
        actions.extend(move_seq)
        actions.append(4)  # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop; craft in place
        actions.append(4)
        _, state = state.step(4)

    return actions

