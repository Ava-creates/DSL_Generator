    # Action indices
    spec = env.action_specs()
    DOWN = spec["DOWN"]
    UP = spec["UP"]
    LEFT = spec["LEFT"]
    RIGHT = spec["RIGHT"]
    USE = spec["USE"]

    # Current state information
    state = env._current_state
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # copy to simulate pickups

    # Goal and required primitives
    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)   # {prim_idx: count}

    width, height = grid.shape[:2]

    # ------------------------------------------------------------------
    # Helper: Manhattan movement (fallback when BFS fails)
    # ------------------------------------------------------------------
    def _manhattan(cur, tgt):
        moves = []
        x, y = cur
        tx, ty = tgt
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    # ------------------------------------------------------------------
    # Helper: BFS shortest path respecting non‑grabbable obstacles.
    # ------------------------------------------------------------------
    def _bfs_path(start, goal_pos, allow_goal=True):
        # Determine blocked cells (any non‑grabbable entity present)
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # The destination may contain the target primitive/workshop; allow stepping onto it.
        if allow_goal:
            blocked[goal_pos[0], goal_pos[1]] = False

        q = collections.deque([start])
        came_from = {start: None}
        action_from = {}

        while q:
            cur = q.popleft()
            if cur == goal_pos:
                break
            x, y = cur
            for a, (dx, dy) in (
                (DOWN, (1, 0)),
                (UP, (-1, 0)),
                (RIGHT, (0, 1)),
                (LEFT, (0, -1)),
            ):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_from[nxt] = a
                        q.append(nxt)

        if goal_pos not in came_from:
            return None  # no path found

        # Reconstruct action list
        actions_rev = []
        cur = goal_pos
        while cur != start:
            actions_rev.append(action_from[cur])
            cur = came_from[cur]
        actions_rev.reverse()
        return actions_rev

    # ------------------------------------------------------------------
    # Main plan: collect primitives then craft at workshop.
    # ------------------------------------------------------------------
    actions = []

    # ---- Collect each required primitive ----
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Find all current locations of this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # Nothing left to collect; abort further attempts for this primitive
                break

            # Choose nearest location (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1])
            )

            # Compute path
            path = _bfs_path(pos, target, allow_goal=True)
            if path is None:
                path = _manhattan(pos, target)

            actions.extend(path)
            pos = target

            # Pick up the primitive
            actions.append(USE)
            grid[pos[0], pos[1], prim_idx] = 0   # simulate removal

    # ---- Move to workshop and craft ----
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        workshop_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if workshop_locs:
            # Choose nearest workshop
            target_ws = min(
                workshop_locs,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1])
            )
            path = _bfs_path(pos, target_ws, allow_goal=True)
            if path is None:
                path = _manhattan(pos, target_ws)
            actions.extend(path)
            pos = target_ws
            actions.append(USE)   # craft at workshop

    return actions


    spec = env.action_specs()
    DOWN = spec["DOWN"]; UP = spec["UP"]; LEFT = spec["LEFT"]; RIGHT = spec["RIGHT"]; USE = spec["USE"]
    state = env._current_state
    pos = tuple(state.pos)
    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}
    # work on a mutable copy of the grid to mark collected items
    grid = state.grid.copy()
    width, height = grid.shape[:2]

    # pre‑compute blocked cells (non‑grabbable entities)
    non_grab = list(env.world.non_grabbable_indices)
    if non_grab:
        base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
    else:
        base_blocked = np.zeros((width, height), dtype=bool)

    def bfs_path(start, target, allow_target_block=False):
        """Return a list of actions from start to target avoiding base_blocked."""
        blocked = base_blocked.copy()
        if allow_target_block:
            blocked[target[0], target[1]] = False
        q = collections.deque([start])
        came_from = {start: None}
        action_from = {}
        moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (RIGHT, (0, 1)), (LEFT, (0, -1))]
        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in moves:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_from[nxt] = a
                        q.append(nxt)
        if target not in came_from:
            return None
        # reconstruct
        path = []
        cur = target
        while cur != start:
            path.append(action_from[cur])
            cur = came_from[cur]
        path.reverse()
        return path

    def manhattan_path(start, target):
        moves = []
        x, y = start
        tx, ty = target
        while x < tx:
            moves.append(DOWN); x += 1
        while x > tx:
            moves.append(UP); x -= 1
        while y < ty:
            moves.append(RIGHT); y += 1
        while y > ty:
            moves.append(LEFT); y -= 1
        return moves

    actions = []

    # ---- collect primitives ----
    for prim_idx, count in needed.items():
        for _ in range(count):
            # locate remaining instances of this primitive
            locs = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locs:
                break  # none left
            # choose nearest by Manhattan distance
            target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            path = bfs_path(pos, target, allow_target_block=True)
            if path is None:
                path = manhattan_path(pos, target)
            actions.extend(path)
            actions.append(USE)          # pick up
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0   # remove from simulated grid

    # ---- move to workshop and craft ----
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target_ws = min(ws_locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            path = bfs_path(pos, target_ws, allow_target_block=True)
            if path is None:
                path = manhattan_path(pos, target_ws)
            actions.extend(path)
            actions.append(USE)   # craft

    return actions

