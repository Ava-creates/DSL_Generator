    # Goal information
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Required primitives for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Obtain current state (reset if needed)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
