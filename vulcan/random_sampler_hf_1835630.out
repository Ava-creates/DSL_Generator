    import numpy as np
    import collections

    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions moving from start to a cell
    # adjacent (Manhattan distance == 1) to any target location.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, grid):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)  # blocked cells
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Check adjacency
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
                if (x, y) == (tx, ty):
                    return path
            # Expand neighbours
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    # ------------------------------------------------------------------
    # Retrieve world and cookbook objects from the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers keep the world inside the current state.
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal is the item named "arrow".
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in the cookbook.")
    goal_idx = cookbook.index[goal_name]

    # Primitives required to craft the goal (including counts).
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # current (x, y)
    grid = state.grid.copy()        # mutable copy for planning

    actions = []
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locations of this primitive on the grid.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            # Update internal position tracker.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Mark cell as empty for future planning.
            grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        # Find workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop.
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft the arrow.
            actions.append(USE)
        else:
            # No visible workshop; attempt to craft in place.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    import numpy as np
    import collections

    # Action indices used by CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # BFS that returns a list of actions moving the agent from `start`
    # to a cell adjacent (Manhattan distance ≤ 1) to any location in
    # `targets`.  Cells containing any non‑zero kind are treated as
    # obstacles.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, grid):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # blocked cells
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop when adjacent to a target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable path.
        return []

    # ------------------------------------------------------------------
    # Retrieve the underlying CraftWorld and its cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state.
        wrapper_state = getattr(env, "_current_state", None)
        if wrapper_state is not None:
            world = wrapper_state.world
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance from the environment.")
    cookbook = world.cookbook

    # Goal is hard‑coded to "arrow".
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Current position and a mutable copy of the grid for planning.
    pos = tuple(state.pos)                # (x, y)
    cur_grid = state.grid.copy()          # (W, H, n_kinds)

    actions = []
    harvested = set()                     # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locate all cells that currently contain this primitive.
        locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from the current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Plan a path to a cell adjacent to the primitive.
            path = _bfs_path(pos, [loc], cur_grid)
            actions.extend(path)
            # Update internal position tracker.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Remove the primitive from the planning grid.
            cur_grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or an integer).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        # Find all workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop.
            path = _bfs_path(pos, [target_ws], cur_grid)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
        # Use the workshop to craft the arrow.
        actions.append(USE)
    else:
        # No specific workshop required; just use at current location.
        actions.append(USE)

    return actions

