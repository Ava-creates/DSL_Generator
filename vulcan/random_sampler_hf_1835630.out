    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    # Create a hashable representation of a state for visited‑set tracking
    def _state_hash(st):
        return (
            st.pos,                     # position tuple
            st.dir,                     # facing direction
            tuple(st.inventory.tolist()),  # inventory vector
            st.grid.tobytes(),          # full grid layout (changes when items are taken/crafted)
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    # Safety limits
    MAX_PLAN_LEN = 500
    n_actions = getattr(world, "n_actions", 5)   # typical actions: 0‑4

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Trim overly long trajectories
        if len(node.actions) >= MAX_PLAN_LEN:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within limits
    return []


