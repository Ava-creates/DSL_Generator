    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Initialise environment and obtain useful objects
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (W, H, n_kinds)
    height, width = grid.shape[0], grid.shape[1]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def delta_to_action(dy, dx):
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        raise ValueError("Invalid delta for direction")

    def is_free(pos):
        y, x = pos
        if not (0 <= y < height and 0 <= x < width):
            return False
        # a cell is free iff no kind occupies it
        return not np.any(grid[y, x, :])

    def bfs(start, goal):
        """Return a list of positions from start (exclusive) to goal (inclusive)
        using 4‑way moves, avoiding any occupied cell. If no path, return None."""
        if not is_free(goal):
            return None
        q = deque()
        q.append(start)
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx in [(1,0),(-1,0),(0,1),(0,-1)]:
                ny, nx = y+dy, x+dx
                nxt = (ny, nx)
                if 0 <= ny < height and 0 <= nx < width and nxt not in came_from and is_free(nxt):
                    came_from[nxt] = cur
                    q.append(nxt)
        else:
            return None  # not found

        # reconstruct path (excluding start)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert list of positions to movement actions."""
        acts = []
        y, x = state.pos  # dummy, not used
        for (ny, nx), (py, px) in zip(path, [(state.pos[0], state.pos[1])] + path[:-1]):
            dy, dx = ny - py, nx - px
            acts.append(delta_to_action(dy, dx))
        return acts

    def find_nearest(kind, from_pos):
        """Return coordinate of the nearest cell containing `kind`."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # primitive missing – give up early
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on
            adj = None
            for ny, nx in [(ty-1,tx),(ty+1,tx),(ty,tx-1),(ty,tx+1)]:
                if 0 <= ny < height and 0 <= nx < width and is_free((ny,nx)):
                    adj = (ny, nx)
                    break
            if adj is None:
                # fallback: stand on the primitive cell itself after picking it up
                adj = (ty, tx)

            # Move to the adjacent cell
            path = bfs(cur_pos, adj)
            if path is None:
                # cannot reach – abort
                return actions
            actions += path_to_actions(path)
            cur_pos = adj

            # Face the primitive (use a movement action that would be blocked)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy != 0 or dx != 0:
                actions.append(delta_to_action(dy, dx))

            # Pick up the primitive
            actions.append(USE)

            # Update internal grid representation (primitive removed)
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            # Choose a free neighbour of the workshop to stand on
            wy, wx = ws_cell
            adj = None
            for ny, nx in [(wy-1,wx),(wy+1,wx),(wy,wx-1),(wy,wx+1)]:
                if 0 <= ny < height and 0 <= nx < width and is_free((ny,nx)):
                    adj = (ny, nx)
                    break
            if adj is None:
                adj = ws_cell  # fallback, even if occupied
            path = bfs(cur_pos, adj)
            if path is not None:
                actions += path_to_actions(path)
                cur_pos = adj
            # Face the workshop
            dy, dx = wy - cur_pos[0], wx - cur_pos[1]
            if dy != 0 or dx != 0:
                actions.append(delta_to_action(dy, dx))

    # Finally, trigger crafting
    actions.append(USE)

    return actions


    import numpy as np

    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and fetch underlying objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from `start` to `goal` using a simple Manhattan walk.
        Obstacles are ignored – this works for most generated scenarios."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind, from_pos):
        """Find the nearest cell containing `kind` (primitive or workshop).
        Returns a tuple (y, x) or None if not found."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    # ------------------------------------------------------------------
    # Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on before using
            adj = None
            for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(
                        grid[ny, nx, list(world.non_grabbable_indices)] > 0
                    )
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour – fallback to the primitive cell itself
                adj = (ty, tx)

            # Move to the adjacent cell
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (add a movement action that would step into it)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at current location
    actions.append(USE)

    return actions

