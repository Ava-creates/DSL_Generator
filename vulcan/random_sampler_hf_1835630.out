    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _manhattan_path(src, dst):
        """Return a list of actions (DOWN/UP/LEFT/RIGHT) to move from src to dst."""
        actions = []
        r, c = src
        tr, tc = dst
        # vertical moves
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        # horizontal moves
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    def _find_nearest(grid, kind_idx, start_pos):
        """Find the nearest cell (Manhattan) containing kind_idx."""
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start_pos[0]) + abs(j - start_pos[1])
                    if best_dist is None or d < best_dist:
                        best = (i, j)
                        best_dist = d
        return best

    def _find_any(grid, kind_idx):
        """Return any cell containing kind_idx (used for workshops)."""
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify goal index for 'arrow'
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:   # not defined in recipes
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect required primitives (respect counts)
    # ------------------------------------------------------------------
    for prim_idx, count in primitive_needs.items():
        for _ in range(count):
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # primitive missing – abort early
                return action_seq
            # Move to primitive
            for a in _manhattan_path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick up (USE)
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # Craft the arrow (move to workshop if required)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)

    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _manhattan_path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Craft at workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
    else:
        # No specific workshop – attempt crafting in place
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq


    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: find the nearest cell that contains a given kind (Manhattan)
    # ------------------------------------------------------------------
    def _nearest(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: locate any cell that contains a given kind (used for workshops)
    # ------------------------------------------------------------------
    def _any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Helper: produce a Manhattan path (list of actions) from src to dst
    # ------------------------------------------------------------------
    def _manhattan_path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # Initialise a fresh episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify the goal item (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # unknown goal – nothing to do
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    actions_taken = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting required counts)
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            target = _nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # Primitive not present – abort early
                return actions_taken
            # Move to the primitive location
            for a in _manhattan_path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                actions_taken.append(a)
                if done:
                    return actions_taken
            # Pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            actions_taken.append(USE)
            if done:
                return actions_taken

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _manhattan_path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                actions_taken.append(a)
                if done:
                    return actions_taken
            # Perform the crafting action
            reward, done, obs = env.step(USE)
            state = env._current_state
            actions_taken.append(USE)
    else:
        # No explicit workshop – attempt to craft in place
        reward, done, obs = env.step(USE)
        state = env._current_state
        actions_taken.append(USE)

    return actions_taken

