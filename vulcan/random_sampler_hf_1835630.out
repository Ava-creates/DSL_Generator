    import numpy as np
    from collections import deque

    # Action indices (as defined by CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and obtain the current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy for bookkeeping

    # Goal item index and its primitive requirements
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # Helper data
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos, ignore_target=False):
        """Return True if ``pos`` contains a non‑grabbable entity."""
        y, x = pos
        if ignore_target:
            return False
        return np.any(grid[y, x, non_grab] > 0)

    def bfs(start, goal):
        """Shortest walkable path from ``start`` to ``goal`` avoiding obstacles.
        Returns a list of positions (excluding ``start``, including ``goal``)."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited:
                        blocked = is_blocked(nxt, ignore_target=(nxt == goal))
                        if not blocked:
                            visited[nxt] = cur
                            q.append(nxt)
        else:
            return []  # no path found

        # Reconstruct path backwards
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions into movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the nearest cell containing ``kind`` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    actions = []
    cur = state.pos  # current position (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive not found – abort early
                return actions

            # Move to the primitive cell
            path = bfs(cur, prim_loc)
            if not path and cur != prim_loc:
                return actions
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick it up
            actions.append(USE)

            # Update local grid copy
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if required)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs(cur, ws_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = ws_loc

    # ------------------------------------------------------------------
    # Craft the arrow
    # ------------------------------------------------------------------
    actions.append(USE)

    return actions


    """Implementation for make_arrow_vn (variant 2).

    This version uses BFS to find shortest walkable paths while avoiding
    non‑grabbable entities (e.g., water, trees).  It collects all required
    primitives for the 'arrow' recipe, moves to the appropriate workshop
    (if any), and finally issues a USE action to craft the arrow.
    """
    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and obtain the current state / world.
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid.copy()             # mutable copy for bookkeeping

    # Index of the target item ('arrow') and its primitive requirements.
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    non_grab = list(world.non_grabbable_indices)

    def is_blocked(pos):
        """Return True if the cell at ``pos`` contains any non‑grabbable entity."""
        y, x = pos
        return np.any(grid[y, x, non_grab] > 0)

    def bfs_path(start, goal):
        """Shortest walkable path from ``start`` to ``goal`` avoiding blocked cells."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):
                if 0 <= ny < h and 0 <= nx < w:
                    nxt = (ny, nx)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = cur
                        q.append(nxt)
        else:
            return []  # No path found

        # Reconstruct path (excluding start, including goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions (including start) to movement actions."""
        acts = []
        for (y1, x1), (y2, x2) in zip(path, path[1:]):
            if y2 == y1 + 1:
                acts.append(DOWN)
            elif y2 == y1 - 1:
                acts.append(UP)
            elif x2 == x1 + 1:
                acts.append(RIGHT)
            elif x2 == x1 - 1:
                acts.append(LEFT)
        return acts

    def nearest_cell(kind, from_pos):
        """Find the nearest cell containing ``kind`` (primitive or workshop)."""
        locs = np.argwhere(grid[:, :, kind] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[dists.argmin()])

    def free_adjacent(target):
        """Return a walkable neighbour of ``target`` (preferring N, S, W, E)."""
        ty, tx = target
        for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                if not is_blocked((ny, nx)):
                    return (ny, nx)
        return target  # fallback (assumed walkable for collection)

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos  # current position (y, x)

    # Collect each primitive the required number of times.
    for prim_idx, count in required.items():
        for _ in range(count):
            prim_loc = nearest_cell(prim_idx, cur)
            if prim_loc is None:
                # Primitive not present; abort early.
                return actions

            # Move to a free cell adjacent to the primitive.
            stand_pos = free_adjacent(prim_loc)
            path = bfs_path(cur, stand_pos)
            actions.extend(path_to_actions([cur] + path))
            cur = stand_pos

            # Step onto the primitive cell itself.
            path = bfs_path(cur, prim_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = prim_loc

            # Pick up the primitive.
            actions.append(USE)

            # Update local copy of the grid to reflect collection.
            grid[prim_loc[0], prim_loc[1], prim_idx] = 0

    # Move to the workshop required by the recipe (if any).
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_loc = nearest_cell(ws_idx, cur)
        if ws_loc is not None:
            path = bfs_path(cur, ws_loc)
            actions.extend(path_to_actions([cur] + path))
            cur = ws_loc

    # Final USE to craft the arrow.
    actions.append(USE)

    return actions

