            actions.extend(path)
            pos = apply_path(pos, path)
            actions.append(USE)   # craft at workshop
        else:
            # No workshop found; just attempt to use (may fail but keeps interface simple).
            actions.append(USE)
    else:
        # No workshop required; just use to craft.
        actions.append(USE)

    return actions


    import collections, numpy as np

    # Action indices as defined in CraftWorld.
