    import numpy as np
    from collections import deque

    # Action constants (match CraftWorld's definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: move a position according to an action (assumes movement is legal)
    # ------------------------------------------------------------------
    def _move(pos, act):
        x, y = pos
        if act == RIGHT:
            return (x + 1, y)
        if act == LEFT:
            return (x - 1, y)
        if act == DOWN:
            return (x, y + 1)
        if act == UP:
            return (x, y - 1)
        return pos

    # ------------------------------------------------------------------
    # Helper: BFS that finds a path (list of actions) from start to any cell
    # that is orthogonally adjacent to one of the target cells.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        w, h = occupied.shape
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path, (x, y)
            # expand neighbours
            for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),
                                  (DOWN, (0, 1)), (UP, (0, -1))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no reachable adjacent cell
        return [], start

    # ------------------------------------------------------------------
    # Retrieve the underlying CraftWorld and Cookbook objects from the env
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # CraftLab wraps the state; try to fetch from there
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("Could not locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure the environment has been reset and obtain the current state
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Basic situation information
    # ------------------------------------------------------------------
    pos = tuple(state.pos)          # (x, y)
    direction = int(state.dir)      # current facing direction
    grid = state.grid                # (W, H, n_kinds)

    # Work on a mutable copy so we can mark collected primitives as empty
    mutable_grid = np.copy(grid)

    actions = []

    # ------------------------------------------------------------------
    # Goal: craft an "arrow"
    # ------------------------------------------------------------------
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # locate remaining instances of this primitive
            locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]
            if not locs:
                # no more of this primitive on the map – abort
                break

            # choose the closest one (Manhattan distance)
            locs.sort(key=lambda lc: abs(lc[0] - pos[0]) + abs(lc[1] - pos[1]))
            target = locs[0]

            # cells occupied by any entity (including the target)
            occupied = np.any(mutable_grid > 0, axis=2)

            # find path to a free cell adjacent to the target
            path, new_pos = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # simulate movement to keep pos/direction up‑to‑date
            for act in path:
                pos = _move(pos, act)
                direction = act

            # determine direction needed to face the target
            tx, ty = target
            needed_dir = None
            if tx > pos[0]:
                needed_dir = RIGHT
            elif tx < pos[0]:
                needed_dir = LEFT
            elif ty > pos[1]:
                needed_dir = DOWN
            elif ty < pos[1]:
                needed_dir = UP

            # turn if necessary
            if needed_dir is not None and direction != needed_dir:
                actions.append(needed_dir)
                direction = needed_dir

            # pick up the primitive
            actions.append(USE)
            gathered += 1

            # mark the primitive as collected
            mutable_grid[tx, ty, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (could be a string name)
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else workshop_key)

        # locate workshop cells (they are static, use original grid)
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda lc: abs(lc[0] - pos[0]) + abs(lc[1] - pos[1]))
            ws_target = ws_cells[0]

            occupied = np.any(mutable_grid > 0, axis=2)
            path, new_pos = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)

            for act in path:
                pos = _move(pos, act)
                direction = act

            # ensure we are facing the workshop before using
            wx, wy = ws_target
            needed_dir = None
            if wx > pos[0]:
                needed_dir = RIGHT
            elif wx < pos[0]:
                needed_dir = LEFT
            elif wy > pos[1]:
                needed_dir = DOWN
            elif wy < pos[1]:
                needed_dir = UP

            if needed_dir is not None and direction != needed_dir:
                actions.append(needed_dir)
                direction = needed_dir

            # craft the arrow
            actions.append(USE)

    # ------------------------------------------------------------------
    # Return the compiled action sequence
    # ------------------------------------------------------------------
    return actions


    # Action constants (match CraftWorld's definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions leading from `start` to a
    # cell adjacent (Manhattan distance ≤ 1) to any of `targets`.  The search
    # avoids cells that are occupied in `grid` (any non‑zero kind blocks
    # movement).  Returns (actions, final_position).
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, grid):
        width, height, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # blocked cells
        from collections import deque
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are adjacent (or on) a target, stop.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path, (x, y)
            # Expand neighbours.
            for dx, dy, act in [(1, 0, RIGHT), (-1, 0, LEFT),
                                (0, 1, DOWN), (0, -1, UP)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable path.
        return [], start

    # ------------------------------------------------------------------
    # Retrieve the underlying CraftWorld and its Cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers (e.g., CraftLab) expose the world via the current state.
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance in env")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Current position, direction and mutable copy of the grid.
    pos = tuple(state.pos)          # (x, y)
    mutable_grid = state.grid.copy()  # (W, H, n_kinds)

    actions = []

    # ------------------------------------------------------------------
    # Goal: craft an "arrow".
    # ------------------------------------------------------------------
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        collected = 0
        while collected < required_cnt:
            # Locate remaining instances of this primitive.
            locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]
            if not locations:
                # No more of this primitive on the map – break out.
                break
            # Choose the closest instance (Manhattan distance).
            locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            target = locations[0]

            # Find a path to a free cell adjacent to the target.
            path, new_pos = _bfs_path(pos, [target], mutable_grid)
            actions.extend(path)

            # Simulate movement to keep `pos` up‑to‑date.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Pick up the primitive.
            actions.append(USE)
            collected += 1

            # Mark the cell as empty for subsequent path‑finding.
            mutable_grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name).
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        # Locate workshop cells (they are static in the original grid).
        workshop_cells = [tuple(p) for p in np.argwhere(state.grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            ws_target = workshop_cells[0]

            # Path to a free cell adjacent to the workshop.
            path, new_pos = _bfs_path(pos, [ws_target], mutable_grid)
            actions.extend(path)

            # Update position after moving.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)

            # Use the workshop to craft the arrow.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Return the assembled action sequence.
    # ------------------------------------------------------------------
    return actions

