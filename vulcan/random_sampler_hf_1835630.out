    import numpy as np
    import collections

    # Action indices (match CraftWorld defaults)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions that brings the agent from *start* to a
        cell adjacent (Manhattan distance == 1) to any cell in *targets*.
        *occupied* is a bool array where True means the cell cannot be stepped
        on.  If the start position is already adjacent, an empty list is
        returned.  If no reachable adjacent cell exists, an empty list is also
        returned."""
        width, height = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                # Check if this new position is adjacent to any target.
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []

    # ----------------------------------------------------------------------
    # Obtain the underlying world and the current state from the env wrapper.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # env may be a CraftLab wrapper; try to fetch the state first.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Determine which primitive resources are needed for a single arrow.
    # ----------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    # If the recipe contains no primitives (arrow itself is primitive) we
    # simply need to use the workshop (or just USE if none required).
    if not primitives_needed:
        primitives_needed = {}

    # ----------------------------------------------------------------------
    # Current grid, agent position and occupancy mask.
    # ----------------------------------------------------------------------
    grid = state.grid                     # (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested_cells = set()               # remember cells we already collected from

    # ----------------------------------------------------------------------
    # Collect all required primitives (greedy nearest‑first).
    # ----------------------------------------------------------------------
    for prim_idx, required_cnt in primitives_needed.items():
        collected = 0
        while collected < required_cnt:
            # Find all cells that still contain this primitive and have not been harvested.
            prim_cells = [
                tuple(coord) for coord in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(coord) not in harvested_cells
            ]
            if not prim_cells:
                # No more of this primitive on the map; break out.
                break

            # Choose the closest cell (Manhattan distance).
            prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = prim_cells[0]

            # Plan a path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement to update the current position.
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            actions.append(USE)
            harvested_cells.add(target)
            collected += 1

            # Update occupancy: the primitive cell becomes empty after pickup.
            occupied[target] = False
            grid[:, :, prim_idx][target] = 0

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer id).
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        workshop_cells = [tuple(c) for c in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            workshop_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)   # craft at the workshop
        else:
            # No workshop tile found; attempt to craft at current location.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions


    import numpy as np
    import collections

    # Action indices (match CraftWorld defaults)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    def _bfs_adjacent(start, targets, occupied):
        """Return a list of actions that moves from ``start`` to a cell adjacent
        to any cell in ``targets`` while avoiding occupied cells.

        Parameters
        ----------
        start: tuple[int, int]
            (x, y) start position.
        targets: list[tuple[int, int]]
            Positions we want to become adjacent to.
        occupied: np.ndarray[bool]
            2‑D mask where True means the cell cannot be entered.

        Returns
        -------
        list[int]
            Sequence of actions (DOWN/UP/LEFT/RIGHT) that reaches an adjacent
            cell, or an empty list if already adjacent / unreachable.
        """
        w, h = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}

        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add((nx, ny))
                new_path = path + [act]
                # Check adjacency after this move
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ----------------------------------------------------------------------
    # Retrieve world and current state (handle possible wrappers)
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Try to get it from the internal state wrapper.
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ----------------------------------------------------------------------
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    # If the recipe has no primitive components, just attempt to craft.
    if not primitives_needed:
        primitives_needed = {}

    # ----------------------------------------------------------------------
    # Current grid, position and occupancy mask
    # ----------------------------------------------------------------------
    grid = state.grid                     # shape (W, H, n_kinds)
    pos = tuple(state.pos)                # (x, y)
    occupied = np.any(grid > 0, axis=2)   # True where any entity exists

    actions = []
    harvested = set()                     # cells already collected from

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # Find all cells that still contain this primitive and are not yet harvested
            prim_cells = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not prim_cells:
                # No more of this primitive on the map – break out
                break

            # Choose the nearest primitive (Manhattan distance)
            prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = prim_cells[0]

            # Plan a path to a cell adjacent to the primitive
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement to update current position
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive (USE while facing it)
            actions.append(USE)
            harvested.add(target)
            gathered += 1

            # Update occupancy: the primitive layer disappears; if no other layer,
            # the cell becomes free for future navigation.
            occupied[target] = np.any(grid[target[0], target[1], :] > 0) and not (
                grid[target[0], target[1], prim_idx] == 0
            )
            grid[target[0], target[1], prim_idx] = 0

    # ----------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer id)
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str)
            else workshop_key
        )
        workshop_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if workshop_cells:
            # Move to the nearest workshop
            workshop_cells.sort(
                key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])
            )
            ws_target = workshop_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)
        else:
            # No workshop found – just use current location
            actions.append(USE)
    else:
        # No specific workshop required – use current location
        actions.append(USE)

    return actions

