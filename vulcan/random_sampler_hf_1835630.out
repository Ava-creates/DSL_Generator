    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions that brings the
    # agent from `start` to a cell adjacent to any of `targets`. The agent
    # may only walk on empty cells (no entity present in any kind layer).
    # ------------------------------------------------------------------
    def _bfs_path(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where something exists
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Stop if we are adjacent (or on) a target cell
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1 or (x, y) == (tx, ty):
                    return path
            # Expand 4‑connected neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:          # can only walk on empty cells
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable target – return empty list (will cause failure later)
        return []

    # ------------------------------------------------------------------
    # Locate the CraftWorld instance (may be stored directly on the env
    # or inside the current state wrapper).
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate CraftWorld instance in the environment.")

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Ensure we have a current state (reset if the environment hasn't started)
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # (x, y) coordinates
    grid = state.grid                # (W, H, n_kinds)

    actions = []
    harvested = set()                # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first)
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # Current locations of this primitive on the grid
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Order by Manhattan distance from current position
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        gathered = 0
        for loc in locations:
            if gathered >= needed_cnt:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive
            path = _bfs_path(pos, [loc])
            actions.extend(path)
            # Simulate moving the agent to keep `pos` up‑to‑date
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive
            actions.append(USE)
            harvested.add(loc)
            gathered += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name or already an int)
        workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        # Locate all workshop cells of this type
        workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_locs:
            # Choose the nearest workshop
            workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_locs[0]
            # Move adjacent to the workshop
            path = _bfs_path(pos, [target_ws])
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft using USE action
            actions.append(USE)

    return actions


