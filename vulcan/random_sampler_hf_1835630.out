    # Reset the environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Action indices (as defined by CraftLab.action_specs)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    height, width = grid.shape[0], grid.shape[1]

    def delta_to_action(dy, dx):
        """Convert a single‑step delta to the corresponding action."""
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        raise ValueError("Invalid delta for movement")

    def bfs(start, goal_cells):
        """
        Breadth‑first search from ``start`` to the nearest cell in ``goal_cells``.
        ``goal_cells`` is a set of (y, x) tuples that are acceptable destinations.
        Returns a list of positions from start (excluded) to the chosen goal (included),
        or None if no path exists.
        """
        from collections import deque

        # cells that are blocked for movement: any non‑grabbable entity
        blocked_kinds = list(world.non_grabbable_indices)

        visited = np.full((height, width), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True

        while q:
            (y, x), path = q.popleft()
            if (y, x) in goal_cells:
                return path  # path does NOT include the goal cell itself

            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < height and 0 <= nx < width and not visited[ny, nx]:
                    # a cell is traversable if it has no non‑grabbable entity
                    if not np.any(grid[ny, nx, blocked_kinds] > 0):
                        visited[ny, nx] = True
                        q.append(((ny, nx), path + [(ny, nx)]))
        return None

    def nearest_positions(kind_idx, from_pos):
        """
        Return a list of positions that contain ``kind_idx``.
        """
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        return [tuple(p) for p in locs]

    # ------------------------------------------------------------------
    # Determine the goal index for 'arrow' and its primitive requirements
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            # Find all cells containing the primitive
            prim_cells = nearest_positions(prim_idx, cur_pos)
            if not prim_cells:
                # Primitive not present – abort planning.
                return actions

            # For each primitive cell, consider the four adjacent free cells as
            # possible standing positions.
            candidate_goals = set()
            prim_to_adj = {}   # map from adjacent cell -> primitive cell it serves
            for py, px in prim_cells:
                for ay, ax in ((py - 1, px), (py + 1, px), (py, px - 1), (py, px + 1)):
                    if 0 <= ay < height and 0 <= ax < width:
                        # cell must be free of non‑grabbable objects
                        if not np.any(grid[ay, ax, list(world.non_grabbable_indices)] > 0):
                            candidate_goals.add((ay, ax))
                            prim_to_adj.setdefault((ay, ax), []).append((py, px))

            # If no free neighbour, we will stand directly on the primitive cell
            if not candidate_goals:
                candidate_goals = {tuple(loc) for loc in prim_cells}
                for cell in candidate_goals:
                    prim_to_adj.setdefault(cell, []).append(cell)

            # Find a path to the nearest reachable goal cell
            path = bfs(cur_pos, candidate_goals)
            if path is None:
                # No reachable position – abort planning.
                return actions

            # Translate the path into actions
            for nxt in path:
                dy = nxt[0] - cur_pos[0]
                dx = nxt[1] - cur_pos[1]
                actions.append(delta_to_action(dy, dx))
                cur_pos = nxt

            # Now we are on a cell adjacent (or on) the primitive.
            # Choose the associated primitive cell to face.
            target_prim = prim_to_adj[cur_pos][0]  # pick the first linked primitive
            ty, tx = target_prim

            # Face the primitive (add a single movement action towards it; it will be
            # blocked if the primitive occupies the cell, which correctly sets direction)
            dy = ty - cur_pos[0]
            dx = tx - cur_pos[1]
            if dy != 0 or dx != 0:
                actions.append(delta_to_action(dy, dx))

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_cells = nearest_positions(workshop_idx, cur_pos)
        if workshop_cells:
            goal_set = set(workshop_cells)
            path = bfs(cur_pos, goal_set)
            if path is not None:
                for nxt in path:
                    dy = nxt[0] - cur_pos[0]
                    dx = nxt[1] - cur_pos[1]
                    actions.append(delta_to_action(dy, dx))
                    cur_pos = nxt

    # Trigger crafting at the current location
    actions.append(USE)

    return actions


    # Reset the environment to a fresh start.
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # ------------------------------------------------------------------
    # Action indices (as defined by the environment's action specs)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks
        from ``start`` to ``goal`` using Manhattan distance only."""
        actions = []
        y, x = start
        gy, gx = goal
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind, from_pos, planning_grid):
        """Find the nearest cell that currently contains ``kind`` in the
        given planning grid. Returns (y, x) or ``None`` if not present."""
        locations = np.argwhere(planning_grid[:, :, kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = int(np.argmin(dists))
        return tuple(locations[nearest_idx])

    def is_free_cell(y, x, planning_grid):
        """Return True if the cell (y, x) does not contain any non‑grabbable
        entity (e.g., water, stone). Grabbable primitives are allowed."""
        if not (0 <= y < planning_grid.shape[0] and 0 <= x < planning_grid.shape[1]):
            return False
        occupied = np.any(planning_grid[y, x, list(world.non_grabbable_indices)] > 0)
        return not occupied

    # ------------------------------------------------------------------
    # Determine the goal index for 'arrow' and the required primitives.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # Work on a mutable copy of the grid so we can “remove” collected items.
    planning_grid = grid.copy()

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos, planning_grid)
            if target is None:
                # Primitive not available – abort planning.
                return actions
            ty, tx = target

            # Choose a free adjacent cell to stand on before using.
            adj = None
            for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
                if is_free_cell(ny, nx, planning_grid):
                    adj = (ny, nx)
                    break
            if adj is None:
                # No free neighbour; fall back to standing on the primitive cell itself.
                adj = (ty, tx)

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (direction that would move into it).
            dy = ty - cur_pos[0]
            dx = tx - cur_pos[1]
            if dy > 0:
                actions.append(DOWN)
            elif dy < 0:
                actions.append(UP)
            elif dx > 0:
                actions.append(RIGHT)
            elif dx < 0:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update the planning grid to reflect that the primitive has been taken.
            planning_grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos, planning_grid)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions

