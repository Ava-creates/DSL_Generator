    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    from collections import deque

    def bfs_adj(start, targets, grid):
        """Return a list of action names moving from start to a cell adjacent to any target."""
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # adjacency check (Chebyshev distance ≤ 1)
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # traversable only if the cell is empty
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None

    # ------------------------------------------------------------------
    # 1) Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                break  # cannot find more of this primitive

            path = bfs_adj(pos, prim_cells, grid)
            if path is None:
                break  # unreachable primitive

            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # pick up the primitive
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to workshop (if needed) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_adj(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # craft at the workshop
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    return actions

