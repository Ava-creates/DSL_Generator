    # Reset the environment and initialise useful structures
    env.reset()
    actions: list[int] = []
    act_map = env.action_specs()                     # e.g. {"UP":0, "DOWN":1, ...}
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    from collections import deque
    import numpy as np

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving the agent
    # from `start` to a cell that is adjacent (Chebyshev distance ≤ 1)
    # to any cell in `targets`.  Walks only through empty cells.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start: tuple[int, int],
                        targets: list[tuple[int, int]],
                        grid: np.ndarray) -> list[str] | None:
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()
            # adjacency test (including diagonals)
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path
            # expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # walk only through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None  # no reachable adjacent cell

    # ------------------------------------------------------------------
    # Identify goal and required primitives
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # locate all cells currently holding the primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # primitive not present – cannot collect further
                continue

            # plan a path to an adjacent cell of a reachable primitive
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # unreachable – skip this instance
                continue

            # execute movement actions
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # pick up the primitive (USE)
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # craft the item with USE at the workshop
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # Return the complete action sequence
    return actions


    # Reset the environment and initialise helpers
    env.reset()
    actions: list[int] = []
    act_map = env.action_specs()          # e.g. {"UP":0, "DOWN":1, ...}
    move_delta = {
        "UP":    (-1, 0),
        "DOWN":  (1, 0),
        "LEFT":  (0, -1),
        "RIGHT": (0, 1),
    }

    from collections import deque
    import numpy as np

    # ------------------------------------------------------------------
    # BFS that returns a list of action *names* moving the agent from
    # `start` to a cell that is adjacent (Chebyshev distance ≤ 1) to any
    # cell in `targets`.  Walks only through empty cells.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start: tuple[int, int],
                        targets: list[tuple[int, int]],
                        grid: np.ndarray) -> list[str] | None:
        W, H = grid.shape[:2]
        visited = np.full((W, H), False, dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()
            # Check adjacency to any target cell
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path
            # Expand neighbours
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # Only walk through empty cells (no entity present)
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None  # No reachable adjacent cell found

    # ------------------------------------------------------------------
    # Identify the goal and the primitives required to craft it
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # Locate all cells currently holding the primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # Primitive absent – cannot collect further
                continue

            # Plan a path to an adjacent cell of the nearest reachable primitive
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                # Unreachable primitive – skip this instance
                continue

            # Execute the movement actions
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # Pick up the primitive (USE)
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # Craft the item with USE at the workshop
            use_id = act_map["USE"]
            actions.append(use_id)
            env.step(use_id)

    # Return the accumulated action sequence
    return actions

