    import numpy as np
    import collections

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    # direction mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    def bfs(start, targets, blocked):
        """Bread‑first search returning a list of direction indices from start to any target."""
        w, h = blocked.shape
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # if we fall out, return empty path (should not happen in well‑formed tasks)
        return []

    # ----------------------------------------------------------------------
    # Access world / recipe information
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]
    arrow_recipe = cookbook.recipes[arrow_idx]

    # ----------------------------------------------------------------------
    # Determine full set of required items (including intermediates)
    # ----------------------------------------------------------------------
    needed_counts = {}

    def accumulate(item_idx, qty):
        """Recursively add required quantities for item_idx."""
        needed_counts[item_idx] = needed_counts.get(item_idx, 0) + qty
        # if the item has a recipe, recurse on its ingredients
        recipe = cookbook.recipes.get(item_idx)
        if recipe:
            for ing_idx, ing_qty in recipe.items():
                if isinstance(ing_idx, int):          # ignore the special "_at"/"_key"
                    accumulate(ing_idx, ing_qty * qty)

    accumulate(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # Split into primitives and craftable items, and compute a topological order
    # ----------------------------------------------------------------------
    primitive_set = cookbook.primitives
    craftable_items = [i for i in needed_counts if i not in primitive_set]

    order = []          # items will appear after all their ingredients
    visited = set()

    def dfs(item_idx):
        if item_idx in visited:
            return
        visited.add(item_idx)
        recipe = cookbook.recipes.get(item_idx)
        if recipe:
            for ing_idx in recipe:
                if isinstance(ing_idx, int):
                    dfs(ing_idx)
        order.append(item_idx)

    for item in craftable_items:
        dfs(item)

    # ----------------------------------------------------------------------
    # Prepare grid information (blocked cells)
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid
    w, h, _ = grid.shape

    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Action sequence construction
    # ----------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)

    # Helper: move to nearest cell containing a specific kind
    def move_to_kind(kind_idx, count):
        nonlocal cur_pos, actions
        for _ in range(count):
            # locate all cells that still contain the kind
            cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}
            path = bfs(cur_pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)
            # pick up the item
            actions.append(4)   # USE

    # ----------------------------------------------------------------------
    # 1) Collect all primitive resources
    # ----------------------------------------------------------------------
    for prim_idx in primitive_set:
        cnt = needed_counts.get(prim_idx, 0)
        if cnt > 0:
            move_to_kind(prim_idx, cnt)

    # ----------------------------------------------------------------------
    # 2) Craft items in topological order (including the final arrow)
    # ----------------------------------------------------------------------
    for item_idx in order:
        cnt = needed_counts.get(item_idx, 0)
        if cnt == 0:
            continue
        # locate workshop for this item
        recipe = cookbook.recipes.get(item_idx, {})
        workshop_key = recipe.get("_at", recipe.get("_key"))
        if workshop_key is None:
            continue  # should not happen
        workshop_idx = workshop_key if isinstance(workshop_key, int) else cookbook.index[workshop_key]

        workshop_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, workshop_idx] > 0}
        path = bfs(cur_pos, workshop_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)

        # use the workshop the required number of times
        actions.extend([4] * cnt)   # USE repeatedly

    return actions


    # ----------------------------------------------------------------------
    # Helper functions -------------------------------------------------------
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT

    def bfs(start, goal_cells, blocked):
        """Return a list of direction indices to reach any cell in goal_cells."""
        w, h = start_grid.shape[:2]
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable (should not happen)

    def move_to_kind(kind_idx, count):
        """Move to the nearest cell containing `kind_idx` and USE it `count` times."""
        nonlocal cur_pos, actions
        for _ in range(count):
            # locate all cells that currently contain the required kind
            cells = {(x, y) for x in range(w) for y in range(h)
                     if start_grid[x, y, kind_idx] > 0}
            path = bfs(cur_pos, cells, blocked_mask)
            actions.extend(path)
            # update position
            for a in path:
                dx, dy = DIRS[a]
                cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)
            actions.append(4)  # USE to pick up

    # ----------------------------------------------------------------------
    # Gather world / recipe information --------------------------------------
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]
    arrow_recipe = cookbook.recipes[arrow_idx]

    # ----------------------------------------------------------------------
    # Determine full crafting plan (primitives + intermediate crafts) -------
    # ----------------------------------------------------------------------
    needed_primitives = {}          # primitive_kind -> total count required
    craft_plan = []                 # list of (item_idx, count) in order to craft

    def resolve(item_idx, mult):
        """Recursively collect primitive needs and schedule crafts."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:  # primitive (no recipe)
            needed_primitives[item_idx] = needed_primitives.get(item_idx, 0) + mult
            return
        # first resolve all ingredient items
        for ing, cnt in rec.items():
            if isinstance(ing, int):          # ignore _at / _key entries
                resolve(ing, cnt * mult)
        # then schedule this item to be crafted
        craft_plan.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # Prepare grid and blocked‑cell mask ------------------------------------
    # ----------------------------------------------------------------------
    start_grid = env._current_state.grid
    w, h, _ = start_grid.shape
    blocked_mask = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked_mask |= start_grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # Build the action sequence ---------------------------------------------
    # ----------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)

    # 1) Collect all needed primitive resources
    for kind_idx, cnt in needed_primitives.items():
        move_to_kind(kind_idx, cnt)

    # 2) Execute crafting steps in the order produced by `resolve`
    for item_idx, cnt in craft_plan:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        # locate any workshop cell of the required type
        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if start_grid[x, y, wk_idx] > 0}
        path = bfs(cur_pos, wk_cells, blocked_mask)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)

        # use the workshop the required number of times
        actions.extend([4] * cnt)   # USE

    return actions

