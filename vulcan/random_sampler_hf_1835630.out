    # Define action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    from collections import deque

    def _is_empty(cell):
        """Return True if the cell has no entities."""
        return cell.sum() == 0

    def _find_nearest(grid, kind_idx, start):
        """Find the nearest cell (Manhattan) containing an entity of kind_idx."""
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    def _bfs_to_adjacent(grid, start, target):
        """
        Breadth‑first search for the shortest path (as a list of actions)
        from start to any empty cell that is 4‑connected to target.
        """
        h, w, _ = grid.shape
        moves = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (LEFT, (0, -1)),
            (RIGHT, (0, 1)),
        ]

        def _adjacent(pos):
            return (abs(pos[0] - target[0]) + abs(pos[1] - target[1])) == 1

        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)

        while q:
            (r, c), path = q.popleft()
            if _adjacent((r, c)):
                return path
            for act, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:
                    if _is_empty(grid[nr, nc, :]):
                        visited.add((nr, nc))
                        q.append(((nr, nc), path + [act]))
        return None  # no reachable adjacent cell

    # ------------------------------------------------------------------
    # Initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify the goal item (arrow)
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        # unknown goal – nothing to do
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for one arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting multiplicities)
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            # locate the nearest remaining primitive of this kind
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # primitive not present – abort early
                return action_seq

            # find path to a free cell adjacent to the primitive
            path = _bfs_to_adjacent(state.grid, state.pos, target)
            if path is None:
                # cannot reach it – abort
                return action_seq

            # execute movement actions
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq

            # use the primitive (the agent should now be facing it)
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_nearest(state.grid, workshop_idx, state.pos)
        if workshop_pos is not None:
            path = _bfs_to_adjacent(state.grid, state.pos, workshop_pos)
            if path is not None:
                for a in path:
                    reward, done, obs = env.step(a)
                    state = env._current_state
                    action_seq.append(a)
                    if done:
                        return action_seq
                # perform the crafting action
                reward, done, obs = env.step(USE)
                state = env._current_state
                action_seq.append(USE)

    return action_seq


    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: Manhattan path from src to dst (list of movement actions)
    # ------------------------------------------------------------------
    def _path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # Helper: Find nearest cell (Manhattan) containing a given kind
    # ------------------------------------------------------------------
    def _nearest(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: Find any cell containing a given kind
    # ------------------------------------------------------------------
    def _any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # ------------------------------------------------------------------
    # Identify the goal item index ("arrow")
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:               # not present in the cookbook
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respect multiplicities)
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target = _nearest(state.grid, prim_idx, state.pos)
            if target is None:        # primitive missing – abort
                return action_seq
            # Move to the primitive cell
            for a in _path(state.pos, target):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick it up
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # If recipe specifies a workshop, go there and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at", None)
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _path(state.pos, workshop_pos):
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Craft at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)

    return action_seq

