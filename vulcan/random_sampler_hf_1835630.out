    # ----------------------------------------------------------------------
    # Helper: BFS that avoids any occupied cell and returns a list of actions
    # moving from `start` to a position adjacent to any cell in `targets`.
    # ----------------------------------------------------------------------
    def _bfs_to_adjacent(start, targets):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where something blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

