    # Primitive requirements for a single arrow
    required = world.cookbook.primitives_for(target_idx)

    import heapq

    def state_key(st):
        """Hashable representation of a state for visited checking."""
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    def heuristic(st):
        """Estimate of remaining steps: missing primitives + one craft action."""
        if st.satisfies("", target_idx):
            return 0
        miss = 0
        inv = st.inventory
        for kind, cnt in required.items():
            have = inv[kind] if kind < len(inv) else 0
            if have < cnt:
                miss += cnt - have
        # at least one USE action needed to craft
        return miss + 1

    start_key = state_key(start_state)
    visited = {start_key: 0}
    frontier = [(heuristic(start_state), 0, start_state, [])]  # (f, g, state, actions)

    n_actions = getattr(world, "n_actions", 5)
    MAX_STEPS = 800

    while frontier:
        f, g, cur_state, cur_actions = heapq.heappop(frontier)

        if cur_state.satisfies("", target_idx):
            return cur_actions

        if g >= MAX_STEPS:
            continue

        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = state_key(nxt_state)
            ng = g + 1
            if key not in visited or ng < visited[key]:
                visited[key] = ng
                nf = ng + heuristic(nxt_state)
                heapq.heappush(frontier, (nf, ng, nxt_state, cur_actions + [a]))

    # No plan found within limits
    return []


