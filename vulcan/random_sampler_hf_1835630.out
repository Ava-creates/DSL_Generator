def make_arrow_vn(env):
    actions = []
    # reset env if not already
    obs = env.reset()
    state = env._current_state  # access internal state
    world = env.world
    goal = env.task.goal
    # get primitive requirements
    primitives = world.cookbook.primitives_for(goal)
    # get workshop kind for goal
    recipe = world.cookbook.recipes.get(goal, {})
    workshop_kind = recipe.get('_at')
    # helper to find nearest cell of a kind
    def find_cells(kind):
        grid = state.grid  # shape (W,H,K)
        positions = np.argwhere(grid[:,:,kind] == 1)
        return [tuple(p[:2]) for p in positions]
    # navigation helper
    def move_to(target):
        nonlocal state, actions
        # simple greedy move: first adjust x then y
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:
                # need move right (assuming x is column)
                actions.append(3)  # RIGHT
                reward, new_state = state.step(3)
            elif x > tx:
                actions.append(2)  # LEFT
                reward, new_state = state.step(2)
            elif y < ty:
                actions.append(0)  # DOWN
                reward, new_state = state.step(0)
            elif y > ty:
                actions.append(1)  # UP
                reward, new_state = state.step(1)
            state = new_state
    # function to collect a primitive kind count times
    def collect(kind, count):
        nonlocal state, actions
        cells = find_cells(kind)
        if not cells:
            return
        # simple: pick first cell
        target = cells[0]
        # move adjacent to target (choose position next to it)
        # we will move to a cell that is not blocked (empty)
        # For simplicity, move onto the cell itself then use (may work)
        move_to(target)
        for _ in range(count):
            actions.append(4)  # USE
            reward, new_state = state.step(4)
            state = new_state
    # collect primitives
    for kind, cnt in primitives.items():
        collect(kind, cnt)
    # go to workshop and craft
    if workshop_kind is not None:
        cells = find_cells(workshop_kind)
        if cells:
            target = cells[0]
            move_to(target)
            actions.append(4)  # USE to craft
            reward, new_state = state.step(4)
            state = new_state
    return actions


    # Reset the environment to obtain the initial state.
    env.reset()
    state = env._current_state
    grid = state.grid.copy()
    pos = state.pos  # (x, y)
    direction = state.dir

    world = env.world
    cookbook = world.cookbook

    # Index of the target item.
    arrow_idx = cookbook.index["arrow"]
    recipe = cookbook.recipes[arrow_idx]

    # Workshop where the arrow must be crafted.
    workshop_idx = recipe["_at"]

    # Primitive requirements (exclude the workshop entry).
    prim_counts = {k: v for k, v in recipe.items() if k != "_at"}

    # Occupancy map: True where any entity occupies the cell.
    occ = np.any(grid > 0, axis=2)  # shape (WIDTH, HEIGHT)

    # Direction vectors: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.
    dx = [0, 0, -1, 1]
    dy = [1, -1, 0, 0]

    actions = []

    # ------------------------------------------------------------------
    # Helper: breadth‑first search on (x, y, direction) state space.
    # Returns a list of movement actions that brings the agent from
    # (sx, sy, sd) to (tx, ty, td).  Raises if no path exists.
    # ------------------------------------------------------------------
    def bfs(sx, sy, sd, tx, ty, td):
        W, H = occ.shape
        visited = np.zeros((W, H, 4), dtype=bool)
        prev = {}
        dq = collections.deque()
        dq.append((sx, sy, sd))
        visited[sx, sy, sd] = True
        while dq:
            x, y, d = dq.popleft()
            if (x, y, d) == (tx, ty, td):
                # Reconstruct path.
                path = []
                cur = (x, y, d)
                while cur != (sx, sy, sd):
                    cur_prev, act = prev[cur]
                    path.append(act)
                    cur = cur_prev
                path.reverse()
                return path
            for a in range(4):  # movement actions
                nx = x + dx[a]
                ny = y + dy[a]
                if 0 <= nx < W and 0 <= ny < H and not occ[nx, ny]:
                    nd = a
                    if not visited[nx, ny, nd]:
                        visited[nx, ny, nd] = True
                        prev[(nx, ny, nd)] = ((x, y, d), a)
                        dq.append((nx, ny, nd))
        raise ValueError("No path found")

    # ------------------------------------------------------------------
    # Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed in prim_counts.items():
        for _ in range(needed):
            # Locate remaining instances of the primitive.
            locations = np.argwhere(grid[..., prim_idx] > 0)
            if locations.size == 0:
                raise ValueError("Required primitive not present on the map")
            reached = False
            for (tx, ty) in locations:
                # Try each direction that would let us face the primitive.
                for d in range(4):
                    adj_x = tx - dx[d]
                    adj_y = ty - dy[d]
                    if not (0 <= adj_x < occ.shape[0] and 0 <= adj_y < occ.shape[1]):
                        continue
                    if occ[adj_x, adj_y]:
                        continue
                    try:
                        move_seq = bfs(pos[0], pos[1], direction, adj_x, adj_y, d)
                    except ValueError:
                        continue
                    # Move to the chosen adjacent cell.
                    actions.extend(move_seq)
                    # Use action to pick up the primitive.
                    actions.append(4)  # USE
                    # Update internal state.
                    pos = (adj_x, adj_y)
                    direction = d
                    grid[tx, ty, prim_idx] = 0
                    occ = np.any(grid > 0, axis=2)
                    reached = True
                    break
                if reached:
                    break
            if not reached:
                raise ValueError("Unable to reach a required primitive")

    # ------------------------------------------------------------------
    # Move to the workshop and craft the arrow.
    # ------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[..., workshop_idx] > 0)
    if workshop_cells.size == 0:
        raise ValueError("Workshop not found on the map")
    crafted = False
    for (wx, wy) in workshop_cells:
        for d in range(4):
            adj_x = wx - dx[d]
            adj_y = wy - dy[d]
            if not (0 <= adj_x < occ.shape[0] and 0 <= adj_y < occ.shape[1]):
                continue
            if occ[adj_x, adj_y]:
                continue
            try:
                move_seq = bfs(pos[0], pos[1], direction, adj_x, adj_y, d)
            except ValueError:
                continue
            actions.extend(move_seq)
            actions.append(4)  # USE to craft
            crafted = True
            break
        if crafted:
            break
    if not crafted:
        raise ValueError("Unable to reach the workshop for crafting")

    return actions

