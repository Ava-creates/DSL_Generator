    import numpy as np
    from collections import deque

    # Action identifiers – must match the ordering used in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}

    def _bfs_adjacent(start, targets, occupied):
        """
        Return a list of actions that moves from ``start`` to a cell
        adjacent (Manhattan distance = 1) to any cell in ``targets``.
        Cells where ``occupied`` is True are treated as blocked.
        """
        w, h = occupied.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(start[0] - tx) + abs(start[1] - ty) == 1:
                return []

        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited or occupied[nx, ny]:
                    continue
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                visited.add((nx, ny))
                q.append((nx, ny, new_path))
        return []  # unreachable

