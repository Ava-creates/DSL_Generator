    def _move_to(cur_pos, target, seq):
        """Append moves that bring cur_pos (mutable [x,y]) to target (x,y)."""
        while cur_pos[0] != target[0] or cur_pos[1] != target[1]:
            if cur_pos[0] < target[0]:
                seq.append(RIGHT)
                cur_pos[0] += 1
            elif cur_pos[0] > target[0]:
                seq.append(LEFT)
                cur_pos[0] -= 1
            elif cur_pos[1] < target[1]:
                seq.append(DOWN)
                cur_pos[1] += 1
            elif cur_pos[1] > target[1]:
                seq.append(UP)
                cur_pos[1] -= 1

