    # Action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: move a position according to an action (assumes move succeeds)
    # ------------------------------------------------------------------
    def _move(pos, act):
        x, y = pos
        if act == RIGHT:
            return (x + 1, y)
        if act == LEFT:
            return (x - 1, y)
        if act == DOWN:
            return (x, y + 1)
        if act == UP:
            return (x, y - 1)
        return pos

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions leading to a cell
    # adjacent to any target location (target cells may be occupied).
    # Also returns the final adjacent position.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occupied):
        from collections import deque
        w, h = occupied.shape
        q = deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # check adjacency to any target
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path, (x, y)
            # explore neighbours
            for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),
                                  (DOWN, (0, 1)), (UP, (0, -1))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # no reachable adjacent cell
        return [], start

    # ------------------------------------------------------------------
    # Retrieve the underlying CraftWorld and its Cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the current state
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state; reset the environment if needed.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal: make an "arrow"
    # ------------------------------------------------------------------
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Planning state
    # ------------------------------------------------------------------
    pos = tuple(state.pos)          # (x, y)
    direction = int(state.dir)      # current facing direction
    mutable_grid = np.copy(state.grid)   # mutable copy for planning
    actions = []

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        gathered = 0
        while gathered < needed_cnt:
            # locate remaining instances of this primitive
            locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]
            if not locations:
                # no more primitives of this type – break to avoid infinite loop
                break
            # pick the closest one
            locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = locations[0]

            # occupied cells for path‑finding (ignore the target itself – it is blocked)
            occupied = np.any(mutable_grid > 0, axis=2)

            # find path to a free cell adjacent to the target
            path, pos = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # update position and direction following the path
            for act in path:
                pos = _move(pos, act)
                direction = act

            # determine which direction we must face to interact with the target
            tx, ty = target
            needed_dir = None
            if tx > pos[0]:
                needed_dir = RIGHT
            elif tx < pos[0]:
                needed_dir = LEFT
            elif ty > pos[1]:
                needed_dir = DOWN
            elif ty < pos[1]:
                needed_dir = UP

            # adjust facing direction if necessary (a single turn action suffices)
            if needed_dir is not None and direction != needed_dir:
                actions.append(needed_dir)
                direction = needed_dir

            # pick up the primitive
            actions.append(USE)
            gathered += 1

            # mark the cell as empty in our mutable copy
            mutable_grid[tx, ty, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if the recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # resolve workshop index (may be a string name)
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else workshop_key)

        # locate workshop cells (they are not consumable, so we keep the original grid)
        workshop_cells = [tuple(p) for p in np.argwhere(state.grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            ws_target = workshop_cells[0]

            occupied = np.any(mutable_grid > 0, axis=2)
            path, pos = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)

            for act in path:
                pos = _move(pos, act)
                direction = act

            # face the workshop
            wx, wy = ws_target
            needed_dir = None
            if wx > pos[0]:
                needed_dir = RIGHT
            elif wx < pos[0]:
                needed_dir = LEFT
            elif wy > pos[1]:
                needed_dir = DOWN
            elif wy < pos[1]:
                needed_dir = UP

            if needed_dir is not None and direction != needed_dir:
                actions.append(needed_dir)
                direction = needed_dir

            # craft the arrow
            actions.append(USE)

    # ------------------------------------------------------------------
    # Return the complete action list
    # ------------------------------------------------------------------
    return actions


    import collections
    import numpy as np

    # Action indices as defined in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    # `start` to a cell orthogonally adjacent to any cell in `targets`.
    # Cells where `occ` is True are treated as blocked.
    # ------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are adjacent (Manhattan distance == 1) to any target, stop.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # Explore neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell.
        return []

    # ------------------------------------------------------------------
    # Helper: apply a list of actions to a position.
    # ------------------------------------------------------------------
    def _apply_actions(pos, actions):
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate the underlying CraftWorld and its Cookbook.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state; reset the environment if needed.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal: make an "arrow".
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for the goal (primitive index → count).
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Working copies for planning.
    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()             # (W, H, n_kinds)
    occ = np.any(grid, axis=2)           # occupied mask (bool)

    plan_actions = []
    harvested = set()                    # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # All cells currently containing this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed_cnt:
                break
            if cell in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_adjacent(pos, [cell], occ)
            plan_actions.extend(path)
            pos = _apply_actions(pos, path)

            # Pick it up.
            plan_actions.append(USE)

            # Update planning structures: remove the primitive from the cell.
            grid[cell[0], cell[1], prim_idx] = 0
            occ = np.any(grid, axis=2)   # recompute occupied mask
            harvested.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # Go to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string or already an int).
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            # Choose the nearest workshop cell.
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_adjacent(pos, [target_ws], occ)
            plan_actions.extend(path)
            pos = _apply_actions(pos, path)
            plan_actions.append(USE)   # craft at workshop
        else:
            # No visible workshop; attempt to craft in place.
            plan_actions.append(USE)
    else:
        # No specific workshop required.
        plan_actions.append(USE)

    return plan_actions

