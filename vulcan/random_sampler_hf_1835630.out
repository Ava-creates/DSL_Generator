    # Directions correspond to action indices: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]

    # ------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of movement actions
    # ------------------------------------------------------------------
    def bfs(start, targets, blocked):
        w, h = grid.shape[:2]
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # No path found – should not happen in a solvable scenario
        return []

    # ------------------------------------------------------------------
    # Helper: move to a cell containing a given kind and use it
    # ------------------------------------------------------------------
    def acquire(kind_idx, count):
        nonlocal pos, actions
        for _ in range(count):
            # Find all cells that currently hold the required kind
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(4)   # USE

    # ------------------------------------------------------------------
    # Gather world / recipe information
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    # ------------------------------------------------------------------
    # Resolve full crafting plan (primitives needed + ordered craft steps)
    # ------------------------------------------------------------------
    needed_prims = {}          # primitive idx → total count required
    craft_steps = []           # list of (item_idx, count) in dependency order

    def resolve(item_idx, multiplier):
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier
            return
        # Resolve ingredient items first (ignore special keys like "_at")
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * multiplier)
        # After its ingredients, schedule this item to be crafted
        craft_steps.append((item_idx, multiplier))

    resolve(arrow_idx, 1)

    # ------------------------------------------------------------------
    # Prepare static data: grid, blocked cells, dimensions
    # ------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ------------------------------------------------------------------
    # Build the final action sequence
    # ------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 1) Collect every primitive required by the recipe
    for kind_idx, cnt in needed_prims.items():
        acquire(kind_idx, cnt)

    # 2) Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        # Locate any workshop cell of the required type
        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        # Use the workshop the required number of times
        actions.extend([4] * cnt)

    return actions


