    craft_steps = []

    def resolve(item_idx: int, mult: int) -> None:
        """Recursively collect primitive requirements and schedule crafting."""
        recipe = cookbook.recipes.get(item_idx)
        if recipe is None:
            # Primitive item (no recipe)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # Resolve all ingredient items (ignore special keys like "_at")
        for ing, cnt in recipe.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # After its ingredients, schedule crafting of this item
        craft_steps.append((item_idx, mult))

