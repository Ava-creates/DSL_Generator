                if cand_path is not None:
                    path, loc = cand_path, candidate
                    break
            if path is None:
                break  # cannot reach any remaining primitive
            actions.extend(path)
            move_along(path)
            # pick up
            actions.append(4)            # USE
            grid[loc[0], loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            amount -= 1

