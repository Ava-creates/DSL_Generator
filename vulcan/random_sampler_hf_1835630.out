    # Directions correspond to action ids: 0=DOWN,1=UP,2=LEFT,3=RIGHT
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    ACTION_USE = 4

    # ------------------------------------------------------------------
    # Helper: BFS returns list of actions to reach any cell in `targets`
    # ------------------------------------------------------------------
    def bfs(start, targets, blocked):
        w, h = blocked.shape
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable in valid scenarios

    # ------------------------------------------------------------------
    # Helper: move to a cell containing `kind_idx` and USE it `cnt` times
    # ------------------------------------------------------------------
    def go_to_and_use(kind_idx, cnt):
        nonlocal pos, actions, grid, w, h, blocked
        for _ in range(cnt):
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 1) Resolve recipe for "arrow": primitives needed and crafting order
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}          # primitive idx -> total count
    craft_steps = []           # list of (item_idx, count) in execution order

    def resolve(item_idx, mult):
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive, no recipe
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # Resolve ingredient items first (ignore special keys)
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # After ingredients are ensured, schedule this item to be crafted
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ------------------------------------------------------------------
    # 2) Static environment data
    # ------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ------------------------------------------------------------------
    # 3) Build action sequence
    # ------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 3a) Collect all required primitive resources
    for kind_idx, count in needed_prims.items():
        go_to_and_use(kind_idx, count)

    # 3b) Perform crafting steps at their workshops
    for item_idx, count in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([ACTION_USE] * count)

    return actions


    import collections
    import numpy as np

    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    ACTION_USE = 4

    def bfs(start, targets, blocked):
        """Return a list of action indices moving from start to any target cell."""
        w, h = blocked.shape
        q = collections.deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable in solvable scenarios

    def go_to_and_use(kind_idx, count):
        """Move to a cell containing `kind_idx` and press USE `count` times."""
        nonlocal pos, actions, grid, w, h, blocked
        for _ in range(count):
            cells = {(x, y) for x in range(w) for y in range(h)
                     if grid[x, y, kind_idx] > 0}
            path = bfs(pos, cells, blocked)
            actions.extend(path)
            for a in path:
                dx, dy = DIRS[a]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(ACTION_USE)

    # ----------------------------------------------------------------------
    # 1) Gather recipe information for the target item "arrow"
    # ----------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index["arrow"]

    needed_prims = {}   # primitive kind -> total count required
    craft_steps = []    # ordered list of (item_idx, count) to craft

    def resolve(item_idx, mult):
        """Recursively collect primitive requirements and schedule crafting."""
        rec = cookbook.recipes.get(item_idx)
        if rec is None:                     # primitive (no recipe entry)
            needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult
            return
        # Resolve ingredient items first (ignore special keys like "_at" or "_key")
        for ing, cnt in rec.items():
            if isinstance(ing, int):
                resolve(ing, cnt * mult)
        # Schedule this item to be crafted after its ingredients are ready
        craft_steps.append((item_idx, mult))

    resolve(arrow_idx, 1)

    # ----------------------------------------------------------------------
    # 2) Static environment data
    # ----------------------------------------------------------------------
    grid = env._current_state.grid
    w, h, _ = grid.shape
    blocked = np.zeros((w, h), dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    # ----------------------------------------------------------------------
    # 3) Build the action sequence
    # ----------------------------------------------------------------------
    actions = []
    pos = tuple(env._current_state.pos)

    # 3a) Collect all required primitive resources
    for kind_idx, cnt in needed_prims.items():
        go_to_and_use(kind_idx, cnt)

    # 3b) Perform crafting steps at the appropriate workshops
    for item_idx, cnt in craft_steps:
        rec = cookbook.recipes[item_idx]
        wk_key = rec.get("_at", rec.get("_key"))
        wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]

        wk_cells = {(x, y) for x in range(w) for y in range(h)
                    if grid[x, y, wk_idx] > 0}
        path = bfs(pos, wk_cells, blocked)
        actions.extend(path)
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)

        actions.extend([ACTION_USE] * cnt)

    return actions

