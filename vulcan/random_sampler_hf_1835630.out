    import numpy as np
    import collections

    # --------------------------------------------------------------------- #
    # Helper: BFS that returns a list of movement actions from start to target.
    # --------------------------------------------------------------------- #
    def _bfs(start, target, grid, non_grab):
        """Return list of action indices to move from start to target.
        Returns None if no path is found."""
        width, height = grid.shape[:2]

        # Determine blocked cells (any non‑grabbable entity present)
        if non_grab:
            blocked = np.any(grid[:, :, list(non_grab)] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Allow stepping onto the target even if it is otherwise blocked
        blocked[target[0], target[1]] = False

        # BFS structures
        q = collections.deque([start])
        came_from = {start: None}
        action_to = {}

        # Action mapping
        spec = env.action_specs()
        dirs = [
            (spec["DOWN"], (1, 0)),
            (spec["UP"], (-1, 0)),
            (spec["RIGHT"], (0, 1)),
            (spec["LEFT"], (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_to[nxt] = a
                        q.append(nxt)

        if target not in came_from:
            return None

        # Reconstruct action list
        path = []
        cur = target
        while cur != start:
            path.append(action_to[cur])
            cur = came_from[cur]
        path.reverse()
        return path

    # --------------------------------------------------------------------- #
    # Gather task specifics
    # --------------------------------------------------------------------- #
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )

    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    state = env._current_state
    pos = tuple(state.pos)               # current (x, y)
    grid = state.grid.copy()              # occupancy tensor (W, H, n_kinds)
    non_grab = set(env.world.non_grabbable_indices)

    actions = []

    # --------------------------------------------------------------------- #
    # Collect each required primitive (including multiple copies)
    # --------------------------------------------------------------------- #
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # Find all remaining instances of this primitive on the map
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # Primitive not available; abort collection for this type
                break

            # Choose the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            # Plan a path to the target
            path = _bfs(pos, target, grid, non_grab)
            if path is None:
                # Fallback to naive Manhattan moves (ignores obstacles)
                dx, dy = target[0] - pos[0], target[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1

            actions.extend(path)
            actions.append(USE)                     # pick up the primitive

            # Update simulated position and grid (primitive removed)
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0

    # --------------------------------------------------------------------- #
    # Move to the appropriate workshop (if required) and craft the goal.
    # --------------------------------------------------------------------- #
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locations:
            target_ws = min(
                ws_locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = _bfs(pos, target_ws, grid, non_grab)
            if path is None:
                dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1
            actions.extend(path)
            actions.append(USE)                     # craft at the workshop

    return actions


    import numpy as np
    import collections

    # --------------------------------------------------------------------- #
    # Action indices
    # --------------------------------------------------------------------- #
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"],
        spec["UP"],
        spec["LEFT"],
        spec["RIGHT"],
        spec["USE"],
    )

    # --------------------------------------------------------------------- #
    # Goal and required primitive counts
    # --------------------------------------------------------------------- #
    goal = env.task.goal
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    # --------------------------------------------------------------------- #
    # Snapshot of current state (used for planning only)
    # --------------------------------------------------------------------- #
    state = env._current_state
    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()               # occupancy tensor (W, H, n_kinds)
    actions = []

    # --------------------------------------------------------------------- #
    # Helper: BFS that returns a list of movement actions from start to target.
    # --------------------------------------------------------------------- #
    def _bfs(start, target):
        """Return list of movement actions from start to target, or None."""
        width, height = grid.shape[:2]

        # Cells that cannot be entered: any non‑grabbable entity present
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        # Allow stepping onto the target even if it is otherwise blocked
        blocked[target[0], target[1]] = False

        # BFS structures
        q = collections.deque([start])
        came_from = {start: None}
        action_to = {}

        dirs = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]

        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_to[nxt] = a
                        q.append(nxt)

        if target not in came_from:
            return None

        # Reconstruct action list
        path = []
        cur = target
        while cur != start:
            path.append(action_to[cur])
            cur = came_from[cur]
        path.reverse()
        return path

    # --------------------------------------------------------------------- #
    # Collect each required primitive (multiple copies possible)
    # --------------------------------------------------------------------- #
    for prim_idx, count in needed.items():
        for _ in range(count):
            # Find remaining instances of this primitive on the map
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more copies left; abort further collection of this primitive
                break

            # Choose the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            # Plan a path to the target cell
            path = _bfs(pos, target)
            if path is None:
                # Fallback: direct Manhattan moves (ignores obstacles)
                dx, dy = target[0] - pos[0], target[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1

            actions.extend(path)
            actions.append(USE)                     # pick up the primitive

            # Update simulated position and remove the primitive from the grid
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0

    # --------------------------------------------------------------------- #
    # Move to the appropriate workshop (if any) and craft the final item
    # --------------------------------------------------------------------- #
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            # Choose the nearest workshop
            target_ws = min(
                ws_locs,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = _bfs(pos, target_ws)
            if path is None:
                # Fallback to Manhattan moves
                dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]
                path = []
                while dx > 0:
                    path.append(DOWN)
                    dx -= 1
                while dx < 0:
                    path.append(UP)
                    dx += 1
                while dy > 0:
                    path.append(RIGHT)
                    dy -= 1
                while dy < 0:
                    path.append(LEFT)
                    dy += 1
            actions.extend(path)
            actions.append(USE)                     # craft at the workshop

    return actions

