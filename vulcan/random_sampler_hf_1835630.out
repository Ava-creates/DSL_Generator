                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)  # craft at workshop
        else:
            # No visible workshop – use current cell.
            actions.append(USE)
    else:
        # No specific workshop required.
        actions.append(USE)

    return actions

