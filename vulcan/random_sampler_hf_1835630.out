    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions that moves the agent from
    # `start` to a cell adjacent (Manhattan distance ≤ 1) to any of the
    # `target_cells`.  `occ` is a boolean 2‑D array where True marks a
    # blocked cell.
    # ------------------------------------------------------------------
    def _bfs_path(start, target_cells, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        targets = set(target_cells)

        while q:
            x, y, path = q.popleft()
            # If we are already adjacent to a target, stop.
            for tx, ty in targets:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
