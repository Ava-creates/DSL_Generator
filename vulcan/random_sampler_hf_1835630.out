    return [USE] * max_steps


    # Helper to get index of a named kind
    def _kind_idx(name):
        return env.world.cookbook.index[name]

    # Mapping of movement actions (assume grid rows = x, cols = y)
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    move_to_action = {
        (1, 0): ACTION_DOWN,
        (-1, 0): ACTION_UP,
        (0, -1): ACTION_LEFT,
        (0, 1): ACTION_RIGHT,
    }

    # Reset environment to obtain initial state
    obs = env.reset()
    state = env._current_state
    grid = state.grid
    pos = state.pos

    # Goal: make an arrow
    goal_idx = _kind_idx('arrow')
    # Primitive requirements for one arrow
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    needed = {k: v for k, v in recipe.items() if k != '_key'}
    workshop_kind = recipe.get('_key')  # workshop where arrow is crafted

    # Set of indices that block movement (non‑grabbable entities)
    block_set = env.world.non_grabbable_indices

    # Function to test if a cell is walkable
    def _walkable(x, y):
        if x < 0 or x >= grid.shape[0] or y < 0 or y >= grid.shape[1]:
            return False
        # blocked if any non‑grabbable kind is present
        return not any(grid[x, y, idx] > 0 for idx in block_set)

    # BFS to compute a path (as list of actions) from current pos to target cell
    from collections import deque

    def _bfs_path(start, target):
        if start == target:
            return []
        q = deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for dx, dy in [(1, 0), (-1, 0), (0, -1), (0, 1)]:
                nx, ny = x + dx, y + dy
                if _walkable(nx, ny) and (nx, ny) not in came_from:
                    came_from[(nx, ny)] = (cur, (dx, dy))
                    q.append((nx, ny))
        # reconstruct actions
        if target not in came_from:
            return []  # no path found
        actions = []
        cur = target
        while came_from[cur] is not None:
            prev, move = came_from[cur]
            actions.append(move_to_action[move])
            cur = prev
        actions.reverse()
        return actions

    # Main planning loop
    actions_seq = []
    max_steps = 1000  # safety guard
    while not state.satisfies('', goal_idx) and len(actions_seq) < max_steps:
        inventory = state.inventory
        # Check if we have enough primitives to craft
        have_all = True
        for prim_idx, cnt in needed.items():
            if inventory[prim_idx] < cnt:
                have_all = False
                break

        if have_all:
            # Go to workshop and craft
            # Find any workshop cell of the required kind
            ws_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
            if ws_cells.size == 0:
                break  # cannot find workshop
            # choose nearest workshop
            dists = np.sum(np.abs(ws_cells - np.array(state.pos)), axis=1)
            target = tuple(ws_cells[dists.argmin()])
            actions_seq += _bfs_path(state.pos, target)
            # execute moves
            for a in actions_seq[-len(_bfs_path(state.pos, target)):]:
                _, state = env.step(a)
            # use (craft)
            actions_seq.append(ACTION_USE)
            _, state = env.step(ACTION_USE)
        else:
            # Find a primitive we still need
            missing = None
            for prim_idx, cnt in needed.items():
                if inventory[prim_idx] < cnt:
                    missing = prim_idx
                    break
            if missing is None:
                break
            # locate nearest primitive of this kind
            prim_cells = np.argwhere(grid[:, :, missing] > 0)
            if prim_cells.size == 0:
                break  # cannot find needed primitive
            dists = np.sum(np.abs(prim_cells - np.array(state.pos)), axis=1)
            target = tuple(prim_cells[dists.argmin()])
            actions_seq += _bfs_path(state.pos, target)
            # execute moves
            for a in actions_seq[-len(_bfs_path(state.pos, target)):]:
                _, state = env.step(a)
            # pick up primitive
            actions_seq.append(ACTION_USE)
            _, state = env.step(ACTION_USE)

    return actions_seq

