    import numpy as np
    from collections import deque

    # Action constants as defined by CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # make a mutable copy for planning

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from ``start`` to ``goal`` while avoiding non‑grabbable
        obstacles. ``start`` and ``goal`` are (y, x) tuples."""
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                actions_rev = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        actions_rev.append(DOWN)
                    elif py == cur[0] + 1:
                        actions_rev.append(UP)
                    elif px == cur[1] - 1:
                        actions_rev.append(RIGHT)
                    elif px == cur[1] + 1:
                        actions_rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(actions_rev))

            for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # block movement if any non‑grabbable entity occupies the cell
                    if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))
        # No path found – return empty list (should not happen for valid scenarios)
        return []

    def find_nearest(cell_kind, from_pos):
        """Find the nearest cell containing ``cell_kind`` (primitive or workshop)
        relative to ``from_pos``. Returns (y, x) or None."""
        locations = np.argwhere(grid[:, :, cell_kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = np.argmin(dists)
        return tuple(locations[nearest_idx])

    # ------------------------------------------------------------------
    # Identify goal and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early
                return actions

            ty, tx = target

            # Choose a free adjacent cell to stand on before using
            adj = None
            neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]
            for ny, nx in neighbours:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; fall back to standing on the primitive cell itself
                adj = target

            # Move to the adjacent cell
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (add a movement action that will be blocked)
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive
            actions.append(USE)

            # Update our planning grid to reflect that the primitive has been taken
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location
    actions.append(USE)

    return actions


