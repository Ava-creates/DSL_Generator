    # BFS path finder
    import collections
    def bfs(start, target):
        width, height = grid.shape[:2]
        # blocked cells: any non‑grabbable entity present
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)
        # allow stepping on target even if blocked (e.g., workshop)
        blocked[target[0], target[1]] = False
        q = collections.deque([start])
        came = {start: None}
        act = {}
        dirs = [(DOWN, (1,0)), (UP, (-1,0)), (RIGHT, (0,1)), (LEFT, (0,-1))]
        while q:
            cur = q.popleft()
            if cur == target:
                break
            x,y = cur
            for a,(dx,dy) in dirs:
                nx, ny = x+dx, y+dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx,ny]:
                    nxt = (nx,ny)
                    if nxt not in came:
                        came[nxt]=cur
                        act[nxt]=a
                        q.append(nxt)
        if target not in came:
            return None
        path=[]
        cur=target
        while cur!=start:
            path.append(act[cur])
            cur=came[cur]
        path.reverse()
        return path

    # collect primitives
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                break
            # nearest by Manhattan
            target = min(locations, key=lambda p: abs(p[0]-pos[0])+abs(p[1]-pos[1]))
            path = bfs(pos, target)
            if path is None:
                # fallback Manhattan moves
                dx = target[0]-pos[0]
                dy = target[1]-pos[1]
                path = []
                while dx>0:
                    path.append(DOWN); dx-=1
                while dx<0:
                    path.append(UP); dx+=1
                while dy>0:
                    path.append(RIGHT); dy-=1
                while dy<0:
                    path.append(LEFT); dy+=1
            actions.extend(path)
            actions.append(USE)
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0

    # move to workshop and craft
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target_ws = min(ws_locs, key=lambda p: abs(p[0]-pos[0])+abs(p[1]-pos[1]))
            path = bfs(pos, target_ws)
            if path is None:
                dx = target_ws[0]-pos[0]
                dy = target_ws[1]-pos[1]
                path = []
                while dx>0:
                    path.append(DOWN); dx-=1
                while dx<0:
                    path.append(UP); dx+=1
                while dy>0:
                    path.append(RIGHT); dy-=1
                while dy<0:
                    path.append(LEFT); dy+=1
            actions.extend(path)
            actions.append(USE)

    return actions


    # ----- Setup -----
    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )
    goal = env.task.goal
    # primitive requirements for the goal (primitive index -> count)
    needed = env.world.cookbook.primitives_for(goal)

    # current state snapshot
    state = env._current_state
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # mutable copy to simulate pickups

    # ----- Helper functions -----
    def _bfs_path(start, target, allow_target_block=False):
        """Return list of actions to move from start to target using BFS.
        start/target are (x, y) tuples. If allow_target_block is True the target
        cell is considered traversable even if it contains a non‑grabbable entity."""
        width, height = grid.shape[:2]
        # cells occupied by non‑grabbable entities are blocked
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((width, height), dtype=bool)

        if allow_target_block:
            blocked[target[0], target[1]] = False

        # BFS
        q = collections.deque([start])
        came_from = {start: None}
        action_from = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in (
                (DOWN, (1, 0)),
                (UP, (-1, 0)),
                (RIGHT, (0, 1)),
                (LEFT, (0, -1)),
            ):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_from[nxt] = a
                        q.append(nxt)

        if target not in came_from:
            return None  # no path found

        # reconstruct actions
        actions = []
        cur = target
        while cur != start:
            a = action_from[cur]
            actions.append(a)
            cur = came_from[cur]
        actions.reverse()
        return actions

    def _manhattan_path(start, target):
        """Fallback simple Manhattan movement (ignores obstacles)."""
        moves = []
        x, y = start
        tx, ty = target
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    actions = []

    # ----- Collect required primitives -----
    for prim_idx, count in needed.items():
        for _ in range(count):
            # locate all remaining instances of this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # nothing left of this primitive; abort further collection
                break
            # pick the closest one (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = _bfs_path(pos, target, allow_target_block=True)
            if path is None:
                path = _manhattan_path(pos, target)
            actions.extend(path)
            pos = target
            # pick up the primitive
            actions.append(USE)
            grid[pos[0], pos[1], prim_idx] = 0  # simulate removal

    # ----- Move to workshop and craft -----
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if ws_locations:
            # choose nearest workshop
            target_ws = min(
                ws_locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = _bfs_path(pos, target_ws, allow_target_block=True)
            if path is None:
                path = _manhattan_path(pos, target_ws)
            actions.extend(path)
            pos = target_ws
            # craft at the workshop
            actions.append(USE)

    return actions

