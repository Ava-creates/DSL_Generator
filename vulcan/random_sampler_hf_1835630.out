    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    import collections, numpy as np

    # Action constants (default ordering in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_path(start, targets, grid):
        """Return a list of actions moving from start to a cell adjacent to any
        target location.  Blocks are any cell with a non‑zero entry in any kind."""
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # True where something blocks movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # Adjacent to a target?
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # No reachable adjacent cell.
        return []

    def _move(pos, act):
        """Return new position after applying a movement action."""
        x, y = pos
        if act == RIGHT:
            return (x + 1, y)
        if act == LEFT:
            return (x - 1, y)
        if act == DOWN:
            return (x, y + 1)
        if act == UP:
            return (x, y - 1)
        return pos

    # ------------------------------------------------------------------
    # Locate world / cookbook objects inside the environment wrapper.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the state instead.
        state_tmp = getattr(env, "_current_state", None)
        if state_tmp is not None:
            world = getattr(state_tmp, "world", None)
    if world is None:
        raise RuntimeError("Cannot find CraftWorld instance in the environment.")

    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if needed) and fetch goal info.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not present in the cookbook.")
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow.
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Planning state (mutable copies for offline planning)
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                 # current agent position
    grid = state.grid.copy()               # occupancy grid (will be mutated as we collect)
    actions = []                           # final action list to return
    harvested = set()                      # cells from which we already picked up

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # All cells currently containing this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position (greedy nearest first).
        locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
        collected = 0

        for loc in locations:
            if collected >= needed_cnt:
                break
            if loc in harvested:
                continue

            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)

            # Pick it up.
            actions.append(USE)
            harvested.add(loc)
            collected += 1

            # Update planning grid – the primitive is now gone.
            grid[loc[0], loc[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be string name or integer).
        if isinstance(workshop_key, str):
            ws_idx = cookbook.index[workshop_key]
        else:
            ws_idx = int(workshop_key)

        # Find all workshop cells on the map.
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            # Choose the nearest workshop cell.
            ws_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))
            target_ws = ws_cells[0]

            # Move adjacent to the workshop.
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)

    # Use action to perform the crafting (or final USE if no workshop needed).
    actions.append(USE)

    return actions


    import collections
    import numpy as np

    # Action indices (standard ordering in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from
    #   start (x, y) to any cell adjacent (Manhattan distance ≤ 1) to one
    #   of the target cells. Cells that contain any entity are treated as
    #   obstacles.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, grid):
