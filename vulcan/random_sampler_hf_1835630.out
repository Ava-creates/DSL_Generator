    # ----------------------------------------------------------------------
    # Retrieve action indices
    # ----------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ----------------------------------------------------------------------
    # Helper: move from current position to a target cell using Manhattan steps
    # ----------------------------------------------------------------------
    def _move(cur, tgt):
        actions = []
        x0, y0 = cur
        x1, y1 = tgt
        # horizontal moves
        while x0 < x1:
            actions.append(RIGHT)
            x0 += 1
        while x0 > x1:
            actions.append(LEFT)
            x0 -= 1
        # vertical moves
        while y0 < y1:
            actions.append(DOWN)
            y0 += 1
        while y0 > y1:
            actions.append(UP)
            y0 -= 1
        return actions, (x0, y0)

    # ----------------------------------------------------------------------
    # Resolve goal index for "arrow"
    # ----------------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise RuntimeError("Arrow item not found in cookbook")

    # ----------------------------------------------------------------------
    # Determine which primitive items are needed to craft an arrow
    # ----------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx)

    # ----------------------------------------------------------------------
    # Get current state information
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid
    cur_pos = tuple(state.pos)

    actions = []

    # ----------------------------------------------------------------------
    # Collect each required primitive (ignore obstacles for simplicity)
    # ----------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        # locate all cells containing this primitive
        locations = [tuple(pos) for pos in np.argwhere(grid[:, :, prim_idx] > 0)]
        gathered = 0
        while gathered < cnt and locations:
            target = locations.pop(0)
            move_acts, cur_pos = _move(cur_pos, target)
            actions.extend(move_acts)
            # pick up the primitive (use once; assume one item per cell)
            actions.append(USE)
            gathered += 1
            # update grid so we don't try to pick the same cell again
            grid[target[0], target[1], prim_idx] = 0

    # ----------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft the arrow
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or integer)
        if isinstance(workshop_key, int):
            workshop_idx = workshop_key
        else:
            workshop_idx = env.world.cookbook.index.get(workshop_key)
        if workshop_idx is not None:
            workshop_cells = [tuple(pos) for pos in np.argwhere(grid[:, :, workshop_idx] > 0)]
            if workshop_cells:
                # Move next to the first workshop cell (choose an adjacent free cell)
                ws = workshop_cells[0]
                # simple approach: move directly onto the workshop cell itself
                move_acts, cur_pos = _move(cur_pos, ws)
                actions.extend(move_acts)

    # ----------------------------------------------------------------------
    # Final USE to craft the arrow
    # ----------------------------------------------------------------------
    actions.append(USE)

    return actions


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action mapping
    # ----------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _in_bounds(pos, shape):
        x, y = pos
        w, h = shape
        return 0 <= x < w and 0 <= y < h

    def _neighbors(pos, shape):
        x, y = pos
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if _in_bounds((nx, ny), shape):
                yield (nx, ny)

    def _bfs(start, goals, blocked):
        """Bread‑first search from start to any cell in goals."""
        w, h = blocked.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        dq = deque([start])
        visited[start] = True
        while dq:
            cur = dq.popleft()
            if cur in goals:
                # reconstruct path
                path = [cur]
                while path[-1] != start:
                    path.append(prev[path[-1]])
                path.reverse()
                return path
            for nb in _neighbors(cur, (w, h)):
                if not visited[nb] and not blocked[nb]:
                    visited[nb] = True
                    prev[nb] = cur
                    dq.append(nb)
        return None

    def _path_to_actions(path):
        """Convert a list of positions (including start) into movement actions."""
        act_list = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 > x0:
                act_list.append(RIGHT)
            elif x1 < x0:
                act_list.append(LEFT)
            elif y1 > y0:
                act_list.append(DOWN)
            elif y1 < y0:
                act_list.append(UP)
        return act_list

    # ----------------------------------------------------------------------
    # Main planning
    # ----------------------------------------------------------------------
    world = env.world
    state = env._current_state
    grid = state.grid
    shape = grid.shape[:2]                     # (WIDTH, HEIGHT)

    # --------------------------------------------------------------
    # Resolve the goal index for "arrow"
    # --------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        goal_idx = world.cookbook.index.get("arrow")
    if goal_idx is None:
        raise RuntimeError("Could not locate index for goal 'arrow'")

    # --------------------------------------------------------------
    # Primitive requirements (expanded)
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(goal_idx)

    # --------------------------------------------------------------
    # Cells that cannot be stepped on (non‑grabbable entities)
    # --------------------------------------------------------------
    blocked = np.zeros(shape, dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    actions = []
    cur_pos = tuple(state.pos)

    # --------------------------------------------------------------
    # Helper: move to a target cell (any reachable cell)
    # --------------------------------------------------------------
    def _move_to(target):
        nonlocal cur_pos, actions
        path = _bfs(cur_pos, {target}, blocked)
        if path is None:
            return False
        actions.extend(_path_to_actions(path))
        cur_pos = target
        return True

    # --------------------------------------------------------------
    # Collect each required primitive
    # --------------------------------------------------------------
    for prim_idx, need_cnt in primitive_needs.items():
        gathered = 0
        while gathered < need_cnt:
            # locate all cells that currently contain this primitive
            locations = [tuple(pos) for pos in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not locations:
                # no more of this primitive on the map
                break

            # pick the reachable location with the shortest path
            best_loc = None
            best_len = None
            for loc in locations:
                path = _bfs(cur_pos, {loc}, blocked)
                if path is not None:
                    if best_len is None or len(path) < best_len:
                        best_loc = loc
                        best_len = len(path)
            if best_loc is None:
                # none reachable – give up on this primitive
                break

            _move_to(best_loc)

            # how many of this primitive are on the cell?
            available = int(grid[best_loc[0], best_loc[1], prim_idx])
            use_cnt = min(need_cnt - gathered, available)
            actions.extend([USE] * use_cnt)

            # update grid view (cell becomes empty if we took everything)
            grid[best_loc[0], best_loc[1], prim_idx] = max(0, available - use_cnt)
            gathered += use_cnt

    # --------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the arrow
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        if isinstance(workshop_key, int):
            workshop_idx = workshop_key
        else:
            workshop_idx = world.cookbook.index.get(workshop_key)
        if workshop_idx is not None:
            workshop_cells = [tuple(pos) for pos in np.argwhere(grid[:, :, workshop_idx] > 0)]
            if workshop_cells:
                ws = workshop_cells[0]
                # Find a free adjacent cell to the workshop
                adj_candidates = [nb for nb in _neighbors(ws, shape) if not blocked[nb]]
                if adj_candidates:
                    # Choose the closest candidate to current position
                    adj_candidates.sort(
                        key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
                    )
                    _move_to(adj_candidates[0])

    # --------------------------------------------------------------
    # Final craft action
    # --------------------------------------------------------------
    actions.append(USE)

    return actions

