    import numpy as np
    from collections import deque

    # helper: map direction vectors to action indices (as defined in CraftLab)
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }

    # ----------------------------------------------------------------------
    # BFS that returns a list of actions moving from start to a cell that is
    # either the target cell itself or any of its 4‑neighbour cells.
    # ----------------------------------------------------------------------
    def bfs(start, target_cells, grid):
        H, W = grid.shape[:2]
        # cells that are occupied (any kind) are blocked for movement
        blocked = np.any(grid > 0, axis=2)

        # if start is already adjacent to a target, return empty path
        sx, sy = start
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        # BFS over positions
        q = deque()
        q.append((sx, sy, []))
        visited = np.full((H, W), False, dtype=bool)
        visited[sy, sx] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:
                    if blocked[ny, nx]:
                        continue
                    npath = path + [act]
                    # check adjacency to any target cell
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[ny, nx] = True
                    q.append((nx, ny, npath))
        # if we cannot reach, return empty list (fallback)
        return []

    # ----------------------------------------------------------------------
    # Main logic
    # ----------------------------------------------------------------------
    # obtain current state from the environment
    state = env._current_state
    grid = state.grid          # shape (H, W, n_kinds)
    pos = state.pos            # (x, y)

    # goal index
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        # fallback: try to read from env.scenario.world maybe
        raise ValueError("Cannot determine goal index from environment.")

    # ------------------------------------------------------------------
    # 1. Determine which primitive resources are required for the goal.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # 2. Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        while needed_cnt > 0:
            # locate all cells containing this primitive
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # primitive not present – cannot continue
                break
            # compute path to the nearest primitive (by Manhattan distance)
            # we treat the primitive cell itself as a target (we will move next to it)
            path = bfs(pos, prim_cells.tolist(), grid)
            actions.extend(path)
            # update position after moving
            for a in path:
                dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # now we are adjacent to a primitive cell – use it
            actions.append(4)   # USE
            # simulate the use: inventory would increase, grid would lose the primitive
            # For planning we only need to update our local copies.
            # Find the primitive cell we are adjacent to (any)
            adj_prim = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_prim = (cx, cy)
                    break
            if adj_prim is not None:
                # remove one instance from the grid representation
                grid[adj_prim[1], adj_prim[0], prim_idx] -= 1
                needed_cnt -= 1
            else:
                # shouldn't happen; break to avoid infinite loop
                break

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is None:
        # no specific workshop – nothing to do
        return actions

    # workshop_key may be a string name or an integer index
    if isinstance(workshop_key, str):
        workshop_idx = env.world.cookbook.index[workshop_key]
    else:
        workshop_idx = workshop_key

    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size > 0:
        path = bfs(pos, workshop_cells.tolist(), grid)
        actions.extend(path)
        # update position after moving
        for a in path:
            dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]
            pos = (pos[0] + dx, pos[1] + dy)

        # finally, use the workshop to craft the item
        actions.append(4)   # USE

    return actions

