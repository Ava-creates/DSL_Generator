    # Resolve the underlying scenario and world objects (works for raw scenarios or CraftLab wrappers)
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the desired item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Obtain the initial state from which we will plan
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_key(st):
        """Create a hashable representation of a state for the visited set."""
        # Position, direction, inventory contents, and a compact encoding of the grid occupancy
        # Grid is large; we compress it to bytes (which is hashable) – this is acceptable for BFS limits.
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_state_key(init_state)}
    frontier = deque([Node(init_state, [])])

    # Safety limits
    MAX_PLAN_LENGTH = 800          # maximum number of actions we will consider
    n_actions = getattr(world, "n_actions", 5)   # default: 4 moves + USE

    while frontier:
        node = frontier.popleft()
        cur_state, cur_actions = node.state, node.actions

        # Goal test: does the inventory contain at least one arrow?
        if cur_state.satisfies("", target_idx):
            return cur_actions

        # Prune overly long plans
        if len(cur_actions) >= MAX_PLAN_LENGTH:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            key = _state_key(next_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(next_state, cur_actions + [a]))

    # If we exhaust the search without finding a plan, return an empty list.
    return []

