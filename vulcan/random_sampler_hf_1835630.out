def make_arrow_vn(env):
    # Reset environment to a fresh state
    env.reset()
    world = env.world
    goal = env.task.goal

    # Action indices (as defined in CraftLab.action_specs())
    ACTION_DOWN = 0
    ACTION_UP = 1
    ACTION_LEFT = 2
    ACTION_RIGHT = 3
    ACTION_USE = 4

    actions = []

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell that contains a given kind
    # ------------------------------------------------------------------
    def find_nearest(pos, kind):
        grid = env._current_state.grid
        xs, ys = np.where(grid[:, :, kind] > 0)
        if len(xs) == 0:
            return None
        dists = np.abs(xs - pos[0]) + np.abs(ys - pos[1])
        idx = np.argmin(dists)
        return (int(xs[idx]), int(ys[idx]))

    # ------------------------------------------------------------------
    # Helper: generate a simple Manhattan path to a free cell that is
    # adjacent to the target cell.  Returns a list of movement actions.
    # ------------------------------------------------------------------
    def move_to_adjacent(start, target):
        grid = env._current_state.grid
        h, w = grid.shape[:2]

        # Directions with the action that would move *towards* the target
        dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

        candidates = []
        for dx, dy, _ in dirs:
            ax, ay = target[0] + dx, target[1] + dy
            if 0 <= ax < h and 0 <= ay < w:
                if grid[ax, ay].sum() == 0:          # cell must be empty
                    candidates.append((ax, ay))

        if not candidates:
            return []  # no reachable adjacent cell found

        # Choose the adjacent cell with smallest Manhattan distance
        adj = min(candidates,
                  key=lambda c: abs(c[0] - start[0]) + abs(c[1] - start[1]))
        ax, ay = adj

        moves = []
        curx, cury = start

        # Simple vertical then horizontal moves
        while curx < ax:
            moves.append(ACTION_DOWN)
            curx += 1
        while curx > ax:
            moves.append(ACTION_UP)
            curx -= 1
        while cury < ay:
            moves.append(ACTION_RIGHT)
            cury += 1
        while cury > ay:
            moves.append(ACTION_LEFT)
            cury -= 1
        return moves

    # ------------------------------------------------------------------
    # 1. Collect all required primitive resources
    # ------------------------------------------------------------------
    primitives = world.cookbook.primitives_for(goal)  # {kind_idx: count}
    for kind, needed in primitives.items():
        while needed > 0:
            cur_pos = env._current_state.pos
            target = find_nearest(cur_pos, kind)
            if target is None:
                # Primitive not found – abort planning for this kind
                break

            # Move next to the primitive
            move_actions = move_to_adjacent(cur_pos, target)
            for a in move_actions:
                env.step(a)
                actions.append(a)

            # Use (collect) the primitive
            env.step(ACTION_USE)
            actions.append(ACTION_USE)

            needed -= 1

    # ------------------------------------------------------------------
    # 2. Craft the desired item at its workshop (if applicable)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        cur_pos = env._current_state.pos
        workshop_pos = find_nearest(cur_pos, workshop_kind)
        if workshop_pos is not None:
            move_actions = move_to_adjacent(cur_pos, workshop_pos)
            for a in move_actions:
                env.step(a)
                actions.append(a)

            # Use (craft) at the workshop
            env.step(ACTION_USE)
            actions.append(ACTION_USE)

    return actions


    # Reset the environment to start a new episode
    _ = env.reset()
    # Gather the list of possible action indices from the environment spec
    action_space = list(env.action_specs().values())
    # Record the sequence of actions we will take
    action_sequence = []
    # Upper bound on steps to avoid infinite loops
    MAX_STEPS = 2000

    for _ in range(MAX_STEPS):
        # If the environment exposes an internal termination check, use it
        if hasattr(env, "_is_done") and env._is_done():
            break
        # Choose an action uniformly at random from the available actions
        a = np.random.choice(action_space)
        # Execute the action; the step method returns (reward, done, observation)
        _, done, _ = env.step(int(a))
        action_sequence.append(int(a))
        # Stop if the environment reports termination (goal reached or max steps)
        if done:
            break

    return action_sequence

