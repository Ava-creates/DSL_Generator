            world = getattr(state_wrap, "world", None)
    if world is None:
        raise RuntimeError("Unable to locate world object in the environment.")
    cookbook = world.cookbook

    # Ensure we have a current state (reset if necessary).
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Goal is hard‑coded to “arrow”.
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Current position and a mutable copy of the grid.
    pos = tuple(state.pos)                # (x, y)
    cur_grid = state.grid.copy()          # (W, H, n_kinds)

    actions = []
    harvested = set()                     # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Locate all cells containing this primitive.
        locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]
        # Greedy nearest‑first ordering.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Compute occupied map (any non‑empty cell blocks movement).
            occupied = np.any(cur_grid > 0, axis=2)
            # Find a path to a cell adjacent to the primitive.
            path = _bfs_path(pos, [loc], occupied)
            actions.extend(path)
            # Update simulated position.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Remove the primitive from the grid so future planning sees the cell as free.
            cur_grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

