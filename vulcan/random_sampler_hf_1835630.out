    # reset environment and fetch useful objects
    env.reset()
    state = env._current_state            # CraftState
    world = env.world                     # CraftWorld
    grid = state.grid.copy()              # mutable copy for planning

    # action indices (consistent with CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    height, width, _ = grid.shape
    non_grab = set(world.non_grabbable_indices)

    def passable(pos):
        """Return True if the cell can be entered (no non‑grabbable entity)."""
        y, x = pos
        if not (0 <= y < height and 0 <= x < width):
            return False
        # any non‑grabbable kind present blocks movement
        return not np.any(grid[y, x, list(non_grab)] > 0)

    def bfs(start, goal):
        """Shortest path (list of positions) from start to goal using 4‑connectivity.
        Returns None if goal is unreachable."""
        if start == goal:
            return [start]
        from collections import deque
        q = deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                nxt = (ny, nx)
                if nxt in came_from:
                    continue
                if passable(nxt) or nxt == goal:   # allow stepping onto goal even if occupied by a grabbable
                    came_from[nxt] = cur
                    q.append(nxt)
        else:
            return None

        # reconstruct path
        path = []
        cur = goal
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions to movement actions."""
        acts = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            dy, dx = y1 - y0, x1 - x0
            if dy == 1:
                acts.append(DOWN)
            elif dy == -1:
                acts.append(UP)
            elif dx == 1:
                acts.append(RIGHT)
            elif dx == -1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def nearest_of_kind(kind_idx, from_pos):
        """Find the nearest cell containing ``kind_idx`` that is reachable."""
        candidates = np.argwhere(grid[:, :, kind_idx] > 0)
        if candidates.size == 0:
            return None
        # sort by Manhattan distance for efficiency
        dists = np.abs(candidates[:, 0] - from_pos[0]) + np.abs(candidates[:, 1] - from_pos[1])
        order = np.argsort(dists)
        for idx in order:
            cell = tuple(candidates[idx])
            # ensure we can actually reach the cell
            if bfs(from_pos, cell) is not None:
                return cell
        return None

    # ------------------------------------------------------------------
    # Determine recipe for ``arrow`` and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect each primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = nearest_of_kind(prim_idx, cur_pos)
            if target is None:
                # primitive missing / unreachable – abort early
                return actions

            # plan movement to the primitive cell
            path = bfs(cur_pos, target)
            if path is None:
                return actions
            actions.extend(path_to_actions(path))
            cur_pos = target

            # pick up the primitive
            actions.append(USE)

            # remove it from our planning grid so we don't try to pick it again
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest_of_kind(workshop_idx, cur_pos)
        if ws_cell is not None:
            path = bfs(cur_pos, ws_cell)
            if path is not None:
                actions.extend(path_to_actions(path))
                cur_pos = ws_cell

    # final USE to trigger crafting
    actions.append(USE)

    return actions


    # Reset the environment and extract useful objects
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid.copy()             # mutable copy for planning

    # Action indices (consistent with CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    import collections

    # Directions: (dy, dx, action)
    _DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    def _in_bounds(y, x):
        return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]

    def _is_blocked(y, x):
        """Return True if the cell is occupied by a non‑grabbable entity."""
        return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def _bfs_path(start, goal):
        """Return a list of actions that moves from start to goal using BFS.
        Returns None if goal is unreachable."""
        if start == goal:
            return []
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), acts = q.popleft()
            for dy, dx, act in _DIRS:
                ny, nx = y + dy, x + dx
                if not _in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                # Allow stepping onto the goal even if it is “blocked”
                if (ny, nx) != goal and _is_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                new_acts = acts + [act]
                if (ny, nx) == goal:
                    return new_acts
                q.append(((ny, nx), new_acts))
        return None

    def _nearest_reachable(kind_idx, from_pos):
        """Find the nearest cell containing `kind_idx` that is reachable.
        Returns (path_actions, cell) or (None, None) if none reachable."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None, None
        # Sort by Manhattan distance for efficiency
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        order = np.argsort(dists)
        for idx in order:
            cell = tuple(locations[idx])
            path = _bfs_path(from_pos, cell)
            if path is not None:
                return path, cell
        return None, None

    # ------------------------------------------------------------------
    # Determine the recipe for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            path, cell = _nearest_reachable(prim_idx, cur_pos)
            if path is None:            # primitive missing / unreachable
                return actions
            actions.extend(path)
            cur_pos = cell
            actions.append(USE)         # pick up the primitive
            # Update planning grid so we don't try to pick the same item again
            grid[cell[0], cell[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_path, ws_cell = _nearest_reachable(workshop_idx, cur_pos)
        if ws_path is not None:
            actions.extend(ws_path)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions

