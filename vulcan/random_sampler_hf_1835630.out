    return actions


    import numpy as np
    from collections import deque

    # Action indices (as defined by CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and obtain current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # (H, W, n_kinds)

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def bfs_adjacent(start, target_kind):
        """Find shortest path (list of actions) from start to a free cell
        that is orthogonally adjacent to a cell containing target_kind.
        Returns (actions, adjacent_pos, target_pos, face_dir) or (None,…)
        """
        H, W = grid.shape[0], grid.shape[1]
        visited = np.full((H, W), False, dtype=bool)
        q = deque()
        q.append((start[0], start[1], []))
        visited[start[0], start[1]] = True

        while q:
            y, x, acts = q.popleft()

            # Check if any neighbour holds the target
            for dy, dx, dir_act in ((1, 0, DOWN), (-1, 0, UP),
                                    (0, -1, LEFT), (0, 1, RIGHT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W:
                    if grid[ny, nx, target_kind] > 0:
                        return acts, (y, x), (ny, nx), dir_act

            # Expand to neighbouring free cells
            for dy, dx, dir_act in ((1, 0, DOWN), (-1, 0, UP),
                                    (0, -1, LEFT), (0, 1, RIGHT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # A cell is free if it does not contain any non‑grabbable entity
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        visited[ny, nx] = True
                        q.append((ny, nx, acts + [dir_act]))
        return None, None, None, None

    def bfs_to_target(start, target_kind):
        """Shortest path to step onto a cell that contains target_kind."""
        H, W = grid.shape[0], grid.shape[1]
        visited = np.full((H, W), False, dtype=bool)
        q = deque()
        q.append((start[0], start[1], []))
        visited[start[0], start[1]] = True

        while q:
            y, x, acts = q.popleft()
            # If current cell already has the target, we are done
            if grid[y, x, target_kind] > 0:
                return acts, (y, x)

            for dy, dx, dir_act in ((1, 0, DOWN), (-1, 0, UP),
                                    (0, -1, LEFT), (0, 1, RIGHT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        visited[ny, nx] = True
                        q.append((ny, nx, acts + [dir_act]))
        return None, None

    # ------------------------------------------------------------------
    # Determine goal (arrow) and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            path, adj_pos, target_pos, face_dir = bfs_adjacent(cur_pos, prim_idx)
            if path is None:
                # No reachable primitive – abort planning
                return actions

            actions.extend(path)          # move to adjacent free cell
            cur_pos = adj_pos

            # Face the primitive by attempting a move into its cell (blocked)
            actions.append(face_dir)

            # Pick it up
            actions.append(USE)

            # Mark the primitive as collected in our planning grid
            ty, tx = target_pos
            grid[ty, tx, prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        path, ws_pos = bfs_to_target(cur_pos, workshop_idx)
        if path is not None:
            actions.extend(path)
            cur_pos = ws_pos

    # Use to trigger crafting
    actions.append(USE)

    return actions

