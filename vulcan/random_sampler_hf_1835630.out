    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid                    # (WIDTH, HEIGHT, n_kinds)

    # Action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_free(cell):
        """Return True if the cell is empty (no entity occupies it)."""
        y, x = cell
        return grid[y, x, :].sum() == 0

    def bfs(start, goal):
        """Bread‑first search on the 2‑D grid avoiding occupied cells.
        Returns a list of positions from start to goal (inclusive) or
        None if no path exists."""
        from collections import deque
        h, w = grid.shape[0], grid.shape[1]
        visited = np.full((h, w), False, dtype=bool)
        prev = dict()
        q = deque([start])
        visited[start] = True
        while q:
            cur = q.popleft()
            if cur == goal:
                # reconstruct path
                path = [cur]
                while cur != start:
                    cur = prev[cur]
                    path.append(cur)
                path.reverse()
                return path
            y, x = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx] and is_free((ny, nx)):
                    visited[ny, nx] = True
                    prev[(ny, nx)] = cur
                    q.append((ny, nx))
        return None

    def path_to_actions(path):
        """Convert a list of positions (including start) to action indices."""
        act = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            if y1 == y0 + 1:
                act.append(DOWN)
            elif y1 == y0 - 1:
                act.append(UP)
            elif x1 == x0 + 1:
                act.append(RIGHT)
            elif x1 == x0 - 1:
                act.append(LEFT)
        return act

    def nearest_entity(kind_idx, from_pos):
        """Find the nearest cell containing the given kind index."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        return tuple(locs[np.argmin(dists)])

    def free_adjacent(cell):
        """Return a list of free orthogonal neighbours of `cell`."""
        y, x = cell
        neigh = []
        for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and is_free((ny, nx)):
                neigh.append((ny, nx))
        return neigh

    def direction_action(src, dst):
        """Return the action that makes the agent at src face dst (one step)."""
        sy, sx = src
        dy, dx = dst[0] - sy, dst[1] - sx
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        return None

    # ------------------------------------------------------------------
    # Determine goal (arrow) and its required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect each primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            prim_cell = nearest_entity(prim_idx, cur_pos)
            if prim_cell is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on (prefer the closest one)
            adj_candidates = free_adjacent(prim_cell)
            if not adj_candidates:
                # No free neighbour; cannot pick up this primitive.
                return actions
            # pick the candidate with minimal Manhattan distance from current pos
            adj = min(adj_candidates,
                      key=lambda c: abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]))

            # Move to the chosen adjacent cell
            path = bfs(cur_pos, adj)
            if path is None:
                return actions
            actions.extend(path_to_actions(path))
            cur_pos = adj

            # Face the primitive (add a turn action – moving into the occupied cell is blocked
            # but updates the facing direction)
            turn = direction_action(cur_pos, prim_cell)
            if turn is not None:
                actions.append(turn)

            # Pick up the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest_entity(ws_idx, cur_pos)
        if ws_cell is not None:
            # Find a free adjacent cell to the workshop
            ws_adj_candidates = free_adjacent(ws_cell)
            if ws_adj_candidates:
                ws_adj = min(ws_adj_candidates,
                             key=lambda c: abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]))
                path = bfs(cur_pos, ws_adj)
                if path is not None:
                    actions.extend(path_to_actions(path))
                    cur_pos = ws_adj

                # Face the workshop and use
                turn = direction_action(cur_pos, ws_cell)
                if turn is not None:
                    actions.append(turn)
                actions.append(USE)
            else:
                # No free neighbour – fallback to using from current location if already adjacent
                turn = direction_action(cur_pos, ws_cell)
                if turn is not None:
                    actions.append(turn)
                actions.append(USE)
    else:
        # No specific workshop; just issue a USE to trigger crafting
        actions.append(USE)

    return actions

