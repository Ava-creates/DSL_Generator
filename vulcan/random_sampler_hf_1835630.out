    import heapq
    from collections import namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # primitive requirements for a single arrow (may be empty if arrow is primitive)
    needed_prims = world.cookbook.primitives_for(target_idx)

    def _heuristic(st):
        """Simple admissible heuristic: missing needed primitives."""
        inv = st.inventory
        return sum(max(0, needed_prims.get(k, 0) - inv[k]) for k in needed_prims)

    # A* search
    start_node = Node(init_state, [])
    start_f = _heuristic(init_state)
    frontier = [(start_f, 0, start_node)]  # (f, g, node)
    visited = {_state_hash(init_state): 0}

    MAX_EXPANSIONS = 50000
    expansions = 0
    n_actions = getattr(world, "n_actions", 5)  # usually 5 (4 moves + USE)

    while frontier and expansions < MAX_EXPANSIONS:
        _, g, node = heapq.heappop(frontier)
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Depth limit to keep planning tractable
        if g >= 300:
            continue

        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            g2 = g + 1
            if h not in visited or g2 < visited[h]:
                visited[h] = g2
                f = g2 + _heuristic(nxt_state)
                heapq.heappush(frontier, (f, g2, Node(nxt_state, node.actions + [a])))

        expansions += 1

    # No feasible plan found within limits
    return []


