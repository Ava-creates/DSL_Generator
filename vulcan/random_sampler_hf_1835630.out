    import numpy as np
    from collections import deque

    # Reset environment and get initial state and world reference
    env.reset()
    cur_state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []  # arrow not defined in this world

    # Mapping from action index to movement delta (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1),   # DOWN
              1: (0, -1),  # UP
              2: (-1, 0),  # LEFT
              3: (1, 0)}   # RIGHT
    USE_ACTION = 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions which leaves the
    # agent in a cell where the cell directly in front contains `target_kind`.
    # Returns None if no such position is reachable.
    # ------------------------------------------------------------------
    def bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        q = deque()
        sx, sy = state.pos
        sdir = state.dir
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, path = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine which primitive resources are needed for one arrow.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:               # arrow might itself be a primitive
        primitive_needs = {arrow_idx: 1}

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources.
    # ------------------------------------------------------------------
    for prim_idx, count in primitive_needs.items():
        for _ in range(count):
            seq = bfs_to_target(cur_state, prim_idx)
            if seq is None:
                # Primitive unreachable – abort planning.
                return actions
            actions.extend(seq)
            actions.append(USE_ACTION)  # pick up
            # Simulate to keep cur_state up‑to‑date
            for a in seq + [USE_ACTION]:
                _, cur_state = cur_state.step(a)

    # ------------------------------------------------------------------
    # 2) Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = bfs_to_target(cur_state, workshop_idx)
        if seq is None:
            # Workshop unreachable – still attempt a USE (harmless)
            actions.append(USE_ACTION)
            _, cur_state = cur_state.step(USE_ACTION)
        else:
            actions.extend(seq)
            actions.append(USE_ACTION)  # craft
            for a in seq + [USE_ACTION]:
                _, cur_state = cur_state.step(a)
    else:
        # No specific workshop; craft in place.
        actions.append(USE_ACTION)
        _, cur_state = cur_state.step(USE_ACTION)

    return actions


    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
