    H, W, _ = grid.shape
    non_grabbable = set(world.non_grabbable_indices)

    def is_blocked(y, x):
        if y < 0 or y >= H or x < 0 or x >= W:
            return True
        return any(grid[y, x, k] > 0 for k in non_grabbable)

    from collections import deque

    def bfs(start, goal):
        if start == goal:
            return []
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not is_blocked(ny, nx):
                    if (ny, nx) not in visited:
                        if (ny, nx) == goal:
                            return path + [act]
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return None

    def positions_of(kind):
        return [tuple(p) for p in np.argwhere(grid[:, :, kind] > 0)]

    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)

    actions = []
    cur_pos = state.pos

    for prim_idx, count in needed.items():
        for _ in range(count):
            best_seq = None
            best_target = None
            best_adj = None
            for tgt in positions_of(prim_idx):
                for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):
