    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helpers
    # ----------------------------------------------------------------------
    # Mapping from (dx, dy) movement vectors to CraftLab action indices.
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    # Reverse map for updating the simulated position.
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs(start, targets, grid):
        """
        Breadth‑first search returning a list of actions that moves the agent
        from ``start`` to a cell that is *adjacent* to any cell in ``targets``.
        ``grid`` is the (H, W, K) array; any non‑zero entry in the last axis is
        considered blocked for movement.
        """
        H, W = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)

        sx, sy = start
        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((H, W), False, dtype=bool)
        visited[sy, sx] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:
                    if blocked[ny, nx]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[ny, nx] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency → empty path (caller will handle).
        return []

    # ----------------------------------------------------------------------
    # Main planning
    # ----------------------------------------------------------------------
    # Current state and static info.
    state = env._current_state
    grid = state.grid.copy()          # local mutable copy
    pos = tuple(state.pos)            # (x, y)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # 1. Determine primitive requirements.
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    # 2. Collect each primitive.
    for prim_idx, needed in primitives_needed.items():
        while needed > 0:
            # Locate all cells containing this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive unavailable – abort planning.
                return plan
            # Find a path to the nearest primitive (adjacent).
            path = bfs(pos, prim_cells.tolist(), grid)
            plan.extend(path)
            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use the primitive (collect).
            plan.append(4)   # USE action
            # Find the primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected – break to avoid infinite loop.
                break
            # Update local grid (remove one instance) and decrement counter.
            grid[adj_cell[1], adj_cell[0], prim_idx] -= 1
            needed -= 1

    # 3. Move to the workshop and craft the goal item.
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is None:
        # No specific workshop → nothing else to do.
        return plan

    # Resolve workshop index.
    if isinstance(workshop_key, str):
        workshop_idx = env.world.cookbook.index[workshop_key]
    else:
        workshop_idx = int(workshop_key)

    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size > 0:
        path = bfs(pos, workshop_cells.tolist(), grid)
        plan.extend(path)
        for a in path:
            dx, dy = ACT2DIR[a]
            pos = (pos[0] + dx, pos[1] + dy)
        # Craft at the workshop.
        plan.append(4)   # USE

    return plan

