    import numpy as np
    import collections

    # Action indices (match CraftWorld's definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from `start` to a cell
    # adjacent (Manhattan distance == 1) to any of the `targets`.
    # ------------------------------------------------------------------
    def _bfs_path(start, targets, grid):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)          # cells that block movement
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # If we are already adjacent (or on) a target, stop.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            # Expand neighbours.
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []   # no path found (should not happen in well‑formed worlds)

    # ------------------------------------------------------------------
    # Retrieve world and cookbook objects from the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers store the world inside the current state.
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Goal is the item named "arrow".
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in the cookbook.")
    goal_idx = cookbook.index[goal_name]

    # Primitives required to craft the goal (including counts).
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Ensure we have a fresh state (reset if necessary).
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)          # current (x, y) position
    grid = state.grid.copy()        # mutable copy for planning

    actions = []
    harvested = set()               # cells already used for collection

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells that contain this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position.
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            # Update internal position tracker.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # Mark the cell as empty for future planning.
            grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (string name or integer).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        # Locate workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            # Move adjacent to the workshop.
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Craft the arrow.
            actions.append(USE)
        else:
            # No visible workshop; attempt to craft in place.
            actions.append(USE)
    else:
        # No specific workshop required – just use the craft action.
        actions.append(USE)

    return actions


    import numpy as np
    import collections

    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_path(start, targets, grid):
        w, h, _ = grid.shape
        occupied = np.any(grid > 0, axis=2)
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) <= 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occupied[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    # Locate world and cookbook
    world = getattr(env, "world", None)
    if world is None:
        state_wrapper = getattr(env, "_current_state", None)
        if state_wrapper is not None:
            world = getattr(state_wrapper, "world", None)
    if world is None:
        raise RuntimeError("World object not found in environment")
    cookbook = world.cookbook

    # Goal item
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in cookbook")
    goal_idx = cookbook.index[goal_name]

    # Required primitives (including counts)
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Ensure we have a fresh state
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    pos = tuple(state.pos)
    grid = state.grid.copy()
    actions = []
    harvested = set()

    # Helper to update position after an action
    def _move(pos, act):
        if act == RIGHT:
            return (pos[0] + 1, pos[1])
        if act == LEFT:
            return (pos[0] - 1, pos[1])
        if act == DOWN:
            return (pos[0], pos[1] + 1)
        if act == UP:
            return (pos[0], pos[1] - 1)
        return pos

    # Collect each primitive
    for prim_idx, needed in primitives_needed.items():
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        collected = 0
        for loc in locations:
            if collected >= needed:
                break
            if loc in harvested:
                continue
            path = _bfs_path(pos, [loc], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)
            actions.append(USE)
            grid[loc[0], loc[1], prim_idx] = 0
            harvested.add(loc)
            collected += 1

    # Craft at workshop if required
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else int(workshop_key))
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            path = _bfs_path(pos, [target_ws], grid)
            actions.extend(path)
            for act in path:
                pos = _move(pos, act)
            actions.append(USE)
        else:
            actions.append(USE)
    else:
        actions.append(USE)

    return actions

