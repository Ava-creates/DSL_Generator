    # Collect required primitives
    for prim_idx, cnt in needed.items():
        locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
        have = 0
        for loc in locations:
            if have >= cnt:
                break
            if loc in collected:
                continue
            path = bfs(pos, [loc], occupied)
            actions.extend(path)
            for a in path:
                if a == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif a == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif a == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif a == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)
            grid[loc[0], loc[1], prim_idx] = 0
            occupied[loc[0], loc[1]] = False
            collected.add(loc)
            have += 1

    # Craft at the required workshop (if any)
    recipe = cookbook.recipes.get(goal_idx, {})
    ws_key = recipe.get("_at")
    if ws_key is not None:
        ws_idx = cookbook.index[ws_key] if isinstance(ws_key, str) else ws_key
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target = ws_cells[0]
            path = bfs(pos, [target], occupied)
            actions.extend(path)
            for a in path:
                if a == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif a == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif a == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif a == UP:
                    pos = (pos[0], pos[1] - 1)
            actions.append(USE)

    return actions

