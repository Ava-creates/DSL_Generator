    from collections import deque, namedtuple

    # Node used in BFS
    Node = namedtuple("Node", ["state", "actions"])

    # Hash function for visited states (position, direction, inventory, grid)
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = {_state_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 300                         # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)  # default action count (0‑4)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long plans
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, next_state = cur_state.step(a)
            h = _state_hash(next_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(next_state, node.actions + [a]))

    # No plan found within limits
    return []


    # Resolve the scenario and world objects from the supplied environment
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Identify the index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting state of the episode
    try:
        start_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    # Helper to hash a state for fast visited‑set lookup
    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    Node = namedtuple("Node", ["state", "actions"])
    visited = {_state_hash(start_state)}
    frontier = deque([Node(start_state, [])])

    # Safety limits – adjust if the world is larger
    MAX_STEPS = 500
    n_actions = getattr(world, "n_actions", 5)   # typical action space size

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in the inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt = cur_state.step(a)
            h = _state_hash(nxt)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt, node.actions + [a]))

    # No plan found within the search budget
    return []

