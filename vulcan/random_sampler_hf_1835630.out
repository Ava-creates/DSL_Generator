    RIGHT = specs.get("RIGHT", 3)
    USE = specs.get("USE", 4)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal
        while avoiding non‑grabbable obstacles."""
        if start == goal:
            return []
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                actions_rev = []
                cur = (y, x)
                while cur != start:
                    py, px = prev[cur]
                    if py == cur[0] - 1:
                        actions_rev.append(DOWN)
                    elif py == cur[0] + 1:
                        actions_rev.append(UP)
                    elif px == cur[1] - 1:
                        actions_rev.append(RIGHT)
                    elif px == cur[1] + 1:
                        actions_rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(actions_rev))

            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:
                    # blocked if any non‑grabbable entity occupies the cell
                    if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):
                        continue
                    visited[ny, nx] = True
                    prev[(ny, nx)] = (y, x)
                    q.append((ny, nx))

        # No path found – fall back to Manhattan moves (may collide with obstacles)
        y0, x0 = start
        y1, x1 = goal
        actions = []
        dy = y1 - y0
        dx = x1 - x0
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing the given kind."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])
        nearest_idx = int(np.argmin(dists))
        return tuple(locs[nearest_idx])

    # ------------------------------------------------------------------
    # Determine goal (arrow) and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort planning
                return actions

            ty, tx = target

            # Choose a free adjacent cell to stand on before using
            adj = None
            for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):
                if 0 <= ny < H and 0 <= nx < W:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; fallback to standing on the primitive cell itself
                adj = (ty, tx)

