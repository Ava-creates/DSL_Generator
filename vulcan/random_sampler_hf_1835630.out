    # Reset environment and obtain current state objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(y, x):
        """Return True if the cell contains any non‑grabbable entity."""
        return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs_path(start, goal):
        """Find a shortest path from start to goal avoiding blocked cells.
        Returns a list of actions (DOWN/UP/LEFT/RIGHT). If no path is found,
        returns an empty list."""
        if start == goal:
            return []
        h, w = grid.shape[:2]
        queue = collections.deque()
        queue.append(start)
        visited = {start: None}
        while queue:
            y, x = queue.popleft()
            for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not is_blocked(ny, nx):
                    if (ny, nx) not in visited:
                        visited[(ny, nx)] = (y, x, act)
                        if (ny, nx) == goal:
                            # reconstruct actions
                            actions = []
                            cur = (ny, nx)
                            while visited[cur] is not None:
                                py, px, act = visited[cur]
                                actions.append(act)
                                cur = (py, px)
                            actions.reverse()
                            return actions
                        queue.append((ny, nx))
        # No path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Return coordinates of the nearest cell containing kind_idx."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine what primitives are required for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            ty, tx = target

            # Choose a free adjacent cell to stand on before using.
            adj = None
            adj_facing = None
            for ny, nx, facing in (
                (ty - 1, tx, DOWN),   # stand above, face down
                (ty + 1, tx, UP),     # stand below, face up
                (ty, tx - 1, RIGHT),  # stand left, face right
                (ty, tx + 1, LEFT)    # stand right, face left
            ):
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked(ny, nx):
                    adj = (ny, nx)
                    adj_facing = facing
                    break

            if adj is None:
                # No free neighbour – stand on the primitive cell itself.
                adj = (ty, tx)
                adj_facing = None

            # Move to the chosen adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Adjust direction if needed (may move into blocked cell just to turn).
            if adj_facing is not None:
                actions.append(adj_facing)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(ws_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions

