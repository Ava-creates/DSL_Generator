    env.reset()
    state = env._current_state
    world = env.world
    grid = state.grid
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def manhattan_path(start, goal):
        """Return a list of movement actions from start to goal (vertical then horizontal)."""
        actions = []
        y, x = start
        gy, gx = goal
        dy = gy - y
        dx = gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell containing the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(target):
        """Return a free adjacent cell to target and the direction needed to face the target."""
        ty, tx = target
        for ny, nx, facing in [(ty - 1, tx, DOWN),
                               (ty + 1, tx, UP),
                               (ty, tx - 1, RIGHT),
                               (ty, tx + 1, LEFT)]:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return ny, nx, facing
        # fallback: stand on the target itself
        return ty, tx, None

    # ------------------------------------------------------------------
    # Determine required primitives for an arrow and collect them.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required_prims = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    for prim_idx, needed_cnt in required_prims.items():
        for _ in range(needed_cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – return whatever we have planned.
                return actions

            ny, nx, face_dir = free_adjacent(target)

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, (ny, nx))
            cur_pos = (ny, nx)

            # Face the primitive if needed.
            if face_dir is not None:
                actions.append(face_dir)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE triggers the crafting action.
    actions.append(USE)

    return actions

