    import collections, numpy as np

    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def bfs_adjacent(start, targets, blocked):
        w, h = blocked.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    def apply_actions(pos, actions):
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate world and cookbook
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("CraftWorld instance not found in the environment.")
    cookbook = world.cookbook

    # Ensure we have a current state
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # ------------------------------------------------------------------
    # Goal identification
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not defined in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitives required for the goal
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    pos = tuple(state.pos)
    grid = state.grid.copy()
    blocked = np.any(grid, axis=2)   # occupied cells block movement

    plan = []
    harvested = set()

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in primitives_needed.items():
        # Find all cells containing this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance to reduce travel
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed:
                break
            if cell in harvested:
                continue
            # Move adjacent to the primitive
            path = bfs_adjacent(pos, [cell], blocked)
            plan.extend(path)
            pos = apply_actions(pos, path)

            # Pick it up
            plan.append(USE)

            # Update planning structures
            grid[cell[0], cell[1], prim_idx] = 0
            blocked = np.any(grid, axis=2)
            harvested.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the arrow at its workshop (if required)
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = bfs_adjacent(pos, [target_ws], blocked)
            plan.extend(path)
            pos = apply_actions(pos, path)
            plan.append(USE)
        else:
            # No visible workshop – attempt to craft where we are
            plan.append(USE)
    else:
        # No specific workshop required
        plan.append(USE)

    return plan


    import collections, numpy as np

    # Action indices as defined in CraftWorld.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _bfs_adjacent(start, targets, blocked):
        """Return a list of actions that moves from start to a cell adjacent to any target."""
        w, h = blocked.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)
        while q:
            x, y, path = q.popleft()
            # Stop when we are orthogonally adjacent to a target.
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not blocked[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        return []

    def _apply(pos, actions):
        """Apply a list of actions to a position and return the new position."""
        x, y = pos
        for a in actions:
            if a == RIGHT:
                x += 1
            elif a == LEFT:
                x -= 1
            elif a == DOWN:
                y += 1
            elif a == UP:
                y -= 1
        return (x, y)

    # ------------------------------------------------------------------
    # Locate the world and cookbook objects inside the environment.
    # ------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world through the current state.
        cur_state = getattr(env, "_current_state", None)
        if cur_state is not None:
            world = getattr(cur_state, "world", None)
    if world is None:
        raise RuntimeError("Cannot locate CraftWorld instance in the provided environment.")
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Ensure we have a current state; reset the environment if needed.
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state

    # Goal item name.
    goal_name = "arrow"
    if goal_name not in cookbook.index.contents:
        raise ValueError(f"Goal '{goal_name}' not found in the recipe file.")
    goal_idx = cookbook.index[goal_name]

    # Primitives required to craft the goal.
    primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Planning structures.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                 # (x, y)
    grid = state.grid.copy()               # (W, H, n_kinds)
    blocked = np.any(grid, axis=2)         # bool mask of occupied cells
    plan_actions = []                      # final action list
    harvested = set()                      # cells already collected from

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        # Locate all cells that currently contain this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from current position to reduce travel.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        collected = 0
        for cell in cells:
            if collected >= needed_cnt:
                break
            if cell in harvested:
                continue
            # Move adjacent to the primitive.
            path = _bfs_adjacent(pos, [cell], blocked)
            plan_actions.extend(path)
            pos = _apply(pos, path)

            # Pick it up.
            plan_actions.append(USE)

            # Update planning structures: cell is now empty.
            grid[cell[0], cell[1], prim_idx] = 0
            blocked = np.any(grid, axis=2)
            harvested.add(cell)
            collected += 1

    # ------------------------------------------------------------------
    # Craft the goal at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a string name or already an int).
        ws_idx = (cookbook.index[workshop_key]
                  if isinstance(workshop_key, str) else int(workshop_key))
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            # Choose the nearest workshop.
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target_ws = ws_cells[0]
            path = _bfs_adjacent(pos, [target_ws], blocked)
            plan_actions.extend(path)
            pos = _apply(pos, path)
            plan_actions.append(USE)
        else:
            # No visible workshop; attempt to craft at current location.
            plan_actions.append(USE)
    else:
        # No specific workshop required.
        plan_actions.append(USE)

    return plan_actions

