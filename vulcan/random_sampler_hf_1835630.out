    cookbook = world.cookbook

    # Identify the goal item ("arrow") and its recipe.
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for one arrow.
    primitive_counts = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Determine a workshop kind that can craft the goal (any workshop index).
    workshop_kind = None
    # The recipe dict may contain a non‑int key indicating the workshop.
    for key, val in cookbook.recipes[goal_idx].items():
        if not isinstance(key, int):
            # If the key itself is the workshop kind name, resolve its index.
            if isinstance(key, str):
                workshop_kind = cookbook.index.get(key, None)
            else:
                workshop_kind = key
            break
    if workshop_kind is None and world.workshop_indices:
        workshop_kind = world.workshop_indices[0]

    # Helper to translate a Manhattan displacement into action indices.
    action_map = env.action_specs()  # e.g. {'DOWN':0,'UP':1,'LEFT':2,'RIGHT':3,'USE':4}
    def _moves(src, dst):
        """Return a list of actions that moves from src (y,x) to dst (y,x)."""
        dy = dst[0] - src[0]
        dx = dst[1] - src[1]
        seq = []
        if dy < 0:
            seq += [action_map['UP']] * (-dy)
        elif dy > 0:
            seq += [action_map['DOWN']] * dy
        if dx < 0:
            seq += [action_map['LEFT']] * (-dx)
        elif dx > 0:
            seq += [action_map['RIGHT']] * dx
        return seq

    plan = []

    # Collect each required primitive the needed number of times.
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            # Locate a cell that currently holds the primitive.
            locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # No more of this primitive on the map – abort collection.
                break
            target = tuple(locations[0])
            # Move to the primitive cell.
            plan += _moves(state.pos, target)
            # Pick it up.
            plan.append(action_map['USE'])
            # Update the simulated state so subsequent moves are based on the new position.
            for a in plan[-(_moves(state.pos, target).__len__() + 1):]:
                _, state = env.step(a)

    # Finally, go to a suitable workshop and craft the arrow.
    if workshop_kind is not None:
        locations = np.argwhere(state.grid[:, :, workshop_kind] > 0)
        if locations.size > 0:
            target = tuple(locations[0])
            plan += _moves(state.pos, target)
            plan.append(action_map['USE'])   # crafting action

    return plan


    # Reset environment to start a fresh episode and obtain initial state
    env.reset()
    state = env._current_state

    # Goal item index and handy references
    goal = env.task.goal
    world = env.world
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Helper: recursively collect primitive requirements for any item.
    # Returns a dict {primitive_kind: total_count}
    # ----------------------------------------------------------------------
    def _primitive_requirements(item):
        rec = cookbook.recipes.get(item, {})
        req = {}
        for ing, cnt in rec.items():
            if ing == "_key":
                continue
            sub = _primitive_requirements(ing)
            if sub:
                for k, v in sub.items():
                    req[k] = req.get(k, 0) + v * cnt
            else:
                req[ing] = req.get(ing, 0) + cnt
        return req

    # Primitives we ultimately need to collect for the final goal
    needed_prims = _primitive_requirements(goal)

    # ----------------------------------------------------------------------
    # Action utilities
    # ----------------------------------------------------------------------
    act_map = {name: idx for idx, name in env.action_specs().items()}
    USE = act_map.get("USE", 4)

    def _move_towards(pos, target):
        """Return an action that moves one step from pos towards target."""
        px, py = pos
        tx, ty = target
        if px < tx:
            return act_map["RIGHT"]
        if px > tx:
            return act_map["LEFT"]
        if py < ty:
            return act_map["DOWN"]
        if py > ty:
            return act_map["UP"]
        return None

    # ----------------------------------------------------------------------
    # Main planning loop – keep acting until the goal appears in inventory.
    # ----------------------------------------------------------------------
    actions = []
    while not state.satisfies("", goal):
        # --------------------------------------------------------------
        # 1. Try to craft anything we can at the current location.
        # --------------------------------------------------------------
        crafted = False
        for out_item, rec in cookbook.recipes.items():
            workshop = rec.get("_key")
            if workshop is None:
                continue
            # Must be adjacent (or on) the required workshop.
            if not state.next_to(workshop):
                continue
            # Check inventory for all required ingredients.
            can_craft = True
            for ing, cnt in rec.items():
                if ing == "_key":
                    continue
                if state.inventory[ing] < cnt:
                    can_craft = False
                    break
            if can_craft:
                actions.append(USE)
                _, _ = env.step(USE)
                state = env._current_state
                crafted = True
                break
        if crafted:
            continue

        # --------------------------------------------------------------
        # 2. Determine which primitive items we still need.
        # --------------------------------------------------------------
        remaining = {}
        for kind, need in needed_prims.items():
            have = int(state.inventory[kind])
            if need > have:
                remaining[kind] = need - have

        # --------------------------------------------------------------
        # 3. If we still need primitives, head to the closest one.
        # --------------------------------------------------------------
        if remaining:
            pos = state.pos
            grid = state.grid
            best_dist = None
            best_target = None
            best_kind = None
            for kind in remaining.keys():
                locations = np.argwhere(grid[:, :, kind] > 0)
                for (x, y) in locations:
                    d = abs(x - pos[0]) + abs(y - pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best_target = (x, y)
                        best_kind = kind
            if best_target is not None:
                # If we are already on the cell containing the primitive, pick it up.
                if state.pos == best_target:
                    actions.append(USE)
                    _, _ = env.step(USE)
                    state = env._current_state
                    continue
                # Otherwise move one step towards it.
                act = _move_towards(state.pos, best_target)
                if act is not None:
                    actions.append(act)
                    _, _ = env.step(act)
                    state = env._current_state
                    continue
        else:
            # --------------------------------------------------------------
            # 4. No primitives left – move to the workshop for the final goal.
            # --------------------------------------------------------------
            rec = cookbook.recipes.get(goal, {})
            workshop = rec.get("_key")
            if workshop is not None:
                # Locate any workshop cell of the required type.
                workshop_cells = np.argwhere(state.grid[:, :, workshop] > 0)
                if workshop_cells.size > 0:
                    pos = state.pos
                    dists = [abs(x - pos[0]) + abs(y - pos[1]) for x, y in workshop_cells]
                    target = tuple(workshop_cells[int(np.argmin(dists))])
                    if state.pos != target:
                        act = _move_towards(state.pos, target)
                        if act is not None:
                            actions.append(act)
                            _, _ = env.step(act)
                            state = env._current_state
                            continue
            # --------------------------------------------------------------
            # 5. Fallback – make a safe move (up) to avoid dead‑loop.
            # --------------------------------------------------------------
            actions.append(act_map["UP"])
            _, _ = env.step(act_map["UP"])
            state = env._current_state

    return actions

