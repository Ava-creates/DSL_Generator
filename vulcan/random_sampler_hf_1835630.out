    # Constants for actions
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and grab current state / world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks
        from ``start`` to ``goal`` using a simple Manhattan walk."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def nearest_location(locations, from_pos):
        """Pick the nearest location (in Manhattan distance) from ``from_pos``."""
        if not locations:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        idx = np.argmin(dists)
        return tuple(locations[idx])

    def free_adjacent(cell, cur_pos):
        """Return a free adjacent cell to ``cell`` (prefer a cell that keeps us
        facing the target). If none are free, return the target cell itself."""
        y, x = cell
        candidates = [
            (y - 1, x),  # above   (facing DOWN)
            (y + 1, x),  # below   (facing UP)
            (y, x - 1),  # left    (facing RIGHT)
            (y, x + 1),  # right   (facing LEFT)
        ]
        for ny, nx in candidates:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                # check if any non‑grabbable entity occupies the cell
                occupied = False
                if world.non_grabbable_indices:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx)
        # fallback – may be blocked but we have no better option
        return cell

    # ------------------------------------------------------------------
    # Determine the primitive requirements for an arrow
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        # Gather all locations of this primitive at the start
        prim_locs = np.argwhere(grid[:, :, prim_idx] > 0)
        for _ in range(count):
            target = nearest_location(prim_locs, cur_pos)
            if target is None:
                # Not enough primitives – abort early
                return actions

            # Choose a free adjacent cell to stand on
            adj = free_adjacent(target, cur_pos)

            # Move to the adjacent cell
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (best‑effort – add a direction action)
            ty, tx = target
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)
            # If already on the same cell, direction does not matter

            # Pick up the primitive
            actions.append(USE)

            # Remove the used location so we don't try to collect it again
            prim_locs = np.array([loc for loc in prim_locs if tuple(loc) != target])

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
        ws_target = nearest_location(ws_locs, cur_pos)
        if ws_target is not None:
            actions += manhattan_path(cur_pos, ws_target)
            cur_pos = ws_target

    # Final USE to trigger crafting
    actions.append(USE)

    return actions

