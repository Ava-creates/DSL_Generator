    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_cells = locate_all(workshop_idx)
        ws_target = nearest_cell(workshop_cells, cur_pos)
        if ws_target is not None:
            actions += bfs_path(cur_pos, ws_target)
            cur_pos = ws_target

    # Final USE triggers crafting of the arrow.
    actions.append(USE)

    return actions

