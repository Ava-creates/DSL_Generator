    while frontier:
        node = frontier.popleft()
        cur = node.state

        # Goal test
        if cur.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # ------------------------------------------------------------------
        # Action ordering – try USE first if a needed primitive or a
        # relevant workshop is adjacent, otherwise explore movement actions.
        # ------------------------------------------------------------------
        actions = []
        # check adjacency for any needed primitive or any workshop (any recipe)
        for kind in needed_prims:
            if cur.next_to(kind):
                actions.append(world.n_actions - 1 if n_actions > 4 else 4)  # USE
                break
        # also try USE when next to any workshop (any recipe output)
        if not actions:
            for out_idx in world.cookbook.recipes:
