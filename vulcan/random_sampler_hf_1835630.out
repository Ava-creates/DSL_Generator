    # Action indices (as defined in CraftLab)
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    from collections import deque
    import numpy as np

    def _bfs_adjacent(start_pos, target_cells, grid):
        """
        Bread‑first search that returns a list of actions moving the agent
        from ``start_pos`` to a cell that is Manhattan‑distance 1 from any
        cell in ``target_cells``. Cells occupied by any non‑grabbable entity
        are treated as blocked.
        """
        W, H = grid.shape[:2]

        # blocked cells: any non‑grabbable entity present
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start_pos

        # Already adjacent to a target?
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacent cell
        return []

    # ------------------------------------------------------------------
    # Initialise current state information
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy of the world grid
    pos = tuple(state.pos)            # (x, y) coordinates
    plan = []                          # actions to be returned

    # Goal index is stored in the task (namedtuple with field `goal`)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal
    # ------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    for kind_idx, count in needed.items():
        while count > 0:
            # Find all cells currently containing this primitive
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive unavailable – abort planning
                return plan

            # Move adjacent to the nearest such cell
            path = _bfs_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Update position according to the movement taken
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Safety fallback – should not happen
                break

            # Update local grid copy (remove one instance of the primitive)
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            count -= 1

    # ------------------------------------------------------------------
    # 2. Move to the required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (name string or integer)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = _bfs_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use the workshop to craft the goal item
            plan.append(ACTION_USE)

    return plan


    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,   # y + 1
        (0, -1): ACTION_UP,    # y - 1
        (-1, 0): ACTION_LEFT,  # x - 1
        (1, 0): ACTION_RIGHT,  # x + 1
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def _bfs_adjacent(start_pos, target_cells, grid):
        """
        Bread‑first search that returns a list of actions moving the agent
        from ``start_pos`` to any cell that is Manhattan‑distance 1 from a
        cell in ``target_cells``. Cells containing any non‑grabbable entity
        are treated as blocked.
        """
        W, H = grid.shape[:2]

        # Build blocked mask from non‑grabbable entities.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start_pos

        # Already adjacent?
        for tx, ty in target_cells:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    for tx, ty in target_cells:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacent cell.
        return []

    # ------------------------------------------------------------------
    # Initialise current state information.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy of the world grid
    pos = tuple(state.pos)            # (x, y) current agent position
    plan = []                          # list of action indices to return

    # Goal index is stored in the task description.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal.
    # ------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    for kind_idx, count in needed.items():
        while count > 0:
            # Locate all cells that currently contain this primitive.
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive not present – abort planning.
                return plan

            # Find a path to a cell adjacent to any such primitive.
            path = _bfs_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate the movement to update the agent's position.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use the primitive (pick up).
            plan.append(ACTION_USE)

            # Determine which primitive cell we are now adjacent to.
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Should not happen, but break to avoid infinite loop.
                break

            # Update local grid copy and decrement remaining count.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            count -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (name or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = _bfs_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use the workshop to craft the item.
            plan.append(ACTION_USE)

    return plan

