    # Reset the environment to a fresh start
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # Action indices (consistent with CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk
        from ``start`` to ``goal`` using a simple Manhattan walk."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)
        return actions

    def nearest_cell(kind_idx, from_pos):
        """Find the nearest cell that currently contains ``kind_idx``."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def free_adjacent(cell):
        """Return a free orthogonal neighbour of ``cell`` (or None)."""
        y, x = cell
        candidates = [
            (y - 1, x, DOWN),   # above, need to face DOWN
            (y + 1, x, UP),     # below, face UP
            (y, x - 1, RIGHT),  # left, face RIGHT
            (y, x + 1, LEFT)    # right, face LEFT
        ]
        for ny, nx, facing in candidates:
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                if not occupied:
                    return (ny, nx, facing)
        return None

    # ------------------------------------------------------------------
    # Determine the recipe for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            # Choose a free adjacent cell to stand on before using.
            adj = free_adjacent(target)
            if adj is None:
                # No free neighbour; stand on the primitive cell itself.
                adj = (target[0], target[1], None)

            # Move to the adjacent cell.
            actions += manhattan_path(cur_pos, adj[:2])
            cur_pos = adj[:2]

            # Adjust facing direction if we have a specific direction.
            if adj[2] is not None:
                actions.append(adj[2])

            # Use to pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = nearest_cell(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions


    # Reset environment and obtain current state and world information
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # Movement deltas corresponding to actions
    ACTION_DELTAS = {
        DOWN:  (1, 0),
        UP:    (-1, 0),
        LEFT:  (0, -1),
        RIGHT: (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def is_walkable(pos):
        """Return True if the cell at `pos` is not blocked by a non‑grabbable entity."""
        y, x = pos
        # Non‑grabbable indices are stored as a set of ints
        return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs_path(start, goal):
        """Breadth‑first search returning a list of actions that moves from start to goal.
        Cells that are non‑walkable are avoided. If no path exists, an empty list is returned."""
        if start == goal:
            return []
        H, W = grid.shape[:2]
        from collections import deque
        queue = deque([start])
        visited = {start}
        parent = {}
        while queue:
            cur = queue.popleft()
            if cur == goal:
                break
            for act, (dy, dx) in ACTION_DELTAS.items():
                ny, nx = cur[0] + dy, cur[1] + dx
                if 0 <= ny < H and 0 <= nx < W:
                    nxt = (ny, nx)
                    if nxt in visited:
                        continue
                    if not is_walkable(nxt):
                        continue
                    visited.add(nxt)
                    parent[nxt] = (cur, act)
                    queue.append(nxt)
        else:
            # No path found
            return []

        # Reconstruct action list
        actions_rev = []
        cur = goal
        while cur != start:
            cur, act = parent[cur]
            actions_rev.append(act)
        actions_rev.reverse()
        return actions_rev

    def locate_all(kind_idx):
        """Return list of (y, x) coordinates where `kind_idx` appears on the grid."""
        return [tuple(coord) for coord in np.argwhere(grid[:, :, kind_idx] > 0)]

    def nearest_cell(cells, from_pos):
        """Select the cell with smallest Manhattan distance from `from_pos`."""
        if not cells:
            return None
        dists = [abs(y - from_pos[0]) + abs(x - from_pos[1]) for (y, x) in cells]
        return cells[int(np.argmin(dists))]

    def adjacent_free(cell):
        """Find a free orthogonal neighbour of `cell`. Return (ny, nx) or None."""
        y, x = cell
        H, W = grid.shape[:2]
        for dy, dx in [( -1, 0), (1, 0), (0, -1), (0, 1)]:
            ny, nx = y + dy, x + dx
            if 0 <= ny < H and 0 <= nx < W and is_walkable((ny, nx)):
                return (ny, nx)
        return None

    def direction_to(src, dst):
        """Return the action that makes the agent at `src` face `dst` (one step away)."""
        dy = dst[0] - src[0]
        dx = dst[1] - src[1]
        if dy == 1 and dx == 0:
            return DOWN
        if dy == -1 and dx == 0:
            return UP
        if dy == 0 and dx == 1:
            return RIGHT
        if dy == 0 and dx == -1:
            return LEFT
        # Not adjacent; default to None
        return None

    # ------------------------------------------------------------------
    # Determine goal index and required primitives
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in required.items():
        for _ in range(needed_cnt):
            # Locate all remaining instances of this primitive
            prim_cells = locate_all(prim_idx)
            target = nearest_cell(prim_cells, cur_pos)
            if target is None:
                # Primitive not present; abort early
                return actions

            # Choose a free adjacent cell to stand on (if possible)
            stand_pos = adjacent_free(target)
            if stand_pos is None:
                # Fallback: stand directly on the primitive cell
                stand_pos = target

            # Move to the chosen standing position
            actions += bfs_path(cur_pos, stand_pos)
            cur_pos = stand_pos

            # Face the primitive (if we are not on the same cell)
            if stand_pos != target:
                face_act = direction_to(stand_pos, target)
                if face_act is not None:
                    actions.append(face_act)

            # Use to collect the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_cells = locate_all(workshop_idx)
        ws_target = nearest_cell(workshop_cells, cur_pos)
        if ws_target is not None:
            actions += bfs_path(cur_pos, ws_target)
            cur_pos = ws_target

    # Final USE to trigger crafting
    actions.append(USE)

    return actions

