    # Retrieve scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Determine primitive requirements for a single arrow
    needed_prims = world.cookbook.primitives_for(target_idx)  # {prim_idx: count}
    # If the recipe has no primitive requirements (unlikely), treat as empty dict
    if not isinstance(needed_prims, dict):
        needed_prims = {}

    # Initial state
    try:
        init_state = scenario.init()
    except Exception:
