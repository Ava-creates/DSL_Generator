    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: Manhattan path (list of actions) from src to dst
    # ------------------------------------------------------------------
    def _manhattan_path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # Helper: find nearest cell (Manhattan) containing a given kind
    # ------------------------------------------------------------------
    def _nearest_cell(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: locate any cell containing a given kind (used for workshops)
    # ------------------------------------------------------------------
    def _any_cell(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Initialise a fresh episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # ------------------------------------------------------------------
    # Identify the goal index for "arrow"
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # unknown goal
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ------------------------------------------------------------------
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    action_seq = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting counts)
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = _nearest_cell(state.grid, prim_idx, state.pos)
            if target is None:
                # Primitive not present – abort early
                return action_seq
            # Move to the primitive cell
            for a in _manhattan_path(state.pos, target):
                _, done, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Pick it up (USE)
            _, done, _ = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # ------------------------------------------------------------------
    # If the recipe specifies a workshop, move there before crafting
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _any_cell(state.grid, workshop_idx)
        if workshop_pos is not None:
            for a in _manhattan_path(state.pos, workshop_pos):
                _, done, _ = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq

    # ------------------------------------------------------------------
    # Craft the arrow (USE at current location)
    # ------------------------------------------------------------------
    _, done, _ = env.step(USE)
    action_seq.append(USE)

    return action_seq


    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: Manhattan path from src to dst (list of actions)
    # ------------------------------------------------------------------
    def _path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind (Manhattan distance)
    # ------------------------------------------------------------------
    def _nearest(grid, kind_idx, start):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start[0]) + abs(j - start[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: locate any cell containing a given kind (used for workshops)
    # ------------------------------------------------------------------
    def _any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # ------------------------------------------------------------------
    # Initialise episode
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world

    # ------------------------------------------------------------------
    # Identify the goal index for "arrow"
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # unknown goal – nothing to do
        return []

    # ------------------------------------------------------------------
    # Build a post‑order list of items that must be crafted (including arrow)
    # ------------------------------------------------------------------
    def _craft_order(goal_idx):
        order = []
        visited = set()

        def _dfs(item):
            if item in visited:
                return
            visited.add(item)
            recipe = world.cookbook.recipes.get(item, {})
            for ing, cnt in recipe.items():
                if ing == "_at":
                    continue
                _dfs(ing)
            order.append(item)

        _dfs(goal_idx)
        return order

    craft_sequence = _craft_order(arrow_idx)

    # Set of primitive kind indices for quick lookup
    primitive_set = world.cookbook.primitives

    action_seq = []

    # ------------------------------------------------------------------
    # Execute the plan: for each item in the post‑order list, ensure its
    # ingredients are present, then move to its workshop (if any) and craft.
    # ------------------------------------------------------------------
    for item_idx in craft_sequence:
        recipe = world.cookbook.recipes.get(item_idx, {})

        # --------------------------------------------------------------
        # Satisfy ingredient requirements (collect primitives as needed)
        # --------------------------------------------------------------
        for ing_idx, need_cnt in recipe.items():
            if ing_idx == "_at":
                continue
            # Keep collecting / crafting until we have enough of this ingredient
            while state.inventory[ing_idx] < need_cnt:
                if ing_idx in primitive_set:
                    # ---- Collect primitive from the world -----------------
                    target = _nearest(state.grid, ing_idx, state.pos)
                    if target is None:
                        # Primitive not available – abort early
                        return action_seq
                    for a in _path(state.pos, target):
                        reward, done, obs = env.step(a)
                        state = env._current_state
                        action_seq.append(a)
                        if done:
                            return action_seq
                    # Pick it up
                    reward, done, obs = env.step(USE)
                    state = env._current_state
                    action_seq.append(USE)
                    if done:
                        return action_seq
                else:
                    # ---- Craft the missing non‑primitive ingredient -------
                    sub_recipe = world.cookbook.recipes.get(ing_idx, {})
                    workshop_name = sub_recipe.get("_at")
                    if workshop_name is not None:
                        ws_idx = world.cookbook.index.index(workshop_name)
                        ws_pos = _any(state.grid, ws_idx)
                        if ws_pos is not None:
                            for a in _path(state.pos, ws_pos):
                                reward, done, obs = env.step(a)
                                state = env._current_state
                                action_seq.append(a)
                                if done:
                                    return action_seq
                            reward, done, obs = env.step(USE)
                            state = env._current_state
                            action_seq.append(USE)
                            if done:
                                return action_seq
                    else:
                        # No workshop required – just use the action
                        reward, done, obs = env.step(USE)
                        state = env._current_state
                        action_seq.append(USE)
                        if done:
                            return action_seq

        # --------------------------------------------------------------
        # All ingredients ready – craft the current item
        # --------------------------------------------------------------
        workshop_name = recipe.get("_at")
        if workshop_name is not None:
            ws_idx = world.cookbook.index.index(workshop_name)
            ws_pos = _any(state.grid, ws_idx)
            if ws_pos is not None:
                for a in _path(state.pos, ws_pos):
                    reward, done, obs = env.step(a)
                    state = env._current_state
                    action_seq.append(a)
                    if done:
                        return action_seq
                reward, done, obs = env.step(USE)
                state = env._current_state
                action_seq.append(USE)
                if done:
                    return action_seq
        else:
            # Craft in place
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    return action_seq

