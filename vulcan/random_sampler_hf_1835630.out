    # actions
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # --------------------------------------------------------------
    # Helper: Manhattan path (fallback when no better path found)
    # --------------------------------------------------------------
    def _manhattan_path(src, dst):
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            if r < tr:
                actions.append(DOWN)
                r += 1
            else:
                actions.append(UP)
                r -= 1
        while c != tc:
            if c < tc:
                actions.append(RIGHT)
                c += 1
            else:
                actions.append(LEFT)
                c -= 1
        return actions

    # --------------------------------------------------------------
    # Helper: BFS respecting passable kinds (empty cells + allowed_kinds)
    # --------------------------------------------------------------
    def _bfs_path(grid, start, goal, allowed_kinds):
        h, w, _ = grid.shape
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (r, c), path = q.popleft()
            if (r, c) == goal:
                return path
            for act, (dr, dc) in ((DOWN, (1, 0)), (UP, (-1, 0)),
                                  (LEFT, (0, -1)), (RIGHT, (0, 1))):
                nr, nc = r + dr, c + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                if (nr, nc) in visited:
                    continue
                cell_kinds = np.where(grid[nr, nc, :] > 0)[0]
                if cell_kinds.size == 0:
                    passable = True
                else:
                    passable = any(k in allowed_kinds for k in cell_kinds)
                if passable:
                    visited.add((nr, nc))
                    q.append(((nr, nc), path + [act]))
        return None

    # --------------------------------------------------------------
    # Helper: locate nearest cell containing a specific kind (Manhattan)
    # --------------------------------------------------------------
    def _find_nearest(grid, kind_idx, start_pos):
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - start_pos[0]) + abs(j - start_pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # --------------------------------------------------------------
    # Helper: locate any cell containing a specific kind (used for workshops)
    # --------------------------------------------------------------
    def _find_any(grid, kind_idx):
        h, w, _ = grid.shape
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    return (i, j)
        return None

    # --------------------------------------------------------------
    # Begin episode
    # --------------------------------------------------------------
    env.reset()
    state = env._current_state
    world = env.world

    # --------------------------------------------------------------
    # Identify the index of the target item ('arrow')
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        # Arrow not defined in this world
        return []

    # --------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # --------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    action_seq = []

    # --------------------------------------------------------------
    # Collect all required primitives (respecting multiplicities)
    # --------------------------------------------------------------
    for prim_idx, need_cnt in primitive_needs.items():
        for _ in range(need_cnt):
            target = _find_nearest(state.grid, prim_idx, state.pos)
            if target is None:
                # Primitive missing – abort early
                return action_seq

            # Find a path that can step on the primitive cell itself
            path = _bfs_path(state.grid, state.pos, target, {prim_idx})
            if path is None:
                path = _manhattan_path(state.pos, target)

            # Execute movement actions
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq

            # Pick up the primitive
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
            if done:
                return action_seq

    # --------------------------------------------------------------
    # Craft the arrow (may require a specific workshop)
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _find_any(state.grid, workshop_idx)
        if workshop_pos is not None:
            path = _bfs_path(state.grid, state.pos, workshop_pos, {workshop_idx})
            if path is None:
                path = _manhattan_path(state.pos, workshop_pos)
            for a in path:
                reward, done, obs = env.step(a)
                state = env._current_state
                action_seq.append(a)
                if done:
                    return action_seq
            # Perform crafting at the workshop
            reward, done, obs = env.step(USE)
            state = env._current_state
            action_seq.append(USE)
    else:
        # No workshop required – attempt to craft in place
        reward, done, obs = env.step(USE)
        state = env._current_state
        action_seq.append(USE)

    return action_seq


