    from collections import deque, namedtuple
    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_state_hash(init_state))

    MAX_STEPS = 1200
    n_actions = getattr(world, "n_actions", 5)

    # Prefer the USE action (index 4) before movement actions
    action_order = [4] + [i for i in range(n_actions) if i != 4]

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        if cur_state.satisfies("", target_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        for a in action_order:
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    return []


    # Obtain the scenario and world objects from the environment
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Get the index of the target item ("arrow") from the cookbook
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initialise the starting state of the scenario
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    # Node holds a state and the list of actions taken to reach it
    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """
        Create a hashable representation of a CraftState.
        Includes position, direction, inventory contents, and the whole grid.
        """
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # BFS frontier and visited set
    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_state_hash(init_state))

    # Safety limits
    MAX_STEPS = 2000
    n_actions = getattr(world, "n_actions", 5)

    # Prefer the USE action (index 4) before movement actions if present
    action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: check if we have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune paths that are already too long
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in action_order:
            _, nxt_state = cur_state.step(a)  # reward is ignored (always 0.0)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # If no plan was found within the limits, return an empty list
    return []

