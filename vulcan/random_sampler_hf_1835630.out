        # Resolve workshop index (may be a name or already an int).
        workshop_idx = (cookbook.index[workshop_key]
                        if isinstance(workshop_key, str)
                        else workshop_key)
        # Find all workshop cells.
        workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            # Choose the nearest workshop.
            workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))
            target_ws = workshop_cells[0]
            occupied = np.any(cur_grid > 0, axis=2)
            path = _bfs_path(pos, [target_ws], occupied)
            actions.extend(path)
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use the workshop to craft the arrow.
            actions.append(USE)

    return actions

