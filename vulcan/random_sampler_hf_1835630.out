    spec = env.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = (
        spec["DOWN"], spec["UP"], spec["LEFT"], spec["RIGHT"], spec["USE"]
    )
    state = env._current_state
    pos = tuple(state.pos)                     # current agent position
    goal = env.task.goal                        # index of the desired item
    needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}

    # copy of the grid to simulate removals after picking up primitives
    grid = state.grid.copy()
    width, height = grid.shape[:2]

    # cells that are permanently blocked (non‑grabbable entities such as water, stone)
    non_grab = list(env.world.non_grabbable_indices)
    if non_grab:
        base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
    else:
        base_blocked = np.zeros((width, height), dtype=bool)

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions from start to target.
    # If allow_target_block=True the target cell may be occupied (primitive or workshop)
    # ----------------------------------------------------------------------
    def bfs_path(start, target, allow_target_block=False):
        blocked = base_blocked.copy()
        if allow_target_block:
            blocked[target[0], target[1]] = False
        q = collections.deque([start])
        came_from = {start: None}
        action_from = {}
        moves = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (RIGHT, (0, 1)),
            (LEFT, (0, -1)),
        ]
        while q:
            cur = q.popleft()
            if cur == target:
                break
            x, y = cur
            for a, (dx, dy) in moves:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        action_from[nxt] = a
                        q.append(nxt)
        if target not in came_from:
            return None
        # reconstruct path
        path = []
        cur = target
        while cur != start:
            path.append(action_from[cur])
            cur = came_from[cur]
        path.reverse()
        return path

    # ----------------------------------------------------------------------
    # Helper: simple Manhattan path (used as fallback)
    # ----------------------------------------------------------------------
    def manhattan_path(start, target):
        moves = []
        x, y = start
        tx, ty = target
        while x < tx:
            moves.append(DOWN)
            x += 1
        while x > tx:
            moves.append(UP)
            x -= 1
        while y < ty:
            moves.append(RIGHT)
            y += 1
        while y > ty:
            moves.append(LEFT)
            y -= 1
        return moves

    actions = []

    # ----------------------------------------------------------------------
    # 1) Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # locate remaining instances of this primitive in the simulated grid
            locs = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locs:
                # no more instances; break (should not happen in a solvable scenario)
                break
            # choose the closest instance by Manhattan distance
            target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))
            path = bfs_path(pos, target, allow_target_block=True)
            if path is None:
                path = manhattan_path(pos, target)
            actions.extend(path)
            actions.append(USE)                     # pick up the primitive
            # update simulated state
            pos = target
            grid[pos[0], pos[1], prim_idx] = 0      # remove primitive from grid

    # ----------------------------------------------------------------------
    # 2) Move to the appropriate workshop and craft the goal item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
        if ws_locs:
            target_ws = min(
                ws_locs,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            path = bfs_path(pos, target_ws, allow_target_block=True)
            if path is None:
                path = manhattan_path(pos, target_ws)
            actions.extend(path)
            actions.append(USE)   # craft at the workshop
    else:
        # No specific workshop; just use at current location
        actions.append(USE)

    return actions

