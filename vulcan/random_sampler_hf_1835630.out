    import random

    # Reset the environment to start a new episode and obtain the initial observation.
    # The reset method returns an observation dict (we do not need its contents here).
    env.reset()

    actions = []
    done = False
    # Upper bound on the number of steps we will try before giving up.
    max_steps = 1000

    while not done and len(actions) < max_steps:
        # Simple exploration policy: choose a random action from the 5 possible actions.
        # Action indices follow the mapping defined in CraftLab.action_specs():
        #   DOWN → 0, UP → 1, LEFT → 2, RIGHT → 3, USE → 4
        act = random.choice([0, 1, 2, 3, 4])

        # Step the environment with the chosen action.
        # env.step returns a tuple (reward, done, observation).
        _, done, _ = env.step(act)

        # Record the action we just performed.
        actions.append(act)

        # If the environment reports that the episode is done (goal achieved or max steps reached),
        # we exit the loop early.
        if done:
            break

    return actions


    # Placeholder implementation: return an empty action list.
    return []

