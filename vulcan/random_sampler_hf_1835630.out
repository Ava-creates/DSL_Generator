    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helpers: action ↔ direction and BFS to a cell adjacent to any target.
    # ----------------------------------------------------------------------
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {a: d for d, a in DIR2ACT.items()}

    def bfs_adjacent(start, targets, grid, blocked_kinds):
        """Return a list of actions that moves the agent from *start* to a cell
        adjacent (Manhattan distance = 1) to any cell in *targets* while avoiding
        cells that contain any kind in *blocked_kinds*."""
        H, W = grid.shape[:2]

        # Build blocked‑cell mask.
        blocked = np.zeros((H, W), dtype=bool)
        for k in blocked_kinds:
            blocked |= grid[:, :, k] > 0

        sx, sy = start
        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.zeros((H, W), dtype=bool)
        visited[sy, sx] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:
                    if blocked[ny, nx]:
                        continue
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[ny, nx] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ----------------------------------------------------------------------
    # Initialise state.
    # ----------------------------------------------------------------------
    # Assume the environment has already been reset; otherwise call env.reset().
    state = env._current_state
    grid = state.grid.copy()                # mutable local copy
    pos = tuple(state.pos)                  # (x, y)

    # Goal item index.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in environment task.")

    # ----------------------------------------------------------------------
    # 1. Gather required primitive resources.
    # ----------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    blocked_kinds = env.world.non_grabbable_indices
    plan = []

    for prim_idx, needed in primitives_needed.items():
        while needed > 0:
            # Locate remaining cells containing this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)  # (y, x) rows
            if prim_cells.size == 0:
                # Primitive unavailable – abort planning.
                return plan

            # Convert to (x, y) tuples for BFS.
            prim_targets = [(int(c[1]), int(c[0])) for c in prim_cells]

            # Find path to become adjacent to the nearest reachable primitive.
            path = bfs_adjacent(pos, prim_targets, grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use (collect) the primitive.
            plan.append(4)   # USE action

            # Identify which primitive cell we are now adjacent to.
            adj_cell = None
            for cy, cx in prim_cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (int(cx), int(cy))
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update local grid and remaining count.
            grid[adj_cell[1], adj_cell[0], prim_idx] -= 1
            needed -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop kind index.
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            workshop_targets = [(int(c[1]), int(c[0])) for c in workshop_cells]
            path = bfs_adjacent(pos, workshop_targets, grid, blocked_kinds)
            plan.extend(path)

            # Simulate movement to workshop adjacency.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft the item by using the workshop.
            plan.append(4)   # USE action

    return plan


    # Ensure the environment is reset to obtain an initial state.
    _ = env.reset()
    state = env._current_state
    grid = state.grid.copy()
    pos = tuple(state.pos)  # (x, y)

    # Goal index of the item to craft.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    # Mapping between movement vectors and CraftLab action indices.
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def get_positions(kind_idx):
        """Return a list of (x, y) coordinates where ``kind_idx`` is present."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)
        return list(zip(xs, ys))

    def bfs_adjacent(start, targets):
        """
        Bread‑first search returning a list of actions that moves the agent
        from ``start`` to a cell adjacent (Manhattan distance 1) to any cell
        in ``targets`` while avoiding blocked cells (any non‑zero entry in the
        grid).
        """
        H, W = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)

        sx, sy = start
        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        from collections import deque
        q = deque()
        q.append((sx, sy, []))
        visited = np.full((H, W), False, dtype=bool)
        visited[sy, sx] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx] and not blocked[ny, nx]:
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[ny, nx] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    plan = []

    # ------------------------------------------------------------------
    # 1. Collect required primitive resources.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_idx, needed in primitives_needed.items():
        while needed > 0:
            prim_positions = get_positions(prim_idx)
            if not prim_positions:
                # Primitive unavailable; abort planning.
                return plan

            # Move adjacent to the nearest reachable primitive.
            path = bfs_adjacent(pos, prim_positions)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(4)  # USE action

            # Identify the primitive cell we are now adjacent to.
            adj = None
            for tx, ty in prim_positions:
                if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:
                    adj = (tx, ty)
                    break
            if adj is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update local grid copy and decrement requirement.
            grid[adj[1], adj[0], prim_idx] -= 1
            needed -= 1

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_positions = get_positions(workshop_idx)
        if workshop_positions:
            path = bfs_adjacent(pos, workshop_positions)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft the item at the workshop.
            plan.append(4)  # USE action

    return plan

