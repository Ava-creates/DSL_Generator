    # Reset environment and get current state
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy of the grid

    # ------------------------------------------------------------------
    # Action indices (as defined by CraftLab)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    H, W = grid.shape[:2]

    def in_bounds(y, x):
        return 0 <= y < H and 0 <= x < W

    def is_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return np.any(grid[y, x])

    def bfs_path(start, goal):
        """Return a list of movement actions from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                # reconstruct actions
                rev = []
                cur = goal
                while cur != start:
                    py, px = parent[cur]
                    if cur[0] == py + 1:
                        rev.append(DOWN)
                    elif cur[0] == py - 1:
                        rev.append(UP)
                    elif cur[1] == px + 1:
                        rev.append(RIGHT)
                    else:
                        rev.append(LEFT)
                    cur = (py, px)
                return list(reversed(rev))
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if is_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x)
                q.append((ny, nx))
        # No path found
        return []

    def find_nearest(kind_idx, from_pos):
        """Return coordinates of the closest cell containing kind_idx, or None."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    def adjacent_free(cell, avoid=set()):
        """Return a free neighbour of `cell` not in `avoid`, or None."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if (ny, nx) in avoid:
                continue
            if not is_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos          # (y, x)
    harvested = set()            # cells we have already collected from

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort planning.
                return actions

            # Find a free adjacent cell to stand on while harvesting.
            adj = adjacent_free(target, avoid=harvested)
            if adj is None:
                # No place to stand; abort.
                return actions

            # Move to that adjacent cell.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (issue a move in its direction; the move will be blocked,
            # but the subsequent USE will interact with the cell in front).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick it up.
            actions.append(USE)

            # Update internal grid to reflect that the primitive has been removed.
            grid[target[0], target[1], prim_idx] = 0
            harvested.add(target)

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is None:
            return actions
        ws_adj = adjacent_free(ws_cell, avoid=harvested)
        if ws_adj is None:
            ws_adj = cur_pos  # stay where we are; still attempt USE
        actions += bfs_path(cur_pos, ws_adj)
        cur_pos = ws_adj

        dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
        if dy == 1:
            actions.append(DOWN)
        elif dy == -1:
            actions.append(UP)
        elif dx == 1:
            actions.append(RIGHT)
        elif dx == -1:
            actions.append(LEFT)

    # Trigger the crafting action.
    actions.append(USE)

    return actions


    # Reset the environment and grab useful objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid.copy()             # mutable copy of the grid

    # ------------------------------------------------------------------
    # Action indices (as defined by CraftLab)
    # ------------------------------------------------------------------
    specs = env.action_specs()
    DOWN = specs["DOWN"]
    UP = specs["UP"]
    LEFT = specs["LEFT"]
    RIGHT = specs["RIGHT"]
    USE = specs["USE"]
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    H, W = grid.shape[:2]

    def in_bounds(y, x):
        return 0 <= y < H and 0 <= x < W

    def is_blocked(y, x):
        """A cell is blocked if any entity occupies it."""
        return np.any(grid[y, x] > 0)

    def bfs_path(start, goal):
        """Return a list of movement actions from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}  # (y,x) -> (prev_y, prev_x, action)
        while q:
            y, x = q.popleft()
            for dy, dx, act in DIRS:
                ny, nx = y + dy, x + dx
                if not in_bounds(ny, nx):
                    continue
                if (ny, nx) in visited:
                    continue
                if is_blocked(ny, nx):
                    continue
                visited.add((ny, nx))
                parent[(ny, nx)] = (y, x, act)
                if (ny, nx) == goal:
                    # reconstruct actions
                    actions = []
                    cur = goal
                    while cur != start:
                        py, px, a = parent[cur]
                        actions.append(a)
                        cur = (py, px)
                    actions.reverse()
                    return actions
                q.append((ny, nx))
        # No path found – return empty list (caller may handle failure)
        return []

    def find_nearest(kind_idx, from_pos):
        """Locate the nearest cell containing the given kind index."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return (int(nearest[0]), int(nearest[1]))

    def adjacent_free(cell):
        """Return a free neighbour of `cell` (or None if none exist)."""
        y, x = cell
        for dy, dx, _ in DIRS:
            ny, nx = y + dy, x + dx
            if not in_bounds(ny, nx):
                continue
            if not is_blocked(ny, nx):
                return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index("arrow")
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = None
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []
    cur_pos = state.pos                     # (y, x)

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort.
                return actions

            # Find a free cell adjacent to the primitive.
            stand = adjacent_free(target)
            if stand is None:
                # No place to stand next to the primitive – abort.
                return actions

            # Move to the standing position.
            actions += bfs_path(cur_pos, stand)
            cur_pos = stand

            # Face the primitive (issue a move in that direction; it will be blocked).
            dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

            # Update internal grid to reflect that the primitive has been harvested.
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Go to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is None:
            return actions
        ws_adj = adjacent_free(ws_cell)
        if ws_adj is None:
            # If we cannot stand next to the workshop, stay where we are and just face it.
            ws_adj = cur_pos
        actions += bfs_path(cur_pos, ws_adj)
        cur_pos = ws_adj

        dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]
        if dy == 1:
            actions.append(DOWN)
        elif dy == -1:
            actions.append(UP)
        elif dx == 1:
            actions.append(RIGHT)
        elif dx == -1:
            actions.append(LEFT)

    # Trigger crafting of the arrow.
    actions.append(USE)

    return actions

