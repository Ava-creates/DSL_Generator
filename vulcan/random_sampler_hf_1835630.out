    # Ensure the environment starts from a fresh episode.
    env.reset()
    cur_state = env._current_state
    world = env.world
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of move actions (0‑3) which brings
    # the agent to a position where the cell directly in front contains
    # the desired kind. If unreachable, returns an empty list.
    # ------------------------------------------------------------------
    from collections import deque

    # Action → (dx, dy) mapping (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)
    _DIR_DELTAS = {
        0: (0, 1),   # DOWN
        1: (0, -1),  # UP
        2: (-1, 0),  # LEFT
        3: (1, 0),   # RIGHT
    }

    def _in_bounds(x, y, w, h):
        return 0 <= x < w and 0 <= y < h

    def _bfs_to_target(state, target_kind):
        grid = state.grid
        w, h = grid.shape[:2]
        sx, sy = state.pos
        sdir = state.dir

        def walkable(x, y):
            if not _in_bounds(x, y, w, h):
                return False
            # Any occupied cell blocks movement.
            return not np.any(grid[x, y, :])

        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, acts = q.popleft()
            # Is the cell in front the target?
            dx, dy = _DIR_DELTAS[d]
            fx, fy = x + dx, y + dy
            if _in_bounds(fx, fy, w, h) and grid[fx, fy, target_kind] > 0:
                return acts
            # Expand possible moves.
            for a in (0, 1, 2, 3):
                ndx, ndy = _DIR_DELTAS[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        # Target not reachable.
        return []

    # ------------------------------------------------------------------
    # Determine primitive requirements for the goal.
    # ------------------------------------------------------------------
    primitive_reqs = world.cookbook.primitives_for(goal_idx)

    # Determine workshop (if any) where the goal must be crafted.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if isinstance(recipe, dict):
        workshop_name = recipe.get('_at')
        if workshop_name is not None:
            workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []

    # ------------------------------------------------------------------
    # Collect required primitives.
    # ------------------------------------------------------------------
    for prim_kind, count in primitive_reqs.items():
        for _ in range(count):
            move_seq = _bfs_to_target(cur_state, prim_kind)
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up the primitive
            # Apply actions to keep the internal state in sync.
            for a in move_seq + [4]:
                _, _, _ = env.step(a)
                cur_state = env._current_state

    # ------------------------------------------------------------------
    # Go to the workshop (if needed) and craft the goal item.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        actions.extend(move_seq)
        actions.append(4)  # USE to craft at the workshop
        for a in move_seq + [4]:
            _, _, _ = env.step(a)
            cur_state = env._current_state

    return actions


    # reset environment to start state
    env.reset()
    state = env._current_state
    world = env.world

    # retrieve action indices from the environment
    act_spec = env.action_specs()
    DOWN = act_spec["DOWN"]
    UP = act_spec["UP"]
    LEFT = act_spec["LEFT"]
    RIGHT = act_spec["RIGHT"]
    USE = act_spec["USE"]

    # direction → (dx, dy) mapping (grid indexed as [x, y])
    deltas = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # goal item index
    goal_idx = env.task.goal

    # primitive requirements for the goal (kind → count)
    primitive_reqs = world.cookbook.primitives_for(goal_idx)

    # workshop where the goal must be crafted (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if isinstance(recipe, dict):
        workshop_name = recipe.get("_at")
        if workshop_name is not None:
            workshop_idx = world.cookbook.index.index(workshop_name)

    actions = []

    # ------------------------------------------------------------------
    # helper: BFS that returns a list of movement actions which leaves the
    # agent adjacent to a cell containing ``target_kind`` and facing it.
    # Returns None if no such sequence exists.
    # ------------------------------------------------------------------
    def _bfs_to_adjacent(grid, start_pos, start_dir, target_kind):
        w, h = grid.shape[:2]

        def _in_bounds(x, y):
            return 0 <= x < w and 0 <= y < h

        # already facing the target?
        dx, dy = deltas[start_dir]
        fx, fy = start_pos[0] + dx, start_pos[1] + dy
        if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
            return []

        from collections import deque

        visited = set()
        q = deque()
        q.append((start_pos[0], start_pos[1], start_dir, []))
        visited.add((start_pos[0], start_pos[1], start_dir))

        while q:
            x, y, d, path = q.popleft()

            # check if the cell in front holds the target
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return path

            # expand possible moves
            for a, (mx, my) in deltas.items():
                nx, ny = x + mx, y + my
                if not _in_bounds(nx, ny):
                    continue
                # movement only allowed onto empty cells
                if np.any(grid[nx, ny, :]):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, path + [a]))

        return None

    # ------------------------------------------------------------------
    # 1) collect all required primitives
    # ------------------------------------------------------------------
    for prim_kind, cnt in primitive_reqs.items():
        for _ in range(cnt):
            path = _bfs_to_adjacent(state.grid, state.pos, state.dir, prim_kind)
            if path is None:
                # cannot reach the primitive – abort early
                return actions
            for a in path:
                _, _, _ = env.step(a)
                state = env._current_state
                actions.append(a)
            # pick up the primitive
            _, _, _ = env.step(USE)
            state = env._current_state
            actions.append(USE)

    # ------------------------------------------------------------------
    # 2) go to the workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        path = _bfs_to_adjacent(state.grid, state.pos, state.dir, workshop_idx)
        if path is not None:
            for a in path:
                _, _, _ = env.step(a)
                state = env._current_state
                actions.append(a)
            # craft / use the workshop
            _, _, _ = env.step(USE)
            state = env._current_state
            actions.append(USE)

    return actions

