    # Reset environment and get handles to the current state and world.
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # Action constants.
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    # Occupancy map: True where any kind occupies the cell.
    occupied = np.any(grid > 0, axis=2)

    # Directions with corresponding deltas and action indices.
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]

    def bfs_path(start, goal):
        """Return a list of actions (DOWN/UP/LEFT/RIGHT) that moves the
        agent from ``start`` to ``goal`` while avoiding occupied cells.
        If no path exists, returns an empty list."""
        if start == goal:
            return []
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {start: (None, None)}  # (prev_cell, action_to_here)

        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx, a in DIRS:
                ny, nx = y + dy, x + dx
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    if (ny, nx) not in visited and not occupied[ny, nx]:
                        visited.add((ny, nx))
                        parent[(ny, nx)] = (cur, a)
                        q.append((ny, nx))

        if goal not in parent:
            return []  # no path found

        # Reconstruct actions backwards.
        actions_rev = []
        cur = goal
        while parent[cur][0] is not None:
            prev, act = parent[cur]
            actions_rev.append(act)
            cur = prev
        actions_rev.reverse()
        return actions_rev

    def find_nearest(kind_idx, from_pos):
        """Find the nearest cell that contains the given kind index.
        Returns (y, x) or None if not found."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine which primitives are required to craft an 'arrow'.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive missing – abort early.
                return actions

            ty, tx = target

            # Choose a free adjacent cell to stand on.
            adj = None
            for dy, dx, _ in DIRS:
                ny, nx = ty + dy, tx + dx
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    if not occupied[ny, nx]:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour; stand on the primitive cell itself.
                adj = target

            # Move to the chosen adjacent cell using BFS path.
            actions += bfs_path(cur_pos, adj)
            cur_pos = adj

            # Face the primitive (best‑effort) by moving one step toward it.
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)
            # If already on the same cell, direction is irrelevant.

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += bfs_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions


    # Reset environment and fetch state...
    ...
    return actions

