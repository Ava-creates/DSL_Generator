    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action / direction maps (as defined by CraftLab)
    # ----------------------------------------------------------------------
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}
    ACTION_USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from ``start``
    # to a cell adjacent (Manhattan distance 1) to any cell in ``targets``.
    # ----------------------------------------------------------------------
    def bfs_to_adjacent(start, targets, grid):
        """Return actions to get adjacent to any target cell."""
        W, H = grid.shape[:2]

        # blocked cells = any non‑grabbable entity present (>0)
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start

        # already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # check adjacency to any target
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # unreachable
        return []

    # ----------------------------------------------------------------------
    # Initialise mutable copies of the current state
    # ----------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy for planning
    pos = tuple(state.pos)            # (x, y)

    # Goal index stored in the task object
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive (and intermediate) requirements for the goal
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives (including intermediates)
    # ----------------------------------------------------------------------
    for kind_idx, cnt_needed in needed.items():
        while cnt_needed > 0:
            # locate all cells that currently contain this kind
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # primitive not present – abort planning
                return plan

            # move adjacent to the nearest reachable primitive
            path = bfs_to_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # simulate movement
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # pick it up
            plan.append(ACTION_USE)

            # find which primitive cell we are now adjacent to
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # unexpected – stop to avoid infinite loop
                break

            # update local grid copy and decrement needed count
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt_needed -= 1

    # ----------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # resolve workshop index (name -> int or already int)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # craft by using the workshop
            plan.append(ACTION_USE)

    return plan


    import numpy as np
    from collections import deque

    # Action indices as defined by CraftLab
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    def bfs_adjacent(start, targets, grid):
        """
        Bread‑first search that returns a list of actions moving the agent
        from ``start`` to a cell adjacent (Manhattan distance 1) to any cell
        in ``targets`` while avoiding non‑grabbable obstacles.
        """
        W, H = grid.shape[:2]

        # Cells occupied by any non‑grabbable entity block movement.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start

        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency
        return []

    # ------------------------------------------------------------------
    # Initialise mutable copies of the current state
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy for simulation
    pos = tuple(state.pos)            # (x, y)

    # Goal index is stored in the task definition (env.task.goal)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Primitive requirements for the goal (expanded recursively)
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for kind_idx, cnt_needed in needed.items():
        while cnt_needed > 0:
            # Locate all cells that currently contain this primitive
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # Primitive not present – abort planning
                return plan

            # Move adjacent to the nearest reachable primitive
            path = bfs_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to update position
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected; safety break to avoid infinite loop
                break

            # Update the simulated grid and decrement needed count
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            cnt_needed -= 1

    # ------------------------------------------------------------------
    # 2. Move to the required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # Resolve workshop index (could be a name or already an int)
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)

            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Craft by using the workshop
            plan.append(ACTION_USE)

    return plan

