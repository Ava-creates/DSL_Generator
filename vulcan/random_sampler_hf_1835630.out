    # code...


    # ----------------------------------------------------------------------
    # Action identifiers – must match the ordering used in CraftWorld.
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving the agent from `src`
    # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in
    # `targets`.  Cells where `blocked` is True are treated as obstacles.
    # ----------------------------------------------------------------------
    from collections import deque

    def _bfs_adjacent(src, targets, blocked):
        w, h = blocked.shape
        target_set = set(targets)

        # Already adjacent?
        for tx, ty in target_set:
            if abs(src[0] - tx) + abs(src[1] - ty) == 1:
                return []

        q = deque()
        q.append((src[0], src[1], []))
        visited = {src}
        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in MOVE_DELTAS.items():
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if blocked[nx, ny] or (nx, ny) in visited:
                    continue
                new_path = path + [act]
                for tx, ty in target_set:
                    if abs(nx - tx) + abs(ny - ty) == 1:
                        return new_path
                visited.add((nx, ny))
                q.append((nx, ny, new_path))
        return []  # unreachable

    # ----------------------------------------------------------------------
    # Retrieve the world and current state from the environment.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state
        world = state.world
    else:
        state = getattr(env, "_current_state", None)
        if state is None:
            env.reset()
            state = env._current_state

    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # ----------------------------------------------------------------------
    # Determine primitive ingredients needed for a single arrow.
    # ----------------------------------------------------------------------
    needed_prims = cookbook.primitives_for(goal_idx)           # {prim_idx: count}
    if not needed_prims:                                        # arrow itself is primitive
        return [USE]

    # ----------------------------------------------------------------------
    # Current grid, agent position and occupancy mask.
    # ----------------------------------------------------------------------
    grid = state.grid                                          # (W, H, n_kinds)
    pos = tuple(state.pos)                                     # (x, y)
    occupied = np.any(grid > 0, axis=2)                        # True where any entity exists

    actions = []
    harvested = set()                                          # cells already collected from

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ----------------------------------------------------------------------
    for prim_idx, count_needed in needed_prims.items():
        collected = 0
        while collected < count_needed:
            # Locate all remaining cells containing this primitive.
            cand = [
                tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)
                if tuple(p) not in harvested
            ]
            if not cand:
                break  # no more of this primitive on the map

            # Choose the closest one (Manhattan distance).
            cand.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            target = cand[0]

            # Plan path to a cell adjacent to the primitive.
            path = _bfs_adjacent(pos, [target], occupied)
            actions.extend(path)

            # Simulate movement.
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            actions.append(USE)
            harvested.add(target)
            collected += 1

            # Update occupancy – the cell becomes empty after pickup.
            occupied[target] = False

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (may be a name string).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        ws_cells = [
            tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)
        ]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
            ws_target = ws_cells[0]
            path = _bfs_adjacent(pos, [ws_target], occupied)
            actions.extend(path)
            for act in path:
                dx, dy = MOVE_DELTAS[act]
                pos = (pos[0] + dx, pos[1] + dy)
            actions.append(USE)          # craft at workshop
        else:
            actions.append(USE)          # fallback: try to craft in place
    else:
        actions.append(USE)              # no specific workshop required

    return actions

