    # Mapping from direction vectors to action indices (DOWN,UP,LEFT,RIGHT)
    DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    from collections import deque
    import numpy as np

    def bfs_to_adjacent(start, targets, grid):
        """Return a list of actions that moves from ``start`` to a cell
        adjacent to any of ``targets`` while avoiding non‑grabbable obstacles."""
        W, H = grid.shape[:2]

        # Cells are blocked if they contain any non‑grabbable entity.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start
        # Already adjacent to a target?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target cell.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ------------------------------------------------------------------
    # Begin planning.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy of the world grid
    pos = tuple(state.pos)            # (x, y)

    # Goal item index (could be stored directly or as part of a struct)
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # Determine all primitive (or intermediate) items required for the goal.
    needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    plan = []

    # --------------------------------------------------------------
    # 1. Collect required primitives / intermediate items.
    # --------------------------------------------------------------
    for kind_idx, required_cnt in needed.items():
        while required_cnt > 0:
            # Locate cells that currently hold this kind.
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # No more of this primitive in the world – abort planning.
                return plan

            # Move adjacent to the nearest such cell.
            path = bfs_to_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement to keep ``pos`` up‑to‑date.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Use action to pick up the primitive.
            plan.append(4)   # USE

            # Identify which cell we are now adjacent to.
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update local grid copy to reflect the pickup.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            required_cnt -= 1

    # --------------------------------------------------------------
    # 2. Move to the required workshop (if any) and craft the goal.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (name string or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Craft by using the workshop.
            plan.append(4)   # USE

    return plan


    # Mapping from direction vectors to action indices.
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,   # y+ (down)
        (0, -1): ACTION_UP,    # y- (up)
        (-1, 0): ACTION_LEFT,  # x- (left)
        (1, 0): ACTION_RIGHT,  # x+ (right)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    from collections import deque
    import numpy as np

    def bfs_to_adjacent(start, targets, grid):
        """Return a list of actions moving from ``start`` to a cell adjacent
        to any cell in ``targets`` while avoiding non‑grabbable obstacles.

        ``grid`` has shape (W, H, K). Cells are blocked if they contain any
        entity whose index is in ``env.world.non_grabbable_indices``.
        """
        W, H = grid.shape[:2]

        # Build blocked mask.
        blocked = np.zeros((W, H), dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= grid[:, :, idx] > 0

        sx, sy = start
        # Already adjacent?
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((W, H), False, dtype=bool)
        visited[sx, sy] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    if blocked[nx, ny]:
                        continue
                    npath = path + [act]
                    # Check adjacency to any target.
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[nx, ny] = True
                    q.append((nx, ny, npath))
        # No reachable adjacency.
        return []

    # ------------------------------------------------------------------
    # Begin planning.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()          # mutable copy of the world grid
    pos = tuple(state.pos)            # (x, y)

    # Goal index may be stored directly or inside a struct.
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        raise ValueError("Goal index not found in env.task")

    # --------------------------------------------------------------
    # 1. Collect required primitive items.
    # --------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []

    for kind_idx, remaining in needed.items():
        while remaining > 0:
            # Locate cells that currently contain this kind.
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                # No more of this primitive on the map – abort planning.
                return plan

            # Move adjacent to the nearest such cell.
            path = bfs_to_adjacent(pos, cells.tolist(), grid)
            plan.extend(path)

            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)

            # Pick up the primitive.
            plan.append(ACTION_USE)

            # Identify which cell we are now adjacent to.
            adj_cell = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj_cell = (cx, cy)
                    break
            if adj_cell is None:
                # Unexpected situation; break to avoid infinite loop.
                break

            # Update the local grid copy and decrement remaining count.
            grid[adj_cell[0], adj_cell[1], kind_idx] -= 1
            remaining -= 1

    # --------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item.
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (name string or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use the workshop to craft.
            plan.append(ACTION_USE)

    return plan

