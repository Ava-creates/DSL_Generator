    scenario = getattr(env, "scenario", None) or env
    world = getattr(scenario, "world", None) or getattr(env, "world", None)
    if world is None:
        return []

    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _hash(st):
        # Position, direction, inventory tuple, and immutable grid snapshot
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_hash(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 400                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # default to 5 (4 moves + USE)

    # Prefer USE action (usually last index) to speed up collection/crafting
    action_order = list(range(n_actions - 1, -1, -1))

    while frontier:
        node = frontier.popleft()
        state = node.state

        # Goal test: have at least one arrow in inventory
        if state.satisfies("", target_idx):
            return node.actions

        if len(node.actions) >= MAX_STEPS:
            continue

        for a in action_order:
            _, next_state = state.step(a)
            key = _hash(next_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(next_state, node.actions + [a]))

    # No plan found within limits
    return []


    # Resolve scenario and world objects.
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow".
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state of the episode.
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ------------------------------------------------------------------
    # Bread‑first search over (state, action_sequence) pairs.
    # ------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _hash_state(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory (as a tuple), and full grid bytes.
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_hash_state(init_state)}
    frontier = deque([Node(init_state, [])])

    MAX_STEPS = 500                     # safety bound on plan length
    n_actions = getattr(world, "n_actions", 5)   # default to 5 (4 moves + USE)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test – have at least one arrow in inventory.
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Depth limit.
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand neighbours.
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            key = _hash_state(nxt_state)
            if key not in visited:
                visited.add(key)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within the search limits.
    return []

