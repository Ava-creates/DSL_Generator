    env.reset()
    state = env._current_state
    world = env.world

    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Action → (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}

    def bfs_to_target(cur_state, target_kind):
        """Return a list of movement actions (0‑3) that ends with the agent
        facing a cell containing `target_kind`. Empty list means already
        adjacent or unreachable."""
        grid = cur_state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        from collections import deque
        q = deque()
        start_x, start_y = cur_state.pos
        start_dir = cur_state.dir
        q.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return []

    actions = []

    # ------------------------------------------------------------------
    # Collect all primitive resources required for one arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_seq = bfs_to_target(state, prim_idx)
            # If BFS failed but we are already adjacent, still allow pickup
            if not move_seq and not state.next_to(prim_idx):
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            for a in move_seq + [4]:
                _, state = state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its required workshop (if any)
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = bfs_to_target(state, workshop_idx)
        actions.extend(move_seq)
        actions.append(4)  # USE to craft
        for a in move_seq + [4]:
            _, state = state.step(a)
    else:
        # No specific workshop; attempt crafting in place
        actions.append(4)
        _, state = state.step(4)

    return actions


    # Reset the environment and get handles to the current state and world.
    env.reset()
    cur_state = env._current_state
    world = env.world

    # Index of the goal item "arrow". If not present, return empty plan.
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # Mapping from action index to (dx, dy) movement.
    deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}  # DOWN,UP,LEFT,RIGHT

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that ends
    # with the agent facing a cell containing `target_kind`. Returns [] if
    # the target is already in front or unreachable.
    # ----------------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        import numpy as np
        from collections import deque

        grid = state.grid
        W, H = grid.shape[:2]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        start_x, start_y = state.pos
        start_dir = state.dir
        q = deque()
        q.append((start_x, start_y, start_dir, []))
        visited = {(start_x, start_y, start_dir)}

        while q:
            x, y, d, acts = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return acts
            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, acts + [a]))
        return []  # unreachable

    actions = []

    # ----------------------------------------------------------------------
    # 1) Collect all primitive resources required for a single arrow.
    # ----------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            # If BFS failed but we are already adjacent, still allow a USE.
            if not move_seq and not cur_state.next_to(prim_idx):
                # Unreachable primitive – abort planning.
                return actions
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            # Apply the actions to keep cur_state in sync.
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # ----------------------------------------------------------------------
    # 2) Craft the arrow at its required workshop (if any).
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        actions.extend(move_seq)
        actions.append(4)  # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – attempt crafting in place.
        actions.append(4)
        _, cur_state = cur_state.step(4)

    return actions

