    # ----------------------------------------------------------------------
    # make_arrow_vn
    # ----------------------------------------------------------------------
    # The function builds a plan that collects the primitives required for an
    # “arrow” and then crafts the arrow at the appropriate workshop.  It works
    # by performing a breadth‑first search in the *state* space of the
    # environment.  The search is guided by a simple heuristic that prefers
    # actions which bring the agent closer to a needed primitive (or to the
    # workshop once all primitives have been gathered).  The first sequence of
    # actions that yields an inventory containing at least one ``arrow`` is
    # returned.
    #
    # The implementation is deliberately self‑contained – it uses only the
    # public API of the provided classes (CraftWorld, CraftScenario,
    # CraftState, …) and does not rely on any hidden implementation details.
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple
    import numpy as np

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        # Position, direction, inventory vector and the occupancy of the grid.
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    def _manhattan(a, b):
        """Manhattan distance between two (x, y) points."""
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    # ------------------------------------------------------------------
    # Extract world / scenario information
    # ------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Initial state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ------------------------------------------------------------------
    # Determine what we need to collect
    # ------------------------------------------------------------------
    # Primitive requirements for a single arrow (primitive_idx -> count)
    primitive_needs = world.cookbook.primitives_for(target_idx)

    # Workshop where the arrow can be crafted
    recipe = world.cookbook.recipes.get(target_idx, {})
    workshop_name = recipe.get("_at")  # e.g. "workshop"
    workshop_idx = None
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.get(workshop_name)

    # ------------------------------------------------------------------
    # Search node definition
    # ------------------------------------------------------------------
    Node = namedtuple("Node", ["state", "actions", "dist"])

    # ------------------------------------------------------------------
    # Initialise frontier
    # ------------------------------------------------------------------
    frontier = deque()
    start_node = Node(state=init_state, actions=[], dist=0)
    frontier.append(start_node)
    visited = {_state_hash(init_state)}

    # ------------------------------------------------------------------
    # Search parameters
    # ------------------------------------------------------------------
    MAX_STEPS = 3000                     # safety bound
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # --------------------------------------------------------------
        # Goal test: we have at least one arrow in the inventory
        # --------------------------------------------------------------
        if cur_state.satisfies("", target_idx):
            return node.actions

        # --------------------------------------------------------------
        # Stop expanding overly long paths
        # --------------------------------------------------------------
        if len(node.actions) >= MAX_STEPS:
            continue

        # --------------------------------------------------------------
        # Heuristic: distance to the *nearest* needed primitive, or to the
        # workshop if we already have everything.
        # --------------------------------------------------------------
        # Compute which primitives are still missing.
        missing = {}
        for prim_idx, req_cnt in primitive_needs.items():
            have = int(cur_state.inventory[prim_idx])
            if have < req_cnt:
                missing[prim_idx] = req_cnt - have

        # If nothing is missing we head for the workshop (if known).
        if not missing:
            # If there is no workshop information we just continue BFS.
            if workshop_idx is not None:
                # Find any cell that contains the workshop.
                ws_cells = np.argwhere(cur_state.grid[:, :, workshop_idx] > 0)
                if ws_cells.size:
                    # Use Manhattan distance to the *closest* workshop cell.
                    dists = [_manhattan(cur_state.pos, tuple(p[:2])) for p in ws_cells]
                    heuristic = min(dists)
                else:
                    heuristic = 0
            else:
                heuristic = 0
        else:
            # Find the closest cell that holds any of the missing primitives.
            primitive_cells = []
            for p_idx in missing.keys():
                cells = np.argwhere(cur_state.grid[:, :, p_idx] > 0)
                primitive_cells.extend(cells.tolist())
            if primitive_cells:
                dists = [_manhattan(cur_state.pos, tuple(p[:2])) for p in primitive_cells]
                heuristic = min(dists)
            else:
                # No remaining primitives on the map – continue BFS anyway.
                heuristic = 0

        # --------------------------------------------------------------
        # Expand neighbours (actions)
        # --------------------------------------------------------------
        for a in range(n_actions):
            reward, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h in visited:
                continue
            visited.add(h)

            # Insert in frontier using a simple priority: actions that reduce
            # the heuristic are explored first (A*‑like behaviour).  Because we
            # use a deque we push “good” nodes to the left and others to the
            # right.
            # Re‑compute heuristic for the child state.
            # (We reuse the same code as above – a tiny helper.)
            child_missing = {}
            for prim_idx, req_cnt in primitive_needs.items():
                have = int(nxt_state.inventory[prim_idx])
                if have < req_cnt:
                    child_missing[prim_idx] = req_cnt - have

            if not child_missing and workshop_idx is not None:
                ws_cells = np.argwhere(nxt_state.grid[:, :, workshop_idx] > 0)
                child_h = min(
                    [_manhattan(nxt_state.pos, tuple(p[:2])) for p in ws_cells]
                ) if ws_cells.size else 0
            else:
                prim_cells = []
                for p_idx in child_missing.keys():
                    cells = np.argwhere(nxt_state.grid[:, :, p_idx] > 0)
                    prim_cells.extend(cells.tolist())
                child_h = (
                    min([_manhattan(nxt_state.pos, tuple(p[:2])) for p in prim_cells])
                    if prim_cells else 0
                )

            # Prefer nodes with smaller heuristic.
            if child_h <= heuristic:
                frontier.appendleft(Node(state=nxt_state,
                                         actions=node.actions + [a],
                                         dist=node.dist + 1))
            else:
                frontier.append(Node(state=nxt_state,
                                     actions=node.actions + [a],
                                     dist=node.dist + 1))

    # No plan found within the search budget.
    return []


    # Retrieve scenario and world objects
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Determine the index of the target item "arrow"
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Obtain the initial state of the episode
    try:
        init_state = scenario.init()
    except Exception:
        return []

    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_state_hash(init_state))

    MAX_STEPS = 2000
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No plan found within limits
    return []

