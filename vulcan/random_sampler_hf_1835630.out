                    a = act_map[act_name]
                    actions.append(a)
                    env.step(a)

            # craft at the workshop
            actions.append(act_map["USE"])
            env.step(act_map["USE"])

    return actions


    import numpy as np
    from collections import deque

    # reset the environment and initialise containers
    env.reset()
    actions = []

    # goal information and recipe details
    goal_idx = env.task.goal
    needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at', None)

    # mapping from action name to action index and movement deltas
    act_map = env.action_specs()          # e.g. {'DOWN':0, 'UP':1, ...}
    move_delta = {
        'UP':    (-1, 0),
        'DOWN':  ( 1, 0),
        'LEFT':  ( 0,-1),
        'RIGHT': ( 0, 1),
    }

    def bfs_to_adjacent(start, targets, grid):
        """
        Bread‑first search returning a list of action names that moves the agent
        from `start` to any cell that is Chebyshev‑adjacent (including diagonally)
        to a cell in `targets`.  Returns None if no such path exists.
        """
        W, H = grid.shape[:2]
        visited = np.zeros((W, H), dtype=bool)
        q = deque()
        q.append((start, []))
        visited[start] = True
        target_set = set(targets)

        while q:
            pos, path = q.popleft()

            # adjacency test
            for tx, ty in target_set:
                if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:
                    return path

            # expand neighbours (orthogonal moves only)
            for act_name, (dx, dy) in move_delta.items():
                nx, ny = pos[0] + dx, pos[1] + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # can only walk through empty cells
                    if grid[nx, ny].sum() == 0:
                        visited[nx, ny] = True
                        q.append(((nx, ny), path + [act_name]))
        return None

    # ----------------------------------------------------------------------
    # 1) Collect all required primitive resources
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            state = env._current_state
            grid = state.grid
            pos = state.pos

            # locate all cells containing the required primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                continue

            # plan a path to the nearest reachable primitive
            path = bfs_to_adjacent(pos, prim_cells, grid)
            if path is None:
                continue

            # execute movement actions
            for act_name in path:
                act_id = act_map[act_name]
                actions.append(act_id)
                env.step(act_id)

            # pick up the primitive (USE)
            use_id = act_map['USE']
            actions.append(use_id)
            env.step(use_id)

    # ----------------------------------------------------------------------
    # 2) Go to the required workshop (if any) and craft the goal item
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        state = env._current_state
        grid = state.grid
        pos = state.pos

        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            path = bfs_to_adjacent(pos, workshop_cells, grid)
            if path:
                for act_name in path:
                    act_id = act_map[act_name]
                    actions.append(act_id)
                    env.step(act_id)

            # craft at the workshop (USE)
            use_id = act_map['USE']
            actions.append(use_id)
            env.step(use_id)

    return actions

