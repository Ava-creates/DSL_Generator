    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    moves = [
        ((0, 1), DOWN),   # down  (y+1)
        ((0, -1), UP),    # up    (y-1)
        ((-1, 0), LEFT),  # left  (x-1)
        ((1, 0), RIGHT),  # right (x+1)
    ]

    def bfs_path(start, goal, grid):
        """Return a list of actions moving from start to goal using BFS.
        Cells containing any entity are treated as blocked, except the goal
        cell itself which may be occupied (e.g., a workshop or item)."""
        w, h = grid.shape[0], grid.shape[1]          # x‑size, y‑size
        from collections import deque
        q = deque([tuple(start)])
        prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)

        while q:
            x, y = q.popleft()
            if [x, y] == goal:
                break
            for (dx, dy), act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in prev:
                    continue
                # allow stepping onto the goal cell even if occupied
                if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:
                    continue
                prev[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))

        if tuple(goal) not in prev:
            return []   # unreachable

        # reconstruct path
        path = []
        cur = tuple(goal)
        while prev[cur][0] is not None:
            cur, act = prev[cur]
            path.append(act)
        path.reverse()
        return path

    def nearest_kind(kind_idx, cur_pos, grid):
        """Find the nearest cell (Manhattan) that currently contains the given kind."""
        ys, xs = np.where(grid[:, :, kind_idx] > 0)   # y‑rows, x‑cols
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Determine starting position (live state if available)
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the initial grid for planning
    grid = env.scenario.init_grid.copy()

    actions = []
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the goal
    # ------------------------------------------------------------------
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for prim_kind, needed in primitive_requirements.items():
        for _ in range(needed):
            target = nearest_kind(prim_kind, cur_pos, grid)
            if target is None:
                # Primitive not found – abort planning
                return actions
            actions.extend(bfs_path(cur_pos, target, grid))
            actions.append(USE)                     # pick up primitive
            # Remove the primitive from our planning grid
            grid[target[0], target[1], prim_kind] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            actions.extend(bfs_path(cur_pos, workshop_pos, grid))
            actions.append(USE)   # perform crafting at the workshop
            cur_pos = workshop_pos

    # Return the complete action sequence
    return actions


    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper: move current position (list [x, y]) toward target (list [x, y])
    # ------------------------------------------------------------------
    def _move_to(cur, target, seq):
        """Append actions to seq that move cur to target using Manhattan moves."""
        while cur[0] != target[0] or cur[1] != target[1]:
            if cur[0] < target[0]:
                seq.append(RIGHT)
                cur[0] += 1
            elif cur[0] > target[0]:
                seq.append(LEFT)
                cur[0] -= 1
            elif cur[1] < target[1]:
                seq.append(DOWN)
                cur[1] += 1
            elif cur[1] > target[1]:
                seq.append(UP)
                cur[1] -= 1

    # ------------------------------------------------------------------
    # Helper: locate nearest cell that currently contains the requested kind.
    # Returns [x, y] or None.
    # ------------------------------------------------------------------
    def _nearest_kind(kind_idx, cur_pos, grid):
        xs, ys = np.where(grid[:, :, kind_idx] > 0)   # x‑indices first, then y‑indices
        if xs.size == 0:
            return None
        dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])
        best = int(np.argmin(dists))
        return [int(xs[best]), int(ys[best])]

    # ------------------------------------------------------------------
    # Determine starting position (live state if available, else init pos)
    # ------------------------------------------------------------------
    if hasattr(env, "_current_state") and env._current_state is not None:
        cur_pos = list(env._current_state.pos)
    else:
        cur_pos = list(env.scenario.init_pos)

    # Work on a mutable copy of the static grid so we can “remove” items once taken.
    grid = env.scenario.init_grid.copy()

    actions = []
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Gather all primitive resources required for the goal.
    # ------------------------------------------------------------------
    primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()

    # If the goal itself is a primitive, we must also pick it up.
    if goal_idx in env.world.cookbook.primitives:
        primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1

    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            target = _nearest_kind(kind_idx, cur_pos, grid)
            if target is None:
                # Required primitive missing – abort planning.
                return actions
            _move_to(cur_pos, target, actions)
            actions.append(USE)                     # pick up / interact
            # Mark the primitive as taken in our local grid copy.
            grid[target[0], target[1], kind_idx] = 0
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. If the recipe specifies a workshop, go there and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)
        if workshop_pos is not None:
            _move_to(cur_pos, workshop_pos, actions)
            actions.append(USE)   # perform crafting at the workshop

    # Return the complete sequence of actions.
    return actions

