    # action identifiers
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from `start` to a cell
    # adjacent (Manhattan distance = 1) to any cell in `targets`.  Occupied
    # cells (any non‑zero entry in the grid) are treated as walls.
    # ----------------------------------------------------------------------
    def _bfs_adjacent(start, targets, occ):
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        target_set = set(targets)

        while q:
            x, y, path = q.popleft()
            # adjacency test
            for tx, ty in target_set:
                if abs(x - tx) + abs(y - ty) == 1:
                    return path
            # expand neighbours
            for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),
                                (-1, 0, LEFT), (1, 0, RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    if not occ[nx, ny]:
                        visited.add((nx, ny))
                        q.append((nx, ny, path + [act]))
        # unreachable – return empty list
        return []

    # ----------------------------------------------------------------------
    # Locate the underlying CraftWorld instance and its cookbook.
    # ----------------------------------------------------------------------
    world = getattr(env, "world", None)
    if world is None:
        # Some wrappers expose the world via the internal state.
        state_obj = getattr(env, "_current_state", None)
        if state_obj is not None:
            world = getattr(state_obj, "world", None)
    if world is None:
        raise RuntimeError("Could not locate CraftWorld instance inside env.")
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Ensure we start from a fresh episode.
    # ----------------------------------------------------------------------
    if not hasattr(env, "_current_state") or env._current_state is None:
        env.reset()
    state = env._current_state

    # ----------------------------------------------------------------------
    # Goal: craft an 'arrow'.
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Required primitive counts for a single arrow.
    primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # ----------------------------------------------------------------------
    # Current position, grid and occupancy map.
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid                           # (W, H, n_kinds)
    occupied = np.any(grid > 0, axis=2)         # True where movement is blocked

    actions = []            # final action sequence
    collected_cells = set() # primitives already harvested

    # ----------------------------------------------------------------------
    # Collect each required primitive (greedy nearest‑first).
    # ----------------------------------------------------------------------
    for prim_idx, need in primitives_needed.items():
        # Locate all cells that currently contain this primitive.
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # Sort by Manhattan distance from our current position.
        cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        gathered = 0
        for cell in cells:
            if gathered >= need:
                break
            if cell in collected_cells:
                continue
            # Move adjacent to the primitive.
            path = _bfs_adjacent(pos, [cell], occupied)
            actions.extend(path)
            # Update our notion of position.
            for act in path:
                if act == RIGHT:
                    pos = (pos[0] + 1, pos[1])
                elif act == LEFT:
                    pos = (pos[0] - 1, pos[1])
                elif act == DOWN:
                    pos = (pos[0], pos[1] + 1)
                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Pick up the primitive.
            actions.append(USE)
            # After collection the cell becomes empty – update occupancy.
            occupied[cell[0], cell[1]] = False
            collected_cells.add(cell)
            gathered += 1

    # ----------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a string name or already an int).
        workshop_idx = (
            cookbook.index[workshop_key]
            if isinstance(workshop_key, str) else workshop_key
        )
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]
        if not ws_cells:
            raise RuntimeError(f"No workshop of type '{workshop_key}' found.")
        # Choose the nearest workshop.
        ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))
        target_ws = ws_cells[0]
        path = _bfs_adjacent(pos, [target_ws], occupied)
        actions.extend(path)
        for act in path:
            if act == RIGHT:
                pos = (pos[0] + 1, pos[1])
            elif act == LEFT:
                pos = (pos[0] - 1, pos[1])
            elif act == DOWN:
                pos = (pos[0], pos[1] + 1)
            elif act == UP:
                pos = (pos[0], pos[1] - 1)
        # Craft the arrow.
        actions.append(USE)
    else:
        # No specific workshop – just use the craft action at current location.
        actions.append(USE)

    return actions


