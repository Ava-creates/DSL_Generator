    grid = state.grid                     # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def manhattan_path(start, goal):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that
        moves the agent from ``start`` to ``goal`` using a Manhattan walk.
        No obstacle checking is performed."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x

        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)

        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)

        return actions

    def find_nearest(cell_kind, from_pos):
        """Find the nearest cell containing ``cell_kind`` (primitive or workshop).
        Returns the coordinate (y, x) or ``None`` if not found."""
        locations = np.argwhere(grid[:, :, cell_kind] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest_idx = np.argmin(dists)
        return tuple(locations[nearest_idx])

    # ------------------------------------------------------------------
    # Determine the goal index for 'arrow' and the required primitives.
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not found – abort early.
                return actions

            ty, tx = target

            # Choose a free adjacent cell (prefer one that lets us face the primitive).
            adj = None
            neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]
            for ny, nx in neighbours:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx)
                        break
            if adj is None:
                # No free neighbour – fallback to the primitive cell itself.
                adj = target

            # Move to the adjacent cell.
            actions += manhattan_path(cur_pos, adj)
            cur_pos = adj

            # Turn to face the primitive (use a movement action that will be blocked).
            dy, dx = ty - cur_pos[0], tx - cur_pos[1]
            if dy == 1:
                actions.append(DOWN)
            elif dy == -1:
                actions.append(UP)
            elif dx == 1:
                actions.append(RIGHT)
            elif dx == -1:
                actions.append(LEFT)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Trigger crafting at the current location.
    actions.append(USE)

    return actions


    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and fetch underlying objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    grid = state.grid                     # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_free(y, x):
        """Return True if the cell is inside the map and not occupied by a
        non‑grabbable entity."""
        if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):
            return False
        return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs(start, goal_set):
        """Bread‑first search from start to the first position in goal_set.
        Returns the list of positions (including start) describing the path,
        or None if no path exists."""
        from collections import deque

        q = deque([start])
        visited = {start: None}
        while q:
            cur = q.popleft()
            if cur in goal_set:
                # reconstruct path
                path = []
                while cur is not None:
                    path.append(cur)
                    cur = visited[cur]
                path.reverse()
                return path
            y, x = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                nxt = (ny, nx)
                if nxt not in visited and is_free(ny, nx):
                    visited[nxt] = cur
                    q.append(nxt)
        return None

    def positions_to_actions(path):
        """Convert a list of positions to a list of movement actions."""
        acts = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            if y1 == y0 + 1:
                acts.append(DOWN)
            elif y1 == y0 - 1:
                acts.append(UP)
            elif x1 == x0 + 1:
                acts.append(RIGHT)
            elif x1 == x0 - 1:
                acts.append(LEFT)
        return acts

    # ------------------------------------------------------------------
    # Identify goal item and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            # locate all cells that contain this primitive
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # primitive not present – abort early
                return actions

            # map each free adjacent cell to its corresponding primitive cell
            adj_to_prim = {}
            for py, px in prim_cells:
                for dy, dx, face_act in [(1, 0, DOWN), (-1, 0, UP),
                                         (0, 1, RIGHT), (0, -1, LEFT)]:
                    ny, nx = py + dy, px + dx
                    if is_free(ny, nx):
                        adj_to_prim[(ny, nx)] = (py, px, face_act)

            # If no free neighbour exists, fall back to the primitive cell itself
            if not adj_to_prim:
                # treat the primitive cell as the goal (it must be free)
                target_cells = [(py, px) for py, px in prim_cells
                                if is_free(py, px)]
                if not target_cells:
                    return actions
                goal_set = set(target_cells)
                path = bfs(cur_pos, goal_set)
                if path is None:
                    return actions
                actions += positions_to_actions(path)
                cur_pos = path[-1]
                # we are on the same cell as the primitive; just USE
                actions.append(USE)
                continue

            # Search for the nearest reachable adjacent cell
            goal_set = set(adj_to_prim.keys())
            path = bfs(cur_pos, goal_set)
            if path is None:
                return actions

            # Move along the path
            actions += positions_to_actions(path)
            cur_pos = path[-1]

            # Determine direction to face the primitive and use
            py, px, face_act = adj_to_prim[cur_pos]
            actions.append(face_act)   # turn towards the primitive
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            ws_set = {tuple(p) for p in workshop_cells}
            path = bfs(cur_pos, ws_set)
            if path is not None:
                actions += positions_to_actions(path)
                cur_pos = path[-1]

    # Finally trigger crafting
    actions.append(USE)

    return actions

