    from collections import deque
    import numpy as np

    def bfs(start, goals):
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goals:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                if np.any(grid[nx, ny, :]) and nxt not in goals:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    def collect_primitive(prim_idx, needed):
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                break
            path = None
            target_loc = None
            for loc in locations:
                cand = bfs(pos, {loc})
                if cand is not None:
                    path = cand
                    target_loc = loc
                    break
            if path is None:
                break
            actions.extend(path)
            move_along(path)
            actions.append(4)  # USE
            grid[target_loc[0], target_loc[1], prim_idx] = 0
            inventory[prim_idx] += 1
            needed -= 1

    recipes = cookbook.recipes
    primitives_set = cookbook.primitives

    def ensure_item(item_idx, amount):
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives_set:
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            recipe = recipes.get(item_idx, {})
            # ensure ingredients
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to workshop if needed
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # craft
            actions.append(4)  # USE
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    ensure_item(target_idx, 1)
    return actions


    import numpy as np
    from collections import deque

    # current state and world information
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    target_name = "arrow"
    target_idx = cookbook.index[target_name]

    # mutable copies of the world state for planning
    grid = state.grid.copy()
    pos = tuple(state.pos)
    inventory = state.inventory.copy()
    width, height, _ = grid.shape
    actions = []

    # ------------------------------------------------------------------
    # Helper: shortest path (as list of actions) from start to any goal cell
    # ------------------------------------------------------------------
    def bfs(start, goal_cells):
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in goal_cells:
                return path
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                nxt = (nx, ny)
                if nxt in visited:
                    continue
                # can step onto a goal cell even if occupied
                if np.any(grid[nx, ny, :]) and nxt not in goal_cells:
                    continue
                visited.add(nxt)
                q.append((nxt, path + [act]))
        return None

    # ------------------------------------------------------------------
    # Helper: update simulated position according to a path of actions
    # ------------------------------------------------------------------
    def move_along(path):
        nonlocal pos
        for a in path:
            if a == 0:   # DOWN
                pos = (pos[0], pos[1] + 1)
            elif a == 1: # UP
                pos = (pos[0], pos[1] - 1)
            elif a == 2: # LEFT
                pos = (pos[0] - 1, pos[1])
            elif a == 3: # RIGHT
                pos = (pos[0] + 1, pos[1])

    # ------------------------------------------------------------------
    # Primitive collection
    # ------------------------------------------------------------------
    def collect_primitive(prim_idx, needed):
        nonlocal actions, grid, inventory, pos
        while needed > 0:
            # locate all cells that still contain the primitive
            locations = [(x, y) for x in range(width) for y in range(height)
                         if grid[x, y, prim_idx] > 0]
            if not locations:
                break  # nothing left on the map
            # pick the first reachable primitive (could be optimized)
            path = None
            target = None
            for loc in locations:
                cand = bfs(pos, {loc})
                if cand is not None:
                    path, target = cand, loc
                    break
            if path is None:
                break  # unreachable
            actions.extend(path)
            move_along(path)
            actions.append(4)                     # USE to pick up
            grid[target[0], target[1], prim_idx] = 0
            inventory[prim_idx] += 1
            needed -= 1

    # ------------------------------------------------------------------
    # Recursive crafting helper
    # ------------------------------------------------------------------
    recipes = cookbook.recipes
    primitives = cookbook.primitives

    def ensure_item(item_idx, amount):
        nonlocal actions, grid, inventory, pos
        while inventory[item_idx] < amount:
            if item_idx in primitives:
                # primitive: just collect the missing amount
                collect_primitive(item_idx, amount - inventory[item_idx])
                continue

            # need to craft the item
            recipe = recipes.get(item_idx, {})
            # first make sure all ingredients are available
            for ing_idx, cnt in list(recipe.items()):
                if ing_idx == "_at":
                    continue
                if inventory[ing_idx] < cnt:
                    ensure_item(ing_idx, cnt)

            # move to the required workshop (if any)
            workshop = recipe.get("_at")
            if workshop is not None:
                ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]
                ws_cells = [(x, y) for x in range(width) for y in range(height)
                            if grid[x, y, ws_idx] > 0]
                if ws_cells:
                    path = bfs(pos, {ws_cells[0]})
                    if path:
                        actions.extend(path)
                        move_along(path)

            # perform the craft
            actions.append(4)                     # USE to craft
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                inventory[ing_idx] -= cnt
            inventory[item_idx] += 1

    # ------------------------------------------------------------------
    # Build the target arrow
    # ------------------------------------------------------------------
    ensure_item(target_idx, 1)

    return actions

