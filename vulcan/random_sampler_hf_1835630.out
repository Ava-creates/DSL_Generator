    env.reset()
    cur_state = env._current_state
    world = env.world

    # Find index of goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:
        return []

    # ------------------------------------------------------------------
    # BFS helper: returns list of movement actions (0‑3) that bring the
    # agent to a cell where the cell directly in front contains target_kind.
    # Returns None if target unreachable.
    # ------------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # action -> (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sdir = state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # ------------------------------------------------------------------
    # Determine primitive requirements for a single arrow.
    # If the recipe dict is empty, treat the arrow itself as a primitive.
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    plan = []

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            move_seq = _bfs_to_target(cur_state, prim_idx)
            if move_seq is None:
                return plan  # cannot reach required primitive
            plan.extend(move_seq)
            plan.append(4)  # USE action to pick up

            # Update internal state to stay in sync
            for a in move_seq + [4]:
                _, cur_state = cur_state.step(a)

    # ------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        move_seq = _bfs_to_target(cur_state, workshop_idx)
        if move_seq is None:
            return plan  # workshop unreachable
        plan.extend(move_seq)
        plan.append(4)  # USE to craft
        for a in move_seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop; attempt to craft in place.
        plan.append(4)  # USE to craft
        _, cur_state = cur_state.step(4)

    return plan


    env.reset()
    cur_state = env._current_state
    world = env.world

    # Find the index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    if arrow_idx == 0:          # arrow not defined in this world
        return []

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions (0‑3) that brings
    # the agent to a position where the cell directly in front contains
    # `target_kind`. Returns None if the target cannot be reached.
    # ----------------------------------------------------------------------
    def _bfs_to_target(state, target_kind):
        grid = state.grid
        W, H = grid.shape[:2]

        # action → (dx, dy)
        deltas = {
            0: (0, 1),   # DOWN
            1: (0, -1),  # UP
            2: (-1, 0),  # LEFT
            3: (1, 0),   # RIGHT
        }

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        def walkable(x, y):
            return in_bounds(x, y) and not np.any(grid[x, y, :])

        sx, sy = state.pos
        sdir = state.dir

        from collections import deque
        q = deque()
        q.append((sx, sy, sdir, []))
        visited = {(sx, sy, sdir)}

        while q:
            x, y, d, actions = q.popleft()
            dx, dy = deltas[d]
            fx, fy = x + dx, y + dy
            if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:
                return actions

            for a in (0, 1, 2, 3):
                ndx, ndy = deltas[a]
                nx, ny = x + ndx, y + ndy
                if not walkable(nx, ny):
                    continue
                if (nx, ny, a) in visited:
                    continue
                visited.add((nx, ny, a))
                q.append((nx, ny, a, actions + [a]))
        return None

    # ----------------------------------------------------------------------
    # Determine which primitives are required to craft a single arrow.
    # If the recipe dict is empty, the arrow itself is a primitive that must
    # be collected directly.
    # ----------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    if not primitive_needs:
        primitive_needs = {arrow_idx: 1}

    plan = []

    # ----------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ----------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            seq = _bfs_to_target(cur_state, prim_idx)
            if seq is None:
                return plan          # unreachable primitive → abort
            plan.extend(seq)
            plan.append(4)           # USE to pick up / interact

            # Keep internal state in sync.
            for a in seq + [4]:
                _, cur_state = cur_state.step(a)

    # ----------------------------------------------------------------------
    # Craft the arrow at its designated workshop (if any).
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        seq = _bfs_to_target(cur_state, workshop_idx)
        if seq is None:
            return plan          # unreachable workshop → abort
        plan.extend(seq)
        plan.append(4)           # USE to craft
        for a in seq + [4]:
            _, cur_state = cur_state.step(a)
    else:
        # No specific workshop – just try to craft in place.
        plan.append(4)           # USE to craft
        _, cur_state = cur_state.step(4)

    return plan

