        cur = target
        while cur != start:
            seq.append(act_to[cur])
            cur = parent[cur]
        seq.reverse()
        return seq

    # -----------------------------------------------------------------
    # Simple Manhattan fallback (ignores obstacles).
    # -----------------------------------------------------------------
    def manhattan_path(start, target):
        seq = []
        dx = target[0] - start[0]
        dy = target[1] - start[1]
        while dx > 0:
            seq.append(DOWN)
            dx -= 1
        while dx < 0:
            seq.append(UP)
            dx += 1
        while dy > 0:
            seq.append(RIGHT)
            dy -= 1
        while dy < 0:
            seq.append(LEFT)
            dy += 1
        return seq

    # -----------------------------------------------------------------
    # Helper to move to a location, updating position and action list.
    # -----------------------------------------------------------------
    def move_to(tgt):
        nonlocal pos
        if pos == tgt:
            return
        path = bfs(pos, tgt)
        if path is None:
            path = manhattan_path(pos, tgt)
        actions.extend(path)
        pos = tgt

    # -----------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # -----------------------------------------------------------------
    for prim_idx, need_cnt in required.items():
        have = int(inventory[prim_idx])
        to_collect = max(0, need_cnt - have)

        for _ in range(to_collect):
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more instances of this primitive on the map.
                break

            # Choose the nearest instance (Manhattan distance).
            target = min(
                locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )

            move_to(target)
            actions.append(USE)                     # pick up the primitive

            # Update simulated world state.
            grid[target[0], target[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # -----------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the goal.
    # -----------------------------------------------------------------
    recipe = cookbook.recipes.get(goal, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        ws_idx = cookbook.index[workshop_name]
        ws_locations = list(zip(*np.where(grid[:, :, ws_idx] > 0)))
        if ws_locations:
            target_ws = min(
                ws_locations,
                key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),
            )
            move_to(target_ws)
            actions.append(USE)                     # craft at workshop
    else:
        # No specific workshop required; just use the craft action here.
        actions.append(USE)

    return actions


