    """Plan a sequence of actions that gathers the required primitives and
    crafts an ``arrow`` in the provided CraftLab environment.

    The function works for any environment that follows the CraftWorld
    interface.  It extracts the goal index (either from the current task or
    by looking up the name ``'arrow'``), determines the primitive
    requirements, and then uses a BFS planner to move to the nearest
    instances of each primitive while avoiding non‑grabbable obstacles.
    Finally it moves to the appropriate workshop (if any) and issues a
    ``USE`` action to craft the arrow.

    Returns
    -------
    List[int]
        A list of action indices (as defined by the environment's
        ``action_specs``) that, when executed, should produce an arrow.
    """
    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Action mapping (environment may use non‑default indices)
    # ------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _in_bounds(pos, shape):
        x, y = pos
        w, h = shape
        return 0 <= x < w and 0 <= y < h

    def _neighbors(pos, shape):
        x, y = pos
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if _in_bounds((nx, ny), shape):
                yield (nx, ny)

    def _bfs(start, targets, blocked):
        """Bread‑first search from ``start`` to the closest cell in ``targets``.
        Returns the path as a list of positions (including ``start``) or
        ``None`` if no target is reachable.
        """
        w, h = blocked.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        dq = deque([start])
        visited[start] = True
        while dq:
            cur = dq.popleft()
            if cur in targets:
                # reconstruct path
                path = [cur]
                while path[-1] != start:
                    path.append(prev[path[-1]])
                path.reverse()
                return path
            for nb in _neighbors(cur, (w, h)):
                if not visited[nb] and not blocked[nb]:
                    visited[nb] = True
                    prev[nb] = cur
                    dq.append(nb)
        return None

    def _path_to_actions(path):
        """Convert a list of positions (including start) to movement actions."""
        act_list = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 > x0:
                act_list.append(RIGHT)
            elif x1 < x0:
                act_list.append(LEFT)
            elif y1 > y0:
                act_list.append(DOWN)
            elif y1 < y0:
                act_list.append(UP)
        return act_list

    # ------------------------------------------------------------------
    # Access world and current state
    # ------------------------------------------------------------------
    world = env.world
    state = env._current_state
    grid = state.grid.copy()                     # work on a copy for planning
    shape = grid.shape[:2]                       # (WIDTH, HEIGHT)

    # ------------------------------------------------------------------
    # Resolve the goal index for ``arrow``
    # ------------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    if goal_idx is None:
        goal_idx = world.cookbook.index.get("arrow")
    if goal_idx is None:
        raise RuntimeError("Unable to locate goal index for 'arrow'.")

    # ------------------------------------------------------------------
    # Primitive requirements for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = world.cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Cells that are not walkable (non‑grabbable entities)
    # ------------------------------------------------------------------
    blocked = np.zeros(shape, dtype=bool)
    for idx in world.non_grabbable_indices:
        blocked |= grid[:, :, idx] > 0

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: move to a reachable target cell
    # ------------------------------------------------------------------
    def _move_to(target):
        nonlocal cur_pos, actions
        path = _bfs(cur_pos, {target}, blocked)
        if path is None:
            return False
        actions.extend(_path_to_actions(path))
        cur_pos = target
        return True

    # ------------------------------------------------------------------
    # Gather each required primitive
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        gathered = 0
        while gathered < needed:
            # locate all cells that currently contain this primitive
            candidates = [tuple(pos) for pos in np.argwhere(grid[:, :, prim_idx] > 0)]
            if not candidates:
                # no more of this primitive on the map – give up
                break

            # pick the reachable candidate with the shortest path
            best_loc = None
            best_len = None
            for loc in candidates:
                path = _bfs(cur_pos, {loc}, blocked)
                if path is not None:
                    if best_len is None or len(path) < best_len:
                        best_loc = loc
                        best_len = len(path)

            if best_loc is None:
                # nothing reachable
                break

            # move to the chosen location
            _move_to(best_loc)

            # pick up as many as needed (or available)
            available = int(grid[best_loc[0], best_loc[1], prim_idx])
            take = min(available, needed - gathered)
            actions.extend([USE] * take)

            # update planning grid
            grid[best_loc[0], best_loc[1], prim_idx] = max(0, available - take)
            gathered += take

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at") or recipe.get("_key")
    if workshop_key is not None:
        # workshop_key may be a string name or already an index
        if isinstance(workshop_key, int):
            workshop_idx = workshop_key
        else:
            workshop_idx = world.cookbook.index.get(workshop_key)

        if workshop_idx is not None:
            # locate workshop cells
            workshop_cells = [tuple(pos) for pos in np.argwhere(grid[:, :, workshop_idx] > 0)]
            if workshop_cells:
                # pick the closest workshop cell
                ws = min(workshop_cells,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
                # find a free adjacent cell to stand on
                adj_free = [nb for nb in _neighbors(ws, shape) if not blocked[nb]]
                if adj_free:
                    # choose the adjacent cell closest to current position
                    target_adj = min(adj_free,
                                     key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
                    _move_to(target_adj)

    # ------------------------------------------------------------------
    # Final craft action
    # ------------------------------------------------------------------
    actions.append(USE)

    return actions


