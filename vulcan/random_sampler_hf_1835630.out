import numpy as np

# Reset the environment to start a fresh episode
obs = env.reset()
actions = []

# Set a reasonable cap on the number of steps to avoid infinite loops
MAX_STEPS = 1000

# Retrieve the possible action indices from the environment specification
action_space = list(env.action_specs().values())

for _ in range(MAX_STEPS):
    # If the task is already completed, stop early
    if env._is_done():
        break

    # Choose a random action from the available actions
    action = np.random.choice(action_space)
    actions.append(int(action))

    # Execute the action; ignore the reward and observation details
    reward, done, _ = env.step(action)

    # If the environment reports termination, exit the loop
    if done:
