    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Action / direction helpers (indices follow CraftLab's action_specs)
    # ------------------------------------------------------------------
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    DIR2ACT = {
        (0, 1): ACTION_DOWN,    # y+ (down)
        (0, -1): ACTION_UP,     # y- (up)
        (-1, 0): ACTION_LEFT,   # x- (left)
        (1, 0): ACTION_RIGHT,   # x+ (right)
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ------------------------------------------------------------------
    # Bread‑first search: move from start to a cell adjacent to any target.
    # ------------------------------------------------------------------
    def bfs(start, targets, grid):
        """Return a list of actions that brings the agent adjacent to a target.

        Parameters
        ----------
        start : tuple (x, y)
            Current agent position.
        targets : list of (x, y)
            Cells we want to become adjacent to.
        grid : np.ndarray (H, W, K)
            World grid; any non‑zero entry in the last axis blocks movement.

        Returns
        -------
        list[int]
            Action sequence (may be empty if already adjacent or unreachable).
        """
        H, W = grid.shape[:2]
        blocked = np.any(grid > 0, axis=2)

        sx, sy = start
        for tx, ty in targets:
            if abs(sx - tx) + abs(sy - ty) == 1:
                return []

        q = deque()
        q.append((sx, sy, []))
        visited = np.full((H, W), False, dtype=bool)
        visited[sy, sx] = True

        while q:
            x, y, path = q.popleft()
            for (dx, dy), act in DIR2ACT.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:
                    if blocked[ny, nx]:
                        continue
                    npath = path + [act]
                    for tx, ty in targets:
                        if abs(nx - tx) + abs(ny - ty) == 1:
                            return npath
                    visited[ny, nx] = True
                    q.append((nx, ny, npath))
        return []

    # ------------------------------------------------------------------
    # Extract current state information.
    # ------------------------------------------------------------------
    state = env._current_state
    grid = state.grid.copy()                     # mutable copy of the world grid
    pos = tuple(state.pos)                       # (x, y)

    # Goal index (may be an int or a Struct with .arg)
    goal = getattr(env.task, "goal", None)
    if isinstance(goal, (int, np.integer)):
        goal_idx = int(goal)
    elif hasattr(goal, "arg"):
        goal_idx = int(goal.arg)
    else:
        raise ValueError("Unable to determine goal index from env.task")

    # ------------------------------------------------------------------
    # 1. Determine primitive resources needed for the goal.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    plan = []  # final action list

    # ------------------------------------------------------------------
    # 2. Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        while count > 0:
            # Locate all cells currently containing this primitive.
            cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # No more primitives of this type left on the map.
                return plan
            # Find path to the nearest primitive (adjacent cell).
            path = bfs(pos, cells.tolist(), grid)
            plan.extend(path)
            # Simulate movement.
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use action to pick up the primitive.
            plan.append(ACTION_USE)

            # Identify which primitive cell we are now adjacent to.
            adj = None
            for cx, cy in cells:
                if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:
                    adj = (cx, cy)
                    break
            if adj is None:
                # Should not happen; break to avoid infinite loop.
                break

            # Update local grid copy to reflect removal of one primitive.
            grid[adj[1], adj[0], prim_idx] -= 1
            count -= 1

    # ------------------------------------------------------------------
    # 3. Move to the workshop (if required) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        # Resolve workshop index (could be a name string or integer).
        if isinstance(workshop_key, str):
            workshop_idx = env.world.cookbook.index[workshop_key]
        else:
            workshop_idx = int(workshop_key)

        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            path = bfs(pos, workshop_cells.tolist(), grid)
            plan.extend(path)
            for a in path:
                dx, dy = ACT2DIR[a]
                pos = (pos[0] + dx, pos[1] + dy)
            # Use action to craft at the workshop.
            plan.append(ACTION_USE)

    return plan

