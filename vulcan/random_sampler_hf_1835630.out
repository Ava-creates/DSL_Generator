    # Reset environment and fetch current state information
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                   # CraftWorld instance
    grid = state.grid                   # (WIDTH, HEIGHT, n_kinds)

    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_free(pos):
        """Return True if a cell is traversable (no non‑grabbable entity)."""
        y, x = pos
        return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)

    def bfs(start, goals):
        """Breadth‑first search from ``start`` to any cell in ``goals``."""
        from collections import deque
        q = deque([start])
        visited = {start}
        parent = {}

        while q:
            cur = q.popleft()
            if cur in goals:
                # reconstruct path
                path = []
                while cur != start:
                    path.append(cur)
                    cur = parent[cur]
                path.append(start)
                path.reverse()
                return path
            y, x = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    nxt = (ny, nx)
                    if nxt not in visited and is_free(nxt):
                        visited.add(nxt)
                        parent[nxt] = cur
                        q.append(nxt)
        return None

    def path_to_adjacent(target, from_pos):
        """
        Find a path to a free cell adjacent to ``target``.
        Returns (path, facing_dir) where ``facing_dir`` is the direction
        the agent must face to use the primitive (or None if standing on it).
        """
        ty, tx = target
        # candidate adjacent cells (position, direction needed to face the target)
        candidates = []
        for dy, dx, face in [(-1, 0, DOWN), (1, 0, UP),
                             (0, -1, RIGHT), (0, 1, LEFT)]:
            ny, nx = ty + dy, tx + dx
            if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and is_free((ny, nx)):
                candidates.append(((ny, nx), face))

        if not candidates:
            # No free neighbour – fall back to standing on the primitive itself.
            path = bfs(from_pos, {target})
            return path, None

        # Choose the reachable candidate with the shortest path.
        best_path, best_face = None, None
        best_len = None
        for cand, face in candidates:
            path = bfs(from_pos, {cand})
            if path is not None:
                if best_len is None or len(path) < best_len:
                    best_path, best_face, best_len = path, face, len(path)

        if best_path is None:
            # Could not reach any adjacent cell; try the primitive cell itself.
            path = bfs(from_pos, {target})
            return path, None
        return best_path, best_face

    def actions_from_path(path):
        """Convert a list of positions to a list of movement actions."""
        acts = []
        for (y0, x0), (y1, x1) in zip(path, path[1:]):
            if y1 > y0:
                acts.append(DOWN)
            elif y1 < y0:
                acts.append(UP)
            elif x1 > x0:
                acts.append(RIGHT)
            elif x1 < x0:
                acts.append(LEFT)
        return acts

    # ------------------------------------------------------------------
    # Determine primitives needed for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (y, x)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in required_prims.items():
        for _ in range(needed_cnt):
            # Locate the nearest instance of the primitive.
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # Primitive missing – abort early.
                return actions
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            target = tuple(locations[np.argmin(dists)])

            # Find a path to an adjacent free cell and the direction to face.
            path, face_dir = path_to_adjacent(target, cur_pos)
            if path is None:
                return actions

            # Move along the path.
            actions += actions_from_path(path)
            cur_pos = path[-1]

            # Face the primitive if required.
            if face_dir is not None:
                actions.append(face_dir)

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_locations = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_locations.size > 0:
            dists = np.abs(ws_locations[:, 0] - cur_pos[0]) + np.abs(ws_locations[:, 1] - cur_pos[1])
            ws_target = tuple(ws_locations[np.argmin(dists)])
            ws_path = bfs(cur_pos, {ws_target})
            if ws_path:
                actions += actions_from_path(ws_path)
                cur_pos = ws_path[-1]

    # Final USE to trigger crafting.
    actions.append(USE)

    return actions


    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)

    # ------------------------------------------------------------------
    # Constants and helper utilities
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def manhattan_path(start, goal):
        """Return a list of movement actions that walk from ``start`` to ``goal``."""
        actions = []
        y, x = start
        gy, gx = goal
        dy, dx = gy - y, gx - x

        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)

        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)

        return actions

    def find_nearest(kind_idx, from_pos):
        """Linear scan for the nearest cell containing ``kind_idx``."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        nearest = locations[np.argmin(dists)]
        return tuple(nearest)

    # ------------------------------------------------------------------
    # Determine primitives required for an ``arrow``
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = state.pos  # (row, col)

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in required_prims.items():
        for _ in range(needed_cnt):
            target = find_nearest(prim_idx, cur_pos)
            if target is None:
                # Primitive not present – abort early.
                return actions

            ty, tx = target

            # Choose an adjacent free cell to stand on before using.
            adj = None
            for ny, nx, facing in [
                (ty - 1, tx, DOWN),   # stand above, face down
                (ty + 1, tx, UP),     # stand below, face up
                (ty, tx - 1, RIGHT),  # stand left, face right
                (ty, tx + 1, LEFT)    # stand right, face left
            ]:
                if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:
                    occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)
                    if not occupied:
                        adj = (ny, nx, facing)
                        break

            # If no free neighbour, stand on the primitive cell itself.
            if adj is None:
                adj = (ty, tx, None)

            # Move to the chosen adjacent cell.
            actions += manhattan_path(cur_pos, adj[:2])
            cur_pos = adj[:2]

            # Adjust direction if needed.
            if adj[2] is not None:
                actions.append(adj[2])

            # Pick up the primitive.
            actions.append(USE)

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_cell = find_nearest(workshop_idx, cur_pos)
        if ws_cell is not None:
            actions += manhattan_path(cur_pos, ws_cell)
            cur_pos = ws_cell

    # Final USE triggers the crafting action.
    actions.append(USE)

    return actions

