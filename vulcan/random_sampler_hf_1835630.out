    # Bread‑first search over (state, action‑sequence) pairs
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Create a hashable representation of a CraftState."""
        # Grid is large; use its raw bytes to capture exact layout
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_state_hash(init_state))

    MAX_STEPS = 2000                     # safety limit for plan length
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: have at least one arrow in inventory
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune overly long trajectories
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No feasible plan found within the limits
    return []


    # ----------------------------------------------------------------------
    # Retrieve scenario and world objects; fail gracefully if they are missing.
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # Index of the target item "arrow" in the global cookbook.
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # Starting state of the episode.
    try:
        init_state = scenario.init()
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Breadth‑first search over (state, action‑history) pairs.
    # The search is capped by MAX_STEPS to avoid runaway planning.
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _state_hash(st):
        """Hashable representation of a CraftState for visited‑set checks."""
        # Position, direction, inventory tuple, and a bytes view of the grid.
        return (st.pos,
                st.dir,
                tuple(st.inventory.tolist()),
                st.grid.tobytes())

    visited = set()
    frontier = deque([Node(init_state, [])])
    visited.add(_state_hash(init_state))

    MAX_STEPS = 2000                     # safety limit for plan length
    n_actions = getattr(world, "n_actions", 5)

    # Prefer the USE action (index 4) before movement actions to speed up crafting.
    action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))

    while frontier:
        node = frontier.popleft()
        cur_state = node.state

        # Goal test: does the inventory contain at least one arrow?
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Prune excessively long trajectories.
        if len(node.actions) >= MAX_STEPS:
            continue

        # Expand successors.
        for a in action_order:
            reward, nxt_state = cur_state.step(a)   # reward is always 0.0 here
            h = _state_hash(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, node.actions + [a]))

    # No feasible plan found within the limits.
    return []

