    # ----------------------------------------------------------------------
    # Helper: obtain the underlying scenario and world objects
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # ----------------------------------------------------------------------
    # Identify the numeric index of the target item "arrow"
    # ----------------------------------------------------------------------
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:          # recipe might not contain an arrow
        return []

    # ----------------------------------------------------------------------
    # Initialise the start state (CraftState) from the scenario
    # ----------------------------------------------------------------------
    try:
        start_state = scenario.init()
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # BFS over (state, action_sequence) pairs
    # ----------------------------------------------------------------------
    from collections import deque, namedtuple

    Node = namedtuple("Node", ["state", "actions"])

    def _hash_state(st):
        """Create a compact, hash‑able representation of a CraftState."""
        # Position + direction + inventory tuple + immutable grid bytes
        return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())

    visited = {_hash_state(start_state)}
    frontier = deque([Node(start_state, [])])

    # safety limits – avoid infinite search in pathological maps
    MAX_STEPS = 2000
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        cur_node = frontier.popleft()
        cur_state = cur_node.state

        # Goal test: do we already have an arrow?
        if cur_state.satisfies("", target_idx):
            return cur_node.actions

        # Depth limit
        if len(cur_node.actions) >= MAX_STEPS:
            continue

        # Expand all possible primitive actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            h = _hash_state(nxt_state)
            if h not in visited:
                visited.add(h)
                frontier.append(Node(nxt_state, cur_node.actions + [a]))

    # No plan found within the allowed budget
    return []


    # ----------------------------------------------------------------------
    # make_arrow_vn: A* planner that uses recipe information as a heuristic.
    # Returns a list of action indices that achieve at least one "arrow".
    # ----------------------------------------------------------------------
    scenario = getattr(env, "scenario", env)
    world = getattr(scenario, "world", getattr(env, "world", None))
    if world is None:
        return []

    # target item index
    try:
        target_idx = world.cookbook.index["arrow"]
    except Exception:
        return []

    # initial state
    try:
        init_state = scenario.init()
    except Exception:
        return []

    import heapq
    from collections import namedtuple

    Node = namedtuple("Node", ["g", "f", "state", "actions"])

    def _state_hash(st):
        """Hashable representation of a CraftState."""
        return (
            st.pos,
            st.dir,
            tuple(st.inventory.tolist()),
            st.grid.tobytes(),
        )

    # heuristic: number of missing primitive units required for the goal
    # (simple admissible heuristic)
    primitive_requirements = world.cookbook.primitives_for(target_idx)

    def _heuristic(st):
        if st.inventory[target_idx] > 0:
            return 0
        missing = 0
        inv = st.inventory
        for prim_idx, need_cnt in primitive_requirements.items():
            have = inv[prim_idx] if prim_idx < len(inv) else 0
            if have < need_cnt:
                missing += need_cnt - have
        return missing

    start_h = _heuristic(init_state)
    start_node = Node(g=0, f=start_h, state=init_state, actions=[])
    frontier = [(start_node.f, start_node)]  # heap of (priority, node)
    visited = {_state_hash(init_state)}

    MAX_PLAN_LEN = 2500
    n_actions = getattr(world, "n_actions", 5)

    while frontier:
        _, node = heapq.heappop(frontier)
        cur_state = node.state

        # Goal test
        if cur_state.satisfies("", target_idx):
            return node.actions

        # Length pruning
        if node.g >= MAX_PLAN_LEN:
            continue

        # Expand successors
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            hsh = _state_hash(nxt_state)
            if hsh in visited:
                continue
            visited.add(hsh)
            g_next = node.g + 1
            h_next = _heuristic(nxt_state)
            f_next = g_next + h_next
            heapq.heappush(frontier, (f_next, Node(g=g_next, f=f_next,
                                                   state=nxt_state,
                                                   actions=node.actions + [a])))

    # No plan found within limits
    return []

