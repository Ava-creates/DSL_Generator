                elif act == UP:
                    pos = (pos[0], pos[1] - 1)
            # Use action to craft at the workshop
            actions.append(USE)

    # Return the complete action sequence
    return actions


def make_arrow_vn(env):
    DOWN, UP, LEFT, RIGHT, USE = 0,1,2,3,4
    # helper to get state
    state = getattr(env, "_current_state", None)
    if state is None:
        env.reset()
        state = env._current_state
    # world and cookbook
    world = getattr(env, "world", None) or getattr(state, "world", None) or env
    cookbook = world.cookbook
    goal_idx = cookbook.index["arrow"]
    primitives_needed = cookbook.primitives_for(goal_idx)
    # copy grid for simulation
    grid = state.grid.copy()
    occ = np.any(grid > 0, axis=2)  # bool matrix occupied
    pos = tuple(state.pos)
    actions = []
    # BFS function
    def bfs(start, target):
        # target is cell coordinate to reach
        w, h = occ.shape
        q = collections.deque()
        q.append((start[0], start[1], []))
        visited = {start}
        while q:
            x, y, path = q.popleft()
            if (x, y) == target:
                return path
            for dx, dy, act in ((1,0,RIGHT),( -1,0,LEFT),(0,1,DOWN),(0,-1,UP)):
                nx, ny = x+dx, y+dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited and not occ[nx, ny]:
                    visited.add((nx, ny))
                    q.append((nx, ny, path + [act]))
        return []  # unreachable
    # collect primitives
    for prim_idx, count in primitives_needed.items():
        gathered = 0
        # locate all cells containing this primitive
        cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]
        # sort by Manhattan distance from current pos (optional)
        cells.sort(key=lambda c: abs(c[0]-pos[0]) + abs(c[1]-pos[1]))
        for cell in cells:
            if gathered >= count:
                break
            # compute path
            path = bfs(pos, cell)
            actions.extend(path)
            pos = cell
            # use to pick up
            actions.append(USE)
            # update grid and occupancy
            grid[cell[0], cell[1], prim_idx] = 0
            occ[cell[0], cell[1]] = False
            gathered += 1
    # move to workshop if needed
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_key = recipe.get("_at")
    if workshop_key is not None:
        ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]
        if ws_cells:
            ws_cells.sort(key=lambda c: abs(c[0]-pos[0]) + abs(c[1]-pos[1]))
            target_ws = ws_cells[0]
            path = bfs(pos, target_ws)
            actions.extend(path)
            pos = target_ws
            actions.append(USE)
    return actions

