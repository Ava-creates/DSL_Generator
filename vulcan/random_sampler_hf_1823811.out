    def bfs_path(start, target):
        """Return list of move actions from start to target avoiding occupied cells."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # target may be occupied; others must be empty
                if nxt != target and state.grid[nr, nc, :].any():
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # no path
        # reconstruct
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def nearest_cell(cells, start):
        """Pick cell with smallest Manhattan distance to start."""
        best = None
        best_dist = None
        for r, c in cells:
