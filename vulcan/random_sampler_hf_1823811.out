    # Reset the environment and fetch useful references
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal we need to craft (arrow)
    goal_idx = env.task.goal

    # Primitive resources required (including transitive ones)
    required = world.cookbook.primitives_for(goal_idx)

    # Determine the workshop (if any) where the final craft must happen
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # Prepare action list and tracking of current position
    actions = []
    cur_pos = tuple(state.pos)

    # Grid dimensions and a mutable copy of the initial grid
    width, height = scenario.init_grid.shape[:2]
    grid = scenario.init_grid.copy()

    # Set of entity kinds that block movement (non‑grabbable)
    non_grab = set(world.non_grabbable_indices)

    # ----------------------------------------------------------------------
    # Helper: check whether a cell is blocked by a non‑grabbable entity
    # ----------------------------------------------------------------------
    def is_blocked(pos):
        x, y = pos
        if not non_grab:
            return False
        cell = grid[x, y, :]
        return np.any(cell[list(non_grab)] > 0)

    # ----------------------------------------------------------------------
    # Helper: BFS to compute a sequence of movement actions from start to target
    # ----------------------------------------------------------------------
    from collections import deque

    # (dx, dy, action_index) – order matches the action encoding used by the env
    moves = [(0, 1, 0),   # DOWN
             (0, -1, 1),  # UP
             (-1, 0, 2),  # LEFT
             (1, 0, 3)]   # RIGHT

    def bfs_actions(start, target):
        """Return list of actions to move from start to target avoiding blocked cells."""
        if start == target:
            return []
        queue = deque([start])
        visited = {start: None}
        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            x, y = cur
            for dx, dy, act in moves:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = (cur, act)
                        queue.append(nxt)
        else:
            # No path found – return empty list (the caller may choose to skip)
            return []

        # Reconstruct path
        seq = []
        cur = target
        while cur != start:
            prev, act = visited[cur]
            seq.append(act)
            cur = prev
        seq.reverse()
        return seq

    # ----------------------------------------------------------------------
    # Helper: locate the nearest cell containing a given kind
    # ----------------------------------------------------------------------
    def nearest_cell(kind, from_pos):
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = int(dists.argmin())
        return tuple(cells[idx])

    # ----------------------------------------------------------------------
    # Collect all required primitive items
    # ----------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # Primitive not found – skip (should not happen in well‑formed scenarios)
                continue
            actions.extend(bfs_actions(cur_pos, target))
            actions.append(4)                     # USE to pick up the primitive
            grid[target[0], target[1], kind] = 0  # Mark the cell as empty
            cur_pos = target

    # ----------------------------------------------------------------------
    # Move to the workshop (if required) and perform the final craft
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            actions.extend(bfs_actions(cur_pos, target))
            cur_pos = target

    actions.append(4)  # Final USE to trigger crafting of the arrow
    return actions


