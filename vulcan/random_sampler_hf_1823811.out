    # Action identifiers (order matches the environment's definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _bfs_actions(src, dst):
        """Return a shortest sequence of movement actions from src to dst
        while avoiding cells occupied by non‑grabbable entities.
        Falls back to Manhattan moves if no path exists."""
        if src == dst:
            return []

        grid = env._current_state.grid
        h, w = grid.shape[:2]

        # Cells that are blocked for movement (any non‑grabbable entity present)
        non_grab = list(env.world.non_grabbable_indices)
        if non_grab:
            blocked = np.any(grid[:, :, non_grab] > 0, axis=2)
        else:
            blocked = np.zeros((h, w), dtype=bool)

        # Simple bounds check for destination
        if not (0 <= dst[0] < h and 0 <= dst[1] < w):
            return _manhattan_actions(src, dst)

        from collections import deque
        q = deque([src])
        visited = np.full((h, w), False, dtype=bool)
        visited[src] = True
        parent = {}  # (x, y) -> (prev_coord, move)

        moves = [(DOWN, (1, 0)), (UP, (-1, 0)),
                 (RIGHT, (0, 1)), (LEFT, (0, -1))]

        while q:
            cur = q.popleft()
            if cur == dst:
                break
            for move, (dx, dy) in moves:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny] and not blocked[nx, ny]:
                    visited[nx, ny] = True
                    parent[(nx, ny)] = (cur, move)
                    q.append((nx, ny))

        if dst not in parent:
            # No reachable path – fallback to Manhattan moves
            return _manhattan_actions(src, dst)

        # Reconstruct path
        actions_rev = []
        cur = dst
        while cur != src:
            prev, move = parent[cur]
            actions_rev.append(move)
            cur = prev
        actions_rev.reverse()
        return actions_rev

    def _manhattan_actions(src, dst):
        """Simple Manhattan movement (ignores obstacles)."""
        x, y = src
        tx, ty = dst
        acts = []
        dx = tx - x
        dy = ty - y
        if dx > 0:
            acts += [DOWN] * dx
        elif dx < 0:
            acts += [UP] * (-dx)
        if dy > 0:
            acts += [RIGHT] * dy
        elif dy < 0:
            acts += [LEFT] * (-dy)
        return acts

    def _move_actions(src, dst):
        """Choose BFS path if possible, otherwise Manhattan."""
        return _bfs_actions(src, dst)

    def _nearest_kind(pos, kind_idx):
        """Find the nearest cell (Manhattan distance) that contains the given kind."""
        grid = env._current_state.grid
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = int(dists.argmin())
        return tuple(locations[nearest].tolist())

    # ------------------------------------------------------------------
    # Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index.index('arrow')
    primitives_needed = cookbook.primitives_for(arrow_idx)   # dict {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, qty in primitives_needed.items():
        for _ in range(qty):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # Primitive not present – abort early with whatever actions we have
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # Move to workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _manhattan_path(start, goal):
        """Straight‑line Manhattan moves (ignores obstacles)."""
        x, y = start
        tx, ty = goal
        acts = []
        dx = tx - x
        dy = ty - y
        if dx > 0:
            acts += [DOWN] * dx
        elif dx < 0:
            acts += [UP] * (-dx)
        if dy > 0:
            acts += [RIGHT] * dy
        elif dy < 0:
            acts += [LEFT] * (-dy)
        return acts

    def _bfs_path(start, goal):
        """Shortest path avoiding non‑grabbable cells using BFS.
        Falls back to Manhattan moves if no path is found."""
        grid = env._current_state.grid
        h, w, _ = grid.shape
        # cells occupied by any non‑grabbable kind are blocked
        blocked = np.any(grid[:, :, list(env.world.non_grabbable_indices)] > 0,
                         axis=2)

        if not (0 <= goal[0] < h and 0 <= goal[1] < w):
            return []   # out‑of‑bounds target

        from collections import deque
        q = deque([start])
        visited = np.zeros((h, w), dtype=bool)
        visited[start] = True
        parent = {}

        while q:
            cur = q.popleft()
            if cur == goal:
                break
            for move, (dx, dy) in ((DOWN, (1, 0)), (UP, (-1, 0)),
                                   (RIGHT, (0, 1)), (LEFT, (0, -1))):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny] and not blocked[nx, ny]:
                    visited[nx, ny] = True
                    parent[(nx, ny)] = (cur, move)
                    q.append((nx, ny))

        # If goal unreachable, fall back to Manhattan
        if goal not in parent and start != goal:
            return _manhattan_path(start, goal)

        # Reconstruct action list
        actions_rev = []
        cur = goal
        while cur != start:
            prev, move = parent[cur]
            actions_rev.append(move)
            cur = prev
        actions_rev.reverse()
        return actions_rev

    def _move_actions(src, dst):
        """Choose BFS path if possible, otherwise Manhattan."""
        return _bfs_path(src, dst)

    def _nearest(pos, kind_idx):
        """Return coordinates of the nearest cell containing the given kind."""
        grid = env._current_state.grid
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = int(dists.argmin())
        return tuple(locations[nearest].tolist())

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    target_name = 'arrow'
    target_idx = cookbook.index.index(target_name)

    # Primitive requirements for a single arrow
    needed = cookbook.primitives_for(target_idx)   # {prim_idx: count}

    actions = []
    cur_pos = env._current_state.pos

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, qty in needed.items():
        for _ in range(qty):
            loc = _nearest(cur_pos, prim_idx)
            if loc is None:
                # Required primitive not present – abort early
                return actions
            actions += _move_actions(cur_pos, loc)
            cur_pos = loc
            actions.append(USE)   # pick up / interact

    # ------------------------------------------------------------------
    # Move to workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = cookbook.recipes[target_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = cookbook.index.index(workshop_name)
        wloc = _nearest(cur_pos, workshop_idx)
        if wloc is not None:
            actions += _move_actions(cur_pos, wloc)
            cur_pos = wloc
            actions.append(USE)   # craft at workshop

    return actions

