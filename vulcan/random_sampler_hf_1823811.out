    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    def _cell_occupied(pos, grid):
        """Return True if any entity occupies the cell at `pos`."""
        x, y = pos
        return grid[x, y, :].any()

    def _bfs_path(start, goal, grid):
        """Breadth‑first search for a path from start to goal."""
        if start == goal:
            return [start]
        width, height = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        # Goal cell may be occupied; other cells must be free
                        if nxt == goal or not _cell_occupied(nxt, grid):
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # No path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Convert a list of positions into a list of action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, grid):
        """Return actions to move from src to dst, preferring BFS."""
        path = _bfs_path(src, dst, grid)
        if path is None:
            # Fallback to Manhattan moves (may hit obstacles but guarantees progress)
            acts = []
            x, y = src
            tx, ty = dst
            dx, dy = tx - x, ty - y
            if dx > 0:
                acts += [DOWN] * dx
            elif dx < 0:
                acts += [UP] * (-dx)
            if dy > 0:
                acts += [RIGHT] * dy
            elif dy < 0:
                acts += [LEFT] * (-dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx, grid):
        """Find nearest cell containing the given kind index."""
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    # --------------------------------------------------------------
    # Planning
    # --------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    sim_grid = env._current_state.grid.copy()

    # 1. Collect all required primitive items
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_kind(cur_pos, prim_idx, sim_grid)
            if target is None:
                # Primitive not available – abort planning
                return actions
            actions += _move_actions(cur_pos, target, sim_grid)
            cur_pos = target
            actions.append(USE)  # pick up primitive
            sim_grid[target[0], target[1], prim_idx] = 0  # remove from simulated grid

    # 2. Move to workshop (if recipe specifies one) and craft the arrow
    workshop_name = world.cookbook.recipes.get(arrow_idx, {}).get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_pos = _nearest_kind(cur_pos, workshop_idx, sim_grid)
        if ws_pos is not None:
            actions += _move_actions(cur_pos, ws_pos, sim_grid)
            cur_pos = ws_pos
            actions.append(USE)  # craft at the workshop

    return actions


    # code body

