            if prim_cells.size == 0:
                # Primitive unavailable – abort early.
                return actions
            tr, tc = prim_cells[0]

            # Move to the primitive cell.
            move_seq = bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # No workshop info.

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # No workshop found.

    wr, wc = workshop_cells[0]

    # Move to the workshop cell.
    move_seq = bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions


