    # Constants for actions
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Return a list of actions moving Manhattan‑style from src to dst."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions.extend([DOWN] * dx)
        elif dx < 0:
            actions.extend([UP] * (-dx))
        if dy > 0:
            actions.extend([RIGHT] * dy)
        elif dy < 0:
            actions.extend([LEFT] * (-dy))
        return actions

    def _nearest_kind(pos, kind_idx):
        """Find the coordinates of the nearest cell containing kind_idx."""
        grid = env._current_state.grid
        locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))
        if not locations:
            return None
        dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]
        return locations[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # 1. Identify the goal (arrow) and its primitive requirements
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # 2. Reduce requirements by primitives already in inventory
    # ------------------------------------------------------------------
    inventory = env._current_state.inventory
    for prim_idx, have_cnt in list(needed.items()):
        have = int(inventory[prim_idx])
        if have >= have_cnt:
            needed.pop(prim_idx)
        else:
            needed[prim_idx] = have_cnt - have

    # ------------------------------------------------------------------
    # 3. Collect the missing primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # primitive missing – abort early
                return actions
            actions.extend(_move_actions(cur_pos, target))
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # 4. Move to the workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions.extend(_move_actions(cur_pos, workshop_pos))
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Manhattan moves from src (x,y) to dst (x,y)."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
