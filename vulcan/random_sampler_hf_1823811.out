    # Reset environment and get initial references
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld

    # Identify the goal index and required primitives
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)  # {primitive_idx: count}

    # Map action names to indices using the environment's specs
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    # Directions paired with their corresponding movement actions
    move_dirs = [
        (1, 0, ACTION_DOWN),   # down
        (-1, 0, ACTION_UP),    # up
        (0, -1, ACTION_LEFT),  # left
        (0, 1, ACTION_RIGHT),  # right
    ]

    actions = []

    from collections import deque

    def find_path(cur_state, target_kind):
        """
        Breadth‑first search that returns a list of movement actions leading
        the agent to any cell containing `target_kind`. The agent may step onto
        that cell even if it is occupied; otherwise it may only step onto empty
        cells.
        """
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                cell = grid[nx, ny, :]
                # Allow movement onto empty cells or directly onto the target cell
                if cell.sum() == 0 or cell[target_kind] > 0:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        # If unreachable, return empty list (should not happen in valid scenarios)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            # Find a path to a cell containing the needed primitive
            path = find_path(state, kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the goal
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions


