            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # No more primitives of this type on the map – abort planning
                return plan_actions
            # Choose the nearest location
            target_cell = nearest_position(pos, locations)
            if target_cell is None:
                return plan_actions

            # Find a free adjacent cell to stand on before using
            free_adj = adjacent_free_cells(*target_cell)
            if not free_adj:
                # Can't reach this primitive; skip it
                # Mark it as unavailable by zeroing its count to avoid infinite loop
                grid[target_cell[0], target_cell[1], prim_idx] = 0
                continue

            # Choose the free adjacent cell closest to current position
            stand_cell = nearest_position(pos, free_adj)

            # Move to the standing cell
            moves, pos = move_to(pos, stand_cell)
            plan_actions.extend(moves)

            # Use action to pick up the primitive (assumes facing is irrelevant)
            plan_actions.append(ACTION_USE)

            # Update the grid to reflect the collected primitive
            grid[target_cell[0], target_cell[1], prim_idx] -= 1
            needed -= 1

    # ----------------------------------------------------------------------
    # Move to the appropriate workshop and craft the arrow
    # ----------------------------------------------------------------------
    # Identify the workshop kind required for the goal (if any)
