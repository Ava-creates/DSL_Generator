        step onto a primitive or workshop located there)."""
        if pos == goal:
            return True
        x, y = pos
        return not grid[x, y, :].any()

    def _bfs_path(start, goal, grid):
        """Breadth‑first search returning a list of positions from start
        to goal (inclusive). Returns None if no path exists."""
        if start == goal:
            return [start]
        width, height = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            cx, cy = cur
            for dx, dy, _ in MOVES:
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in came_from and _walkable(nxt, goal, grid):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

