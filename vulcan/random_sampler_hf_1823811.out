    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def bfs_path(start, goal, occupied):
        """Return a list of positions (excluding start, including goal) that
        leads from start to goal while avoiding occupied cells. The goal cell
        may be occupied (e.g., a primitive or workshop) and is treated as
        walkable."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Map a movement delta to the corresponding action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ------------------------------------------------------------------
    # Main planning
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)
    # Work on a mutable copy of the grid to track collected primitives
    grid = state.grid.copy()

    # ---- Collect all required primitives --------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # locate remaining instances of this primitive
            locs = np.argwhere(grid[:, :, kind_idx] > 0)
            if locs.size == 0:
                break
            # sort by Manhattan distance from current position
            dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(grid, axis=2)
            chosen_path = None
            target = None
            for idx in order:
                cand = tuple(locs[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    chosen_path = path
                    target = cand
                    break
            if chosen_path is None:
                continue      # cannot reach any remaining instance
            # follow the path
            for step in chosen_path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # pick up the primitive
            actions.append(4)   # USE
            grid[target[0], target[1], kind_idx] = 0

    # ---- Move to workshop (if required) and craft -----------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops are occupied)
            for idx in order:
