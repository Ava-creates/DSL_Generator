    # Reset environment and get initial state
    env.reset()
    state = env._current_state

    # Determine goal index (arrow) from the task or cookbook
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Goal 'arrow' not found in cookbook")

    # Primitive requirements for the goal
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Action constants
    act_spec = env.action_specs()
    DOWN = act_spec["DOWN"]
    UP = act_spec["UP"]
    LEFT = act_spec["LEFT"]
    RIGHT = act_spec["RIGHT"]
    USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: Manhattan move towards a target coordinate.
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal state
        while state.pos != target:
            y, x = state.pos
            ty, tx = target
            if y < ty:
                act = DOWN
                dy, dx = 1, 0
            elif y > ty:
                act = UP
                dy, dx = -1, 0
            elif x < tx:
                act = RIGHT
                dy, dx = 0, 1
            else:
                act = LEFT
                dy, dx = 0, -1
            # try to move; if blocked the position will not change
            actions.append(act)
            _, _, _ = env.step(act)
            state = env._current_state

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind index.
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - state.pos[0]) + abs(j - state.pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: find a free (empty) cell adjacent to a given cell.
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        grid = state.grid
        h, w, _ = grid.shape
        cy, cx = cell
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = cy + dy, cx + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        # fallback: return the original cell (may be occupied)
        return cell

    # ------------------------------------------------------------------
    # Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, count in needed_prims.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                # primitive not present; cannot collect, abort early
                continue
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(USE)
            _, _, _ = env.step(USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # Go to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index.get(workshop_name)
        if workshop_idx is not None:
            ws = find_nearest(workshop_idx)
            if ws:
                adj = adjacent_free(ws)
                move_to(adj)
                actions.append(USE)
                _, _, _ = env.step(USE)
                state = env._current_state

    # Return the compiled action sequence
    return actions


    # Reset environment and obtain initial state
    env.reset()
    state = env._current_state

    # Determine the index of the goal item ("arrow")
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
    if goal_idx is None:
        raise ValueError("Goal 'arrow' not found in cookbook")

    # Primitive requirements for the goal
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Action indices
    act_spec = env.action_specs()
    DOWN = act_spec["DOWN"]
    UP = act_spec["UP"]
    LEFT = act_spec["LEFT"]
    RIGHT = act_spec["RIGHT"]
    USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: move agent to an absolute position using Manhattan moves
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal state
        while state.pos != target:
            y, x = state.pos
            ty, tx = target
            if y < ty:
                act = DOWN
            elif y > ty:
                act = UP
            elif x < tx:
                act = RIGHT
            else:
                act = LEFT
            actions.append(act)
            env.step(act)
            state = env._current_state

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell that contains a specific kind index
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - state.pos[0]) + abs(j - state.pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: pick a free cell adjacent (including the target itself)
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        grid = state.grid
        h, w, _ = grid.shape
        cy, cx = cell
        # If the cell itself is free, use it
        if not grid[cy, cx, :].any():
            return (cy, cx)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = cy + dy, cx + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        # Fallback: return original cell (may be occupied)
        return (cy, cx)

    # ------------------------------------------------------------------
    # Collect all required primitive resources
    # ------------------------------------------------------------------
    for kind_idx, count in needed_prims.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                # Primitive not present; skip (cannot fulfill task)
                continue
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(USE)
            env.step(USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # Move to the appropriate workshop and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws = find_nearest(workshop_idx)
        if ws:
            adj = adjacent_free(ws)
            move_to(adj)
            actions.append(USE)
            env.step(USE)
            state = env._current_state

    return actions

