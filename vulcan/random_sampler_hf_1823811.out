    import collections
    import numpy as np

    def find_path(cur_state, target_kind):
        """Breadth‑first search for a sequence of movement actions that brings the
        agent to a cell containing `target_kind`. The search can walk on empty
        cells or directly onto the target cell; any other occupied cell is
        treated as an obstacle."""
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Cell is free if no entities occupy it, or if it already
                # contains the desired kind (so we can step onto it).
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # No reachable cell – this should not happen in a well‑formed scenario.
        return []

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for kind_idx, count in required.items():
        for _ in range(count):
            path = find_path(state, kind_idx)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # Pick up the primitive that is now under the agent.
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        # Use the workshop to craft the item.
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # Return the complete sequence of actions.
    return actions

