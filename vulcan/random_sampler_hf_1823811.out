    # -------------------------------------------------------------------------
    # Helper: breadth‑first search for a path avoiding any occupied cell
    # -------------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return list of actions to move from start to goal, or empty list if unreachable."""
        grid = state.grid
        h, w, _ = grid.shape
        frontier = collections.deque()
        frontier.append((start, []))
        visited = {start}
        while frontier:
            (y, x), path = frontier.popleft()
            if (y, x) == goal:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
