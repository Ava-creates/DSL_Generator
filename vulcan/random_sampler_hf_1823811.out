                # Required primitive not found – abort planning
                return actions
            actions += manhattan_path(cur_pos, target)
            cur_pos = target
            actions.append(USE)          # pick up the primitive
            # Remove the primitive from our local view so we don't pick it again
            grid[target[0], target[1], prim_idx] = 0

