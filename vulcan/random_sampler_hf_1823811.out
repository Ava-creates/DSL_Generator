    # reset environment and get initial state/world
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    goal_idx = env.task.goal            # index of the item to craft (arrow)

    actions: list[int] = []

    # ---------- helper utilities ----------
    def manhattan(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    def locate(kind):
        """Return list of grid positions where `kind` is present."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def go_to(target):
        """Move the agent from its current position to `target` using
        Manhattan steps. Updates the global `state` and records actions."""
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right (increase x)
                act = 3          # RIGHT
                new_pos = (x + 1, y)
            elif x > tx:        # need to move left
                act = 2          # LEFT
                new_pos = (x - 1, y)
            elif y < ty:        # need to move down (increase y)
                act = 0          # DOWN
                new_pos = (x, y + 1)
            else:               # need to move up
                act = 1          # UP
                new_pos = (x, y - 1)

            actions.append(act)
            _, state = state.step(act)   # apply movement, update state

    def ensure_item(item_idx, needed):
        """Make sure `state.inventory[item_idx]` is at least `needed`.
        Recursively collects primitives or crafts intermediate items."""
        nonlocal state
        while state.inventory[item_idx] < needed:
            # Primitive resources are collected directly from the map
            if item_idx in world.cookbook.primitives:
                positions = locate(item_idx)
                if not positions:
                    raise RuntimeError(f"Primitive {item_idx} not found on map")
                # pick the nearest occurrence
                target = min(positions, key=lambda p: manhattan(p, state.pos))
                go_to(target)
                actions.append(4)               # USE to pick up
                _, state = state.step(4)
                continue

            # Otherwise we need to craft the item according to its recipe
            recipe = world.cookbook.recipes.get(item_idx, {})
            # First, ensure we have all ingredients
            for ing_idx, cnt in recipe.items():
                if ing_idx == "_at":
                    continue
                ensure_item(ing_idx, cnt)

            # Move to the required workshop (if any) before crafting
            workshop_idx = None
            workshop_name = recipe.get("_at")
            if workshop_name is not None:
                workshop_idx = world.cookbook.index[workshop_name]

            if workshop_idx is not None:
                ws_positions = locate(workshop_idx)
                if not ws_positions:
                    raise RuntimeError(f"Workshop {workshop_name} not found on map")
                target = min(ws_positions, key=lambda p: manhattan(p, state.pos))
                go_to(target)

            # Use action to craft the item
            actions.append(4)                     # USE to craft
            _, state = state.step(4)

    # ---------- main plan ----------
    ensure_item(goal_idx, 1)

    return actions


    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # index of the goal item for this task
    goal_idx = env.task.goal

    # primitive requirements for one unit of the goal (recursively expanded)
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine if the goal requires a specific workshop
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_name = recipe["_at"]
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # ------------------------------------------------------------------ #
    # Helper utilities
    # ------------------------------------------------------------------ #
    def locate(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step_action(act):
        """Execute an action, update the local `state`, and return nothing."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def go_to(target):
        """Move (Manhattan) from current position to `target` using the four move actions."""
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right (increase x)
                act = 3          # RIGHT
            elif x > tx:        # need to move left
                act = 2          # LEFT
            elif y < ty:        # need to move down (increase y)
                act = 0          # DOWN
            else:               # need to move up
                act = 1          # UP
            actions.append(act)
            step_action(act)

    # ------------------------------------------------------------------ #
    # 1) Collect all required primitives
    # ------------------------------------------------------------------ #
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:          # primitive not present – abort early
                return actions
            # pick the nearest occurrence to reduce travel distance
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # pick up the item (USE)
            actions.append(4)          # USE
            step_action(4)

    # ------------------------------------------------------------------ #
    # 2) Go to the required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------ #
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target = min(ws_positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            actions.append(4)          # USE to craft at the workshop
            step_action(4)

    return actions

