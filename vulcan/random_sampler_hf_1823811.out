    # Pre‑compute blocked cells (non‑grabbable entities)
    blocked_cells = set()
    for ng in world.non_grabbable_indices:
        occ = np.where(state.grid[:, :, ng] > 0)
        blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked_cells:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        return [start]

    def move_action(cur, nxt):
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("Non‑adjacent move requested")

    actions = []
    cur_pos = state.pos
    used_cells = set()

    # Collect required primitives
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            candidates = [loc for loc in find_locations(prim_idx) if loc not in used_cells]
            if not candidates:
                # Primitive not available; assume already in inventory
                continue
            target = min(candidates,
                         key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
            used_cells.add(target)
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE to pick up

    # Move to workshop (if required) and craft
    if workshop_kind is not None:
        wk_locs = [loc for loc in find_locations(workshop_kind)]
        if wk_locs:
            target = min(wk_locs,
                         key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE to craft
    else:
        # No specific workshop – craft at current location
        actions.append(4)       # USE to craft

    return actions

