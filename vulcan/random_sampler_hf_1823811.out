    # Reset the environment if possible.
    try:
        env.reset()
    except Exception:
        pass

    # Access the underlying scenario and world objects.
    scenario = getattr(env, "scenario", None) or getattr(env, "scn", None)
    world = getattr(env, "world", None) or getattr(env, "wrld", None)
    if scenario is None or world is None:
        raise RuntimeError("Unable to locate scenario or world in the environment.")

    # Current agent position.
    pos = tuple(scenario.init_pos)

    # Copy of the initial grid layout.
    grid = np.array(scenario.init_grid, copy=True)

    # Determine the index for the "arrow" goal.
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow item not found in the cookbook.")

    # Primitives required to craft the arrow.
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # Locate all instances of each required primitive on the map.
    primitive_locs = {}
    for kind in primitives_needed:
        ys, xs = np.where(grid[:, :, kind] > 0)  # ys: x‑indices, xs: y‑indices
        primitive_locs[kind] = list(zip(xs.tolist(), ys.tolist()))  # (x, y) tuples

    # Locate workshop(s) where the arrow can be crafted.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    workshop_positions = []
    if workshop_kind is not None:
        wy, wx = np.where(grid[:, :, workshop_kind] > 0)
        workshop_positions = list(zip(wx.tolist(), wy.tolist()))
    if not workshop_positions:
        workshop_positions = [pos]  # fallback to current location

    actions = []

    def _move(cur, target):
        """Return a list of actions to move from cur to target (Manhattan moves)."""
        act = []
        x, y = cur
        tx, ty = target
        while x < tx:
            act.append(3)  # RIGHT
            x += 1
        while x > tx:
            act.append(2)  # LEFT
            x -= 1
        while y < ty:
            act.append(0)  # DOWN
            y += 1
        while y > ty:
            act.append(1)  # UP
            y -= 1
        return act, (x, y)

    def _pop_nearest(cur, locs):
        """Remove and return the location nearest to cur."""
        if not locs:
            return None
        dists = [abs(cur[0] - lx) + abs(cur[1] - ly) for (lx, ly) in locs]
        idx = int(np.argmin(dists))
        return locs.pop(idx)

    # Collect each required primitive the necessary number of times.
    for kind, count in primitives_needed.items():
        for _ in range(count):
            target = _pop_nearest(pos, primitive_locs.get(kind, []))
            if target is None:
                continue  # no more of this primitive on the map
            move_seq, pos = _move(pos, target)
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up the primitive
            # Update the grid to reflect the collected item.
            grid[target[0], target[1], kind] = 0

    # Move to the nearest workshop and craft the arrow.
    workshop_target = _pop_nearest(pos, workshop_positions)
    if workshop_target is not None:
        move_seq, pos = _move(pos, workshop_target)
        actions.extend(move_seq)
        actions.append(4)  # USE to craft the arrow

    return actions

