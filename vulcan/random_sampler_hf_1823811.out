    # Reset environment and get initial references
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal item index
    goal_idx = env.task.goal

    # Primitive requirements for the goal
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine required workshop (if any) for crafting the goal
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # Helper: locate all positions of a given kind on the current grid
    def locate(kind):
        grid = state.grid
        inds = np.argwhere(grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    # Helper: move agent from current position to target using Manhattan steps
    # Action mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE
    def go_to(target):
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right (increase x)
                act = 3
            elif x > tx:        # need to move left
                act = 2
            elif y < ty:        # need to move down (increase y)
                act = 0
            else:               # need to move up
                act = 1
            actions.append(act)
            _, state = state.step(act)

    # Collect each required primitive the necessary number of times
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Primitive not found; abort early
                return actions
            # Choose the nearest occurrence to reduce steps
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the primitive
            actions.append(4)          # USE
            _, state = state.step(4)

    # If a workshop is required, go there and craft the item
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target = min(ws_positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            actions.append(4)          # USE to craft
            _, state = state.step(4)
    else:
        # No specific workshop; just attempt to craft at current location
        actions.append(4)
        _, state = state.step(4)

    return actions


    # Reset environment and obtain initial references
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world
    goal_idx = env.task.goal

    actions = []

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def locate(kind_idx):
        """Return list of (x, y) positions where kind_idx is present."""
        grid = state.grid
        inds = np.argwhere(grid[:, :, kind_idx] > 0)
        return [tuple(p) for p in inds]

    def go_to(target):
        """Move the agent from its current position to target using Manhattan steps."""
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # move right (increase x)
                act = 3          # RIGHT
                new_pos = (x + 1, y)
            elif x > tx:        # move left
                act = 2          # LEFT
                new_pos = (x - 1, y)
            elif y < ty:        # move down (increase y)
                act = 0          # DOWN
                new_pos = (x, y + 1)
            else:               # move up
                act = 1          # UP
                new_pos = (x, y - 1)

            actions.append(act)
            _, state = state.step(act)   # apply movement

    def pick_up(kind_idx):
        """Move to the nearest instance of kind_idx and USE to pick it up."""
        nonlocal state
        positions = locate(kind_idx)
        if not positions:
            raise RuntimeError(f"Cannot find required primitive {kind_idx} on the grid.")
        # Choose nearest by Manhattan distance
        target = min(positions,
                     key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
        go_to(target)
        actions.append(4)                # USE
        _, state = state.step(4)

    # ----------------------------------------------------------------------
    # Core recursive crafting logic
    # ----------------------------------------------------------------------
    def ensure(item_idx, needed):
        """
        Guarantee that `state.inventory[item_idx]` is at least `needed`.
        Handles both primitive collection and recursive crafting of intermediate items.
        """
        # If we already have enough, nothing to do
        if state.inventory[item_idx] >= needed:
            return

        # Determine how many more we need
        deficit = needed - state.inventory[item_idx]

        # If the item is a primitive, just collect the required amount
        if item_idx in world.cookbook.primitives:
            for _ in range(deficit):
                pick_up(item_idx)
            return

        # Otherwise the item must have a recipe
        recipe = world.cookbook.recipes.get(item_idx)
        if recipe is None:
            raise RuntimeError(f"No recipe found for non‑primitive item {item_idx}")

        # For each ingredient (ignore the special key "_at")
        for ing_idx, count_per in recipe.items():
            if ing_idx == "_at":
                continue
            total_needed = count_per * deficit
            ensure(ing_idx, total_needed)

        # After all ingredients are satisfied, go to the required workshop and craft
        workshop_name = recipe.get("_at")
        if workshop_name is None:
            raise RuntimeError(f"Recipe for {item_idx} missing workshop specification")
        workshop_idx = world.cookbook.index[workshop_name]

        # Locate nearest workshop of the appropriate type
        ws_positions = locate(workshop_idx)
        if not ws_positions:
            raise RuntimeError(f"No workshop {workshop_name} found on the grid")
        target_ws = min(ws_positions,
                        key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
        go_to(target_ws)

        # Use the workshop `deficit` times to produce the required amount
        for _ in range(deficit):
            actions.append(4)            # USE
            _, state = state.step(4)

    # ----------------------------------------------------------------------
    # Execute plan for the goal item
    # ----------------------------------------------------------------------
    ensure(goal_idx, 1)

    # Return the compiled action list
    return actions

