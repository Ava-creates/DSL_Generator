    # Reset environment to a clean start
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world                    # CraftWorld instance
    index = world.cookbook.index         # name ↔ integer id

    # ------------------------------------------------------------------
    # Identify goal and its requirements
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = index[goal_name]

    # Primitive counts needed for one arrow (recursively expanded)
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop required to craft the arrow (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else index[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) where grid contains at least one of `kind`."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Convert a step from cur → nxt into an action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Non‑adjacent move requested")

    def bfs(start, goal):
        """Shortest path (list of positions) from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Cells that cannot be entered (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay where we are
        return [start]

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1. Collect required primitives
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            locations = find_locations(prim_idx)
            if not locations:
                # Primitive already in inventory or not present on map
                continue
            target = locations[0]                       # pick first occurrence
            path = bfs(cur_pos, target)
            for step in path[1:]:                       # skip current position
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)                           # USE to pick up

    # 2. Go to workshop (if needed) and craft the arrow
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = wk_locs[0]
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)                           # USE to craft

    return actions


    import numpy as np, collections

    # Reset the environment to a clean start
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world                    # CraftWorld instance
    index = world.cookbook.index         # name ↔ integer id mapping

    # Goal specification
    goal_name = "arrow"
    goal_idx = index[goal_name]

    # Primitive requirements for a single arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop required for crafting the arrow (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else index[wk]

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------

    def find_locations(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Convert a step between adjacent cells into an action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Non‑adjacent step in path")

    def bfs(start, goal):
        """Shortest path (as list of positions) avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Cells that cannot be entered (water, stone, etc.)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay in place
        return [start]

    # --------------------------------------------------------------
    # Planning
    # --------------------------------------------------------------

    actions = []
    cur_pos = state.pos

    # Remember which primitive cells have already been targeted
    used_cells = set()

    # Collect each required primitive the necessary number of times
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            # Find a still‑available instance of the primitive
            locs = [loc for loc in find_locations(prim_idx) if loc not in used_cells]
            if not locs:
                # Assume we already have it in inventory; skip
                continue
            target = locs[0]
            used_cells.add(target)

            # Move to the primitive
            path = bfs(cur_pos, target)
            for step in path[1:]:          # skip the current position
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick it up
            actions.append(4)               # USE

    # Move to the workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = wk_locs[0]
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)               # USE to craft

    return actions

