    import numpy as np
    from collections import deque

    # Action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]

    world = env.world
    grid = env._current_state.grid.copy()
    cur_pos = env._current_state.pos
    actions = []

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions from start to goal.
    # Cells with any entity are treated as obstacles, except the goal cell.
    # ----------------------------------------------------------------------
    def bfs(start, goal):
        if start == goal:
            return []
        h, w = grid.shape[:2]
        visited = np.zeros((h, w), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny]:
                    # allow stepping onto the goal even if occupied
                    if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:
                        continue
                    visited[nx, ny] = True
                    prev[(nx, ny)] = ((x, y), act)
                    if (nx, ny) == goal:
                        # reconstruct path
                        path = []
                        cur = goal
                        while cur != start:
                            (p, a) = prev[cur]
                            path.append(a)
                            cur = p
                        path.reverse()
                        return path
                    q.append((nx, ny))
        return None  # unreachable

    # ----------------------------------------------------------------------
    # Helper: find nearest cell containing a given kind (by BFS distance)
    # ----------------------------------------------------------------------
    def nearest_entity(start, kind_idx):
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        best_path = None
        best_loc = None
        for loc in locations:
            loc_tup = (int(loc[0]), int(loc[1]))
            path = bfs(start, loc_tup)
            if path is None:
                continue
            if best_path is None or len(path) < len(best_path):
                best_path = path
                best_loc = loc_tup
        return best_loc, best_path

    # ----------------------------------------------------------------------
    # Determine what primitives are needed to craft an arrow
    # ----------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ----------------------------------------------------------------------
    # Collect each required primitive
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target, path = nearest_entity(cur_pos, prim_idx)
            if target is None or path is None:
                # cannot reach required primitive – abort planning
                return actions
            actions.extend(path)
            actions.append(USE)          # pick up the primitive
            cur_pos = target
            # update planning grid: remove one instance of the primitive
            if grid[target[0], target[1], prim_idx] > 0:
                grid[target[0], target[1], prim_idx] -= 1

    # ----------------------------------------------------------------------
    # If the recipe specifies a workshop, move there and craft
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos, path = nearest_entity(cur_pos, workshop_idx)
        if workshop_pos is not None and path is not None:
            actions.extend(path)
            actions.append(USE)      # craft at the workshop
            cur_pos = workshop_pos

    return actions


    import numpy as np
    from collections import deque

    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]

    world = env.world
    # Index of the target item (arrow)
    target_idx = world.cookbook.index.index('arrow')
    # Primitive requirements for a single arrow
    primitives_needed = world.cookbook.primitives_for(target_idx)

    # Current mutable planning state
    cur_pos = env._current_state.pos
    grid = env._current_state.grid.copy()
    actions = []

    def bfs(start, goal):
        """Return a list of actions moving from start to goal.
        Cells with any entity are treated as obstacles, except the goal cell itself."""
        if start == goal:
            return []
        H, W = grid.shape[:2]
        visited = np.zeros((H, W), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:
                    # Allow stepping onto the goal even if occupied
                    if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:
                        continue
                    visited[nx, ny] = True
                    prev[(nx, ny)] = ((x, y), act)
                    if (nx, ny) == goal:
                        # reconstruct path
                        path = []
                        cur = goal
                        while cur != start:
                            (p, a) = prev[cur]
                            path.append(a)
                            cur = p
                        path.reverse()
                        return path
                    q.append((nx, ny))
        return None  # unreachable

    def nearest_entity(pos, kind_idx):
        """Find the nearest cell containing an entity of kind_idx.
        Returns (location, path) where path is a list of actions from pos to location."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        best_path = None
        best_loc = None
        for loc in locations:
            loc_tup = (int(loc[0]), int(loc[1]))
            path = bfs(pos, loc_tup)
            if path is None:
                continue
            if best_path is None or len(path) < len(best_path):
                best_path = path
                best_loc = loc_tup
        return best_loc, best_path

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target, path = nearest_entity(cur_pos, prim_idx)
            if target is None:
                # Primitive not reachable – abort planning
                return actions
            actions.extend(path)
            actions.append(USE)          # pick up the primitive
            cur_pos = target
            # Update planning grid: consume one instance of the primitive
            if grid[target[0], target[1], prim_idx] > 0:
                grid[target[0], target[1], prim_idx] -= 1

    # ------------------------------------------------------------------
    # Move to the workshop (if the recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(target_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos, path = nearest_entity(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions.extend(path)
            actions.append(USE)      # craft at the workshop
            cur_pos = workshop_pos

    return actions

