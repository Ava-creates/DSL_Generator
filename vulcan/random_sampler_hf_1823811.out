            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # allow stepping onto goal even if occupied
                    if not state.grid[ny, nx, :].any() or (ny, nx) == goal:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Move the agent to an absolute position using the BFS planner.
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal actions, state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # cannot find a path
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Locate the nearest cell that contains a given kind index.
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Choose a free cell (including the target itself) adjacent to a cell.
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the cell itself if free
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        # fallback: current position
        return state.pos

    # ------------------------------------------------------------------
    # 1) Collect all primitive resources required for the arrow.
    # ------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                continue  # primitive missing; skip
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj_ws = adjacent_free(ws_pos)
            move_to(adj_ws)
            actions.append(ACT_USE)  # craft at workshop
            env.step(ACT_USE)
            state = env._current_state

    return actions

