    # Reset environment and obtain references
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world                    # CraftWorld instance
    idx = world.cookbook.index           # name ↔ integer id mapping

    # Goal: make an arrow
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive items needed for one arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest path from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Cells occupied by non‑grabbable entities are blocked
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay where we are
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur → nxt into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not to an adjacent cell")

    # ------------------------------------------------------------------
    # Planning: collect primitives then craft at workshop (if needed)
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    used_cells = set()   # avoid targeting the same primitive cell twice

    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            # Find an unused instance of the primitive
            candidates = [loc for loc in find_locations(prim_idx) if loc not in used_cells]
            if not candidates:
                # Primitive might already be in inventory; skip picking
                continue
            # Choose the nearest candidate (Manhattan distance)
            target = min(candidates,
                         key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
            used_cells.add(target)

            # Move to the primitive
            path = bfs_path(cur_pos, target)
            for step in path[1:]:          # skip current position
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick it up
            actions.append(4)               # USE

    # If a workshop is required, move there and craft
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = min(wk_locs,
                         key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)               # USE to craft

    return actions


