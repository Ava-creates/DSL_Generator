    # Reset environment to start fresh
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index and primitive requirements
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Determine workshop (if any) for final crafting
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan move sequence (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing at least one entity of `kind`
    # ------------------------------------------------------------------
    def nearest_cell(kind, from_pos, grid):
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # Work on a mutable copy of the initial grid so we can mark primitives as taken
    grid_copy = scenario.init_grid.copy()

    # ------------------------------------------------------------------
    # Collect all required primitive items
    # ------------------------------------------------------------------
    for kind, count in required.items():
        for _ in range(count):
            target = nearest_cell(kind, cur_pos, grid_copy)
            if target is None:
                # No more of this primitive left on the map; abort collection for this item
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up the primitive
            # Mark the primitive as consumed so we don't try to pick it again
            grid_copy[target[0], target[1], kind] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the final item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to craft at the workshop
    else:
        # No specific workshop: just attempt a USE at current location to trigger crafting
        actions.append(4)

    return actions


