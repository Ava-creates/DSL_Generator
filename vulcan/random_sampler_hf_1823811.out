    # Reset the environment to a fresh start
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Goal we want to achieve
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # How many of each primitive are required for one arrow?
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Determine the workshop (if any) where the arrow must be crafted
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def find_locations(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Translate a step from cur -> nxt into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3  # RIGHT
        if dx == -1:
            return 2  # LEFT
        if dy == 1:
            return 0  # DOWN
        if dy == -1:
            return 1  # UP
        raise ValueError("Attempted to move between non‑adjacent cells")

    def bfs(start, goal):
        """Return a list of positions from start to goal using BFS (including start)."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Cells that cannot be entered (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # If no path found, just stay where we are
        return [start]

    # ----------------------------------------------------------------------
    # Build the action sequence
    # ----------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # --- Collect all required primitives ------------------------------------
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            # Refresh locations after each collection (grid changes)
            locations = find_locations(prim_idx)
            if not locations:
                # Primitive not present; abort early
                continue
            target = locations[0]  # pick the first occurrence
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)  # USE to pick up the primitive

    # --- Move to the workshop (if required) and craft the arrow ------------
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            target = wk_locations[0]
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)  # USE to craft the arrow at the workshop

    return actions


