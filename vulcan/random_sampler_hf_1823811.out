    # Reset environment and obtain handles to state and world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Goal index and primitive requirements for the goal
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Action indices (consistent with CraftLab)
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']
    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    import collections
    import numpy as np

    def find_path(cur_state, target_kind):
        """BFS returning a list of movement actions that leads the agent
        to any cell containing `target_kind`.  The search may step onto
        empty cells or the target cell itself, but avoids other occupied
        cells."""
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # No reachable cell – return empty list (should not happen)
        return []

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for kind_idx, count in required.items():
        for _ in range(count):
            path = find_path(state, kind_idx)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # Pick up the primitive under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # Return the complete action sequence
    return actions


