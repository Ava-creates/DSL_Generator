        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    from collections import deque

    def find_path(cur_state, target_kind):
        """
        Breadth‑first search that returns a list of movement actions which
        brings the agent to a cell containing `target_kind`.  The agent may
        step onto empty cells or directly onto the target cell; all other
        cells are treated as obstacles.
        """
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    # Allow moving onto empty cells or the target cell.
                    if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # If we exit the loop the target is unreachable; return empty path.
        return []

    # ------------------------------------------------------------------
    # 1) Collect every required primitive in the needed quantity.
    # ------------------------------------------------------------------
    for kind, count in required.items():
        for _ in range(count):
            path = find_path(state, kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive.
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Go to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
    # Use the current cell (workshop or just the current location) to craft.
    _, state = state.step(ACTION_USE)
    actions.append(ACTION_USE)

    return actions


