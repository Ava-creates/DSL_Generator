    actions = []

    # Helper to move the agent towards a target coordinate using Manhattan steps
    def move_to(target):
        while env._current_state.pos != target:
            cur_x, cur_y = env._current_state.pos
            tgt_x, tgt_y = target
            if cur_x < tgt_x:
                act = 3  # RIGHT
            elif cur_x > tgt_x:
                act = 2  # LEFT
            elif cur_y < tgt_y:
                act = 0  # DOWN (y grows downwards)
            else:
                act = 1  # UP
            actions.append(act)
            # Execute action; ignore reward/done/obs
            env.step(act)

    # Collect each required primitive the necessary number of times
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate all cells that currently contain this primitive
            grid_layer = env._current_state.grid[:, :, prim_idx]
            ys, xs = np.where(grid_layer > 0)
            if len(xs) == 0:
                raise RuntimeError(f"Primitive {prim_idx} not found on the grid.")
            # Choose the nearest primitive cell (Manhattan distance)
            cur_x, cur_y = env._current_state.pos
            dists = np.abs(xs - cur_x) + np.abs(ys - cur_y)
            nearest_idx = int(np.argmin(dists))
            target_pos = (int(xs[nearest_idx]), int(ys[nearest_idx]))
            # Move to the primitive
            move_to(target_pos)
            # Pick it up using the USE action (index 4)
            actions.append(4)
            env.step(4)

    # After gathering all primitives, move to any workshop cell of the required type
    workshop_layer = env._current_state.grid[:, :, workshop_idx]
    ys, xs = np.where(workshop_layer > 0)
    if len(xs) == 0:
        raise RuntimeError("No workshop of the required type found on the grid.")
    # Choose the nearest workshop
    cur_x, cur_y = env._current_state.pos
    dists = np.abs(xs - cur_x) + np.abs(ys - cur_y)
    nearest_idx = int(np.argmin(dists))
    workshop_pos = (int(xs[nearest_idx]), int(ys[nearest_idx]))
    move_to(workshop_pos)

    # Craft the goal item at the workshop
    actions.append(4)
    env.step(4)

    # Return the complete action sequence
    return actions


    # Simple stochastic planner: keep taking random actions until the task is done
    # or a hard step limit is reached. This works for most CraftWorld levels where
    # the goal is reachable with unrestricted movement and use actions.
    # The environment is assumed to be a CraftLab instance (as described above).

    # Reset the environment to start a fresh episode
    env.reset()
    actions = []
    rng = np.random.RandomState(0)          # deterministic randomness
    max_steps = getattr(env, "max_steps", 500)  # fallback if attribute missing

    # Loop until the environment signals completion or we exceed the step budget
    while not env._is_done() and len(actions) < max_steps:
        act = int(rng.randint(0, 5))        # action IDs: 0‑4 (DOWN, UP, LEFT, RIGHT, USE)
        _, _ = env.step(act)                # step returns (reward, done) but we ignore reward
        actions.append(act)

    return actions

