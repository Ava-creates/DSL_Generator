    import numpy as np
    from collections import deque

    def locate(kind):
        """Return list of (x, y) positions where `kind` is present."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step_action(act):
        """Execute an action and update the local `state`."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def bfs_path(start, target):
        """Shortest path (as list of actions) from start to target."""
        occ = np.any(state.grid > 0, axis=2)
        occ[target] = False  # target cell may be occupied (e.g., workshop)
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []

    def go_to(target):
        """Move to `target`, recording actions."""
        for act in bfs_path(state.pos, target):
            actions.append(act)
            step_action(act)

    actions = []

    # Collect required primitives.
    for kind, req_cnt in needed.items():
        while state.inventory[kind] < req_cnt:
            positions = locate(kind)
            if not positions:
                return actions
            positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            reached = False
            for tgt in positions:
                path = bfs_path(state.pos, tgt)
                if path:
                    go_to(tgt)
                    actions.append(4)   # USE to pick up
                    step_action(4)
                    reached = True
                    break
            if not reached:
                return actions

    # Move to workshop if required and craft.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            ws_positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(ws_positions[0])
            actions.append(4)   # USE to craft
            step_action(4)
    else:
        actions.append(4)       # USE to craft at current location
        step_action(4)

    return actions


    # Reset environment and get handles to state and world configuration.
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world

    # Index of the goal item (arrow) for this episode.
    goal_idx = env.task.goal

    # Primitive requirements for the goal: {kind_index: count}.
    needed = world.cookbook.primitives_for(goal_idx)

    # Determine if the goal must be crafted at a specific workshop.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_name = recipe["_at"]
        workshop_idx = world.cookbook.index[workshop_name]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    import numpy as np
    from collections import deque

    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Return a list of positions (excluding `start`) that leads from `start`
        to `target` using 4‑connected moves, avoiding occupied cells.
        The target cell itself may be occupied (e.g., a workshop) and is
        treated as free for stepping onto it.
        """
        w, h = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)
        occupied[target] = False                # allow stepping onto target
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                npos = (nx, ny)
                if npos in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add(npos)
                q.append((npos, path + [npos]))
        return []  # unreachable

    def follow_path(path):
        """
        Convert a list of positions into actions, append them to `actions`,
        and update the global `state`.
        """
        nonlocal state, actions
        for nxt in path:
            x, y = state.pos
            nx, ny = nxt
            if nx > x:
                act = 3          # RIGHT
            elif nx < x:
                act = 2          # LEFT
            elif ny > y:
                act = 0          # DOWN
            else:
                act = 1          # UP
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1. Collect all required primitives.
    for kind_idx, req_cnt in needed.items():
        while state.inventory[kind_idx] < req_cnt:
            positions = locate(kind_idx)
            if not positions:                     # primitive not on map
                return actions
            # Find shortest reachable instance.
            path = bfs_path(state.pos, positions[0])
            # If the first instance is unreachable, try others.
            if not path:
                # try all positions and keep the shortest reachable one
                best = None
                for pos in positions:
                    p = bfs_path(state.pos, pos)
                    if p and (best is None or len(p) < len(best)):
                        best = p
                path = best if best is not None else []
            if not path:                          # none reachable
                return actions
            follow_path(path)
            # Pick up the primitive.
            actions.append(4)                      # USE
            _, state = state.step(4)

    # 2. Move to required workshop (if any) and craft.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            # Choose the closest workshop.
            ws_positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            path = bfs_path(state.pos, ws_positions[0])
            if path:
                follow_path(path)
    # 3. Perform the crafting action.
    actions.append(4)                               # USE
    _, state = state.step(4)

    return actions

