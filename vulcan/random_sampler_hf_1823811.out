    occupied = np.any(grid > 0, axis=2)        # bool matrix: True where any entity exists

    plan = []                                   # final list of actions to return

    # ----------------------------------------------------------------------
    # Helper: move adjacent to a target cell containing *kind_idx* and USE it
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """
        Move the simulated agent adjacent to *target* and issue a USE action.
        Updates simulated position, grid, occupied matrix and inventory.
        Returns True on success, False if movement is impossible.
        """
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
