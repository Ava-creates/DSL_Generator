    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # target item index (arrow or whatever the task goal is)
    goal_idx = env.task.goal

    # primitive requirements (including transitive) for one goal item
    required = world.cookbook.primitives_for(goal_idx)

    # workshop required for the final crafting step, if any
    recipe = world.cookbook.recipes.get(goal_idx, {})
    wk = recipe.get('_at')
    if wk is None:
        workshop_kind = None
    else:
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan move sequence (action indices)
    #   DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate the nearest unused cell containing the given kind
    # ------------------------------------------------------------------
    harvested: dict[int, set[tuple[int, int]]] = {}

    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        idx = int(np.argmin(dists))
        return candidates[idx]

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # resource not available; skip this instance
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up the primitive
            harvested[kind].add(target)     # mark cell as used

    # ------------------------------------------------------------------
    # Move to workshop if needed, then craft
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
    # final USE to trigger crafting (whether at workshop or elsewhere)
    actions.append(4)

    return actions


    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # index of the goal item (arrow or whatever the task specifies)
    goal_idx = env.task.goal

    # primitive requirements (including transitive) for one unit of the goal
    required = world.cookbook.primitives_for(goal_idx)

    # workshop required for the final crafting step (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    wk = recipe.get('_at')
    workshop_kind = None
    if wk is not None:
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan move sequence (action indices)
    # Encoding: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell containing a given kind that has not
    # been harvested yet.
    # ------------------------------------------------------------------
    harvested: dict[int, set[tuple[int, int]]] = {}

    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        return candidates[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # Collect all required primitive items.
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # primitive not available – skip (task may be impossible)
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up the primitive
            harvested[kind].add(target)     # mark this cell as used

    # ------------------------------------------------------------------
    # If a workshop is required, move to the nearest one.
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)

    # Final USE to trigger crafting of the goal item
    actions.append(4)

    return actions

