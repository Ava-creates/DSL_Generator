    # reset environment and get current state/world references
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # goal definition
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitive requirements for a single arrow (recursively expanded)
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) where `kind` appears on the current grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Return shortest path (list of positions) from start to goal
        avoiding non‑grabbable cells. If no path exists, returns [start]."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # cells occupied by non‑grabbable entities are blocked
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # no reachable path
        return [start]

    def move_action(cur, nxt):
        """Convert a move from cur to adjacent nxt into action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not adjacent")

    # ------------------------------------------------------------------
    # Build action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # 1) Gather all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            # locate remaining instances of this primitive
            locations = find_locations(prim_idx)
            if not locations:
                # nothing left to collect – break to avoid infinite loop
                break

            # pick the nearest one (Manhattan distance heuristic)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )

            # move to the target
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # pick it up
            actions.append(4)   # USE
            # update planning snapshot
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to workshop (if needed) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            target = min(
                wk_locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
        actions.append(4)   # USE to craft at workshop
    else:
        actions.append(4)   # USE to craft at current location

    return actions


