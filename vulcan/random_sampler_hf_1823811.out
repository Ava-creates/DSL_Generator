    # ------------------------------------------------------------
    #  make_arrow_vn – plan a sequence of actions that makes an arrow
    # ------------------------------------------------------------
    # The function works directly on the provided CraftLab environment.
    # It queries the world’s cookbook for the “arrow” recipe, collects
    # the required primitive items, moves to the appropriate workshop,
    # and finally uses the workshop to craft the arrow.
    #
    # The returned list contains integer action IDs that can be fed
    # back to `env.step(action)`.  The function also *executes* each
    # action on the environment while building the plan so that the
    # internal state stays up‑to‑date (grid, inventory, position, …).
    # ------------------------------------------------------------

    import collections
    import numpy as np

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    # Direction vectors and the corresponding action names (as returned by
    # `env.action_specs()`).  The order matches the usual DMLab mapping.
    DIR_VECTORS = {
        "UP":    (0, -1),
        "DOWN":  (0, 1),
        "LEFT":  (-1, 0),
        "RIGHT": (1, 0),
    }

    # ------------------------------------------------------------------
    # Breadth‑first search on the current walkable mask.
    # Returns a list of direction names that lead from `src` to any cell
    # in `targets`.  If several targets are reachable, the closest one
    # (in terms of BFS layers) is chosen.
    # ------------------------------------------------------------------
    def bfs(src, targets, walkable_mask):
        q = collections.deque([src])
        visited = {src: None}                     # maps pos -> (parent, move_name)
        while q:
            cur = q.popleft()
            if cur in targets:
                # reconstruct path
                path = []
                while visited[cur] is not None:
                    parent, move = visited[cur]
                    path.append(move)
                    cur = parent
                path.reverse()
                return path, cur                 # cur is the reached target
            for move_name, (dx, dy) in DIR_VECTORS.items():
                nx, ny = cur[0] + dx, cur[1] + dy
                if (0 <= nx < walkable_mask.shape[0] and
                    0 <= ny < walkable_mask.shape[1] and
                    walkable_mask[nx, ny] and
                    (nx, ny) not in visited):
                    visited[(nx, ny)] = (cur, move_name)
                    q.append((nx, ny))
        # No reachable target
        return None, None

    # ------------------------------------------------------------------
    # Convert a direction name (e.g. "UP") to the integer action ID used by
    # the environment.
    # ------------------------------------------------------------------
    action_id = env.action_specs()          # e.g. {"UP":0, "DOWN":1, ...}
    def act(name):
        return action_id[name]

    # ------------------------------------------------------------------
    # Main planning loop
    # ------------------------------------------------------------------
    actions = []                                 # list to be returned
    world = env.world
    state = env._current_state

    # Goal index (the item we have to craft)
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # 1. Determine which primitive resources are required for the goal.
    # ------------------------------------------------------------------
    # `primitives_for` returns a dict {primitive_idx: count_needed}.
    needed_primitives = world.cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # 2. Repeatedly collect missing primitives.
    # ------------------------------------------------------------------
    while True:
        # recompute missing amounts from the *current* inventory
        inv = state.inventory
        missing = {}
        for prim_idx, cnt in needed_primitives.items():
            have = int(inv[prim_idx])
            if have < cnt:
                missing[prim_idx] = cnt - have

        if not missing:                     # all primitives are present
            break

        # pick the first missing primitive (any order works)
        prim_idx, need_cnt = next(iter(missing.items()))

        # locate all cells that still contain this primitive
        prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
        if prim_cells.size == 0:
            raise RuntimeError("Required primitive not found in the grid.")

        # choose the closest primitive cell (Manhattan distance as heuristic)
        cur_pos = state.pos
        dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
        target_cell = tuple(prim_cells[dists.argmin()])

        # ------------------------------------------------------------------
        # 3. Find a walkable neighbour of the primitive that lets us face it
        #    after the last move (so that a single USE picks it up).
        # ------------------------------------------------------------------
        neigh_candidates = {}
        for move_name, (dx, dy) in DIR_VECTORS.items():
            cand = (target_cell[0] - dx, target_cell[1] - dy)   # cell we must step into
            if (0 <= cand[0] < state.grid.shape[0] and
                0 <= cand[1] < state.grid.shape[1]):
                # cell must be empty (walkable)
                if state.grid[cand[0], cand[1]].sum() == 0:
                    neigh_candidates[cand] = move_name

        if not neigh_candidates:
            raise RuntimeError("No accessible neighbour for primitive at %s" % (target_cell,))

        # ------------------------------------------------------------------
        # 4. Run BFS to the nearest reachable neighbour.
        # ------------------------------------------------------------------
        walkable = (state.grid.sum(axis=2) == 0)
        path, reached = bfs(cur_pos, set(neigh_candidates.keys()), walkable)
        if path is None:
            raise RuntimeError("Cannot reach primitive at %s" % (target_cell,))

        # Execute the movement actions
        for mv in path:
            actions.append(act(mv))
            _, _, _ = env.step(act(mv))
            state = env._current_state

        # After the moves we are on `reached`; the direction we just took
        # points towards the primitive, so a single USE will collect it.
        actions.append(act("USE"))
        _, _, _ = env.step(act("USE"))
        state = env._current_state

    # ------------------------------------------------------------------
    # 5. All primitives are in inventory – move to the appropriate workshop
    #    and use it to craft the arrow.
    # ------------------------------------------------------------------
    # The workshop name is stored under the special key "_at" in the recipe.
    recipe = world.cookbook.recipes[goal_idx]
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        raise RuntimeError("Goal recipe does not specify a workshop.")

    workshop_idx = world.cookbook.index[workshop_name]

    # locate any workshop cell of the required type
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        raise RuntimeError("Workshop '%s' not found in the grid." % workshop_name)
    workshop_cell = tuple(workshop_cells[0])

    # find a walkable neighbour that lets us face the workshop
    neigh_candidates = {}
    for move_name, (dx, dy) in DIR_VECTORS.items():
        cand = (workshop_cell[0] - dx, workshop_cell[1] - dy)
        if (0 <= cand[0] < state.grid.shape[0] and
            0 <= cand[1] < state.grid.shape[1] and
            state.grid[cand[0], cand[1]].sum() == 0):
            neigh_candidates[cand] = move_name

    if not neigh_candidates:
        raise RuntimeError("No accessible neighbour for workshop at %s" % (workshop_cell,))

    # BFS to the nearest neighbour
    walkable = (state.grid.sum(axis=2) == 0)
    cur_pos = state.pos
    path, reached = bfs(cur_pos, set(neigh_candidates.keys()), walkable)
    if path is None:
        raise RuntimeError("Cannot reach workshop at %s" % (workshop_cell,))

    # Move to the neighbour
    for mv in path:
        actions.append(act(mv))
        _, _, _ = env.step(act(mv))
        state = env._current_state

    # Use the workshop to craft the arrow
    actions.append(act("USE"))
    _, _, _ = env.step(act("USE"))
    state = env._current_state

    # ------------------------------------------------------------------
    # 6. Return the complete action list.
    # ------------------------------------------------------------------
    return actions


    import numpy as np
    from collections import deque

    # Helper: map delta to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)
    _delta_to_action = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }

    # ------------------------------------------------------------------
    # Basic utilities working directly on the internal CraftState
    # ------------------------------------------------------------------
    def _is_free(grid, x, y):
        """A cell is free if it contains no entities."""
        return grid[x, y, :].sum() == 0

    def _neighbors(pos, width, height):
        x, y = pos
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nx, ny = x + dx, y + dy
            if 0 <= nx < width and 0 <= ny < height:
                yield (nx, ny), (dx, dy)

    def _bfs_path(grid, start, goal_cond):
        """
        Breadth‑first search returning a list of actions that moves the agent
        from ``start`` to any cell satisfying ``goal_cond``.
        ``goal_cond`` receives a position tuple (x, y) and returns True/False.
        """
        width, height = grid.shape[0], grid.shape[1]
        q = deque()
        q.append(start)
        came_from = {start: None}
        move_from = {start: None}   # store (dx,dy) taken to reach a node

        while q:
            cur = q.popleft()
            if goal_cond(cur):
                # reconstruct path
                actions = []
                while came_from[cur] is not None:
                    dx, dy = move_from[cur]
                    actions.append(_delta_to_action[(dx, dy)])
                    cur = came_from[cur]
                actions.reverse()
                return actions
            for nxt, delta in _neighbors(cur, width, height):
                if nxt not in came_from and _is_free(grid, *nxt):
                    came_from[nxt] = cur
                    move_from[nxt] = delta
                    q.append(nxt)
        # No path found – return empty list (will cause failure later)
        return []

    # ------------------------------------------------------------------
    # Begin planning
    # ------------------------------------------------------------------
    # Access the current internal state of the environment
    state = env._current_state          # type: CraftState
    world = env.world                   # type: CraftWorld
    goal_idx = env.task.goal            # integer index of the desired item

    # Required primitive counts for the goal
    needed_prims = world.cookbook.primitives_for(goal_idx).copy()  # {prim_idx: count}
    # Recipe for the goal (to locate the workshop)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')   # may be None for primitive goals

    # Working copies that we update as we simulate actions
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    cur_pos = tuple(state.pos)

    actions_plan = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in needed_prims.items():
        while inventory[prim_idx] < required_cnt:
            # Locate all cells that currently contain this primitive
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more primitives left on the map – cannot continue
                return actions_plan
            # Choose the closest one (Manhattan distance)
            distances = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
            target_cell = tuple(prim_cells[distances.argmin()])

            # Move to the primitive cell
            move_actions = _bfs_path(grid, cur_pos, lambda p, t=target_cell: p == t)
            actions_plan.extend(move_actions)
            cur_pos = target_cell

            # Use (collect) the primitive
            actions_plan.append(4)   # USE action
            # Simulate the effect on our local copies
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Go to the appropriate workshop and craft the item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        # Find all workshop locations
        workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
        if workshop_cells.size == 0:
            # No workshop on the map – cannot craft
            return actions_plan

        # Determine a free cell adjacent (including orthogonal neighbours) to any workshop
        width, height = grid.shape[0], grid.shape[1]
        best_path = None
        best_target = None
        for wx, wy in workshop_cells:
            # Examine the four neighbouring cells (including the workshop cell itself if free)
            candidates = [(wx, wy)] + [(wx + dx, wy + dy) for dx, dy in [(-1,0),(1,0),(0,-1),(0,1)]]
            for cx, cy in candidates:
                if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):
                    # Path to this candidate
                    path = _bfs_path(grid, cur_pos, lambda p, t=(cx, cy): p == t)
                    if best_path is None or len(path) < len(best_path):
                        best_path = path
                        best_target = (cx, cy)

        if best_path is None:
            # No reachable workshop adjacency – give up
            return actions_plan

        # Move to the chosen adjacent cell
        actions_plan.extend(best_path)
        cur_pos = best_target

        # Use (craft) at the workshop
        actions_plan.append(4)   # USE action

    # ------------------------------------------------------------------
    # Return the complete action list
    # ------------------------------------------------------------------
    return actions_plan

