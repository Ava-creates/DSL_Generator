    import collections
    import numpy as np

    # Reset the environment and obtain core objects.
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Goal index and its primitive requirements.
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Mapping from action names to integer indices.
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    # Direction vectors paired with their corresponding action ids.
    move_dirs = [
        (1, 0, ACTION_DOWN),   # down
        (-1, 0, ACTION_UP),    # up
        (0, -1, ACTION_LEFT),  # left
        (0, 1, ACTION_RIGHT)   # right
    ]

    actions = []

    def find_path(cur_state, target_kind):
        """
        Bread‑first search returning a list of movement actions that brings the
        agent to a cell containing `target_kind`. The agent may step onto empty
        cells or directly onto the target cell; other occupied cells are treated
        as obstacles.
        """
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow stepping onto empty cells or the target cell itself.
                if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        # No path found (should not happen in a well‑formed scenario).
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources for the goal.
    # ------------------------------------------------------------------
    for prim_kind, count in required.items():
        for _ in range(count):
            path_to_prim = find_path(state, prim_kind)
            for act in path_to_prim:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive now under the agent.
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path_to_ws = find_path(state, workshop_kind)
        for act in path_to_ws:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the item.
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # Return the complete action sequence.
    return actions


