    # Action indices (assumed standard)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # Direction vectors matching the action indices
    DIRS = {
        DOWN: (1, 0),
        UP: (-1, 0),
        LEFT: (0, -1),
        RIGHT: (0, 1),
    }

    # ------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of actions from src→dst
    # ------------------------------------------------------------------
    def bfs_path(src, dst, grid):
        """Return a list of actions (indices) moving from src to dst avoiding
        any occupied cell (any non‑zero kind) except the destination cell.
        If no path exists, returns an empty list."""
        if src == dst:
            return []
        h, w, _ = grid.shape
        q = collections.deque()
        q.append(src)
        visited = {src: (None, None)}  # node -> (parent, action_to_here)
        while q:
            x, y = q.popleft()
            for act, (dx, dy) in DIRS.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < h and 0 <= ny < w:
                    if (nx, ny) in visited:
                        continue
                    # Allow stepping onto the destination even if occupied
                    if (nx, ny) != dst and grid[nx, ny].any():
                        continue
                    visited[(nx, ny)] = ((x, y), act)
                    if (nx, ny) == dst:
                        # reconstruct path
                        path = []
                        cur = (nx, ny)
                        while visited[cur][0] is not None:
                            parent, a = visited[cur]
                            path.append(a)
                            cur = parent
                        return list(reversed(path))
                    q.append((nx, ny))
        # no path found
        return []

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell (by BFS distance) containing a kind
    # ------------------------------------------------------------------
    def nearest_cell(pos, kind_idx, grid):
        """Return coordinates of the nearest cell containing `kind_idx`.
        Uses BFS distance (Manhattan with obstacles). Returns None if not found."""
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        # Simple heuristic: choose the cell with smallest Manhattan distance,
        # then verify a path exists; fallback to brute‑force BFS search.
        best = None
        best_dist = None
        for c in cells:
            manh = abs(c[0] - pos[0]) + abs(c[1] - pos[1])
            if best_dist is None or manh < best_dist:
                best = tuple(c.tolist())
                best_dist = manh
        # Ensure a path exists; if not, try others
        path = bfs_path(pos, best, grid)
        if path:
            return best
        # fallback: try all cells until a reachable one is found
        for c in cells:
            cand = tuple(c.tolist())
            if bfs_path(pos, cand, grid):
                return cand
        return None

    # ------------------------------------------------------------------
    # Gather recipe information for the target item "arrow"
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}
    # Copy current grid for planning (will be updated as we "pick up" items)
    planning_grid = env._current_state.grid.copy()
    cur_pos = env._current_state.pos
    plan_actions = []

    # ------------------------------------------------------------------
    # 1. Collect each required primitive in any order
    # ------------------------------------------------------------------
    for prim_idx, amount in primitives_needed.items():
        for _ in range(amount):
            target = nearest_cell(cur_pos, prim_idx, planning_grid)
            if target is None:
                # Primitive not present – abort planning
                return plan_actions
            path = bfs_path(cur_pos, target, planning_grid)
            plan_actions.extend(path)
            cur_pos = target
            plan_actions.append(USE)  # pick up the primitive
            # Update planning grid: primitive is removed after pickup
            planning_grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if required) and craft
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes.get(arrow_idx, {}).get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = nearest_cell(cur_pos, workshop_idx, planning_grid)
        if workshop_pos is not None:
            path = bfs_path(cur_pos, workshop_pos, planning_grid)
            plan_actions.extend(path)
            cur_pos = workshop_pos
            plan_actions.append(USE)  # craft at the workshop

    return plan_actions

