    # Reset environment to a clean start if possible.
    try:
        env.reset()
    except Exception:
        pass

    actions = []

    # Identify the goal item index from the environment/task.
    goal_idx = None
    if hasattr(env, "task"):
        task = getattr(env, "task")
        if hasattr(task, "goal"):
            goal_idx = task.goal
        elif isinstance(task, (list, tuple)):
            goal_idx = task[0]

    if goal_idx is None:
        return actions

    # Primitive requirements for the target item.
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    # Current simulated position and a mutable copy of the grid.
    cur_pos = list(env._current_state.pos)
    grid = env._current_state.grid.copy()

    # Helper to generate movement actions (Manhattan) and update cur_pos.
    def move_to(target):
        nonlocal cur_pos
        act = []
        tx, ty = target
        # x corresponds to first dimension (horizontal), y to second (vertical)
        while cur_pos[0] < tx:
            act.append(3)          # RIGHT
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            act.append(2)          # LEFT
            cur_pos[0] -= 1
        while cur_pos[1] < ty:
            act.append(0)          # DOWN
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            act.append(1)          # UP
            cur_pos[1] -= 1
        return act

    # Collect each primitive the required number of times.
    for kind_idx, count in primitives_needed.items():
        needed = count
        while needed > 0:
            # Locate all cells that currently contain this primitive.
            positions = np.argwhere(grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                # No more of this primitive on the map; abort collection.
                break
            # Choose the first available position (could be improved with nearest).
            target = tuple(positions[0])
            actions.extend(move_to(target))
            actions.append(4)          # USE to pick up
            # Simulate removal of the primitive from the grid.
            grid[target[0], target[1], kind_idx] = 0
            needed -= 1

    # After gathering primitives, move to the appropriate workshop (if any) and craft.
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
        if ws_positions.shape[0] > 0:
            ws_target = tuple(ws_positions[0])
            actions.extend(move_to(ws_target))
            actions.append(4)          # USE to craft at workshop

    return actions


    # Reset environment to a known state and obtain the initial state.
    try:
        env.reset()
    except Exception:
        pass

    actions = []

    # Identify the goal index from the environment's task.
    goal_idx = None
    if hasattr(env, "task"):
        task = getattr(env, "task")
        if hasattr(task, "goal"):
            goal_idx = task.goal
        elif isinstance(task, (list, tuple)):
            goal_idx = task[0]

    if goal_idx is None:
        return actions

    # Determine primitive requirements for the goal.
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    # Current agent position (mutable copy).
    cur_pos = list(env._current_state.pos)

    def move_to(target):
        """Generate actions to move from cur_pos to target (x, y)."""
        nonlocal cur_pos
        act_seq = []
        tx, ty = target
        # Move in x direction.
        while cur_pos[0] < tx:
            act_seq.append(3)          # RIGHT
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            act_seq.append(2)          # LEFT
            cur_pos[0] -= 1
        # Move in y direction.
        while cur_pos[1] < ty:
            act_seq.append(0)          # DOWN
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            act_seq.append(1)          # UP
            cur_pos[1] -= 1
        return act_seq

    # Helper to track which primitive cells have already been used.
    used_cells = set()

    # Collect each required primitive.
    grid = env._current_state.grid
    for kind_idx, count in primitives_needed.items():
        # Find all locations of this primitive kind.
        positions = [tuple(pos) for pos in np.argwhere(grid[:, :, kind_idx] > 0)]
        pos_idx = 0
        while count > 0 and pos_idx < len(positions):
            cell = positions[pos_idx]
            if cell in used_cells:
                pos_idx += 1
                continue
            # Move to the primitive and pick it up.
            actions.extend(move_to(cell))
            actions.append(4)          # USE to collect
            used_cells.add(cell)
            count -= 1
            pos_idx += 1

    # After gathering primitives, move to the workshop (if any) and craft.
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        # Locate a workshop cell of the required type.
        ws_positions = [tuple(p) for p in np.argwhere(grid[:, :, workshop_kind] > 0)]
        if ws_positions:
            target_ws = ws_positions[0]
            actions.extend(move_to(target_ws))
            actions.append(4)          # USE to craft

    return actions

