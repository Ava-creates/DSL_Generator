                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst):
        """Return actions to move from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(src, dst)
        if path is None:
            # fallback: simple Manhattan moves (may collide with obstacles)
            actions = []
            x, y = src
            tx, ty = dst
            dx = tx - x
            dy = ty - y
            if dx > 0:
                actions += [DOWN] * dx
            elif dx < 0:
                actions += [UP] * (-dx)
            if dy > 0:
                actions += [RIGHT] * dy
            elif dy < 0:
                actions += [LEFT] * (-dy)
            return actions
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx):
        """Find the nearest cell (Manhattan distance) containing the given kind."""
        grid = env._current_state.grid
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # Primitive not present – abort planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if specified) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions


    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # Index of the target item “arrow”
    arrow_idx = world.cookbook.index.index('arrow')
    # Primitive requirements for one arrow (primitive_kind_idx -> count)
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _is_occupied(pos, grid):
        """Return True if any entity occupies the cell."""
        x, y = pos
        return grid[x, y, :].any()

    def _bfs_path(start, goal, grid):
        """Return a list of positions from start to goal using BFS.
        The goal cell is considered traversable even if occupied.
        """
        if start == goal:
            return [start]
        width, height = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        # Allow stepping onto the goal even if occupied
                        if not _is_occupied(nxt, grid) or nxt == goal:
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, grid):
        """Compute actions to move from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(src, dst, grid)
        if path is None:
            # fallback: simple Manhattan moves (may hit obstacles)
            actions = []
            x, y = src
            tx, ty = dst
            dx = tx - x
            dy = ty - y
            if dx > 0:
                actions += [DOWN] * dx
            elif dx < 0:
                actions += [UP] * (-dx)
            if dy > 0:
                actions += [RIGHT] * dy
            elif dy < 0:
                actions += [LEFT] * (-dy)
            return actions
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx, grid, excluded):
        """Find the nearest cell containing `kind_idx` that is not in `excluded`."""
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        # filter out excluded positions
        if excluded:
            mask = np.array([tuple(c) not in excluded for c in coords])
            coords = coords[mask]
            if coords.size == 0:
                return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    # Keep track of positions already harvested for each kind
    consumed = {}

    for prim_idx, count in primitives_needed.items():
        consumed.setdefault(prim_idx, set())
        for _ in range(count):
            target = _nearest_kind(cur_pos, prim_idx,
                                   env._current_state.grid,
                                   consumed[prim_idx])
            if target is None:
                # Primitive not available – abort planning
                return actions
            actions += _move_actions(cur_pos, target,
                                     env._current_state.grid)
            cur_pos = target
            actions.append(USE)   # pick up primitive
            consumed[prim_idx].add(target)   # mark as taken

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        target_ws = _nearest_kind(cur_pos, workshop_idx,
                                  env._current_state.grid, set())
        if target_ws is not None:
            actions += _move_actions(cur_pos, target_ws,
                                     env._current_state.grid)
            cur_pos = target_ws
            actions.append(USE)   # craft at workshop

    return actions

