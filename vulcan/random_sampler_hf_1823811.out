    # ----------------------------------------------------------------------
    # Helper functions for movement and action generation
    # ----------------------------------------------------------------------
    def _move_to(pos, target):
        """Return a list of actions that moves from pos to target using Manhattan steps.
        Assumes actions: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT."""
        actions = []
        x, y = pos
        tx, ty = target
        while x < tx:
            actions.append(3)   # RIGHT
            x += 1
        while x > tx:
            actions.append(2)   # LEFT
            x -= 1
        while y < ty:
            actions.append(0)   # DOWN
            y += 1
        while y > ty:
            actions.append(1)   # UP
            y -= 1
        return actions, (x, y)

    # ----------------------------------------------------------------------
    # Initialise environment state (grid, position, etc.)
    # ----------------------------------------------------------------------
    # Reset the environment to obtain a fresh state (if not already reset)
    try:
        env.reset()
    except Exception:
        pass  # ignore if the environment does not expose reset

    # Access underlying scenario / world objects
    scenario = getattr(env, "scenario", None)
    world = getattr(env, "world", None)
    if scenario is None or world is None:
        # Fallback to attributes that may exist on the env directly
        scenario = getattr(env, "scn", None)
        world = getattr(env, "wrld", None)

    # Starting position (agent's initial location)
    pos = tuple(scenario.init_pos) if scenario is not None else (0, 0)

    # Initial grid layout (allocentric view)
    grid = np.array(scenario.init_grid, copy=True)

    # ----------------------------------------------------------------------
    # Determine the goal index for the "arrow" item
    # ----------------------------------------------------------------------
    # Prefer the goal that the environment was created with; otherwise look it up by name.
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        # Use the cookbook index for the name "arrow"
        goal_idx = world.cookbook.index["arrow"]

    # ----------------------------------------------------------------------
    # Determine which primitive resources are required to craft the arrow
    # ----------------------------------------------------------------------
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}
    # If the recipe is empty (no primitive requirement) just go to the workshop.
    if not primitives_needed:
        primitives_needed = {}

    # ----------------------------------------------------------------------
    # Locate all occurrences of each required primitive on the map
    # ----------------------------------------------------------------------
    primitive_locs = {}
    for kind in primitives_needed.keys():
        ys, xs = np.where(grid[:, :, kind] > 0)  # note: grid is (W, H, K)
        primitive_locs[kind] = list(zip(xs.tolist(), ys.tolist()))

    # ----------------------------------------------------------------------
    # Locate the workshop(s) where the arrow can be crafted.
    # The workshop kind is stored in the recipe under the special key "_at".
    # ----------------------------------------------------------------------
    recipe_info = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe_info.get("_at", None)
    workshop_positions = []
    if workshop_kind is not None:
        wy, wx = np.where(grid[:, :, workshop_kind] > 0)
        workshop_positions = list(zip(wx.tolist(), wy.tolist()))
    # If no explicit workshop is found, fall back to any cell (should still work)
    if not workshop_positions:
        # Choose the current position as a dummy workshop location
        workshop_positions = [pos]

    # ----------------------------------------------------------------------
    # Build the action sequence
    # ----------------------------------------------------------------------
    actions = []

    # Helper to pop the nearest location of a given kind
    def _pop_nearest(current_pos, locs):
        if not locs:
            return None
        # Compute Manhattan distances
        dists = [abs(current_pos[0] - x) + abs(current_pos[1] - y) for (x, y) in locs]
        idx = int(np.argmin(dists))
        return locs.pop(idx)

    # Collect each required primitive the required number of times
    for kind, count in primitives_needed.items():
        for _ in range(count):
            target = _pop_nearest(pos, primitive_locs[kind])
            if target is None:
                # No more instances of this primitive; give up early
                continue
            # Move to the primitive cell
            move_actions, pos = _move_to(pos, target)
            actions.extend(move_actions)
            # Pick it up
            actions.append(4)  # USE
            # Update grid to reflect that the item has been taken
            grid[target[0], target[1], kind] = 0

    # After collecting all primitives, go to the nearest workshop and craft
    workshop_target = _pop_nearest(pos, workshop_positions)
    if workshop_target is not None:
        move_actions, pos = _move_to(pos, workshop_target)
        actions.extend(move_actions)
        actions.append(4)  # USE to craft the arrow

    # Return the complete action list
    return actions


    # Reset the environment to obtain the initial state and task information
    _ = env.reset()
    # Mapping from action name to integer code
    act_map = env.action_specs()
    # Shortcuts for movement directions
    moves = [
        (1, 0, "DOWN"),
        (-1, 0, "UP"),
        (0, 1, "RIGHT"),
        (0, -1, "LEFT"),
    ]

    # Helper: Bread‑first search to an empty cell adjacent to a target cell
    def bfs_to_adjacent(start, target, occ):
        tr, tc = target
        # all empty neighbours of the target that can be stood on
        goal_cells = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occ.shape[0]
            and 0 <= tc + dc < occ.shape[1]
            and not occ[tr + dr, tc + dc]
        ]
        if not goal_cells:
            return []  # no reachable adjacent cell
        from collections import deque

        q = deque([start])
        parent = {start: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if cur in goal_cells:
                # reconstruct path of action names
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path
            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ.shape[0]
                    and 0 <= nc < occ.shape[1]
                    and not occ[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # no path found

    # Shortcut to translate a direction name to a movement delta
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    # Access world, scenario and goal information
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal  # integer index of the desired item

    # Recipe information: required primitives and workshop location
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Working copies of the grid and occupancy mask
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell

    # Current agent state
    cur_pos = scenario.init_pos  # (row, col)

    # Accumulated action list to be returned
    actions = []

    # ----------------------------------------------------------------------
    # Helper to move the agent along a list of direction names
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ----------------------------------------------------------------------
    # Collect each required primitive the needed number of times
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # locate all remaining instances of this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # nothing left – break early
                break
            # pick the closest instance (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )
            # move to an empty neighbour of the target
            path = bfs_to_adjacent(cur_pos, target, occ)
            execute_path(path)
            # now we are adjacent; issue USE to pick up the primitive
            actions.append(act_map["USE"])
            # update grid/occupancy: the primitive disappears
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the goal item
    if workshop_idx is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if not workshop_cells:
            # fall back to the original scenario grid if the workshop was removed
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))
            )
        if workshop_cells:
            target = workshop_cells[0]  # any workshop will do
            path = bfs_to_adjacent(cur_pos, target, occ)
            execute_path(path)
            # craft by using the workshop
            actions.append(act_map["USE"])

    # Return the compiled action sequence
    return actions

