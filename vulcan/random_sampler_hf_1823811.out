    """Plan a sequence of actions that collects the required primitives and
    crafts an arrow (or any goal item) in the given CraftLab environment."""
    import numpy as np
    from collections import deque

    # Start a fresh episode.
    env.reset()
    state = env._current_state      # CraftState
    world = env.world

    # Index of the goal item (arrow in the usual tasks).
    goal_idx = env.task.goal

    # Primitive requirements for one unit of the goal.
    needed = world.cookbook.primitives_for(goal_idx).copy()

    # Determine if the final crafting must happen at a specific workshop.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = world.cookbook.index[recipe["_at"]]

    actions = []

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step(act):
        """Execute an action, updating the local `state`."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def bfs(start, target):
        """Bread‑first search returning a list of movement actions from start to target."""
        occ = np.any(state.grid > 0, axis=2)          # occupied cells
        occ[target] = False                           # allow stepping onto the target
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)),   # DOWN
                                  (1, (0, -1)),  # UP
                                  (2, (-1, 0)),  # LEFT
                                  (3, (1, 0))):  # RIGHT
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return []  # No path found.

    def go_to(coord):
        """Move the agent to `coord`, recording actions."""
        for act in bfs(state.pos, coord):
            actions.append(act)
            step(act)

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, required_cnt in needed.items():
        while state.inventory[kind] < required_cnt:
            positions = locate(kind)
            if not positions:
                # Primitive not found; abort planning.
                return actions
            # Choose the nearest occurrence to reduce travel.
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            actions.append(4)            # USE to pick up the primitive.
            step(4)

    # ------------------------------------------------------------------
    # 2. Go to the required workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
            actions.append(4)            # USE to craft at the workshop.
            step(4)
    else:
        # No specific workshop – attempt to craft at the current location.
        actions.append(4)
        step(4)

    return actions


    # Reset environment and obtain current state/world.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index and required primitive counts.
    goal_idx = env.task.goal
    needed = world.cookbook.primitives_for(goal_idx).copy()

    # Determine workshop (if any) required for crafting this goal.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_idx = world.cookbook.index[recipe["_at"]]

    # Imports for helper utilities.
    import numpy as np
    from collections import deque

    actions = []   # List of action indices to be returned.

    # ------------------------------------------------------------------
    # Helper functions.
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) positions where `kind` exists on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step_action(act):
        """Execute an action, updating the local `state`."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def bfs_path(start, target):
        """Bread‑first search returning a list of movement actions from `start` to `target`."""
        occ = np.any(state.grid > 0, axis=2)          # Blocked cells.
        # Allow stepping onto the target even if currently occupied.
        if 0 <= target[0] < occ.shape[0] and 0 <= target[1] < occ.shape[1]:
            occ[target[0], target[1]] = False
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []   # No path found.

    def go_to(target):
        """Move the agent to `target`, recording actions."""
        for act in bfs_path(state.pos, target):
            actions.append(act)
            step_action(act)

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, req_cnt in needed.items():
        while state.inventory[kind] < req_cnt:
            positions = locate(kind)
            if not positions:
                # Primitive not present; abort planning.
                return actions
            # Choose nearest primitive (Manhattan distance).
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the primitive.
            actions.append(4)          # USE action.
            step_action(4)

    # ------------------------------------------------------------------
    # 2. Go to workshop (if required) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
    # Use action to trigger crafting (whether at workshop or current cell).
    actions.append(4)
    step_action(4)

    return actions

