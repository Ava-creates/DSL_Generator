    """Generate a sequence of actions to craft an arrow in the given CraftWorld environment."""
    # Reset the environment to a clean start
    env.reset()
    state = env._current_state

    # Determine the goal index for the arrow item
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index["arrow"]

    # Primitive requirements for the goal (arrow)
    primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Map action names to integer codes
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # -------------------------------------------------------------------------
    # Helper: move the agent to an absolute grid position (ignoring obstacles)
    # -------------------------------------------------------------------------
    def move_to(target_pos):
        nonlocal actions, state
        while state.pos != target_pos:
            y, x = state.pos
            ty, tx = target_pos
            if y < ty:
                act = ACT_DOWN
            elif y > ty:
                act = ACT_UP
            elif x < tx:
                act = ACT_RIGHT
            else:
                act = ACT_LEFT
            actions.append(act)
            _, _, _ = env.step(act)          # ignore reward/done/obs
            state = env._current_state

    # -------------------------------------------------------------------------
    # Helper: locate the nearest cell that contains a given kind index
    # -------------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    dist = abs(i - state.pos[0]) + abs(j - state.pos[1])
                    if best_dist is None or dist < best_dist:
                        best_dist = dist
                        best = (i, j)
        return best

    # -------------------------------------------------------------------------
    # Helper: given a target cell, pick an adjacent free cell (or stay if none)
    # -------------------------------------------------------------------------
    def adjacent_free(target):
        grid = state.grid
        h, w, _ = grid.shape
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = target[0] + dy, target[1] + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not grid[ny, nx, :].any():
                        return (ny, nx)
        return target

    # -------------------------------------------------------------------------
    # Collect all required primitives
    # -------------------------------------------------------------------------
    for kind_idx, needed in primitives.items():
        for _ in range(needed):
            pos = find_nearest(kind_idx)
            if pos is None:
                # Primitive not present; cannot continue
                continue
            adj = adjacent_free(pos)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # -------------------------------------------------------------------------
    # Move to the appropriate workshop and craft the goal item
    # -------------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(workshop_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            move_to(adj)
            actions.append(ACT_USE)          # use at workshop to craft
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    return actions


    env.reset()
    state = env._current_state

    # Determine goal index for "arrow"
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index["arrow"]

    # Primitive requirements for the goal
    primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Action spec mapping
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    # Direction ↔ action helpers
    delta_to_act = {
        (1, 0): ACT_DOWN,
        (-1, 0): ACT_UP,
        (0, -1): ACT_LEFT,
        (0, 1): ACT_RIGHT,
    }

    actions = []

    # -------------------------------------------------------------------------
    # Helper: BFS pathfinding on the current grid (ignoring the target cell)
    # -------------------------------------------------------------------------
    def bfs(start, goal):
        """Return a list of actions to move from start to goal (both free cells)."""
        from collections import deque

        h, w, _ = state.grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev = {}
        q = deque()
        q.append(start)
        visited[start] = True

        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:
                    # allow stepping onto the goal even if it is occupied
                    if not state.grid[ny, nx, :].any() or (ny, nx) == goal:
                        visited[ny, nx] = True
                        prev[(ny, nx)] = (y, x)
                        q.append((ny, nx))

        if start == goal:
            return []

        if goal not in prev:
            # No path found – return empty list (will be ignored)
            return []

        # Reconstruct actions
        path_actions = []
        cur = goal
        while cur != start:
            p = prev[cur]
            dy, dx = cur[0] - p[0], cur[1] - p[1]
            path_actions.append(delta_to_act[(dy, dx)])
            cur = p
        path_actions.reverse()
        return path_actions

    # -------------------------------------------------------------------------
    # Helper: move agent to a free target cell using BFS
    # -------------------------------------------------------------------------
    def move_to(target):
        nonlocal actions, state
        for act in bfs(state.pos, target):
            actions.append(act)
            _, _, _ = env.step(act)
            state = env._current_state

    # -------------------------------------------------------------------------
    # Helper: locate the nearest cell containing a given kind index
    # -------------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    dist = abs(i - py) + abs(j - px)
                    if best_dist is None or dist < best_dist:
                        best_dist = dist
                        best = (i, j)
        return best

    # -------------------------------------------------------------------------
    # Helper: pick a free cell adjacent (including diagonal) to a given cell
    # -------------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the cell itself if it is free
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        # Fallback: stay where we are
        return state.pos

    # -------------------------------------------------------------------------
    # Collect all required primitives
    # -------------------------------------------------------------------------
    for kind_idx, needed in primitives.items():
        for _ in range(needed):
            pos = find_nearest(kind_idx)
            if pos is None:
                continue  # primitive not present – skip
            adj = adjacent_free(pos)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # -------------------------------------------------------------------------
    # Move to the workshop (if any) and craft the goal item
    # -------------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(workshop_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    return actions

