    from collections import deque
    import numpy as np

    def _bfs_path(start, target):
        """Return a list of movement actions from start to target,
        allowing the target cell to be occupied."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].any():
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # No path found.
        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def _nearest_cell(cells, start):
        """Pick the cell with smallest Manhattan distance to start."""
        best = None
        best_dist = None
        for r, c in cells:
            d = abs(r - start[0]) + abs(c - start[1])
            if best is None or d < best_dist:
                best = (r, c)
                best_dist = d
        return best

    # Identify the goal item.
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []
    goal_idx = idx[goal_name]

    # Determine which primitive resources are required.
    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitive items.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate all cells currently holding this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present; abort early.
                return actions
            # Choose the nearest occurrence.
            target = _nearest_cell(prim_cells, state.pos)
            # Move to that cell.
            move_seq = _bfs_path(state.pos, target)
            actions.extend(move_seq)
            state.pos = target
            # Pick it up.
            actions.append(USE)
            tr, tc = target
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions
    workshop_idx = idx[workshop_name]

    # Find a workshop cell (any will do; pick the closest).
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions
    workshop_target = _nearest_cell(workshop_cells, state.pos)

    move_seq = _bfs_path(state.pos, workshop_target)
    actions.extend(move_seq)
    state.pos = workshop_target

    # Craft the arrow.
    actions.append(USE)

    return actions

