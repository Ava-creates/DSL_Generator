    def _is_walkable(grid, pos, allow_kinds=None):
        """Return True if `pos` is traversable.
        All occupied cells block movement except those whose kind is in `allow_kinds`."""
        x, y = pos
        cell = grid[x, y, :]
        if allow_kinds is None:
            # no exceptions – any occupied cell blocks movement
            return not cell.any()
        # cell may contain only allowed kinds (or be empty)
        mask = np.isin(np.arange(cell.shape[0]), list(allow_kinds))
        # keep only the allowed entries
        allowed = cell * mask
        # walkable if after removing allowed entries nothing remains
        return not (cell - allowed).any()

    def _bfs_path(grid, start, goal, allow_kinds=None):
        """Shortest 4‑connected path from start to goal while respecting walkability.
        Returns list of positions including both ends, or None if unreachable."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(grid, nxt, allow_kinds):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # unreachable

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of adjacent positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

