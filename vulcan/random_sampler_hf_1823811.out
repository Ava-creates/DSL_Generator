    # Reset environment to start a fresh episode.
    _ = env.reset()

    # Mapping from action names (e.g., "DOWN") to integer codes.
    act_map = env.action_specs()

    # Directions with (delta_row, delta_col, name).
    moves = [
        (1, 0, "DOWN"),
        (-1, 0, "UP"),
        (0, 1, "RIGHT"),
        (0, -1, "LEFT"),
    ]

    # ------------------------------------------------------------------
    # Helper: BFS that finds a path (as a list of direction names) to any
    # empty neighbour of a target cell.
    def bfs_to_adjacent(start, target, occ):
        tr, tc = target
        # All empty cells surrounding the target that the agent can stand on.
        goal_cells = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occ.shape[0]
            and 0 <= tc + dc < occ.shape[1]
            and not occ[tr + dr, tc + dc]
        ]
        if not goal_cells:
            return []  # No reachable adjacent cell.

        from collections import deque

        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in goal_cells:
                # Reconstruct path.
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ.shape[0]
                    and 0 <= nc < occ.shape[1]
                    and not occ[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # No path found.

    # ------------------------------------------------------------------
    # Helper: translate a direction name to its delta.
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    # Helper: execute a list of direction names, updating position and actions.
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Gather scenario/world information.
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal if hasattr(env.task, "goal") else None
    if goal_idx is None:
        return []

    # Recipe information: required primitives and workshop (if any).
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Working copies of the grid and occupancy mask.
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell.

    # Current agent position.
    cur_pos = scenario.init_pos  # (row, col)

    # List to accumulate the final action sequence.
    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate remaining instances of this primitive.
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                break  # No more copies left.

            # Choose the closest instance (Manhattan distance).
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to an empty neighbour of the target.
            path = bfs_to_adjacent(cur_pos, target, occ)
            execute_path(path)

            # Use action to pick up the primitive.
            actions.append(act_map["USE"])

            # Update internal model: primitive disappears.
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # ------------------------------------------------------------------
    # If a workshop is required, move to it and craft the goal item.
    if workshop_idx is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if not workshop_cells:
            # Fallback to original grid if workshop cell was cleared.
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))
            )
        if workshop_cells:
            target_ws = workshop_cells[0]  # Any workshop cell suffices.
            path = bfs_to_adjacent(cur_pos, target_ws, occ)
            execute_path(path)
            actions.append(act_map["USE"])

    # Return the compiled action list.
    return actions

