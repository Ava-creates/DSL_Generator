    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)

    def manhattan_path(src, dst):
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def nearest(pos, kind):
        grid = env._current_state.grid
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        idx = dists.argmin()
        return tuple(cells[idx].tolist())

    actions = []
    cur = env._current_state.pos

    for k, cnt in needed.items():
        for _ in range(cnt):
            target = nearest(cur, k)
            if target is None:
                return actions
            actions += manhattan_path(cur, target)
            cur = target
            actions.append(USE)

    workshop = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop is not None:
        w_idx = world.cookbook.index.index(workshop)
        w_pos = nearest(cur, w_idx)
        if w_pos is not None:
            actions += manhattan_path(cur, w_pos)
            cur = w_pos
            actions.append(USE)

    return actions


    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # Index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index('arrow')
    # Primitive requirements for one arrow (dict {primitive_idx: count})
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    actions = []
    cur_pos = env._current_state.pos
    grid = env._current_state.grid

    # ------------------------------------------------------------------
    # Helper: Manhattan move actions from src to dst
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        acts = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            acts += [DOWN] * dx
        elif dx < 0:
            acts += [UP] * (-dx)
        if dy > 0:
            acts += [RIGHT] * dy
        elif dy < 0:
            acts += [LEFT] * (-dy)
        return acts

    # ------------------------------------------------------------------
    # Helper: find the nearest cell that contains a given kind
    # ------------------------------------------------------------------
    def _nearest_kind(pos, kind_idx):
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # Primitive not present – abort planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

