    env.reset()
    state = env._current_state

    # Identify the goal index for the arrow
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow goal not found in cookbook")

    # Action constants
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ----------------------------------------------------------------------
    # Helper: BFS to compute a list of actions from start to a target cell.
    # Cells occupied in any channel are considered blocked, except the target
    # cell itself (useful when moving onto a workshop).
    # ----------------------------------------------------------------------
    from collections import deque

    def bfs_path(start, target):
        grid = state.grid
        h, w = grid.shape[:2]
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # Allow stepping onto the target even if it is occupied
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    # ----------------------------------------------------------------------
    # Helper: move the agent to an absolute position using bfs_path.
    # ----------------------------------------------------------------------
    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # cannot reach the target
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ----------------------------------------------------------------------
    # Helper: locate the nearest cell containing a given kind index.
    # ----------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w = grid.shape[:2]
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ----------------------------------------------------------------------
    # Helper: find a free cell (including the cell itself) adjacent to a
    # given location. Returns None if none found.
    # ----------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        grid = state.grid
        h, w = grid.shape[:2]
        # Prefer the cell itself if it is free
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        return None

    # ----------------------------------------------------------------------
    # Collect all primitive resources needed for the arrow.
    # ----------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in primitives_needed.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                continue  # resource not present
            adj = adjacent_free(src)
            if adj is None:
                continue  # no free adjacent cell
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # ----------------------------------------------------------------------
    # If the recipe requires a workshop, go there and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            if adj:
                move_to(adj)
                actions.append(ACT_USE)
                env.step(ACT_USE)
                state = env._current_state

    return actions


