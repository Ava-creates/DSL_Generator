    # Helper utilities
    # ------------------------------------------------------------------
    def bfs_path(start, goal, occupied):
        """Return a list of positions from start (excluded) to goal (included)
        moving only through cells where `occupied` is False. Goal cell may be occupied."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Goal cell may be occupied; treat it as walkable.
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path (exclude start, include goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Convert a movement delta into the corresponding action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ------------------------------------------------------------------
    # Planning state
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # (x, y)
    grid = state.grid.copy()            # mutable copy to track collected primitives

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources
    # ------------------------------------------------------------------
    for kind_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find all remaining cells that contain this primitive
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                break  # no more of this primitive on the map

            # Sort candidates by Manhattan distance from current position
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)   # any entity blocks movement
            target = None
            path = None
            for idx in order:
                cand = tuple(locations[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    target = cand
                    path = p
                    break

            if target is None:
                # Could not reach any remaining instance; abort further collection of this kind
                break

            # Follow the path to the primitive
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)          # USE
            grid[target[0], target[1], kind_idx] = 0   # mark as collected

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        # locate workshop cells in the original grid (workshops are static)
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block movement)
            for idx in order:
                cand = tuple(workshop_cells[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    for step in p:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE at workshop to craft
                    break
    else:
        # No specific workshop required; craft at current location
        actions.append(4)   # USE

    return actions


