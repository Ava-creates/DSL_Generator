    def _move_actions(src, dst):
        """Generate Manhattan moves from src to dst (ignores obstacles)."""
        x, y = src
        tx, ty = dst
        acts = []
        dx = tx - x
        dy = ty - y
        if dx > 0:
            acts += [DOWN] * dx
        elif dx < 0:
            acts += [UP] * (-dx)
        if dy > 0:
            acts += [RIGHT] * dy
        elif dy < 0:
            acts += [LEFT] * (-dy)
        return acts

    def _nearest_kind(pos, kind_idx):
        """Return coordinates of the nearest cell containing kind_idx."""
        grid = env._current_state.grid
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = int(dists.argmin())
        return tuple(locations[nearest].tolist())

    # ------------------------------------------------------------------
    # 1. Collect required primitives
    # ------------------------------------------------------------------
    for kind_idx, qty in primitives_needed.items():
        for _ in range(qty):
            target = _nearest_kind(cur_pos, kind_idx)
            if target is None:
                # Primitive not present; abort early.
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up / interact

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = cookbook.recipes[goal_idx].get('_at')
