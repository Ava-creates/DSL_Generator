    env.reset()
    state = env._current_state

    # Identify the goal index for "arrow"
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("arrow not found in cookbook")

    # Action mapping
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    from collections import deque

    def bfs_path(start, target):
        """Return a list of actions to move from start to target avoiding occupied cells.
        The target cell may be occupied (we only need to stand next to it)."""
        grid = env._current_state.grid
        h, w, _ = grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    def move_to(pos):
        nonlocal state
        while state.pos != pos:
            path = bfs_path(state.pos, pos)
            if not path:
                raise RuntimeError(f"Cannot reach position {pos}")
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == pos:
                    break

    def find_nearest(kind_idx):
        """Return coordinates of the nearest cell containing kind_idx, or None."""
        grid = env._current_state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    def adjacent_free(cell):
        """Return a free cell orthogonal/diagonal adjacent to `cell`, preferring orthogonal."""
        y, x = cell
        grid = env._current_state.grid
        h, w, _ = grid.shape
        # orthogonal neighbours first
        for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            ny, nx = y + dy, x + dx
            if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                return (ny, nx)
        # then diagonals
        for dy, dx in ((-1, -1), (-1, 1), (1, -1), (1, 1)):
            ny, nx = y + dy, x + dx
            if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                return (ny, nx)
        # fallback: stand on the cell itself if free
        if not grid[y, x, :].any():
            return (y, x)
        return None

    # --------------------------------------------------------------
    # Collect required primitive resources
    # --------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                raise RuntimeError(f"Primitive {kind_idx} not found on map")
            adj = adjacent_free(src)
            if adj is None:
                raise RuntimeError(f"No free cell adjacent to primitive {kind_idx}")
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # --------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos is None:
            raise RuntimeError(f"Workshop {workshop_name} not found on map")
        adj = adjacent_free(ws_pos)
        if adj is None:
            raise RuntimeError(f"No free cell adjacent to workshop {workshop_name}")
        move_to(adj)
        actions.append(ACT_USE)
        env.step(ACT_USE)
        state = env._current_state

    return actions


    # Reset environment and fetch initial state
    env.reset()
    state = env._current_state

    # Determine the index of the "arrow" goal
    if hasattr(env, "task") and hasattr(env.task, "goal"):
