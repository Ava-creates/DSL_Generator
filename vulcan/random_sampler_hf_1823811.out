def make_arrow_vn(env):
    """
    Generate a list of actions that will make an ``arrow`` in the given
    CraftLab environment.  The implementation follows a very simple
    “collect‑then‑craft” strategy:

    1.  Determine which primitive resources are required for one arrow.
    2.  While the goal is not satisfied:
        * If any required primitive is missing, move to a cell that
          contains it and ``USE`` to pick it up.
        * Otherwise, move to the appropriate workshop and ``USE`` to craft
          the arrow.
    3.  Return the full action sequence.

    The function steps the environment as it builds the plan so that the
    agent’s position, direction and inventory stay in sync with the
    generated actions.
    """
    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _action_map():
        """Return a dict mapping action names to integer codes."""
        return env.action_specs()

    def _move_one_step(cur, target, act_map):
        """Return a single movement action that moves cur towards target."""
        cx, cy = cur
        tx, ty = target
        if cx < tx:
            return act_map["DOWN"]
        if cx > tx:
            return act_map["UP"]
        if cy < ty:
            return act_map["RIGHT"]
        if cy > ty:
            return act_map["LEFT"]
        return None  # already at target

    def _move_to(pos, target, act_map):
        """Yield movement actions that walk from pos to target (Manhattan)."""
        actions = []
        cur = pos
        while cur != target:
            a = _move_one_step(cur, target, act_map)
            actions.append(a)
            # simulate the step so we can update ``cur`` for the next loop
            reward, done, _ = env.step(a)
            cur = env._current_state.pos
        return actions

    # ------------------------------------------------------------------
    # Initialise environment and fetch recipe information
    # ------------------------------------------------------------------
    # Reset the environment (ignores the returned observation – we will
    # query the internal state directly).
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld
    cookbook = world.cookbook

    # Index of the goal item (``arrow``) – raise a clear error if missing.
    try:
        arrow_idx = cookbook.index.index("arrow")
    except Exception as exc:
        raise ValueError("The recipe set does not contain an 'arrow' item.") from exc

    # Primitive requirements for a single arrow.
    primitive_req = cookbook.primitives_for(arrow_idx)   # {kind_idx: count}
    if not primitive_req:
        # If the recipe has no entry, the arrow is a primitive itself.
        primitive_req = {arrow_idx: 1}

    # Action mapping (DOWN, UP, LEFT, RIGHT, USE)
    act_map = _action_map()
    use_action = act_map["USE"]

    # ------------------------------------------------------------------
    # Main planning loop
    # ------------------------------------------------------------------
    plan = []                     # accumulated list of actions to return

    while not state.satisfies("", arrow_idx):
        inventory = state.inventory

        # ----------------------------------------------------------------
        # Determine which primitives are still missing.
        # ----------------------------------------------------------------
        missing = {}
        for kind, need_cnt in primitive_req.items():
            have = int(inventory[kind])
            if have < need_cnt:
                missing[kind] = need_cnt - have

        # ----------------------------------------------------------------
        # If we still need primitives, go collect one of them.
        # ----------------------------------------------------------------
        if missing:
            # pick an arbitrary needed kind (deterministic order for repeatability)
            needed_kind = min(missing.keys())
            # locate any cell that currently holds this kind
            cells = np.argwhere(state.grid[:, :, needed_kind] > 0)
            if cells.size == 0:
                raise RuntimeError(f"Required primitive {needed_kind} not present on the map.")
            target_cell = tuple(cells[0])          # (row, col)

            # move to the cell
            plan.extend(_move_to(state.pos, target_cell, act_map))

            # pick it up
            plan.append(use_action)
            reward, done, _ = env.step(use_action)
            state = env._current_state
            continue

        # ----------------------------------------------------------------
        # All primitives are present – go to the workshop and craft.
        # ----------------------------------------------------------------
        # The workshop index is stored under the special key "_at" in the
        # recipe dictionary.
        recipe = cookbook.recipes[arrow_idx]
        workshop_kind = recipe.get("_at")
        if workshop_kind is None:
            raise RuntimeError("Workshop location ('_at') not defined for arrow recipe.")

        # Find any workshop cell of the required type.
        wk_cells = np.argwhere(state.grid[:, :, workshop_kind] > 0)
        if wk_cells.size == 0:
            raise RuntimeError("No workshop of the required type found on the map.")
        wk_target = tuple(wk_cells[0])

        # Move to the workshop.
        plan.extend(_move_to(state.pos, wk_target, act_map))

        # Craft the arrow.
        plan.append(use_action)
        reward, done, _ = env.step(use_action)
        state = env._current_state
        # Loop will exit once the inventory contains the arrow.

    return plan


    # Reset the environment to a fresh episode
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world                    # CraftWorld instance
    index = world.cookbook.index         # name ↔ integer id

    # Goal item name (as used in the recipe file)
    goal_name = "arrow"
    goal_idx = index[goal_name]

    # Primitive requirements for a single arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Determine the workshop needed for crafting the arrow
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else index[wk]

    # Helper: find all grid locations that currently contain a given kind
    def find_locations(kind):
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    # Helper: convert a move between adjacent cells into an action id
    def move_action(cur, nxt):
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Non‑adjacent step in path")

    # Helper: BFS shortest path ignoring non‑grabbable cells
    def bfs(start, goal):
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # If no path found, just stay in place
        return [start]

    actions = []
    cur_pos = state.pos

    # Collect each required primitive the necessary number of times
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            locs = find_locations(prim_idx)
            if not locs:
                # primitive already in inventory or unavailable; skip
                continue
            target = locs[0]                     # pick the first instance
            path = bfs(cur_pos, target)
            for step in path[1:]:                # skip current position
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # Use action to pick up the item
            actions.append(4)                    # USE

    # Move to the appropriate workshop and craft the arrow
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = wk_locs[0]
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)                    # USE to craft

    return actions

