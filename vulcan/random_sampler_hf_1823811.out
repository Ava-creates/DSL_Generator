    # ------------------------------------------------------------------
    # Constants and helper utilities
    # ------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    from collections import deque
    import numpy as np

    def _bfs_adjacent(start, target, blocked):
        """Return a list of actions that moves the agent from *start* to any
        free 4‑adjacent cell of *target*.  If none reachable, returns []."""
        h, w = blocked.shape
        tx, ty = target
        # admissible cells around the target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ------------------------------------------------------------------
    # Reset / obtain current state from the environment
    # ------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []                     # cannot retrieve state → give up

    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # arrow not defined in this world

    # primitive requirements for ONE arrow
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # locate workshop name in the recipe (key "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                     # recipe does not specify a workshop

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # workshop not indexed

    # ------------------------------------------------------------------
    # Local mutable copies for planning simulation
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix: True = blocked

    plan = []

    # ------------------------------------------------------------------
    # Helper: navigate to a cell adjacent to *target* and USE it,
    # updating the simulated world state.
    # ------------------------------------------------------------------
    def _move_and_use(target, kind_idx):
        """Move adjacent to *target*, issue USE, and update simulation.
        Returns False if movement is impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = _bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False

        # simulate movement
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # simulate USE
        plan.append(USE)
        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ------------------------------------------------------------------
    # Collect all required primitive resources
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.shape[0] == 0:
                # primitive not present on the map – abort planning
                return plan
            # choose the closest occurrence (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not _move_and_use(target, prim_idx):
                return plan

    # ------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # workshops are static; fall back to the original scenario grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    _move_and_use(workshop_target, workshop_idx)

    # ------------------------------------------------------------------
    # Return the assembled action sequence
    # ------------------------------------------------------------------
    return plan


