    # Reset environment to obtain a fresh state and action mapping
    _ = env.reset()
    act_map = env.action_specs()                     # e.g., {"DOWN":0, "UP":1, ...}

    # Basic movement directions and their coordinate deltas (row, col)
    moves = [
        ("DOWN", (1, 0)),
        ("UP", (-1, 0)),
        ("RIGHT", (0, 1)),
        ("LEFT", (0, -1)),
    ]
    dir_to_delta = {name: delta for name, delta in moves}

    # --------------------------------------------------------------
    # Helper: BFS to find a shortest path (list of direction names)
    # from start to any empty cell adjacent to a target cell.
    # --------------------------------------------------------------
    def bfs_to_adjacent(start, target, occupied):
        tr, tc = target
        # All walkable neighbours of the target cell
        neighbours = [
            (tr + dr, tc + dc)
            for _, (dr, dc) in moves
            if 0 <= tr + dr < occupied.shape[0]
            and 0 <= tc + dc < occupied.shape[1]
            and not occupied[tr + dr, tc + dc]
        ]
        if not neighbours:
            return []  # no reachable adjacent cell

        from collections import deque
        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in neighbours:
                # reconstruct path
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for name, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occupied.shape[0]
                    and 0 <= nc < occupied.shape[1]
                    and not occupied[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # no path found

    # --------------------------------------------------------------
    # Helper: Execute a list of direction names, updating the current
    # position and appending the corresponding action codes.
    # --------------------------------------------------------------
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # --------------------------------------------------------------
    # Gather scenario / world information
    # --------------------------------------------------------------
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal                         # integer index of the desired item

    # Primitive requirements for the goal and workshop location (if any)
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")                # may be None

    # Working copies of the grid and occupancy mask
    grid = scenario.init_grid.copy()
    occupied = grid.sum(axis=2) > 0                  # True where any entity occupies the cell

    # Current agent state
    cur_pos = scenario.init_pos                      # (row, col)

    # List of actions to be returned
    actions = []

    # --------------------------------------------------------------
    # Collect each required primitive the required number of times
    # --------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate all remaining cells containing this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more of this primitive left; abort early
                break

            # Choose the closest instance (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to an empty neighbour of the target
            path = bfs_to_adjacent(cur_pos, target, occupied)
            execute_path(path)

            # Pick up the primitive
            actions.append(act_map["USE"])

            # Update grid/occupancy: primitive disappears after pickup
            r, c = target
            grid[r, c, :] = 0
            occupied[r, c] = False

    # --------------------------------------------------------------
    # Move to the workshop (if required) and craft the goal item
    # --------------------------------------------------------------
    if workshop_kind is not None:
        # Locate a workshop cell of the appropriate kind
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            # Fallback to original grid in case the workshop was overwritten
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0))
            )
        if workshop_cells:
            target = workshop_cells[0]  # any workshop works
            path = bfs_to_adjacent(cur_pos, target, occupied)
            execute_path(path)
            actions.append(act_map["USE"])

    return actions


    # Reset environment to ensure a fresh start
    _ = env.reset()
    act_map = env.action_specs()                     # e.g., {"DOWN":0, "UP":1, ...}

    # Directions and corresponding deltas (row, col)
    moves = [
        ("DOWN", (1, 0)),
        ("UP",   (-1, 0)),
        ("RIGHT",(0, 1)),
        ("LEFT", (0, -1)),
    ]
    dir_to_delta = {name: delta for name, delta in moves}

    # ------------------------------------------------------------------
    # Helper: BFS that finds a path (list of direction names) from start
    # to any empty cell adjacent to target, avoiding occupied cells.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, target, occupied):
        tr, tc = target
        h, w = occupied.shape
        # All walkable neighbours of the target
        adj_cells = [
            (tr + dr, tc + dc)
            for _, (dr, dc) in moves
            if 0 <= tr + dr < h and 0 <= tc + dc < w and not occupied[tr + dr, tc + dc]
        ]
        if not adj_cells:
            return []  # no reachable adjacent cell

        from collections import deque
        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in adj_cells:
                # reconstruct path
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for dname, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc] and (nr, nc) not in parent:
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = dname
                    q.append((nr, nc))
        return []  # no path found

    # ------------------------------------------------------------------
    # Helper: Execute a list of direction names, updating cur_pos and
    # appending the corresponding action codes.
    # ------------------------------------------------------------------
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Gather scenario / world information
    # ------------------------------------------------------------------
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal                         # integer index of the desired item

    # Primitive requirements for the goal and workshop location (if any)
    primitives_needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")

    # Working copies of the grid and occupancy mask
    grid = scenario.init_grid.copy()
    occupied = grid.sum(axis=2) > 0                 # True where any entity occupies the cell

    # Current agent state
    cur_pos = scenario.init_pos                     # (row, col)

    # Action list to be returned
    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate all remaining cells containing this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                continue  # no more of this primitive on the map

            # Try candidates in order of Manhattan distance from current position
            prim_cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            path_found = False
            for target in prim_cells:
                path = bfs_to_adjacent(cur_pos, target, occupied)
                if path:                     # reachable
                    execute_path(path)
                    actions.append(act_map["USE"])
                    # Update grid/occupancy: primitive disappears after pickup
                    r, c = target
                    grid[r, c, :] = 0
                    occupied[r, c] = False
                    path_found = True
                    break
            if not path_found:
                # If none reachable, skip this primitive
                continue

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            # fallback to original grid in case workshop was overwritten
            workshop_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0)))
        if workshop_cells:
            # Choose the nearest workshop cell
            workshop_cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            target = workshop_cells[0]
            path = bfs_to_adjacent(cur_pos, target, occupied)
            if path:
                execute_path(path)
                actions.append(act_map["USE"])

    return actions

