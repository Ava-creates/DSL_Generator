    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: find nearest cell containing at least one entity of `kind`
    # ------------------------------------------------------------------
    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
