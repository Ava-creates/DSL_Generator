    # reset environment to start a fresh episode and obtain the initial state
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world
    cb = world.cookbook

    # index of the target item ("arrow")
    goal_idx = cb.index["arrow"]

    # primitive requirements for one arrow (primitive_idx -> count)
    needed = cb.primitives_for(goal_idx)

    actions = []                         # final action sequence to return

    # ------------------------------------------------------------
    # helper: execute a list of actions, updating the local `state`
    # ------------------------------------------------------------
    def _apply(seq):
        nonlocal state
        for a in seq:
            _, new_state = state.step(a)
            state = new_state

    # ------------------------------------------------------------
    # helper: simple Manhattan path (no obstacle avoidance)
    # ------------------------------------------------------------
    def _move_to(target):
        seq = []
        x, y = state.pos
        tx, ty = target
        while (x, y) != (tx, ty):
            if x < tx:
                seq.append(3)          # RIGHT
                x += 1
            elif x > tx:
                seq.append(2)          # LEFT
                x -= 1
            elif y < ty:
                seq.append(0)          # DOWN
                y += 1
            elif y > ty:
                seq.append(1)          # UP
                y -= 1
        return seq

    # ------------------------------------------------------------
    # helper: find a free (empty) cell adjacent to `pos`
    # ------------------------------------------------------------
    def _free_adjacent(pos):
        w, h = state.grid.shape[:2]
        x, y = pos
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                if dx == 0 and dy == 0:
                    continue
                ax, ay = x + dx, y + dy
                if 0 <= ax < w and 0 <= ay < h:
                    if not np.any(state.grid[ax, ay, :]):   # completely empty
                        return (ax, ay)
        return None

    # ------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------
    for prim_idx, count_needed in needed.items():
        while state.inventory[prim_idx] < count_needed:
            # locate any remaining instance of this primitive on the map
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # nothing left on the map – break to avoid infinite loop
                break
            px, py = prim_cells[0]

            # move to a free cell next to the primitive
            target = _free_adjacent((px, py))
            if target is None:
                # cannot reach this primitive; give up on it
                break
            seq = _move_to(target)
            actions.extend(seq)
            _apply(seq)

            # use the primitive (USE action = 4)
            actions.append(4)
            _, new_state = state.step(4)
            state = new_state

    # ------------------------------------------------------------
    # Craft the arrow at its workshop
    # ------------------------------------------------------------
    # recipe dictionary contains a special key "_at" pointing to the workshop kind
    workshop_kind = cb.recipes[goal_idx]["_at"]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_kind] > 0)
    if workshop_cells.size > 0:
        wx, wy = workshop_cells[0]
        target = _free_adjacent((wx, wy))
        if target is not None:
            seq = _move_to(target)
            actions.extend(seq)
            _apply(seq)

            # final USE to craft the arrow
            actions.append(4)
            # (no need to keep the final state, we only return the actions)

    return actions


    # Reset the environment to obtain a fresh state.
    env.reset()
    state = env._current_state

    # Goal item index.
    goal = env.task.goal

    # Mapping from primitive kind index to required count.
    needed = dict(state.world.cookbook.primitives_for(goal))

    # Record the actions we will return.
    actions: list[int] = []

    # Helper to execute a list of actions, updating state and inventory.
    def _apply(act_list: list[int]) -> None:
        nonlocal state, needed, actions
        for a in act_list:
            _, new_state = state.step(a)
            state = new_state
            actions.append(a)
        # Remove any primitives that are now satisfied.
        inv = state.inventory
        for k in list(needed):
            if inv[k] >= needed[k]:
                needed.pop(k)

    # Bread‑first search that returns a sequence of movement actions
    # (DOWN=0, UP=1, LEFT=2, RIGHT=3) to reach any cell in ``targets``.
    from collections import deque

    def _bfs(start: tuple[int, int],
             targets: set[tuple[int, int]],
             blocked: set[tuple[int, int]]) -> list[int] | None:
        w, h = state.grid.shape[:2]
        q = deque()
        q.append((start, []))
        visited = {start}
        # (dx, dy) order matches action indices defined in the env.
        moves = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for a, (dx, dy) in enumerate(moves):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                if (nx, ny) in visited or (nx, ny) in blocked:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [a]))
        return None

    # ------------------------------------------------------------------
    # Phase 1 – collect all required primitives.
    # ------------------------------------------------------------------
    while needed:
        grid = state.grid
        w, h = grid.shape[:2]

        # Find all cells that contain any needed primitive.
        primitive_cells: dict[int, list[tuple[int, int]]] = {}
        for kind in needed:
            inds = np.argwhere(grid[:, :, kind] > 0)
            if inds.size:
                primitive_cells[kind] = [tuple(p) for p in inds]

        # Choose the primitive that can be reached with the shortest path.
        best_path: list[int] | None = None
        best_kind: int | None = None
        cur = state.pos

        # Cells that are occupied (cannot be stepped on).
        occupied = set(map(tuple, np.argwhere(grid.sum(axis=2) > 0)))

        for kind, cells in primitive_cells.items():
            # All positions adjacent (including the cell itself) to a primitive.
            adj_targets = set()
            for (px, py) in cells:
                for dx, dy in [(0, 0), (0, 1), (0, -1), (-1, 0), (1, 0)]:
                    ax, ay = px + dx, py + dy
                    if 0 <= ax < w and 0 <= ay < h:
                        adj_targets.add((ax, ay))

            path = _bfs(cur, adj_targets, occupied)
            if path is not None and (best_path is None or len(path) < len(best_path)):
                best_path = path
                best_kind = kind

        if best_path is None:
            # No reachable primitive – give up.
            break

        # Move next to the chosen primitive and pick it up.
        _apply(best_path)
        _apply([4])          # USE action to collect the primitive.

    # ------------------------------------------------------------------
    # Phase 2 – go to the appropriate workshop and craft the goal.
    # ------------------------------------------------------------------
    # Identify the workshop kind required for the goal (stored under "_at").
    recipe = state.world.cookbook.recipes.get(goal, {})
    workshop_kind: int | None = None
    for key, val in recipe.items():
        if key == "_at":
            # The value is the workshop kind index (or a list containing it).
            if isinstance(val, int):
                workshop_kind = val
            elif isinstance(val, (list, tuple)) and val:
                workshop_kind = int(val[0])
            break

    # Fallback: any workshop present in the world.
    if workshop_kind is None and state.world.workshop_indices:
        workshop_kind = state.world.workshop_indices[0]

    if workshop_kind is not None:
        inds = np.argwhere(state.grid[:, :, workshop_kind] > 0)
        if inds.size:
            workshop_cells = [tuple(p) for p in inds]

            # Adjacent positions to any workshop cell.
            adj_targets = set()
            for (wx, wy) in workshop_cells:
                for dx, dy in [(0, 0), (0, 1), (0, -1), (-1, 0), (1, 0)]:
                    ax, ay = wx + dx, wy + dy
                    if 0 <= ax < w and 0 <= ay < h:
                        adj_targets.add((ax, ay))

            occupied = set(map(tuple, np.argwhere(state.grid.sum(axis=2) > 0)))
            path = _bfs(state.pos, adj_targets, occupied)
            if path:
                _apply(path)
                _apply([4])      # USE action to craft the goal item.

    return actions

