    from collections import deque

    def _bfs_path(start, target):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to target.
        Cells occupied by any entity are treated as obstacles, except the target cell.
        """
        if start == target:
            return []

        h, w = state.grid.shape[:2]
        moves = [(DOWN, (1, 0)),
                 (UP, (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT, (0, 1))]

        q = deque([start])
        visited = {start}
        parent = {}

        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Disallow stepping on occupied cells unless it's the target.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)

        # Reconstruct path.
        if target not in parent and start != target:
            return []  # No path found.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Phase 1: Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate cells that currently hold this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive missing; abort early.
                return actions

            # Choose the nearest primitive cell (Manhattan distance).
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            tr, tc = prim_cells[dists.argmin()]

            # Move to the primitive cell.
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update internal copy of the state (grid becomes empty, inventory increments).
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # Phase 2: Go to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # No workshop info; cannot craft.

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # Workshop not present.

    # Choose the nearest workshop cell.
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]

    # Move to the workshop.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions


    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    index = cookbook.index

    # Resolve action indices from the environment (fallback to defaults)
    action_map = env.action_specs()
    DOWN = action_map.get("DOWN", 0)
    UP = action_map.get("UP", 1)
    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    # ------------------------------------------------------------------
    # Identify the goal item (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                     # Arrow not defined in this world.
    goal_idx = index[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

