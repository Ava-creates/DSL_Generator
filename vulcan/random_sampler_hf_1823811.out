    # Reset environment and obtain initial state
    env.reset()
    state = env._current_state

    # Identify goal index for the "arrow"
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow item not found in cookbook")

    # Action mapping
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # --------------------------------------------------------------------- #
    # Helper: Breadth‑first search for a free path from start → target
    # --------------------------------------------------------------------- #
    def bfs_path(start, target):
        from collections import deque
        h, w, _ = state.grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # cell is traversable if empty or is the final target cell
                    if not state.grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # no path found

    # --------------------------------------------------------------------- #
    # Helper: Move agent to an absolute position using bfs_path
    # --------------------------------------------------------------------- #
    def move_to(target):
        nonlocal actions, state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:  # stuck; break to avoid infinite loop
                break
            for act in path:
                actions.append(act)
                env.step(act)
                state = env._current_state
                if state.pos == target:
                    break

    # --------------------------------------------------------------------- #
    # Helper: Locate nearest cell containing a specific kind index
    # --------------------------------------------------------------------- #
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # --------------------------------------------------------------------- #
    # Helper: Choose a free adjacent cell (including the cell itself)
    # --------------------------------------------------------------------- #
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the cell itself if free
        if not state.grid[y, x, :].any():
            return (y, x)
        # Otherwise search 8‑neighbourhood
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not state.grid[ny, nx, :].any():
                    return (ny, nx)
        # Fallback: stay where we are
        return state.pos

    # --------------------------------------------------------------------- #
    # Collect all required primitives for the arrow
    # --------------------------------------------------------------------- #
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in needed.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                # Primitive not present on the map; skip
                continue
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # --------------------------------------------------------------------- #
    # Go to the workshop (if the recipe specifies one) and craft the arrow
    # --------------------------------------------------------------------- #
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            move_to(adj)
            actions.append(ACT_USE)      # use at workshop to craft
            env.step(ACT_USE)
            state = env._current_state

    return actions


    # Reset environment and fetch the initial state
    env.reset()
    state = env._current_state

    # Determine the index of the goal item (arrow)
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow item not found in the cookbook.")

    # Action indices
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ----------------------------------------------------------------------
    # Helper: Bread‑first‑search for a free path between two cells.
    # ----------------------------------------------------------------------
    def bfs_path(start, target):
        from collections import deque
        h, w, _ = state.grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN), (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT), (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # allow moving onto empty cells or the final target cell
                    if not state.grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # no path found

    # ----------------------------------------------------------------------
    # Helper: Move the agent to an absolute position using the BFS planner.
    # ----------------------------------------------------------------------
    def move_to(pos):
        nonlocal actions, state
        while state.pos != pos:
            path = bfs_path(state.pos, pos)
            if not path:  # stuck – abort movement
                break
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == pos:
                    break

    # ----------------------------------------------------------------------
    # Helper: Locate the closest cell containing a specific kind index.
    # ----------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ----------------------------------------------------------------------
    # Helper: Choose a free cell adjacent (including diagonal) to a target.
    # ----------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the target cell itself if it is free
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        # Fallback: current position
        return state.pos

    # ----------------------------------------------------------------------
    # 1) Collect all primitive resources required for the goal.
    # ----------------------------------------------------------------------
    needed_primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in needed_primitives.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                # Primitive not present in the current map – skip.
                continue
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)          # pick up / collect
            env.step(ACT_USE)
            state = env._current_state

    # ----------------------------------------------------------------------
    # 2) Go to the workshop (if the recipe specifies one) and craft.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj_ws = adjacent_free(ws_pos)
            move_to(adj_ws)
            actions.append(ACT_USE)          # craft at workshop
            env.step(ACT_USE)
            state = env._current_state

    # Return the assembled action list
    return actions

