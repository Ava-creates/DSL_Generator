    import collections, numpy as np

    # Helper: map direction vectors to action indices (consistent with env)
    DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    ACT2DIR = {v: k for k, v in DIR2ACT.items()}

    # ------------------------------------------------------------------
    # Simple BFS that returns a list of movement actions (0‑3) to reach any
    # cell in `targets`.  The agent can only step on empty cells.
    # ------------------------------------------------------------------
    def bfs(start_pos, targets, grid):
        h, w = grid.shape[:2]
        q = collections.deque()
        q.append((start_pos, []))
        visited = {start_pos}
        while q:
            (x, y), path = q.popleft()
            if (x, y) in targets:
                return path
            for act, (dx, dy) in ACT2DIR.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    # cell is free if no kind is present
                    if not grid[ny, nx].any():
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # no path found – return empty list (will cause failure later)
        return []

    # ------------------------------------------------------------------
    # Turn the agent to face a specific neighbour cell and use (action 4)
    # ------------------------------------------------------------------
    def face_and_use(state, target_pos, actions):
        ax, ay = state.pos
        tx, ty = target_pos
        dx, dy = tx - ax, ty - ay
        act = DIR2ACT.get((dx, dy))
        if act is None:
            # shouldn't happen; just ignore
            return actions
        actions.append(act)          # turn (may also move if free, but target is occupied)
        actions.append(4)            # USE
        return actions

    # ------------------------------------------------------------------
    # Main planning
    # ------------------------------------------------------------------
    # reset environment to get a fresh state
    env.reset()
    state = env._current_state

    # goal index (item we need to craft)
    goal_idx = env.task.goal

    # primitive requirements for the goal
    primitive_needs = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives (ignoring possible intermediate crafts)
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        while state.inventory[prim_idx] < needed:
            # locate any cell that still contains this primitive
            prim_layer = state.grid[:, :, prim_idx]
            positions = np.argwhere(prim_layer > 0)
            if positions.size == 0:
                # nothing left – break to avoid infinite loop
                break
            # pick the closest one (Manhattan)
            ay, ax = state.pos[1], state.pos[0]
            dists = np.abs(positions[:, 1] - ax) + np.abs(positions[:, 0] - ay)
            chosen = positions[dists.argmin()]
            ty, tx = chosen[0], chosen[1]

            # compute all empty neighbour cells of the primitive
            neighbour_cells = set()
            for dx, dy in ACT2DIR.values():
                nx, ny = tx + dx, ty + dy
                if 0 <= nx < state.grid.shape[1] and 0 <= ny < state.grid.shape[0]:
                    if not state.grid[ny, nx].any():
                        neighbour_cells.add((nx, ny))

            # plan path to one of the neighbour cells
            path = bfs(state.pos, neighbour_cells, state.grid)
            for act in path:
                # execute movement action
                reward, done, _ = env.step(act)
                state = env._current_state

            # now we are on a neighbour cell; face the primitive and use
            actions = face_and_use(state, (tx, ty), actions)
            # actually perform the actions in the environment to keep state sync
            for act in actions[-2:]:      # the two actions just added
                reward, done, _ = env.step(act)
                state = env._current_state

    # ------------------------------------------------------------------
    # 2) Move to the required workshop and craft the goal item
    # ------------------------------------------------------------------
    # Find which workshop type is needed for this recipe
    workshop_kind = None
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_kind = recipe["_at"]
    else:
        # fallback: assume any workshop works; pick first known workshop kind
        if env.world.workshop_indices:
            workshop_kind = env.world.workshop_indices[0]

    if workshop_kind is not None:
        # locate a workshop cell of that kind
        wk_layer = state.grid[:, :, workshop_kind]
        wk_positions = np.argwhere(wk_layer > 0)
        if wk_positions.size:
            wk_y, wk_x = wk_positions[0]
            # neighbour cells around workshop
            neighbour_cells = set()
            for dx, dy in ACT2DIR.values():
                nx, ny = wk_x + dx, wk_y + dy
                if 0 <= nx < state.grid.shape[1] and 0 <= ny < state.grid.shape[0]:
                    if not state.grid[ny, nx].any():
                        neighbour_cells.add((nx, ny))
            # path to neighbour
            path = bfs(state.pos, neighbour_cells, state.grid)
            for act in path:
                reward, done, _ = env.step(act)
                state = env._current_state
            # face workshop and use to craft
            actions = face_and_use(state, (wk_x, wk_y), actions)
            for act in actions[-2:]:
                reward, done, _ = env.step(act)
                state = env._current_state

    # Return the complete action list
    return actions

