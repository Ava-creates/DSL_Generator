    # Reset the environment (ignore errors if already reset)
    try:
        env.reset()
    except Exception:
        pass

    actions: list[int] = []

    # ------------------------------------------------------------------
    # Determine the goal index (the item we need to craft)
    # ------------------------------------------------------------------
    goal_idx = None
    task = getattr(env, "task", None)
    if task is not None:
        goal_idx = getattr(task, "goal", None)
        if goal_idx is None and isinstance(task, (list, tuple)):
            goal_idx = task[0]

    if goal_idx is None:
        # No goal information – nothing to do
        return actions

    # ------------------------------------------------------------------
    # What primitive resources are needed to craft the goal?
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # ------------------------------------------------------------------
    # Helper state: current position and a copy of the grid for planning
    # ------------------------------------------------------------------
    cur_pos = list(env._current_state.pos)          # mutable [x, y]
    grid = env._current_state.grid.copy()           # (W, H, n_kinds)

    # ------------------------------------------------------------------
    # Helper: generate a Manhattan sequence of actions from cur_pos to target
    # ------------------------------------------------------------------
    def move_to(target: tuple[int, int]) -> list[int]:
        """Return a list of actions that moves the agent from cur_pos to target."""
        seq: list[int] = []
        tx, ty = target
        # x‑axis (horizontal) moves
        while cur_pos[0] < tx:
            seq.append(3)          # RIGHT
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            seq.append(2)          # LEFT
            cur_pos[0] -= 1
        # y‑axis (vertical) moves
        while cur_pos[1] < ty:
            seq.append(0)          # DOWN
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            seq.append(1)          # UP
            cur_pos[1] -= 1
        return seq

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for kind_idx, needed in primitives_needed.items():
        remaining = needed
        while remaining > 0:
            # Find all cells that currently contain this primitive
            positions = np.argwhere(grid[:, :, kind_idx] > 0)  # shape (N, 2)
            if positions.size == 0:
                # No more of this primitive on the map – abort collection
                break

            # Choose the nearest primitive (Manhattan distance) to minimise travel
            dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])
            nearest_idx = int(np.argmin(dists))
            target = tuple(positions[nearest_idx].tolist())

            # Move to the primitive and pick it up
            actions.extend(move_to(target))
            actions.append(4)                     # USE to pick up

            # Simulate the pickup so we don't target the same cell again
            grid[target[0], target[1], kind_idx] = 0
            remaining -= 1

    # ------------------------------------------------------------------
    # After gathering all primitives, go to the appropriate workshop (if any) and craft.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")  # may be None

    if workshop_kind is not None:
        # Locate a workshop of the required type
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
        if ws_positions.shape[0] > 0:
            dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])
            nearest_ws = int(np.argmin(dists))
            ws_target = tuple(ws_positions[nearest_ws].tolist())
            actions.extend(move_to(ws_target))
        # Craft at the workshop
        actions.append(4)                     # USE to craft
    else:
        # No specific workshop required – craft at current location
        actions.append(4)                     # USE to craft

    return actions


    # Reset environment (ignore errors if already reset)
    try:
        env.reset()
    except Exception:
        pass

    actions = []

    # ------------------------------------------------------------------
    # Determine the goal index (the item we need to craft)
    # ------------------------------------------------------------------
    goal_idx = None
    task = getattr(env, "task", None)
    if task is not None:
        goal_idx = getattr(task, "goal", None)
        if goal_idx is None and isinstance(task, (list, tuple)):
            goal_idx = task[0]

    # fallback: try to fetch the index of "arrow" directly
    if goal_idx is None:
        try:
            goal_idx = env.world.cookbook.index["arrow"]
        except Exception:
            return actions

    # ------------------------------------------------------------------
    # What primitive resources are needed for this goal?
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    # Current agent position (mutable copy)
    cur_pos = list(env._current_state.pos)          # [x, y]

    # Work on a copy of the grid so we can simulate pickups
    grid = env._current_state.grid.copy()

    # ------------------------------------------------------------------
    # Helper: generate a Manhattan path from cur_pos to target cell
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal cur_pos
        seq = []
        tx, ty = target
        while cur_pos[0] < tx:
            seq.append(3)          # RIGHT
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            seq.append(2)          # LEFT
            cur_pos[0] -= 1
        while cur_pos[1] < ty:
            seq.append(0)          # DOWN
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            seq.append(1)          # UP
            cur_pos[1] -= 1
        return seq

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for kind_idx, needed in primitives_needed.items():
        remaining = needed
        while remaining > 0:
            positions = np.argwhere(grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                # No more of this primitive on the map – give up on it
                break
            # Choose the nearest primitive (Manhattan distance)
            dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])
            nearest = int(np.argmin(dists))
            target = tuple(positions[nearest])
            actions.extend(move_to(target))
            actions.append(4)                      # USE to pick up
            # Simulate the pickup so we don't target the same cell again
            grid[target[0], target[1], kind_idx] = 0
            remaining -= 1

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
        if ws_positions.shape[0] > 0:
            dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])
            nearest = int(np.argmin(dists))
            ws_target = tuple(ws_positions[nearest])
            actions.extend(move_to(ws_target))
        actions.append(4)          # USE to craft at the workshop
    else:
        # No specific workshop required – craft at current location
        actions.append(4)

    return actions

