    # Reset the environment and obtain the initial state/world objects
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld

    # ------------------------------------------------------------------
    # Helper: map action names to indices (environment may override defaults)
    # ------------------------------------------------------------------
    action_map = env.action_specs()
    ACTION_DOWN = action_map.get('DOWN')
    ACTION_UP = action_map.get('UP')
    ACTION_LEFT = action_map.get('LEFT')
    ACTION_RIGHT = action_map.get('RIGHT')
    ACTION_USE = action_map.get('USE')

    # Directions paired with their corresponding action indices
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    # ------------------------------------------------------------------
    # Helper: breadth‑first search that returns a list of movement actions
    # leading from the agent's current position to any cell containing
    # `target_kind`. The agent may step onto empty cells or directly onto
    # the target cell; all other occupied cells are treated as obstacles.
    # ------------------------------------------------------------------
    from collections import deque

    def find_path(cur_state, target_kind):
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow stepping onto empty cells or the target cell itself
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # If we reach here the target is unreachable; return empty list
        return []

    actions = []

    # ------------------------------------------------------------------
    # 1) Gather all primitive resources needed for the goal item.
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    required_primitives = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    for prim_idx, count in required_primitives.items():
        for _ in range(count):
            # Find a path to the nearest cell that holds this primitive
            path = find_path(state, prim_idx)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use the primitive (pick it up)
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # Return the complete action sequence
    return actions


    import collections, numpy as np

    # reset and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # goal item index and its primitive requirements
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # action mapping from the environment
    act_map = env.action_specs()
    ACTION_DOWN = act_map.get('DOWN')
    ACTION_UP = act_map.get('UP')
    ACTION_LEFT = act_map.get('LEFT')
    ACTION_RIGHT = act_map.get('RIGHT')
    ACTION_USE = act_map.get('USE')

    # direction vectors paired with their action ids
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    def find_path(cur_state, target_kind):
        """BFS returning a list of movement actions that brings the agent to a cell
        containing `target_kind`. The agent may step onto empty cells or the target
        cell itself; all other occupied cells are treated as obstacles."""
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # allow stepping onto empty cells or directly onto the target cell
                if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        # unreachable in a well‑formed scenario
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_kind, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, prim_kind)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # pick up the primitive now under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        # use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

