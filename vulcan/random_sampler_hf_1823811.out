    # Reset environment and fetch useful references
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index for the arrow (or whatever item the task requires)
    goal_idx = env.task.goal

    # Primitive ingredients required for the goal (kind_index -> count)
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the recipe requires a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    wk = recipe.get('_at')
    workshop_kind = None
    if wk is not None:
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan moves from start to target (ignores obstacles)
    # Action IDs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell containing at least one entity of `kind`
    # Returns (row, col) tuple or None if not found.
    # ------------------------------------------------------------------
    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # Primitive missing from the map; skip collection.
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE to pick up the primitive

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and perform final crafting
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
    # Final USE to craft the goal at the current location (or wherever the
    # workshop was, if applicable).
    actions.append(4)

    return actions


