    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)

    # Work on a copy of the grid so we can “consume” items as we pick them up
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)  # (row, col)

    def manhattan_path(src, dst):
        """Return a list of movement actions to go from src to dst (Manhattan distance)."""
        actions = []
        sr, sc = src
        dr, dc = dst
        if dr > sr:
            actions += [DOWN] * (dr - sr)
        elif dr < sr:
            actions += [UP] * (sr - dr)
        if dc > sc:
            actions += [RIGHT] * (dc - sc)
        elif dc < sc:
            actions += [LEFT] * (sc - dc)
        return actions

    def nearest(pos, kind):
        """Find the nearest cell containing the given kind (ignoring empty cells)."""
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        idx = dists.argmin()
        return tuple(cells[idx].tolist())

    actions = []

    # ----------------------------------------------------------------------
    # 1) Collect all required primitives for the arrow
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = nearest(cur_pos, prim_idx)
            if target is None:
                # Primitive not found – abort early
                return actions
            actions += manhattan_path(cur_pos, target)
            cur_pos = target
            actions.append(USE)          # pick up the primitive
            grid[target[0], target[1], prim_idx] = 0  # remove it from local view

    # ----------------------------------------------------------------------
    # 2) Go to the appropriate workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = nearest(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += manhattan_path(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions


