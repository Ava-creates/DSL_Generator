    # Reset environment and get current state/world
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Goal item
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Determine required primitive counts and workshop (if any)
    primitive_counts = world.cookbook.primitives_for(goal_idx)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    def find_locations(kind):
        """Return list of (x, y) positions where the grid contains the given kind."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Translate a step between adjacent cells into a direction action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise ValueError("Requested move is not between adjacent cells")

    def bfs(start, goal):
        """Return shortest path (list of positions) from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Build set of blocked cells (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        # BFS
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay put
        return [start]

    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # --------------------------------------------------------------
    # Collect each required primitive the needed number of times
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            locations = find_locations(prim_idx)
            if not locations:
                # Primitive might already be in inventory; skip
                continue
            target = locations[0]                     # pick first occurrence
            path = bfs(cur_pos, target)
            for step in path[1:]:                     # skip current position
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # Pick up the primitive (USE action)
            actions.append(4)

    # --------------------------------------------------------------
    # If a workshop is required, move to it and craft the arrow
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = wk_locs[0]
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # Use the workshop to craft the arrow
            actions.append(4)

    return actions


