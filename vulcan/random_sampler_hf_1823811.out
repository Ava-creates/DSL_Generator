                    # Allow stepping onto the goal even if it is occupied
                    if not state.grid[ny, nx, :].any() or (ny, nx) == goal:
                        visited[ny, nx] = True
                        prev[(ny, nx)] = (cur, act)
                        q.append((ny, nx))

        if start == goal:
            return []

        if goal not in prev:
            # No path found
            return []

        # Reconstruct actions
        rev_actions = []
        cur = goal
        while cur != start:
            prev_node, act = prev[cur]
            rev_actions.append(act)
            cur = prev_node
        rev_actions.reverse()
        return rev_actions

