    # Reset environment and extract useful objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # ------------------------------------------------------------
    # Identify the goal (arrow) and its requirements
    # ------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []   # unknown goal

    # Primitive items needed (recursively expanded) and workshop (if any)
    primitive_needs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # ------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Bread‑first search returning a list of positions from `start` (excluded)
        to `goal` (included). `occupied` is a bool mask where True means blocked.
        The goal cell may be occupied (e.g., a workshop)."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path (exclude start, include goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Map a movement delta to the corresponding action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ------------------------------------------------------------
    # Begin constructing the action sequence
    # ------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # current agent location
    grid = state.grid.copy()            # mutable copy to track collected items

    # ------------------------------------------------------------
    # Utility to locate the nearest reachable primitive of a given kind
    # ------------------------------------------------------------
    def find_nearest(kind_idx, cur):
        """Return (target_cell, path) for the closest reachable primitive."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None, None
        # order by Manhattan distance
        dists = np.abs(locations[:, 0] - cur[0]) + np.abs(locations[:, 1] - cur[1])
        order = np.argsort(dists)
        occupied_mask = np.any(grid, axis=2)
        for i in order:
            target = tuple(locations[i])
            path = bfs_path(cur, target, occupied_mask)
            if path is not None:
                return target, path
        return None, None

    # ------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------
    for kind_idx, needed in list(primitive_needs.items()):
        for _ in range(needed):
            target, path = find_nearest(kind_idx, cur_pos)
            if target is None:
                # No reachable instance; give up on this primitive
                continue
            # Follow the path to the primitive
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # Pick it up
            actions.append(4)                     # USE
            grid[target[0], target[1], kind_idx] = 0   # remove from copy

    # ------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            # Choose the nearest workshop
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops are blocked)
            for i in order:
                target = tuple(workshop_cells[i])
                path = bfs_path(cur_pos, target, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # No specific workshop – craft at current location
        actions.append(4)   # USE to trigger crafting

    return actions


    # Reset environment and fetch useful handles
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Identify goal item and its recipe
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []                       # unknown goal

    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Return a walkable path (list of positions) from start to goal.
        `occupied` is a bool mask where True means blocked. Goal cell may be occupied.
        """
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Allow stepping onto the goal even if it is occupied
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path (exclude start, include goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Convert a movement delta into an action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ------------------------------------------------------------------
    # Planning state
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # (x, y)
    # mutable copy of the grid to keep track of which primitives are still present
    grid = state.grid.copy()

    # ------------------------------------------------------------------
    # Collect all required primitive resources
    # ------------------------------------------------------------------
    def find_nearest(kind_idx, cur):
        """Return (target_cell, path) for the closest reachable primitive of given kind."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None, None
        # Manhattan distance ordering
        dists = np.abs(locations[:, 0] - cur[0]) + np.abs(locations[:, 1] - cur[1])
        order = np.argsort(dists)
        occupied_mask = np.any(grid, axis=2)   # cells occupied by any entity
        for idx in order:
            target = tuple(locations[idx])
            path = bfs_path(cur, target, occupied_mask)
            if path is not None:
                return target, path
        return None, None

    for kind_idx, needed in list(primitive_needs.items()):
        for _ in range(needed):
            target, path = find_nearest(kind_idx, cur_pos)
            if target is None:
                # No reachable instance left; give up on this primitive
                continue
            # Follow the path to the primitive
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # Pick it up
            actions.append(4)                     # USE
            # Remove it from our mutable copy so we don't try to collect it again
            grid[target[0], target[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            # Choose the closest workshop cell
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops are occupied)
            for idx in order:
                target = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, target, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # No specific workshop required – craft at current location
        actions.append(4)   # USE

    return actions

