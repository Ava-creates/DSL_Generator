    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # name ↔ id mapping

    # Action indices from the environment spec
    act_map = env.action_specs()
    DOWN = act_map["DOWN"]
    UP = act_map["UP"]
    LEFT = act_map["LEFT"]
    RIGHT = act_map["RIGHT"]
    USE = act_map["USE"]

    # ------------------------------------------------------------------
    # Identify the goal item ('arrow') and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                     # Arrow not defined in this world
    goal_idx = index[goal_name]        # integer id of the arrow item
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                       # will hold the resulting action list

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions from start to target.
    # All occupied cells are treated as obstacles, except the target cell.
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def _bfs_path(start, target):
        """Return a list of move actions to reach `target` from `start`."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        moves = [(DOWN, (1, 0)),
                 (UP,   (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT,(0, 1))]
        queue = deque([start])
        visited = {start}
        parent = {}                     # child -> (parent, action)

        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        if target not in parent and start != target:
            return []   # no path found

        # Reconstruct path backwards.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive (respecting multiplicities).
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            # Locate the nearest cell containing this primitive.
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return actions               # primitive unavailable, abort
            # Choose the cell with minimal Manhattan distance to current pos.
            dists = np.abs(cells[:, 0] - state.pos[0]) + np.abs(cells[:, 1] - state.pos[1])
            target_cell = tuple(cells[dists.argmin()])

            # Move to the primitive cell.
            move_seq = _bfs_path(state.pos, target_cell)
            actions.extend(move_seq)
            state.pos = target_cell

            # Pick it up.
            actions.append(USE)

            # Update our local copy of the state.
            state.inventory[prim_idx] += 1
            tr, tc = target_cell
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # no workshop info, finish early

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # workshop not present

    # Choose the nearest workshop cell.
    dists = np.abs(workshop_cells[:, 0] - state.pos[0]) + np.abs(workshop_cells[:, 1] - state.pos[1])
    wr, wc = tuple(workshop_cells[dists.argmin()])

    # Move to the workshop.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions

