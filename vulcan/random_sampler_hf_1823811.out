    # ----------------------------------------------------------------------
    # 2. Go to the workshop (if any) and craft the goal item.
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            go_to(ws_positions[0])
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)

    # Return the complete action list.
    return actions

