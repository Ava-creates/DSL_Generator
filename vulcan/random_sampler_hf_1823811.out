    """Improved version of `make_arrow_v1`."""
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _cell_blocked(pos, grid):
        """Return True if the cell at `pos` contains any non‑empty entity."""
        x, y = pos
        return grid[x, y, :].any()

    def _bfs_path(start, goal, grid):
        """Shortest path from start to goal using BFS (allow stepping onto goal)."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        # permit moving onto the goal even if occupied
                        if not _cell_blocked(nxt, grid) or nxt == goal:
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of positions into a list of action indices."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, grid):
        """Return actions moving from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(src, dst, grid)
        if path is None:
            # Manhattan fallback (may collide with obstacles)
            acts = []
            x, y = src
            tx, ty = dst
            if tx > x:
                acts += [DOWN] * (tx - x)
            elif tx < x:
                acts += [UP] * (x - tx)
            if ty > y:
                acts += [RIGHT] * (ty - y)
            elif ty < y:
                acts += [LEFT] * (y - ty)
            return acts
        return _actions_from_path(path)

    def _nearest_entity(pos, kind_idx, grid, excluded):
        """Find the nearest cell containing `kind_idx` not in `excluded`."""
        candidates = np.argwhere(grid[:, :, kind_idx] > 0)
        if candidates.size == 0:
            return None
        if excluded:
            mask = np.array([tuple(c) not in excluded for c in candidates])
            candidates = candidates[mask]
            if candidates.size == 0:
                return None
        dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
        nearest = candidates[dists.argmin()]
        return tuple(nearest.tolist())

