    env.reset()
    state = env._current_state
    world = env.world

    goal_idx = env.task.goal
    action_map = env.action_specs()
    ACTION_DOWN = action_map['DOWN']
    ACTION_UP = action_map['UP']
    ACTION_LEFT = action_map['LEFT']
    ACTION_RIGHT = action_map['RIGHT']
    ACTION_USE = action_map['USE']

    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    def find_path(cur_state, target_kind):
        """BFS returning a list of movement actions that brings the agent to a cell
        containing `target_kind`. The agent may step onto empty cells or the target
        cell itself; all other occupied cells are treated as obstacles."""
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                cell = grid[nx, ny, :]
                # allow moving onto empty cells or directly onto the target cell
                if cell.sum() == 0 or cell[target_kind] > 0:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        # No path found – return empty list (should not happen in valid scenarios)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    for prim_kind, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, prim_kind)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # Pick up the primitive now under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions


    # Reset environment and get current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Goal item index
    goal_idx = env.task.goal

    # Action indices from the environment spec
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    # Direction vectors paired with their corresponding action ids
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions leading to the
    # nearest cell containing `target_kind`. Cells occupied by any
    # non‑grabbable entity are treated as obstacles.
    # ------------------------------------------------------------------
    import collections

    def bfs_path(cur_state, target_kind):
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # treat any non‑grabbable entity as a wall
                blocked = any(grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)
                if blocked:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        return None  # unreachable

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources.
    # ------------------------------------------------------------------
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    for prim_kind, cnt in required.items():
        for _ in range(cnt):
            path = bfs_path(state, prim_kind)
            if path is None:
                raise RuntimeError(f"Primitive {prim_kind} not reachable")
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # Pick up the primitive that is now under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = bfs_path(state, workshop_kind)
        if path is None:
            raise RuntimeError("Workshop not reachable")
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        # Use the workshop to craft the goal item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

