    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to find a shortest path (as a list of movement actions)
    # from the current position to any cell that contains the desired kind.
    # ------------------------------------------------------------------
    def find_path_to(state, target_kind):
        grid = state.grid
        H, W, _ = grid.shape
        start = state.pos
        visited = set([start])
        from collections import deque
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    visited.add((nx, ny))
