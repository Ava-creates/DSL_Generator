    import numpy as np
    from collections import deque

    # Reset environment to a fresh start
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Goal definition
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for one arrow
    primitive_reqs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Determine required workshop (if any)
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # Helper: occupancy mask (True = blocked)
    occupancy = np.any(state.grid > 0, axis=2)

    # Helper: BFS path finder returning list of actions (ints)
    DIRS = [
        (0, 1, 0),   # DOWN
        (0, -1, 1),  # UP
        (-1, 0, 2),  # LEFT
        (1, 0, 3),   # RIGHT
    ]

    def bfs_path(start, goal, occ):
        """Return list of action indices to move from start to goal avoiding blocked cells."""
        if start == goal:
            return []
        q = deque([start])
        visited = {start: (None, None)}  # node -> (prev_node, action_to_here)
        while q:
            x, y = q.popleft()
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < occ.shape[0] and 0 <= ny < occ.shape[1]:
                    if not occ[nx, ny] and (nx, ny) not in visited:
                        visited[(nx, ny)] = ((x, y), act)
                        if (nx, ny) == goal:
                            # reconstruct path
                            path_actions = []
                            cur = (nx, ny)
                            while visited[cur][0] is not None:
                                prev, a = visited[cur]
                                path_actions.append(a)
                                cur = prev
                            path_actions.reverse()
                            return path_actions
                        q.append((nx, ny))
        # No path found
        return []

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for kind_idx, needed in primitive_reqs.items():
        # locations where this primitive currently exists
        prim_cells = np.argwhere(state.grid[:, :, kind_idx] > 0)
        if prim_cells.size == 0:
            continue  # nothing to collect; skip

        # Cycle through available locations if needed > number of cells
        for i in range(needed):
            target = tuple(prim_cells[i % len(prim_cells)])

            # Find a walkable neighbor of the target to stand on
            neighbor = None
            for dx, dy, act in DIRS:
                nx, ny = target[0] - dx, target[1] - dy  # neighbor cell opposite direction
                if 0 <= nx < occupancy.shape[0] and 0 <= ny < occupancy.shape[1]:
                    if not occupancy[nx, ny]:
                        neighbor = (nx, ny)
                        break
            if neighbor is None:
                # fallback: try any adjacent empty cell
                for dx, dy, _ in DIRS:
                    nx, ny = target[0] + dx, target[1] + dy
                    if 0 <= nx < occupancy.shape[0] and 0 <= ny < occupancy.shape[1]:
                        if not occupancy[nx, ny]:
                            neighbor = (nx, ny)
                            break
            if neighbor is None:
                # cannot reach this primitive, skip it
                continue

            # Move to neighbor
            path = bfs_path(cur_pos, neighbor, occupancy)
            actions.extend(path)
            cur_pos = neighbor

            # Use to collect the primitive
            actions.append(4)  # USE

            # Update occupancy: the primitive cell becomes empty after collection
            occupancy[target] = False

    # ------------------------------------------------------------------
    # Go to workshop and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            workshop = tuple(workshop_cells[0])

            # Find walkable neighbor of workshop
            neighbor = None
            for dx, dy, act in DIRS:
                nx, ny = workshop[0] - dx, workshop[1] - dy
                if 0 <= nx < occupancy.shape[0] and 0 <= ny < occupancy.shape[1]:
                    if not occupancy[nx, ny]:
                        neighbor = (nx, ny)
                        break
            if neighbor is None:
                for dx, dy, _ in DIRS:
                    nx, ny = workshop[0] + dx, workshop[1] + dy
                    if 0 <= nx < occupancy.shape[0] and 0 <= ny < occupancy.shape[1]:
                        if not occupancy[nx, ny]:
                            neighbor = (nx, ny)
                            break

            if neighbor is not None:
                path = bfs_path(cur_pos, neighbor, occupancy)
                actions.extend(path)
                cur_pos = neighbor
                # Use to craft the arrow at the workshop
                actions.append(4)  # USE

    # Return the compiled action sequence
    return actions


    # Reset the environment and get initial state
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Define the goal item
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Determine primitive requirements for one arrow
    primitive_reqs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Find the required workshop (if any) for the arrow recipe
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    actions = []
    cur_pos = tuple(state.pos)

    def move_to(cur, target):
        """Append moves to `actions` to go from cur to target using Manhattan steps."""
        x, y = cur
        tx, ty = target
        while x < tx:
            actions.append(3)   # RIGHT
            x += 1
        while x > tx:
            actions.append(2)   # LEFT
            x -= 1
        while y < ty:
            actions.append(0)   # DOWN
            y += 1
        while y > ty:
            actions.append(1)   # UP
            y -= 1
        return (x, y)

    # Collect each required primitive the needed number of times
    for kind_idx, needed in primitive_reqs.items():
        for _ in range(needed):
            # Find any cell that currently holds this primitive
            locations = np.argwhere(state.grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # No more of this primitive on the map; give up early
                break
            target = tuple(locations[0])
            cur_pos = move_to(cur_pos, target)
            actions.append(4)   # USE to pick up the primitive

    # Move to the workshop (if required) and craft the arrow
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            cur_pos = move_to(cur_pos, tuple(workshop_cells[0]))
            actions.append(4)   # USE to trigger crafting

    return actions

