    # ----------------------------------------------------------------------
    # Basic setup: retrieve mappings, scenario/world, and goal index for "arrow".
    # ----------------------------------------------------------------------
    act_map = env.action_specs()                     # name → int
    move_names = ["DOWN", "UP", "LEFT", "RIGHT"]
    move_deltas = {
        "DOWN": (1, 0),
        "UP": (-1, 0),
        "LEFT": (0, -1),
        "RIGHT": (0, 1),
    }
    name_to_action = {name: act_map[name] for name in act_map}

    # Scenario / world may be stored under different attribute names.
    scenario = getattr(env, "scenario", None) or getattr(env, "scn", None)
    world = getattr(env, "world", None) or getattr(env, "wrld", None)
    if scenario is None or world is None:
        raise RuntimeError("Could not locate scenario or world inside env.")

    # Goal index for the item "arrow".
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Goal 'arrow' not found in cookbook.")

    # ----------------------------------------------------------------------
    # Extract recipe information: required primitives and workshop location.
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")                     # may be None
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind: count}

    # ----------------------------------------------------------------------
    # Working copies of the grid and occupancy mask.
    # ----------------------------------------------------------------------
    grid = scenario.init_grid.copy()          # (W, H, n_kinds)
    occ = grid.sum(axis=2) > 0                # True where any entity occupies the cell
    cur_pos = tuple(scenario.init_pos)        # (row, col)

    actions = []                               # final action list to return

    # ----------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of move names from start
    # to a target cell (inclusive). Returns [] if no path found.
    # ----------------------------------------------------------------------
    from collections import deque

    def bfs_path(start, target, occ_mask):
        """Return list of move names to go from start to target (standing on target)."""
        if start == target:
            return []
        rows, cols = occ_mask.shape
        q = deque([start])
        parent = {start: None}
        parent_move = {}
        while q:
            r, c = q.popleft()
            for mname in move_names:
                dr, dc = move_deltas[mname]
                nr, nc = r + dr, c + dc
                if 0 <= nr < rows and 0 <= nc < cols and not occ_mask[nr, nc]:
                    if (nr, nc) not in parent:
                        parent[(nr, nc)] = (r, c)
                        parent_move[(nr, nc)] = mname
                        if (nr, nc) == target:
                            # reconstruct path
                            path = []
                            cur = (nr, nc)
                            while parent[cur] is not None:
                                path.append(parent_move[cur])
                                cur = parent[cur]
                            path.reverse()
                            return path
                        q.append((nr, nc))
        return []  # unreachable

    # ----------------------------------------------------------------------
    # Helper: execute a list of move names, updating cur_pos and actions.
    # ----------------------------------------------------------------------
    def follow_path(path):
        nonlocal cur_pos
        for mname in path:
            actions.append(name_to_action[mname])
            dr, dc = move_deltas[mname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ----------------------------------------------------------------------
    # 1) Collect all required primitives (respecting needed counts).
    # ----------------------------------------------------------------------
    for prim_kind, count_needed in primitives_needed.items():
        for _ in range(count_needed):
            # locate all remaining cells that still contain this primitive
            ys, xs = np.where(grid[:, :, prim_kind] > 0)
            if len(xs) == 0:
                # nothing left – break early
                break
            # pick the nearest one (Manhattan distance)
            candidates = list(zip(ys, xs))   # (row, col)
            target = min(candidates,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            # move to that cell
            path = bfs_path(cur_pos, target, occ)
            follow_path(path)
            # pick it up
            actions.append(name_to_action["USE"])
            # update grid / occupancy
            tr, tc = target
            grid[tr, tc, :] = 0
            occ[tr, tc] = False

    # ----------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        wy, wx = np.where(grid[:, :, workshop_kind] > 0)
        if len(wx) == 0:
            # workshop might have been removed from mutable copy; fall back to original layout
            wy, wx = np.where(scenario.init_grid[:, :, workshop_kind] > 0)
        if len(wx) > 0:
            workshop_pos = (wy[0], wx[0])   # (row, col)
            path = bfs_path(cur_pos, workshop_pos, occ)
            follow_path(path)
            actions.append(name_to_action["USE"])
    else:
        # No dedicated workshop – just use at current location.
        actions.append(name_to_action["USE"])

    return actions


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Basic environment introspection
    # ----------------------------------------------------------------------
    # Action mapping (name -> integer)
    act_map = env.action_specs()
    # Ensure we have the five standard actions
    required_names = {"DOWN", "UP", "LEFT", "RIGHT", "USE"}
    if not required_names.issubset(set(act_map)):
        raise RuntimeError("Environment missing required actions.")

    # Helper: map direction name to movement delta (dx, dy)
    moves = [
        (0, 1, "DOWN"),
        (0, -1, "UP"),
        (-1, 0, "LEFT"),
        (1, 0, "RIGHT"),
    ]
    name_to_delta = {name: (dx, dy) for dx, dy, name in moves}
    name_to_action = {name: act_map[name] for name in required_names}

    # Retrieve scenario and world objects (different attribute names possible)
    scenario = getattr(env, "scenario", None) or getattr(env, "scn", None)
    world = getattr(env, "world", None) or getattr(env, "wrld", None)
    if scenario is None or world is None:
        raise RuntimeError("Could not locate scenario or world in the env.")

    # Goal index for "arrow"
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Goal 'arrow' not found in cookbook.")

    # ----------------------------------------------------------------------
    # Recipe information
    # ----------------------------------------------------------------------
    # Mapping primitive_kind -> count needed for one arrow
    primitives_needed = world.cookbook.primitives_for(goal_idx)
    # Workshop kind (may be None)
    workshop_kind = world.cookbook.recipes.get(goal_idx, {}).get("_at")

    # ----------------------------------------------------------------------
    # Working copy of the grid and occupancy mask
    # ----------------------------------------------------------------------
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0          # True where any entity occupies the cell
    cur_pos = tuple(scenario.init_pos)  # (x, y)

    actions = []

    # ----------------------------------------------------------------------
    # Helper: BFS to a free neighbour of a target cell
    # ----------------------------------------------------------------------
    def bfs_adj(start, target, occ_mask):
        """Return list of direction names to reach a free neighbour of target."""
        tx, ty = target
        # All free neighbours of target that are walkable
        neighbours = [
            (tx + dx, ty + dy, name)
            for dx, dy, name in moves
            if 0 <= tx + dx < occ_mask.shape[0]
            and 0 <= ty + dy < occ_mask.shape[1]
            and not occ_mask[tx + dx, ty + dy]
        ]
        if not neighbours:
            return []  # No accessible neighbour

        # BFS from start
        q = deque([start])
        parent = {start: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if any(cur == (nx, ny) for nx, ny, _ in neighbours):
                # Reconstruct path
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path
            cx, cy = cur
            for dx, dy, name in moves:
                nx, ny = cx + dx, cy + dy
                if (
                    0 <= nx < occ_mask.shape[0]
                    and 0 <= ny < occ_mask.shape[1]
                    and not occ_mask[nx, ny]
                    and (nx, ny) not in parent
                ):
                    parent[(nx, ny)] = cur
                    parent_move[(nx, ny)] = name
                    q.append((nx, ny))
        return []  # No path found

    # ----------------------------------------------------------------------
    # Helper: execute a path of direction names, updating position and actions
    # ----------------------------------------------------------------------
    def follow(path):
        nonlocal cur_pos
        for dname in path:
            actions.append(name_to_action[dname])
            dx, dy = name_to_delta[dname]
            cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)

    # ----------------------------------------------------------------------
    # Collect required primitives
    # ----------------------------------------------------------------------
    for prim_kind, count_needed in primitives_needed.items():
        for _ in range(count_needed):
            # Locate any remaining instance of this primitive
            xs, ys = np.where(grid[:, :, prim_kind] > 0)
            if len(xs) == 0:
                # No more of this primitive on the map – give up
                break
            # Choose the closest instance (Manhattan distance)
            candidates = list(zip(xs, ys))  # (x, y) pairs
            target = min(
                candidates,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )
            # Move to a free neighbour of the primitive
            path = bfs_adj(cur_pos, target, occ)
            follow(path)
            # Pick up the primitive
            actions.append(name_to_action["USE"])
            # Update grid and occupancy mask
            tx, ty = target
            grid[tx, ty, :] = 0
            occ[tx, ty] = False

    # ----------------------------------------------------------------------
    # Go to workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        wxs, wys = np.where(grid[:, :, workshop_kind] > 0)
        if len(wxs) == 0:
            # Workshop might have been removed from the mutable copy; fall back to original grid
            wxs, wys = np.where(scenario.init_grid[:, :, workshop_kind] > 0)
        if len(wxs) > 0:
            workshop_pos = (wxs[0], wys[0])
            path = bfs_adj(cur_pos, workshop_pos, occ)
            follow(path)
            actions.append(name_to_action["USE"])
    else:
        # No specific workshop – just use at current location
        actions.append(name_to_action["USE"])

    return actions

