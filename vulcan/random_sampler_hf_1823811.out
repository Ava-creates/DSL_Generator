    # Reset the environment to obtain a fresh state.
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Index of the goal item (arrow).
    goal_idx = env.task.goal

    # Primitive ingredients required to craft the goal.
    required = world.cookbook.primitives_for(goal_idx)

    # Find the workshop kind needed for this recipe (if any).
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop = recipe.get('_at')
    if workshop is None:
        workshop_kind = None
    else:
        workshop_kind = workshop if isinstance(workshop, int) else world.cookbook.index[workshop]

    actions = []
    cur_pos = tuple(state.pos)

    # Helper: generate Manhattan moves from start to target.
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # Helper: locate the nearest cell containing a given kind.
    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # Collect all required primitive items.
    for kind, count in required.items():
        for _ in range(count):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # If the primitive cannot be found, skip it.
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE to pick up the primitive

    # Move to the workshop (if needed) and craft the goal.
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE to craft at the workshop

    return actions


    # reset environment to a fresh start and grab the internal state
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    cw = world.cookbook                  # Cookbook instance

    # ------------------------------------------------------------------
    # Goal configuration
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cw.index[goal_name]       # integer id of the goal item

    # primitives required to craft the goal (primitive idx → count)
    needed = cw.primitives_for(goal_idx).copy()

    # workshop type where the goal must be crafted
    workshop_type = cw.recipes[goal_idx].get("_at", None)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    # movement direction vectors and corresponding action ids (as defined in CraftLab)
    MOVE_DELTAS = [(0, 1, 0),   # DOWN
                   (0, -1, 1),  # UP
                   (-1, 0, 2),  # LEFT
                   (1, 0, 3)]   # RIGHT

    width, height, n_kinds = state.grid.shape

    def occupied_mask(grid):
        """Boolean mask of cells that cannot be entered (any non‑zero kind)."""
        return np.any(grid > 0, axis=2)

    occ = occupied_mask(state.grid)

    def in_bounds(x, y):
        return 0 <= x < width and 0 <= y < height

    def adjacent_positions(x, y):
        """All positions that are orthogonally adjacent to (x, y)."""
        for dx, dy, _ in MOVE_DELTAS:
            nx, ny = x + dx, y + dy
            if in_bounds(nx, ny):
                yield (nx, ny)

    def bfs_path(start, targets, occ_mask):
        """
        Bread‑first search from ``start`` to any cell in ``targets`` that is free.
        Returns a list of action ids (movement only). If no path exists,
        returns an empty list.
        """
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in targets:
                return path
            for dx, dy, act in MOVE_DELTAS:
                nx, ny = cx + dx, cy + dy
                if not in_bounds(nx, ny):
                    continue
                if occ_mask[ny, nx]:      # note: numpy uses (y, x) ordering
                    continue
                if (nx, ny) in visited:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        return []   # unreachable

    # ------------------------------------------------------------------
    # Main planning loop
    # ------------------------------------------------------------------
    actions = []   # the final action list to be returned

    while not state.satisfies(goal_name, goal_idx):
        # --------------------------------------------------------------
        # 1) Collect needed primitives (if any remain)
        # --------------------------------------------------------------
        if any(cnt > 0 for cnt in needed.values()):
            # pick a primitive type that is still required
            for prim_idx, cnt in list(needed.items()):
                if cnt <= 0:
                    continue
                # locate all cells that currently contain this primitive
                prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
                if prim_cells.size == 0:
                    # nothing left of this primitive – should not happen
                    continue
                # choose the closest primitive cell (Manhattan distance)
                cur_x, cur_y = state.pos
                dists = np.abs(prim_cells - np.array([cur_x, cur_y])).sum(axis=1)
                target_cell = tuple(prim_cells[dists.argmin()])   # (x, y)

                # compute all free cells that are adjacent to the target primitive
                adj_free = {
                    (ax, ay)
                    for ax, ay in adjacent_positions(*target_cell)
                    if not occ[ay, ax]   # free cell
                }

                # find a path to one of those free adjacent cells
                path = bfs_path(state.pos, adj_free, occ)
                if not path:
                    raise RuntimeError("No path to required primitive")

                # execute the movement actions
                for act in path:
                    reward, done, _ = env.step(act)
                    actions.append(act)
                    state = env._current_state
                    occ = occupied_mask(state.grid)

                # now we are adjacent; issue a USE action to pick up the primitive
                reward, done, _ = env.step(4)   # 4 == USE
                actions.append(4)
                state = env._current_state
                occ = occupied_mask(state.grid)

                # update bookkeeping
                needed[prim_idx] -= 1
                break   # re‑evaluate the outer while‑condition
            continue   # go back to while loop start

        # --------------------------------------------------------------
        # 2) All primitives collected – go to the appropriate workshop
        # --------------------------------------------------------------
        if workshop_type is None:
            raise RuntimeError("Goal has no associated workshop")
        # locate any workshop cell of the required type
        workshop_cells = np.argwhere(state.grid[:, :, workshop_type] > 0)
        if workshop_cells.size == 0:
            raise RuntimeError("No workshop of required type found")
        # pick the closest workshop
        cur_x, cur_y = state.pos
        dists = np.abs(workshop_cells - np.array([cur_x, cur_y])).sum(axis=1)
        workshop_target = tuple(workshop_cells[dists.argmin()])   # (x, y)

        # free cells adjacent to the workshop
        adj_free = {
            (ax, ay)
            for ax, ay in adjacent_positions(*workshop_target)
            if not occ[ay, ax]
        }

        path = bfs_path(state.pos, adj_free, occ)
        if not path:
            raise RuntimeError("No path to workshop")

        for act in path:
            reward, done, _ = env.step(act)
            actions.append(act)
            state = env._current_state
            occ = occupied_mask(state.grid)

        # use the workshop to craft the goal item
        reward, done, _ = env.step(4)   # USE
        actions.append(4)
        state = env._current_state
        # after crafting the loop will exit because the goal is satisfied

    return actions

