    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Identify goal and its recipe.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []

    primitive_needs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Return a walkable path (list of positions) from start (excluded) to goal (included)."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Goal cell may be occupied (e.g., contains the primitive or workshop)
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # Reconstruct path backwards.
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Map a movement delta to the environment's action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ------------------------------------------------------------------
    # Planning state.
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # (x, y)
    grid = state.grid.copy()            # mutable copy to track remaining primitives

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources.
    # ------------------------------------------------------------------
    for kind_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find all remaining instances of this primitive.
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                break  # none left
            # Order by Manhattan distance from current position.
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked
            target = None
            path = None
            for idx in order:
                cand = tuple(locations[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    target = cand
                    path = p
                    break
            if target is None:
                break  # cannot reach any remaining instance

            # Follow the path to the primitive.
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # Pick it up.
            actions.append(4)                     # USE
            grid[target[0], target[1], kind_idx] = 0   # mark as collected

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block)
            for idx in order:
                w_target = tuple(workshop_cells[idx])
                w_path = bfs_path(cur_pos, w_target, occupied_mask)
                if w_path is not None:
                    for step in w_path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # No specific workshop required – craft at current location.
        actions.append(4)   # USE

    return actions


    # Reset environment and fetch useful references
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # ------------------------------------------------------------------
    # Identify the goal item ("arrow") and its recipe.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []                       # unknown goal

    # Primitive requirements for one arrow
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Return a walkable path (list of positions) from start (excluded) to goal (included).
        `occupied` is a bool mask where True means blocked. Goal cell may be occupied.
        """
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Allow stepping onto the goal even if occupied.
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # Reconstruct path (exclude start, include goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Map a movement delta to the environment's action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ------------------------------------------------------------------
    # Planning state
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # current (x, y)
    # mutable copy of the grid to track which primitives are still present
    grid = state.grid.copy()

    # ------------------------------------------------------------------
    # Helper to locate the nearest reachable primitive of a given kind.
    # ------------------------------------------------------------------
    def nearest_primitive(kind_idx, cur):
        """Find the closest reachable cell containing `kind_idx`.
        Returns (target_position, path) or (None, None) if none reachable."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None, None
        # Manhattan distances for ordering
        dists = np.abs(locations[:, 0] - cur[0]) + np.abs(locations[:, 1] - cur[1])
        order = np.argsort(dists)
        occupied_mask = np.any(grid, axis=2)   # any entity blocks movement
        for idx in order:
            target = tuple(locations[idx])
            path = bfs_path(cur, target, occupied_mask)
            if path is not None:
                return target, path
        return None, None

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources.
    # ------------------------------------------------------------------
    for kind_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            target, path = nearest_primitive(kind_idx, cur_pos)
            if target is None:
                # No reachable instance left; give up on this primitive.
                continue
            # Follow the path, emitting movement actions.
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # Pick up the primitive.
            actions.append(4)                     # USE
            grid[target[0], target[1], kind_idx] = 0   # mark as collected

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        # Find all workshop cells of the required type.
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block)
            for idx in order:
                w_target = tuple(workshop_cells[idx])
                w_path = bfs_path(cur_pos, w_target, occupied_mask)
                if w_path is not None:
                    for step in w_path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # No specific workshop required – craft at current location.
        actions.append(4)   # USE

    return actions

