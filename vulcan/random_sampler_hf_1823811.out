            actions.append(4)                     # USE to pick up
            state.inventory[p_idx] += 1
            state.grid[target[0], target[1], p_idx] = 0

    # Move to workshop if needed
    if workshop_kind is not None:
        wk_locs = find_locs(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_act(cur_pos, step))
                cur_pos = step

    # Craft the arrow
    actions.append(4)  # USE

    return actions


    # Reset environment to a fresh state
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world
    idx = world.cookbook.index

    # --------------------------------------------------------------
    # Identify the goal (arrow) and its requirements
    # --------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive counts needed to craft one arrow (recursively expanded)
    needed_prims = world.cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}

    # Determine if a specific workshop is required for crafting the arrow
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    def find_positions(kind):
        """Return a list of (x, y) coordinates where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal):
        """Return the shortest 4‑connected path from `start` to `goal`
        avoiding cells occupied by non‑grabbable entities."""
        if start == goal:
            return [start]
        w, h = state.grid.shape[:2]

        # Build a set of blocked cells (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No reachable path – stay in place
        return [start]

    def to_action(cur, nxt):
        """Convert a step from `cur` to adjacent `nxt` into a DMLab action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("Step is not adjacent")

    # --------------------------------------------------------------
    # Build the action sequence
    # --------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) Collect all required primitive resources
    for prim_idx, required_qty in needed_prims.items():
        while state.inventory[prim_idx] < required_qty:
            # Locate all remaining instances of this primitive on the map
            candidates = find_positions(prim_idx)
            if not candidates:
                # No more of this primitive available – abort collection loop
                break

            # Choose the nearest instance (Manhattan distance)
            target = min(
                candidates,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )

            # Move to the selected primitive
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(to_action(cur_pos, step))
                cur_pos = step

            # Pick it up
            actions.append(4)                      # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2) If a workshop is required, move to the nearest one
    if workshop_kind is not None:
        wk_locations = find_positions(workshop_kind)
        if wk_locations:
            target = min(
                wk_locations,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(to_action(cur_pos, step))
                cur_pos = step

    # 3) Craft the arrow (USE at current location)
    actions.append(4)  # USE

    return actions

