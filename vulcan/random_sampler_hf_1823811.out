    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    idx = cookbook.index

    # action indices
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []
    goal_idx = idx[goal_name]

    # primitives required to craft the goal
    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    from collections import deque

    def bfs_path(start, target):
        """Return a list of move actions from start to target (target may be occupied)."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # treat occupied cells as obstacles unless it's the destination
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []
        # reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def nearest_cell(start, kind_idx):
        """BFS to the closest cell that contains `kind_idx`."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # block unless the cell holds the desired kind
                if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # reconstruct path to this cell
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None

    # 1. Collect required primitives
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            path, cell = nearest_cell(state.pos, prim_idx)
            if cell is None:
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[cell[0], cell[1], prim_idx] = 0

    # 2. Move to the workshop and craft the arrow
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions
    workshop_idx = idx[workshop_name]
    path, cell = nearest_cell(state.pos, workshop_idx)
    if cell is not None:
        actions.extend(path)
        state.pos = cell
        actions.append(USE)

    return actions


    # Reset environment and get handles to the underlying state and world.
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.scenario.world          # CraftWorld instance
    cookbook = world.cookbook           # Cookbook with recipes etc.
    idx = cookbook.index                # Index mapping names ↔ integer IDs

    # Action indices (derived from the environment's spec for safety)
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    # Goal we want to craft.
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []                       # Arrow not defined in this world.
    goal_idx = idx[goal_name]

    # Primitive requirements for the goal (may be empty if goal is primitive).
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                     # Will hold the final action sequence.

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of move actions from start to target.
    # Cells with any entity are treated as obstacles, except the target
    # cell itself (which may be occupied by the desired primitive or workshop).
    # ------------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        """Return a list of move actions to reach `target` from `start`."""
        if start == target:
            return []

        h, w = state.grid.shape[:2]
        queue = deque([start])
        visited = {start}
        parent = {}

        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        if target not in parent and start != target:
            return []                  # No path found.

        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Helper: Find the closest cell containing a given kind (primitive or workshop)
    # and return the path to it together with the cell coordinates.
    # ------------------------------------------------------------------
    def _nearest_cell(start, kind_idx):
        """BFS that stops at the first cell containing `kind_idx`."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start

        h, w = state.grid.shape[:2]
        queue = deque([start])
        visited = {start}
        parent = {}

        while queue:
            cur = queue.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Treat occupied cells as blocked unless they contain the target kind.
                if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # Reconstruct path to this cell.
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                queue.append(nxt)
        return [], None               # Not found.

    # ------------------------------------------------------------------
    # 1. Collect each required primitive (respecting multiplicities).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            path, cell = _nearest_cell(state.pos, prim_idx)
            if cell is None:
                # Primitive not reachable – abort early.
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)                     # Pick up the primitive.
            state.inventory[prim_idx] += 1
            state.grid[cell[0], cell[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the workshop for the goal and craft the item.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        # No workshop requirement – nothing more to do.
        return actions

    workshop_idx = idx[workshop_name]
    path, cell = _nearest_cell(state.pos, workshop_idx)
    if cell is None:
        # Workshop not reachable – abort.
        return actions
    actions.extend(path)
    state.pos = cell
    actions.append(USE)                     # Craft the arrow at the workshop.

    return actions

