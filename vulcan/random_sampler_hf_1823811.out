    import numpy as np
    from collections import deque

    # ----- reset and grab references -----
    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    index = cookbook.index                    # name ↔ id mapping

    # ----- constants for actions -----
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    action_from_delta = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, -1): LEFT,
        (0, 1): RIGHT,
    }

    # ----- helper: BFS path planning -----
    width, height = state.grid.shape[0], state.grid.shape[1]
    non_grabbable = set(world.non_grabbable_indices)

    def is_blocked(r, c):
        """Return True if cell (r,c) contains any non‑grabbable entity."""
        return any(state.grid[r, c, idx] > 0 for idx in non_grabbable)

    def bfs_path(start, targets):
        """Find shortest path from start to any cell in targets.
        Returns list of positions (r,c) *excluding* start, inclusive of target.
        If no path exists, returns None."""
        q = deque([start])
        visited = {start}
        parent = {start: None}
        while q:
            cur = q.popleft()
            if cur in targets:
                # reconstruct path
                path = []
                while parent[cur] is not None:
                    path.append(cur)
                    cur = parent[cur]
                path.reverse()
                return path
            r, c = cur
            for dr, dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                nr, nc = r+dr, c+dc
                if 0 <= nr < width and 0 <= nc < height:
                    if (nr, nc) not in visited and not is_blocked(nr, nc):
                        visited.add((nr, nc))
                        parent[(nr, nc)] = cur
                        q.append((nr, nc))
        return None

    # ----- identify goal (arrow) -----
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                     # arrow not defined in this world
    goal_idx = index[goal_name]

    # ----- primitive requirements -----
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # ----- collect each required primitive -----
    for prim_idx, need_cnt in primitive_needs.items():
        for _ in range(need_cnt):
            # locate all cells that currently hold this primitive
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return actions          # cannot find required primitive
            target_set = {tuple(cell) for cell in cells}

            # plan path to the nearest such cell
            path = bfs_path(state.pos, target_set)
            if path is None:
                return actions          # unreachable primitive

            # translate path into actions
            cur = state.pos
            for nxt in path:
                dr, dc = nxt[0] - cur[0], nxt[1] - cur[1]
                actions.append(action_from_delta[(dr, dc)])
                cur = nxt
            state.pos = cur               # update internal position

            # pick up the primitive
            actions.append(USE)
            state.inventory[prim_idx] += 1
            r, c = cur
            state.grid[r, c, prim_idx] = 0

    # ----- go to workshop and craft -----
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                 # no workshop info, cannot craft

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                 # no workshop present

    target_set = {tuple(cell) for cell in workshop_cells}
    path = bfs_path(state.pos, target_set)
    if path is None:
        return actions                 # cannot reach workshop

    cur = state.pos
    for nxt in path:
        dr, dc = nxt[0] - cur[0], nxt[1] - cur[1]
        actions.append(action_from_delta[(dr, dc)])
        cur = nxt
    state.pos = cur

    # craft the arrow
    actions.append(USE)

    return actions


    # Reset environment and get references
    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    index = cookbook.index                    # name ↔ id mapping

    # Goal identification
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []  # arrow not defined

    goal_idx = index[goal_name]

    # Primitive requirements for one arrow
    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS path finder returning a list of actions.
    # Allows stepping onto the goal cell even if it is occupied.
    # ------------------------------------------------------------------
    def _bfs_path(start, goal, allow_goal_occupied=True):
        """Return list of actions (DOWN,UP,LEFT,RIGHT) to move from start to goal.
        Returns None if no path is found."""
        w, h = state.grid.shape[:2]
        visited = np.full((w, h), False, dtype=bool)
        q = collections.deque()
        q.append(start)
        visited[start] = True
        parent = {}

        # direction vectors and corresponding action indices
        dirs = [(1, 0, 0),   # DOWN
                (-1, 0, 1),  # UP
                (0, -1, 2),  # LEFT
                (0, 1, 3)]   # RIGHT

        while q:
            r, c = q.popleft()
            if (r, c) == goal:
                break
            for dr, dc, act in dirs:
                nr, nc = r + dr, c + dc
                if not (0 <= nr < w and 0 <= nc < h):
                    continue
                if visited[nr, nc]:
                    continue
                occupied = state.grid[nr, nc, :].any()
                if occupied and not (allow_goal_occupied and (nr, nc) == goal):
                    continue
                visited[nr, nc] = True
                parent[(nr, nc)] = ((r, c), act)
                q.append((nr, nc))
        else:
            return None  # no path found

        # reconstruct actions
        path = []
        cur = goal
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # locate any remaining cell containing this primitive
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return actions  # cannot find required primitive

            tr, tc = cells[0]  # pick the first occurrence

            # plan movement to the primitive cell (standing on it is fine)
            move_seq = _bfs_path(state.pos, (tr, tc), allow_goal_occupied=True)
            if move_seq is None:
                return actions  # no reachable path

            actions.extend(move_seq)
            state.pos = (tr, tc)

            # pick up the primitive
            actions.append(4)  # USE action

            # update internal state representation
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # workshop information missing

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # no workshop found on the map

    wr, wc = workshop_cells[0]

    move_seq = _bfs_path(state.pos, (wr, wc), allow_goal_occupied=True)
    if move_seq is None:
        return actions  # cannot reach workshop

    actions.extend(move_seq)
    state.pos = (wr, wc)

    # craft the arrow
    actions.append(4)  # USE at the workshop

    return actions

