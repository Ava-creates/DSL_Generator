    # Reset environment and get references
    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    index = cookbook.index                    # name ↔ id mapping

    # Action identifiers (as defined in CraftLab)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Identify the goal (arrow) index
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []  # Arrow not defined in this world
    goal_idx = index[goal_name]

    # ------------------------------------------------------------------
    # Determine primitive requirements for one arrow (transitive)
    # ------------------------------------------------------------------
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # Helper: BFS path‑finder (4‑connected moves)
    # ------------------------------------------------------------------
    def bfs(start, target):
        """Return a list of positions from start to target (inclusive)
        using 4‑connected moves, treating any occupied cell as blocked
        except the target cell itself. Returns None if unreachable."""
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)          # any entity blocks movement
        occupied[target] = False                           # allow stepping onto target
        q = collections.deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:
                    nxt = (nr, nc)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        q.append(nxt)
        else:
            return None  # target never reached

        # Reconstruct path from start to target
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    # Mapping from movement delta to action index
    delta_to_action = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, 1): RIGHT,
        (0, -1): LEFT,
    }

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate any remaining instance of this primitive on the map
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # No more of this primitive; abort planning
                return plan

            target_r, target_c = cells[0]

            # Compute a path to the primitive
            path = bfs(state.pos, (target_r, target_c))
            if path is None:
                # Unreachable primitive; abort planning
                return plan

            # Translate path into actions and update simulated state
            for (r0, c0), (r1, c1) in zip(path, path[1:]):
                act = delta_to_action[(r1 - r0, c1 - c0)]
                plan.append(act)
                state.pos = (r1, c1)

            # Pick up the primitive
            plan.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[target_r, target_c, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return plan  # No workshop information; cannot craft

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return plan  # No workshop cell found

    w_r, w_c = workshop_cells[0]

    path = bfs(state.pos, (w_r, w_c))
    if path is None:
        return plan  # Workshop unreachable

    for (r0, c0), (r1, c1) in zip(path, path[1:]):
        act = delta_to_action[(r1 - r0, c1 - c0)]
        plan.append(act)
        state.pos = (r1, c1)

    # Craft the arrow at the workshop
    plan.append(USE)

    return plan


    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    index = cookbook.index                    # name ↔ id mapping

    # Action IDs (as defined by the environment)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Identify the goal (arrow) index
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []  # Arrow not defined in this world
    goal_idx = index[goal_name]

    # ------------------------------------------------------------------
    # Determine primitive requirements (including transitive ones)
    # ------------------------------------------------------------------
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS path‑finder (4‑connected Manhattan moves)
    # ------------------------------------------------------------------
    def bfs(start, target):
        """Return a list of positions from start to target (inclusive)
        using 4‑connected moves, treating any occupied cell as blocked
        except the target cell itself. Returns None if unreachable."""
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)          # True where blocked
        occupied[target] = False                           # allow stepping onto target
        q = collections.deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:
                    nxt = (nr, nc)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        q.append(nxt)
        else:
            return None  # target never reached

        # Reconstruct path from start to target
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    # Mapping from movement delta to action index
    delta2act = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, 1): RIGHT,
        (0, -1): LEFT,
    }

    # ------------------------------------------------------------------
    # Utility to translate a path into actions and update simulated state
    # ------------------------------------------------------------------
    def follow_path(path):
        for (r0, c0), (r1, c1) in zip(path, path[1:]):
            act = delta2act[(r1 - r0, c1 - c0)]
            actions.append(act)
            state.pos = (r1, c1)

    # ------------------------------------------------------------------
    # 1. Collect all required primitives (nearest reachable instance each time)
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find all remaining instances of this primitive on the map
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # No more of this primitive; abort planning
                return actions

            # Sort candidates by Manhattan distance from current position
            candidates = [tuple(c) for c in cells]
            candidates.sort(key=lambda pos: abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1]))

            # Try each candidate until a reachable one is found
            path = None
            target = None
            for cand in candidates:
                p = bfs(state.pos, cand)
                if p is not None:
                    path = p
                    target = cand
                    break
            if path is None:
                # Primitive exists but is unreachable; abort planning
                return actions

            # Move to the primitive and pick it up
            follow_path(path)
            actions.append(USE)                     # pick up
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # No workshop info; cannot craft

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # No workshop cell found

    # Choose the nearest reachable workshop cell
    w_candidates = [tuple(c) for c in workshop_cells]
    w_candidates.sort(key=lambda pos: abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1]))

    path = None
    w_target = None
    for cand in w_candidates:
        p = bfs(state.pos, cand)
        if p is not None:
            path = p
            w_target = cand
            break
    if path is None:
        return actions  # Workshop unreachable

    follow_path(path)
    actions.append(USE)  # craft at the workshop

    return actions

