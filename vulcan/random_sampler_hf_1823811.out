        # move in x direction (LEFT / RIGHT)
        while sx < dx:
            path.append(3)   # RIGHT
            sx += 1
        while sx > dx:
            path.append(2)   # LEFT
            sx -= 1

        # move in y direction (DOWN / UP)
        while sy < dy:
            path.append(0)   # DOWN
            sy += 1
        while sy > dy:
            path.append(1)   # UP
            sy -= 1
        return path

    # ------------------------------------------------------------------
    # 3.  Collect each required primitive.
    # ------------------------------------------------------------------
    for kind_idx, needed_cnt in primitive_needs.items():
