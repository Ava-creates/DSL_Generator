    # Reset the environment and obtain handles to the current state and world data.
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    idx = cookbook.index                # name ↔ integer id mapping

    # Action identifiers (consistent with CraftLab.action_specs()).
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    # ------------------------------------------------------------------
    # Helper: BFS shortest path from start to target (target may be occupied).
    # Returns a list of action indices.
    # ------------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                occupied = state.grid[nr, nc, :].any()
                # allow stepping onto the target even if occupied
                if occupied and nxt != target:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # no path found
        # reconstruct action list
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Helper: find the nearest cell containing a given kind (primitive or workshop).
    # Returns (action_path, cell_coords) or ([], None) if not found.
    # ------------------------------------------------------------------
    def _nearest_kind(kind_idx, start):
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                occupied = state.grid[nr, nc, :].any()
                # we may step onto a cell that holds the target kind
                if occupied and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # reconstruct path to this cell
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None  # not found

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and the primitives required to craft it.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []  # arrow not defined in this world
    goal_idx = idx[goal_name]

    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            path, cell = _nearest_kind(prim_idx, state.pos)
            if cell is None:
                # Primitive missing or unreachable – abort early.
                return plan
            plan.extend(path)
            state.pos = cell
            plan.append(USE)  # pick up the primitive
            # Update simulated state.
            r, c = cell
            state.inventory[prim_idx] += 1
            state.grid[r, c, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return plan  # cannot craft without a workshop

    workshop_idx = idx[workshop_name]
    path, cell = _nearest_kind(workshop_idx, state.pos)
    if cell is None:
        return plan  # no reachable workshop
    plan.extend(path)
    state.pos = cell
    plan.append(USE)  # craft the arrow at the workshop

    return plan


    # Reset environment and obtain references
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    idx = cookbook.index                # name ↔ integer id mapping

    # Action indices (consistent with CraftLab.action_specs)
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    from collections import deque

    # ------------------------------------------------------------------
    # Helper: BFS shortest path (list of actions) from start → target.
    # The target cell may be occupied; all intermediate cells must be empty.
    # ------------------------------------------------------------------
    def _bfs_path(start, target):
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Disallow stepping on occupied cells unless it is the target
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # No path found
        # Reconstruct action list
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell containing a given kind.
    # Returns (action_path, cell_coords) or ([], None) if not found.
    # ------------------------------------------------------------------
    def _nearest_cell_of(kind_idx, start):
        # If already on the desired cell
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Treat occupied cells as blocked unless they hold the target kind
                if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # Reconstruct path to this cell
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []  # Arrow not defined in this world
    goal_idx = idx[goal_name]

    primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_requirements.items():
        for _ in range(needed_cnt):
            path, cell = _nearest_cell_of(prim_idx, state.pos)
            if cell is None:
                # Primitive missing / unreachable; abort early.
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)                     # Pick up the primitive
            tr, tc = cell
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0        # Remove from map

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # No workshop information; cannot craft.

    workshop_idx = idx[workshop_name]
    path, cell = _nearest_cell_of(workshop_idx, state.pos)
    if cell is None:
        return actions  # No reachable workshop.
    actions.extend(path)
    state.pos = cell
    actions.append(USE)   # Craft the arrow at the workshop

    return actions

