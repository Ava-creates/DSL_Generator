    # Reset environment and obtain initial state/world
    env.reset()
    state = env._current_state
    world = env.world

    # Goal index and primitive requirements
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Action mapping
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    # Directions paired with corresponding movement actions
    move_dirs = [
        (1, 0, ACTION_DOWN),   # down
        (-1, 0, ACTION_UP),    # up
        (0, -1, ACTION_LEFT),  # left
        (0, 1, ACTION_RIGHT),  # right
    ]

    actions = []

    from collections import deque

    def find_path(cur_state, target_kind):
        """Breadth‑first search returning a list of movement actions that leads
        the agent to any cell containing `target_kind`. The agent may step onto
        that cell even if it is occupied; otherwise it may only step onto empty
        cells."""
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                cell = grid[nx, ny, :]
                # Allow moving onto empty cells or directly onto the target cell
                if cell.sum() == 0 or cell[target_kind] > 0:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        # Unreachable (should not happen in valid scenarios)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, kind)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # Pick up the primitive
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        # Use the workshop to craft
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions


    # Reset the environment and get the initial state/world objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Goal item index and the primitive requirements for crafting it
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Action indices (consistent with CraftLab's action_specs)
    # If action_specs is available, use it to be safe; otherwise fall back to defaults.
    try:
        act_map = env.action_specs()
        ACTION_DOWN = act_map['DOWN']
        ACTION_UP = act_map['UP']
        ACTION_LEFT = act_map['LEFT']
        ACTION_RIGHT = act_map['RIGHT']
        ACTION_USE = act_map['USE']
    except Exception:
        ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4

    # Directions paired with the corresponding movement action
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    from collections import deque

    def find_path(cur_state, target_kind):
        """
        Breadth‑first search that returns a list of movement actions leading
        the agent to any cell containing `target_kind`. The agent may step
        onto empty cells or directly onto the target cell; all other cells
        are considered blocked.
        """
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow moving onto empty cells or the cell that already holds the target kind
                if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        # Should not happen in a well‑formed scenario; return empty path as fallback
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use the primitive (pick it up / interact)
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Go to the appropriate workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to perform the crafting action
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # Return the complete action sequence that solves the task
    return actions

