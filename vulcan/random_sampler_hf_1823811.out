    # -------------------------------------------------------------------------
    # Action mapping
    # -------------------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # -------------------------------------------------------------------------
    # Helper: BFS pathfinding on free cells (ignores orientation)
    # -------------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return a list of actions to move from start to goal avoiding occupied cells."""
        grid = state.grid
        h, w, _ = grid.shape
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == goal:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # cell must be completely empty
                    if not grid[ny, nx, :].any():
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    # -------------------------------------------------------------------------
    # Helper: move agent to a target free cell using bfs_path
    # -------------------------------------------------------------------------
    def move_to(target):
        nonlocal actions, state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # cannot reach target
            for act in path:
                actions.append(act)
                env.step(act)
                state = env._current_state
                if state.pos == target:
                    break

    # -------------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind index
    # -------------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # -------------------------------------------------------------------------
    # Helper: pick a free cell orthogonal/diagonal adjacent to a target cell
    # -------------------------------------------------------------------------
    def adjacent_free(cell):
        grid = state.grid
        h, w, _ = grid.shape
        y, x = cell
        # check neighbours (including diagonals)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        # fallback: if the cell itself is free
        if not grid[y, x, :].any():
            return (y, x)
        return None

    # -------------------------------------------------------------------------
    # Collect all required primitives for the goal
    # -------------------------------------------------------------------------
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                continue  # primitive not present
            adj = adjacent_free(src)
            if adj is None:
                continue  # no free adjacent cell
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # -------------------------------------------------------------------------
    # Move to the workshop (if required) and craft the goal item
    # -------------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws = find_nearest(workshop_idx)
        if ws:
            adj = adjacent_free(ws)
            if adj:
                move_to(adj)
                actions.append(ACT_USE)
                env.step(ACT_USE)
                state = env._current_state

    return actions


    env.reset()
    state = env._current_state

    # identify goal index (arrow)
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("arrow not found")

    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    # mapping delta to action
    delta_act = {(1,0):ACT_DOWN, (-1,0):ACT_UP, (0,1):ACT_RIGHT, (0,-1):ACT_LEFT}

    actions = []

    # bfs path
    def bfs_path(start, goal):
        from collections import deque
        h,w,_ = state.grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y,x), path = q.popleft()
            if (y,x)==goal:
                return path
            for dy,dx,act in ((1,0,ACT_DOWN),(-1,0,ACT_UP),(0,1,ACT_RIGHT),(0,-1,ACT_LEFT)):
                ny, nx = y+dy, x+dx
                if 0<=ny<h and 0<=nx<w and (ny,nx) not in visited:
                    if not state.grid[ny,nx,:].any() or (ny,nx)==goal:
                        visited.add((ny,nx))
                        q.append(((ny,nx), path+[act]))
        return []

    def move_to(target):
        nonlocal actions, state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break
            for act in path:
                actions.append(act)
                env.step(act)
                state = env._current_state
                if state.pos == target:
                    break

    def find_nearest(kind_idx):
        grid = state.grid
        h,w,_ = grid.shape
        py,px = state.pos
        best = None
        best_d = None
        for i in range(h):
            for j in range(w):
                if grid[i,j,kind_idx] > 0:
                    d = abs(i-py)+abs(j-px)
                    if best_d is None or d<best_d:
                        best_d = d
                        best = (i,j)
        return best

    def adjacent_free(cell):
        y,x = cell
        h,w,_ = state.grid.shape
        # check the cell itself first
        if not state.grid[y,x,:].any():
            return (y,x)
        for dy in (-1,0,1):
            for dx in (-1,0,1):
                ny, nx = y+dy, x+dx
                if 0<=ny<h and 0<=nx<w and not state.grid[ny,nx,:].any():
                    return (ny,nx)
        return state.pos

    # collect primitives
    needed = env.world.cookbook.primitives_for(goal_idx)
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                continue
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # go to workshop if needed
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    return actions

