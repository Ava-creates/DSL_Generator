    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # No workshop cell found on the map

    workshop_pos = tuple(workshop_cells[0])

    path = bfs(state.pos, workshop_pos)
    if path is None:
        return actions  # Workshop unreachable

    for (r0, c0), (r1, c1) in zip(path, path[1:]):
        act = delta_to_action[(r1 - r0, c1 - c0)]
        actions.append(act)
        state.pos = (r1, c1)

