    # reset environment to get fresh state
    _ = env.reset()
    act_map = env.action_specs()
    # movement mappings
    moves = [
        (1, 0, "DOWN"),
        (-1, 0, "UP"),
        (0, 1, "RIGHT"),
        (0, -1, "LEFT"),
    ]
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}
    delta_to_dir = {(dr, dc): name for dr, dc, name in moves}
    # BFS to an empty cell adjacent to target (or target itself if it is empty)
    from collections import deque
    def bfs_adj(start, target, occ):
        tr, tc = target
        # possible goal cells: empty neighbours of target
        goal_cells = []
        for dr, dc, _ in moves:
            nr, nc = tr + dr, tc + dc
            if 0 <= nr < occ.shape[0] and 0 <= nc < occ.shape[1] and not occ[nr, nc]:
                goal_cells.append((nr, nc))
        if not goal_cells:
            return []  # cannot reach
        q = deque([start])
        parent = {start: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if cur in goal_cells:
                # reconstruct path
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path
            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if 0 <= nr < occ.shape[0] and 0 <= nc < occ.shape[1] and not occ[nr, nc] and (nr, nc) not in parent:
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # no path
    # access scenario and world
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal
    # recipe and required primitives
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    primitives_needed = world.cookbook.primitives_for(goal_idx)
    # if goal itself is primitive and no recipe, treat as need to pick it up
    if not primitives_needed and goal_idx in world.cookbook.primitives:
        primitives_needed = {goal_idx: 1}
    # working copies
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0
    cur_pos = scenario.init_pos
    actions = []
    # helper to execute a list of direction names
    def exec_path(path_dirs):
        nonlocal cur_pos
        for d in path_dirs:
            actions.append(act_map[d])
            dr, dc = dir_to_delta[d]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)
    # collect required primitives
    for kind_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            # locate remaining instances
            cells = list(zip(*np.where(grid[:, :, kind_idx] > 0)))
            if not cells:
                break
            # choose nearest by Manhattan distance
            target = min(cells, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            path = bfs_adj(cur_pos, target, occ)
            exec_path(path)
            # use to pick up
            actions.append(act_map["USE"])
            # update grid and occupancy
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False
    # go to workshop and craft
    if workshop_idx is not None:
        ws_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if not ws_cells:
            ws_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0)))
        if ws_cells:
            target = ws_cells[0]
            path = bfs_adj(cur_pos, target, occ)
            exec_path(path)
            actions.append(act_map["USE"])
    return actions


    # Reset environment to obtain fresh scenario and state
    _ = env.reset()

    # Action name → integer mapping
    act_map = env.action_specs()
    # Movement directions with corresponding name strings
    moves = [
        (1, 0, "DOWN"),
        (-1, 0, "UP"),
        (0, 1, "RIGHT"),
        (0, -1, "LEFT"),
    ]
    # Helper: BFS to any empty cell adjacent to a target cell
    def bfs_to_adjacent(start, target, occ):
        tr, tc = target
        # Candidate adjacent cells that are inside the grid and free
        goal_cells = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occ.shape[0]
            and 0 <= tc + dc < occ.shape[1]
            and not occ[tr + dr, tc + dc]
        ]
        if not goal_cells:
            return []  # no reachable neighbour
        from collections import deque

        q = deque([start])
        parent = {start: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if cur in goal_cells:
                # reconstruct path of direction names
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path
            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ.shape[0]
                    and 0 <= nc < occ.shape[1]
                    and not occ[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # unreachable

    # Mapping direction name → delta for position updates
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    # Extract scenario/world/goal information
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal

    # Recipe data: required primitives and workshop (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Working copies of grid and occupancy mask
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell

    # Current agent position
    cur_pos = scenario.init_pos  # (row, col)

    # Accumulate actions to be returned
    actions = []

    # Helper to execute a list of direction names, updating position & actions
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # --------------------------------------------------------------
    # Collect required primitives
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate remaining instances of this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more of this primitive on the map – abort early
                break
            # Choose the closest instance (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )
            # Move adjacent to the target
            path = bfs_to_adjacent(cur_pos, target, occ)
            execute_path(path)
            # Use action to pick up the primitive
            actions.append(act_map["USE"])
            # Update grid/occupancy: primitive disappears
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # --------------------------------------------------------------
    # Move to workshop (if required) and craft the goal item
    if workshop_idx is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if not workshop_cells:
            # Fall back to original scenario grid if workshop was removed during collection
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))
            )
        if workshop_cells:
            target = workshop_cells[0]  # any workshop will do
            path = bfs_to_adjacent(cur_pos, target, occ)
            execute_path(path)
            # Use action at the workshop to craft
            actions.append(act_map["USE"])

    return actions

