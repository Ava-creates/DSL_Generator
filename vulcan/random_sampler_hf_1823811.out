    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index (the item we need to make)
    goal_idx = env.task.goal

    # Primitive requirements for the goal (including transitive primitives)
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the goal must be crafted at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan move sequence (action indices)
    #   DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate the nearest unused cell that contains the given kind.
    # ------------------------------------------------------------------
    used_cells: dict[int, set[tuple[int, int]]] = {}

    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = used_cells.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        idx = int(np.argmin(dists))
        return candidates[idx]

    # ------------------------------------------------------------------
    # Collect all required primitive items.
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        used_cells.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # No more of this primitive on the map; give up on this item.
                break
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)                # USE to pick up the primitive
            used_cells[kind].add(target)     # mark cell as harvested

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
        actions.append(4)                    # USE to craft at the workshop
    else:
        # If no specific workshop, a final USE attempts crafting in place.
        actions.append(4)

    return actions


    # Reset environment to start fresh
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Index of the goal item (arrow)
    goal_idx = env.task.goal

    # Primitive requirements (including transitive) for one arrow
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if a specific workshop is needed for the final craft
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan moves from start to target using action indices.
    # Encoding: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell containing the given kind that has
    # not been harvested yet.
    # ------------------------------------------------------------------
    harvested: dict[int, set[tuple[int, int]]] = {}

    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        idx = int(np.argmin(dists))
        return candidates[idx]

    # ------------------------------------------------------------------
    # Collect all required primitive items.
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # Primitive not found; skip (the task may be impossible)
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up the primitive
            harvested[kind].add(target)     # mark this cell as used

    # ------------------------------------------------------------------
    # If a workshop is required, move to the nearest one.
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)

    # Final USE to trigger the crafting of the arrow
    actions.append(4)

    return actions

