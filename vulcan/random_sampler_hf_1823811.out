    # Ensure the environment starts from a fresh episode
    env.reset()

    # Grab underlying objects; if they are missing we cannot proceed
    scenario = getattr(env, "scenario", None)
    world = getattr(env, "world", None)
    if scenario is None or world is None:
        return []

    # Initial CraftState for this episode
    state = scenario.init()

    # Determine the goal index (the item we must produce)
    goal_idx = None
    task = getattr(env, "task", None)
    if task is not None:
        goal_idx = getattr(task, "goal", None)
    # Fallback: look up the index for "arrow" directly from the cookbook
    if goal_idx is None:
        try:
            goal_idx = world.cookbook.index["arrow"]
        except Exception:
            return []

    # Bread‑first search over the deterministic state transition graph
    from collections import deque

    max_steps = 200                     # safety bound to keep search tractable
    visited = set()
    queue = deque()
    queue.append((state, []))

    n_actions = getattr(world, "n_actions", 5)   # default to the five basic actions

    while queue:
        cur_state, actions = queue.popleft()

        # Goal reached?
        if cur_state.satisfies("", goal_idx):
            return actions

        # Do not explore beyond the depth limit
        if len(actions) >= max_steps:
            continue

        # Hash the full state (position, direction, inventory, and grid)
        key = (
            cur_state.pos,
            cur_state.dir,
            cur_state.inventory.tobytes(),
            cur_state.grid.tobytes(),
        )
        if key in visited:
            continue
        visited.add(key)

        # Expand all possible actions
        for a in range(n_actions):
            _, nxt_state = cur_state.step(a)
            queue.append((nxt_state, actions + [a]))

    # If the search failed, return an empty plan
    return []

