    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Reset the environment (ignore any return value)
    try:
        env.reset()
    except Exception:
        pass

    # Mapping from action name (e.g. "UP") to integer code used by the env
    act_map = env.action_specs()

    # Directions used for movement – order does not matter as long as it
    # matches the keys in `act_map`.
    moves = [
        (-1, 0, "UP"),
        (1, 0, "DOWN"),
        (0, -1, "LEFT"),
        (0, 1, "RIGHT"),
    ]
    name_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    # ------------------------------------------------------------------
    # Helper: breadth‑first search for a path from `start` to any empty
    # neighbour of `target`.  Returns a list of direction names.
    def bfs_to_adjacent(start, target, occ):
        tr, tc = target
        # All empty cells that are orthogonally adjacent to the target.
        goal_cells = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occ.shape[0]
            and 0 <= tc + dc < occ.shape[1]
            and not occ[tr + dr, tc + dc]
        ]
        if not goal_cells:
            return []  # No reachable adjacent cell.

        # If we are already on a goal cell, no movement is needed.
        if start in goal_cells:
            return []

        q = deque([start])
        parent = {start: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if cur in goal_cells:
                # Reconstruct path of direction names.
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path
            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ.shape[0]
                    and 0 <= nc < occ.shape[1]
                    and not occ[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # No path found.

    # ------------------------------------------------------------------
    # Helper: execute a list of direction names, updating `cur_pos` and
    # appending the corresponding integer actions.
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = name_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Retrieve goal information.
    goal_idx = None
    if hasattr(env, "task"):
        task = getattr(env, "task")
        if hasattr(task, "goal"):
            goal_idx = task.goal
        elif isinstance(task, (list, tuple)):
            goal_idx = task[0]

    if goal_idx is None:
        return []  # No identifiable goal.

    scenario = env.scenario
    world = scenario.world

    # Primitive requirements for the goal.
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    # Workshop (if any) where the final crafting must happen.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")

    # Working copy of the grid and an occupancy mask (True = blocked).
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0

    # Current agent position.
    cur_pos = scenario.init_pos  # (row, col)

    # Accumulated list of actions to be returned.
    actions = []

    # ------------------------------------------------------------------
    # Collect all required primitive items.
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate remaining instances of this primitive.
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more instances left; abort early.
                break

            # Choose the closest instance (Manhattan distance).
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to an empty neighbour of the target.
            path = bfs_to_adjacent(cur_pos, target, occ)
            execute_path(path)

            # Use the primitive.
            actions.append(act_map["USE"])

            # Update grid and occupancy: the primitive disappears.
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the goal item.
    if workshop_idx is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if not workshop_cells:
            # Fallback to the original scenario grid if the workshop was
            # removed during primitive collection.
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))
            )
        if workshop_cells:
            # Choose the nearest workshop.
            target_ws = min(
                workshop_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )
            path = bfs_to_adjacent(cur_pos, target_ws, occ)
            execute_path(path)
            actions.append(act_map["USE"])

    # Return the compiled action sequence.
    return actions


    # Reset (or re‑initialize) the environment and fetch useful handles
    try:
        env.reset()
    except Exception:
        pass

    # Action name → integer mapping (e.g. {"DOWN":0, "UP":1, ... ,"USE":4})
    act_map = env.action_specs()

    # Simple move definitions: (delta_row, delta_col, name)
    MOVES = [
        (1, 0, "DOWN"),
        (-1, 0, "UP"),
        (0, 1, "RIGHT"),
        (0, -1, "LEFT"),
    ]
    name_to_delta = {n: (dr, dc) for dr, dc, n in MOVES}

    # ------------------------------------------------------------------
    # Helper: breadth‑first search from `src` to any walkable cell adjacent
    # to `target`.  Returns a list of action integers (empty if unreachable).
    def bfs_to_adjacent(src, target, occ_grid):
        tr, tc = target
        # candidate cells we may stand on (must be empty and inside bounds)
        candidates = [
            (tr + dr, tc + dc)
            for dr, dc, _ in MOVES
            if 0 <= tr + dr < occ_grid.shape[0]
            and 0 <= tc + dc < occ_grid.shape[1]
            and not occ_grid[tr + dr, tc + dc]
        ]
        if not candidates:
            return []  # no reachable neighbour

        from collections import deque

        q = deque([src])
        parent = {src: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if cur in candidates:
                # reconstruct path of action names
                path_names = []
                while parent[cur] is not None:
                    path_names.append(parent_move[cur])
                    cur = parent[cur]
                path_names.reverse()
                return [act_map[name] for name in path_names]

            r, c = cur
            for dr, dc, name in MOVES:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ_grid.shape[0]
                    and 0 <= nc < occ_grid.shape[1]
                    and not occ_grid[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Gather goal information
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        # cannot determine goal → return empty plan
        return []

    # Recipe and primitive requirements
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind: count}

    # Working copies of the grid and occupancy mask
    scenario = env.scenario
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0                     # True where any entity exists
    cur_pos = scenario.init_pos                    # (row, col)

    actions = []

    # ------------------------------------------------------------------
    # Function to move along a list of action ints, updating cur_pos
    def execute_actions(action_list):
        nonlocal cur_pos
        for a in action_list:
            actions.append(a)
            # update position according to action name
            name = next(k for k, v in act_map.items() if v == a)
            dr, dc = name_to_delta[name]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    for prim_kind, needed in primitives_needed.items():
        for _ in range(needed):
            # locate all remaining instances of this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_kind] > 0)))
            if not prim_cells:
                # no more of this primitive on the map – give up early
                break
            # pick the closest one (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )
            # move to an empty neighbour of the target
            path = bfs_to_adjacent(cur_pos, target, occ)
            execute_actions(path)
            # use action to pick up the primitive
            actions.append(act_map["USE"])
            # update grid / occupancy: primitive disappears
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # ------------------------------------------------------------------
    # Finally, go to the required workshop (if any) and craft the goal
    if workshop_kind is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            # fallback to original scenario grid if workshop was removed earlier
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0))
            )
        if workshop_cells:
            target_ws = workshop_cells[0]  # any workshop works
            path = bfs_to_adjacent(cur_pos, target_ws, occ)
            execute_actions(path)
            actions.append(act_map["USE"])

    return actions

