            target_workshop = nearest_position(pos, workshop_cells)
            # Find a free adjacent cell to the workshop
            free_adj = adjacent_free_cells(*target_workshop)
            if free_adj:
                stand_cell = nearest_position(pos, free_adj)
                moves, pos = move_to(pos, stand_cell)
                plan_actions.extend(moves)
                # Use action to craft at the workshop
                plan_actions.append(ACTION_USE)

    return plan_actions


