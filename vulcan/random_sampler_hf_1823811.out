    def bfs_path(start, target):
        """
        Return a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) moving from `start`
        to `target` while avoiding occupied cells. The target cell may be
        occupied (contains the needed primitive or workshop); we allow stepping
        onto it.
        """
        occ = np.any(state.grid > 0, axis=2)          # blocked cells
        # Allow stepping onto the target even if occupied.
        if 0 <= target[0] < occ.shape[0] and 0 <= target[1] < occ.shape[1]:
            occ[target[0], target[1]] = False
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # No path found.

    def go_to(target):
