    import numpy as np

    # Action constants (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Return a list of actions to move Manhattan‑style from src to dst."""
        actions = []
        sx, sy = src
        dx, dy = dst
        if dx > sx:
            actions += [DOWN] * (dx - sx)
        elif dx < sx:
            actions += [UP] * (sx - dx)
        if dy > sy:
            actions += [RIGHT] * (dy - sy)
        elif dy < sy:
            actions += [LEFT] * (sy - dy)
        return actions

    def _nearest_kind(pos, kind_idx, grid):
        """Find the nearest cell (Manhattan distance) that contains `kind_idx`."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])
        nearest = locs[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index.index(goal_name)

    # Primitive‑to‑count mapping needed for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Plan actions
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    # Work on a local copy of the grid so we can “remove” items once picked
    grid = env._current_state.grid.copy()

    # 1. Collect all required primitives
    for prim_idx, qty in primitives_needed.items():
        for _ in range(qty):
            target = _nearest_kind(cur_pos, prim_idx, grid)
            if target is None:
                # Primitive missing – abort planning; return what we have so far
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)                     # pick up the primitive
            grid[target[0], target[1], prim_idx] = 0  # mark as collected

    # 2. Move to the workshop (if the recipe specifies one) and craft
    workshop_name = cookbook.recipes.get(goal_idx, {}).get('_at')
    if workshop_name is not None:
        workshop_idx = cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)                     # craft at the workshop

    return actions


    # constants for actions (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Return a list of actions that moves Manhattan‑style from src to dst."""
        sx, sy = src
        dx, dy = dst
        acts = []
        if dx > sx:
            acts += [DOWN] * (dx - sx)
        elif dx < sx:
            acts += [UP] * (sx - dx)
        if dy > sy:
            acts += [RIGHT] * (dy - sy)
        elif dy < sy:
            acts += [LEFT] * (sy - dy)
        return acts

    def _nearest_kind(pos, kind_idx, grid):
        """Find the closest cell (Manhattan distance) that contains `kind_idx`."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])
        nearest = locs[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index.index(goal_name)

    # Primitive requirements for a single arrow (may be empty if arrow is primitive)
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Planning: collect primitives, then craft at the required workshop
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    # Work on a mutable copy of the grid to keep track of items we have taken
    grid = env._current_state.grid.copy()

    # 1. Collect all required primitives
    for prim_idx, qty in primitives_needed.items():
        for _ in range(qty):
            target = _nearest_kind(cur_pos, prim_idx, grid)
            if target is None:
                # Primitive not present in the current scenario – abort planning.
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)                     # pick up the primitive
            grid[target[0], target[1], prim_idx] = 0  # remove from local view

    # 2. Move to the workshop (if the recipe specifies one) and craft
    workshop_name = cookbook.recipes.get(goal_idx, {}).get('_at')
    if workshop_name is not None:
        workshop_idx = cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)                     # craft at the workshop

    return actions

