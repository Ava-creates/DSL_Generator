    # Reset the environment to a known state.
    env.reset()
    # Current state and world objects.
    state = env._current_state          # CraftState
    world = env.world

    # Goal index (arrow) and required primitive counts.
    goal_idx = env.task.goal
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine workshop (if any) for the goal.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    import numpy as np
    from collections import deque

    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Bread‑first search returning a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that moves the agent from `start` to `target`.  All occupied cells are
        avoided, but the target cell itself is considered free.
        """
        occ = np.any(state.grid > 0, axis=2)   # occupied cells
        occ[target] = False                    # allow stepping onto target
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in visited:
                        visited.add(nxt)
                        q.append((nxt, path + [act]))
        return []   # no path found

    def step_action(act):
        """Execute action `act` in the environment and update local `state`."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def go_to(target):
        """Move to `target`, recording actions and updating the internal state."""
        for a in bfs_path(state.pos, target):
            actions.append(a)
            step_action(a)

    # ------------------------------------------------------------------
    # Build the action list.
    # ------------------------------------------------------------------
    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, req_cnt in needed.items():
        while state.inventory[kind] < req_cnt:
            candidates = locate(kind)
            if not candidates:
                # Primitive not present – abort planning.
                return actions
            # Choose the nearest reachable primitive.
            candidates.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            reached = False
            for tgt in candidates:
                path = bfs_path(state.pos, tgt)
                if path is not None:   # path may be empty if already there
                    go_to(tgt)
                    actions.append(4)   # USE to pick up
                    step_action(4)
                    reached = True
                    break
            if not reached:
                # No reachable instance of this primitive.
                return actions

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cells = locate(workshop_idx)
        if ws_cells:
            ws_cells.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            # Move to the closest workshop cell.
            go_to(ws_cells[0])
            actions.append(4)   # USE to craft
            step_action(4)
    else:
        # No specific workshop – just use at current location.
        actions.append(4)
        step_action(4)

    return actions


    # Reset the environment to a fresh start.
    env.reset()

    # Access the current state and world configuration.
    state = env._current_state          # CraftState
    world = env.world

    # Goal item index (arrow).
    goal_idx = env.task.goal

    # Primitive requirements for the goal (e.g., wood, stone, etc.).
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine the workshop required for crafting the goal, if any.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_name = recipe["_at"]
        workshop_idx = world.cookbook.index[workshop_name]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    import numpy as np
    from collections import deque

    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step_action(act):
        """Execute an action, updating the local `state` reference."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def bfs_path(start, target):
        """
        Compute a shortest path (as a list of action indices) from `start` to `target`
        avoiding occupied cells. The target cell itself may be occupied (e.g., a workshop)
        and is therefore treated as free for the purpose of stepping onto it.
        """
        occ = np.any(state.grid > 0, axis=2)          # occupied cells
        # Ensure the target is considered free.
        occ[target] = False
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        # No reachable path.
        return []

    def go_to(target):
        """Move the agent to `target`, recording actions and updating the state."""
        for act in bfs_path(state.pos, target):
            actions.append(act)
            step_action(act)

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, req_cnt in needed.items():
        while state.inventory[kind] < req_cnt:
            positions = locate(kind)
            if not positions:
                # Primitive not present on the map – abort planning.
                return actions
            # Sort by Manhattan distance to the current position.
            positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            # Attempt to reach the nearest reachable primitive.
            reached = False
            for target in positions:
                path = bfs_path(state.pos, target)
                if path is not None:
                    go_to(target)
                    actions.append(4)          # USE to pick up the primitive.
                    step_action(4)
                    reached = True
                    break
            if not reached:
                # Unable to reach any instance of this primitive.
                return actions

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            ws_positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            # Move adjacent to the workshop (or onto it if free).
            go_to(ws_positions[0])
            actions.append(4)          # USE to craft at the workshop.
            step_action(4)
    else:
        # No specific workshop required – attempt to craft at the current location.
        actions.append(4)
        step_action(4)

    return actions

