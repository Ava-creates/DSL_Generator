            # No path found – return empty list.
            return []

        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive (respecting multiplicities).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find any cell that currently holds this primitive.
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # Primitive not available – abort early.
                return actions
            tr, tc = cells[0]

            # Move to the primitive cell.
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update our internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        # No workshop information – return what we have.
        return actions

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # No workshop found – return what we have.
        return actions

    wr, wc = workshop_cells[0]

    # Move to the workshop cell.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions

