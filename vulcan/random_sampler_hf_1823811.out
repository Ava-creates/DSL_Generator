    actions = []

    from collections import deque
    import numpy as np

    def bfs_path(start, target):
        """Return list of movement actions from start to target avoiding obstacles."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        moves = [(DOWN, (1, 0)),
                 (UP, (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT, (0, 1))]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        # reconstruct
        if target not in parent and start != target:
            return []  # No path found
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Phase 1: Collect primitives
    # ------------------------------------------------------------------
    for prim_idx, count_needed in primitive_needs.items():
        for _ in range(count_needed):
            # Find all cells that currently hold this primitive.
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # Primitive missing; abort.
                return actions
            # Choose nearest cell (Manhattan distance)
            dists = np.abs(cells - np.array(state.pos)).sum(axis=1)
            tr, tc = cells[dists.argmin()]

            # Move to the cell
            move_seq = bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Use (pick up)
            actions.append(USE)

            # Update internal copy
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # Phase 2: Craft at the required workshop
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # No workshop info

    workshop_idx = index[workshop_name]
