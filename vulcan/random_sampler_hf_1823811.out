            if state.inventory[kind] > 0:
                state.inventory[kind] -= 1  # pretend we will use it later
                continue
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # No reachable cell; give up on this resource
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up
            used_cells[kind].add(target)

    # Move to the workshop (if required) before crafting
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)

    # Final USE to craft the goal item
    actions.append(4)
    return actions


