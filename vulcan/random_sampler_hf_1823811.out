    # Reset the environment to a fresh state.
    _ = env.reset()

    # Mapping from action names to integer codes (e.g., "DOWN" → 0).
    act_map = env.action_specs()

    # Movement directions with their corresponding (dr, dc) deltas.
    moves = [
        (1, 0, "DOWN"),
        (-1, 0, "UP"),
        (0, 1, "RIGHT"),
        (0, -1, "LEFT"),
    ]

    # ------------------------------------------------------------------
    # Helper: Bread‑first search for a path to any empty neighbour of a target cell.
    def bfs_to_adjacent(start, target, occ):
        tr, tc = target
        # All empty cells surrounding the target that the agent can stand on.
        goal_cells = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occ.shape[0]
            and 0 <= tc + dc < occ.shape[1]
            and not occ[tr + dr, tc + dc]
        ]
        if not goal_cells:
            return []  # No reachable adjacent cell.

        from collections import deque

        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in goal_cells:
                # Reconstruct the sequence of action names.
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ.shape[0]
                    and 0 <= nc < occ.shape[1]
                    and not occ[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # No path found.

    # ------------------------------------------------------------------
    # Helper to translate a direction name to its delta.
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    # ------------------------------------------------------------------
    # Helper to execute a list of direction names, updating position and actions.
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Gather environment information.
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal if hasattr(env.task, "goal") else None
    if goal_idx is None:
        return []

    # Recipe data: required primitives and workshop location (if any).
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Working copies of the grid and occupancy mask (True = occupied).
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0

    # Current agent position.
    cur_pos = scenario.init_pos  # (row, col)

    # List that will hold the final action sequence.
    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate all remaining instances of this primitive.
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more copies left; abort early.
                break

            # Choose the closest primitive (Manhattan distance).
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to an empty neighbour of the target.
            path = bfs_to_adjacent(cur_pos, target, occ)
            execute_path(path)

            # Use the primitive (agent is now adjacent).
            actions.append(act_map["USE"])

            # Update grid and occupancy: the primitive disappears.
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the goal item.
    if workshop_idx is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if not workshop_cells:
            # Fallback to the original scenario grid if the workshop was cleared.
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))
            )
        if workshop_cells:
            target_ws = workshop_cells[0]  # any workshop suffices.
            path = bfs_to_adjacent(cur_pos, target_ws, occ)
            execute_path(path)
            actions.append(act_map["USE"])

    # Return the compiled list of actions.
    return actions


    # Reset environment to obtain a fresh state
    _ = env.reset()

    # Mapping from action names to integer codes used by the environment
    act_map = env.action_specs()

    # Define movement directions
    moves = [
