    # action indices as defined by CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # reset the environment to obtain a fresh state
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.scenario.world          # type: CraftWorld
    cookbook = world.cookbook            # type: Cookbook
    index = cookbook.index               # maps names ↔ integer ids

    # ------------------------------------------------------------------
    # 1. Identify the goal (arrow) and the primitive ingredients required.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # arrow not defined in this world

    goal_idx = index[goal_name]          # integer id of the arrow item
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                         # list of actions to return

    # ------------------------------------------------------------------
    # Helper: generate a simple Manhattan path from current to target.
    # ------------------------------------------------------------------
    def _move_to(start, target):
        """Return a list of move actions (DOWN/UP/RIGHT/LEFT) that walks
        from start (r,c) to target (r,c) using a greedy Manhattan approach.
        Also returns the final position after executing those moves."""
        r, c = start
        tr, tc = target
        seq = []
        while (r, c) != (tr, tc):
            if r < tr:
                seq.append(DOWN)
                r += 1
            elif r > tr:
                seq.append(UP)
                r -= 1
            elif c < tc:
                seq.append(RIGHT)
                c += 1
            else:  # c > tc
                seq.append(LEFT)
                c -= 1
        return seq, (r, c)

    # ------------------------------------------------------------------
    # 2. Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # locate any cell that currently contains this primitive
            primitive_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if primitive_cells.size == 0:
                # No more of this primitive on the map – give up.
                return actions
            target_r, target_c = primitive_cells[0]

            # move next to the primitive cell (greedy Manhattan)
            move_seq, new_pos = _move_to(state.pos, (target_r, target_c))
            actions.extend(move_seq)
            state.pos = new_pos

            # pick it up (USE).  In the default CraftWorld implementation,
            # using on the same cell works for picking up items.
            actions.append(USE)

            # Update our internal copy of the state so that subsequent
            # planning steps see the primitive as consumed.
            state.inventory[prim_idx] += 1
            state.grid[target_r, target_c, prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Go to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    # The workshop name is stored under the special key "_at" in the recipe.
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # no workshop information

    workshop_idx = index[workshop_name]

    # locate a workshop cell (any will do)
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # cannot find a workshop

    w_r, w_c = workshop_cells[0]

    # move to the workshop cell
    move_seq, new_pos = _move_to(state.pos, (w_r, w_c))
    actions.extend(move_seq)
    state.pos = new_pos

    # craft the arrow (USE while standing on the workshop)
    actions.append(USE)

    return actions


    # Placeholder implementation: return an empty action sequence.
    return []

