    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _manhattan_path(src, dst):
        """Return a list of actions that walk from src to dst using Manhattan moves."""
        actions = []
        x, y = src
        tx, ty = dst
        # vertical movement (row index)
        while x < tx:
            actions.append(DOWN)
            x += 1
        while x > tx:
            actions.append(UP)
            x -= 1
        # horizontal movement (col index)
        while y < ty:
            actions.append(RIGHT)
            y += 1
        while y > ty:
            actions.append(LEFT)
            y -= 1
        return actions

    def _nearest_entity(pos, kind_idx):
        """Find the closest cell (Manhattan distance) that currently contains kind_idx."""
        grid = env._current_state.grid
        # locations where the count of this kind is >0
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        best = int(np.argmin(dists))
        return tuple(locations[best])

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # dict {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            target = _nearest_entity(cur_pos, prim_idx)
            if target is None:
                # Primitive not found – abort early
                return actions
            actions += _manhattan_path(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
