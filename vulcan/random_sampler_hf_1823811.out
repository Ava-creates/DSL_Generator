    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Constants (match CraftLab.action_specs)
    # ----------------------------------------------------------------------
    # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS that stops on any empty cell adjacent to *target*
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        """Return a list of actions moving from *start* to a free cell
        that is 4‑connected to *target*.  ``blocked`` is a bool matrix where
        True means the cell cannot be entered.  Empty list if no path."""
        h, w = blocked.shape
        tx, ty = target

        # all admissible goal cells (empty and adjacent to target)
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ----------------------------------------------------------------------
    # Reset environment and obtain the underlying CraftState
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []  # cannot obtain state

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []  # arrow not defined in this world

    # primitives required for a single arrow
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # locate required workshop (key "_at" or "_key")
    workshop_idx = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_idx = idx.get(v, None)
            break
    if workshop_idx is None:
        return []  # no workshop info

    # ----------------------------------------------------------------------
    # Local mutable copies for planning simulation
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells

    plan = []                                   # actions to return

    # ----------------------------------------------------------------------
    # Helper: move adjacent to *target* and issue a USE action
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Move next to *target* (which contains an entity of *kind_idx*)
        and perform USE.  Updates simulated pos, grid, occupied, inventory.
        Returns True on success, False otherwise."""
        nonlocal pos, plan, grid, occupied, inventory

        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False

        # execute movement actions in simulation
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # perform USE
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect each required primitive (respecting multiplicities)
    # ----------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                return plan  # primitive missing; return what we have
            # choose nearest by Manhattan distance
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Go to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # workshops are static; fall back to original grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan  # no workshop found

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])

    move_and_use(workshop_target, workshop_idx)

    return plan


