    import numpy as np

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Return a list of movement actions (Manhattan) from src to dst."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_kind(pos, kind_idx, grid):
        """Find the coordinates of the nearest cell containing kind_idx."""
        locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))
        if not locations:
            return None
        distances = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]
        return locations[int(np.argmin(distances))]

    # ------------------------------------------------------------------
    # 1. Determine goal (arrow) and required primitives
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
    # 2. Collect required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    grid = env._current_state.grid

    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_kind(cur_pos, prim_idx, grid)
            if target is None:
                # primitive missing; abort planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)
            # simulate pickup locally to avoid revisiting same cell
            grid = grid.copy()
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Move to workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)  # craft at workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper functions
