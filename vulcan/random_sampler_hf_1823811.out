    import numpy as np
    from collections import deque

    # Reset environment and obtain current state and world information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # --------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # --------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []                       # unknown goal

    # Primitive requirements for one arrow
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    def bfs_path(start, goal, occupied):
        """Return a list of positions from start (excluded) to goal (included)
        using 4‑directional movement, avoiding occupied cells."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Convert a movement delta to the environment's action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # --------------------------------------------------------------
    # Planning
    # --------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)                     # current (x, y)
    grid = state.grid.copy()                       # mutable copy for tracking pickups
    occupied_mask = np.any(grid, axis=2)           # cells that block movement

    # --------------------------------------------------------------
    # 1) Collect required primitives
    # --------------------------------------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # Find remaining instances of this primitive on the map
            candidates = np.argwhere(grid[:, :, kind_idx] > 0)
            if candidates.size == 0:
                break

            # Sort candidates by Manhattan distance from current position
            dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            target = None
            path = None
            for idx in order:
                cand = tuple(candidates[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    target = cand
                    path = p
                    break

            if path is None:
                continue    # cannot reach any remaining instance

            # Follow the path to the primitive
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)          # USE
            grid[target[0], target[1], kind_idx] = 0
            occupied_mask = np.any(grid, axis=2)

    # --------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # --------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            for idx in order:
                target = tuple(workshop_cells[idx])
                p = bfs_path(cur_pos, target, occupied_mask)
                if p is not None:
                    for step in p:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to craft at the workshop
                    break
    else:
        # No specific workshop required; craft at current location
        actions.append(4)   # USE to craft

    return actions


    # Reset environment and get current state and world information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # --------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # --------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []                       # unknown goal

    # Primitive requirements for one arrow
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Find a walkable path from start to goal on the grid.
        `occupied` is a 2‑D boolean mask where True means the cell blocks movement.
        Returns list of positions (excluding start, including goal) or None if no path."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Convert a movement delta into the environment's action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # --------------------------------------------------------------
    # Planning
    # --------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)
    # Make a mutable copy of the grid to keep track of which primitives have been taken
    grid = state.grid.copy()

    # --------------------------------------------------------------
    # 1) Collect all required primitives
    # --------------------------------------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # Find all remaining cells containing this primitive
            candidates = np.argwhere(grid[:, :, kind_idx] > 0)
            if candidates.size == 0:
                # No more of this primitive left – cannot fulfill the task
                return actions
            # Sort candidates by Manhattan distance from current position
            dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)   # any entity (including other primitives) blocks movement
            target = None
            path = None
            for idx in order:
                cand = tuple(candidates[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    target = cand
                    path = p
                    break
            if path is None:
                # Unable to reach any remaining instance of this primitive
                return actions

            # Follow the path to the target primitive
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)          # USE
            # Remove it from the mutable grid so it no longer blocks movement
            grid[target[0], target[1], kind_idx] = 0

    # --------------------------------------------------------------
    # 2) Move to the appropriate workshop (if required) and craft
    # --------------------------------------------------------------
    if workshop_idx is not None:
        # Locate all workshop cells of the required type
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            # Use the original static occupancy (items we have already collected are already cleared)
            occupied_mask = np.any(state.grid, axis=2)
            for idx in order:
                target = tuple(workshop_cells[idx])
                p = bfs_path(cur_pos, target, occupied_mask)
                if p is not None:
                    for step in p:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to craft at the workshop
                    break
    else:
        # No specific workshop required – craft at current location
        actions.append(4)   # USE

    return actions

