    # ------------------------------------------------------------------
    def _path(src, dst):
        sx, sy = src
        dx, dy = dst
        path = []

        # X‑direction
        while sx < dx:
            path.append(3)   # RIGHT
            sx += 1
        while sx > dx:
            path.append(2)   # LEFT
            sx -= 1

        # Y‑direction
        while sy < dy:
            path.append(0)   # DOWN
            sy += 1
        while sy > dy:
            path.append(1)   # UP
            sy -= 1
        return path

