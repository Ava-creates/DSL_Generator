    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # copy of grid to track consumed resources
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)  # (row, col)

    height, width = grid.shape[:2]

    # ------------------------------------------------------------------
    # helper functions
    # ------------------------------------------------------------------
    def nearest(pos, kind):
        """Return coordinates of the nearest cell containing `kind`."""
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        idx = dists.argmin()
        return tuple(cells[idx].tolist())

    def bfs_actions(src, dst):
        """Return a list of actions to move from src to dst avoiding obstacles
        (except the destination cell which may be occupied)."""
        if src == dst:
            return []

        from collections import deque

        # (delta row, delta col) -> action
        moves = [((1, 0), DOWN), ((-1, 0), UP),
                 ((0, -1), LEFT), ((0, 1), RIGHT)]

        visited = {src}
        queue = deque()
        queue.append((src, []))

        while queue:
            (r, c), acts = queue.popleft()
            for (dr, dc), act in moves:
                nr, nc = r + dr, c + dc
                if not (0 <= nr < height and 0 <= nc < width):
                    continue
                if (nr, nc) in visited:
                    continue
                # allow stepping onto destination even if occupied
                if (nr, nc) != dst and np.any(grid[nr, nc, :] > 0):
                    continue
                visited.add((nr, nc))
                new_acts = acts + [act]
                if (nr, nc) == dst:
                    return new_acts
                queue.append(((nr, nc), new_acts))
        # fallback: Manhattan moves (may collide with obstacles)
        man = []
        r, c = src
        tr, tc = dst
        dr = tr - r
        dc = tc - c
        if dr > 0:
            man += [DOWN] * dr
        elif dr < 0:
            man += [UP] * (-dr)
        if dc > 0:
            man += [RIGHT] * dc
        elif dc < 0:
            man += [LEFT] * (-dc)
        return man

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = nearest(cur_pos, prim_idx)
            if target is None:
                # primitive missing; abort planning
                return actions
            actions += bfs_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)               # pick up
            grid[target[0], target[1], prim_idx] = 0   # remove from local copy

    # ------------------------------------------------------------------
    # 2) Move to workshop (if any) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = nearest(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += bfs_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at workshop

    return actions


    # action identifiers
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Access world information
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    # primitive requirements for a single arrow: {primitive_idx: count}
    needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
    # Local copy of the grid (so we can “remove” items once picked up)
    # ------------------------------------------------------------------
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)          # (row, col)

    rows, cols = grid.shape[:2]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _nearest(pos, kind_idx):
        """Return coordinates of the nearest cell that currently contains `kind_idx`."""
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        return tuple(cells[dists.argmin()].tolist())

    def _bfs_actions(start, goal):
        """Return a list of actions that moves from start to goal while avoiding
        occupied cells (except the goal cell itself)."""
        if start == goal:
            return []

        # (dr, dc, action)
        moves = [((1, 0), DOWN), ((-1, 0), UP),
                 ((0, -1), LEFT), ((0, 1), RIGHT)]

        from collections import deque
        queue = deque()
        queue.append((start, []))
        visited = {start}

        while queue:
            (r, c), acts = queue.popleft()
            for (dr, dc), act in moves:
                nr, nc = r + dr, c + dc
                if not (0 <= nr < rows and 0 <= nc < cols):
                    continue
                if (nr, nc) in visited:
                    continue
                # allow stepping onto the destination even if occupied
                if (nr, nc) != goal and np.any(grid[nr, nc, :] > 0):
                    continue
                visited.add((nr, nc))
                new_acts = acts + [act]
                if (nr, nc) == goal:
                    return new_acts
                queue.append(((nr, nc), new_acts))
        # No path found – fallback to empty list (will likely fail later)
        return []

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = _nearest(cur_pos, prim_idx)
            if target is None:
                # primitive missing – abort planning
                return actions
            actions += _bfs_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)                     # pick up the primitive
            grid[target[0], target[1], prim_idx] = 0  # remove from planning grid

    # ------------------------------------------------------------------
    # 2) Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _bfs_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

