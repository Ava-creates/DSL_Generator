    import numpy as np
    from collections import deque

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    idx_arrow = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(idx_arrow)

    actions = []
    cur_pos = env._current_state.pos
    grid = env._current_state.grid.copy()
    H, W = grid.shape[:2]

    def bfs(start, goal):
        """Return a list of actions to move from start to goal, or None if unreachable."""
        if start == goal:
            return []
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            for dx, dy, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:
                    # allow stepping onto the goal even if occupied
                    if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:
                        continue
                    visited[nx, ny] = True
                    prev[(nx, ny)] = ((x, y), act)
                    if (nx, ny) == goal:
                        path = []
                        cur = goal
                        while cur != start:
                            cur, act = prev[cur]
                            path.append(act)
                        path.reverse()
                        return path
                    q.append((nx, ny))
        return None

    def nearest_kind(pos, kind_idx):
        """Find the reachable cell containing kind_idx with the shortest path."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        best_path = None
        best_loc = None
        for loc in locations:
            loc_tup = (int(loc[0]), int(loc[1]))
            path = bfs(pos, loc_tup)
            if path is None:
                continue
            if best_path is None or len(path) < len(best_path):
                best_path = path
                best_loc = loc_tup
        return best_loc, best_path

    # Collect required primitives
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target, path = nearest_kind(cur_pos, prim_idx)
            if target is None:
                return actions  # cannot find required primitive
            actions.extend(path)
            actions.append(USE)          # pick up the primitive
            cur_pos = target
            if grid[target[0], target[1], prim_idx] > 0:
                grid[target[0], target[1], prim_idx] -= 1

    # Move to workshop (if recipe specifies one) and craft
    recipe = world.cookbook.recipes.get(idx_arrow, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        target, path = nearest_kind(cur_pos, workshop_idx)
        if target is not None:
            actions.extend(path)
            actions.append(USE)  # craft at the workshop

    return actions


    import numpy as np
    from collections import deque

    # Action constants (match CraftState step implementation)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index("arrow")
    # primitive requirements for a single arrow
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # current mutable state while planning
    cur_pos = tuple(env._current_state.pos)
    grid = env._current_state.grid.copy()

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions to reach a target cell.
    # ------------------------------------------------------------------
    def bfs_path(start, goal, grid):
        """Return list of actions (DOWN/UP/LEFT/RIGHT) from start to goal.
        start/goal are (x, y) tuples. Cells that contain any entity are
        treated as blocked unless they are the goal cell itself.
        """
        if start == goal:
            return []
        H, W = grid.shape[:2]
        visited = np.zeros((H, W), dtype=bool)
        prev = {}  # (x, y) -> ((px, py), action)
        q = deque()
        q.append(start)
        visited[start] = True
        while q:
            x, y = q.popleft()
            for dx, dy, act in ((1, 0, DOWN), (-1, 0, UP),
                                (0, 1, RIGHT), (0, -1, LEFT)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if visited[nx, ny]:
                    continue
                # allow stepping onto the goal even if blocked
                if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:
                    continue
                visited[nx, ny] = True
                prev[(nx, ny)] = ((x, y), act)
                if (nx, ny) == goal:
                    # reconstruct path
                    actions = []
                    cur = goal
                    while cur != start:
                        (p, a) = prev[cur]
                        actions.append(a)
                        cur = p
                    actions.reverse()
                    return actions
                q.append((nx, ny))
        # no path found
        return None

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind index.
    # ------------------------------------------------------------------
    def find_nearest(pos, kind_idx, grid):
        """Return (target_cell, path_actions) for the closest entity of kind."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        best_path = None
        best_loc = None
        for loc in locations:
            target = (int(loc[0]), int(loc[1]))
            path = bfs_path(pos, target, grid)
            if path is None:
                continue
            if best_path is None or len(path) < len(best_path):
                best_path = path
                best_loc = target
        return best_loc, best_path

    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives (respecting required counts).
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target, path = find_nearest(cur_pos, prim_idx, grid)
            if target is None or path is None:
                # cannot reach required primitive – abort planning
                return actions
            actions.extend(path)          # move to primitive cell
            actions.append(USE)           # pick it up
            # update mutable grid state (remove one instance)
            if grid[target[0], target[1], prim_idx] > 0:
                grid[target[0], target[1], prim_idx] -= 1
            cur_pos = target

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        target, path = find_nearest(cur_pos, workshop_idx, grid)
        if target is not None and path is not None:
            actions.extend(path)
            actions.append(USE)   # craft at the workshop

    return actions

