    actions = []

    # Identify the goal item index
    if not hasattr(env, "task") or not hasattr(env.task, "goal"):
        return actions
    goal_idx = env.task.goal

    # Access world and recipe information
    world = env.world
    cookbook = world.cookbook

    # Determine the primitive resources needed for the goal
    needed_primitives = cookbook.primitives_for(goal_idx).copy()

    # Helper to move the agent to a target (x, y) position using Manhattan moves
    def move_to(target_pos):
        nonlocal actions
        # Current state is stored in env._current_state after each step
        cur_state = env._current_state
        cur_x, cur_y = cur_state.pos
        target_x, target_y = target_pos

        # Horizontal moves
        while cur_x != target_x:
            if cur_x < target_x:
                act = 3  # RIGHT
                cur_x += 1
            else:
                act = 2  # LEFT
                cur_x -= 1
            actions.append(act)
            env.step(act)  # update internal state

        # Vertical moves
        while cur_y != target_y:
            if cur_y < target_y:
                act = 0  # DOWN
                cur_y += 1
            else:
                act = 1  # UP
                cur_y -= 1
            actions.append(act)
            env.step(act)  # update internal state

    import numpy as np

    # Collect each required primitive
    for kind_idx, qty in list(needed_primitives.items()):
        while qty > 0:
            # Locate any remaining instance of this primitive on the grid
            positions = np.argwhere(env._current_state.grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                # No more of this primitive left on the map – give up on this kind
                break
            target = tuple(positions[0][:2])  # (x, y) of the first found instance
            move_to(target)

            # Pick up the item with the USE action
            actions.append(4)  # USE
            env.step(4)
            qty -= 1
        needed_primitives[kind_idx] = qty

    # After gathering primitives, move to the appropriate workshop (if any) and craft
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_kind] > 0)
        if workshop_positions.size > 0:
            workshop_target = tuple(workshop_positions[0][:2])
            move_to(workshop_target)

    # Final USE to attempt crafting the goal item
    actions.append(4)  # USE
    env.step(4)

    return actions

