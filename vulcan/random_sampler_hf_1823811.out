    # action ids (must match CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                     # arrow not defined in this world

    goal_idx = index[goal_name]      # integer id of the arrow item
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                     # list of actions to be returned

    # ------------------------------------------------------------------
    # Helper: BFS to find a path avoiding occupied cells (except target).
    # ------------------------------------------------------------------
    from collections import deque

    h, w = state.grid.shape[:2]
    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    def bfs_path(start, target):
        """Return a list of move actions to go from start to target."""
        if start == target:
            return []

        queue = deque([start])
        visited = {start}
        parent = {}

        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)

                # Allow stepping onto the target even if it is occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        if target not in parent and start != target:
            return []      # no path found

        # reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive (handling multiplicities).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
