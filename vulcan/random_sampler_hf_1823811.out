    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of move actions from start to target.
    # Allows stepping onto the target even if occupied; all other cells
    # must be empty (no non‑zero occupancy in any kind).
    # ------------------------------------------------------------------
    def _bfs_path(start, target):
        """Return list of move actions (DOWN/UP/LEFT/RIGHT) to reach target."""
        if start == target:
            return []

        h, w = state.grid.shape[:2]
        moves = [
            (DOWN, (1, 0)),
            (UP, (-1, 0)),
            (LEFT, (0, -1)),
            (RIGHT, (0, 1)),
        ]

        q = deque([start])
        visited = {start}
        parent = {}

        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Disallow moving through occupied cells except the target.
                if nxt != target and state.grid[nr, nc, :].any():
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)

        if target not in parent and start != target:
            return []  # No path found

        # Reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate any cell currently holding this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive missing – abort early.
                return actions
            tr, tc = prim_cells[0]

            # Move to the primitive cell.
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = index[workshop_name]
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            wr, wc = workshop_cells[0]

            # Move to the workshop cell.
            move_seq = _bfs_path(state.pos, (wr, wc))
            actions.extend(move_seq)
            state.pos = (wr, wc)

            # Craft the arrow.
            actions.append(USE)

    return actions


