    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    world = env.world

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _cell_blocked(pos, g):
        """Return True if the cell contains any entity (i.e. is not empty)."""
        x, y = pos
        return g[x, y, :].any()

    def _bfs(start, goal, g):
        """Bread‑first search returning a list of positions from start to goal.
        Cells occupied by any entity are treated as obstacles, except the goal
        cell itself which is always considered walkable."""
        if start == goal:
            return [start]
        w, h = g.shape[:2]
        q = collections.deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt in came_from:
                        continue
                    # allow stepping onto the goal even if occupied
                    if _cell_blocked(nxt, g) and nxt != goal:
                        continue
                    came_from[nxt] = cur
                    q.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _path_to_actions(path):
        """Convert a position path to a list of action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent cells in path")
        return acts

    def _move(src, dst, g):
        """Return actions moving from src to dst using BFS, falling back to Manhattan."""
        p = _bfs(src, dst, g)
        if p is None:
            # Manhattan fallback (ignores obstacles)
            acts = []
            sx, sy = src
            tx, ty = dst
            if tx > sx:
                acts += [DOWN] * (tx - sx)
            elif tx < sx:
                acts += [UP] * (sx - tx)
            if ty > sy:
                acts += [RIGHT] * (ty - sy)
            elif ty < sy:
                acts += [LEFT] * (sy - ty)
            return acts
        return _path_to_actions(p)

    def _nearest(pos, kind_idx, g, banned):
        """Find nearest cell containing `kind_idx` not in `banned` set."""
        cells = np.argwhere(g[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        if banned:
            mask = np.array([tuple(c) not in banned for c in cells])
            cells = cells[mask]
            if cells.size == 0:
                return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)
    grid = env._current_state.grid.copy()          # mutable copy for planning

    # 1) Determine primitive requirements for the goal item (arrow)
    goal_idx = world.cookbook.index.index('arrow')
    prim_req = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Track which locations of each primitive have already been harvested
    harvested = {k: set() for k in prim_req.keys()}

    # 2) Collect each required primitive
    for kind_idx, needed in prim_req.items():
        for _ in range(needed):
            target = _nearest(cur_pos, kind_idx, grid, harvested[kind_idx])
            if target is None:
                # Primitive not available – abort planning
                return actions
            actions += _move(cur_pos, target, grid)
            cur_pos = target
            actions.append(USE)                     # pick up primitive
            grid[target[0], target[1], kind_idx] = 0
            harvested[kind_idx].add(target)

    # 3) Move to the workshop (if the recipe specifies one) and craft
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_target = _nearest(cur_pos, workshop_idx, grid, set())
        if ws_target is not None:
            actions += _move(cur_pos, ws_target, grid)
            cur_pos = ws_target
            actions.append(USE)   # craft at the workshop

    return actions


    # Action indices (as defined in the environment)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    world = env.world

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    def _bfs_path(start, goal, grid):
        """Return a list of positions from start to goal using BFS.
        The goal cell is considered walkable even if occupied.
        """
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        from collections import deque
        frontier = deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt in came_from:
                        continue
                    # treat the goal cell as walkable even if occupied
                    if (grid[nx, ny, :].any() and nxt != goal):
                        continue
                    came_from[nxt] = cur
                    frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Convert a list of adjacent positions to a list of actions."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, grid):
        """Move from src to dst using BFS; fall back to Manhattan moves."""
        path = _bfs_path(src, dst, grid)
        if path is None:
            # Manhattan fallback (ignores obstacles)
            acts = []
            sx, sy = src
            tx, ty = dst
            if tx > sx:
                acts += [DOWN] * (tx - sx)
            elif tx < sx:
                acts += [UP] * (sx - tx)
            if ty > sy:
                acts += [RIGHT] * (ty - sy)
            elif ty < sy:
                acts += [LEFT] * (sy - ty)
            return acts
        return _actions_from_path(path)

    def _nearest_cell(pos, kind_idx, grid, excluded):
        """Find the nearest cell containing `kind_idx` not in `excluded`."""
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        if excluded:
            mask = np.array([tuple(c) not in excluded for c in cells])
            cells = cells[mask]
            if cells.size == 0:
                return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    # --------------------------------------------------------------
    # 1) Determine goal and its primitive requirements
    # --------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)
    prim_req = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # --------------------------------------------------------------
    # 2) Collect all required primitives
    # --------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)
    grid = env._current_state.grid.copy()   # mutable copy for planning
    harvested = {k: set() for k in prim_req.keys()}

    for kind_idx, needed in prim_req.items():
        for _ in range(needed):
            target = _nearest_cell(cur_pos, kind_idx, grid, harvested[kind_idx])
            if target is None:
                # Primitive not reachable; abort planning
                return actions
            actions += _move_actions(cur_pos, target, grid)
            cur_pos = target
            actions.append(USE)                     # pick up primitive
            grid[target[0], target[1], kind_idx] = 0
            harvested[kind_idx].add(target)

    # --------------------------------------------------------------
    # 3) Go to the appropriate workshop (if any) and craft the goal
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_cell(cur_pos, workshop_idx, grid, set())
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos, grid)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

