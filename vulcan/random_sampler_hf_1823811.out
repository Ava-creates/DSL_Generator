    # Reset environment and get current state/world references
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Goal definition
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for one arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Determine workshop (if any) needed for crafting the arrow
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return a list of (x, y) positions where `kind` occurs on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Convert a step from cur -> nxt into an action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Non‑adjacent move requested")

    def bfs(start, goal, blocked):
        """Breadth‑first search from start to goal avoiding blocked cells.
        Returns a list of positions (including start and goal)."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H:
                    nxt = (nx, ny)
                    if nxt in blocked:
                        continue
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay where we are
        return [start]

    # ------------------------------------------------------------------
    # Initial location bookkeeping
    # ------------------------------------------------------------------
    # Record current position
    cur_pos = state.pos

    # Map each primitive kind to a mutable list of its remaining locations
    prim_locations = {
        kind: find_locations(kind) for kind in primitive_counts.keys()
    }

    actions = []

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_kind, needed in primitive_counts.items():
        for _ in range(needed):
            # If no more instances of this primitive are left, give up on this one
            if not prim_locations[prim_kind]:
                continue
            target = prim_locations[prim_kind].pop(0)   # pick first available

            # Build blocked set for the current BFS call
            blocked_cells = set()

            # Non‑grabbable entities
            for ng in world.non_grabbable_indices:
                occ = np.where(state.grid[:, :, ng] > 0)
                blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))

            # Remaining (uncollected) primitives
            for k, locs in prim_locations.items():
                blocked_cells.update(locs)

            # Workshop cells (treated as obstacles for movement)
            for wk in world.workshop_indices:
                occ = np.where(state.grid[:, :, wk] > 0)
                blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))

            # Ensure the goal cell itself is traversable
            blocked_cells.discard(target)

            # Compute path and translate to actions
            path = bfs(cur_pos, target, blocked_cells)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Use action to pick up the primitive
            actions.append(4)   # USE

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = wk_locs[0]

            # Re‑compute blocked cells (now primitives have been removed)
            blocked_cells = set()
            for ng in world.non_grabbable_indices:
                occ = np.where(state.grid[:, :, ng] > 0)
                blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))
            for wk in world.workshop_indices:
                occ = np.where(state.grid[:, :, wk] > 0)
                blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))
            blocked_cells.discard(target)

            path = bfs(cur_pos, target, blocked_cells)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE to craft at workshop
    else:
        # No specific workshop – just issue a USE at current location
        actions.append(4)

    return actions


