    # Reset environment and obtain references to the current state and world data.
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # name ↔ id mapping

    # Resolve action indices (robust to possible changes in ordering).
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # Arrow not defined in this world
    goal_idx = index[goal_name]

    # primitives_for returns a dict {primitive_idx: count} needed for one goal.
    primitive_needs = cookbook.primitives_for(goal_idx)

    actions = []                         # Accumulate the final action list.

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of move actions from start to target.
    # The target cell may be occupied (contains the needed primitive or a
    # workshop); all other cells must be free (no entity present).
    # ------------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        """Return a list of move actions (DOWN/UP/LEFT/RIGHT) to reach target."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        moves = [(DOWN, (1, 0)),
                 (UP, (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT, (0, 1))]
        queue = deque([start])
        visited = {start}
        parent = {}

        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        if target not in parent and start != target:
            return []      # No path found.

        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive (respecting multiplicities).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find cells that currently hold this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive unavailable – abort early.
                return actions

            # Choose the nearest primitive (Manhattan distance).
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            nearest = prim_cells[dists.argmin()]
            tr, tc = nearest.tolist()

            # Move to the primitive cell.
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update our internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # No workshop info.

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # No workshop on the map.

    # Choose the nearest workshop cell.
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    nearest_ws = workshop_cells[dists.argmin()]
    wr, wc = nearest_ws.tolist()

    # Move to the workshop.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions


    # Reset environment and grab useful references
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # name ↔ id mapping

    # Resolve action indices from the env (robust to possible reordering)
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
