    # Reset the environment and obtain the initial state.
    obs = env.reset()
    # Mapping from action names to integer codes.
    act = env.action_specs()
    # World configuration (recipes, primitives, etc.).
    world = env.world
    # Goal item index for the current task.
    goal = env.task.goal

    # Primitive requirements for the goal (may be empty if the goal is primitive).
    primitive_needs = world.cookbook.primitives_for(goal).copy()

    # Current state and inventory.
    state = env._current_state
    inventory = state.inventory

    # Maximum number of steps allowed (fallback to a large number if not present).
    max_steps = getattr(env, "max_steps", 1000)

    actions_taken = []
    steps = 0

    while steps < max_steps:
        # Check if the goal has been achieved.
        if state.satisfies(None, goal):
            break

        # Determine which primitives are still missing.
        missing = {k: v - inventory[k] for k, v in primitive_needs.items() if inventory[k] < v}

        if missing:
            # Choose a needed primitive (first one in the dict).
            target_kind = next(iter(missing))
            # Find all cells containing this primitive.
            positions = np.argwhere(state.grid[:, :, target_kind] > 0)
            if positions.size == 0:
                # No more of this primitive on the map – abort.
                break
            # Pick the closest occurrence (Manhattan distance).
            agent_pos = np.array(state.pos)
            dists = np.sum(np.abs(positions - agent_pos), axis=1)
            target_pos = positions[dists.argmin()]
            dy, dx = target_pos - agent_pos

            # If adjacent, attempt to collect it.
            if abs(dy) + abs(dx) == 1:
                action = act["USE"]
                reward, new_state = env.step(action)
                actions_taken.append(action)
                state = new_state
                inventory = state.inventory
                steps += 1
                continue

            # Otherwise move one step towards the target.
            if abs(dy) > abs(dx):
                move_dir = "DOWN" if dy > 0 else "UP"
            else:
                move_dir = "RIGHT" if dx > 0 else "LEFT"
            action = act[move_dir]
        else:
            # All required primitives are collected – go to the workshop.
            recipe = world.cookbook.recipes.get(goal, {})
            workshop_kind = recipe.get("_at")
            if workshop_kind is None:
                # No workshop needed; break to avoid infinite loop.
                break
            positions = np.argwhere(state.grid[:, :, workshop_kind] > 0)
            if positions.size == 0:
                break
            agent_pos = np.array(state.pos)
            dists = np.sum(np.abs(positions - agent_pos), axis=1)
            target_pos = positions[dists.argmin()]
            dy, dx = target_pos - agent_pos

            if abs(dy) + abs(dx) == 1:
                action = act["USE"]
                reward, new_state = env.step(action)
                actions_taken.append(action)
                state = new_state
                inventory = state.inventory
                steps += 1
                continue

            if abs(dy) > abs(dx):
                move_dir = "DOWN" if dy > 0 else "UP"
            else:
                move_dir = "RIGHT" if dx > 0 else "LEFT"
            action = act[move_dir]

        # Execute the chosen movement action.
        reward, new_state = env.step(action)
        actions_taken.append(action)
        state = new_state
        inventory = state.inventory
        steps += 1

    return actions_taken

