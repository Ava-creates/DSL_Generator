    # Try to start from a fresh episode.
    try:
        env.reset()
    except Exception:
        pass

    actions = []

    # ------------------------------------------------------------------
    # Identify the goal index that the environment is asking for.
    # ------------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task"):
        task = getattr(env, "task")
        if hasattr(task, "goal"):
            goal_idx = task.goal
        elif isinstance(task, (list, tuple)) and len(task) > 0:
            goal_idx = task[0]

    if goal_idx is None:
        return actions

    # ------------------------------------------------------------------
    # Determine which primitive resources are required for this goal.
    # ``primitives_for`` expands the whole recipe tree and returns a map
    # from primitive kind index → required count.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Helper to move the agent from its current position to a target cell.
    # The function updates ``cur_pos`` in‑place so subsequent calls know the
    # new location.
    # ------------------------------------------------------------------
    cur_pos = list(env._current_state.pos)

    def move_to(target):
        """Return a list of actions that moves the agent from ``cur_pos`` to ``target``."""
        nonlocal cur_pos
        seq = []
        tx, ty = target
        # Move horizontally (x‑axis)
        while cur_pos[0] < tx:
            seq.append(3)          # RIGHT
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            seq.append(2)          # LEFT
            cur_pos[0] -= 1
        # Move vertically (y‑axis)
        while cur_pos[1] < ty:
            seq.append(0)          # DOWN
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            seq.append(1)          # UP
            cur_pos[1] -= 1
        return seq

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    used_cells = set()
    grid = env._current_state.grid

    for kind_idx, cnt in primitives_needed.items():
        # Find all cells that currently contain this primitive.
        positions = [tuple(p) for p in np.argwhere(grid[:, :, kind_idx] > 0)]
        pos_ptr = 0
        while cnt > 0 and pos_ptr < len(positions):
            cell = positions[pos_ptr]
            if cell in used_cells:
                pos_ptr += 1
                continue
            actions.extend(move_to(cell))
            actions.append(4)          # USE → pick up
            used_cells.add(cell)
            cnt -= 1
            pos_ptr += 1

    # ------------------------------------------------------------------
    # Finally, go to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_kind] > 0)]
        if ws_cells:
            actions.extend(move_to(ws_cells[0]))
            actions.append(4)          # USE → craft

    return actions


    # Reset the environment (ignore errors if already reset)
    try:
        env.reset()
    except Exception:
        pass

    actions = []

    # ----------------------------------------------------------------------
    # Identify the goal index from the environment's task description
    # ----------------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task"):
        task = getattr(env, "task")
        if hasattr(task, "goal"):
            goal_idx = task.goal
        elif isinstance(task, (list, tuple)):
            goal_idx = task[0]

    if goal_idx is None:
        return actions

    # ----------------------------------------------------------------------
    # Determine which primitive items are required for the goal.
    # `primitives_for` returns a flat dict of primitive kind → count.
    # ----------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    # ----------------------------------------------------------------------
    # Helper to move the agent from its current location to a target cell.
    # This naïve implementation uses Manhattan moves and ignores obstacles.
    # ----------------------------------------------------------------------
    cur_pos = list(env._current_state.pos)   # mutable copy of (x, y)

    def move_to(target):
        """Return a list of actions that moves the agent from cur_pos to target."""
        nonlocal cur_pos
        seq = []
        tx, ty = target
        while cur_pos[0] < tx:
            seq.append(3)          # RIGHT
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            seq.append(2)          # LEFT
            cur_pos[0] -= 1
        while cur_pos[1] < ty:
            seq.append(0)          # DOWN
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            seq.append(1)          # UP
            cur_pos[1] -= 1
        return seq

    # ----------------------------------------------------------------------
    # Collect each required primitive, preferring the nearest unused cell.
    # ----------------------------------------------------------------------
    used_cells = set()
    grid = env._current_state.grid

    for kind_idx, needed in primitives_needed.items():
        # Find all locations that currently contain this primitive.
        locations = [tuple(p) for p in np.argwhere(grid[:, :, kind_idx] > 0)]

        while needed > 0 and locations:
            # Choose the nearest location that hasn't been used yet.
            dists = [(abs(cur_pos[0] - x) + abs(cur_pos[1] - y), (x, y))
                     for (x, y) in locations if (x, y) not in used_cells]
            if not dists:
                break
            _, cell = min(dists, key=lambda t: t[0])

            # Move to the cell and pick up the primitive.
            actions.extend(move_to(cell))
            actions.append(4)          # USE to collect
            used_cells.add(cell)
            needed -= 1

    # ----------------------------------------------------------------------
    # After gathering primitives, move to the required workshop (if any) and craft.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_kind] > 0)]
        if workshop_cells:
            # Pick the nearest workshop.
            dists = [(abs(cur_pos[0] - x) + abs(cur_pos[1] - y), (x, y))
                     for (x, y) in workshop_cells]
            _, ws_target = min(dists, key=lambda t: t[0])
            actions.extend(move_to(ws_target))
            actions.append(4)          # USE to craft

    return actions

