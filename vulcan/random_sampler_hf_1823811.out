    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    actions = []
    cur_pos = env._current_state.pos
    # Work on a mutable copy of the grid so we can mark collected items as empty
    grid = env._current_state.grid.copy()
    world = env.world

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------
    def _bfs(start, goal, target_idx):
        """Breadth‑first search returning a list of actions (using the
        DOWN/UP/RIGHT/LEFT constants) that moves from start to goal.
        Cells that contain any entity are treated as blocked, except the
        goal cell when it holds the desired target_idx."""
        from collections import deque

        w, h = grid.shape[0], grid.shape[1]
        visited = set()
        prev = {}          # (x, y) -> (prev_x, prev_y, action)
        q = deque([start])
        visited.add(start)

        # direction vectors aligned with action indices
        dirs = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]

        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for dx, dy, act in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                    blocked = (grid[nx, ny, :] > 0).any()
                    # Allow stepping onto the goal even if it is otherwise blocked,
                    # provided it contains the required target entity.
                    if blocked and not (nx == goal[0] and ny == goal[1] and grid[nx, ny, target_idx] > 0):
                        continue
                    visited.add((nx, ny))
                    prev[(nx, ny)] = (x, y, act)
                    q.append((nx, ny))

        if goal not in prev and start != goal:
            return None

        # Reconstruct action list
        path = []
        cur = goal
        while cur != start:
            px, py, act = prev[cur]
            path.append(act)
            cur = (px, py)
        path.reverse()
        return path

    def _nearest_entity(pos, kind_idx):
        """Find the Manhattan‑closest cell (including current) that contains kind_idx."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])
        best = int(np.argmin(dists))
        return tuple(locs[best])

    # ------------------------------------------------------------------
    # Determine recipe for "arrow"
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_entity(cur_pos, prim_idx)
            if target is None:
                # Primitive missing – abort early
                return actions
            path = _bfs(cur_pos, target, prim_idx)
            if path is None:
                # No traversable path – abort early
                return actions
            actions.extend(path)
            actions.append(USE)          # pick up the primitive
            # Mark the primitive as collected in our local grid copy
            grid[target[0], target[1], prim_idx] -= 1
            cur_pos = target

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_entity(cur_pos, workshop_idx)
        if workshop_pos is not None:
            path = _bfs(cur_pos, workshop_pos, workshop_idx)
            if path is not None:
                actions.extend(path)
                actions.append(USE)      # craft at the workshop

    return actions


    # Action identifiers
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _manhattan_path(src, dst):
        """Return a list of actions that move from src to dst using Manhattan moves."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions.extend([DOWN] * dx)
        elif dx < 0:
            actions.extend([UP] * (-dx))
        if dy > 0:
            actions.extend([RIGHT] * dy)
        elif dy < 0:
            actions.extend([LEFT] * (-dy))
        return actions

    def _nearest_entity(pos, kind_idx):
        """Find the nearest cell (including current) that contains the given kind."""
        grid = env._current_state.grid
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        best = int(np.argmin(dists))
        return tuple(locations[best])

    # ------------------------------------------------------------------
    # Identify goal ('arrow') and its recipe
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_entity(cur_pos, prim_idx)
            if target is None:
                # Primitive not present in the world – abort early
                return actions
            actions.extend(_manhattan_path(cur_pos, target))
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # Move to workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_entity(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions.extend(_manhattan_path(cur_pos, workshop_pos))
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

