    # 2. Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target = _nearest_kind(cur_pos, prim_idx, planning_grid)
            if target is None:
                # Primitive missing – abort planning
                return actions
            actions += _move_actions(cur_pos, target, planning_grid)
            cur_pos = target
            actions.append(USE)  # pick up
            # Remove the primitive from the planning grid
            planning_grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx, planning_grid)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos, planning_grid)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

