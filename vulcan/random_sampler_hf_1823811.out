    from collections import deque

    # Bread‑first search for a path that ends on an empty cell adjacent to `target`
    def bfs_adj(start, target, occ):
        tr, tc = target
        # All free neighbours of the target that can be stood on
        adj = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occ.shape[0]
            and 0 <= tc + dc < occ.shape[1]
            and not occ[tr + dr, tc + dc]
        ]
        if not adj:
            return []
        q = deque([start])
        parent = {start: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if cur in adj:
                # Reconstruct path of direction names
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
