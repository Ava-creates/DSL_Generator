    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """
        Return a list of positions (excluding *start*, including *goal*)
        that leads from start to goal moving only through cells where
        occupied == False. The goal cell may be occupied (e.g., a resource or
        workshop).
        """
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Allow stepping onto the goal even if occupied
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # Reconstruct path backwards
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Map a movement delta to the environment's action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ------------------------------------------------------------------
    # Planning: collect primitives then craft at workshop (if any)
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # current (x, y) of the agent
    # Make a mutable copy of the grid to keep track of collected items
    grid = state.grid.copy()

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------------
    for kind_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find all remaining cells that contain this primitive
            candidates = np.argwhere(grid[:, :, kind_idx] > 0)
            if candidates.size == 0:
                break  # no more instances left on the map
            # Order candidates by Manhattan distance from current position
            dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked
            target = None
            path = None
            for idx in order:
                cand = tuple(candidates[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    target = cand
                    path = p
                    break
            if target is None:
                # Could not reach any remaining instance; skip this primitive
                continue

            # Follow the path, emitting movement actions
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # Use action to pick up the primitive
            actions.append(4)          # USE
            # Mark the primitive as collected in our mutable grid copy
            grid[target[0], target[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops occupy cells)
            for idx in order:
                cand = tuple(workshop_cells[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    for step in p:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # No specific workshop required; simply use the current cell to craft
        actions.append(4)

    return actions


