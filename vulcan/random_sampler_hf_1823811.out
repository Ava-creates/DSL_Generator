            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                break
            # Order candidates by Manhattan distance from current position
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            target = None
            path = None
            occupied_mask = np.any(grid, axis=2)   # any entity blocks movement
            for idx in order:
                cand = tuple(locations[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    target = cand
                    path = p
                    break
            if path is None:
                continue   # cannot reach any remaining instance

            # Follow the path, emitting movement actions
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # Use action to pick up the primitive
            actions.append(4)          # USE
            # Remove the primitive from our mutable copy
            grid[target[0], target[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
