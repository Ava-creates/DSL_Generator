    # Reset environment and obtain references
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Goal definition
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for a single arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Determine required workshop (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind, grid):
        """Return list of (x, y) where `kind` is present in `grid`."""
        occ = np.where(grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Translate a step from cur → nxt into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("non‑adjacent move requested")

    def bfs_path(start, goal, grid):
        """Shortest path from start to goal avoiding blocked cells."""
        if start == goal:
            return [start]
        W, H = grid.shape[:2]

        # Blocked cells: non‑grabbable entities + any occupied cell except the goal
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))
        occ = np.argwhere(grid.sum(axis=2) > 0)
        for x, y in occ:
            if (x, y) != goal:
                blocked.add((x, y))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay in place
        return [start]

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    cur_grid = state.grid.copy()          # mutable copy to reflect pickups
    inventory = state.inventory.copy()

    # 1) Collect all required primitives (use inventory first if possible)
    for prim_idx, total_needed in primitive_counts.items():
        needed = total_needed
        while needed > 0:
            if inventory[prim_idx] > 0:
                inventory[prim_idx] -= 1
                needed -= 1
                continue

            locations = find_locations(prim_idx, cur_grid)
            if not locations:
                raise RuntimeError(
                    f"Required primitive {idx.get(prim_idx, prim_idx)} not found on the map"
                )
            # Choose nearest occurrence (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]),
            )
            path = bfs_path(cur_pos, target, cur_grid)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)                     # USE to pick up
            inventory[prim_idx] += 1              # now have it
            inventory[prim_idx] -= 1              # consume for crafting
            # Remove primitive from mutable grid
            cur_grid[target[0], target[1], prim_idx] = 0
            needed -= 1

    # 2) Move to workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind, cur_grid)
        if not wk_locations:
            raise RuntimeError("Required workshop for crafting arrow not found on the map")
        target = min(
            wk_locations,
            key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]),
        )
        path = bfs_path(cur_pos, target, cur_grid)
        for step in path[1:]:
            actions.append(move_action(cur_pos, step))
            cur_pos = step
        actions.append(4)                         # USE to craft at workshop
    else:
        # No specific workshop – craft at current location
        actions.append(4)                         # USE to craft

    return actions


    # Reset environment and obtain useful references
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Identify goal (arrow) and its recipe information
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for a single arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind, grid):
        """Return list of (x, y) coordinates where `kind` is present in `grid`."""
        occ = np.where(grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Convert a step from cur → nxt into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("non‑adjacent move requested")

    def bfs_path(start, goal, grid):
        """Shortest path from start to goal avoiding occupied cells (except goal)."""
        if start == goal:
            return [start]
        W, H = grid.shape[:2]

        # Treat any occupied cell as blocked, except the goal cell itself
        blocked = set()
        occ = np.argwhere(grid.sum(axis=2) > 0)
        for x, y in occ:
            if (x, y) != goal:
                blocked.add((x, y))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay in place
        return [start]

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    cur_grid = state.grid.copy()   # mutable copy to reflect pickups

    # 1) Collect all required primitives (nearest first)
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            locations = locate(prim_idx, cur_grid)
            if not locations:
                # Primitive not present on map – assume already in inventory
                continue
            # Choose the nearest occurrence (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            # Move to the primitive
            path = bfs_path(cur_pos, target, cur_grid)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # Pick it up
            actions.append(4)                     # USE
            # Update mutable grid copy
            cur_grid[target[0], target[1], prim_idx] = 0

    # 2) Move to the workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locs = locate(workshop_kind, cur_grid)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target, cur_grid)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
        actions.append(4)                         # USE to craft at workshop
    else:
        # No specific workshop – craft at current location
        actions.append(4)                         # USE to craft

    return actions

