    # Reset environment to ensure a fresh state
    try:
        env.reset()
    except Exception:
        pass

    # Obtain the current CraftState from the environment
    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # --------------------------------------------------------------
    # Identify the goal item ('arrow') and its recipe
    # --------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # no arrow defined in the cookbook

    # Primitive requirements for a single arrow
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # Determine the workshop required for crafting the arrow
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                     # recipe lacks workshop information
    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # workshop name not indexed

    # --------------------------------------------------------------
    # Local mutable copies for planning / simulation
    # --------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y) agent position
    grid = state.grid.copy()                   # (W, H, n_kinds) occupancy
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells

    plan = []                                   # list of action indices to return

    # --------------------------------------------------------------
    # Constants & helper utilities
    # --------------------------------------------------------------
    # Action ordering follows CraftLab.action_specs
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    from collections import deque

    def bfs_adjacent(start, target, blocked):
        """Return a list of movement actions that brings the agent from *start*
        to any empty cell that is 4‑connected to *target*.
        If unreachable, returns an empty list."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []          # target completely surrounded by obstacles
        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable

    def move_and_use(target, kind_idx):
        """Move adjacent to *target* (which contains *kind_idx*) and issue USE.
        Updates simulated position, grid, occupied map and inventory.
        Returns False if movement to an adjacent cell is impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # Simulate movement actions
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # Perform USE action
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            # Pick up the primitive (or interact with workshop)
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # --------------------------------------------------------------
    # Collect all required primitives
    # --------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # Primitive not present on the map – abort planning
                return plan
            # Choose the nearest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # --------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # --------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # Workshops are static; fall back to original grid if they were cleared in simulation
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan


    # ----------------------------------------------------------------------
    # Reset / obtain current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass
    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and extract its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # no arrow defined in the index

    # Primitive requirements for a single arrow
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # Determine which workshop is required (stored under "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                     # recipe lacks workshop information
    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # workshop not indexed

    # ----------------------------------------------------------------------
    # Local mutable copies for planning simulation
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y) agent position
    grid = state.grid.copy()                   # (W, H, n_kinds) occupancy
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells
    plan = []                                   # list of action indices to return

    # ----------------------------------------------------------------------
    # Action constants and movement helpers
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    def bfs_adjacent(start, target, blocked):
        """Return a list of movement actions that brings the agent from *start*
        to any empty cell that is 4‑connected to *target*.
        If unreachable, returns an empty list."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []          # target completely surrounded by obstacles
        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable

    def move_and_use(target, kind_idx):
        """Move adjacent to *target* (which contains *kind_idx*) and issue USE.
        Updates simulated position, grid, occupied map and inventory.
        Returns False on failure, True otherwise."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # Execute movement actions in the simulated world
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # Perform the USE action
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            # Pick up the primitive / interact with workshop
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives (may need multiple of each)
    # ----------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # Primitive not present anywhere – abort planning
                return plan
            # Choose the nearest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the appropriate workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan

