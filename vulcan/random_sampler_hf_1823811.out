    # Action identifiers
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its index in the recipe book
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # arrow not defined in this world
    goal_idx = index[goal_name]

    # ------------------------------------------------------------------
    # Determine which primitive resources are needed for a single arrow
    # ------------------------------------------------------------------
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # Simple BFS path‑finder (4‑connected Manhattan moves)
    # ------------------------------------------------------------------
    def bfs(start, target):
        """Return a list of positions from start to target (inclusive).
        Returns None if target is unreachable."""
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)          # True where any entity sits
        occupied[target] = False                           # we may step onto target
        q = collections.deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:
                    nxt = (nr, nc)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        q.append(nxt)
        else:
            return None  # target never reached

        # reconstruct path
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Map movement deltas to action indices
    # ------------------------------------------------------------------
    delta_to_action = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, 1): RIGHT,
        (0, -1): LEFT,
    }

    # ------------------------------------------------------------------
    # 1. Collect all required primitive items
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate any remaining instance of this primitive on the grid
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return actions  # cannot find needed primitive, abort planning

            target = tuple(cells[0])  # (row, col)

            # Compute a path to the primitive
            path = bfs(state.pos, target)
            if path is None:
                return actions  # unreachable primitive

            # Translate path steps into actions
            for (r0, c0), (r1, c1) in zip(path, path[1:]):
                act = delta_to_action[(r1 - r0, c1 - c0)]
                actions.append(act)
                state.pos = (r1, c1)

            # Pick up the primitive
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the workshop and craft the arrow
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # No workshop information; cannot craft

