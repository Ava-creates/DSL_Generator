    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to find a shortest sequence of movement actions from the
    # current position to a cell that contains the desired kind. The search
    # may step onto the target cell itself (even though it is occupied) but
    # otherwise only traverses empty cells.
    # ------------------------------------------------------------------
    def find_path_to(state, target_kind):
        grid = state.grid
        H, W, _ = grid.shape
        start = state.pos
        visited = set([start])
        from collections import deque
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            # If this cell holds the target entity, we have arrived
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow movement onto empty cells or directly onto the target cell
                cell_occupied = grid[nx, ny, :].sum() > 0
                if cell_occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        return None  # target not reachable

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for kind, count in required.items():
        for _ in range(count):
            path = find_path_to(state, kind)
            if path is None:
                # If unreachable, abort collection for this primitive
                continue
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use action to pick up the primitive now under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop specified by the recipe and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path_to(state, workshop_kind)
        if path:
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use the workshop to craft the item
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    return actions

