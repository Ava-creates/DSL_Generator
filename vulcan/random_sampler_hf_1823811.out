    # Determine if the goal requires a specific workshop
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_name = recipe["_at"]
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # ------------------------------------------------------------------ #
    # Helper utilities
    # ------------------------------------------------------------------ #
    def locate(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step_action(act):
        """Execute an action, update the local `state`, and return nothing."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def go_to(target):
        """Move (Manhattan) from current position to `target` using the four move actions."""
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right (increase x)
                act = 3          # RIGHT
            elif x > tx:        # need to move left
                act = 2          # LEFT
            elif y < ty:        # need to move down (increase y)
                act = 0          # DOWN
            else:               # need to move up
                act = 1          # UP
            actions.append(act)
            step_action(act)

    # ------------------------------------------------------------------ #
    # 1) Collect all required primitives
    # ------------------------------------------------------------------ #
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:          # primitive not present – abort early
                return actions
            # pick the nearest occurrence to reduce travel distance
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # pick up the item (USE)
            actions.append(4)          # USE
            step_action(4)

    # ------------------------------------------------------------------ #
    # 2) Go to the required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------ #
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target = min(ws_positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            actions.append(4)          # USE to craft at the workshop
            step_action(4)

    return actions


    # Reset environment to start fresh
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index (item we need to produce)
    goal_idx = env.task.goal

    # Primitive requirements for one unit of the goal (recursively expanded)
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine workshop (if any) required to craft the goal
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_name = recipe["_at"]
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # ------------------------------------------------------------------ #
    # Helper utilities
    # ------------------------------------------------------------------ #
    WIDTH, HEIGHT = state.grid.shape[:2]

    def locate(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step_action(act):
        """Execute an action, update local `state`."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def manhattan(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    # direction mapping for movement actions
    DIR_MAP = {
        (0, 1): 0,   # DOWN  (y + 1)
        (0, -1): 1,  # UP    (y - 1)
        (-1, 0): 2,  # LEFT  (x - 1)
        (1, 0): 3,   # RIGHT (x + 1)
    }

    def bfs(start, goal):
        """Return list of positions from start to goal (inclusive) using 4‑way moves."""
        q = collections.deque()
        q.append(start)
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:
                    # cell must be empty to step onto
                    if state.grid[nx, ny, :].sum() == 0 and (nx, ny) not in came_from:
                        came_from[(nx, ny)] = cur
                        q.append((nx, ny))
        if goal not in came_from:
            return None
        # reconstruct path
        path = []
        cur = goal
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    def move_along(path):
        """Convert a path (list of positions) to actions, updating state."""
        for prev, nxt in zip(path, path[1:]):
            dx = nxt[0] - prev[0]
            dy = nxt[1] - prev[1]
            act = DIR_MAP[(dx, dy)]
            actions.append(act)
            step_action(act)

    def go_adjacent_to(target_pos):
        """
        Move to an empty cell adjacent to `target_pos`.
        Returns the adjacent cell chosen (or None if impossible).
        """
        tx, ty = target_pos
        # candidate adjacent cells (must be inside grid and empty)
        candidates = []
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            cx, cy = tx + dx, ty + dy
            if 0 <= cx < WIDTH and 0 <= cy < HEIGHT:
                if state.grid[cx, cy, :].sum() == 0:
                    candidates.append((cx, cy))
        if not candidates:
            return None
        # pick candidate with minimal Manhattan distance from current position
        adj = min(candidates, key=lambda p: manhattan(state.pos, p))
        path = bfs(state.pos, adj)
        if path is None:
            return None
        move_along(path)
        return adj

    def face_and_use(target_pos):
        """Turn towards `target_pos` (by issuing a move action) and USE."""
        ax, ay = state.pos
        tx, ty = target_pos
        dx, dy = tx - ax, ty - ay
        # one of dx, dy should be 0 and the other +/-1
        if (dx, dy) not in DIR_MAP:
            # not directly adjacent – should not happen
            return
        turn_act = DIR_MAP[(dx, dy)]
        actions.append(turn_act)
        step_action(turn_act)   # may stay in place but updates direction
        actions.append(4)       # USE
        step_action(4)

    # ------------------------------------------------------------------ #
    # 1) Collect all required primitives
    # ------------------------------------------------------------------ #
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # primitive missing – abort early
                return actions
            # choose the nearest occurrence
            target = min(positions, key=lambda p: manhattan(state.pos, p))
            adj = go_adjacent_to(target)
            if adj is None:
                # cannot reach – abort
                return actions
            face_and_use(target)

    # ------------------------------------------------------------------ #
    # 2) Go to required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------ #
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target = min(ws_positions, key=lambda p: manhattan(state.pos, p))
            adj = go_adjacent_to(target)
            if adj is not None:
                face_and_use(target)

    return actions

