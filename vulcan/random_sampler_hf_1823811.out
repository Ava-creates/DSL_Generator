    # Reset environment and obtain initial state/world references
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Goal index and primitive requirements (recursively expanded)
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)
    # If the goal itself is a primitive, collect one instance of it
    if not required:
        required = {goal_idx: 1}

    # Action identifiers (consistent with CraftLab)
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    import numpy as np
    from collections import deque

    def find_path(cur_state, target_kind):
        """
        Breadth‑first search returning a list of movement actions that bring the
        agent to any cell containing `target_kind`. The agent may step onto the
        target cell even if occupied, but otherwise avoids any occupied cell.
        """
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow moving onto empty cells or the target cell itself
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # If unreachable, return empty list (should not happen in valid scenarios)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

