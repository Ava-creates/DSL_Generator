    def move_towards(cur_pos, target_pos):
        cx, cy = cur_pos
        tx, ty = target_pos
        if cx < tx:
            return ACTION_RIGHT
        if cx > tx:
            return ACTION_LEFT
        if cy < ty:
            return ACTION_DOWN
        if cy > ty:
            return ACTION_UP
        return None

