    # Reset environment and fetch current state
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # Identify the target item and its recipe
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []  # unknown goal
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Find a walkable path from start to goal (goal may be occupied)."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Allow stepping onto the goal even if it is occupied
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # Reconstruct path (excluding start, including goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Convert a movement delta into an action index."""
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise ValueError("Invalid movement delta")

    actions = []
    cur_pos = tuple(state.pos)

    # Work on a mutable copy of the grid to track collected primitives
    grid = state.grid.copy()

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    def find_nearest(kind_idx, cur):
        """Return (target_cell, path) for the closest reachable primitive of kind."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None, None
        dists = np.abs(locations[:, 0] - cur[0]) + np.abs(locations[:, 1] - cur[1])
        order = np.argsort(dists)
        occupied_mask = np.any(grid, axis=2)
        for idx in order:
            target = tuple(locations[idx])
            path = bfs_path(cur, target, occupied_mask)
            if path is not None:
                return target, path
        return None, None

    for kind_idx, needed in list(primitive_needs.items()):
        for _ in range(needed):
            target, path = find_nearest(kind_idx, cur_pos)
            if target is None:
                # Cannot reach remaining instances of this primitive
                continue
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            actions.append(4)                     # USE to pick up
            grid[target[0], target[1], kind_idx] = 0   # remove from copy

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops are occupied)
            for idx in order:
                target = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, target, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break

    return actions


    import numpy as np
    from collections import deque

    # Reset environment and get current state and world info
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # Identify goal item and its recipe
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # Helper: BFS to find a walkable path (allow stepping onto goal cell)
    def bfs_path(start, goal, occupied):
        w, h = occupied.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Goal cell may be occupied; treat it as walkable
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path (exclude start, include goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    # Helper: translate a step delta into an action index
    def delta_to_action(dx, dy):
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise ValueError("Invalid movement delta")

    actions = []
    cur_pos = tuple(state.pos)
    # Work on a mutable copy of the grid to track collected primitives
    grid = state.grid.copy()

    # --------------------------------------------------------------
    # Collect all required primitives (including multiple copies)
    # --------------------------------------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # Find all remaining cells containing this primitive
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                break  # nothing left
            # Sort by Manhattan distance from current position
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(grid, axis=2)
            chosen_path = None
            target_cell = None
            for idx in order:
                cand = tuple(locations[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    chosen_path = path
                    target_cell = cand
                    break
            if chosen_path is None:
                # unable to reach any instance of this primitive
                continue
            # Follow the path
            for step in chosen_path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # Pick up the primitive
            actions.append(4)   # USE
            grid[target_cell[0], target_cell[1], kind_idx] = 0

    # --------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops occupy cells)
            for idx in order:
                cand = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to craft
                    break

    return actions

