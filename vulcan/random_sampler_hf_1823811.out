    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _manhattan_path(src, dst):
        """Return a list of actions that move from src to dst using Manhattan moves."""
        actions = []
        x, y = src
        tx, ty = dst
        # vertical movement (row index)
        while x < tx:
            actions.append(DOWN)
            x += 1
        while x > tx:
            actions.append(UP)
            x -= 1
        # horizontal movement (column index)
        while y < ty:
            actions.append(RIGHT)
            y += 1
        while y > ty:
            actions.append(LEFT)
            y -= 1
        return actions

    def _nearest_entity(pos, kind_idx):
        """Find the closest cell (Manhattan distance) that contains the given kind."""
        grid = env._current_state.grid
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        best = int(np.argmin(dists))
        return tuple(locations[best])

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    world = env.world
    idx_arrow = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(idx_arrow)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, required_cnt in primitives_needed.items():
        for _ in range(required_cnt):
            target = _nearest_entity(cur_pos, prim_idx)
            if target is None:
                # Primitive not present – abort early
                return actions
            actions += _manhattan_path(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(idx_arrow, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_entity(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _manhattan_path(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions


    import numpy as np
    from collections import deque

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    world = env.world
    idx_arrow = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(idx_arrow)

    actions = []
    cur_pos = env._current_state.pos
    grid = env._current_state.grid.copy()

    def bfs_path(start, goal, grid):
        if start == goal:
            return []
        H, W = grid.shape[:2]
        visited = np.full((H, W), False, dtype=bool)
        prev = {}
        q = deque()
        q.append(start)
        visited[start] = True
        while q:
            x, y = q.popleft()
            for dx, dy, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:
                    if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:
                        continue
                    visited[nx, ny] = True
                    prev[(nx, ny)] = ((x, y), act)
                    if (nx, ny) == goal:
                        path = []
                        cur = goal
                        while cur != start:
                            (p, a) = prev[cur]
                            path.append(a)
                            cur = p
                        path.reverse()
                        return path
                    q.append((nx, ny))
        return None

    def find_nearest(pos, kind_idx, grid):
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        best_path = None
        best_loc = None
        for loc in locs:
            loc_tup = (int(loc[0]), int(loc[1]))
            path = bfs_path(pos, loc_tup, grid)
            if path is None:
                continue
            if best_path is None or len(path) < len(best_path):
                best_path = path
                best_loc = loc_tup
        return best_loc, best_path

    # Collect required primitives
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target, path = find_nearest(cur_pos, prim_idx, grid)
            if target is None:
                return actions
            actions.extend(path)
            actions.append(USE)
            cur_pos = target
            if grid[target[0], target[1], prim_idx] > 0:
                grid[target[0], target[1], prim_idx] -= 1

    # Move to workshop (if required) and craft
    recipe = world.cookbook.recipes.get(idx_arrow, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        target, path = find_nearest(cur_pos, workshop_idx, grid)
        if target is not None:
            actions.extend(path)
            actions.append(USE)

    return actions

