    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    import numpy as np
    from collections import deque

    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Return a list of positions (excluding `start`) that leads from `start`
        to `target` using 4‑connected moves, avoiding occupied cells.
        The target cell itself may be occupied (e.g., a workshop) and is
        treated as free for stepping onto it.
        """
        w, h = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                npos = (nx, ny)
                if npos in visited:
                    continue
                if occupied[nx, ny] and npos != target:
                    continue
                visited.add(npos)
                q.append((npos, path + [npos]))
        return []  # unreachable

    def follow_path(path):
        """Convert a list of positions into actions, update `state`, and record them."""
        nonlocal state
        for nxt in path:
            x, y = state.pos
            nx, ny = nxt
            if nx > x:
                act = 3          # RIGHT
            elif nx < x:
                act = 2          # LEFT
            elif ny > y:
                act = 0          # DOWN
            else:
                act = 1          # UP
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1. Collect all required primitives.
    for kind_idx, required_cnt in needed.items():
        while state.inventory[kind_idx] < required_cnt:
            positions = locate(kind_idx)
            if not positions:
                # Primitive not present on the map – abort early.
                return actions

            # Find the shortest reachable instance.
            best_path = None
            for pos in positions:
                p = bfs_path(state.pos, pos)
                if p and (best_path is None or len(p) < len(best_path)):
                    best_path = p
            if not best_path:
                # No reachable instance – abort.
                return actions

            # Move to the primitive and pick it up.
            follow_path(best_path)
            actions.append(4)          # USE to collect
            _, state = state.step(4)

    # 2. Move to the required workshop (if any) and craft.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            # Choose the closest reachable workshop.
            best_ws_path = None
            for ws in ws_positions:
                p = bfs_path(state.pos, ws)
                if p and (best_ws_path is None or len(p) < len(best_ws_path)):
                    best_ws_path = p
            if best_ws_path:
                follow_path(best_ws_path)

    # 3. Perform the crafting action.
    actions.append(4)                  # USE to trigger crafting
    _, state = state.step(4)

    return actions

