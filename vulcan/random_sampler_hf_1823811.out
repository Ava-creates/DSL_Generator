    # Action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def _is_walkable(grid, pos, ignore_kind=None):
        """Return True if the cell at `pos` can be stepped on.
        All non‑zero entries block movement, except the entity given by
        `ignore_kind` which we allow to occupy the cell (used when we intend
        to pick it up or stand on a workshop)."""
        x, y = pos
        cell = grid[x, y, :]
        if ignore_kind is not None and cell[ignore_kind] > 0:
            # allow stepping onto the target primitive/workshop only if it is the
            # sole occupant of the cell (grid is one‑hot, so this is sufficient)
            return np.count_nonzero(cell) == 1
        return not cell.any()

    def _bfs_path(grid, start, goal, ignore_kind=None):
        """Find a shortest 4‑connected path from `start` to `goal`.
        Returns a list of positions (including both ends) or None if unreachable."""
        if start == goal:
            return [start]
        width, height = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(grid, nxt, ignore_kind):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of adjacent positions into a list of action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(grid, src, dst, ignore_kind=None):
        """Return actions to move from `src` to `dst`; fall back to Manhattan moves."""
        path = _bfs_path(grid, src, dst, ignore_kind)
        if path is None:
            # simple Manhattan (may collide with obstacles)
            acts = []
            x, y = src
            tx, ty = dst
            dx = tx - x
            dy = ty - y
            if dx > 0:
                acts += [DOWN] * dx
            elif dx < 0:
                acts += [UP] * (-dx)
            if dy > 0:
                acts += [RIGHT] * dy
            elif dy < 0:
                acts += [LEFT] * (-dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(grid, pos, kind_idx):
        """Find the nearest cell containing `kind_idx` (Manhattan distance)."""
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # 1. Determine primitives required for an arrow
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # 2. Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)          # current agent position
    grid = env._current_state.grid                    # current grid snapshot

    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target = _nearest_kind(grid, cur_pos, prim_idx)
            if target is None:
                # primitive not present – abort planning
                return actions
            # move to the primitive (allow stepping onto it)
            actions += _move_actions(grid, cur_pos, target, ignore_kind=prim_idx)
            cur_pos = target
            actions.append(USE)                       # pick it up
            # simulate removal of the primitive from the grid
            grid = np.copy(grid)
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Move to the workshop (if the recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(grid, cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(grid, cur_pos, workshop_pos, ignore_kind=workshop_idx)
            cur_pos = workshop_pos
            actions.append(USE)                       # craft at the workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _is_walkable(grid, pos, ignore_kind=None):
        """True if the cell at `pos` can be stepped on."""
        x, y = pos
        cell = grid[x, y, :]
        if ignore_kind is not None and cell[ignore_kind] > 0:
            # allow stepping onto the target primitive (and nothing else)
            return np.count_nonzero(cell) == 1
        return not cell.any()

    def _bfs_path(grid, start, goal, ignore_kind=None):
        """Shortest 4‑connected path from start to goal, avoiding blocked cells."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(grid, nxt, ignore_kind):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # unreachable

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(grid, src, dst, ignore_kind=None):
        """Return actions to move from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(grid, src, dst, ignore_kind)
        if path is None:
            # Manhattan fallback – may collide with obstacles but guarantees a result
            actions = []
            x, y = src
            tx, ty = dst
            dx = tx - x
            dy = ty - y
            if dx > 0:
                actions += [DOWN] * dx
            elif dx < 0:
                actions += [UP] * (-dx)
            if dy > 0:
                actions += [RIGHT] * dy
            elif dy < 0:
                actions += [LEFT] * (-dy)
            return actions
        return _actions_from_path(path)

    def _nearest_kind(grid, pos, kind_idx):
        """Find the closest cell containing `kind_idx` (Manhattan distance)."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = locations[dists.argmin()]
        return int(nearest[0]), int(nearest[1])

    # ------------------------------------------------------------------
    # 1. Identify the goal (arrow) and its primitive requirements
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # 2. Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)
    grid = np.copy(env._current_state.grid)

    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_kind(grid, cur_pos, prim_idx)
            if target is None:
                # required primitive not present – abort planning
                return actions
            actions += _move_actions(grid, cur_pos, target, ignore_kind=prim_idx)
            cur_pos = target
            actions.append(USE)  # pick up the primitive
            # update simulated grid: primitive disappears after pickup
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(grid, cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(grid, cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)  # craft at the workshop

    return actions

