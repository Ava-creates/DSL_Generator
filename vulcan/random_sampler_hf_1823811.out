        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest traversable path (list of positions) from start to goal,
        avoiding cells occupied by non‑grabbable entities."""
        if start == goal:
            return [start]

        width, height = state.grid.shape[:2]

        # Build blocked set from non‑grabbable entities
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}

        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay put
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur to adjacent nxt into an action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3  # RIGHT
        if dx == -1:
            return 2  # LEFT
        if dy == 1:
            return 0  # DOWN
        if dy == -1:
            return 1  # UP
        raise AssertionError("Non‑adjacent move requested")

    # ------------------------------------------------------------------
    # Build the action list
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) Collect all required primitives
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            locations = find_locations(prim_idx)
            if not locations:
                # No more of this primitive on the map – give up on this type
                break

            # Choose nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )

            # Move to target
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)  # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2) Move to workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
