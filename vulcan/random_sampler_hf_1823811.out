    # Reset environment and obtain initial state and world objects
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld

    # Goal item index (arrow)
    goal_idx = env.task.goal

    # Action indices from the environment's specification
    action_map = env.action_specs()
    ACTION_DOWN = action_map["DOWN"]
    ACTION_UP = action_map["UP"]
    ACTION_LEFT = action_map["LEFT"]
    ACTION_RIGHT = action_map["RIGHT"]
    ACTION_USE = action_map["USE"]

    # Direction vectors paired with corresponding actions
    move_dirs = [
        (1, 0, ACTION_DOWN),   # down
        (-1, 0, ACTION_UP),    # up
        (0, -1, ACTION_LEFT),  # left
        (0, 1, ACTION_RIGHT)   # right
    ]

    actions = []

    def find_path(cur_state, target_kind):
        """
        Breadth‑first search that returns a list of movement actions
        leading from the agent's current position to any cell containing
        `target_kind`. Cells occupied by other entities are treated as
        obstacles, except the target cell itself.
        """
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                occupied = np.any(grid[nx, ny, :] > 0)
                # Allow stepping onto the target cell even if occupied
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # No reachable cell found (should not happen in valid scenarios)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources.
    # ------------------------------------------------------------------
    required = world.cookbook.primitives_for(goal_idx)   # {primitive_kind: count}
    for kind, count in required.items():
        for _ in range(count):
            path = find_path(state, kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the arrow
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions


    import collections

    # reset environment and get handles
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # goal index and action mapping
    goal_idx = env.task.goal
    action_map = env.action_specs()
    ACTION_DOWN = action_map["DOWN"]
    ACTION_UP = action_map["UP"]
    ACTION_LEFT = action_map["LEFT"]
    ACTION_RIGHT = action_map["RIGHT"]
    ACTION_USE = action_map["USE"]
    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    actions = []

    def find_path(cur_state, target_kind):
        """BFS returning a list of movement actions to reach any cell
        containing `target_kind`.  Non‑grabbable entities are treated as
        obstacles unless they are the target itself (e.g., a workshop)."""
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # check obstacles: any non‑grabbable entity blocks movement
                blocked = any(grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)
                # allow stepping onto target if it itself is non‑grabbable (e.g., workshop)
                if blocked and target_kind not in world.non_grabbable_indices:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # target not reachable – return empty path
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    required = world.cookbook.primitives_for(goal_idx)
    for kind, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # pick up the primitive
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # use the workshop to craft
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

