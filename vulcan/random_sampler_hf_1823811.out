    # ----------------------------------------------------------------------
    # This implementation provides a generic (but functional) skeleton for
    # generating a sequence of actions that will collect the required
    # primitives for the “arrow” item and then craft it at the appropriate
    # workshop.  The function works with the high‑level CraftLab interface
    # (i.e. an object that exposes ``world`` and ``_current_state`` attributes
    # similar to the classes described in the specification).
    #
    # The algorithm follows these steps:
    #   1. Identify the integer index of the target item (“arrow”) via the
    #      world’s cookbook.
    #   2. Query the cookbook for the primitive requirements of the target.
    #   3. For each required primitive:
    #        a. Locate the nearest cell that currently contains the primitive.
    #        b. Plan a Manhattan‑distance path to that cell while avoiding
    #           blocked cells (any non‑zero entry in the grid for a non‑grabbable
    #           kind).
    #        c. Append the movement actions that follow the path.
    #        d. Append a ``USE`` action to pick up the primitive.
    #   4. After all primitives are collected, move to the workshop cell where
    #      the arrow can be crafted (the workshop type is stored in the recipe
    #      under the special key ``\"_at\"``) and issue a final ``USE`` to craft.
    #
    # The function returns the list of integer actions.  If any step fails
    # (e.g. a primitive cannot be found), the algorithm stops early and returns
    # the actions accumulated up to that point.
    #
    # NOTE: The implementation relies on the following conventions from the
    # environment:
    #   * Action constants are accessible via ``env.world`` attributes:
    #         env.world.DOWN, env.world.UP, env.world.LEFT, env.world.RIGHT, env.world.USE
    #   * The current state can be accessed through ``env._current_state`` (as
    #         used by ``CraftLab``).  This state provides ``grid`` (shape
    #         (W, H, n_kinds)) and ``pos`` (x, y) attributes.
    #   * The grid is binary: ``grid[x, y, k] == 1`` indicates the presence of an
    #         entity of kind ``k`` at that location.
    #   * Non‑grabbable entities are listed in ``env.world.non_grabbable_indices``.
    #   * The inventory is a 1‑D array ``inventory`` indexed by kind.
    #
    # If the environment does not expose exactly these attributes, the code
    # degrades gracefully by returning an empty action list.
    # ----------------------------------------------------------------------
    actions = []

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    def _manhattan_path(start, goal, blocked):
        """Return a simple Manhattan path (list of (dx, dy) moves) from start to goal,
        avoiding cells listed in ``blocked`` (set of (x, y) tuples).  The path is
        generated greedily: first move horizontally, then vertically, skipping any
        step that would land in a blocked cell.  If a step is blocked, the function
        tries the alternative axis; if both are blocked it aborts and returns the
        partial path computed so far.
        """
        x, y = start
        gx, gy = goal
        path = []

        # Horizontal moves
        while x != gx:
            nx = x + (1 if gx > x else -1)
            if (nx, y) not in blocked:
                path.append((nx - x, 0))
                x = nx
            else:
                break

        # Vertical moves
        while y != gy:
            ny = y + (1 if gy > y else -1)
            if (x, ny) not in blocked:
                path.append((0, ny - y))
                y = ny
            else:
                break

        return path

    def _move_actions(dx, dy):
        """Translate a single (dx, dy) step into the corresponding environment action."""
        if dx == 1:
            return env.world.RIGHT
        if dx == -1:
            return env.world.LEFT
        if dy == 1:
            return env.world.DOWN
        if dy == -1:
            return env.world.UP
        # No movement (should not happen)
        return None

    # ----------------------------------------------------------------------
    # Retrieve target item index and its recipe
    # ----------------------------------------------------------------------
    try:
        target_name = "arrow"
        target_idx = env.world.cookbook.index[target_name]
    except Exception:
        # Cannot determine target index – return empty plan
        return actions

    # Primitive requirements for one arrow (dict {kind_idx: count})
    primitives_needed = env.world.cookbook.primitives_for(target_idx)

    # ----------------------------------------------------------------------
    # Access current state (grid, position, inventory)
    # ----------------------------------------------------------------------
    try:
        state = env._current_state
        grid = state.grid
        pos = tuple(state.pos)          # (x, y)
        inventory = state.inventory.copy()
        non_grabbable = set(env.world.non_grabbable_indices)
    except Exception:
        # If the environment does not expose the expected API, give up.
        return actions

    # ----------------------------------------------------------------------
    # Main collection loop
    # ----------------------------------------------------------------------
    for kind_idx, required_cnt in primitives_needed.items():
        while inventory[kind_idx] < required_cnt:
            # Locate the nearest cell that currently holds the required primitive
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # Primitive not present anywhere – cannot continue
                return actions

            # Compute Manhattan distances from current position
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            nearest = locations[np.argmin(dists)]
            target_pos = (int(nearest[0]), int(nearest[1]))

            # Determine blocked cells (any non‑grabbable entity)
            blocked_cells = set()
            for blk_idx in non_grabbable:
                blk_coords = np.argwhere(grid[:, :, blk_idx] > 0)
                for bx, by in blk_coords:
                    blocked_cells.add((int(bx), int(by)))

            # Generate a simple path
            path = _manhattan_path(pos, target_pos, blocked_cells)

            # Translate path steps into actions
            for dx, dy in path:
                act = _move_actions(dx, dy)
                if act is None:
                    continue
                actions.append(act)
                # Update simulated position
                pos = (pos[0] + dx, pos[1] + dy)

            # After reaching the cell, use the USE action to pick up the primitive
            actions.append(env.world.USE)
            # Simulate the pickup: update inventory and clear the cell
            inventory[kind_idx] += 1
            grid[target_pos[0], target_pos[1], kind_idx] = 0

    # ----------------------------------------------------------------------
    # All primitives collected – move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    # The workshop type is stored in the recipe under the special key "_at".
    try:
        recipe = env.world.cookbook.recipes[target_idx]
        workshop_kind = recipe["_at"]
    except Exception:
        # No workshop information – cannot craft
        return actions

    # Find any workshop cell of the required type
    workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
    if workshop_cells.size == 0:
        # No workshop present – cannot craft
        return actions

    # Choose the nearest workshop
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    nearest_ws = workshop_cells[np.argmin(dists)]
    ws_pos = (int(nearest_ws[0]), int(nearest_ws[1]))

    # Move to the workshop
    blocked_cells = set()
    for blk_idx in non_grabbable:
        blk_coords = np.argwhere(grid[:, :, blk_idx] > 0)
        for bx, by in blk_coords:
            blocked_cells.add((int(bx), int(by)))

    path_to_ws = _manhattan_path(pos, ws_pos, blocked_cells)
    for dx, dy in path_to_ws:
        act = _move_actions(dx, dy)
        if act is None:
            continue
        actions.append(act)
        pos = (pos[0] + dx, pos[1] + dy)

    # Craft the arrow with a final USE action
    actions.append(env.world.USE)

    return actions


    # Reset the environment to start a fresh episode and obtain the observation.
    # The observation is not used directly; we only need the action space.
    env.reset()
    # Retrieve the list of possible actions from the environment.
    # `action_specs` returns a dict mapping action names to integer indices.
    action_space = list(env.action_specs().values())

    actions = []
    done = False
    steps = 0
    # Upper bound on the number of steps we are willing to try. 2000 is
    # generous enough for the typical CraftWorld scenarios while still
    # preventing an infinite loop if something goes wrong.
    MAX_STEPS = 2000

    while not done and steps < MAX_STEPS:
        # Choose a random action from the available actions.
        act = np.random.choice(action_space)
        actions.append(int(act))
        # Perform the action; the environment returns (reward, done, obs).
        # We only care about the `done` flag which signals that the goal
        # (making an arrow) has been achieved or the episode limit was hit.
        _, done, _ = env.step(act)
        steps += 1

    return actions

