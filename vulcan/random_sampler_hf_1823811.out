    # Reset the environment and obtain the initial state
    env.reset()
    state = env._current_state
    world = env.world

    # Action mappings
    act_map = env.action_specs()                     # name → index
    idx_to_name = {v: k for k, v in act_map.items()}  # index → name

    # Direction vectors corresponding to action names
    dir_vec = {
        "UP": (0, -1),
        "DOWN": (0, 1),
        "LEFT": (-1, 0),
        "RIGHT": (1, 0),
    }

    # Helper: check whether a cell is free (no entity occupies it)
    def walkable(pos):
        x, y = pos
        if not (0 <= x < state.grid.shape[0] and 0 <= y < state.grid.shape[1]):
            return False
        return state.grid[x, y, :].sum() == 0

    # Bread‑first search returning a list of action indices that reaches any cell in target_set
    from collections import deque

    def bfs(start, target_set):
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            cur, path = q.popleft()
            if cur in target_set:
                return path
            for name, (dx, dy) in dir_vec.items():
                nx, ny = cur[0] + dx, cur[1] + dy
                nxt = (nx, ny)
                if (0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1] and
                        walkable(nxt) and nxt not in visited):
                    visited.add(nxt)
                    q.append((nxt, path + [act_map[name]]))
        return None

    actions = []

    # ------------------------------------------------------------------
    # 1.  Gather all primitive ingredients required for an arrow
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index["arrow"]
    primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    for prim_idx, need_cnt in primitive_needs.items():
