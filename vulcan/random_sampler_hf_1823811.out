    actions: list[int] = []
    cur_pos = tuple(state.pos)          # current (x, y) coordinates

    # Helper: produce a Manhattan‑distance move sequence from start to target.
    def _moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # Keep track of which cells have already been harvested for each kind.
    harvested: dict[int, set[tuple[int, int]]] = {}

    # Helper: find the nearest unharvested cell of a given kind.
    def _nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        return candidates[int(np.argmin(dists))]

    # -------------------------------------------------------------------------
    # 1) Collect all required primitive resources.
    # -------------------------------------------------------------------------
    for kind, cnt in required.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = _nearest_cell(kind, cur_pos)
            if target is None:
                # No more cells of this kind; abort collection for safety.
                continue
            move_seq, cur_pos = _moves_to(cur_pos, target)
            actions.extend(move_seq)          # travel to the resource
            actions.append(4)                 # USE → pick it up
            harvested[kind].add(target)

    # -------------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the final item.
    # -------------------------------------------------------------------------
    if workshop_kind is not None:
        target = _nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = _moves_to(cur_pos, target)
            actions.extend(move_seq)

    # Final USE triggers the crafting at the current location.
    actions.append(4)

    return actions

