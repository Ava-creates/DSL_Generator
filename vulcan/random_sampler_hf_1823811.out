    # reset environment and get current state/world info
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    idx = world.cookbook.index

    # goal definition (arrow)
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitive requirements for one arrow (flattened)
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # workshop required for final craft (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) coordinates where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal):
        """Return shortest path (list of positions) from start to goal using 4‑way moves."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # cells occupied by non‑grabbable entities are blocked
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # no path found – stay at start
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur to adjacent nxt into a CraftWorld action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("non‑adjacent move requested")

    # ------------------------------------------------------------------
    # build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) collect all required primitives
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            locations = find_locations(prim_idx)
            if not locations:
                # cannot find more of this primitive – abort collection for this type
                break
            # choose nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # pick up the primitive
            actions.append(4)   # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0  # remove from map

    # 2) go to workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
        actions.append(4)   # USE to craft at workshop
    else:
        actions.append(4)   # USE to craft in place (no workshop needed)

    return actions


