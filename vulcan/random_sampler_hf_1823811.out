    # Reset the environment and obtain the current state and world configuration
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    idx = world.cookbook.index           # name ↔ integer id

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for a single arrow (expanded to base primitives)
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    def find_locations(kind, grid):
        """Return a list of (x, y) positions where the grid contains the given kind."""
        occ = np.where(grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Translate a step between adjacent cells into a movement action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Requested move is not to an adjacent cell")

    def bfs(start, goal, grid):
        """Return the shortest path (list of positions) from start to goal,
        avoiding cells occupied by non‑grabbable entities."""
        if start == goal:
            return [start]
        W, H = grid.shape[:2]

        # Build a set of blocked positions (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        queue = collections.deque([start])
        prev = {start: None}
        while queue:
            cur = queue.popleft()
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        queue.append(nxt)
        # No path found – stay in place
        return [start]

    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    mutable_grid = state.grid.copy()   # Simulate pickups without altering the real grid

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    for prim_idx, needed in primitive_counts.items():
        while needed > 0:
            locations = find_locations(prim_idx, mutable_grid)
            if not locations:
                # Primitive not present on the map; assume it is already in inventory
                break
            # Choose the first available location (could be improved to nearest)
            target = locations[0]
            path = bfs(cur_pos, target, mutable_grid)
            for step in path[1:]:               # Skip the current position
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # Pick up the primitive
            actions.append(4)                    # USE action
            # Remove the primitive from the mutable copy of the grid
            mutable_grid[target[0], target[1], prim_idx] = 0
            needed -= 1

    # --------------------------------------------------------------
    # If the recipe requires a specific workshop, move there and craft the arrow
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind, mutable_grid)
        if wk_locations:
            target = wk_locations[0]
            path = bfs(cur_pos, target, mutable_grid)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)                    # USE at the workshop to craft

    return actions


