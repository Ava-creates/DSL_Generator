    # Reset the environment and grab the current state and world objects
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Define the goal item
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Determine which primitive resources are needed to craft the goal
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Find out if the recipe requires a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    def find_locations(kind):
        """Return a list of (x, y) positions where the grid contains the given kind."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Convert a step between adjacent cells into a directional action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise ValueError("Requested move is not to an adjacent cell")

    def bfs(start, goal):
        """Return the shortest path (list of positions) from start to goal avoiding blocked cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Determine blocked cells (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # If no path found, just stay in place
        return [start]

    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # --------------------------------------------------------------
    # Collect each required primitive (nearest first)
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            locations = find_locations(prim_idx)
            if not locations:
                # Primitive might already be in inventory; skip
                continue

            # Find the reachable location with the shortest path
            best_path = None
            for loc in locations:
                path = bfs(cur_pos, loc)
                if len(path) == 1:   # unreachable
                    continue
                if best_path is None or len(path) < len(best_path):
                    best_path = path
                    if len(best_path) == 2:   # cannot be shorter than one step
                        break

            if best_path is None:
                # No reachable primitive; give up on this one
                continue

            # Follow the path to the primitive
            for step in best_path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)   # USE

    # --------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            best_path = None
            for loc in wk_locations:
                path = bfs(cur_pos, loc)
                if len(path) == 1:
                    continue
                if best_path is None or len(path) < len(best_path):
                    best_path = path
                    if len(best_path) == 2:
                        break
            if best_path is not None:
                for step in best_path[1:]:
                    actions.append(move_action(cur_pos, step))
                    cur_pos = step
        # Use the workshop to craft
        actions.append(4)   # USE
    else:
        # No specific workshop required; craft in place
        actions.append(4)   # USE

    return actions

