    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _manhattan_actions(src, dst):
        """Return a list of actions that move from src to dst using Manhattan moves."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _blocked_cells(grid):
        """Boolean mask of cells that are occupied (any kind > 0)."""
        return np.any(grid > 0, axis=2)

    def _nearest_entity(pos, kind_idx, grid):
        """Find the nearest cell containing the given kind."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        best = np.argmin(dists)
        return tuple(locations[best])

    def _adjacent_empty(target, cur_pos, blocked):
        """Choose an empty cell adjacent (or equal) to target that is closest to cur_pos."""
        tx, ty = target
        candidates = []
        # include the target itself in case it is already empty
        if not blocked[tx, ty]:
            candidates.append((tx, ty))
        # four orthogonal neighbours
        for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
            nx, ny = tx + dx, ty + dy
            if 0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]:
                if not blocked[nx, ny]:
                    candidates.append((nx, ny))
        if not candidates:
            return None
        # pick the candidate with smallest Manhattan distance to cur_pos
        return min(candidates, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    grid = env._current_state.grid
    blocked = _blocked_cells(grid)

    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_entity(cur_pos, prim_idx, grid)
            if target is None:
                # primitive not found; abort planning
                return actions
            # find a walkable cell adjacent to the primitive
            walk_target = _adjacent_empty(target, cur_pos, blocked)
            if walk_target is None:
                # no accessible neighbour; abort
                return actions
            actions += _manhattan_actions(cur_pos, walk_target)
            cur_pos = walk_target
            actions.append(USE)  # pick up the primitive
            # simulate removal of the primitive for subsequent planning
            grid[target[0], target[1], prim_idx] = 0
            blocked = _blocked_cells(grid)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        target = _nearest_entity(cur_pos, workshop_idx, grid)
        if target is not None:
            walk_target = _adjacent_empty(target, cur_pos, blocked)
            if walk_target is not None:
                actions += _manhattan_actions(cur_pos, walk_target)
                cur_pos = walk_target
                actions.append(USE)  # craft at the workshop

    return actions


    # actions to make an arrow in the given CraftLab environment
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _manhattan_path(src, dst):
        """Return a list of actions that move from src to dst using Manhattan moves."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_entity(pos, kind_idx):
        """Find the nearest cell (including the current one) that contains the given kind."""
        grid = env._current_state.grid
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])
        best = np.argmin(dists)
        return tuple(locs[best])

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    # mapping from primitive kind index -> required count for ONE arrow
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_entity(cur_pos, prim_idx)
            if target is None:
                # primitive not present – abort early
                return actions
            actions += _manhattan_path(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_entity(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _manhattan_path(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

