        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # --------------------------------------------------------------
    # Simulated mutable copies
    # --------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # blocked cells mask
    plan = []                                   # final action list

    # --------------------------------------------------------------
    # Collect all required primitives / components
    # --------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # Missing required item – abort planning
                return plan
            # Choose nearest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, kind_idx):
