    env.reset()
    state = env._current_state

    # ------------------------------------------------------------
    # Identify the goal index for the "arrow" item.
    # ------------------------------------------------------------
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Goal item 'arrow' not found in cookbook")

    # ------------------------------------------------------------
    # Action constants.
    # ------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    from collections import deque

    # ------------------------------------------------------------
    # Helper: BFS to compute a sequence of actions from start to target.
    # ------------------------------------------------------------
    def bfs_path(start, target):
        """Return a list of actions to move from start to target (both (y,x))."""
        h, w, _ = state.grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # Allow stepping onto the target even if occupied.
                    if not state.grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    # ------------------------------------------------------------
    # Helper: Move the agent to an absolute position using bfs_path.
    # ------------------------------------------------------------
    def move_to(pos):
        nonlocal state
        while state.pos != pos:
            path = bfs_path(state.pos, pos)
            if not path:
                break  # cannot reach target
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == pos:
                    break

    # ------------------------------------------------------------
    # Helper: Find the nearest cell containing a given kind index.
    # ------------------------------------------------------------
    def nearest_of_kind(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------
    # Helper: Return a free cell (including the cell itself) adjacent
    # to the given location. Returns None if no free cell found.
    # ------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the cell itself if it's free.
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        return None

    # ------------------------------------------------------------
    # 1) Collect all primitive resources required for the arrow.
    # ------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in needed.items():
        for _ in range(count):
            src = nearest_of_kind(kind_idx)
            if src is None:
                continue  # resource not present
            adj = adjacent_free(src)
            if adj is None:
                continue  # no free adjacent cell
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------
    # 2) If the recipe requires a workshop, go there and craft.
    # ------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = nearest_of_kind(ws_idx)
        if ws_pos:
            adj_ws = adjacent_free(ws_pos)
            if adj_ws:
                move_to(adj_ws)
                actions.append(ACT_USE)
                env.step(ACT_USE)
                state = env._current_state

    # Return the computed action sequence.
    return actions

