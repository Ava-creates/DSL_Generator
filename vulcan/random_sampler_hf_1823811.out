    # Action constants (as used by CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _manhattan(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    def _move_actions(src, dst):
        """Return a list of movement actions that walk from src to dst
        using only vertical then horizontal moves."""
        actions = []
        x, y = src
        tx, ty = dst
        if tx > x:
            actions += [DOWN] * (tx - x)
        elif tx < x:
            actions += [UP] * (x - tx)
        if ty > y:
            actions += [RIGHT] * (ty - y)
        elif ty < y:
            actions += [LEFT] * (y - ty)
        return actions

    def _positions_of(kind_idx):
        """All coordinates (row, col) where the given kind is present."""
        grid = env._current_state.grid
        rows, cols = np.where(grid[:, :, kind_idx] > 0)
        return list(zip(rows.tolist(), cols.tolist()))

    def _nearest(pos, kind_idx):
        """Find the nearest cell containing kind_idx; return None if absent."""
        candidates = _positions_of(kind_idx)
        if not candidates:
            return None
        dists = [_manhattan(pos, c) for c in candidates]
        return candidates[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    world = env.world
    try:
        arrow_idx = world.cookbook.index.index('arrow')
    except Exception:  # arrow not defined – nothing to do
        return []

    # Primitive requirements for a single arrow (may be empty if arrow is primitive)
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    actions = []
    cur_pos = env._current_state.pos

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, qty in primitives_needed.items():
        for _ in range(qty):
            target = _nearest(cur_pos, prim_idx)
            if target is None:
                # Required primitive not on the map – abort early
                return actions
            # Move to the primitive's cell (or its neighbour if the cell is blocked)
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            # Pick it up
            actions.append(USE)

    # ------------------------------------------------------------------
    # 2. Go to the workshop (if the recipe specifies one) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        try:
            workshop_idx = world.cookbook.index.index(workshop_name)
            workshop_pos = _nearest(cur_pos, workshop_idx)
            if workshop_pos is not None:
                actions += _move_actions(cur_pos, workshop_pos)
                cur_pos = workshop_pos
                actions.append(USE)   # craft at the workshop
        except Exception:
            # workshop name not found in index – ignore
            pass

    return actions


    # Action indices (environment uses the same ordering as CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _manhattan_path(src, dst):
        """Return a list of actions that move from src to dst using Manhattan moves."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_entity(pos, kind_idx):
        """Find the nearest cell that contains the given kind (including the cell itself)."""
        grid = env._current_state.grid
        # locations where the kind is present (any positive count)
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        # compute Manhattan distances
        dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])
        best = np.argmin(dists)
        return tuple(locs[best])

    # ------------------------------------------------------------------
    # Identify goal and recipe
    # ------------------------------------------------------------------
    world = env.world
    idx_arrow = world.cookbook.index.index('arrow')
    # Mapping primitive index -> required count for ONE arrow
    primitives_needed = world.cookbook.primitives_for(idx_arrow)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_entity(cur_pos, prim_idx)
            if target is None:
                # Primitive not found in the world; abort early
                return actions
            actions += _manhattan_path(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # Move to workshop (if recipe specifies one) and craft
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(idx_arrow, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_entity(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _manhattan_path(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

