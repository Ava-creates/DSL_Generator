    import numpy as np
    from collections import deque

    # reset environment and pull useful objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    idx = cookbook.index                # name ↔ integer id mapping

    # resolve action indices dynamically
    act_map = env.action_specs()
    DOWN = act_map["DOWN"]
    UP = act_map["UP"]
    LEFT = act_map["LEFT"]
    RIGHT = act_map["RIGHT"]
    USE = act_map["USE"]
    move_defs = [(DOWN, (1, 0)),
                 (UP, (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT, (0, 1))]

    # ------------------------------------------------------------------
    # Helper: BFS path finder returning a list of movement actions.
    # ------------------------------------------------------------------
    def _bfs_path(start, target):
        """Return movement actions from start to target, treating any
        occupied cell as blocked (except the target cell itself)."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in move_defs:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # allow stepping onto the target even if it is occupied
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []          # no path found
        # reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []                     # arrow not defined in this world
    goal_idx = idx[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                     # final action list

    # ------------------------------------------------------------------
    # Phase 1: Collect each required primitive the required number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # locate all cells currently holding this primitive
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # primitive missing – abort early
                return actions
            # pick nearest primitive (Manhattan distance)
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            tr, tc = prim_cells[dists.argmin()]

            # move to the primitive
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # pick it up
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # Phase 2: Go to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                # no workshop info, cannot craft
    workshop_idx = idx[workshop_name]

    # locate workshop cells
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                # workshop not present
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]

    # move to workshop
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # craft the arrow
    actions.append(USE)

    return actions

