            move_seq, cur_pos = path_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)          # USE to pick up the primitive
            harvested[kind].add(target)

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if the recipe specifies one)
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_cells = np.argwhere(scenario.init_grid[:, :, workshop_kind] > 0)
        if wk_cells.size:
            wk_cells = [tuple(c) for c in wk_cells]
            dists = [abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]) for c in wk_cells]
            target = wk_cells[int(np.argmin(dists))]
            move_seq, cur_pos = path_to(cur_pos, target)
            actions.extend(move_seq)

    # ------------------------------------------------------------------
    # Final USE to craft the goal item
    # ------------------------------------------------------------------
    actions.append(4)

    return actions

