    # Get the index for the target item “arrow”.
    arrow_idx = env.world.cookbook.index["arrow"]
    # Retrieve its recipe and the required workshop.
    recipe = env.world.cookbook.recipes[arrow_idx]
    workshop_name = recipe["_at"]
    workshop_idx = env.world.cookbook.index[workshop_name]

    # Start a fresh episode.
    env.reset()
    state = env._current_state          # CraftState instance.
    actions = []                         # Collected action sequence.
    max_steps = 5000
    steps = 0

    # ---------- Helper utilities ----------
    def in_bounds(pos):
        x, y = pos
        w, h = state.grid.shape[:2]
        return 0 <= x < w and 0 <= y < h

    def is_free(pos):
        x, y = pos
        return state.grid[x, y].sum() == 0

    def manhattan_path(start, goal):
        sx, sy = start
        gx, gy = goal
        path = []
        while sx < gx:
            path.append(0)          # DOWN
            sx += 1
        while sx > gx:
            path.append(1)          # UP
            sx -= 1
        while sy < gy:
            path.append(3)          # RIGHT
            sy += 1
        while sy > gy:
            path.append(2)          # LEFT
            sy -= 1
        return path

    def nearest_pos(kind):
        """Find the closest cell that contains an entity of the given kind."""
        positions = np.argwhere(state.grid[:, :, kind] > 0)
        if positions.size == 0:
            return None
        dists = np.sum(np.abs(positions - np.array(state.pos)), axis=1)
        return tuple(positions[dists.argmin()])

    def adjacent_free(target):
        """Pick a free cell next to *target* (Manhattan distance = 1)."""
        tx, ty = target
        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
            ax, ay = tx + dx, ty + dy
            if in_bounds((ax, ay)) and is_free((ax, ay)):
                return (ax, ay)
        return None

    def direction_to(src, dst):
        """Return the action index that points from src to dst (must be adjacent)."""
        sx, sy = src
        dx, dy = dst[0] - sx, dst[1] - sy
        if dx == 1:
            return 0          # DOWN
        if dx == -1:
            return 1          # UP
        if dy == -1:
            return 2          # LEFT
        if dy == 1:
            return 3          # RIGHT
        return None

    def execute_path(path):
        """Run a list of actions, updating *state* and *steps*."""
        nonlocal state, steps
        for a in path:
            reward, done, _ = env.step(a)
            actions.append(a)
            steps += 1
            state = env._current_state
            if steps >= max_steps:
                return False
        return True
    # ---------------------------------------

    # Main loop: keep acting until we possess an arrow or run out of steps.
    while state.inventory[arrow_idx] == 0 and steps < max_steps:
        # Determine which primitive kinds are still missing.
        missing = {}
        for kind, cnt in recipe.items():
            if isinstance(kind, int):
                have = int(state.inventory[kind])
                need = cnt - have
                if need > 0:
                    missing[kind] = need

        # -----------------------------------------------------------------
        # If no primitives are missing, go to the workshop and craft.
        if not missing:
            w_pos = nearest_pos(workshop_idx)
            if w_pos is None:
                break
            a_pos = adjacent_free(w_pos)
            if a_pos is None:
                break
            if not execute_path(manhattan_path(state.pos, a_pos)):
                break

            # Face the workshop.
            needed_dir = direction_to(state.pos, w_pos)
            if needed_dir is not None and state.dir != needed_dir:
                # Simple turn: step one cell away and back.
                opp = (needed_dir + 2) % 4
                vec = {0: (1, 0), 1: (-1, 0), 2: (0, -1), 3: (0, 1)}[opp]
                tmp = (state.pos[0] + vec[0], state.pos[1] + vec[1])
                if in_bounds(tmp) and is_free(tmp):
                    execute_path([opp, needed_dir])

            # Craft using the workshop.
            reward, done, _ = env.step(4)      # USE
            actions.append(4)
            steps += 1
            state = env._current_state
            continue
        # -----------------------------------------------------------------

        # Pick a primitive to collect (first missing kind).
        kind, need_cnt = next(iter(missing.items()))
        prim_pos = nearest_pos(kind)
        if prim_pos is None:
            break
        adj = adjacent_free(prim_pos)
        if adj is None:
            break
        if not execute_path(manhattan_path(state.pos, adj)):
            break

        # Face the primitive.
        needed_dir = direction_to(state.pos, prim_pos)
        if needed_dir is not None and state.dir != needed_dir:
            opp = (needed_dir + 2) % 4
            vec = {0: (1, 0), 1: (-1, 0), 2: (0, -1), 3: (0, 1)}[opp]
            tmp = (state.pos[0] + vec[0], state.pos[1] + vec[1])
            if in_bounds(tmp) and is_free(tmp):
                execute_path([opp, needed_dir])

        # Pick up the primitive.
        reward, done, _ = env.step(4)          # USE
        actions.append(4)
        steps += 1
        state = env._current_state

    return actions


