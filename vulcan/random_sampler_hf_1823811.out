    # Reset environment and fetch useful handles
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index and primitive requirements (including transitive ones)
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Determine workshop (if any) where final crafting must happen
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    ACTIONS = {"DOWN": 0, "UP": 1, "LEFT": 2, "RIGHT": 3, "USE": 4}
    DIRS = [(0, 1, ACTIONS["DOWN"]),
            (0, -1, ACTIONS["UP"]),
            (-1, 0, ACTIONS["LEFT"]),
            (1, 0, ACTIONS["RIGHT"])]

    def bfs_path(start, target, allow_target_kind=None):
        """Bread‑first search returning a list of positions from start to target.
        Cells occupied by any non‑grabbable entity are treated as blocked,
        except the target cell if `allow_target_kind` is present there."""
        W, H = scenario.init_grid.shape[:2]
        q = collections.deque([start])
        visited = {start: None}
        while q:
            x, y = q.popleft()
            if (x, y) == target:
                # reconstruct path
                path = []
                cur = target
                while cur is not None:
                    path.append(cur)
                    cur = visited[cur]
                return list(reversed(path))
            for dx, dy, _ in DIRS:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < W and 0 <= ny < H):
                    continue
                if (nx, ny) in visited:
                    continue
                # check blockage by non‑grabbable entities
                blocked = False
                for idx in world.non_grabbable_indices:
                    if scenario.init_grid[nx, ny, idx] > 0:
                        blocked = True
                        break
                if blocked:
                    # allow stepping onto the target if it holds the allowed kind
                    if (nx, ny) == target and allow_target_kind is not None:
                        if scenario.init_grid[nx, ny, allow_target_kind] > 0:
                            blocked = False
                if not blocked:
                    visited[(nx, ny)] = (x, y)
                    q.append((nx, ny))
        return None  # no path found

    def positions_to_actions(path):
        """Translate a list of positions (including start) into action ids."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(ACTIONS["RIGHT"])
            elif x1 == x0 - 1:
                acts.append(ACTIONS["LEFT"])
            elif y1 == y0 + 1:
                acts.append(ACTIONS["DOWN"])
            elif y1 == y0 - 1:
                acts.append(ACTIONS["UP"])
        return acts

    def nearest_cell(kind, from_pos, grid):
        """Find the nearest cell (Manhattan) that still contains `kind`."""
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # ------------------------------------------------------------------
    # Planning: collect required primitives then craft at workshop
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)

    # Work on a mutable copy of the initial grid to mark primitives as taken
    grid_copy = scenario.init_grid.copy()

    for kind, count in required.items():
        for _ in range(count):
            target = nearest_cell(kind, cur_pos, grid_copy)
            if target is None:
                # Primitive not available; skip (environment may be unsolvable)
                continue
            path = bfs_path(cur_pos, target, allow_target_kind=kind)
            if path is None:
                # Can't reach this primitive; skip
                continue
            actions.extend(positions_to_actions(path))
            actions.append(ACTIONS["USE"])  # pick up primitive
            cur_pos = target
            # Mark primitive as collected
            grid_copy[target[0], target[1], kind] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the final item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)
        if target is not None:
            path = bfs_path(cur_pos, target, allow_target_kind=workshop_kind)
            if path is not None:
                actions.extend(positions_to_actions(path))
                actions.append(ACTIONS["USE"])  # craft at workshop
    else:
        # No specific workshop – a USE at the current location attempts crafting
        actions.append(ACTIONS["USE"])

    return actions


