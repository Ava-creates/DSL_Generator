    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    idx = cookbook.index

    act_map = env.action_specs()
    DOWN = act_map["DOWN"]
    UP = act_map["UP"]
    LEFT = act_map["LEFT"]
    RIGHT = act_map["RIGHT"]
    USE = act_map["USE"]
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    from collections import deque

    h, w = state.grid.shape[:2]

    def bfs_path(start, target):
        """Shortest path from start to target avoiding occupied cells (except target)."""
        if start == target:
            return []
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                occupied = state.grid[nr, nc, :].any()
                if occupied and nxt != target:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # no path found
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def find_nearest(kind_idx, start):
        """BFS to the closest cell containing kind_idx."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                occupied = state.grid[nr, nc, :].any()
                # can step onto the target cell even if occupied
                if occupied and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # reconstruct path
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return None, None

    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []
    goal_idx = idx[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    plan = []
    cur_pos = tuple(state.pos)

    # 1. Collect required primitives
    for prim_idx, count in primitive_needs.items():
        for _ in range(count):
            path, cell = find_nearest(prim_idx, cur_pos)
            if cell is None:
                return plan  # cannot find required primitive
            plan.extend(path)
            cur_pos = cell
            plan.append(USE)  # pick up
            r, c = cell
            state.inventory[prim_idx] += 1
            state.grid[r, c, prim_idx] = 0

    # 2. Move to the workshop and craft the arrow
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return plan
    workshop_idx = idx[workshop_name]
    path, cell = find_nearest(workshop_idx, cur_pos)
    if cell is None:
        return plan
    plan.extend(path)
    cur_pos = cell
    plan.append(USE)  # craft

    return plan

