    def manhattan_path(src, dst):
        """Return a list of movement actions to go from src to dst using Manhattan moves."""
        actions = []
        sr, sc = src
        dr, dc = dst
        drow = dr - sr
        dcol = dc - sc
        if drow > 0:
            actions += [DOWN] * drow
        elif drow < 0:
            actions += [UP] * (-drow)
        if dcol > 0:
            actions += [RIGHT] * dcol
        elif dcol < 0:
            actions += [LEFT] * (-dcol)
