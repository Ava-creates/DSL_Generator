    # Helper: locate all positions of a given kind on the grid
    def locate(kind):
        grid = state.grid
        inds = np.argwhere(grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    # Helper: move from current position to a target cell using Manhattan steps
    # Action mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE
    def go_to(target):
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right (increase x)
                act = 3
                new_pos = (x + 1, y)
            elif x > tx:        # need to move left
                act = 2
                new_pos = (x - 1, y)
            elif y < ty:        # need to move down (increase y)
                act = 0
                new_pos = (x, y + 1)
            else:               # need to move up
                act = 1
                new_pos = (x, y - 1)

            actions.append(act)
            _, state = state.step(act)   # apply action and update state

