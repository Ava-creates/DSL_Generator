    from collections import deque
    import numpy as np

    def bfs_path(start, target):
        """Shortest list of move actions from start to target, avoiding occupied cells."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Block any non‑empty cell unless it is the destination.
                if nxt != target and state.grid[nr, nc].any():
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # No path found.
        # Reconstruct the action sequence.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def find_nearest(kind_idx, start):
        """Locate the nearest cell containing `kind_idx` and return (action_path, cell)."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # If the cell holds the target kind, we can step onto it.
                if state.grid[nr, nc, kind_idx] > 0:
                    parent[nxt] = (cur, act)
                    # Build path to this cell.
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                # Otherwise the cell must be empty to traverse.
                if state.grid[nr, nc].any():
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        return [], None

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            path, cell = find_nearest(prim_idx, state.pos)
            if cell is None:
                return actions  # Primitive not reachable.
            actions.extend(path)
            state.pos = cell
            actions.append(USE)  # Pick up the primitive.
            # Update the simulated state.
            state.inventory[prim_idx] += 1
            tr, tc = cell
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
