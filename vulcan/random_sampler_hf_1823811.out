    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    idx = world.cookbook.index           # name ↔ integer id

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for a single arrow (expanded to base primitives)
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    def find_positions(kind, grid):
        """Return a list of (x, y) positions where the grid contains the given kind."""
        occ = np.where(grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Translate a step between adjacent cells into a movement action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Requested move is not to an adjacent cell")

    def bfs_to_any(start, targets, grid):
        """Shortest path from start to any cell in *targets* avoiding non‑grabbable blocks."""
        if start in targets:
            return [start]
        W, H = grid.shape[:2]

        # blocked positions (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        queue = collections.deque([start])
        prev = {start: None}
        target_set = set(targets)

        while queue:
            cur = queue.popleft()
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt in target_set:
                            # reconstruct path
                            path = [nxt]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        queue.append(nxt)
        # fallback – stay in place
        return [start]

    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    mutable_grid = state.grid.copy()   # simulate pickups without altering the real grid

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    for prim_idx, needed in primitive_counts.items():
        while needed > 0:
            locations = find_positions(prim_idx, mutable_grid)
            if not locations:
                # primitive missing – assume already in inventory
                break
            path = bfs_to_any(cur_pos, locations, mutable_grid)
            for step in path[1:]:               # follow the path, skipping current cell
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)                    # USE to pick up
            mutable_grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            needed -= 1

    # --------------------------------------------------------------
    # Move to a workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locations = find_positions(workshop_kind, mutable_grid)
        if wk_locations:
            path = bfs_to_any(cur_pos, wk_locations, mutable_grid)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)                    # USE at the workshop to craft

    return actions


    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    idx = world.cookbook.index           # name ↔ integer id

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for a single arrow (expanded to base primitives)
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    def find_locations(kind, grid):
        """Return a list of (x, y) positions where the grid contains the given kind."""
        occ = np.where(grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Translate a step between adjacent cells into a movement action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Requested move is not to an adjacent cell")

    def bfs(start, goal, grid):
        """Return the shortest path (list of positions) from start to goal,
        avoiding cells occupied by non‑grabbable entities. Returns None if no path."""
        if start == goal:
            return [start]
        W, H = grid.shape[:2]

        # Compute blocked cells (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        queue = collections.deque([start])
        prev = {start: None}
        while queue:
            cur = queue.popleft()
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        queue.append(nxt)
        return None  # no path found

    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    mutable_grid = state.grid.copy()   # Simulate pickups without altering the real grid

    # --------------------------------------------------------------
    # Collect each required primitive the necessary number of times
    for prim_idx, needed in primitive_counts.items():
        while needed > 0:
            locations = find_locations(prim_idx, mutable_grid)
            if not locations:
                # Primitive not present on the map; assume it is already in inventory
                break

            # Choose the nearest location (by BFS distance)
            best_path = None
            best_target = None
            best_len = None
            for loc in locations:
                path = bfs(cur_pos, loc, mutable_grid)
                if path is None:
                    continue
                length = len(path)
                if best_len is None or length < best_len:
                    best_len = length
                    best_path = path
                    best_target = loc

            if best_path is None:
                # No reachable primitive left
                break

            # Follow the path
            for step in best_path[1:]:               # skip current position
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)                         # USE action
            mutable_grid[best_target[0], best_target[1], prim_idx] = 0
            needed -= 1

    # --------------------------------------------------------------
    # If the recipe requires a specific workshop, move there and craft the arrow
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind, mutable_grid)
        if wk_locations:
            # Move to the nearest workshop
            best_path = None
            best_len = None
            for loc in wk_locations:
                path = bfs(cur_pos, loc, mutable_grid)
                if path is None:
                    continue
                length = len(path)
                if best_len is None or length < best_len:
                    best_len = length
                    best_path = path
            if best_path:
                for step in best_path[1:]:
                    actions.append(move_action(cur_pos, step))
                    cur_pos = step
                actions.append(4)                     # USE at the workshop to craft

    return actions

