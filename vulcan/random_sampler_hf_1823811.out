    import numpy as np

    # Action constants (match CraftWorld definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Manhattan‑style actions from src (x,y) to dst (x,y)."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_kind(pos, kind_idx):
        """Return coordinates of the nearest cell containing `kind_idx` (>0)."""
        grid = env._current_state.grid
        # all positions where the kind is present
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        # Manhattan distances to current position
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = locations[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # 1. Determine the goal (arrow) and its primitive requirements
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # 2. Collect required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # Primitive missing – stop planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos

    # Final USE triggers crafting (at workshop if required, otherwise anywhere)
    actions.append(USE)

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def _move(src, dst):
        """Generate a Manhattan‑style action list from src to dst."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest(pos, kind_idx):
        """Return the coordinates of the nearest cell containing kind_idx."""
        grid = env._current_state.grid
        # Find all locations where this kind is present (count > 0)
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        # Manhattan distances to current position
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # 1. Determine primitives needed to craft an arrow
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # 2. Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest(cur_pos, prim_idx)
            if target is None:
                # Required primitive not found in the current world; abort planning.
                return actions
            actions.extend(_move(cur_pos, target))
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions.extend(_move(cur_pos, workshop_pos))
            cur_pos = workshop_pos

    # Final USE triggers crafting (at workshop if required, otherwise anywhere)
    actions.append(USE)
    return actions

