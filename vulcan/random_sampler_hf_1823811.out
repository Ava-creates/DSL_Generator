    # Reset environment and fetch core objects
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index for the item we need to craft (arrow)
    goal_idx = env.task.goal

    # Primitive resources required (including transitive ones)
    required = world.cookbook.primitives_for(goal_idx)

    # Identify workshop kind (if any) where final crafting must occur
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan move sequence (using action indices)
    #   DOWN=0, UP=1, LEFT=2, RIGHT=3
    # ------------------------------------------------------------------
    def moves_to(start: tuple[int, int], target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:
        x, y = start
        tx, ty = target
        seq: list[int] = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing at least one of `kind`,
    #         ignoring cells already used for that kind.
    # ------------------------------------------------------------------
    used_cells: dict[int, set[tuple[int, int]]] = {}

    def nearest_cell(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = used_cells.get(kind, set())
        # Filter out cells already harvested
        filtered = [tuple(c) for c in cells if tuple(c) not in used]
        if not filtered:
            return None
        # Compute Manhattan distances
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in filtered]
        idx = int(np.argmin(dists))
        return filtered[idx]

    # ------------------------------------------------------------------
    # Collect all required primitive items
    # ------------------------------------------------------------------
    for kind, count in required.items():
        used_cells.setdefault(kind, set())
        for _ in range(count):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # Primitive not found; skip this instance
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up the primitive
            used_cells[kind].add(target)    # mark cell as consumed

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the final item.
    # If no specific workshop, just USE at current location.
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
    # Final USE to trigger crafting
    actions.append(4)

    return actions


