    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    index = cookbook.index

    # Action identifiers (match CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # arrow not defined in this world
    goal_idx = index[goal_name]         # integer id of the arrow item
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                         # will accumulate the action sequence

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of move actions from start to target.
    # The target cell may be occupied (e.g., a workshop or a primitive), but
    # all other cells must be empty.
    # ------------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        """Return a list of move actions (DOWN/UP/LEFT/RIGHT) to reach target."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        queue = deque([start])
        visited = {start}
        parent = {}
        moves = [(DOWN, (1, 0)),
                 (UP, (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT, (0, 1))]
        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Disallow stepping on any occupied cell except the target.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        if target not in parent and start != target:
            return []          # no path found
        # Reconstruct path backwards.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate any cell that currently holds this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present – abort early.
                return actions
            tr, tc = prim_cells[0]

            # Move to the primitive's cell (BFS respects obstacles).
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update our internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # workshop info missing

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # no workshop on the map

    wr, wc = workshop_cells[0]

    # Move to the workshop cell.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions


    # Reset environment and grab useful references.
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # name ↔ integer id mapping

    # Action identifiers (match CraftLab.action_specs).
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and the primitives required to craft it.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # no arrow defined in this world
    goal_idx = index[goal_name]         # integer id of the arrow item
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                         # will accumulate the action sequence

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    from collections import deque

    # (action, (dr, dc))
    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    def _bfs_path(start, target):
        """Return a list of move actions (DOWN/UP/LEFT/RIGHT) from start → target.
        The target cell may be occupied; all other cells must be empty."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        queue = deque([start])
        visited = {start}
        parent = {}
        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Disallow stepping on occupied cells unless it's the target.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        if target not in parent and start != target:
            return []  # no path found

        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def _nearest_cell(cells, start):
        """Pick the cell with the smallest Manhattan distance to *start*."""
        best = None
        best_dist = None
        for r, c in cells:
            d = abs(r - start[0]) + abs(c - start[1])
            if best is None or d < best_dist:
                best = (r, c)
                best_dist = d
        return best

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find any remaining cell that holds this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive missing – abort early.
                return actions
            target = _nearest_cell(prim_cells, state.pos)

            # Move to the primitive.
            move_seq = _bfs_path(state.pos, target)
            actions.extend(move_seq)
            state.pos = target

            # Pick it up.
            actions.append(USE)

            # Update our simulated copy of the state.
            tr, tc = target
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # workshop info missing

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # no workshop on the map

    wr, wc = workshop_cells[0]            # pick the first workshop cell

    # Move to the workshop.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions

