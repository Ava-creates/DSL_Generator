    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Identify goal and required primitive items
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}

    # Map actions from the environment spec
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    # Direction vectors paired with their action ids
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    def find_path(cur_state, target_kind):
        """Bread‑first search returning a list of movement actions that brings
        the agent to a cell containing `target_kind`. The agent may step onto
        empty cells or the target cell itself; all other occupied cells are
        treated as obstacles."""
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        from collections import deque
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # allow moving onto empty cells or directly onto the target cell
                if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        # If unreachable (should not happen in a valid scenario) return empty list
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    for prim_kind, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, prim_kind)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
