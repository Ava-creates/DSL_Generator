    # Ensure the environment is in a fresh state.
    try:
        env.reset()
    except Exception:
        # If the environment does not expose a reset method, ignore the error.
        pass

    # This placeholder implementation does not attempt to solve the task.
    # It simply returns an empty action list, which is a valid return type.
    return []


    # reset the environment and get the internal state object
    env.reset()
    state = env._current_state

    # action indices
    act = env.action_specs()          # e.g. {'DOWN':0,'UP':1,'LEFT':2,'RIGHT':3,'USE':4}
    ACTION_USE = act['USE']
    ACTION_DOWN = act['DOWN']
    ACTION_UP = act['UP']
    ACTION_LEFT = act['LEFT']
    ACTION_RIGHT = act['RIGHT']

    # mapping from movement vector to action index
    vec2act = {
        (0, 1): ACTION_DOWN,   # y+1  -> DOWN
        (0, -1): ACTION_UP,    # y-1 -> UP
        (-1, 0): ACTION_LEFT,  # x-1 -> LEFT
        (1, 0): ACTION_RIGHT,  # x+1 -> RIGHT
    }

    # ------------------------------------------------------------------
    # helper utilities
    # ------------------------------------------------------------------
    def in_bounds(p):
        x, y = p
        return 0 <= x < state.grid.shape[0] and 0 <= y < state.grid.shape[1]

    def is_free(p):
        """A cell is free if it contains no entities (all kinds are zero)."""
        x, y = p
        return not state.grid[x, y, :].any()

    def bfs_to_adjacent(target):
        """Return a list of positions (including start) that leads from the
        current agent position to a free cell adjacent to *target*.
        If the agent is already adjacent, the list contains only the current
        position."""
        from collections import deque

        start = state.pos
        # generate the four cells that are adjacent to target and free
        adj_candidates = []
        tx, ty = target
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nx, ny = tx + dx, ty + dy
            if in_bounds((nx, ny)) and is_free((nx, ny)):
                adj_candidates.append((nx, ny))

        # already adjacent?
        if start in adj_candidates:
            return [start]

        # BFS over free cells
        q = deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            if cur in adj_candidates:
                # reconstruct path
                path = []
                while cur is not None:
                    path.append(cur)
                    cur = prev[cur]
                path.reverse()
                return path
            cx, cy = cur
            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nx, ny = cx + dx, cy + dy
                nxt = (nx, ny)
                if in_bounds(nxt) and nxt not in prev and is_free(nxt):
                    prev[nxt] = cur
                    q.append(nxt)
        raise RuntimeError("No reachable adjacent cell found")

    def positions_to_actions(path):
        """Convert a list of positions (consecutive) into a list of movement
        actions. The first element of *path* is the current position and is
        ignored."""
        actions = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            vec = (x1 - x0, y1 - y0)
            actions.append(vec2act[vec])
        return actions

    def face_and_use(target):
        """Assuming the agent is on a free cell adjacent to *target*,
        emit the action that makes the agent face the target (by attempting
        to move into the target cell – this does not change position because
        the cell is occupied) and then a USE action."""
        ax, ay = state.pos
        tx, ty = target
        dx, dy = tx - ax, ty - ay
        # should be one of the four cardinal directions
        face_act = vec2act[(dx, dy)]
        return [face_act, ACTION_USE]

    # ------------------------------------------------------------------
    # planning loop
    # ------------------------------------------------------------------
    goal_idx = env.task.goal                     # integer index of the arrow
    cookbook = env.world.cookbook

    # recipe for the goal (contains ingredients and the workshop key)
    recipe = cookbook.recipes[goal_idx]
    workshop_idx = recipe.get('_at') or recipe.get('_key')

    # primitive requirements (dict {prim_idx: count})
    primitive_reqs = cookbook.primitives_for(goal_idx)

    plan_actions = []

    # helper to execute a batch of actions and keep *state* up‑to‑date
    def exec_batch(batch):
        nonlocal state
        for a in batch:
            _, _, _ = env.step(a)      # reward, done, obs are ignored here
            state = env._current_state

    while state.inventory[goal_idx] == 0:
        # ------------------------------------------------------------------
        # 1. collect missing primitives
        # ------------------------------------------------------------------
        missing = {}
        for pid, need in primitive_reqs.items():
            have = int(state.inventory[pid])
            if have < need:
                missing[pid] = need - have

        if missing:
            # pick primitives one by one
            for pid, qty in missing.items():
                for _ in range(qty):
                    # locate any remaining instance of this primitive
                    locs = np.argwhere(state.grid[:, :, pid] > 0)
                    if len(locs) == 0:
                        raise RuntimeError("Required primitive not present on the map")
                    # choose the closest one (Manhattan distance)
                    dists = np.abs(locs - np.array(state.pos)).sum(axis=1)
                    target_pos = tuple(locs[dists.argmin()])

                    # move to a free cell adjacent to the primitive
                    path = bfs_to_adjacent(target_pos)
                    move_acts = positions_to_actions(path)
                    exec_batch(move_acts)

                    # now face the primitive and USE to pick it up
                    use_batch = face_and_use(target_pos)
                    exec_batch(use_batch)

                    # record the actions we have taken
                    plan_actions.extend(move_acts + use_batch)
            continue  # re‑evaluate missing primitives after collection

        # ------------------------------------------------------------------
        # 2. we have all primitives – go to the workshop and craft
        # ------------------------------------------------------------------
        # locate the workshop cell (there should be at least one)
        ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if len(ws_locs) == 0:
            raise RuntimeError("Workshop for the goal not found")
        # pick the closest workshop
        dists = np.abs(ws_locs - np.array(state.pos)).sum(axis=1)
        ws_pos = tuple(ws_locs[dists.argmin()])

        # move adjacent to the workshop
        path = bfs_to_adjacent(ws_pos)
        move_acts = positions_to_actions(path)
        exec_batch(move_acts)

        # face the workshop and USE to craft
        use_batch = face_and_use(ws_pos)
        exec_batch(use_batch)

        plan_actions.extend(move_acts + use_batch)

        # after crafting the loop will exit because inventory[goal_idx] > 0

    return plan_actions

