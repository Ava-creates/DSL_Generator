    import collections

    # reset environment to start a fresh episode
    env.reset()
    # shortcut to the current CraftState object
    state = env._current_state

    # goal index (the item we need to craft)
    goal_idx = env.task.goal

    # cookbook provides recipes and primitive requirements
    cookbook = env.world.cookbook
    # primitive counts needed to craft one instance of the goal
    needed = dict(cookbook.primitives_for(goal_idx))

    # workshop kind required for the final crafting step (may be absent)
    workshop_idx = None
    recipe = cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_idx = recipe["_at"]

    # action indices (as defined by CraftLab.action_specs())
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    move_dirs = [(0, 1, ACTION_DOWN),
                 (0, -1, ACTION_UP),
                 (-1, 0, ACTION_LEFT),
                 (1, 0, ACTION_RIGHT)]

    # ----------------------------------------------------------------------
    # Helper: Bread‑first search to the nearest cell satisfying a predicate.
    # Returns a list of movement actions (DOWN/UP/LEFT/RIGHT) that lead to a
    # cell where `cond(pos)` is True.  The search is performed on the current
    # grid (blocked cells are those with any non‑zero kind).
    # ----------------------------------------------------------------------
    def bfs_to_condition(start_pos, cond):
        H, W, _ = state.grid.shape
        q = collections.deque()
        q.append((start_pos, []))
        visited = {start_pos}
        while q:
            (x, y), path = q.popleft()
            if cond((x, y)):
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    # can step only on empty cells
                    if state.grid[nx, ny, :].sum() == 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return None

    # ----------------------------------------------------------------------
    # Helper: Execute a list of actions, updating the stored `state`
    # ----------------------------------------------------------------------
    def execute(actions):
        nonlocal state
        for a in actions:
            env.step(a)               # ignore reward/done/obs
            state = env._current_state

    # ----------------------------------------------------------------------
    # 1) Collect all required primitive resources
    # ----------------------------------------------------------------------
    while any(cnt > 0 for cnt in needed.values()):
        # pick any primitive that is still needed
        prim_kind = next(k for k, c in needed.items() if c > 0)

        # find nearest cell that contains this primitive
        start = state.pos
        def has_prim(pos):
            x, y = pos
            return state.grid[x, y, prim_kind] > 0

        path = bfs_to_condition(start, has_prim)
        if path is None:
            raise RuntimeError("Cannot locate required primitive.")
        execute(path)

        # now we are standing on the primitive – pick it up
        env.step(ACTION_USE)
        state = env._current_state
        needed[prim_kind] -= 1

    # ----------------------------------------------------------------------
    # 2) Move next to the appropriate workshop (if any) and craft
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        # condition: being in a cell whose 3×3 neighbourhood contains the workshop
        def adjacent_to_workshop(pos):
            x, y = pos
            H, W, _ = state.grid.shape
            for dx in (-1, 0, 1):
                for dy in (-1, 0, 1):
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < H and 0 <= ny < W:
                        if state.grid[nx, ny, workshop_idx] > 0:
                            return True
            return False

        start = state.pos
        path = bfs_to_condition(start, adjacent_to_workshop)
        if path is None:
            raise RuntimeError("Cannot reach required workshop.")
        execute(path)

        # use the workshop to craft the goal item
        env.step(ACTION_USE)
        state = env._current_state

    # ----------------------------------------------------------------------
    # The accumulated list of actions is stored in the local variable `actions`.
    # ----------------------------------------------------------------------
    return actions


    # ----------------------------------------------------------------------
    # Helper utilities (local to this function)
    # ----------------------------------------------------------------------
    import numpy as np

    # reset the environment and obtain the initial state
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world
    cookbook = world.cookbook

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    arrow_idx = cookbook.index.index("arrow")
    # primitive requirements for one arrow (primitive_kind -> count)
    primitive_needs = dict(cookbook.primitives_for(arrow_idx))

    # ----------------------------------------------------------------------
    # Action mapping
    # ----------------------------------------------------------------------
    act_map = env.action_specs()          # e.g. {'DOWN':0,'UP':1,'LEFT':2,'RIGHT':3,'USE':4}
    ACTION_USE = act_map["USE"]
    ACTIONS_MOVE = {
        "LEFT":  act_map["LEFT"],
        "RIGHT": act_map["RIGHT"],
        "UP":    act_map["UP"],
        "DOWN":  act_map["DOWN"],
    }

    # ----------------------------------------------------------------------
    # Utility: execute an action, record it, and refresh the state object
    # ----------------------------------------------------------------------
    action_sequence = []

    def do_action(action):
        """Execute an action in the env, record it and update `state`."""
        nonlocal state
        reward, done, _ = env.step(action)          # ignore reward / done here
        action_sequence.append(action)
        state = env._current_state
        return reward, done

    # ----------------------------------------------------------------------
    # Utility: Manhattan distance
    # ----------------------------------------------------------------------
    def manhattan(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    # ----------------------------------------------------------------------
    # Utility: find all positions of a given kind (where count > 0)
    # ----------------------------------------------------------------------
    def positions_of(kind_idx):
        """Return list of (x, y) where the grid contains `kind_idx`."""
        grid_slice = state.grid[:, :, kind_idx]
        xs, ys = np.where(grid_slice > 0)
        return list(zip(xs.tolist(), ys.tolist()))

    # ----------------------------------------------------------------------
    # Utility: pick a free (empty) neighbouring cell of a target position.
    # ----------------------------------------------------------------------
    def free_adjacent(target):
        """Return a free cell adjacent to `target` (or None if none)."""
        tx, ty = target
        candidates = [(tx - 1, ty), (tx + 1, ty), (tx, ty - 1), (tx, ty + 1)]
        max_x, max_y = state.grid.shape[0] - 1, state.grid.shape[1] - 1
        for cx, cy in candidates:
            if 0 <= cx <= max_x and 0 <= cy <= max_y:
                if state.grid[cx, cy, :].sum() == 0:        # completely empty cell
                    return (cx, cy)
        return None

    # ----------------------------------------------------------------------
    # Utility: move the agent step‑by‑step towards a destination cell.
    # ----------------------------------------------------------------------
    def move_to(dest):
        """Issue MOVE actions until the agent reaches `dest`."""
        while state.pos != dest:
            px, py = state.pos
            dx, dy = dest[0] - px, dest[1] - py
            if dx > 0:
                do_action(ACTIONS_MOVE["RIGHT"])
            elif dx < 0:
                do_action(ACTIONS_MOVE["LEFT"])
            elif dy > 0:
                do_action(ACTIONS_MOVE["DOWN"])
            elif dy < 0:
                do_action(ACTIONS_MOVE["UP"])
            else:
                break      # already there (should not happen)

    # ----------------------------------------------------------------------
    # Phase 1 – collect all required primitives
    # ----------------------------------------------------------------------
    for prim_kind, needed_cnt in list(primitive_needs.items()):
        while needed_cnt > 0:
            # locate all remaining instances of this primitive
            prim_positions = positions_of(prim_kind)
            if not prim_positions:
                raise RuntimeError("Required primitive not found in the world.")

            # choose the closest one (Manhattan distance)
            cur_pos = state.pos
            closest = min(prim_positions, key=lambda p: manhattan(p, cur_pos))

            # move to a free adjacent cell of that primitive
            adj = free_adjacent(closest)
            if adj is None:
                # fallback: try to stand on the primitive cell itself (should be impossible)
                raise RuntimeError("No free adjacent cell to primitive.")
            move_to(adj)

            # now use the primitive (pick it up)
            do_action(ACTION_USE)

            # update bookkeeping
            needed_cnt -= 1
            primitive_needs[prim_kind] = needed_cnt

    # ----------------------------------------------------------------------
    # Phase 2 – craft the arrow at its workshop
    # ----------------------------------------------------------------------
    # retrieve workshop kind from the recipe
    recipe_dict = cookbook.recipes[arrow_idx]
    workshop_name = recipe_dict["_at"]
    workshop_kind = cookbook.index.index(workshop_name)

    # locate the workshop (there should be exactly one)
    workshop_positions = positions_of(workshop_kind)
    if not workshop_positions:
        raise RuntimeError("Workshop for arrow not found.")
    workshop_pos = workshop_positions[0]

    # move next to the workshop
    adj_ws = free_adjacent(workshop_pos)
    if adj_ws is None:
        raise RuntimeError("No free cell adjacent to the workshop.")
    move_to(adj_ws)

    # issue USE to craft the arrow
    do_action(ACTION_USE)

    # ----------------------------------------------------------------------
    # Return the compiled action list
    # ----------------------------------------------------------------------
    return action_sequence

