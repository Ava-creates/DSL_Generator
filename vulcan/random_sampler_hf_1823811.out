    # ------------------------------------------------------------------
    # Constants
    # ------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _is_walkable(grid, pos, ignore_kind=None):
        """Return True if `pos` is free to step on.
        Cells that contain any entity are blocked, except when the entity is
        `ignore_kind` (used to allow stepping onto a primitive we intend to pick up)."""
        x, y = pos
        cell = grid[x, y, :]
        if ignore_kind is not None and cell[ignore_kind] > 0:
            # allow stepping onto the target primitive
            return np.count_nonzero(cell) == 1
        return not cell.any()

    def _bfs_path(grid, start, goal, ignore_kind=None):
        """Find a shortest 4‑connected path from `start` to `goal`.
        Returns a list of positions (including both endpoints) or None if unreachable."""
        if start == goal:
            return [start]
        width, height = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(grid, nxt, ignore_kind):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Convert a list of adjacent positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent positions in path")
        return acts

    def _move_actions(grid, src, dst, ignore_kind=None):
        """Return actions to move from src to dst using BFS; fall back to Manhattan."""
        path = _bfs_path(grid, src, dst, ignore_kind)
        if path is None:
            # fallback: simple Manhattan moves (may collide with obstacles)
            actions = []
            x, y = src
            tx, ty = dst
            dx = tx - x
            dy = ty - y
            if dx > 0:
                actions += [DOWN] * dx
            elif dx < 0:
                actions += [UP] * (-dx)
            if dy > 0:
                actions += [RIGHT] * dy
            elif dy < 0:
                actions += [LEFT] * (-dy)
            return actions
        return _actions_from_path(path)

    def _nearest_kind(grid, pos, kind_idx):
        """Find the nearest cell (Manhattan distance) that currently contains `kind_idx`."""
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # 1. Determine required primitives for the target item (arrow)
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # 2. Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)  # ensure a plain tuple
    grid = env._current_state.grid

    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_kind(grid, cur_pos, prim_idx)
            if target is None:
                # primitive missing – abort planning
                return actions
            actions += _move_actions(grid, cur_pos, target, ignore_kind=prim_idx)
            cur_pos = target
            actions.append(USE)   # pick up the primitive
            # update grid simulation (primitive removed after pickup)
            grid = np.copy(grid)
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop (if any) and craft the item
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(grid, cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(grid, cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions


    import collections, numpy as np

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities (use a mutable copy of the grid for planning)
    # ------------------------------------------------------------------
    def _is_walkable(pos, grid):
        """A cell is walkable if it contains no entities."""
        x, y = pos
        return not grid[x, y, :].any()

    def _bfs_path(start, goal, grid):
        """Return a list of positions from start to goal (inclusive) using BFS."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(nxt, grid):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, grid):
        """Return actions moving from src to dst using BFS, fallback to Manhattan."""
        path = _bfs_path(src, dst, grid)
        if path is None:
            # simple Manhattan fallback (may intersect obstacles)
            actions = []
            x, y = src
            tx, ty = dst
            dx, dy = tx - x, ty - y
            if dx > 0:
                actions += [DOWN] * dx
            elif dx < 0:
                actions += [UP] * (-dx)
            if dy > 0:
                actions += [RIGHT] * dy
            elif dy < 0:
                actions += [LEFT] * (-dy)
            return actions
        return _actions_from_path(path)

    def _nearest_cell(pos, kind_idx, grid):
        """Find the nearest cell (Manhattan) containing kind_idx."""
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    def _adjacent_walkable(target, start, grid):
        """Return (adjacent_pos, path_actions) to the closest walkable neighbour of target."""
        w, h = grid.shape[:2]
        candidates = []
        tx, ty = target
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nx, ny = tx + dx, ty + dy
            if 0 <= nx < w and 0 <= ny < h and _is_walkable((nx, ny), grid):
                path = _bfs_path(start, (nx, ny), grid)
                if path is not None:
                    candidates.append(((nx, ny), path))
        if not candidates:
            return None, None
        # pick the candidate with shortest path length
        adj_pos, best_path = min(candidates, key=lambda x: len(x[1]))
        return adj_pos, best_path

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # mutable copy of the grid for planning (so we can “remove” taken items)
    planning_grid = env._current_state.grid.copy()
    cur_pos = env._current_state.pos
    plan_actions = []

    # --------------------------------------------------------------
    # 1. Collect each required primitive
    # --------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            prim_cell = _nearest_cell(cur_pos, prim_idx, planning_grid)
            if prim_cell is None:
                # primitive not present – abort planning
                return plan_actions
            # find a walkable neighbour of the primitive
            adj_pos, path_to_adj = _adjacent_walkable(prim_cell, cur_pos, planning_grid)
            if adj_pos is None:
                # cannot reach a neighbour – abort
                return plan_actions
            # translate path (list of positions) to actions
            plan_actions += _actions_from_path(path_to_adj)
            cur_pos = adj_pos
            plan_actions.append(USE)   # pick up the primitive
            # mark primitive as taken in planning grid
            planning_grid[prim_cell[0], prim_cell[1], prim_idx] = 0

    # --------------------------------------------------------------
    # 2. Move to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_cell = _nearest_cell(cur_pos, workshop_idx, planning_grid)
        if workshop_cell is not None:
            adj_pos, path_to_adj = _adjacent_walkable(workshop_cell, cur_pos, planning_grid)
            if adj_pos is not None:
                plan_actions += _actions_from_path(path_to_adj)
                cur_pos = adj_pos
                plan_actions.append(USE)   # craft at the workshop

    return plan_actions

