    def _move_actions(src, dst):
        """Manhattan movement actions from src (x,y) to dst (x,y)."""
        actions = []
        sx, sy = src
        dx, dy = dst
        if dx > sx:
            actions += [DOWN] * (dx - sx)
        elif dx < sx:
            actions += [UP] * (sx - dx)
        if dy > sy:
            actions += [RIGHT] * (dy - sy)
        elif dy < sy:
            actions += [LEFT] * (sy - dy)
        return actions

    def _nearest_kind(pos, kind_idx, grid):
        """Return coordinates of the nearest cell containing `kind_idx`."""
        locs = np.argwhere(grid[:, :, kind_idx] > 0)
        if locs.size == 0:
            return None
        dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])
        nearest = locs[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
