    ACTION_DOWN = action_map["DOWN"]
    ACTION_UP = action_map["UP"]
    ACTION_LEFT = action_map["LEFT"]
    ACTION_RIGHT = action_map["RIGHT"]
    ACTION_USE = action_map["USE"]
    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to find a shortest path (as a list of movement actions)
    # from the current position to any cell that contains the desired kind.
    # Cells occupied by non‑grabbable entities are treated as obstacles.
    # ------------------------------------------------------------------
    def find_path_to(state, target_kind):
        grid = state.grid
        H, W, _ = grid.shape
        start = state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    # avoid non‑grabbable obstacles
                    blocked = any(grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)
                    if not blocked:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return None

    # ------------------------------------------------------------------
    # 1) Collect every required primitive.
    # ------------------------------------------------------------------
    required = world.cookbook.primitives_for(goal_idx)
    for kind, count in required.items():
        for _ in range(count):
            path = find_path_to(state, kind)
            if path is None:
                continue  # primitive not reachable; should not happen in valid scenarios
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        path = find_path_to(state, workshop_kind)
        if path:
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use the workshop to craft the item
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    return actions


    # Reset environment to start a fresh episode
    env.reset()
    state = env._current_state          # type: CraftState
