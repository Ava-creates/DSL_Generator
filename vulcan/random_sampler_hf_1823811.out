    # -------------------------------------------------------------
    # Helper functions used inside the make_arrow_vn implementation
    # -------------------------------------------------------------
    def _bfs_path(grid, start, goal):
        """Return a list of movement actions (0‑3) that moves from start to goal.
        Movement actions are ordered as:
            0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT
        Cells that contain any entity are considered blocked.
        """
        h, w = grid.shape[:2]
        # pre‑compute blocked cells (any non‑zero entry in the kind dimension)
        blocked = (grid.sum(axis=2) > 0)
        # start cell is allowed even if it contains the agent
        blocked[start] = False

        dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT
        q = collections.deque()
        q.append((start, []))
        seen = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) == goal:
                return path
            for a, (dx, dy) in enumerate(dirs):
                nx, ny = x + dx, y + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in seen:
                        seen.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        # no path found – return empty list (caller will handle failure)
        return []

    # -------------------------------------------------------------
    # Main planning logic
    # -------------------------------------------------------------
    # reset the environment and obtain the initial state
    env.reset()
    state = env._current_state                     # CraftState after reset

    # index of the goal item “arrow”
    arrow_idx = env.world.cookbook.index.index('arrow')

    # primitive requirements for a single arrow (dict {prim_idx: count})
    needed_prims = env.world.cookbook.primitives_for(arrow_idx)

    # workshop kind for arrow crafting (the “_at” entry in the recipe)
    workshop_kind_name = env.world.cookbook.recipes[arrow_idx]['_at']
    workshop_idx = env.world.cookbook.index.index(workshop_kind_name)

    actions = []                                   # final action list to return
    max_total_steps = 5000                         # safety guard

    while not state.inventory[arrow_idx] > 0 and len(actions) < max_total_steps:
        # ---------------------------------------------------------
        # 1) Make sure we have all required primitives in inventory
        # ---------------------------------------------------------
        for prim_idx, req_cnt in needed_prims.items():
            while state.inventory[prim_idx] < req_cnt:
                # locate the nearest cell that still holds this primitive
                prim_layer = state.grid[:, :, prim_idx]
                positions = np.argwhere(prim_layer > 0)
                if positions.size == 0:
                    # no more of this primitive on the map – give up
                    return actions
                # choose the closest one (Manhattan distance)
                cur_x, cur_y = state.pos
                dists = np.abs(positions[:, 0] - cur_x) + np.abs(positions[:, 1] - cur_y)
                target = tuple(positions[dists.argmin()])

                # compute a movement plan to that cell
                move_plan = _bfs_path(state.grid, state.pos, target)
                for a in move_plan:
                    actions.append(a)
                    reward, state = env.step(a)    # update internal state
                # now we are on the primitive cell – pick it up
                actions.append(4)                  # USE action
                reward, state = env.step(4)

        # ---------------------------------------------------------
        # 2) Go to the workshop that can craft an arrow and craft it
        # ---------------------------------------------------------
        # locate any workshop cell of the required type
        workshop_layer = state.grid[:, :, workshop_idx]
        ws_positions = np.argwhere(workshop_layer > 0)
        if ws_positions.size == 0:
            # no workshop on the map – abort
            return actions
        cur_x, cur_y = state.pos
        dists = np.abs(ws_positions[:, 0] - cur_x) + np.abs(ws_positions[:, 1] - cur_y)
        workshop_target = tuple(ws_positions[dists.argmin()])

        # move to the workshop
        move_plan = _bfs_path(state.grid, state.pos, workshop_target)
        for a in move_plan:
            actions.append(a)
            reward, state = env.step(a)

        # craft the arrow
        actions.append(4)          # USE on the workshop
        reward, state = env.step(4)

        # loop will exit once the arrow appears in inventory

    return actions


    # Reset the environment to obtain the initial state.
    env.reset()
    # Access the underlying CraftState.
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Identify the index for the goal item "arrow".
    arrow_idx = cookbook.index["arrow"]

    # Determine which primitive resources are required for one arrow.
    primitive_requirements = cookbook.primitives_for(arrow_idx)  # {kind_idx: count}

    # Locate the workshop type required for crafting the arrow.
    workshop_idx = None
    recipe = cookbook.recipes[arrow_idx]
    for key, val in recipe.items():
        if key == "_at":
            workshop_idx = cookbook.index[val]
            break

    actions = []

    # Helper: move from current position to a target cell (Manhattan moves) and then USE.
    def move_to_and_use(cur_pos, target_pos):
        x, y = cur_pos
        tx, ty = target_pos
        # Horizontal moves.
        while x < tx:
            actions.append(3)   # RIGHT
            x += 1
        while x > tx:
            actions.append(2)   # LEFT
            x -= 1
        # Vertical moves.
        while y < ty:
            actions.append(0)   # DOWN
            y += 1
        while y > ty:
            actions.append(1)   # UP
            y -= 1
        # Interact with the cell (pick‑up or craft).
        actions.append(4)       # USE
        return (x, y)

    # Current agent position.
    cur_pos = state.pos

    # Collect each required primitive the needed number of times.
    for kind_idx, needed in primitive_requirements.items():
        # Find all cells that contain this primitive.
        locations = np.argwhere(state.grid[:, :, kind_idx] > 0)
        if len(locations) == 0:
            continue  # No such primitive on the map; skip.
        # Repeatedly go to distinct locations (wrap around if fewer cells than needed).
        for i in range(needed):
            target = tuple(locations[i % len(locations)])
            cur_pos = move_to_and_use(cur_pos, target)

    # Finally, go to the appropriate workshop and craft the arrow.
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if len(workshop_cells) > 0:
            cur_pos = move_to_and_use(cur_pos, tuple(workshop_cells[0]))
            # One additional USE to trigger the crafting action.
            actions.append(4)

    return actions

