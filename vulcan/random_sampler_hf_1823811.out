    # Action indices according to CraftLab's specification
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to find a shortest sequence of movement actions that
    # brings the agent onto a cell containing `target_kind`.  The search
    # may step on empty cells or directly on the target cell; any other
    # occupied cell is treated as an obstacle.
    # ------------------------------------------------------------------
    import collections
    import numpy as np

    def find_path(cur_state, target_kind):
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # No path found – return empty list (should not happen for valid tasks)
        return []

    # ------------------------------------------------------------------
    # 1) Collect every required primitive (respecting the needed count).
    # ------------------------------------------------------------------
    for kind_idx, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, kind_idx)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # pick up the primitive located under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # use the workshop to craft the goal item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # Return the full action sequence that solves the task.
    return actions

