        if goal_idx is None:
            raise ValueError("Arrow item not found in cookbook")

    # Action mapping
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    from collections import deque

    def bfs_path(start, target):
        """Return a list of actions to move from start to target avoiding occupied cells."""
        grid = env._current_state.grid
        h, w, _ = grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # Allow stepping onto the target even if it contains something
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    def move_to(target):
        nonlocal state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                raise RuntimeError(f"Cannot reach target cell {target}")
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    def find_nearest(kind_idx):
        """Locate the nearest cell containing the given kind index."""
        grid = env._current_state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    def adjacent_free(cell):
        """Return a free cell (or the cell itself) adjacent to the given location."""
        y, x = cell
        grid = env._current_state.grid
        h, w, _ = grid.shape
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        return None

