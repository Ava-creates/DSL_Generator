    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    idx = world.cookbook.index
    arrow_idx = idx.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)  # {primitive_idx: count}

    actions = []
    cur_pos = env._current_state.pos
    grid = env._current_state.grid

    def _is_walkable(pos, goal=None):
        """Cell is walkable if empty or it is the goal cell."""
        x, y = pos
        if goal is not None and pos == goal:
            return True
        return not grid[x, y, :].any()

    def _bfs_path(start, goal):
        """Return a list of positions from start to goal using BFS."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(nxt, goal):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a position path into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst):
        """Return actions to move from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(src, dst)
        if path is None:
            # fallback: naive Manhattan moves (may collide with obstacles)
            x, y = src
            tx, ty = dst
            acts = []
            dx, dy = tx - x, ty - y
            if dx > 0:
                acts += [DOWN] * dx
            elif dx < 0:
                acts += [UP] * (-dx)
            if dy > 0:
                acts += [RIGHT] * dy
            elif dy < 0:
                acts += [LEFT] * (-dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx):
        """Find the nearest cell (Manhattan distance) currently containing kind_idx."""
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # 1. Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # primitive not present – abort planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)  # pick up primitive
            # remove the primitive from the planning grid so we don't revisit it
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = idx.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)  # craft at the workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    def _grid():
        """Current grid of the environment."""
        return env._current_state.grid

    def _size():
        g = _grid()
        return g.shape[0], g.shape[1]

    def _walkable(pos, goal=None):
        """Cell is walkable if empty or it is the goal cell."""
        x, y = pos
        if goal is not None and pos == goal:
            return True
        return not _grid()[x, y, :].any()

    def _bfs_path(start, goal):
        """Return a shortest 4‑connected path from start to goal, avoiding occupied cells."""
        if start == goal:
            return [start]
        w, h = _size()
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _walkable(nxt, goal):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst):
        """Return actions to move from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(src, dst)
        if path is None:
            # fallback: Manhattan moves (may collide with obstacles)
            actions = []
            x, y = src
            tx, ty = dst
            dx = tx - x
            dy = ty - y
            if dx > 0:
                actions += [DOWN] * dx
            elif dx < 0:
                actions += [UP] * (-dx)
            if dy > 0:
                actions += [RIGHT] * dy
            elif dy < 0:
                actions += [LEFT] * (-dy)
            return actions
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx):
        """Find the nearest cell containing the given kind."""
        grid = _grid()
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Plan: collect primitives then craft at the workshop (if any)
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # Primitive missing – abort planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)  # pick up primitive

    # Move to workshop (if required) and craft the arrow
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

