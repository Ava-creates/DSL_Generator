    def _move_actions(src, dst):
        """Return a list of actions that moves Manhattan‑style from src to dst."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_kind(pos, kind_idx):
        """Find the coordinates of the nearest cell containing the given kind."""
        grid = env._current_state.grid
        # locations where this kind is present (any positive count)
        locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))
        if not locations:
            return None
        # Manhattan distance to each candidate
        dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]
        return locations[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # 1. Identify the goal (arrow) and its primitive requirements
    # ------------------------------------------------------------------
