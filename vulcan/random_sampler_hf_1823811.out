    # Reset environment and get current state/world references
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------
    # Identify goal (arrow) and its recipe requirements
    # ------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive counts needed (recursively expanded)
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Determine required workshop for final crafting step, if any
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Return shortest path (list of positions) from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Build set of blocked cells (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        queue = collections.deque([start])
        prev = {start: None}
        while queue:
            cur = queue.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        queue.append(nxt)
        # No path found – stay in place
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur to adjacent nxt into an action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Non‑adjacent movement requested")

    # ------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) Collect all required primitives
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            locations = find_locations(prim_idx)
            if not locations:
                # No more instances of this primitive on the map – abort.
                break

            # Choose nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )

            # Move to the primitive
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick it up
            actions.append(4)   # USE
            # Update planning snapshot (inventory & grid)
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2) Move to required workshop (if any)
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

    # 3) Craft the arrow (USE at current location)
    actions.append(4)   # USE

    return actions


