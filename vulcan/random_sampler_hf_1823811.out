    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment to obtain a fresh state.
    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    index = cookbook.index                    # name ↔ id mapping

    # --------------------------------------------------------------
    # Identify the goal item (arrow).
    # --------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []  # Arrow not defined in this world.
    goal_idx = index[goal_name]

    # --------------------------------------------------------------
    # Determine primitive counts needed for a single arrow.
    # --------------------------------------------------------------
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # --------------------------------------------------------------
    # Helper: BFS that treats any occupied cell as blocked,
    # except the target cell itself (so we can step onto a primitive or workshop).
    # --------------------------------------------------------------
    def bfs(start, target):
        """Return a list of positions from start to target (inclusive)
        using 4‑connected moves, or None if unreachable."""
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)          # True where blocked
        occupied[target] = False                           # allow stepping onto target

        q = collections.deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:
                    nxt = (nr, nc)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        q.append(nxt)
        else:
            return None

        # Reconstruct path.
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    # --------------------------------------------------------------
    # Mapping from movement delta to action index.
    # --------------------------------------------------------------
    delta_to_action = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, 1): RIGHT,
        (0, -1): LEFT,
    }

    # --------------------------------------------------------------
    # 1. Collect required primitives.
    # --------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate any remaining instance of this primitive.
            candidates = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if candidates.size == 0:
                # No more of this primitive – abort planning.
                return actions
            tgt_r, tgt_c = candidates[0]

            path = bfs(state.pos, (tgt_r, tgt_c))
            if path is None:
                # Unreachable – abort planning.
                return actions

            # Translate path into actions.
            for (r0, c0), (r1, c1) in zip(path, path[1:]):
                act = delta_to_action[(r1 - r0, c1 - c0)]
                actions.append(act)
                state.pos = (r1, c1)

            # Pick up the primitive.
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[tgt_r, tgt_c, prim_idx] = 0

    # --------------------------------------------------------------
    # 2. Move to the workshop and craft the arrow.
    # --------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # No workshop information – cannot craft.

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # No workshop present.

    w_r, w_c = workshop_cells[0]
    path = bfs(state.pos, (w_r, w_c))
    if path is None:
        return actions

    for (r0, c0), (r1, c1) in zip(path, path[1:]):
        act = delta_to_action[(r1 - r0, c1 - c0)]
        actions.append(act)
        state.pos = (r1, c1)

    # Use the workshop to craft the arrow.
    actions.append(USE)

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # reset environment and obtain references
    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    index = cookbook.index                    # name ↔ id mapping

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its index
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []  # arrow not defined in this world
    goal_idx = index[goal_name]

    # ----------------------------------------------------------------------
    # Determine primitive requirements for a single arrow
    # ----------------------------------------------------------------------
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # ----------------------------------------------------------------------
    # Simple BFS path‑finder (4‑connected Manhattan moves)
    # ----------------------------------------------------------------------
    def bfs(start, target):
        """Return a list of positions from start to target (inclusive).
        Returns None if target is unreachable."""
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)          # True where blocked
        # allow stepping onto the target even if it is occupied
        occupied[target] = False
        q = collections.deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w:
                    if not occupied[nr, nc] and (nr, nc) not in came_from:
                        came_from[(nr, nc)] = cur
                        q.append((nr, nc))
        else:
            return None  # target never reached

        # reconstruct path
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    # ----------------------------------------------------------------------
    # Map movement deltas to action indices
    # ----------------------------------------------------------------------
    delta_to_action = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, 1): RIGHT,
        (0, -1): LEFT,
    }

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find any remaining instance of this primitive
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # No more instances; abort planning
                return actions

            target_r, target_c = cells[0]

            # Compute path to the primitive
            path = bfs(state.pos, (target_r, target_c))
            if path is None:
                # Unreachable; abort planning
                return actions

            # Convert path steps to actions
            for (r0, c0), (r1, c1) in zip(path, path[1:]):
                act = delta_to_action[(r1 - r0, c1 - c0)]
                actions.append(act)
                state.pos = (r1, c1)

            # Pick up the primitive
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[target_r, target_c, prim_idx] = 0

    # ----------------------------------------------------------------------
    # 2. Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # No workshop information; cannot craft

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # No workshop cell found

    w_r, w_c = workshop_cells[0]

    path = bfs(state.pos, (w_r, w_c))
    if path is None:
        return actions  # Workshop unreachable

    for (r0, c0), (r1, c1) in zip(path, path[1:]):
        act = delta_to_action[(r1 - r0, c1 - c0)]
        actions.append(act)
        state.pos = (r1, c1)

    # Craft the arrow at the workshop
    actions.append(USE)

    return actions

