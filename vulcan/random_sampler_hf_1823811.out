    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Compute a path (list of actions) from start to target avoiding blocked cells.
        Actions: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.
        The target cell is considered traversable even if occupied.
        """
        occ = np.any(state.grid > 0, axis=2)          # blocked cells
        # allow stepping onto the target cell
        occ[target] = False
        w, h = occ.shape
        q = deque([(start, [])])
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # no path found

    def go_to(target):
        """Move the agent to `target`, recording actions and updating `state`."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1. Collect all required primitives.
    for kind, count in needed.items():
