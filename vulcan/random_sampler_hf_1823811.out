        if goal_idx is None:
            raise ValueError("Arrow goal not found in cookbook")

    # ------------------------------------------------------------------
    # Action specifications
    # ------------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions: list[int] = []

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of actions from start to goal.
    # Allows stepping onto the goal cell even if occupied.
    # ------------------------------------------------------------------
    def bfs_path(start: tuple[int, int], goal: tuple[int, int]) -> list[int]:
        from collections import deque

        h, w, _ = state.grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev: dict[tuple[int, int], tuple[tuple[int, int], int]] = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                break
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:
                    # Permit moving onto the goal even if it contains something
                    if not state.grid[ny, nx, :].any() or (ny, nx) == goal:
                        visited[ny, nx] = True
                        prev[(ny, nx)] = ((y, x), act)
                        q.append((ny, nx))

        if start == goal:
            return []

        if goal not in prev:
            raise RuntimeError(f"No path from {start} to {goal}")

        # Reconstruct action list
        rev_actions: list[int] = []
        cur = goal
        while cur != start:
            (py, px), act = prev[cur]
            rev_actions.append(act)
            cur = (py, px)
        rev_actions.reverse()
        return rev_actions

    # ------------------------------------------------------------------
    # Helper: Move agent to an absolute position using the BFS planner.
    # ------------------------------------------------------------------
    def move_to(target: tuple[int, int]) -> None:
        nonlocal state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            for a in path:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: Find the nearest cell that contains a given kind index.
    # ------------------------------------------------------------------
    def find_nearest(kind_idx: int) -> tuple[int, int] | None:
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best: tuple[int, int] | None = None
        best_dist = float("inf")
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: Return a free cell (including the cell itself) adjacent to a target.
    # ------------------------------------------------------------------
    def adjacent_free(cell: tuple[int, int]) -> tuple[int, int] | None:
        y, x = cell
        grid = state.grid
        h, w, _ = grid.shape
        # Prefer the cell itself if it's free
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Collect all primitive resources required for the goal item.
    # ------------------------------------------------------------------
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in needed_prims.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                raise RuntimeError(f"Required primitive {kind_idx} not found on map")
            adj = adjacent_free(src)
            if adj is None:
                raise RuntimeError(f"No free cell adjacent to primitive {kind_idx}")
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # If the recipe requires a workshop, move there and craft the item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos is None:
            raise RuntimeError(f"Workshop '{workshop_name}' not found on map")
        adj = adjacent_free(ws_pos)
        if adj is None:
            raise RuntimeError(f"No free cell adjacent to workshop '{workshop_name}'")
        move_to(adj)
        actions.append(ACT_USE)
        _, _, _ = env.step(ACT_USE)
        state = env._current_state

    # Return the compiled action sequence
    return actions


    env.reset()
    state = env._current_state

    # Determine goal index for "arrow"
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow not found in cookbook")

    # Action mapping
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions: list[int] = []

    # ------------------------------------------------------------------
    # Helper: BFS pathfinder returning a list of actions from start to goal
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_path(start: tuple[int, int], goal: tuple[int, int]) -> list[int]:
        h, w, _ = state.grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                break
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:
                    # allow stepping onto the goal even if occupied
                    if not state.grid[ny, nx, :].any() or (ny, nx) == goal:
                        visited[ny, nx] = True
                        prev[(ny, nx)] = ((y, x), act)
                        q.append((ny, nx))

        if start == goal:
            return []

        if goal not in prev:
            raise RuntimeError(f"No path from {start} to {goal}")

        # reconstruct actions
        rev = []
        cur = goal
        while cur != start:
            cur, act = prev[cur]
            rev.append(act)
        rev.reverse()
        return rev

    # ------------------------------------------------------------------
    # Helper: move agent to an absolute position
    # ------------------------------------------------------------------
    def move_to(target: tuple[int, int]) -> None:
        nonlocal state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind index
    # ------------------------------------------------------------------
    def find_nearest(kind_idx: int) -> tuple[int, int] | None:
        grid = env._current_state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best: tuple[int, int] | None = None
        best_dist = float("inf")
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: find a free cell (including the cell itself) adjacent to a target
    # ------------------------------------------------------------------
    def adjacent_free(cell: tuple[int, int]) -> tuple[int, int] | None:
        y, x = cell
        grid = env._current_state.grid
        h, w, _ = grid.shape
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Collect all primitive resources required for the arrow
    # ------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                raise RuntimeError(f"Primitive {kind_idx} not found on map")
            adj = adjacent_free(src)
            if adj is None:
                raise RuntimeError(f"No free cell adjacent to primitive {kind_idx}")
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # If a workshop is required, go there and craft the arrow
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos is None:
            raise RuntimeError(f"Workshop '{workshop_name}' not found")
        adj = adjacent_free(ws_pos)
        if adj is None:
            raise RuntimeError(f"No free cell adjacent to workshop '{workshop_name}'")
        move_to(adj)
        actions.append(ACT_USE)
        env.step(ACT_USE)
        state = env._current_state

    return actions

