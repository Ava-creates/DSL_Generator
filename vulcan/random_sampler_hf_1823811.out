    import numpy as np
    from collections import deque

    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]

    world = env.world
    idx_arrow = world.cookbook.index.index('arrow')
    # primitives needed to craft one arrow: {prim_idx: count}
    needed = world.cookbook.primitives_for(idx_arrow)

    # Current mutable state while planning
    cur_pos = env._current_state.pos
    grid = env._current_state.grid.copy()
    actions = []

    def bfs(start, goal):
        """Return list of actions from start to goal avoiding occupied cells.
        Cells that have any entity (grid[..., :].sum() > 0) are treated as obstacles,
        except the goal cell itself."""
        if start == goal:
            return []
        H, W = grid.shape[:2]
        visited = np.zeros((H, W), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            for dx, dy, act in DIRS:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:
                    # Allow stepping onto goal even if occupied
                    if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:
                        continue
                    visited[nx, ny] = True
                    prev[(nx, ny)] = ((x, y), act)
                    if (nx, ny) == goal:
                        # reconstruct path
                        path = []
                        cur = goal
                        while cur != start:
                            (p, a) = prev[cur]
                            path.append(a)
                            cur = p
                        path.reverse()
                        return path
                    q.append((nx, ny))
        return None  # unreachable

    def nearest_entity(pos, kind_idx):
        """Find nearest cell containing kind_idx using BFS distance.
        Returns (location, path) where path moves from pos to location."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        best_path = None
        best_loc = None
        for loc in locations:
            loc_tup = (int(loc[0]), int(loc[1]))
            path = bfs(pos, loc_tup)
            if path is None:
                continue
            if best_path is None or len(path) < len(best_path):
                best_path = path
                best_loc = loc_tup
        return best_loc, best_path

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target, path = nearest_entity(cur_pos, prim_idx)
            if target is None:
                # primitive not reachable – abort planning
                return actions
            actions.extend(path)
            actions.append(USE)          # pick up the primitive
            cur_pos = target
            # update planning grid: remove one instance of the primitive
            if grid[target[0], target[1], prim_idx] > 0:
                grid[target[0], target[1], prim_idx] -= 1

    # ------------------------------------------------------------------
    # Move to workshop (if recipe specifies one) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(idx_arrow, {})
    workshop_name = recipe.get('_at')
    if workshop_name:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos, path = nearest_entity(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions.extend(path)
            actions.append(USE)      # craft at the workshop
            cur_pos = workshop_pos

    return actions


    # code body

