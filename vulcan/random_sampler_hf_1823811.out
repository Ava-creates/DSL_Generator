    # Reset environment and get initial state/world
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index and primitive requirements
    goal_idx = env.task.goal
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine required workshop (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    import numpy as np
    from collections import deque

    def locate(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step_action(act):
        """Execute an action, updating the local `state`."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def bfs_actions(start, target):
        """
        Bread‑first search returning a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that moves from `start` to `target` while avoiding occupied cells.
        The target cell may be occupied (e.g., holding a primitive), which we
        allow to step onto.
        """
        occ = np.any(state.grid > 0, axis=2)  # True where any entity exists
        width, height = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    # Allow stepping on the target even if occupied
                    if (nx, ny) != target and occ[nx, ny]:
                        continue
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # No path found – return empty list
        return []

    def go_to(target):
        """Move from current position to `target`, recording actions."""
        for act in bfs_actions(state.pos, target):
            actions.append(act)
            step_action(act)

    # ------------------------------------------------------------------
    # 1) Collect required primitives (taking inventory into account)
    # ------------------------------------------------------------------
    for kind, req_cnt in needed.items():
        while state.inventory[kind] < req_cnt:
            positions = locate(kind)
            if not positions:
                # Primitive not available; abort early
                return actions
            # Choose the nearest occurrence (Manhattan distance)
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the primitive
            actions.append(4)          # USE
            step_action(4)

    # ------------------------------------------------------------------
    # 2) Go to workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
            actions.append(4)          # USE to trigger crafting
            step_action(4)

    return actions


    # Reset environment and obtain initial state/world.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal item index.
    goal_idx = env.task.goal

    # Primitive requirements for one unit of the goal (expanded recursively).
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine required workshop (if any) for crafting the goal.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_name = recipe["_at"]
        workshop_idx = world.cookbook.index[workshop_name]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) coordinates where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_actions(start, target):
        """
        Bread‑first search returning a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that moves from `start` to `target` while avoiding occupied cells.
        """
        occ = np.any(state.grid > 0, axis=2)          # True where blocked
        w, h = occ.shape
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in visited:
                        visited.add(nxt)
                        q.append((nxt, path + [act]))
        return []   # No path found (should not happen in valid scenarios)

    def go_to(target):
        """Move agent from its current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_actions(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1) Collect all required primitives.
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:          # Primitive missing – abort early.
                return actions
            # Choose nearest occurrence (Manhattan distance).
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            actions.append(4)          # USE to pick up the item.
            _, state = state.step(4)

    # 2) If a workshop is required, go there and craft the goal.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
            actions.append(4)          # USE to trigger crafting.
            _, state = state.step(4)

    return actions

