    # ----------------------------------------------------------------------
    # Helper: BFS returning a list of actions from start to goal.
    # ----------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return actions to move from start to goal (ignoring occupancy of goal)."""
        from collections import deque

        h, w, _ = state.grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev = {}
        q = deque()
        q.append(start)
        visited[start] = True

        while q:
            cur = q.popleft()
            if cur == goal:
