    # reset environment and get handles
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # goal definition
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitives required for one arrow
    needed_prims = world.cookbook.primitives_for(goal_idx)

    # workshop required for final crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # helper utilities
    # ------------------------------------------------------------------
    def find_positions(kind):
        """Return list of (x, y) where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal):
        """Shortest path (list of positions) from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        return [start]  # no path found

    def move_action(cur, nxt):
        """Convert a step from cur to adjacent nxt into an action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("Non‑adjacent move requested")

    # ------------------------------------------------------------------
    # construct action list
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) collect each needed primitive
    for prim_idx, cnt_needed in needed_prims.items():
        while state.inventory[prim_idx] < cnt_needed:
            locations = find_positions(prim_idx)
            if not locations:
                # cannot find more of this primitive – break out
                break
            # choose nearest location (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            # move to target
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # pick up the primitive
            actions.append(4)               # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2) go to workshop (if required) and craft
    if workshop_kind is not None:
        wk_locs = find_positions(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
        actions.append(4)   # USE to craft at workshop
    else:
        actions.append(4)   # USE to craft in place

    return actions

