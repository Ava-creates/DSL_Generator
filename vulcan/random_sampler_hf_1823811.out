    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.shape[0] == 0:
                # Primitive not found; abort planning
                return plan
            # Choose the nearest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = locations[dists.argmin()]
            if not move_to_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the appropriate workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # Workshops are static; fall back to the original scenario grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = workshop_cells[dists.argmin()]

    move_to_and_use(workshop_target, workshop_idx)

    return plan

