    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # name ↔ integer id mapping

    # Resolve action indices dynamically from the environment spec
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]

    # Goal item
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # Arrow not defined in this world
    goal_idx = index[goal_name]

    # Primitive requirements for the goal
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                         # Final action sequence

    from collections import deque

    def _bfs_path(start, target):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to target.
        Cells occupied by any entity are treated as obstacles, except the target cell itself.
        """
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        moves = [(DOWN, (1, 0)),
                 (UP, (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT, (0, 1))]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Occupied cells are obstacles unless they are the target.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        # If target unreachable, return empty list.
        if target not in parent and start != target:
            return []
        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate all cells currently containing this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present; abort early.
                return actions
            # Choose the nearest primitive (Manhattan distance).
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            tr, tc = prim_cells[dists.argmin()]

            # Move to the primitive cell.
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick up the primitive.
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0   # Cell becomes empty.

    # ------------------------------------------------------------------
    # 2. Go to the workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # No workshop info; cannot craft.

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # No workshop present in this scenario.

    # Choose nearest workshop.
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]

    # Move to the workshop.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions


