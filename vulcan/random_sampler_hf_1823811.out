    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # target item
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []

    # primitives needed (recursive)
    primitive_needs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Return a list of positions from start (excluded) to goal (included)."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Convert a movement delta into the environment's action index."""
        if dx == 1:
            return 3  # RIGHT
        if dx == -1:
            return 2  # LEFT
        if dy == 1:
            return 0  # DOWN
        if dy == -1:
            return 1  # UP
        raise ValueError("Invalid movement delta")

    actions = []
    cur_pos = tuple(state.pos)
    # mutable copy to track collected primitives
    grid = state.grid.copy()

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources
    # ------------------------------------------------------------------
    for kind_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                break
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)  # any entity blocks movement
            target = None
            path = None
            for idx in order:
                cand = tuple(locations[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    target = cand
                    path = p
                    break
            if target is None:
                continue  # cannot reach this primitive

            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            actions.append(4)  # USE to pick up
            grid[target[0], target[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)  # original grid (workshops occupied)
            for idx in order:
                wpos = tuple(workshop_cells[idx])
                p = bfs_path(cur_pos, wpos, occupied_mask)
                if p is not None:
                    for step in p:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)  # USE to craft
                    break
    else:
        # No specific workshop needed; craft at current location
        actions.append(4)

    return actions


