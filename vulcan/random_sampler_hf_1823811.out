        (0, -1): ACT_LEFT,
    }

    actions = []

    # -------------------------------------------------------------------------
    # Bread‑first‑search returning a list of actions from start → goal
    # -------------------------------------------------------------------------
    def bfs_path(start, goal):
        """Return a list of actions to move from start to goal (free cells)."""
        from collections import deque

        h, w, _ = state.grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            cur = q.popleft()
            if cur == goal:
                break
