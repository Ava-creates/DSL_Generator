    # Reset the environment and obtain handles to the current state and world.
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Map action names to their integer indices.
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    # Directions used for BFS (dx, dy, corresponding action).
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns the shortest list of movement actions that
    # brings the agent onto a cell containing `target_kind`.  Cells that
    # contain any non‑grabbable entity are treated as obstacles.
    # ------------------------------------------------------------------
    import collections

    def bfs_path(cur_state, target_kind):
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Block movement onto cells occupied by non‑grabbable items.
                blocked = any(grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)
                if blocked:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # Target unreachable – return None (should not happen for valid tasks).
        return None

    # ------------------------------------------------------------------
    # 1) Collect every primitive required for the goal.
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed_primitives = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    for prim_idx, cnt in needed_primitives.items():
        for _ in range(cnt):
            path = bfs_path(state, prim_idx)
            if path is None:
                continue  # Unreachable primitive; skip (unlikely in well‑formed scenarios).
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive located under the agent.
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
