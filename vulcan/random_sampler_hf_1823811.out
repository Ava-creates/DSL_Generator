    import numpy as np
    from collections import deque

    # Action indices: 0 DOWN, 1 UP, 2 LEFT, 3 RIGHT, 4 USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    USE = 4

    # ------------------------------------------------------------------
    # Reset / obtain the current state
    # ------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        # some environments return the observation dict on reset
        try:
            env.reset()
            state = getattr(env, "_current_state", None)
        except Exception:
            pass
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []

    # Primitive requirements for a single arrow
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # Workshop required for the arrow (stored under "_at" or "_key")
    recipe_dict = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = None
    for k, v in recipe_dict.items():
        if k == "_at" or k == "_key":
            workshop_name = v
            break
    if workshop_name is None:
        return []

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []

    # ------------------------------------------------------------------
    # Local mutable copies for planning
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells

    plan_actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to any empty neighbour of a target cell
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, target, blocked):
        """Return list of movement actions that bring the agent from *start*
        to a free cell adjacent (4‑connected) to *target*."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []  # target completely surrounded

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Helper: move next to a target cell and issue USE
    # ------------------------------------------------------------------
    def move_and_use(target_coord, kind_idx):
        """Move adjacent to *target_coord* (which contains an entity of
        *kind_idx*) and perform a USE action. Updates planning state."""
        nonlocal pos, plan_actions, grid, occupied, inventory

        path = bfs_to_adjacent(pos, target_coord, occupied)
        if not path and pos != target_coord:
            return False  # cannot reach a neighbour

        # apply movement actions to simulated position
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan_actions.extend(path)

        # perform USE
        plan_actions.append(USE)

        tx, ty = target_coord
        if grid[tx, ty, kind_idx] > 0:
            # pick up the primitive
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.shape[0] == 0:
                # no more of this primitive on the map
                return plan_actions
            # choose the closest one (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan_actions

    # ------------------------------------------------------------------
    # Move to workshop and craft the arrow
    # ------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # fallback to static locations from the original scenario
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan_actions

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])

    move_and_use(workshop_target, workshop_idx)

    # ------------------------------------------------------------------
    # Return the planned action sequence
    # ------------------------------------------------------------------
    return plan_actions


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (match CraftLab.action_specs order)
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS to any empty cell adjacent to a target cell
    # ----------------------------------------------------------------------
    def bfs_to_adjacent(start, target, blocked):
        """Return a list of actions moving from *start* to a free neighbour of *target*.
        If unreachable, returns an empty list."""
        h, w = blocked.shape
        tx, ty = int(target[0]), int(target[1])
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ----------------------------------------------------------------------
    # Reset / obtain current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass
    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify arrow goal and its recipe
    # ----------------------------------------------------------------------
    try:
        arrow_idx = idx["arrow"]
    except Exception:
        return []
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    recipe_dict = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe_dict.get("_at") or recipe_dict.get("_key")
    if workshop_name is None:
        return []
    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Local mutable copies for planning
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                    # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)         # bool matrix: any entity present

    plan_actions = []

    # ----------------------------------------------------------------------
    # Helper: move adjacent to *target_coord* and issue a USE action
    # ----------------------------------------------------------------------
    def move_and_use(target_coord, kind_idx):
        """Navigate next to *target_coord* (which contains *kind_idx*) and USE.
        Updates simulated pos, grid, occupied, inventory. Returns False on failure."""
        nonlocal pos, plan_actions, grid, occupied, inventory

        path = bfs_to_adjacent(pos, target_coord, occupied)
        if not path and pos != target_coord:
            return False
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan_actions.extend(path)

        # Perform USE
        plan_actions.append(USE)

        tx, ty = int(target_coord[0]), int(target_coord[1])
        if grid[tx, ty, kind_idx] > 0:
            # Pick up one unit of the primitive
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect required primitives
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.shape[0] == 0:
                # No more instances of this primitive on the map
                return plan_actions
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = candidates[dists.argmin()]
            if not move_and_use(target, prim_idx):
                return plan_actions

    # ----------------------------------------------------------------------
    # Move to a workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # Fallback to original scenario grid (workshops are static)
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan_actions

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = workshop_cells[dists.argmin()]

    move_and_use(workshop_target, workshop_idx)

    return plan_actions

