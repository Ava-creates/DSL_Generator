    import collections
    import numpy as np

    # reset the environment and get handles to the current state and world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    idx = world.cookbook.index           # name → integer id

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe requirements
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitive resources needed for ONE arrow
    primitive_needs = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # workshop (if any) where the arrow must be crafted
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind, grid):
        """Return list of (x, y) where `kind` occurs on `grid`."""
        occ = np.where(grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal, blocked):
        """Return shortest 4‑connected path from start to goal avoiding `blocked` cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # unreachable – stay put
        return [start]

    def move_action(cur, nxt):
        """Translate a step between adjacent cells into a DMLab action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("Requested move is not to an adjacent cell")

    # ------------------------------------------------------------------
    # Prepare mutable copies of grid and inventory for planning
    # ------------------------------------------------------------------
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    cur_pos = state.pos
    actions = []

    # cells occupied by non‑grabbable entities are blocked for movement
    blocked_cells = set()
    for ng in world.non_grabbable_indices:
        occ = np.where(grid[:, :, ng] > 0)
        blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))

    # ------------------------------------------------------------------
    # 1) Gather all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        while inventory[prim_idx] < needed:
            # find remaining instances of this primitive
            candidates = locate(prim_idx, grid)
            if not candidates:
                # cannot satisfy the recipe – break to avoid infinite loop
                break
            # choose the closest one (Manhattan distance)
            target = min(candidates,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            # move to the target
            path = bfs(cur_pos, target, blocked_cells)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # pick up the primitive
            actions.append(4)          # USE
            inventory[prim_idx] += 1
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2) Go to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locs = locate(workshop_kind, grid)
        if wk_locs:
            target = min(wk_locs,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            path = bfs(cur_pos, target, blocked_cells)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
    # craft (USE at current location)
    actions.append(4)          # USE

    return actions


    # Reset the environment and fetch the current state and world objects.
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    idx = world.cookbook.index           # name → integer id

    # ------------------------------------------------------------------
    # Identify the goal ("arrow") and its recipe requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive resources required for ONE arrow.
    primitive_needs = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop kind required for crafting (may be None).
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` appears on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def blocked_cells():
        """Set of positions occupied by non‑grabbable entities."""
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))
        return blocked

    def bfs(start, goal):
        """Return a shortest 4‑connected path from `start` to `goal` (list of positions)."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        blocked = blocked_cells()

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay where we are.
        return [start]

    def move_action(cur, nxt):
        """Translate a step between adjacent cells into a DMLab action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not between adjacent cells")

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # 1) Gather all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        while state.inventory[prim_idx] < needed:
            candidates = locate(prim_idx)
            if not candidates:
                # No more instances of this primitive on the map – give up.
                break

            # Choose the closest candidate by Manhattan distance.
            target = min(
                candidates,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )

            # Move to the target cell.
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive.
            actions.append(4)                     # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0  # remove from world

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if required) and craft the arrow.
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locs = locate(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

    # Craft the arrow (USE at current location).
    actions.append(4)   # USE

    return actions

