    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    from collections import deque

    actions = []

    def bfs_path(start, target):
        """Return a list of actions to move from start to target."""
        grid = state.grid
        h, w, _ = grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # Allow stepping onto the target even if occupied
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    def move_to(target):
        """Move the agent to an absolute position using bfs_path."""
        nonlocal state, actions
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # cannot reach the target
            for a in path:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    def find_nearest(kind_idx):
        """Find the nearest cell containing the given kind index."""
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    def adjacent_free(cell):
        """Return a free cell (including diagonals) adjacent to `cell`."""
        y, x = cell
        grid = state.grid
        h, w, _ = grid.shape
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        # Fallback: stay where we are (should rarely happen)
        return state.pos

    # ----------------------------------------------------------------------
    # Collect all primitive resources required for the arrow.
    # ----------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in primitives_needed.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                raise RuntimeError(f"Required primitive {kind_idx} not found")
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # ----------------------------------------------------------------------
    # Go to the appropriate workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos is None:
            raise RuntimeError(f"Workshop {workshop_name} not found")
        adj = adjacent_free(ws_pos)
        move_to(adj)
        actions.append(ACT_USE)
        _, _, _ = env.step(ACT_USE)
        state = env._current_state

    return actions

