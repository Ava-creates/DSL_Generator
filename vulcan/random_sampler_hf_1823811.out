    import numpy as np
    from collections import deque

    # Reset the environment to a fresh episode and fetch the initial state.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Identify the goal item index and its primitive requirements.
    goal_idx = env.task.goal
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine if the recipe requires a specific workshop.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` exists on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Compute a shortest sequence of movement actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        from `start` to `target`.  Cells occupied by any entity are treated as
        blocked, except the target cell itself (which may hold the primitive or
        workshop we intend to interact with).
        """
        occ = np.any(state.grid > 0, axis=2)          # True where blocked.
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    if not occ[nx, ny] or (nx, ny) == target:
                        if (nx, ny) not in visited:
                            visited.add((nx, ny))
                            q.append(((nx, ny), path + [act]))
        # No path found – return empty list.
        return []

    def move_to(target):
        """Move the agent from its current location to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, count in needed.items():
        for _ in range(count):
            positions = locate(kind)
            if not positions:
                # Primitive missing – abort planning.
                return actions
            # Choose the nearest occurrence (Manhattan distance) to reduce travel.
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            move_to(target)
            # Pick up the primitive.
            actions.append(4)          # USE action.
            _, state = state.step(4)

    # ------------------------------------------------------------------
    # 2. Go to the required workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                           key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            move_to(target_ws)
            actions.append(4)          # USE to trigger crafting.
            _, state = state.step(4)
    else:
        # No specific workshop – attempt to craft at the current location.
        actions.append(4)
        _, state = state.step(4)

    return actions


    # Reset the environment and obtain the initial state.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index and primitive requirements.
    goal_idx = env.task.goal
    needed = world.cookbook.primitives_for(goal_idx).copy()

    # Identify required workshop (if any).
    workshop_idx = None
