    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # name ↔ id mapping

    # Action indices from the environment spec
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # arrow not defined in this world

    goal_idx = index[goal_name]          # integer id of the arrow item
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                         # list that will be returned

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of move actions from start to target.
    # Cells occupied by any entity are treated as obstacles, except the
    # target cell itself (which may be occupied by the desired primitive
    # or a workshop).
    # ------------------------------------------------------------------
    from collections import deque

    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    def _bfs_path(start, target):
        """Return a list of move actions to reach `target` from `start`."""
        if start == target:
            return []

        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}

        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)

        if target not in parent and start != target:
            # No path found – return empty list.
            return []

        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Helper: find the nearest cell containing a given kind index.
    # Returns (path, (row, col)) where path is a list of move actions.
    # ------------------------------------------------------------------
    def _nearest_cell(start, kind_idx):
        """BFS from start until a cell with `kind_idx` is found."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start

        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}

        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Treat any occupied cell as blocked (except when it holds the target kind)
                if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # Reconstruct path to this cell.
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        # No reachable cell found.
        return [], None

    # ------------------------------------------------------------------
    # 1. Collect each required primitive (respecting multiplicities).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            path, cell = _nearest_cell(state.pos, prim_idx)
            if cell is None:
                # Primitive not reachable – abort.
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)                     # pick up
            # Update internal copies.
            state.inventory[prim_idx] += 1
            state.grid[cell[0], cell[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions

    workshop_idx = index[workshop_name]
    path, cell = _nearest_cell(state.pos, workshop_idx)
    if cell is None:
        return actions
    actions.extend(path)
    state.pos = cell
    actions.append(USE)                     # craft the arrow

    return actions


