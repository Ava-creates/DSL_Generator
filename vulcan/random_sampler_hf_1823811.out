                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in _blocked_cells:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay in place
        return [start]

    def move_action(cur, nxt):
        """Translate a step between adjacent cells into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not between adjacent cells")

    # ------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # 1) Collect all required primitives (respecting current inventory)
    # ------------------------------------------------------------------
    inventory = state.inventory.copy()
    for prim_idx, needed_total in primitive_counts.items():
        needed = needed_total - int(inventory[prim_idx])
        for _ in range(max(0, needed)):
            locations = find_locations(prim_idx)
            if not locations:
                # Primitive not present on the map – assume already held
                break

            # Choose the reachable location with the shortest BFS distance
            best_path = None
            for loc in locations:
                path = bfs_path(cur_pos, loc)
                if len(path) == 1:   # unreachable
                    continue
                if best_path is None or len(path) < len(best_path):
                    best_path = path
                    if len(best_path) == 2:   # cannot be shorter than 1 step
                        break

            if best_path is None:
                # No reachable instance; abort further collection of this primitive
                break

            # Follow the path to the primitive
            for step in best_path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)   # USE
            # Update simulated inventory for subsequent planning
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            best_path = None
            for loc in wk_locations:
                path = bfs_path(cur_pos, loc)
                if len(path) == 1:
                    continue
                if best_path is None or len(path) < len(best_path):
                    best_path = path
                    if len(best_path) == 2:
                        break
            if best_path is not None:
                for step in best_path[1:]:
                    actions.append(move_action(cur_pos, step))
                    cur_pos = step
        # Craft at the workshop
        actions.append(4)   # USE
    else:
        # No specific workshop – craft where we are
        actions.append(4)   # USE

    return actions


    # reset environment and fetch current state/world information
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # target item
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitives required for one arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind, grid):
        """Return list of (x, y) where `kind` is present in `grid`."""
        occ = np.where(grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Translate a step from cur → nxt into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("non‑adjacent move requested")

    def bfs_path(start, goal, grid):
        """Shortest path from start to goal avoiding occupied cells (except goal)."""
        if start == goal:
            return [start]
        W, H = grid.shape[:2]

        # cells that cannot be traversed: any occupied cell that is not the goal
        blocked = set()
        occ = np.argwhere(grid.sum(axis=2) > 0)
        for x, y in occ:
            if (x, y) != goal:
                blocked.add((x, y))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # no path found – stay where we are
        return [start]

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    cur_grid = state.grid.copy()   # mutable copy that we update after pickups

    # 1) Collect required primitives (nearest first)
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            locations = find_locations(prim_idx, cur_grid)
            if not locations:
                # Primitive not present – assume already in inventory
                continue

            # choose the nearest occurrence (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target, cur_grid)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)                     # USE to pick up
            # remove the primitive from the mutable grid representation
            cur_grid[target[0], target[1], prim_idx] = 0

    # 2) Move to workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind, cur_grid)
        if wk_locations:
            target = min(
                wk_locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target, cur_grid)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
        actions.append(4)                         # USE to craft at workshop
    else:
        # No specific workshop – craft at current location
        actions.append(4)                         # USE to craft

    return actions

