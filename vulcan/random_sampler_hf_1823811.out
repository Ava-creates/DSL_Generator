            tx, ty = dst
            if tx > x:
                acts += [DOWN] * (tx - x)
            elif tx < x:
                acts += [UP] * (x - tx)
            if ty > y:
                acts += [RIGHT] * (ty - y)
            elif ty < y:
                acts += [LEFT] * (y - ty)
            return acts
        return _path_to_actions(p)

    def _nearest(pos, kind_idx, grid, banned):
        """Find nearest cell containing kind_idx not in banned set."""
        candidates = np.argwhere(grid[:, :, kind_idx] > 0)
