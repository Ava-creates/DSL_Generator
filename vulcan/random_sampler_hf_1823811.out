    # Reset environment and get initial state
    env.reset()
    state = env._current_state

    # ------------------------------------------------------------------
    # Determine the goal index for the arrow
    # ------------------------------------------------------------------
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow not found in cookbook")

    # ------------------------------------------------------------------
    # Action mapping
    # ------------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS pathfinding on free cells (allow stepping onto target)
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_path(start, target):
        """Return a list of actions to move from start to target avoiding occupied cells."""
        grid = state.grid
        h, w, _ = grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # target may be occupied (e.g., a workshop), allow stepping onto it
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Helper: Move the agent to a free cell
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # cannot reach
            for a in path:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: Find the nearest cell that contains a given kind index
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: Return a free cell adjacent (including diagonal) to a target cell
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        grid = state.grid
        h, w, _ = grid.shape
        # Prefer the cell itself if it is free
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        return None  # no free adjacent cell

    # ------------------------------------------------------------------
    # Collect all primitive resources required for the arrow
    # ------------------------------------------------------------------
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in needed_prims.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                raise RuntimeError(f"Required primitive {kind_idx} not found on map")
            adj = adjacent_free(src)
            if adj is None:
                raise RuntimeError(f"No free cell adjacent to primitive {kind_idx}")
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # Move to the appropriate workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos is None:
            raise RuntimeError(f"Workshop '{workshop_name}' not found on map")
        adj = adjacent_free(ws_pos)
        if adj is None:
            raise RuntimeError(f"No free cell adjacent to workshop '{workshop_name}'")
        move_to(adj)
        actions.append(ACT_USE)
        _, _, _ = env.step(ACT_USE)
        state = env._current_state

    return actions


    # reset environment and get initial state
    env.reset()
    state = env._current_state

    # ------------------------------------------------------------------
    # Identify the goal index for the arrow
    # ------------------------------------------------------------------
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow item not found in cookbook")

    # ------------------------------------------------------------------
    # Action mapping
    # ------------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS pathfinding on free cells
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_path(start, target):
        """Return a list of actions moving from start to target, avoiding occupied cells.
        The target cell may be occupied (e.g., a workshop) – we allow stepping onto it.
        """
        grid = env._current_state.grid
        h, w, _ = grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # allow moving onto target even if it contains something
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Helper: move agent to a given free cell
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                raise RuntimeError(f"Cannot reach target cell {target}")
            for a in path:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind index
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = env._current_state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: pick a free cell (including the cell itself) adjacent to a target cell
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        grid = env._current_state.grid
        h, w, _ = grid.shape
        # if the cell itself is free, use it
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Collect all primitive resources required for the arrow
    # ------------------------------------------------------------------
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                raise RuntimeError(f"Required primitive {kind_idx} not present on map")
            adj = adjacent_free(src)
            if adj is None:
                raise RuntimeError(f"No free cell adjacent to primitive {kind_idx}")
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos is None:
            raise RuntimeError(f"Workshop '{workshop_name}' not found on map")
        adj = adjacent_free(ws_pos)
        if adj is None:
            raise RuntimeError(f"No free cell adjacent to workshop '{workshop_name}'")
        move_to(adj)
        actions.append(ACT_USE)
        _, _, _ = env.step(ACT_USE)
        state = env._current_state

    return actions

