    def bfs_path(start, target):
        """
        Bread‑first search returning a list of movement actions
        (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) that moves the agent from `start` to `target`.
        Cells occupied by any entity are treated as blocked, except the target
        cell itself (which may contain the primitive to pick up or a workshop).
        """
        occ = np.any(state.grid > 0, axis=2)          # True where blocked.
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    # Allow stepping onto the target even if currently occupied.
                    if not occ[nx, ny] or (nx, ny) == target:
                        if (nx, ny) not in visited:
                            visited.add((nx, ny))
                            q.append(((nx, ny), path + [act]))
        return []  # No path found.

    def move_to(target):
        """Move from current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, count in needed.items():
        for _ in range(count):
            positions = locate(kind)
            if not positions:                 # Primitive missing – abort.
                return actions
            # Choose nearest occurrence (Manhattan distance) to reduce travel.
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            move_to(target)
            # Pick up the primitive.
            actions.append(4)                  # USE action.
            _, state = state.step(4)

    # ------------------------------------------------------------------
    # 2. Go to workshop (if required) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            move_to(target_ws)

    # Craft / use at the current location.
    actions.append(4)                          # USE action to craft.
    _, state = state.step(4)

    return actions


