    # Mapping from movement delta to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3)
    _delta_to_action = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}
    _USE = 4

    def _is_free(grid, x, y):
        """A cell is free if no entity occupies any channel."""
        return grid[x, y, :].sum() == 0

    def _neighbors(pos, width, height):
        """Yield orthogonal neighbours and their delta."""
        x, y = pos
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nx, ny = x + dx, y + dy
            if 0 <= nx < width and 0 <= ny < height:
                yield (nx, ny), (dx, dy)

    def _bfs_path(grid, start, goal_cond):
        """
        Bread‑first search that returns a list of actions moving the agent
        from ``start`` to any cell satisfying ``goal_cond``.
        """
        width, height = grid.shape[0], grid.shape[1]
        q = deque([start])
        came_from = {start: None}
        move_from = {}
        while q:
            cur = q.popleft()
            if goal_cond(cur):
                # reconstruct actions
                actions = []
                while came_from[cur] is not None:
                    dx, dy = move_from[cur]
                    actions.append(_delta_to_action[(dx, dy)])
                    cur = came_from[cur]
                actions.reverse()
                return actions
            for nxt, delta in _neighbors(cur, width, height):
                if nxt not in came_from and _is_free(grid, *nxt):
                    came_from[nxt] = cur
                    move_from[nxt] = delta
                    q.append(nxt)
        # no path found
        return []

    # ------------------------------------------------------------------
    # Gather static information from the environment.
    # ------------------------------------------------------------------
    state = env._current_state          # CraftState
    world = env.world                   # CraftWorld
    goal_idx = env.task.goal            # integer index of the desired item

    # Primitive requirements for the goal (and required counts).
    needed_prims = world.cookbook.primitives_for(goal_idx).copy()

    # Determine if the recipe needs a specific workshop.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = world.cookbook.index[recipe["_at"]]

    # Make mutable copies that we will update while planning.
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    cur_pos = tuple(state.pos)

    plan = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, req_cnt in needed_prims.items():
        while inventory[prim_idx] < req_cnt:
            # Locate all cells containing this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present – abort planning.
                return plan

            # Choose the closest primitive (Manhattan distance).
            dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
            target = tuple(prim_cells[dists.argmin()])

            # Move to the chosen primitive.
            moves = _bfs_path(grid, cur_pos, lambda p, t=target: p == t)
            plan.extend(moves)
            cur_pos = target

            # Pick it up.
            plan.append(_USE)
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Go to the required workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size == 0:
            return plan

        width, height = grid.shape[0], grid.shape[1]
        best_path = None
        best_target = None

        # Try to stand on the workshop cell itself or any free orthogonal neighbour.
        for wx, wy in ws_cells:
            candidates = [(wx, wy),
                          (wx - 1, wy), (wx + 1, wy),
                          (wx, wy - 1), (wx, wy + 1)]
            for cx, cy in candidates:
                if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):
                    path = _bfs_path(grid, cur_pos,
                                     lambda p, t=(cx, cy): p == t)
                    if best_path is None or len(path) < len(best_path):
                        best_path = path
                        best_target = (cx, cy)

        if best_path is not None:
            plan.extend(best_path)
            cur_pos = best_target
            plan.append(_USE)  # craft at the workshop
    else:
        # No workshop needed – simply use at the current location.
        plan.append(_USE)

    return plan

