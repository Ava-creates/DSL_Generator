    from collections import deque
    import numpy as np

    actions = []

    def locate(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """Shortest path (list of action ints) from start to target avoiding occupied cells."""
        occ = np.any(state.grid > 0, axis=2)          # True where blocked
        # Allow stepping onto the target even if it is occupied (e.g., a workshop).
        occ[target] = False
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []

    def go_to(target):
        """Move agent to `target`, recording actions and updating local state."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, new_state = state.step(act)
            state = new_state

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, required_cnt in needed.items():
        while state.inventory[kind] < required_cnt:
            positions = locate(kind)
            if not positions:
                # Primitive not present; abort planning.
                return actions
            # Choose the nearest occurrence (Manhattan distance).
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the primitive.
            actions.append(4)  # USE
            _, new_state = state.step(4)
            state = new_state

    # ------------------------------------------------------------------
    # 2. Move to required workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target = min(ws_positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            actions.append(4)  # USE to craft at the workshop
            _, new_state = state.step(4)
            state = new_state
    else:
        # No specific workshop required; attempt to craft at current location.
        actions.append(4)  # USE
        _, new_state = state.step(4)
        state = new_state

    return actions


    # Reset the environment to start a fresh episode.
