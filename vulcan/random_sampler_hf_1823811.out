    def _move_actions(src, dst):
        """Return a list of movement actions to go from src to dst (Manhattan)."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_kind(pos, kind_idx):
        """Find the nearest cell that contains the given kind (Manhattan distance)."""
        grid = env._current_state.grid
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        best = int(dists.argmin())
        return tuple(locations[best].tolist())

    # ------------------------------------------------------------------
    # 1. Identify goal and its recipe
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
