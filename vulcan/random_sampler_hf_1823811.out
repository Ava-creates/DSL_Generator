    DIR_MAP = {
        (0, 1): 0,   # DOWN  (y + 1)
        (0, -1): 1,  # UP    (y - 1)
        (-1, 0): 2,  # LEFT  (x - 1)
        (1, 0): 3,   # RIGHT (x + 1)
    }

    def bfs(start, goal):
        """Bread‑first search on empty cells, returning a list of positions."""
        q = collections.deque()
        q.append(start)
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:
                    # Cell must be empty to step onto it
                    if state.grid[nx, ny, :].sum() == 0 and (nx, ny) not in came_from:
                        came_from[(nx, ny)] = cur
                        q.append((nx, ny))
        if goal not in came_from:
            return None
        # Reconstruct path from start to goal (inclusive)
        path = []
        cur = goal
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    def move_along(path):
        """Convert a position path to actions, updating state and recording actions."""
        for prev, nxt in zip(path, path[1:]):
            dx = nxt[0] - prev[0]
            dy = nxt[1] - prev[1]
            act = DIR_MAP[(dx, dy)]
            actions.append(act)
            step_action(act)

    def go_adjacent_to(target_pos):
        """
        Move to an empty cell adjacent to `target_pos`.
        Returns the adjacent cell chosen (or None if impossible).
        """
        tx, ty = target_pos
        # Candidate adjacent cells (must be inside grid and empty)
        candidates = []
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            cx, cy = tx + dx, ty + dy
            if 0 <= cx < WIDTH and 0 <= cy < HEIGHT:
                if state.grid[cx, cy, :].sum() == 0:
                    candidates.append((cx, cy))
        if not candidates:
            return None
        # Choose the reachable candidate with minimal Manhattan distance
        adj = min(candidates, key=lambda p: manhattan(state.pos, p))
        path = bfs(state.pos, adj)
        if path is None:
            return None
        move_along(path)
        return adj

    def face_and_use(target_pos):
        """
        Turn towards `target_pos` (must be directly adjacent) and perform USE.
        """
        ax, ay = state.pos
        tx, ty = target_pos
        dx, dy = tx - ax, ty - ay
        if (dx, dy) not in DIR_MAP:
            # Not directly adjacent; should not happen in normal flow
            return
        turn_act = DIR_MAP[(dx, dy)]
        actions.append(turn_act)
        step_action(turn_act)   # updates direction (agent may stay in place)
        actions.append(4)       # USE
        step_action(4)

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Primitive missing – abort planning
                return actions
            # Choose the nearest occurrence (Manhattan distance)
            target = min(positions, key=lambda p: manhattan(state.pos, p))
            adj = go_adjacent_to(target)
            if adj is None:
                # Cannot reach the primitive – abort
                return actions
            face_and_use(target)

    # ------------------------------------------------------------------
    # 2) Go to required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target = min(ws_positions, key=lambda p: manhattan(state.pos, p))
            adj = go_adjacent_to(target)
            if adj is not None:
                face_and_use(target)

    return actions

