    import numpy as np
    from collections import deque

    # Reset environment and obtain the current state and world information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # Goal identification
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def bfs_path(start, goal, occupied):
        """Return a list of positions from start (excluded) to goal (included)
        moving only on cells where occupied==False, except the goal cell.
        """
        w, h = occupied.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Allow stepping onto the goal even if occupied
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Map a movement delta to the corresponding action index."""
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise ValueError("Invalid movement delta")

    actions = []
    cur_pos = tuple(state.pos)
    # mutable copy of the grid to keep track of collected primitives
    grid = state.grid.copy()

    # ------------------------------------------------------------------
    # 1) Collect all required primitives (handle multiplicities)
    # ------------------------------------------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # locate remaining instances of this primitive
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                break  # nothing left of this kind
            # sort by Manhattan distance from current position
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)   # cells that are currently blocked
            chosen_path = None
            target_cell = None
            for idx in order:
                cand = tuple(locations[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    chosen_path = path
                    target_cell = cand
                    break

            if chosen_path is None:
                # cannot reach any remaining instance; give up on this primitive
                continue

            # follow the path, emitting movement actions
            for step in chosen_path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step

            # pick up the primitive
            actions.append(4)   # USE
            # remove it from the mutable grid so future paths treat the cell as empty
            grid[target_cell[0], target_cell[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            # workshops occupy their cells; we still allow stepping onto the target cell
            occupied_mask = np.any(state.grid, axis=2)
            for idx in order:
                cand = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break

    return actions


    import numpy as np
    from collections import deque

    # Reset the environment and fetch the current state / world info
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # --------------------------------------------------------------
    # Identify goal and its recipe
    # --------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    def bfs_path(start, goal, occupied):
        """Return a list of positions from start (excluded) to goal (included)
        moving only on cells where occupied == False, except the goal cell."""
        w, h = occupied.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Allow stepping onto the goal even if occupied
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # Reconstruct path
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Map a movement delta to the corresponding action index."""
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise ValueError("Invalid movement delta")

    # --------------------------------------------------------------
    # Main plan construction
    # --------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)
    # mutable copy of the grid to keep track of collected primitives
    grid = state.grid.copy()

    # 1) Collect all required primitives (respect multiplicities)
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # Find remaining instances of this primitive
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # No more of this kind left; break out
                break

            # Sort candidates by Manhattan distance from current position
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)  # cells currently occupied
            chosen_path = None
            target_cell = None

            for idx in order:
                cand = tuple(locations[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    chosen_path = path
                    target_cell = cand
                    break

            if chosen_path is None:
                # Could not reach any remaining instance; abort this primitive
                continue

            # Follow the path, emitting movement actions
            for step in chosen_path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)   # USE
            # Mark cell as empty for future path planning
            grid[target_cell[0], target_cell[1], kind_idx] = 0

    # 2) Move to the workshop (if required) and craft the arrow
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops occupy cells)
            for idx in order:
                cand = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # No specific workshop required; craft at current location
        actions.append(4)   # USE

    return actions

