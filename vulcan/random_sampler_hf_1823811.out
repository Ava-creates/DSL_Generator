    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Helper: compute blocked cells (non‑grabbable entities)
    # ------------------------------------------------------------------
    def compute_blocked(g: np.ndarray) -> np.ndarray:
        blocked = np.zeros(g.shape[:2], dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= (g[:, :, idx] > 0)
        return blocked

    # ------------------------------------------------------------------
    # Helper: BFS shortest path avoiding blocked cells.
    # Returns a list of movement actions that lead from start to any cell
    # in the target set. If start is already in targets, returns [].
    # ------------------------------------------------------------------
    def bfs_path(start: tuple[int, int],
                 targets: set[tuple[int, int]],
                 blocked: np.ndarray) -> list[int]:
        if start in targets:
            return []
        W, H = blocked.shape
        q = deque()
        q.append((start[0], start[1], []))
        visited = np.full((W, H), False, dtype=bool)
        visited[start[0], start[1]] = True
        moves = [(DOWN, (0, 1)),
                 (UP,   (0, -1)),
                 (LEFT, (-1, 0)),
                 (RIGHT,(1, 0))]
        while q:
            x, y, path = q.popleft()
            for act, (dx, dy) in moves:
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:
                    new_path = path + [act]
                    if (nx, ny) in targets:
                        return new_path
                    visited[nx, ny] = True
                    q.append((nx, ny, new_path))
        return []   # unreachable

    # ------------------------------------------------------------------
    # 1. Collect all required primitive resources
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)
    for kind_idx, needed in primitives_needed.items():
        for _ in range(needed):
            # locate remaining instances of this primitive
            positions = np.argwhere(grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                break  # none left on the map
            blocked = compute_blocked(grid)
            target_set = {tuple(p) for p in positions.tolist()}
            path = bfs_path(tuple(cur_pos), target_set, blocked)
            if not path:
                break  # cannot reach any remaining instance
            # move to the primitive
            actions.extend(path)
            for a in path:
                if a == DOWN:
                    cur_pos[1] += 1
                elif a == UP:
                    cur_pos[1] -= 1
                elif a == LEFT:
                    cur_pos[0] -= 1
                elif a == RIGHT:
                    cur_pos[0] += 1
            # pick it up
            actions.append(USE)
            # simulate removal from the grid
            grid[cur_pos[0], cur_pos[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the appropriate workshop (if any) and craft
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
        if ws_positions.size > 0:
            blocked = compute_blocked(grid)
            ws_set = {tuple(p) for p in ws_positions.tolist()}
            ws_path = bfs_path(tuple(cur_pos), ws_set, blocked)
            if ws_path:
                actions.extend(ws_path)
                for a in ws_path:
                    if a == DOWN:
                        cur_pos[1] += 1
                    elif a == UP:
                        cur_pos[1] -= 1
                    elif a == LEFT:
                        cur_pos[0] -= 1
                    elif a == RIGHT:
                        cur_pos[0] += 1
    # final USE to trigger crafting
    actions.append(USE)

    return actions


    # Ensure the environment is in a fresh state.
    try:
        env.reset()
    except Exception:
        pass

    # ------------------------------------------------------------------
    # Determine the goal item index (the item we need to craft).
    # ------------------------------------------------------------------
    goal_idx = None
    task = getattr(env, "task", None)
    if task is not None:
        goal_idx = getattr(task, "goal", None)
        if goal_idx is None and isinstance(task, (list, tuple)):
            goal_idx = task[0]
    if goal_idx is None:
        # Fallback to the name "arrow" if the task does not expose the goal.
        try:
            goal_idx = env.world.cookbook.index["arrow"]
        except Exception:
            return []

    # ------------------------------------------------------------------
    # Action mapping (may differ between environments).
    # ------------------------------------------------------------------
    spec = env.action_specs()
    DOWN = spec.get("DOWN", 0)
    UP = spec.get("UP", 1)
    LEFT = spec.get("LEFT", 2)
    RIGHT = spec.get("RIGHT", 3)
    USE = spec.get("USE", 4)

    # ------------------------------------------------------------------
    # Helper to generate Manhattan moves from the current mutable position
    # to a target cell, updating the mutable position as we go.
    # ------------------------------------------------------------------
    cur_pos = list(env._current_state.pos)  # [x, y]

    def move_to(target):
        tx, ty = target
        moves = []
        while cur_pos[0] < tx:
            moves.append(RIGHT)
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            moves.append(LEFT)
            cur_pos[0] -= 1
        while cur_pos[1] < ty:
            moves.append(DOWN)
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            moves.append(UP)
            cur_pos[1] -= 1
        return moves

    # ------------------------------------------------------------------
    # Work on a local copy of the grid so we can simulate pickups.
    # ------------------------------------------------------------------
    import numpy as np
    grid = env._current_state.grid.copy()

    plan = []

    # ------------------------------------------------------------------
    # 1. Collect all primitive resources required for the goal item.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)
    for kind_idx, count_needed in primitives_needed.items():
        remaining = count_needed
        while remaining > 0:
            # Locate all cells that currently contain this primitive.
            positions = np.argwhere(grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                # No more of this primitive on the map – abort collection for this kind.
                break

            # Choose the nearest instance (Manhattan distance).
            dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])
            nearest = int(dists.argmin())
            target = tuple(positions[nearest])

            # Move to the primitive and pick it up.
            plan.extend(move_to(target))
            plan.append(USE)

            # Simulate the pickup in the local grid copy.
            grid[target[0], target[1], kind_idx] = 0
            remaining -= 1

    # ------------------------------------------------------------------
    # 2. Go to the appropriate workshop (if any) and craft the item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
        if ws_positions.size > 0:
            dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])
            nearest_ws = int(dists.argmin())
            ws_target = tuple(ws_positions[nearest_ws])
            plan.extend(move_to(ws_target))

    # Final USE action to trigger crafting at the current location (or workshop).
    plan.append(USE)

    return plan

