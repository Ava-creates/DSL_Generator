    # Reset the environment to obtain the initial state.
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    cookbook = world.cookbook

    # Goal item index (the arrow) is stored in the task specification.
    goal_idx = env.task.goal

    # Determine the primitive resources required to craft the goal.
    # primitives_for returns a dict {primitive_idx: count}.
    needed = dict(cookbook.primitives_for(goal_idx))

    actions = []
    # Keep a mutable copy of the agent position.
    pos = list(state.pos)                # [x, y]

    # Helper to move the agent to a target (x, y) using Manhattan moves.
    def move_to(target):
        tx, ty = target
        while pos[0] < tx:
            actions.append(3)            # RIGHT
            pos[0] += 1
        while pos[0] > tx:
            actions.append(2)            # LEFT
            pos[0] -= 1
        while pos[1] < ty:
            actions.append(0)            # DOWN
            pos[1] += 1
        while pos[1] > ty:
            actions.append(1)            # UP
            pos[1] -= 1

    # Helper to find an empty neighbour (including the cell itself) of a given location.
    def find_adjacent_empty(grid, x, y):
        h, w, _ = grid.shape
        # Try the cell itself first (in case the item has been collected already).
        if grid[x, y].sum() == 0:
            return (x, y)
        for dx in (0, 1, -1):
            for dy in (0, 1, -1):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and grid[nx, ny].sum() == 0:
                    return (nx, ny)
        # Fallback: return the original location.
        return (x, y)

    grid = state.grid.copy()

    # Collect each required primitive the necessary number of times.
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # Locate the first occurrence of this primitive.
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if len(locations) == 0:
                # No more instances left; break out.
                break
            px, py = locations[0]

            # Move to an empty cell adjacent to the primitive.
            target = find_adjacent_empty(grid, px, py)
            move_to(target)

            # Use action to pick up the primitive.
            actions.append(4)            # USE
            # Simulate the pickup locally so we don't try to collect the same item again.
            grid[px, py, prim_idx] = 0

    # After gathering primitives, go to the appropriate workshop to craft the arrow.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get('_at')
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if len(workshop_cells) > 0:
            wx, wy = workshop_cells[0]
            target = find_adjacent_empty(state.grid, wx, wy)
            move_to(target)
            actions.append(4)            # USE to craft at the workshop

    return actions


    # Access current state and world information
    state = env._current_state if hasattr(env, "_current_state") else env.current_state
    world = env.world
    cookbook = world.cookbook

    # Goal index (the item we need to craft)
    goal_idx = env.task.goal

    # Primitive requirements for the goal (primitive_kind -> count)
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Simulation copies that we will update while planning
    grid = np.copy(state.grid)
    inventory = np.copy(state.inventory)
    pos = tuple(state.pos)          # (x, y)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    # Action indices (as used by the environment)
    ACTION_USE = 4
    ACTIONS_MOVE = [(0, 1),   # DOWN
                    (0, -1),  # UP
                    (-1, 0),  # LEFT
                    (1, 0)]   # RIGHT

    from collections import deque

    def bfs(start, targets, allow_target=False):
        """Bread‑first search returning a list of positions from start to a
        cell in *targets*.  If *allow_target* is True the target cells are
        considered traversable even if they contain an entity."""
        w, h = grid.shape[:2]
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        dq = deque([start])
        visited[start] = True
        while dq:
            x, y = dq.popleft()
            if (x, y) in targets:
                # Reconstruct path
                path = [(x, y)]
                while (x, y) != start:
                    x, y = prev[(x, y)]
                    path.append((x, y))
                path.reverse()
                return path
            for dx, dy in ACTIONS_MOVE:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    blocked = grid[nx, ny, :].sum() > 0
                    if blocked and not (allow_target and (nx, ny) in targets):
                        continue
                    visited[nx, ny] = True
                    prev[(nx, ny)] = (x, y)
                    dq.append((nx, ny))
        return None

    def path_to_actions(path):
        """Convert a list of positions into a list of movement actions."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            dx, dy = x1 - x0, y1 - y0
            for idx, (mx, my) in enumerate(ACTIONS_MOVE):
                if (dx, dy) == (mx, my):
                    acts.append(idx)
                    break
        return acts

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    action_plan = []
    for prim_idx, needed in primitives_needed.items():
        while inventory[prim_idx] < needed:
            # Locate all remaining instances of this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                raise RuntimeError("Required primitive not found on the map.")
            # Choose the closest one (Manhattan distance)
            dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]
            target = locations[int(np.argmin(dists))]

            # Find a path to the target cell (allow stepping on it for collection)
            path = bfs(pos, {target}, allow_target=True)
            if path is None:
                raise RuntimeError("No reachable path to required primitive.")
            action_plan.extend(path_to_actions(path))
            # Use action to pick up the primitive
            action_plan.append(ACTION_USE)

            # Update simulated world state
            grid[target[0], target[1], prim_idx] -= 1
            inventory[prim_idx] += 1
            pos = target

    # ------------------------------------------------------------------
    # Move to the appropriate workshop and craft the goal item
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at", None)

    if workshop_idx is not None:
        # Find any workshop of the required type
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if not workshop_cells:
            raise RuntimeError("Required workshop not present on the map.")
        dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in workshop_cells]
        workshop_target = workshop_cells[int(np.argmin(dists))]

        path = bfs(pos, {workshop_target}, allow_target=True)
        if path is None:
            raise RuntimeError("Cannot reach the workshop.")
        action_plan.extend(path_to_actions(path))
        action_plan.append(ACTION_USE)   # craft at the workshop

        # Simulate crafting (remove primitives – already accounted – and add goal)
        inventory[goal_idx] += 1
        pos = workshop_target

    # Return the complete sequence of actions
    return action_plan

