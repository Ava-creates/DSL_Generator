    # action indices (match CraftWorld's definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _grid():
        """Current grid view."""
        return env._current_state.grid

    def _width_height():
        g = _grid()
        return g.shape[0], g.shape[1]

    def _is_walkable(pos, goal=None):
        """A cell is walkable if it is empty or it is the goal cell."""
        x, y = pos
        if goal is not None and pos == goal:
            return True
        # any non‑zero in the kind dimension means occupied
        return not _grid()[x, y, :].any()

    def _bfs_path(start, goal):
        """Return a list of positions from start to goal using BFS."""
        if start == goal:
            return [start]
        w, h = _width_height()
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(nxt, goal):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            # No path found
            return None

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Convert a list of positions (including start) to action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst):
        """Return actions to move from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(src, dst)
        if path is None:
            # fall back to naive Manhattan moves (may collide with obstacles)
            return _manhattan_actions(src, dst)
        return _actions_from_path(path)

    def _manhattan_actions(src, dst):
        """Simple Manhattan moves ignoring obstacles (fallback)."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_kind(pos, kind_idx):
        """Find the nearest cell (Manhattan distance) that currently contains kind_idx."""
        grid = _grid()
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Determine goal item and required primitives
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    needed_prims = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # Primitive not present – abort planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)  # pick up primitive

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)  # craft at workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    world = env.world

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    def _manhattan_actions(src, dst):
        """Simple Manhattan moves (ignores obstacles)."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _bfs_path(start, goal, grid):
        """Return a list of positions from start to goal using BFS."""
        if start == goal:
            return [start]
        width, height = grid.shape[:2]
        from collections import deque
        frontier = deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt in came_from:
                        continue
                    # treat the goal cell as walkable even if occupied
                    if (grid[nx, ny, :].any() and nxt != goal):
                        continue
                    came_from[nxt] = cur
                    frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Convert a list of positions (including start) to action indices."""
        if not path or len(path) < 2:
            return []
        act = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                act.append(DOWN)
            elif x1 == x0 - 1:
                act.append(UP)
            elif y1 == y0 + 1:
                act.append(RIGHT)
            elif y1 == y0 - 1:
                act.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return act

    def _move_actions(src, dst, grid):
        """Move from src to dst using BFS; fall back to Manhattan if blocked."""
        path = _bfs_path(src, dst, grid)
        if path is None:
            return _manhattan_actions(src, dst)
        return _actions_from_path(path)

    # --------------------------------------------------------------
    # 1. Determine required primitives for the target item (arrow)
    # --------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # --------------------------------------------------------------
    # 2. Collect all required primitives
    # --------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    grid = env._current_state.grid.copy()   # mutable copy for planning

    for prim_idx, count in needed.items():
        for _ in range(count):
            # locate nearest instance of this primitive (Manhattan distance)
            cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # primitive not present – abort planning
                return actions
            dists = np.abs(cells[:, 0] - cur_pos[0]) + np.abs(cells[:, 1] - cur_pos[1])
            target = tuple(cells[dists.argmin()].tolist())

            # move to the primitive and pick it up
            actions += _move_actions(cur_pos, target, grid)
            cur_pos = target
            actions.append(USE)

            # remove it from the planning grid so we don't reuse it
            grid[target[0], target[1], prim_idx] = 0

    # --------------------------------------------------------------
    # 3. Move to the workshop (if any) and craft the arrow
    # --------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if cells.size > 0:
            dists = np.abs(cells[:, 0] - cur_pos[0]) + np.abs(cells[:, 1] - cur_pos[1])
            workshop_pos = tuple(cells[dists.argmin()].tolist())
            actions += _move_actions(cur_pos, workshop_pos, grid)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

