    # ------------------------------------------------------------------
    # Action constants (as defined by the environment)
    # ------------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: breadth‑first search returning a list of actions that moves
    # the agent from `start` to `goal` while staying on empty cells.
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_path(start, goal):
        """Return a list of actions to reach `goal` from `start`."""
        h, w, _ = state.grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == goal:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # The goal cell may be occupied (e.g., a primitive);
                    # we allow stepping onto it only when it is the target.
                    if not state.grid[ny, nx, :].any() or (ny, nx) == goal:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Helper: move the agent to an absolute position using bfs_path.
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # cannot reach target
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell that contains an entity of kind `k`.
    # ------------------------------------------------------------------
    def find_nearest(k):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, k] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: return a free cell (including the target itself) that is
    # orthogonally or diagonally adjacent to `cell`. Returns None if none.
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the cell itself if it is free.
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # 1) Collect all primitive resources required for the arrow.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, needed in primitives_needed.items():
        for _ in range(needed):
            src = find_nearest(kind_idx)
            if src is None:
                continue  # primitive missing from world
            adj = adjacent_free(src)
            if adj is None:
                continue  # no free neighbour to stand on
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # 2) If the recipe specifies a workshop, go there and craft the arrow.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            if adj:
                move_to(adj)
                actions.append(ACT_USE)
                env.step(ACT_USE)
                state = env._current_state

    # Return the compiled action sequence.
    return actions

