    # Reset the environment to get the initial observation and state.
    obs = env.reset()
    import re
    import numpy as np

    # Parse the task name to obtain the goal item (e.g., "make[arrow]").
    task_name = obs.get("task_name", "")
    m = re.search(r"make\[(\w+)\]", task_name)
    if not m:
        return []  # could not determine goal
    goal_name = m.group(1)

    # Resolve goal index, required primitives, and workshop location from the cookbook.
    cookbook = env.world.cookbook
    goal_idx = cookbook.index[goal_name]
    primitive_reqs = cookbook.primitives_for(goal_idx)          # {prim_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    workshop_idx = cookbook.index[workshop_name] if workshop_name else None

    # Helper to move the agent towards a target cell (x, y) using Manhattan steps.
    def move_to(target):
        nonlocal actions, steps, state
        while state.pos != target and steps < max_steps:
            px, py = state.pos
            tx, ty = target
            if px < tx:
                act = 3          # RIGHT
            elif px > tx:
                act = 2          # LEFT
            elif py < ty:
                act = 0          # DOWN
            elif py > ty:
                act = 1          # UP
            else:
                break
            actions.append(act)
            _, done, _ = env.step(act)
            state = env._current_state
            steps += 1
            if done:
                break

    actions = []
    steps = 0
    max_steps = 2000                     # safety limit
    state = env._current_state           # current CraftState

    # -------------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # -------------------------------------------------------------------------
    for prim_idx, needed in primitive_reqs.items():
        for _ in range(needed):
            # Locate a cell that currently contains the primitive.
            locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # No more of this primitive on the map – abort.
                break
            # Choose the first discovered location.
            prim_cell = (int(locations[0][0]), int(locations[0][1]))
            # Move to that cell (standing on it is allowed in CraftWorld).
            move_to(prim_cell)
            # Use the item (action 4) to pick it up.
            actions.append(4)               # USE
            _, done, _ = env.step(4)
            state = env._current_state
            steps += 1
            if done:
                break

    # -------------------------------------------------------------------------
    # 2) Go to the required workshop and perform the crafting action.
    # -------------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_locs.size > 0:
            workshop_cell = (int(workshop_locs[0][0]), int(workshop_locs[0][1]))
            move_to(workshop_cell)
            # Use the workshop to craft the goal item.
            actions.append(4)               # USE (craft)
            _, done, _ = env.step(4)
            state = env._current_state
            steps += 1

    return actions


    # Helper utilities
    dirs = [(1, 0), (-1, 0), (0, -1), (0, 1)]          # DOWN, UP, LEFT, RIGHT
    dir_to_action = {(1, 0): 0, (-1, 0): 1, (0, -1): 2, (0, 1): 3}
    H, W = env._current_state.grid.shape[:2]

    def in_bounds(p):
        x, y = p
        return 0 <= x < H and 0 <= y < W

    def occupied(grid):
        return grid.sum(axis=2) > 0

    occ = occupied(env._current_state.grid)

    # BFS to a target cell (must be free)
    def bfs(start, goal):
        q = collections.deque()
        q.append(start)
        prev = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            for d in dirs:
                nx, ny = cur[0] + d[0], cur[1] + d[1]
                if not in_bounds((nx, ny)):
                    continue
                if occ[nx, ny]:
                    continue
                nxt = (nx, ny)
                if nxt not in prev:
                    prev[nxt] = cur
                    q.append(nxt)
        # reconstruct path
        if goal not in prev:
            return []  # unreachable
        path = []
        cur = goal
        while prev[cur] is not None:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    # Translate a step from p->n into an action (movement)
    def step_action(p, n):
        dx, dy = n[0] - p[0], n[1] - p[1]
        return dir_to_action[(dx, dy)]

    actions = []
    state = env._current_state
    goal_idx = env.task.goal

    # --- 1. Gather required primitives ---------------------------------
    primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind, needed in primitives.items():
        while state.inventory[kind] < needed:
            # locate any cell that still contains this primitive
            prim_cells = np.argwhere(state.grid[:, :, kind] > 0)
            if prim_cells.size == 0:
                raise RuntimeError("Required primitive not found in grid")
            # pick the first one (could improve with nearest)
            tx, ty = prim_cells[0]

            # find a free neighbour of the primitive cell
            neighbour = None
            for d in dirs:
                nx, ny = tx + d[0], ty + d[1]
                if in_bounds((nx, ny)) and not occ[nx, ny]:
                    neighbour = (nx, ny)
                    break
            if neighbour is None:
                raise RuntimeError("No free neighbour to reach primitive")

            # path to the neighbour
            path = bfs(state.pos, neighbour)
            for step in path:
                act = step_action(state.pos, step)
                actions.append(act)
                reward, state = env.step(act)
            # now adjacent; turn towards the primitive (blocked move)
            face_dir = (tx - state.pos[0], ty - state.pos[1])
            turn_act = dir_to_action[face_dir]
            actions.append(turn_act)          # blocked move just sets direction
            reward, state = env.step(turn_act)
            # collect
            actions.append(4)                 # USE
            reward, state = env.step(4)

    # --- 2. Move to workshop and craft ---------------------------------
    recipe = env.world.cookbook.recipes[goal_idx]
    workshop_kind = recipe["_at"]
    # locate any workshop cell
    workshop_cells = np.argwhere(state.grid[:, :, workshop_kind] > 0)
    if workshop_cells.size == 0:
        raise RuntimeError("Workshop not found")
    wx, wy = workshop_cells[0]

    # find free neighbour
    work_neighbour = None
    for d in dirs:
        nx, ny = wx + d[0], wy + d[1]
        if in_bounds((nx, ny)) and not occ[nx, ny]:
            work_neighbour = (nx, ny)
            break
    if work_neighbour is None:
        raise RuntimeError("No free neighbour to reach workshop")

    path = bfs(state.pos, work_neighbour)
    for step in path:
        act = step_action(state.pos, step)
        actions.append(act)
        reward, state = env.step(act)

    # face workshop and craft
    face_dir = (wx - state.pos[0], wy - state.pos[1])
    turn_act = dir_to_action[face_dir]
    actions.append(turn_act)
    reward, state = env.step(turn_act)
    actions.append(4)          # USE to craft
    reward, state = env.step(4)

    # return the compiled action list
    return actions

