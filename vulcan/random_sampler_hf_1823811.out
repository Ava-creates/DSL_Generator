    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    cookbook = world.cookbook

    # index of the target item (arrow) and its primitive requirements
    goal_idx = cookbook.index.index('arrow')
    primitives_needed = cookbook.primitives_for(goal_idx)

    actions = []
    cur_pos = env._current_state.pos
    # work on a local copy of the grid so we can “remove” collected items
    grid = env._current_state.grid.copy()

    def _move_actions(src, dst):
        """Manhattan moves from src to dst (ignores obstacles)."""
        x, y = src
        tx, ty = dst
        acts = []
        if tx > x:
            acts += [DOWN] * (tx - x)
        elif tx < x:
            acts += [UP] * (x - tx)
        if ty > y:
            acts += [RIGHT] * (ty - y)
        elif ty < y:
            acts += [LEFT] * (y - ty)
        return acts

    def _nearest(pos, kind_idx):
        """Return coordinates of the nearest cell containing `kind_idx`."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest_idx = int(dists.argmin())
        return tuple(locations[nearest_idx].tolist())

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest(cur_pos, prim_idx)
            if target is None:
                # primitive not found – abort planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)          # pick up the primitive
            grid[target[0], target[1], prim_idx] = 0  # mark as collected

    # ------------------------------------------------------------------
    # 2. Move to the workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = cookbook.recipes[goal_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = cookbook.index.index(workshop_name)
        workshop_pos = _nearest(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)          # craft at the workshop

    return actions


    import numpy as np

    # Action indices (as defined in CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Return a list of movement actions (Manhattan) from src to dst."""
        actions = []
        x, y = src
        tx, ty = dst
        # vertical moves
        if tx > x:
            actions += [DOWN] * (tx - x)
        elif tx < x:
            actions += [UP] * (x - tx)
        # horizontal moves
        if ty > y:
            actions += [RIGHT] * (ty - y)
        elif ty < y:
            actions += [LEFT] * (y - ty)
        return actions

    def _nearest_kind(pos, kind_idx, grid):
        """Find the coordinates of the nearest cell containing kind_idx."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        # Manhattan distance
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = locations[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    # ------------------------------------------------------------------
    # 1. Identify goal (arrow) and required primitives
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    goal_name = "arrow"
    goal_idx = cookbook.index.index(goal_name)

    # Mapping primitive kind index -> required count for a single arrow
    primitives_needed = cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # 2. Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    # Work on a local copy of the grid so we can "remove" collected items
    grid = env._current_state.grid.copy()

    for prim_idx, qty in primitives_needed.items():
        for _ in range(qty):
            target = _nearest_kind(cur_pos, prim_idx, grid)
            if target is None:
                # Primitive not present; abort planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)          # pick up the primitive
            # Remove the primitive from the local grid copy
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop (if required) and craft
    # ------------------------------------------------------------------
    workshop_name = cookbook.recipes.get(goal_idx, {}).get('_at')
    if workshop_name is not None:
        workshop_idx = cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)          # craft the arrow at the workshop

    return actions

