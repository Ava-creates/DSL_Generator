    # ----------------------------------------------------------------------
    # Helper: generate Manhattan move actions from start to target.
    # Action order: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    # ----------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ----------------------------------------------------------------------
    # Helper: locate the nearest cell that still contains at least one of `kind`.
    # Returns None if no such cell exists.
    # ----------------------------------------------------------------------
    def nearest_cell(kind, from_pos):
        cells = np.argwhere(mutable_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # ----------------------------------------------------------------------
    # Collect all required primitive items.
    # ----------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # Primitive not present on the map – cannot collect further.
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)                     # USE to pick up
            # Mark the primitive as taken so we don't target it again.
            mutable_grid[target[0], target[1], kind] = 0

    # ----------------------------------------------------------------------
    # Move to the workshop (if required) and craft the final item.
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)                     # USE to craft at workshop
    else:
        # No specific workshop: just USE at current location to craft.
        actions.append(4)

    return actions

