    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Gather recipe information for the target item “arrow”
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _cell_occupied(pos, grid):
        """True if any entity occupies the cell at `pos`."""
        x, y = pos
        return grid[x, y, :].any()

    def _bfs_path(start, goal, grid):
        """Shortest path (list of positions) from start to goal.
        Goal may be occupied (e.g., a workshop). Returns None if no path."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        # allow stepping onto goal even if occupied
                        if not _cell_occupied(nxt, grid) or nxt == goal:
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate consecutive positions into action indices."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, grid):
        """Return actions moving from src to dst (BFS preferred, fallback to Manhattan)."""
        path = _bfs_path(src, dst, grid)
        if path is None:
            # Manhattan fallback (may collide with obstacles)
            acts = []
            x, y = src
            tx, ty = dst
            if tx > x:
                acts += [DOWN] * (tx - x)
            elif tx < x:
                acts += [UP] * (x - tx)
            if ty > y:
                acts += [RIGHT] * (ty - y)
            elif ty < y:
                acts += [LEFT] * (y - ty)
            return acts
        return _actions_from_path(path)

    def _nearest_entity(pos, kind_idx, grid, excluded):
        """Find nearest cell containing `kind_idx` not in `excluded`."""
        candidates = np.argwhere(grid[:, :, kind_idx] > 0)
        if candidates.size == 0:
            return None
        if excluded:
            mask = np.array([tuple(c) not in excluded for c in candidates])
            candidates = candidates[mask]
            if candidates.size == 0:
                return None
        dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
        nearest = candidates[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Planning: collect required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    # copy of grid to simulate picking up items
    sim_grid = env._current_state.grid.copy()
    harvested = {}  # kind_idx -> set of positions already taken

    for prim_idx, count in primitives_needed.items():
        harvested.setdefault(prim_idx, set())
        for _ in range(count):
            target = _nearest_entity(cur_pos, prim_idx, sim_grid, harvested[prim_idx])
            if target is None:
                # primitive not available; abort planning
                return actions
            actions += _move_actions(cur_pos, target, sim_grid)
            cur_pos = target
            actions.append(USE)  # pick up primitive
            # simulate removal of the primitive from the grid
            sim_grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            harvested[prim_idx].add(cur_pos)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_pos = _nearest_entity(cur_pos, workshop_idx, sim_grid, set())
        if ws_pos is not None:
            actions += _move_actions(cur_pos, ws_pos, sim_grid)
            cur_pos = ws_pos
            actions.append(USE)  # craft at workshop

    return actions


    # code body

