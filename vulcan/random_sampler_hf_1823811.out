    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) positions where `kind` is present."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """Return a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) moving from start to target,
        avoiding occupied cells (except the target cell)."""
        occ = np.any(state.grid > 0, axis=2)          # blocked cells
        occ[target] = False                           # allow stepping onto target
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # no path

    def go_to(target):
        """Move agent from current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1. Collect all required primitives.
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Primitive missing; abort early.
                return actions
            # Choose the nearest reachable primitive.
            positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            for target in positions:
                path = bfs_path(state.pos, target)
                if path:
                    go_to(target)
                    actions.append(4)          # USE to pick up
                    _, state = state.step(4)
                    break
            else:
                # No reachable instance of this primitive.
                return actions

    # 2. Go to workshop (if required) and craft the goal.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if not ws_positions:
            # No workshop found; abort.
            return actions
        ws_positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
        go_to(ws_positions[0])
    # Craft / use at current location.
    actions.append(4)          # USE to trigger crafting
    _, state = state.step(4)

    return actions


    import numpy as np
    from collections import deque

    # Initialise the episode.
