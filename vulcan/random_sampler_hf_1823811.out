    import numpy as np
    from collections import deque

    # Action indices (as defined in CraftLab.action_specs)
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    ACTIONS = {
        (0, 1): ACTION_DOWN,
        (0, -1): ACTION_UP,
        (-1, 0): ACTION_LEFT,
        (1, 0): ACTION_RIGHT,
    }

    # -------------------------------------------------------------------------
    # Helper: compute Manhattan distance
    def manhattan(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    # Helper: given current position and a target cell, return the direction
    # (dx, dy) needed to face the target (orthogonal neighbours only)
    def direction_to(src, dst):
        dx = dst[0] - src[0]
        dy = dst[1] - src[1]
        if dx > 0:
            return (1, 0)
        if dx < 0:
            return (-1, 0)
        if dy > 0:
            return (0, 1)
        if dy < 0:
            return (0, -1)
        return (0, 0)  # same cell (should not happen)

    # Helper: BFS that returns a list of actions moving from start to any
    # orthogonal neighbour of target that is free (i.e. not blocked).
    def bfs_to_adjacent(start, target, grid):
        width, height, _ = grid.shape
        # cells that are occupied by any kind (including primitives, workshops,
        # water, stone, etc.) are considered blocked for movement.
        blocked = np.any(grid > 0, axis=2)

        # Determine all free cells that are orthogonal neighbours of the target.
        neighbours = []
        for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
            nx, ny = target[0] + dx, target[1] + dy
            if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                neighbours.append((nx, ny))

        # If we are already on a valid neighbour, no movement needed.
        if start in neighbours:
            return []

        # BFS over free cells.
        q = deque()
        q.append((start, []))
        visited = set()
        visited.add(start)

        while q:
            (x, y), path = q.popleft()
            for (dx, dy), act in [((0, 1), ACTION_DOWN),
                                  ((0, -1), ACTION_UP),
                                  ((-1, 0), ACTION_LEFT),
                                  ((1, 0), ACTION_RIGHT)]:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                if blocked[nx, ny]:
                    continue
                if (nx, ny) in visited:
                    continue
                new_path = path + [act]
                if (nx, ny) in neighbours:
                    return new_path
                visited.add((nx, ny))
                q.append(((nx, ny), new_path))

        # If no path found (should not happen in well‑formed scenarios), return empty.
        return []

    # -------------------------------------------------------------------------
    # Reset the environment to obtain a fresh state.
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world                    # CraftWorld instance
    cookbook = world.cookbook

    # Goal: make an arrow.
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for one arrow.
    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    # Workshop needed for the recipe (may be None).
    workshop_idx = None
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = cookbook.index[workshop_name]

    plan_actions = []   # final list of actions to return

    # -------------------------------------------------------------------------
    # Function to execute a list of actions on the internal state (so we keep
    # the simulated state in sync with the actions we record).
    def apply_actions(action_list):
        nonlocal state
        for a in action_list:
            _, new_state = state.step(a)
            state = new_state

    # -------------------------------------------------------------------------
    # Collect all required primitives.
    while True:
        # Determine which primitives are still missing.
        missing = {}
        for p_idx, need_cnt in primitive_needs.items():
            have = int(state.inventory[p_idx])
            if have < need_cnt:
                missing[p_idx] = need_cnt - have

        if not missing:
            break   # all primitives gathered

        # Pick the first missing primitive (simple greedy choice).
        p_idx, _ = next(iter(missing.items()))

        # Locate any instance of this primitive on the grid.
        grid = state.grid
        locations = np.argwhere(grid[:, :, p_idx] > 0)
        if locations.shape[0] == 0:
            # No more of this primitive on the map – cannot continue.
            break

        # Choose the nearest instance (Manhattan distance).
        cur_pos = state.pos
        dists = np.apply_along_axis(lambda loc: manhattan(cur_pos, (loc[0], loc[1])),
                                    1, locations)
        target_cell = tuple(locations[dists.argmin()])

        # Move to a free neighbour of the target cell.
        move_actions = bfs_to_adjacent(cur_pos, target_cell, grid)
        plan_actions.extend(move_actions)
        apply_actions(move_actions)

        # After arriving, face the primitive and use the USE action.
        # Determine direction needed to face the primitive.
        face_dir = direction_to(state.pos, target_cell)
        if face_dir != (0, 0):
            # Ensure the agent's direction matches the needed one.
            # The environment automatically sets direction to the last movement
            # direction, so we may need a small corrective move.
            # We simply perform a dummy move in the required direction and then
            # step back (if the forward cell is free). This keeps us adjacent.
            dx, dy = face_dir
            # Attempt a forward move; if blocked, skip the correction.
            forward_pos = (state.pos[0] + dx, state.pos[1] + dy)
            if (0 <= forward_pos[0] < grid.shape[0] and
                0 <= forward_pos[1] < grid.shape[1] and
                not np.any(grid[forward_pos[0], forward_pos[1], :] > 0)):
                corr_action = ACTIONS[(dx, dy)]
                plan_actions.append(corr_action)
                apply_actions([corr_action])
                # Step back to original cell.
                back_action = ACTIONS[(-dx, -dy)]
                plan_actions.append(back_action)
                apply_actions([back_action])

        # Finally, collect the primitive.
        plan_actions.append(ACTION_USE)
        _, new_state = state.step(ACTION_USE)
        state = new_state

    # -------------------------------------------------------------------------
    # If a workshop is required for the final crafting step, go there and use.
    if workshop_idx is not None:
        grid = state.grid
        workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] > 0:
            workshop_cell = tuple(workshop_cells[0])

            # Move adjacent to the workshop.
            move_actions = bfs_to_adjacent(state.pos, workshop_cell, grid)
            plan_actions.extend(move_actions)
            apply_actions(move_actions)

            # Face the workshop (same correction logic as above).
            face_dir = direction_to(state.pos, workshop_cell)
            if face_dir != (0, 0):
                dx, dy = face_dir
                forward_pos = (state.pos[0] + dx, state.pos[1] + dy)
                if (0 <= forward_pos[0] < grid.shape[0] and
                    0 <= forward_pos[1] < grid.shape[1] and
                    not np.any(grid[forward_pos[0], forward_pos[1], :] > 0)):
                    corr_action = ACTIONS[(dx, dy)]
                    plan_actions.append(corr_action)
                    apply_actions([corr_action])
                    back_action = ACTIONS[(-dx, -dy)]
                    plan_actions.append(back_action)
                    apply_actions([back_action])

            # Use the workshop to craft the arrow.
            plan_actions.append(ACTION_USE)
            _, new_state = state.step(ACTION_USE)
            state = new_state

    # Return the complete action sequence.
    return plan_actions

