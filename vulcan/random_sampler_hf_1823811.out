    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # mutable copy of the initial grid to keep track of collected primitives
    mutable_grid = scenario.init_grid.copy()

    actions = []
    cur_pos = tuple(state.pos)  # (x, y)

    def moves_to(start, target):
        """Return Manhattan move actions from start to target."""
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)  # RIGHT
            x += 1
        while x > tx:
            seq.append(2)  # LEFT
            x -= 1
        while y < ty:
            seq.append(0)  # DOWN
            y += 1
        while y > ty:
            seq.append(1)  # UP
            y -= 1
        return seq, (x, y)

    def nearest_cell(kind, from_pos):
        """Find nearest cell that still contains at least one of `kind`."""
        cells = np.argwhere(mutable_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # Collect required primitives
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # Primitive not present; skip (cannot be collected)
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            mutable_grid[target[0], target[1], kind] = 0  # mark as taken

    # Move to workshop (if any) and craft
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)  # USE to craft at workshop
    else:
        # No specific workshop required; just USE at current location
        actions.append(4)

    return actions


