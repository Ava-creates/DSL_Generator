    # Reset environment and get current state/world
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Goal item
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive counts needed for one arrow
    primitive_needs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Determine workshop (if any) where the arrow must be crafted
    workshop_idx = None
    recipe = cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # Grid dimensions
    width, height, _ = state.grid.shape

    # Pre‑compute blocked cells (non‑grabbable entities block movement)
    non_grabbable = list(world.non_grabbable_indices)
    if non_grabbable:
        blocked = np.any(state.grid[:, :, non_grabbable] > 0, axis=2)
    else:
        blocked = np.zeros((width, height), dtype=bool)

    # Helper: BFS to find a walkable path and return the list of actions
    from collections import deque

    def bfs_actions(start, goal):
        """Return list of actions (indices) to move from start to goal."""
        if start == goal:
            return []
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            x, y = q.popleft()
            for nx, ny, act in ((x + 1, y, 3), (x - 1, y, 2),
                                (x, y + 1, 0), (x, y - 1, 1)):
                if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:
                    nxt = (nx, ny)
                    if nxt not in visited:
                        visited.add(nxt)
                        parent[nxt] = (x, y, act)
                        if nxt == goal:
                            # reconstruct actions
                            actions_rev = []
                            cur = nxt
                            while cur != start:
                                px, py, a = parent[cur]
                                actions_rev.append(a)
                                cur = (px, py)
                            actions_rev.reverse()
                            return actions_rev
                        q.append(nxt)
        # No path found – return empty list (will likely fail later)
        return []

    # Prepare locations of each primitive kind
    primitive_locations = {}
    for kind_idx in primitive_needs:
        locs = np.argwhere(state.grid[:, :, kind_idx] > 0)
        primitive_locations[kind_idx] = [tuple(p) for p in locs]

    actions = []
    cur_pos = tuple(state.pos)

    # Collect required primitives
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # Choose the nearest remaining location of this kind
            if not primitive_locations[kind_idx]:
                # No more of this primitive on the map – abort early
                break
            dists = [abs(px - cur_pos[0]) + abs(py - cur_pos[1])
                     for (px, py) in primitive_locations[kind_idx]]
            nearest_i = int(np.argmin(dists))
            target = primitive_locations[kind_idx].pop(nearest_i)

            # Move to the primitive and pick it up
            actions += bfs_actions(cur_pos, target)
            cur_pos = target
            actions.append(4)  # USE to pick up

    # Move to workshop (if required) and craft the arrow
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size:
            target = tuple(workshop_cells[0])
            actions += bfs_actions(cur_pos, target)
            cur_pos = target

    # Final USE to craft the arrow (whether at workshop or current cell)
    actions.append(4)

    return actions


    # Reset environment and fetch necessary objects
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Identify goal information
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for a single arrow
    primitive_needs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Determine required workshop (if any)
    workshop_idx = None
    recipe = cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # Action list and current position tracking
    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # Work on a mutable copy of the grid to know which primitives remain
    grid = state.grid.copy()

    # Helper to append Manhattan moves
    def move_to(start, target):
        """Append moves to reach target from start (Manhattan) and return new position."""
        x, y = start
        tx, ty = target
        while x < tx:
            actions.append(3)   # RIGHT
            x += 1
        while x > tx:
            actions.append(2)   # LEFT
            x -= 1
        while y < ty:
            actions.append(0)   # DOWN
            y += 1
        while y > ty:
            actions.append(1)   # UP
            y -= 1
        return (x, y)

    # Collect each required primitive the needed number of times
    for kind_idx, needed in primitive_needs.items():
        while needed > 0:
            # Locate remaining instances of this primitive
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # No more of this primitive on the map; cannot fulfill goal
                break
            # Choose the nearest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            nearest = locations[dists.argmin()]
            target = tuple(nearest)
            # Move to the primitive and pick it up
            cur_pos = move_to(cur_pos, target)
            actions.append(4)   # USE to pick up
            # Mark the primitive as collected in our simulated grid
            grid[target[0], target[1], kind_idx] = 0
            needed -= 1

    # Move to the required workshop (if any) and craft the arrow
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            cur_pos = move_to(cur_pos, tuple(workshop_cells[0]))
    # Final USE action to craft the arrow (either at workshop or current location)
    actions.append(4)

    return actions

