                if (
                    0 <= nr < occupied.shape[0]
                    and 0 <= nc < occupied.shape[1]
                    and not occupied[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Helper: append actions for a list of direction names and update pos
    # ------------------------------------------------------------------
    def follow_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for kind_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # locate remaining instances of this primitive
            cells = list(zip(*np.where(grid[:, :, kind_idx] > 0)))
            if not cells:
                # nothing left – abort early
                break

            # choose the closest by Manhattan distance
            target = min(cells, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))

            # move to an empty neighbour of the primitive
            path = bfs_to_adjacent(cur_pos, target)
            follow_path(path)

            # pick it up
            actions.append(act_map["USE"])

            # update grid/occupancy: primitive disappears
            r, c = target
            grid[r, c, :] = 0
            occupied[r, c] = False

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        # locate a workshop cell (prefer one still present in the mutable grid)
        ws_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not ws_cells:
            # fall back to original scenario grid
            ws_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0)))
        if ws_cells:
            target_ws = ws_cells[0]
            path = bfs_to_adjacent(cur_pos, target_ws)
            follow_path(path)
            actions.append(act_map["USE"])

    return actions


    # Reset the environment to a fresh state.
    env.reset()

    # Mapping from action names (e.g., "DOWN") to integer action codes used by the env.
    act_map = env.action_specs()

    # Direction vectors used for movement.
    moves = [
        ("DOWN", (1, 0)),
        ("UP", (-1, 0)),
        ("RIGHT", (0, 1)),
        ("LEFT", (0, -1)),
    ]
    dir_to_delta = {name: delta for name, delta in moves}

    # ----------------------------------------------------------------------
    # Helper: breadth‑first search that returns a list of action names moving
    # the agent from `start` to any empty cell adjacent to `target`.
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, occupied):
        tr, tc = target
        # All empty neighbours of the target cell.
        adjacent = [
            (tr + dr, tc + dc)
            for _, (dr, dc) in moves
            if 0 <= tr + dr < occupied.shape[0]
            and 0 <= tc + dc < occupied.shape[1]
            and not occupied[tr + dr, tc + dc]
        ]
        if not adjacent:
            return []  # No reachable neighbour.

        from collections import deque

        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in adjacent:
                # Reconstruct the path of action names.
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for name, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occupied.shape[0]
                    and 0 <= nc < occupied.shape[1]
                    and not occupied[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # No path found.

    # ----------------------------------------------------------------------
    # Helper: execute a sequence of direction names, updating `cur_pos`
    # and appending the corresponding integer actions to `actions`.
    # ----------------------------------------------------------------------
    def follow(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ----------------------------------------------------------------------
    # Gather task‑specific information from the environment.
    # ----------------------------------------------------------------------
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal  # integer index of the desired item.

    # Primitive requirements and optional workshop for the goal.
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")

    # Working copies of the grid and a boolean occupancy mask.
    grid = scenario.init_grid.copy()
    occupied = grid.sum(axis=2) > 0  # True where any entity occupies the cell.

    # Current agent state.
    cur_pos = scenario.init_pos  # (row, col)

    # List that will hold the final action sequence.
    actions = []

    # ----------------------------------------------------------------------
    # 1) Collect each required primitive the necessary number of times.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate remaining instances of this primitive.
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more of this primitive left; abort early.
                break

            # Choose the closest instance (Manhattan distance).
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to an empty neighbour of the target cell.
            path = bfs_adjacent(cur_pos, target, occupied)
            follow(path)

            # Pick up the primitive.
            actions.append(act_map["USE"])

            # Update the grid and occupancy mask: the primitive disappears.
            r, c = target
            grid[r, c, :] = 0
            occupied[r, c] = False

    # ----------------------------------------------------------------------
    # 2) If the recipe requires a workshop, move there and craft the item.
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            # Fallback to the original scenario grid if the workshop was removed.
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0))
            )
        if workshop_cells:
            target_ws = workshop_cells[0]  # any workshop will do.
            path = bfs_adjacent(cur_pos, target_ws, occupied)
            follow(path)
            actions.append(act_map["USE"])

    return actions

