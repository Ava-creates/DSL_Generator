    import numpy as np
    from collections import deque

    # Reset environment and get references
    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    index = cookbook.index

    # Resolve action indices
    action_map = env.action_specs()
    DOWN = action_map.get("DOWN", 0)
    UP = action_map.get("UP", 1)
    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    # Goal item
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []
    goal_idx = index[goal_name]

    # Primitive requirements for the goal
    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Movement directions
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    def bfs_path(start, target):
        """Return a list of movement actions from start to target (target may be occupied)."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # No path found
        # Reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    actions = []

    # ------------------------------------------------------------------
    # Phase 1: Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate nearest cell containing this primitive
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # Primitive not present; abort early
                return actions
            dists = np.abs(cells - np.array(state.pos)).sum(axis=1)
            tr, tc = cells[dists.argmin()]

            # Move to the primitive
            move_seq = bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # Phase 2: Move to the appropriate workshop and craft the arrow
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # No workshop information available

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # No workshop present in the grid

    # Choose nearest workshop cell
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]

    # Move to the workshop
    move_seq = bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow
    actions.append(USE)

    return actions


    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    idx = cookbook.index

    # Resolve action indices.
    action_map = env.action_specs()
    DOWN = action_map.get("DOWN", 0)
    UP = action_map.get("UP", 1)
    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []
    goal_idx = idx[goal_name]

    # Primitive requirements for the goal.
    primitive_needs = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}
    actions = []

    from collections import deque

    def bfs_path(start, target):
        """Return list of move actions from start to target (target may be occupied)."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Treat occupied cells as obstacles unless it's the destination.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # No path found.
        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def nearest_cell(start, kind_idx):
        """Find the closest cell containing `kind_idx` using BFS."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Block cells unless they contain the desired kind.
                if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # Reconstruct path to this cell.
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None

    # Phase 1: Collect required primitives.
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            path, cell = nearest_cell(state.pos, prim_idx)
            if cell is None:
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)
            # Update our internal copy of inventory and grid.
            state.inventory[prim_idx] += 1
            state.grid[cell[0], cell[1], prim_idx] = 0

    # Phase 2: Move to the workshop and craft the arrow.
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions
    workshop_idx = idx[workshop_name]
    path, cell = nearest_cell(state.pos, workshop_idx)
    if cell is not None:
        actions.extend(path)
        state.pos = cell
        actions.append(USE)

    return actions

