    # Constants for actions (assume standard ordering)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _grid():
        """Current grid view."""
        return env._current_state.grid

    def _inside(x, y):
        """Check whether (x, y) lies inside the world."""
        w, h, _ = _grid().shape
        return 0 <= x < w and 0 <= y < h

    def _is_walkable(pos, grid):
        """A cell is walkable if it contains no entities."""
        x, y = pos
        return not grid[x, y, :].any()

    def _bfs_path(start, goal, grid):
        """Breadth‑first search returning a list of positions from start to goal (inclusive)."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(nxt, grid):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of positions into action indices."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _nearest_cell(pos, kind_idx, grid):
        """Find the nearest cell (Manhattan) that contains the given kind."""
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    def _adjacent_walkable(target, start, grid):
        """Return walkable neighbour of target together with path from start."""
        w, h = grid.shape[:2]
        candidates = []
        tx, ty = target
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nx, ny = tx + dx, ty + dy
            if 0 <= nx < w and 0 <= ny < h and _is_walkable((nx, ny), grid):
                path = _bfs_path(start, (nx, ny), grid)
                if path is not None:
                    candidates.append(((nx, ny), path))
        if not candidates:
            return None, None
        adj_pos, best_path = min(candidates, key=lambda x: len(x[1]))
        return adj_pos, best_path

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    planning_grid = _grid().copy()
    cur_pos = env._current_state.pos
    plan_actions = []

    # --------------------------------------------------------------
    # 1. Collect each required primitive
    # --------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            prim_cell = _nearest_cell(cur_pos, prim_idx, planning_grid)
            if prim_cell is None:
                # Primitive not present – abort planning
                return plan_actions
            adj_pos, path_to_adj = _adjacent_walkable(prim_cell, cur_pos, planning_grid)
            if adj_pos is None:
                # Cannot reach a neighbour – abort
                return plan_actions
            plan_actions += _actions_from_path(path_to_adj)
            cur_pos = adj_pos
            plan_actions.append(USE)   # pick up the primitive
            # Remove the primitive from the planning grid
            planning_grid[prim_cell[0], prim_cell[1], prim_idx] = 0

    # --------------------------------------------------------------
    # 2. Move to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_cell = _nearest_cell(cur_pos, workshop_idx, planning_grid)
        if workshop_cell is not None:
            adj_pos, path_to_adj = _adjacent_walkable(workshop_cell, cur_pos, planning_grid)
            if adj_pos is not None:
                plan_actions += _actions_from_path(path_to_adj)
                cur_pos = adj_pos
                plan_actions.append(USE)   # craft at the workshop

    return plan_actions


    import collections, numpy as np

    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # mutable copy of the grid for planning (so we can “remove” taken items)
    planning_grid = env._current_state.grid.copy()
    cur_pos = env._current_state.pos
    actions = []

    def _is_walkable(pos, grid):
        x, y = pos
        return not grid[x, y, :].any()

    def _bfs_path(start, goal, grid):
        """Return list of positions from start to goal (inclusive) using BFS."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(nxt, grid):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a position path to action indices."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _nearest_cell(pos, kind_idx, grid):
        """Return coordinates of the nearest cell containing kind_idx (Manhattan)."""
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return (int(nearest[0]), int(nearest[1]))

    def _adjacent_walkable(target, start, grid):
        """Find a walkable neighbour of target reachable from start."""
        w, h = grid.shape[:2]
        candidates = []
        tx, ty = target
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nx, ny = tx + dx, ty + dy
            if 0 <= nx < w and 0 <= ny < h and _is_walkable((nx, ny), grid):
                path = _bfs_path(start, (nx, ny), grid)
                if path is not None:
                    candidates.append(((nx, ny), path))
        if not candidates:
            return None, None
        # choose the neighbour with the shortest path
        adj, best_path = min(candidates, key=lambda p: len(p[1]))
        return adj, best_path

    # --------------------------------------------------------------
    # Collect required primitives
    # --------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            prim_cell = _nearest_cell(cur_pos, prim_idx, planning_grid)
            if prim_cell is None:
                return actions  # cannot find needed primitive
            adj, path_to_adj = _adjacent_walkable(prim_cell, cur_pos, planning_grid)
            if adj is None:
                return actions  # cannot reach primitive
            actions.extend(_actions_from_path(path_to_adj))
            cur_pos = adj
            actions.append(USE)  # pick up primitive
            planning_grid[prim_cell[0], prim_cell[1], prim_idx] = 0  # remove it

    # --------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_cell = _nearest_cell(cur_pos, workshop_idx, planning_grid)
        if workshop_cell is not None:
            adj, path_to_adj = _adjacent_walkable(workshop_cell, cur_pos, planning_grid)
            if adj is not None:
                actions.extend(_actions_from_path(path_to_adj))
                cur_pos = adj
                actions.append(USE)  # craft at workshop

    return actions

