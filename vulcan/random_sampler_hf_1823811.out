    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitives required to craft one arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # locate workshop (if recipe specifies one)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Return a list of coordinates from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # cells occupied by non‑grabbable entities are treated as blocked
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # fallback – no path found
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur → nxt into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("non‑adjacent move requested")

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) Collect required primitives
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            locations = find_locations(prim_idx)
            if not locations:
                raise RuntimeError(f"Primitive {idx.get(prim_idx, prim_idx)} not found on map")
            # choose the nearest occurrence (Manhattan distance)
            target = min(locations, key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE to pick up the primitive

    # 2) Move to workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if not wk_locations:
            raise RuntimeError("Workshop for arrow not found on map")
        target = min(wk_locations, key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
        path = bfs_path(cur_pos, target)
        for step in path[1:]:
            actions.append(move_action(cur_pos, step))
            cur_pos = step
        actions.append(4)   # USE to craft at the workshop

    return actions


