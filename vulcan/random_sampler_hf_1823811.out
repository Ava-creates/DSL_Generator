    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    cookbook = world.cookbook

    # index of the target item (arrow)
    goal_idx = cookbook.index.index('arrow')
    # primitive requirements for a single arrow (expanded to primitives)
    primitives_needed = cookbook.primitives_for(goal_idx)

    actions = []
    cur_pos = env._current_state.pos

    def _move_actions(src, dst):
        """Generate Manhattan movement actions from src to dst (ignores obstacles)."""
        x, y = src
        tx, ty = dst
        acts = []
        dx = tx - x
        dy = ty - y
        if dx > 0:
            acts += [DOWN] * dx
        elif dx < 0:
            acts += [UP] * (-dx)
        if dy > 0:
            acts += [RIGHT] * dy
        elif dy < 0:
            acts += [LEFT] * (-dy)
        return acts

    def _nearest_kind(pos, kind_idx):
        """Find the nearest cell containing the given kind index."""
        grid = env._current_state.grid
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = int(dists.argmin())
        return tuple(locations[nearest].tolist())

    # ------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------
    for prim_idx, qty in primitives_needed.items():
        for _ in range(qty):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # Primitive not present in the current scenario; abort early.
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up / interact with the primitive

    # ------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow
    # ------------------------------------------------------------
    workshop_name = cookbook.recipes[goal_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions


    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _manhattan_actions(src, dst):
        """Fallback simple Manhattan moves (ignores obstacles)."""
        x, y = src
        tx, ty = dst
        acts = []
        dx = tx - x
        dy = ty - y
        if dx > 0:
            acts += [DOWN] * dx
        elif dx < 0:
            acts += [UP] * (-dx)
        if dy > 0:
            acts += [RIGHT] * dy
        elif dy < 0:
            acts += [LEFT] * (-dy)
        return acts

    def _bfs_actions(src, dst):
        """Find a shortest path avoiding non‑grabbable cells using BFS.
        Returns a list of actions (DOWN, UP, LEFT, RIGHT). If no path is found,
        falls back to Manhattan moves."""
        grid = env._current_state.grid
        h, w, _ = grid.shape
        blocked = np.any(grid[:, :, list(env.world.non_grabbable_indices)] > 0, axis=2)

        # Simple bounds check
        if not (0 <= dst[0] < h and 0 <= dst[1] < w):
            return _manhattan_actions(src, dst)

        # BFS
        from collections import deque
        q = deque()
        q.append(src)
        visited = np.full((h, w), False, dtype=bool)
        visited[src] = True
        parent = dict()

        while q:
            cur = q.popleft()
            if cur == dst:
                break
            for move, (dx, dy) in [(DOWN, (1, 0)), (UP, (-1, 0)),
                                   (RIGHT, (0, 1)), (LEFT, (0, -1))]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny] and not blocked[nx, ny]:
                    visited[nx, ny] = True
                    parent[(nx, ny)] = (cur, move)
                    q.append((nx, ny))

        if dst not in parent and src != dst:
            # No path found – use Manhattan fallback
            return _manhattan_actions(src, dst)

        # Reconstruct actions
        actions_rev = []
        cur = dst
        while cur != src:
            prev, move = parent[cur]
            actions_rev.append(move)
            cur = prev
        actions_rev.reverse()
        return actions_rev

    def _move_actions(src, dst):
        """Choose BFS path if possible, otherwise Manhattan."""
        return _bfs_actions(src, dst)

    def _nearest_kind(pos, kind_idx):
        """Return coordinates of the nearest cell containing the given kind.
        Uses Manhattan distance for tie‑breaking."""
        grid = env._current_state.grid
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = int(dists.argmin())
        return tuple(locations[nearest].tolist())

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook
    arrow_idx = cookbook.index.index('arrow')
    primitives_needed = cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, qty in primitives_needed.items():
        for _ in range(qty):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # Primitive missing – stop early
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # Move to the appropriate workshop and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

