    import numpy as np
    from collections import deque

    # Ensure a fresh episode.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index and required primitive counts.
    goal_idx = env.task.goal
    needed = world.cookbook.primitives_for(goal_idx).copy()

    # Determine if a specific workshop is required.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_name = recipe["_at"]
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Bread‑first search returning a list of movement actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that brings the agent from `start` to `target`.  Cells occupied by any entity are
        considered blocked, except the target cell itself (which may hold the primitive or
        workshop we want to interact with).
        """
        occ = np.any(state.grid > 0, axis=2)          # True where blocked.
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    # Allow stepping onto the target even if it is currently occupied.
                    if not occ[nx, ny] or (nx, ny) == target:
                        if (nx, ny) not in visited:
                            visited.add((nx, ny))
                            q.append(((nx, ny), path + [act]))
        # No path found – return empty list (caller may decide what to do).
        return []

    def move_to(target):
        """Move the agent from its current location to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, count in needed.items():
        for _ in range(count):
            positions = locate(kind)
            if not positions:
                # Primitive missing – abort planning early.
                return actions
            # Choose the nearest occurrence (Manhattan distance) to reduce travel.
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            move_to(target)
            # Pick up the primitive.
            actions.append(4)          # USE action.
            _, state = state.step(4)

    # ------------------------------------------------------------------
    # 2. Go to the required workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                           key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            move_to(target_ws)
            actions.append(4)          # USE to trigger crafting.
            _, state = state.step(4)
    else:
        # No specific workshop – attempt to craft at the current location.
        actions.append(4)
        _, state = state.step(4)

    return actions


    import numpy as np
    from collections import deque

    # Grab current state and world information
    state = env._current_state          # CraftState
    world = env.world
    goal_idx = env.task.goal

    # Determine primitive requirements for the goal
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = world.cookbook.index[recipe["_at"]]

    actions = []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Bread‑first search returning a list of movement actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that moves the agent from `start` to `target`. The target cell may be occupied
        (e.g., a primitive to pick up); all other cells must be free.
        """
        occ = np.any(state.grid > 0, axis=2)          # True where any entity exists
        width, height = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    if not occ[nx, ny] or (nx, ny) == target:
                        if (nx, ny) not in visited:
                            visited.add((nx, ny))
                            q.append(((nx, ny), path + [act]))
        # No path found – return empty list (caller will stay put)
        return []

    def move_to(target):
        """Move agent from its current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for kind, count in needed.items():
        for _ in range(count):
            positions = locate(kind)
            if not positions:
                # Primitive missing – abort early
                return actions
            # Choose the nearest occurrence to reduce travel distance
            target = min(
                positions,
                key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])
            )
            move_to(target)
            # Pick up the primitive
            actions.append(4)          # USE
            _, state = state.step(4)

    # ------------------------------------------------------------------
    # 2. Go to workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(
                ws_positions,
                key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])
            )
            move_to(target_ws)

    # Trigger crafting (or simply use if no workshop is required)
    actions.append(4)          # USE
    _, state = state.step(4)

    return actions

