    import numpy as np
    from collections import deque

    # Direction vectors: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    USE = 4

    def bfs_to_adjacent(start, target, blocked):
        """Shortest path to any empty cell adjacent to target."""
        h, w = blocked.shape
        goal_cells = []
        tx, ty = target
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # Reset the environment if possible.
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # Identify the goal (arrow) and its recipe.
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []

    primitives_needed = world.cookbook.primitives_for(goal_idx)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at") or recipe.get("_key")
    if workshop_name is None:
        return []
    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []

    # Local mutable copies of the state.
    pos = tuple(state.pos)
    grid = state.grid.copy()
    occupied = np.any(grid > 0, axis=2)
    inventory = state.inventory.copy()

    plan_actions = []

    def move_and_use(target_coord, kind_idx):
        """Move next to target cell, USE it, and update local simulation."""
        nonlocal pos, plan_actions, grid, occupied, inventory
        path = bfs_to_adjacent(pos, target_coord, occupied)
        if not path and pos != target_coord:
            return False
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan_actions.extend(path)
        plan_actions.append(USE)
        tx, ty = target_coord
        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # Collect all required primitives.
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.size == 0:
                return plan_actions
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = tuple(candidates[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan_actions

    # Move to a workshop and craft the arrow.
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan_actions
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan_actions


    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Helper: BFS to a free cell adjacent to a target location.
    # Returns list of movement actions (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)
    # ------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    def bfs_to_adjacent(start, target, blocked):
        """Shortest path from start to any empty neighbour of target."""
        h, w = blocked.shape
        # all admissible destination cells (adjacent & free)
        goal_cells = []
        tx, ty = target
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []                     # nowhere to stand next to target

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []                         # unreachable

    # ------------------------------------------------------------------
    # Reset / obtain current state
    # ------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------------
    # Identify arrow goal and its recipe
    # ------------------------------------------------------------------
    arrow_idx = idx.get("arrow")
    if arrow_idx is None:
        return []

    # primitive requirements for a single arrow
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # workshop where arrow must be crafted
    recipe_dict = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe_dict.get("_at") or recipe_dict.get("_key")
    if workshop_name is None:
        return []
    workshop_idx = idx.get(workshop_name)
    if workshop_idx is None:
        return []

    # ------------------------------------------------------------------
    # Local mutable copies of the world state
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells
    inventory = state.inventory.copy()

    plan_actions = []

    # ------------------------------------------------------------------
    # Helper: move next to a cell containing `kind_idx` and USE it.
    # Updates the simulated local state.
    # ------------------------------------------------------------------
    def move_and_use(target_coord, kind_idx):
        nonlocal pos, plan_actions, grid, occupied, inventory
        path = bfs_to_adjacent(pos, target_coord, occupied)
        if not path and pos != target_coord:
            return False
        # execute movement actions
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan_actions.extend(path)
        # USE action
        plan_actions.append(USE)
        tx, ty = target_coord
        if grid[tx, ty, kind_idx] > 0:
            # pick‑up / craft consumes the entity
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # locate nearest remaining primitive of this kind
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.size == 0:
                # no more primitives of this type – abort early
                return plan_actions
            # Manhattan distance to current position
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = tuple(candidates[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan_actions

    # ------------------------------------------------------------------
    # Move to a workshop cell and craft the arrow
    # ------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # workshop may have been cleared in the simulated copy; fall back to original grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan_actions
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan_actions

