    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions = []
    cur_pos = tuple(state.pos)

    width, height = scenario.init_grid.shape[:2]
    grid = scenario.init_grid.copy()

    def is_blocked(pos):
        x, y = pos
        cell = grid[x, y, :]
        if world.non_grabbable_indices:
            idxs = list(world.non_grabbable_indices)
            return np.any(cell[idxs] > 0)
        return False

    def bfs_actions(start, target):
        if start == target:
            return []
        from collections import deque
        queue = deque([start])
        visited = {start: None}
        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            x, y = cur
            for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in visited and not is_blocked(nxt):
                        visited[nxt] = (cur, act)
                        queue.append(nxt)
        else:
            return []

        seq = []
        cur = target
        while cur != start:
            prev, act = visited[cur]
            seq.append(act)
            cur = prev
        seq.reverse()
        return seq

    def nearest_cell(kind, from_pos):
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                continue
            actions.extend(bfs_actions(cur_pos, target))
            actions.append(4)  # USE to pick up
            grid[target[0], target[1], kind] = 0
            cur_pos = target

    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            actions.extend(bfs_actions(cur_pos, target))
            cur_pos = target

    actions.append(4)  # final USE to craft
    return actions


