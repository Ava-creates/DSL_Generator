        # Move step‑by‑step towards the target cell.
        while state.pos != best_pos:
            px, py = state.pos
            tx, ty = best_pos
            if px < tx:
                act = 0          # DOWN
            elif px > tx:
                act = 1          # UP
            elif py < ty:
                act = 3          # RIGHT
            else:
                act = 2          # LEFT
            actions.append(act)
            _step(act)

        # Pick up the primitive.
        actions.append(4)          # USE
        _step(4)
        needed[best_kind] -= 1

    # ------------------------------------------------------------------
    # 3. Move to a workshop that can craft the goal.
    # ------------------------------------------------------------------
    # The recipe dictionary may contain a special key "_at" that stores the
    # workshop name. We need to translate that name to the corresponding kind
    # index using the world's index mapping.
    workshop_kind = None
    recipe = world.cookbook.recipes.get(goal, {})
    for key, val in recipe.items():
        if isinstance(key, str) and key.startswith('_'):
            # The key is something like "_at" and the value is the workshop name.
            workshop_name = val
            workshop_kind = world.cookbook.index[workshop_name]
            break
    # Fallback: if we could not infer the specific workshop, pick any workshop.
    if workshop_kind is None:
        if world.workshop_indices:
            workshop_kind = world.workshop_indices[0]

    # Locate the nearest cell that contains the chosen workshop.
    positions = np.argwhere(state.grid[:, :, workshop_kind] > 0)
    # If for any reason the workshop is not present, skip the movement.
    if positions.size > 0:
        dists = np.abs(positions - np.array(state.pos)).sum(axis=1)
        nearest_idx = int(dists.argmin())
        target_ws = tuple(positions[nearest_idx].tolist())

        # Move to the workshop.
        while state.pos != target_ws:
            px, py = state.pos
            tx, ty = target_ws
            if px < tx:
                act = 0          # DOWN
            elif px > tx:
                act = 1          # UP
            elif py < ty:
                act = 3          # RIGHT
            else:
                act = 2          # LEFT
            actions.append(act)
            _step(act)

    # ------------------------------------------------------------------
    # 4. Craft the goal item at the workshop.
    # ------------------------------------------------------------------
    # Keep using the workshop until the goal appears in the inventory.
    while state.inventory[goal] == 0:
        actions.append(4)          # USE (craft)
        _step(4)

    # Return the complete action list.
    return actions


    import numpy as np

    # Reset environment to obtain a fresh state.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index for the current task.
    goal_idx = env.task.goal

    # Determine which primitive items are needed for the goal.
    needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # Identify the workshop (if any) required for crafting this item.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # Helper: locate all grid positions that contain a given kind.
    def locate(kind):
        grid = state.grid
        inds = np.argwhere(grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    # Helper: move from the current position to a target cell using
    # Manhattan steps.  Action ordering follows the convention used in
    # CraftWorld: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE.
    def go_to(target):
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right
                act = 3
                new_pos = (x + 1, y)
            elif x > tx:        # need to move left
                act = 2
                new_pos = (x - 1, y)
            elif y < ty:        # need to move down
                act = 0
                new_pos = (x, y + 1)
            else:               # need to move up
                act = 1
                new_pos = (x, y - 1)

            actions.append(act)
            _, state = state.step(act)   # apply action, update state

    actions = []

    # Gather each required primitive the required number of times.
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Primitive not present – abort early.
                return actions
            # Choose the first occurrence (could be improved with nearest‑search).
            target_pos = positions[0]
            go_to(target_pos)
            # Pick up the item.
            actions.append(4)          # USE
            _, state = state.step(4)

    # Finally, go to the appropriate workshop (if any) and craft.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            go_to(ws_positions[0])
            actions.append(4)          # USE to craft
            _, state = state.step(4)

    return actions

