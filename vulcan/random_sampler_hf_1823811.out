    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    # ----------------------------------------------------------------------
    # Helper to generate Manhattan moves from current position to target
    # ----------------------------------------------------------------------
    cur_pos = list(env._current_state.pos)          # mutable [x, y]
    def move_to(target):
        tx, ty = target
        moves = []
        # X direction
        while cur_pos[0] < tx:
            moves.append(RIGHT); cur_pos[0] += 1
        while cur_pos[0] > tx:
            moves.append(LEFT); cur_pos[0] -= 1
        # Y direction
        while cur_pos[1] < ty:
            moves.append(DOWN); cur_pos[1] += 1
        while cur_pos[1] > ty:
            moves.append(UP); cur_pos[1] -= 1
        return moves

    # ----------------------------------------------------------------------
    # Planning grid copy (so we can simulate pickups)
    # ----------------------------------------------------------------------
    import numpy as np
    grid = env._current_state.grid.copy()   # shape (W, H, n_kinds)

