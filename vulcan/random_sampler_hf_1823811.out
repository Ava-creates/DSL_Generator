    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _grid():
        """Current grid view."""
        return env._current_state.grid

    def _inside(x, y):
        """Check whether (x, y) lies inside the world."""
        w, h, _ = _grid().shape
        return 0 <= x < w and 0 <= y < h

    def _is_empty(x, y, target_kind=None):
        """True if cell (x, y) can be stepped on.
        Allows stepping on a cell that contains the target_kind (the primitive we want).
        """
        cell = _grid()[x, y, :]
        if target_kind is not None and cell[target_kind] > 0:
            return True
        return cell.sum() == 0

    def _bfs_path(start, goal_kind=None, goal_pos=None):
        """Breadth‑first search returning a list of positions from start to the goal.
        Either *goal_kind* (any cell containing that kind) or *goal_pos* (exact cell)
        must be supplied.
        """
        from collections import deque

        q = deque([start])
        visited = {start: None}
        while q:
            x, y = q.popleft()
            # Goal reached?
            if goal_pos is not None and (x, y) == goal_pos:
                break
            if goal_kind is not None and _grid()[x, y, goal_kind] > 0:
                break
            # Explore neighbours
            for dx, dy, act in [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]:
                nx, ny = x + dx, y + dy
                if not _inside(nx, ny):
                    continue
                if (nx, ny) in visited:
                    continue
                if not _is_empty(nx, ny, target_kind=goal_kind):
                    continue
                visited[(nx, ny)] = (x, y)
                q.append((nx, ny))
        else:
            # No path found
            return None

        # Reconstruct path
        if goal_pos is not None:
            end = goal_pos
        else:
            # locate the cell that satisfied the goal_kind condition
            end = (x, y)
        path = []
        cur = end
        while cur is not None:
            path.append(cur)
            cur = visited[cur]
        path.reverse()
        return path

    def _path_to_actions(path):
        """Translate a list of positions into action indices."""
        actions = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            dx, dy = x1 - x0, y1 - y0
            if dx == 1:
                actions.append(DOWN)
            elif dx == -1:
                actions.append(UP)
            elif dy == -1:
                actions.append(LEFT)
            elif dy == 1:
                actions.append(RIGHT)
        return actions

    # ------------------------------------------------------------------
    # 1. Determine primitives needed for an arrow
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    # ------------------------------------------------------------------
    # 2. Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            # Find a reachable primitive of this kind
            path = _bfs_path(cur_pos, goal_kind=prim_idx)
            if path is None:
                # Cannot reach required primitive – abort planning
                return actions
            actions.extend(_path_to_actions(path))
            cur_pos = path[-1]
            actions.append(USE)   # pick up the primitive

    # ------------------------------------------------------------------
    # 3. Move to the workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        # Find nearest workshop cell (they are always empty locations)
        path = _bfs_path(cur_pos, goal_kind=workshop_idx)
        if path is not None:
            actions.extend(_path_to_actions(path))
            cur_pos = path[-1]
            actions.append(USE)   # craft at the workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    def _move_actions(src, dst):
        """Return a list of actions moving Manhattan‑wise from src to dst."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_kind(pos, kind_idx):
        """Find the nearest cell (Manhattan distance) that contains kind_idx."""
        grid = env._current_state.grid
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Determine which primitives are required to craft an arrow.
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}

    actions = []
    cur_pos = env._current_state.pos

    # ------------------------------------------------------------------
    # Collect each required primitive, one at a time.
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # Primitive missing – stop planning.
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)   # pick up

    # ------------------------------------------------------------------
    # Go to the workshop (if the recipe specifies one) and craft the arrow.
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft

    return actions

