            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return _actions_from_path(path)

