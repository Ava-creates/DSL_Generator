    """Improved version of make_arrow that accounts for dynamic grid updates
    and uses BFS for obstacle‑aware navigation."""
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # index of the goal item "arrow"
    arrow_idx = world.cookbook.index.index('arrow')
    # primitive requirements for one arrow: {prim_idx: count}
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # make a mutable copy of the current grid to track harvested cells
    grid = env._current_state.grid.copy()
    cur_pos = env._current_state.pos

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _is_occupied(pos, g):
        """True if any entity occupies the cell."""
        x, y = pos
        return g[x, y, :].any()

    def _bfs_path(start, goal, g):
        """BFS shortest path on the grid, allowing stepping onto the goal
        even if occupied (e.g., a workshop). Returns list of positions."""
        if start == goal:
            return [start]
        width, height = g.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        # goal cell may be occupied (e.g., workshop)
                        if not _is_occupied(nxt, g) or nxt == goal:
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate consecutive positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, g):
        """Return actions to move from src to dst using BFS, fall back to Manhattan."""
        path = _bfs_path(src, dst, g)
        if path is None:
            # Manhattan fallback (may collide with obstacles)
            acts = []
            x, y = src
            tx, ty = dst
            dx = tx - x
            dy = ty - y
            if dx > 0:
                acts += [DOWN] * dx
            elif dx < 0:
                acts += [UP] * (-dx)
            if dy > 0:
                acts += [RIGHT] * dy
            elif dy < 0:
                acts += [LEFT] * (-dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx, g, excluded):
        """Find nearest cell containing `kind_idx` not in `excluded`."""
        coords = np.argwhere(g[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        if excluded:
            mask = np.array([tuple(c) not in excluded for c in coords])
            coords = coords[mask]
            if coords.size == 0:
                return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Planning: collect required primitives
    # ------------------------------------------------------------------
    actions = []
    # keep track of which cells have been harvested for each kind
    harvested = {}

    for prim_idx, count in primitives_needed.items():
        harvested.setdefault(prim_idx, set())
        for _ in range(count):
            target = _nearest_kind(cur_pos, prim_idx, grid,
                                   harvested[prim_idx])
            if target is None:
                # primitive not available – abort planning
                return actions
            actions += _move_actions(cur_pos, target, grid)
            cur_pos = target
            actions.append(USE)               # pick up primitive
            # mark cell as empty for this kind (simulate pickup)
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            harvested[prim_idx].add(cur_pos)

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid, set())
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos, grid)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at workshop

    return actions


    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # Index of the desired product
    arrow_idx = world.cookbook.index.index('arrow')
    # Mapping primitive_kind_idx -> required count
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _cell_occupied(pos, grid):
        """True if any entity occupies the cell."""
        x, y = pos
        return grid[x, y, :].any()

    def _bfs_path(start, goal, grid):
        """Return a list of positions from start to goal using BFS.
        The goal cell is considered traversable even if occupied.
        """
        if start == goal:
            return [start]
        width, height = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        # Goal may be occupied; all other cells must be free
                        if nxt == goal or not _cell_occupied(nxt, grid):
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # No path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a positional path into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, grid):
        """Compute actions to move from src to dst (BFS preferred,
        Manhattan fallback if BFS fails)."""
        path = _bfs_path(src, dst, grid)
        if path is None:
            # Simple Manhattan moves – may hit obstacles but ensures progress
            acts = []
            x, y = src
            tx, ty = dst
            dx = tx - x
            dy = ty - y
            if dx > 0:
                acts += [DOWN] * dx
            elif dx < 0:
                acts += [UP] * (-dx)
            if dy > 0:
                acts += [RIGHT] * dy
            elif dy < 0:
                acts += [LEFT] * (-dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx, grid):
        """Find the nearest cell containing `kind_idx`. Returns None if absent."""
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    # Work on a mutable copy of the grid to reflect pickups
    grid = env._current_state.grid.copy()

    # 1. Gather all required primitives
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_kind(cur_pos, prim_idx, grid)
            if target is None:
                # Primitive unavailable – abort planning
                return actions
            actions += _move_actions(cur_pos, target, grid)
            cur_pos = target
            actions.append(USE)  # pick up the primitive
            # Remove the primitive from the simulated grid
            grid[target[0], target[1], prim_idx] = 0

    # 2. Move to workshop (if the recipe specifies one) and craft
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_pos = _nearest_kind(cur_pos, workshop_idx, grid)
        if ws_pos is not None:
            actions += _move_actions(cur_pos, ws_pos, grid)
            cur_pos = ws_pos
            actions.append(USE)   # craft at the workshop

    return actions

