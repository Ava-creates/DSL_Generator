    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE   = act_map['USE']

    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions that brings the
    # agent to a cell containing `target_kind`. The search can step onto
    # empty cells or the target cell itself, but avoids any other occupied
    # cells.
    # ------------------------------------------------------------------
    def find_path(cur_state, target_kind):
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow stepping onto the target cell even if occupied.
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # If unreachable (should not happen in well‑formed scenarios) return empty.
        return []

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect required primitives (or the goal itself if it has no recipe).
    # ------------------------------------------------------------------
    if required:
        # Goal is a crafted item; gather its primitive ingredients.
        for prim_kind, count in required.items():
            for _ in range(count):
                path = find_path(state, prim_kind)
                for a in path:
                    _, state = state.step(a)
                    actions.append(a)
                # Pick up the primitive now under the agent.
                _, state = state.step(ACTION_USE)
                actions.append(ACTION_USE)
    else:
        # Goal is a primitive; just go to it and pick it up.
        path = find_path(state, goal_idx)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) If the recipe requires a workshop, move there and use it to craft.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
