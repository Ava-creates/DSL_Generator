    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for one arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Determine workshop (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # Helper: locations of a kind on the grid
    def find_locations(kind):
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    # BFS shortest path avoiding non‑grabbable cells
    def bfs(start, goal):
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay in place
        return [start]

    # Convert adjacent step to action index
    def step_to_action(cur, nxt):
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Step is not adjacent")

    actions = []
    cur_pos = state.pos

    # 1) Gather required primitives
    for prim_idx, count in primitive_counts.items():
        # Skip if we already have enough in inventory
        if state.inventory[prim_idx] >= count:
            continue
        locations = find_locations(prim_idx)
        if not locations:
            raise RuntimeError(f"Primitive {idx.get(prim_idx, prim_idx)} not found on map")
        # Choose the nearest location (Manhattan)
        target = min(locations,
                     key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
        path = bfs(cur_pos, target)
        for step in path[1:]:
            actions.append(step_to_action(cur_pos, step))
            cur_pos = step
        # Pick up the required amount (use action repeatedly)
        for _ in range(count):
            actions.append(4)   # USE

    # 2) Move to workshop and craft (if required)
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if not wk_locations:
            raise RuntimeError("Required workshop not found on map")
        target = min(wk_locations,
                     key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
        path = bfs(cur_pos, target)
        for step in path[1:]:
            actions.append(step_to_action(cur_pos, step))
            cur_pos = step
        actions.append(4)   # USE to craft

    return actions


    # reset environment to obtain a fresh state
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world                    # CraftWorld instance
    idx = world.cookbook.index            # name ↔ integer id mapping

    # ------------------------------------------------------------------
    # Identify goal and its recipe information
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitive requirements for a single arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # workshop location (if any) required for crafting this item
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) grid coordinates where `kind` is present."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest path (list of coordinates) from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # cells occupied by non‑grabbable entities are treated as blocked
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # no path found – stay in place
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur → nxt into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not to an adjacent cell")

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    inventory = state.inventory.copy()

    # 1) Gather each required primitive (using inventory first if possible)
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            if inventory[prim_idx] > 0:
                # already have one in inventory – just consume virtually
                inventory[prim_idx] -= 1
                continue

            # locate a primitive instance on the map
            locations = find_locations(prim_idx)
            if not locations:
                raise RuntimeError(f"Required primitive {idx.get(prim_idx, prim_idx)} not found on the map")

            # pick the nearest instance (Manhattan distance)
            target = min(locations,
                         key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))

            # move to the target
            path = bfs_path(cur_pos, target)
            for step in path[1:]:               # skip current position
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # pick it up
            actions.append(4)                    # USE
            inventory[prim_idx] += 1             # now we have it
            inventory[prim_idx] -= 1              # and immediately consume for crafting

    # 2) Move to the required workshop (if any) and craft the arrow
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if not wk_locations:
            raise RuntimeError("Required workshop for crafting arrow not found on the map")
        target = min(wk_locations,
                     key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
        path = bfs_path(cur_pos, target)
        for step in path[1:]:
            actions.append(move_action(cur_pos, step))
            cur_pos = step
        actions.append(4)                        # USE to craft at the workshop

    return actions

