    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    from collections import deque
    import numpy as np

    def bfs_path(start, target):
        """Shortest movement actions from start to target, ignoring occupied cells except the target."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # allow stepping onto the target even if occupied
                if nxt != target and state.grid[nr, nc].any():
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # no path found
        # reconstruct actions
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def find_nearest(kind_idx, start):
        """Find nearest cell containing `kind_idx`; return (action_list, cell) or ([], None)."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                occupied = state.grid[nr, nc].any()
                has_target = state.grid[nr, nc, kind_idx] > 0
                if occupied and not has_target:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if has_target:
                    # reconstruct path to this cell
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None

    goal_name = "arrow"
    if goal_name not in index.contents:
        return []
    goal_idx = index[goal_name]

    # Primitive requirements for one arrow.
    needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    # 1. Collect all required primitives.
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            path, cell = find_nearest(prim_idx, state.pos)
            if cell is None:
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)
            state.inventory[prim_idx] += 1
            tr, tc = cell
            state.grid[tr, tc, prim_idx] = 0

