    import numpy as np, collections

    # Reset environment and fetch current state/world objects
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld
    idx = world.cookbook.index           # name → integer id

    # ------------------------------------------------------------------
    # Identify goal and its recipe requirements
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive resources needed for ONE arrow
    primitive_needs = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop (if any) where the arrow must be crafted
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) positions where `kind` occurs on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal):
        """Shortest 4‑connected path from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Cells occupied by any non‑grabbable entity are blocked
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No reachable path – stay put
        return [start]

    def move_action(cur, nxt):
        """Translate a step between adjacent cells into a DMLab action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("Non‑adjacent move requested")

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # 1) Gather all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        while state.inventory[prim_idx] < needed:
            # locate remaining instances of this primitive
            candidates = locate(prim_idx)
            if not candidates:
                # cannot satisfy the recipe – abort further collection
                break

            # choose the closest instance (Manhattan distance)
            target = min(candidates,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))

            # move along shortest path to the target cell
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # pick up the primitive (USE)
            actions.append(4)          # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0   # remove from world

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locs = locate(workshop_kind)
        if wk_locs:
            target = min(wk_locs,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
    # craft (USE at current location)
    actions.append(4)          # USE

    return actions


    # Reset environment and fetch state/world references
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Goal definition
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for a single arrow
    primitive_needs = world.cookbook.primitives_for(goal_idx)

    # Workshop (if any) required for crafting the arrow
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def blocked_cells():
        """Set of coordinates occupied by non‑grabbable entities."""
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))
        return blocked

    def bfs_path(start, goal):
        """Return the shortest path (list of positions) from start to goal avoiding blocked cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        blocked = blocked_cells()
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No reachable path – stay put
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur to adjacent nxt into an action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not adjacent")

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in primitive_needs.items():
        while state.inventory[prim_idx] < required_cnt:
            locations = find_locations(prim_idx)
            if not locations:
                # Primitive unavailable – abort the whole plan
                return []
            # Choose the nearest reachable primitive (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            # Compute path and translate to actions
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # Pick up the primitive
            actions.append(4)   # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            target = min(
                wk_locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
    # Final crafting action
    actions.append(4)   # USE

    return actions

