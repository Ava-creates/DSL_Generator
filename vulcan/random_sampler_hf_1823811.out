    # Reset the environment to start fresh
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index and primitive requirements
    goal_idx = env.task.goal
    needed = world.cookbook.primitives_for(goal_idx)          # {primitive_kind: count}

    # Determine if the final recipe must be performed at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan move sequence (DOWN=0, UP=1, LEFT=2, RIGHT=3)
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate nearest cell that still contains the required kind
    # ------------------------------------------------------------------
    def nearest_cell(kind, from_pos, grid):
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # Make a mutable copy of the initial grid so we can “consume” items once taken
    grid_copy = scenario.init_grid.copy()

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------------
    for kind, cnt in needed.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos, grid_copy)
            if target is None:
                # No more of this primitive left; break early
                break
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)                     # USE to pick up the primitive
            # Mark the primitive as taken so we don't try to collect it again
            grid_copy[target[0], target[1], kind] = 0

    # ------------------------------------------------------------------
    # 2) If a workshop is required, go there and craft the final item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        workshop_target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)
        if workshop_target is not None:
            move_seq, cur_pos = moves_to(cur_pos, workshop_target)
            actions.extend(move_seq)
            actions.append(4)                     # USE to craft at the workshop

    # Return the complete action list
    return actions


    # Reset environment and extract useful objects
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    goal_idx = env.task.goal
    # Primitive requirements for the final goal (may be empty if goal is primitive)
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the final recipe requires a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    # Action indices (consistent with CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Convert a move (dx,dy) into an action index
    def move_to_action(dx, dy):
        if dx == 1:
            return RIGHT
        if dx == -1:
            return LEFT
        if dy == 1:
            return DOWN
        if dy == -1:
            return UP
        raise ValueError("Invalid move delta")

    # Manhattan BFS that treats any non‑empty cell as blocked,
    # except the goal cell which is allowed even if occupied.
    def bfs_path(start, goal, blocked):
        from collections import deque
        W, H = blocked.shape
        q = deque()
        q.append(start)
        visited = np.full((W, H), False, dtype=bool)
        visited[start] = True
        parent = {}
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                # reconstruct path (including start and goal)
                path = [(x, y)]
                while (x, y) != start:
                    x, y = parent[(x, y)]
                    path.append((x, y))
                path.reverse()
                return path
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                    # allow stepping onto the goal even if blocked
                    if (nx, ny) == goal or not blocked[nx, ny]:
                        visited[nx, ny] = True
                        parent[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        return None  # no path found

    # Convert a path (list of positions) into a list of actions.
    # The path must contain at least two positions.
    def actions_from_path(path):
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            dx, dy = x1 - x0, y1 - y0
            acts.append(move_to_action(dx, dy))
        return acts

    # ------------------------------------------------------------------
    # Prepare mutable copies of the grid for bookkeeping
    # ------------------------------------------------------------------
    # Static grid (contains items, workshops, obstacles)
    static_grid = scenario.init_grid
    # Mutable copy to clear primitives once taken
    mutable_grid = static_grid.copy()
    # Blocked mask (True where cell is occupied)
    blocked_mask = (static_grid.sum(axis=2) > 0)

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Collect each required primitive (handling multiplicities)
    # ------------------------------------------------------------------
    for kind_idx, count in required.items():
        for _ in range(count):
            # Find the nearest remaining primitive of this kind
            locations = np.argwhere(mutable_grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # No more primitives of this kind; give up on this item
                continue
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            target_idx = dists.argmin()
            target = tuple(locations[target_idx])

            # Plan a path to the target cell (allowed to step onto it)
            path = bfs_path(cur_pos, target, blocked_mask)
            if path is None:
                # If unreachable, skip this primitive
                continue
            # Convert path to actions and execute
            actions.extend(actions_from_path(path))

            # After arriving on the primitive cell, step back one cell
            # (the previous cell in the path) to be adjacent and facing it.
            if len(path) >= 2:
                back_step = path[-2]  # cell before the target
                dx, dy = back_step[0] - target[0], back_step[1] - target[1]
                actions.append(move_to_action(dx, dy))
                cur_pos = back_step
            else:
                # Edge case: start already on the target; just try a dummy move
                # Try moving RIGHT if possible, otherwise LEFT, etc.
                moved = False
                for dx, dy, act in [(1, 0, RIGHT), (-1, 0, LEFT), (0, 1, DOWN), (0, -1, UP)]:
                    nx, ny = cur_pos[0] + dx, cur_pos[1] + dy
                    if 0 <= nx < blocked_mask.shape[0] and 0 <= ny < blocked_mask.shape[1] and not blocked_mask[nx, ny]:
                        actions.append(act)
                        cur_pos = (nx, ny)
                        moved = True
                        break
                if not moved:
                    # No free neighbour; stay where we are
                    cur_pos = cur_pos

            # Use the USE action to pick up the primitive
            actions.append(USE)

            # Update mutable grid and blocked mask (primitive removed)
            mutable_grid[target[0], target[1], kind_idx] = 0
            blocked_mask[target[0], target[1]] = False

    # ------------------------------------------------------------------
    # If a workshop is required for the final crafting step, move there
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        # Locate the nearest workshop of the required kind
        ws_locs = np.argwhere(static_grid[:, :, workshop_kind] > 0)
        if ws_locs.size > 0:
            dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])
            ws_target = tuple(ws_locs[dists.argmin()])

            # Path to the workshop cell (allowed to step onto it)
            ws_path = bfs_path(cur_pos, ws_target, blocked_mask)
            if ws_path is not None:
                actions.extend(actions_from_path(ws_path))

                # Step back one cell to be adjacent and facing the workshop
                if len(ws_path) >= 2:
                    back_step = ws_path[-2]
                    dx, dy = back_step[0] - ws_target[0], back_step[1] - ws_target[1]
                    actions.append(move_to_action(dx, dy))
                    cur_pos = back_step
                else:
                    # Same fallback as above if already on workshop
                    moved = False
                    for dx, dy, act in [(1, 0, RIGHT), (-1, 0, LEFT), (0, 1, DOWN), (0, -1, UP)]:
                        nx, ny = cur_pos[0] + dx, cur_pos[1] + dy
                        if 0 <= nx < blocked_mask.shape[0] and 0 <= ny < blocked_mask.shape[1] and not blocked_mask[nx, ny]:
                            actions.append(act)
                            cur_pos = (nx, ny)
                            moved = True
                            break
                    if not moved:
                        cur_pos = cur_pos

                # Use the workshop to craft the final item
                actions.append(USE)

    return actions

