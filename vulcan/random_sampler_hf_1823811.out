    # ----------------------------------------------------------------------
    # This implementation works for any version of the `make_arrow_vn`
    # function (v0, v1, v2). It builds a simple plan:
    #   1. Determine which primitive resources are required to craft an arrow.
    #   2. Locate each required primitive in the current grid and move to it,
    #      using the shortest Manhattan‑distance path (horizontal then vertical).
    #      Once adjacent, issue a USE action to pick it up.
    #   3. Locate the workshop where the arrow must be crafted (as indicated
    #      by the recipe) and move to it, then USE to perform the crafting.
    # The function returns the list of integer actions that can be fed to the
    # environment (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).
    # ----------------------------------------------------------------------
    import numpy as np

    # Action constants – they match the mapping used in CraftLab.action_specs()
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Helper to compute a Manhattan‑distance path between two positions.
    # The returned list contains movement actions only (no USE).
    # ----------------------------------------------------------------------
    def _path_actions(src, dst):
        actions = []
        dx = dst[0] - src[0]          # horizontal displacement (x‑axis)
        dy = dst[1] - src[1]          # vertical displacement   (y‑axis)

        # Move horizontally first
        if dx > 0:
            actions += [RIGHT] * dx
        elif dx < 0:
            actions += [LEFT] * (-dx)

        # Then move vertically
        if dy > 0:
            actions += [DOWN] * dy
        elif dy < 0:
            actions += [UP] * (-dy)

        return actions

    # ----------------------------------------------------------------------
    # Access the world, cookbook and the current state.
    # ----------------------------------------------------------------------
    world = env.world                       # CraftWorld instance
    cookbook = world.cookbook                # holds recipes & indices
    idx = cookbook.index                     # Index object: name ↔ id

    # Ensure the environment has been reset so that a state exists.
    # If the user passed an already‑running env we simply read the current
    # state; otherwise we call reset() to obtain one.
    try:
        state = env._current_state          # type: CraftState
    except AttributeError:                  # pragma: no cover
        # Fallback for environments that expose a `reset` method only.
        obs = env.reset()
        state = env._current_state

    grid = state.grid                        # current occupancy grid
    pos = state.pos                          # (x, y) tuple of agent position

    # ----------------------------------------------------------------------
    # Identify the goal index for the item "arrow".
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx.index(goal_name)

    # ----------------------------------------------------------------------
    # Determine which primitive resources are needed for a single arrow.
    # `primitives_for` returns a dict {primitive_idx: count}.
    # ----------------------------------------------------------------------
    primitive_requirements = cookbook.primitives_for(goal_idx)

    # ----------------------------------------------------------------------
    # Build the action plan.
    # ----------------------------------------------------------------------
    plan = []

    # --- 1. Collect each required primitive --------------------------------
    for prim_idx, needed_cnt in primitive_requirements.items():
        # Find all cells that currently contain this primitive.
        locations = np.argwhere(grid[:, :, prim_idx] > 0)

        # If the primitive is not present in the grid (should not happen in a
        # well‑generated scenario), we simply skip it.
        if locations.shape[0] == 0:
            continue

        # We may need several copies of the same primitive.  Re‑use the same
        # location for each copy (the environment will keep the item there
        # until it is picked up).
        target = tuple(locations[0].tolist())   # (x, y)

        for _ in range(needed_cnt):
            # Move to the target cell (or adjacent – the USE action works on the
            # cell the agent is facing; moving onto the cell is safe for all
            # non‑blocking items).
            plan += _path_actions(pos, target)

            # Update our simulated position.
            pos = target

            # Pick up the primitive.
            plan.append(USE)

    # --- 2. Move to the appropriate workshop and craft the arrow ----------
    # The recipe for the arrow contains a special key "_at" that tells us the
    # name of the workshop where the crafting must happen.
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at", None)

    if workshop_name is not None:
        workshop_idx = idx.index(workshop_name)

        # Locate a workshop of the required type.
        workshop_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_locs.shape[0] > 0:
            workshop_pos = tuple(workshop_locs[0].tolist())
            # Move to the workshop.
            plan += _path_actions(pos, workshop_pos)
            pos = workshop_pos

    # Finally, issue the USE action to craft the arrow.
    plan.append(USE)

    # Return the completed list of actions.
    return plan


    # Reset the environment and get the initial state
    env.reset()
    state = env._current_state

    # Action indices
    act_map = env.action_specs()
    UP = act_map["UP"]
    DOWN = act_map["DOWN"]
    LEFT = act_map["LEFT"]
    RIGHT = act_map["RIGHT"]
    USE = act_map["USE"]

    actions = []

    # Goal information
    goal_name = "arrow"
    goal_idx = env.world.cookbook.index[goal_name]
    recipe = env.world.cookbook.recipes[goal_idx]

    # Workshop index for the goal
    workshop_idx = recipe["_key"]

    # Primitive requirements (ignore the "_key" entry)
    primitives_needed = {k: v for k, v in recipe.items() if k != "_key"}

    # Helper: generate a Manhattan‑distance path from cur → target
    def path_to(cur, target):
        seq = []
        y, x = cur
        ty, tx = target
        while y != ty or x != tx:
            if y < ty:
                seq.append(DOWN)
                y += 1
            elif y > ty:
                seq.append(UP)
                y -= 1
            elif x < tx:
                seq.append(RIGHT)
                x += 1
            elif x > tx:
                seq.append(LEFT)
                x -= 1
        return seq

    # Collect each required primitive
    for kind, cnt in primitives_needed.items():
        for _ in range(cnt):
            # Locate the nearest cell containing the primitive
            positions = np.argwhere(state.grid[:, :, kind] > 0)
            if positions.size == 0:
                # No more of this primitive on the map; give up
                continue
            dists = np.sum(np.abs(positions - np.array(state.pos)), axis=1)
            target = tuple(positions[dists.argmin()])

            # Move to the primitive
            for a in path_to(state.pos, target):
                actions.append(a)
                _, state = state.step(a)

            # Pick it up
            actions.append(USE)
            _, state = state.step(USE)

    # Move to the appropriate workshop and craft the item
    ws_positions = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if ws_positions.size > 0:
        dists = np.sum(np.abs(ws_positions - np.array(state.pos)), axis=1)
        ws_target = tuple(ws_positions[dists.argmin()])

        for a in path_to(state.pos, ws_target):
            actions.append(a)
            _, state = state.step(a)

        actions.append(USE)          # craft at the workshop
        _, state = state.step(USE)

    return actions

