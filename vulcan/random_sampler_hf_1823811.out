    # ------------------------------------------------------------------
    # Helper to generate a Manhattan path (using the action encoding)
    # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT
    # ------------------------------------------------------------------
    def path_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Pre‑compute locations of all primitive kinds we need
    # ------------------------------------------------------------------
    kind_cells = {}
    for k in required.keys():
        cells = np.argwhere(scenario.init_grid[:, :, k] > 0)
        kind_cells[k] = [tuple(c) for c in cells]

    # Keep track of which cells have already been harvested
    harvested = {k: set() for k in required.keys()}

    def nearest_available(kind, from_pos):
        """Return the closest cell of `kind` not yet harvested."""
        candidates = [c for c in kind_cells.get(kind, []) if c not in harvested[kind]]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
