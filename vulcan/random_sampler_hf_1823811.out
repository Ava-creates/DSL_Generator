    # Reset the environment to obtain a fresh state (ignore errors if already reset)
    try:
        env.reset()
    except Exception:
        pass

    # Retrieve the current CraftState from the environment
    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # Arrow not defined in the index

    # Primitive (or sub‑component) counts required for one arrow
    needed = world.cookbook.primitives_for(goal_idx)

    # Locate the workshop required for crafting the arrow (stored under "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                     # No workshop info in recipe

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # Workshop not indexed

    # ------------------------------------------------------------------
    # Local mutable copies for planning simulation
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y) current position
    grid = state.grid.copy()                   # (W, H, n_kinds) occupancy
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells
    plan = []                                   # actions to be returned

    # ------------------------------------------------------------------
    # Constants and helper functions
    # ------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    from collections import deque

    def bfs_adjacent(start, target, blocked):
        """Return a list of actions moving from *start* to any empty cell
        that is 4‑connected to *target*. Empty list if unreachable."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []                     # target completely surrounded

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []                         # unreachable

    def move_and_use(target, kind_idx):
        """Move adjacent to *target* (containing *kind_idx*) and issue USE.
        Updates simulated position, grid, occupied mask and inventory.
        Returns False if movement is impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # Simulate movement
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # Issue USE
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ------------------------------------------------------------------
    # Collect all required primitives / components
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # Required item not present on the map – abort planning
                return plan
            # Choose the nearest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, kind_idx):
                return plan

    # ------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # Fallback to original scenario grid (workshops are static)
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    # ------------------------------------------------------------------
    # Return the constructed action sequence
    # ------------------------------------------------------------------
    return plan


    # ----------------------------------------------------------------------
    # Reset environment and fetch current CraftState
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # no arrow defined

    # Primitive (or sub‑component) counts required for one arrow
    needed = world.cookbook.primitives_for(goal_idx)

    # Locate the workshop required for crafting the arrow
    workshop_idx = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            try:
                workshop_idx = idx[v]
            except Exception:
                workshop_idx = None
            break
    if workshop_idx is None:
        return []                     # recipe missing workshop info

    # ----------------------------------------------------------------------
    # Local mutable copies for simulation
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool mask of blocked cells
    plan = []                                   # list of actions to return

    # ----------------------------------------------------------------------
    # Constants and helper functions
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    from collections import deque

    def bfs_adjacent(start, target, blocked):
        """Return a list of actions moving from *start* to any empty
        cell that is 4‑connected to *target*. Empty list if unreachable."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []                     # target completely surrounded

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []                         # unreachable

    def move_and_use(target, kind_idx):
        """Move adjacent to *target* (containing *kind_idx*) and issue USE.
        Updates simulated position, grid, occupied mask and inventory.
        Returns False if movement is impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # Simulate movement
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # Issue USE
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives / sub‑components
    # ----------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # No more of this kind on the map – abort planning
                return plan
            # Choose the nearest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, kind_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # Fallback to original grid (workshops are static)
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    # ----------------------------------------------------------------------
    # Return the constructed action sequence
    # ----------------------------------------------------------------------
    return plan

