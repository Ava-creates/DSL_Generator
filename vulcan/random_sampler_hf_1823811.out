    import numpy as np
    from collections import deque

    # Mapping of movement deltas to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)
    _delta_to_action = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }

    def _is_free(grid, x, y):
        """Return True if the cell at (x, y) has no entities."""
        return grid[x, y, :].sum() == 0

    def _neighbors(pos, width, height):
        """Yield (next_pos, delta) for orthogonal neighbours."""
        x, y = pos
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nx, ny = x + dx, y + dy
            if 0 <= nx < width and 0 <= ny < height:
                yield (nx, ny), (dx, dy)

    def _bfs_path(grid, start, goal_cond):
        """Bread‑first search returning list of actions to reach a cell satisfying goal_cond."""
        width, height = grid.shape[0], grid.shape[1]
        q = deque([start])
        came_from = {start: None}
        move_from = {}
        while q:
            cur = q.popleft()
            if goal_cond(cur):
                # reconstruct actions
                actions = []
                while came_from[cur] is not None:
                    dx, dy = move_from[cur]
                    actions.append(_delta_to_action[(dx, dy)])
                    cur = came_from[cur]
                actions.reverse()
                return actions
            for nxt, delta in _neighbors(cur, width, height):
                if nxt in came_from:
                    continue
                # Allow stepping onto the goal cell even if occupied.
                if goal_cond(nxt) or _is_free(grid, *nxt):
                    came_from[nxt] = cur
                    move_from[nxt] = delta
                    q.append(nxt)
        return []  # no path found

    # ------------------------------------------------------------------
    # Gather environment information.
    # ------------------------------------------------------------------
    state = env._current_state          # CraftState
    world = env.world
    goal_idx = env.task.goal

    # Primitive requirements for the goal.
    needed_prims = world.cookbook.primitives_for(goal_idx).copy()
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_name = recipe["_at"]
        workshop_idx = world.cookbook.index[workshop_name]

    # Work on mutable copies of grid and inventory.
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    cur_pos = tuple(state.pos)

    plan = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, req_cnt in needed_prims.items():
        while inventory[prim_idx] < req_cnt:
            # Locate all cells that currently contain this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not available – abort planning.
                return plan
            # Choose the closest primitive (Manhattan distance).
            dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
            target = tuple(prim_cells[dists.argmin()])

            # Move to the chosen primitive.
            moves = _bfs_path(grid, cur_pos, lambda p, t=target: p == t)
            plan.extend(moves)
            cur_pos = target

            # Pick up the primitive.
            plan.append(4)   # USE
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Go to the required workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        # Find all workshop cells.
        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size == 0:
            return plan

        width, height = grid.shape[0], grid.shape[1]
        best_path = None
        best_target = None

        # Try to stand on a free neighbour of a workshop (or the workshop cell itself if free).
        for wx, wy in ws_cells:
            candidates = [(wx, wy),
                          (wx - 1, wy), (wx + 1, wy),
                          (wx, wy - 1), (wx, wy + 1)]
            for cx, cy in candidates:
                if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):
                    path = _bfs_path(grid, cur_pos, lambda p, t=(cx, cy): p == t)
                    if best_path is None or len(path) < len(best_path):
                        best_path = path
                        best_target = (cx, cy)

        if best_path is None:
            return plan

        plan.extend(best_path)
        cur_pos = best_target

        # Use at the workshop to craft.
        plan.append(4)   # USE
    else:
        # No specific workshop – just use at current location.
        plan.append(4)   # USE

    return plan


    import numpy as np
    from collections import deque

    # Mapping from movement delta to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3)
    _delta_to_action = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }
    _USE = 4

    def _is_free(grid, x, y):
        """A cell is free if no entity occupies any channel."""
        return grid[x, y, :].sum() == 0

    def _neighbors(pos, width, height):
        """Yield orthogonal neighbours and their deltas."""
        x, y = pos
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nx, ny = x + dx, y + dy
            if 0 <= nx < width and 0 <= ny < height:
                yield (nx, ny), (dx, dy)

    def _bfs_path(grid, start, goal_cond):
        """
        Bread‑first search that returns a list of actions moving the agent
        from ``start`` to any cell satisfying ``goal_cond``.
        """
        width, height = grid.shape[0], grid.shape[1]
        q = deque([start])
        came_from = {start: None}
        move_from = {}
        while q:
            cur = q.popleft()
            if goal_cond(cur):
                # reconstruct actions
                actions = []
                while came_from[cur] is not None:
                    dx, dy = move_from[cur]
                    actions.append(_delta_to_action[(dx, dy)])
                    cur = came_from[cur]
                actions.reverse()
                return actions
            for nxt, delta in _neighbors(cur, width, height):
                if nxt not in came_from and _is_free(grid, *nxt):
                    came_from[nxt] = cur
                    move_from[nxt] = delta
                    q.append(nxt)
        # no path found
        return []

    # ------------------------------------------------------------------
    # Gather static information from the environment.
    # ------------------------------------------------------------------
    state = env._current_state          # CraftState
    world = env.world                   # CraftWorld
    goal_idx = env.task.goal            # integer index of the desired item

    # Primitive requirements for the goal (and required counts).
    needed_prims = world.cookbook.primitives_for(goal_idx).copy()

    # Determine if the recipe needs a specific workshop.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = world.cookbook.index[recipe["_at"]]

    # Make mutable copies that we will update while planning.
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    cur_pos = tuple(state.pos)

    plan = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, req_cnt in needed_prims.items():
        while inventory[prim_idx] < req_cnt:
            # Locate all cells containing this primitive.
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present – abort planning.
                return plan

            # Choose the closest primitive (Manhattan distance).
            dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
            target = tuple(prim_cells[dists.argmin()])

            # Move to the chosen primitive.
            moves = _bfs_path(grid, cur_pos, lambda p, t=target: p == t)
            plan.extend(moves)
            cur_pos = target

            # Pick it up.
            plan.append(_USE)
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Go to the required workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size == 0:
            return plan

        width, height = grid.shape[0], grid.shape[1]
        best_path = None
        best_target = None

        # Try to stand on the workshop cell itself or any free orthogonal neighbour.
        for wx, wy in ws_cells:
            candidates = [(wx, wy),
                          (wx - 1, wy), (wx + 1, wy),
                          (wx, wy - 1), (wx, wy + 1)]
            for cx, cy in candidates:
                if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):
                    path = _bfs_path(grid, cur_pos,
                                     lambda p, t=(cx, cy): p == t)
                    if best_path is None or len(path) < len(best_path):
                        best_path = path
                        best_target = (cx, cy)

        if best_path is not None:
            plan.extend(best_path)
            cur_pos = best_target
            plan.append(_USE)  # craft at the workshop
    else:
        # No workshop needed – simply use at the current location.
        plan.append(_USE)

    return plan

