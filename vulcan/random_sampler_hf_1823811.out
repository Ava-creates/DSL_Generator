    # Reset environment and fetch useful references
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # Name ↔ integer ID mapping

    # Resolve action indices from the environment spec
    action_map = env.action_specs()
    DOWN = action_map.get("DOWN", 0)
    UP = action_map.get("UP", 1)
    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                     # Arrow not defined in this world
    goal_idx = index[goal_name]      # Integer id of the arrow item

    # Primitive requirements for crafting one arrow (empty if arrow is primitive)
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                     # List of actions to be returned

    # ------------------------------------------------------------------
    # Helper: BFS to find a path avoiding occupied cells (except the target).
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    h, w = state.grid.shape[:2]
    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    def bfs_path(start, target):
        """Return a list of movement actions from start to target."""
        if start == target:
            return []
        queue = deque([start])
        visited = {start}
        parent = {}
        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)
        if target not in parent and start != target:
            return []      # No path found.
        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Phase 1: Collect required primitives (respecting multiplicities).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive missing; abort early.
                return actions
            # Choose the nearest primitive cell (Manhattan distance).
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            tr, tc = tuple(prim_cells[dists.argmin()])
            # Move to that cell.
            actions.extend(bfs_path(state.pos, (tr, tc)))
            state.pos = (tr, tc)
            # Pick it up.
            actions.append(USE)
            # Update internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # Phase 2: Craft the arrow at its workshop (if any), otherwise pick up.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        # Arrow must be crafted at a specific workshop.
        workshop_idx = index[workshop_name]
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return actions          # No workshop found; cannot craft.
        wr, wc = tuple(workshop_cells[0])
        actions.extend(bfs_path(state.pos, (wr, wc)))
        state.pos = (wr, wc)
        actions.append(USE)          # Craft at the workshop.
    else:
        # No workshop required – arrow is a primitive item itself.
        arrow_cells = np.argwhere(state.grid[:, :, goal_idx] > 0)
        if arrow_cells.size == 0:
            return actions          # Arrow not present anywhere.
        tr, tc = tuple(arrow_cells[0])
        actions.extend(bfs_path(state.pos, (tr, tc)))
        state.pos = (tr, tc)
        actions.append(USE)          # Pick up the arrow.

    return actions


    # Reset environment and fetch useful references
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # Name ↔ integer ID mapping

    # Resolve action indices from the environment specification
    action_map = env.action_specs()
    DOWN = action_map.get("DOWN", 0)
    UP = action_map.get("UP", 1)
    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    # Goal item name
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []   # Arrow not defined in this world
    goal_idx = index[goal_name]

    # Primitive requirements for the goal (including multiplicities)
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS pathfinder that avoids occupied cells (except target)
    # ------------------------------------------------------------------
    from collections import deque
    h, w = state.grid.shape[:2]
    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    def bfs_path(start, target):
        """Return a list of movement actions from start to target."""
        if start == target:
            return []

        queue = deque([start])
        visited = {start}
        parent = {}

        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)

                # Allow stepping onto the target even if it is occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        if target not in parent and start != target:
            return []   # No path found

        # Reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Phase 1: Collect all required primitives (respecting counts)
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate cells that currently contain this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive unavailable – abort early.
                return actions

            # Choose the nearest primitive cell (Manhattan distance).
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            tr, tc = prim_cells[dists.argmin()]

            # Move to the primitive.
            move_seq = bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update internal copy of state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # Phase 2: Go to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions   # No workshop information; cannot craft.

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions   # No workshop present in the world.

    # Choose nearest workshop.
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]

    # Move to workshop.
    move_seq = bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions

