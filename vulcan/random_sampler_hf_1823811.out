    # reset environment and retrieve world information
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # goal index (arrow) and primitive requirements (including transitive)
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # workshop needed for final crafting step (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    wk = recipe.get('_at')
    workshop_kind = None
    if wk is not None:
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    # movement directions: 0=DOWN,1=UP,2=LEFT,3=RIGHT
    dirs = [(0, 1, 0),   # DOWN
            (0, -1, 1),  # UP
            (-1, 0, 2),  # LEFT
            (1, 0, 3)]   # RIGHT

    # check if a cell can be stepped on (allow stepping on kinds in `allow`)
    def cell_free(x, y, grid, allow):
        W, H, _ = grid.shape
        if not (0 <= x < W and 0 <= y < H):
            return False
        cell = grid[x, y]
        if np.sum(cell) == 0:
            return True
        present = np.where(cell > 0)[0]
        return all(k in allow for k in present)

    # breadth‑first search returning a list of actions to reach any target cell
    def bfs(start, targets, grid, allow=set()):
        W, H, _ = grid.shape
        visited = np.full((W, H), False, dtype=bool)
        parent = {}
        q = collections.deque()
        q.append(start)
        visited[start[0], start[1]] = True
        while q:
            x, y = q.popleft()
            if (x, y) in targets:
                # reconstruct path
                seq = []
                cur = (x, y)
                while cur != start:
                    prev, act = parent[cur]
                    seq.append(act)
                    cur = prev
                seq.reverse()
                return seq
            for dx, dy, act in dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < W and 0 <= ny < H):
                    continue
                if visited[nx, ny]:
                    continue
                if not cell_free(nx, ny, grid, allow):
                    continue
                visited[nx, ny] = True
                parent[(nx, ny)] = ((x, y), act)
                q.append((nx, ny))
        return []  # no path found

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)               # agent's current (x, y)
    cur_grid = np.copy(state.grid)           # mutable copy to reflect pickups

    # collect each required primitive
    for kind, cnt in required.items():
        for _ in range(cnt):
            # locate primitive cells still present
            prim_cells = np.argwhere(cur_grid[:, :, kind] > 0)
            if prim_cells.size == 0:
                continue  # primitive not on map
            # choose the primitive cell with smallest Manhattan distance
            dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
            prim_idx = int(np.argmin(dists))
            prim_pos = tuple(prim_cells[prim_idx])

            # find a free neighbour of the primitive to stand on
            neighbour = None
            for dx, dy, _ in dirs:
                nx, ny = prim_pos[0] + dx, prim_pos[1] + dy
                if cell_free(nx, ny, cur_grid, allow=set()):
                    neighbour = (nx, ny)
                    break
            if neighbour is None:
                continue  # cannot reach this primitive

            # move to the neighbour cell
            move_seq = bfs(cur_pos, {neighbour}, cur_grid, allow=set())
            actions.extend(move_seq)
            cur_pos = neighbour

            # pick up the primitive
            actions.append(4)   # USE
            # remove it from our local copy of the grid
            cur_grid[prim_pos[0], prim_pos[1], kind] = 0

    # finally, go to the workshop (if required) and craft the goal
    if workshop_kind is not None:
        work_cells = np.argwhere(cur_grid[:, :, workshop_kind] > 0)
        if work_cells.size > 0:
            # pick the closest workshop cell
            dists = np.abs(work_cells[:, 0] - cur_pos[0]) + np.abs(work_cells[:, 1] - cur_pos[1])
            work_idx = int(np.argmin(dists))
            work_pos = tuple(work_cells[work_idx])

            # allow stepping onto the workshop cell itself
            move_seq = bfs(cur_pos, {work_pos}, cur_grid, allow={workshop_kind})
            actions.extend(move_seq)
            cur_pos = work_pos

            # craft the arrow
            actions.append(4)   # USE

    return actions


    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    recipe = world.cookbook.recipes.get(goal_idx, {})
    wk = recipe.get('_at')
    if wk is None:
        workshop_kind = None
    else:
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions = []
    cur_pos = tuple(state.pos)

    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE

    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE

    return actions

