    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (must match CraftLab.action_specs)
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS to any free cell adjacent to a target cell
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        """Return a list of actions moving from *start* to a free 4‑adjacent
        cell of *target*.  Empty list if unreachable."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []                     # target completely surrounded

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []                         # unreachable

    # ----------------------------------------------------------------------
    # Reset / fetch current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []                         # cannot obtain state

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                         # arrow not defined

    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # locate workshop name in recipe (key "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                         # no workshop info

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                         # workshop not indexed

    # ----------------------------------------------------------------------
    # Local mutable copies for planning
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                 # (x, y)
    grid = state.grid.copy()               # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)    # bool matrix of blocked cells

    plan = []

    # ----------------------------------------------------------------------
    # Helper: move adjacent to a cell containing *kind_idx* and USE it
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Navigate adjacent to *target*, issue USE and update simulated
        world state. Returns False if movement impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # simulate movements
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # USE action
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.shape[0] == 0:
                # primitive missing on map – abort planning
                return plan
            # choose nearest by Manhattan distance
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = tuple(candidates[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # fall back to original scenario grid (workshops never disappear)
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    # ----------------------------------------------------------------------
    # Return the constructed action list
    # ----------------------------------------------------------------------
    return plan


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (must match CraftLab.action_specs)
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of actions moving from *start* to any
    # free cell that is 4‑adjacent to *target*.  Returns empty list if not
    # reachable.
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []                     # target completely surrounded

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []                         # unreachable

    # ----------------------------------------------------------------------
    # Reset environment and fetch the current CraftState
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []                         # cannot obtain state

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                         # arrow not defined in index

    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # locate workshop name in the recipe (key "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                         # no workshop information

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                         # workshop not indexed

    # ----------------------------------------------------------------------
    # Local mutable copies for planning simulation
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                 # (x, y)
    grid = state.grid.copy()               # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)    # bool matrix of blocked cells

    plan = []

    # ----------------------------------------------------------------------
    # Helper: move adjacent to a cell containing *kind_idx* and USE it.
    # Updates simulated position, grid, occupied mask and inventory.
    # Returns False if movement is impossible.
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # simulate the movements
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # issue USE
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            # picking up a primitive (or tool); remove from grid
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.shape[0] == 0:
                # primitive not present on map – abort planning
                return plan
            # choose the closest by Manhattan distance
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = tuple(candidates[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # workshops are static; fall back to original scenario grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    # ----------------------------------------------------------------------
    # Return the planned sequence of actions
    # ----------------------------------------------------------------------
    return plan

