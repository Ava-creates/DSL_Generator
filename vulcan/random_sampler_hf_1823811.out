                            path.reverse()
                            return path
                        q.append(nxt)
        return [start]

    actions = []
    cur_pos = state.pos

    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            locs = find_locations(prim_idx)
            if not locs:
                continue
            target = locs[0]
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE

    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = wk_locs[0]
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE

    return actions

