    env.reset()
    state = env._current_state
    world = env.world

    # Action indices
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']
    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    import collections
    import numpy as np

    def find_path(cur_state, target_kind):
        """BFS returning movement actions to reach a cell containing target_kind."""
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # cell is free or is the target cell
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # unreachable – return empty list
        return []

    actions = []

    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)  # {primitive_idx: count}

    # 1) Collect all required primitives
    for kind_idx, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, kind_idx)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # pick up the primitive
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # 2) Move to workshop (if any) and craft the goal
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

