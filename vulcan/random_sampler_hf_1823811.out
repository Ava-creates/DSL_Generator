    # Reset environment and grab useful handles
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Index of the goal item ("arrow") and its primitive requirements
    arrow_idx = cookbook.index["arrow"]
    primitive_requirements = cookbook.primitives_for(arrow_idx)

    # Determine the workshop (if any) where the arrow must be crafted
    workshop_idx = None
    recipe = cookbook.recipes.get(arrow_idx, {})
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    actions = []

    # Helper: append actions that move from cur_pos to target_pos (Manhattan moves)
    def _move_and_use(cur_pos, target_pos):
        x, y = cur_pos
        tx, ty = target_pos
        # horizontal moves (x axis)
        while x < tx:
            actions.append(3)   # RIGHT
            x += 1
        while x > tx:
            actions.append(2)   # LEFT
            x -= 1
        # vertical moves (y axis)
        while y < ty:
            actions.append(0)   # DOWN
            y += 1
        while y > ty:
            actions.append(1)   # UP
            y -= 1
        # interact with the cell (pick up / craft)
        actions.append(4)       # USE
        return (x, y)

    cur_pos = tuple(state.pos)

    # ----------------------------------------------------------------------
    # 1. Collect all required primitive items
    # ----------------------------------------------------------------------
    for kind_idx, needed in primitive_requirements.items():
        # Locate all cells that currently contain this primitive
        locations = [tuple(pos) for pos in np.argwhere(state.grid[:, :, kind_idx] > 0)]
        if not locations:
            continue  # nothing to collect; should not happen for a valid scenario

        # Simple greedy nearest‑neighbor collection
        for _ in range(needed):
            # find the nearest location (Manhattan distance)
            dists = [abs(cur_pos[0] - lx) + abs(cur_pos[1] - ly) for (lx, ly) in locations]
            nearest_idx = int(np.argmin(dists))
            target = locations.pop(nearest_idx)  # remove so we don't reuse it
            cur_pos = _move_and_use(cur_pos, target)

    # ----------------------------------------------------------------------
    # 2. Go to the appropriate workshop (if required) and craft the arrow
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = [tuple(pos) for pos in np.argwhere(state.grid[:, :, workshop_idx] > 0)]
        if workshop_cells:
            cur_pos = _move_and_use(cur_pos, workshop_cells[0])
            # second USE actually performs the crafting at the workshop
            actions.append(4)

    return actions


    import numpy as np

    # Reset environment to get initial state
    env.reset()
    state = env._current_state          # CraftState instance
    world = env.world
    cookbook = world.cookbook

    # Index of the target item "arrow"
    arrow_idx = cookbook.index["arrow"]
    # Primitive requirements for one arrow
    primitive_needs = cookbook.primitives_for(arrow_idx)

    # Workshop where the arrow must be crafted (if any)
    workshop_idx = None
    recipe = cookbook.recipes.get(arrow_idx, {})
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    actions = []

    # Helper: move from cur_pos to a target cell (Manhattan moves) and then USE
    def move_and_use(cur_pos, target_pos):
        x, y = cur_pos
        tx, ty = target_pos
        # move horizontally
        while x < tx:
            actions.append(3)   # RIGHT
            x += 1
        while x > tx:
            actions.append(2)   # LEFT
            x -= 1
        # move vertically
        while y < ty:
            actions.append(0)   # DOWN
            y += 1
        while y > ty:
            actions.append(1)   # UP
            y -= 1
        # use action on the cell we are standing on (assumes item can be taken)
        actions.append(4)       # USE
        return (x, y)

    cur_pos = tuple(state.pos)

    # Collect each required primitive
    for kind_idx, count in primitive_needs.items():
        # Find all locations of this primitive on the grid
        locations = np.argwhere(state.grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            continue  # no such primitive; skip (should not happen in a valid scenario)

        # Gather the needed amount, cycling through available locations if necessary
        for i in range(count):
            target = tuple(locations[i % len(locations)])
            cur_pos = move_and_use(cur_pos, target)

    # After having all primitives, go to the workshop (if defined) and craft
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            cur_pos = move_and_use(cur_pos, tuple(workshop_cells[0]))
            actions.append(4)   # final USE to craft the arrow

    return actions

