    import numpy as np

    # Helper: map movement direction to action index (as defined in CraftLab)
    DIR2ACT = {
        (1, 0): 0,   # DOWN
        (-1, 0): 1,  # UP
        (0, -1): 2,  # LEFT
        (0, 1): 3,   # RIGHT
    }

    def _move_actions(src, dst):
        """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) to go from src to dst
        using a simple Manhattan‑distance greedy strategy."""
        actions = []
        r, c = src
        tr, tc = dst
        while r != tr:
            dr = 1 if tr > r else -1
            act = DIR2ACT[(dr, 0)]
            actions.append(act)
            r += dr
        while c != tc:
            dc = 1 if tc > c else -1
            act = DIR2ACT[(0, dc)]
            actions.append(act)
            c += dc
        return actions

    # -------------------------------------------------------------------------
    # 1. Resolve indices for the goal item ("arrow") and its recipe.
    # -------------------------------------------------------------------------
    world = env.world
    cookbook = world.cookbook

    # obtain the integer index for the goal name; fall back to searching the index dict
    try:
        goal_idx = cookbook.index["arrow"]
    except Exception:  # pragma: no cover
        raise ValueError("Goal \"arrow\" not found in recipe index.")

    # primitive requirements for a single arrow (does not include intermediate items)
    primitive_needs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    if not primitive_needs:
        # no recipe – nothing to do
        return []

    # -------------------------------------------------------------------------
    # 2. Gather current state information.
    # -------------------------------------------------------------------------
    state = env._current_state            # CraftState instance
    grid = state.grid                      # (W, H, n_kinds)
    pos = tuple(state.pos)                 # (row, col)

    actions_plan = []

    # -------------------------------------------------------------------------
    # 3. Collect each required primitive.
    # -------------------------------------------------------------------------
    for kind, cnt in primitive_needs.items():
        for _ in range(cnt):
            # locate all cells that currently contain this primitive
            locations = np.argwhere(grid[:, :, kind] > 0)
            if locations.size == 0:
                # primitive not present – cannot continue
                return actions_plan

            # pick the nearest location (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            nearest_idx = np.argmin(dists)
            target = tuple(locations[nearest_idx])

            # move to the target cell
            actions_plan.extend(_move_actions(pos, target))
            pos = target  # update our virtual position

            # use the item (the USE action is always index 4)
            actions_plan.append(4)

            # simulate the pick‑up so subsequent searches see the item removed
            grid[target[0], target[1], kind] -= 1

    # -------------------------------------------------------------------------
    # 4. Move to the appropriate workshop and craft the arrow.
    # -------------------------------------------------------------------------
    # The workshop name is stored under the special key "_at" in the recipe dict.
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        # recipe does not specify a workshop – assume current cell is fine
        actions_plan.append(4)  # just use to attempt crafting
        return actions_plan

    workshop_idx = cookbook.index.get(workshop_name)
    if workshop_idx is None:
        # unknown workshop – abort
        return actions_plan

    # locate any workshop cell of that type
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # no workshop present – cannot craft
        return actions_plan

    # choose the nearest workshop
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    nearest_idx = np.argmin(dists)
    workshop_pos = tuple(workshop_cells[nearest_idx])

    # move to the workshop cell
    actions_plan.extend(_move_actions(pos, workshop_pos))
    pos = workshop_pos

    # finally, perform the crafting action
    actions_plan.append(4)

    return actions_plan


    # Action indices (as defined in CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Helper: Manhattan move actions from src to dst
    def _move_actions(src, dst):
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        # move in x direction
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        # move in y direction
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    # Helper: find nearest cell containing a given kind (returns its coordinates)
    def _nearest_kind(pos, kind_idx):
        grid = env._current_state.grid
        # locate all cells where this kind is present
        locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))
        if not locations:
            return None
        # choose the one with minimal Manhattan distance
        distances = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]
        return locations[int(np.argmin(distances))]

    # ------------------------------------------------------------------
    # 1. Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    # primitive requirements for one arrow
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
    # 2. Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos

    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target = _nearest_kind(cur_pos, prim_idx)
            if target is None:
                # primitive not present – cannot continue
                return actions
            # move to the primitive cell (or adjacent cell)
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            # pick it up
            actions.append(USE)

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop and craft the arrow
    # ------------------------------------------------------------------
    # the workshop type is stored under the special key "_at" in the recipe
    workshop_name = world.cookbook.recipes[arrow_idx].get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)  # craft at the workshop

    return actions

