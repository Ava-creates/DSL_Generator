    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # goal definition
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitive requirements (recursive)
    prim_counts = world.cookbook.primitives_for(goal_idx)

    # workshop required for crafting, if any
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # helper utilities
    # ------------------------------------------------------------------
    def find_positions(kind):
        """Return list of (x, y) where `kind` occurs on the current grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def blocked_cells():
        """Set of coordinates occupied by non‑grabbable entities."""
        blk = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blk.update(zip(occ[0].tolist(), occ[1].tolist()))
        return blk

    def bfs(start, goal):
        """Shortest 4‑connected path from start to goal avoiding blocked cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        blocked = blocked_cells()
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # no path – stay where we are
        return [start]

    def move_to(cur, nxt):
        """Translate a step into the corresponding action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("non‑adjacent step requested")

    # ------------------------------------------------------------------
    # build the action list
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) collect all required primitives
    for prim_idx, needed in prim_counts.items():
        while state.inventory[prim_idx] < needed:
            locations = find_positions(prim_idx)
            if not locations:
                # cannot satisfy requirement – break out
                break
            # nearest primitive by Manhattan distance
            target = min(
                locations,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            # move to it
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_to(cur_pos, step))
                cur_pos = step
            # pick up
            actions.append(4)   # USE
            # update simulated state
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2) go to workshop (if needed) and craft
    if workshop_kind is not None:
        wk_locs = find_positions(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_to(cur_pos, step))
                cur_pos = step
    # craft (USE)
    actions.append(4)

    return actions


    # Reset environment and obtain references
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its requirements
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive counts needed to craft one arrow (expanded recursively)
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Workshop kind required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) positions where `kind` exists on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Return shortest path (list of positions) from start to goal,
        avoiding cells occupied by non‑grabbable entities."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Build blocked set from current grid
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay where we are
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur to adjacent nxt into an action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not adjacent")

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            locations = find_locations(prim_idx)
            if not locations:
                # Primitive unavailable – stop trying to collect it
                break

            # Choose the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )

            # Move to the target location
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)   # USE
            # Update simulated state so subsequent searches see the change
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            target = min(
                wk_locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

    # Craft the arrow (USE at the current location – workshop or otherwise)
    actions.append(4)   # USE

    return actions

