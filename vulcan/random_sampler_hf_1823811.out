    # Reset the environment and obtain the initial state and world objects.
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Index of the goal item (arrow) to be crafted.
    goal_idx = env.task.goal

    # Retrieve the mapping from action names to integer indices.
    action_map = env.action_specs()
    ACTION_DOWN = action_map['DOWN']
    ACTION_UP = action_map['UP']
    ACTION_LEFT = action_map['LEFT']
    ACTION_RIGHT = action_map['RIGHT']
    ACTION_USE = action_map['USE']

    # Direction vectors paired with their corresponding actions.
    move_dirs = [
        (1, 0, ACTION_DOWN),   # down
        (-1, 0, ACTION_UP),    # up
        (0, -1, ACTION_LEFT),  # left
        (0, 1, ACTION_RIGHT)   # right
    ]

    # List that will accumulate the sequence of actions to be returned.
    actions = []

    # ------------------------------------------------------------------
    # Helper: breadth‑first search that returns a list of movement actions
    # leading from the agent's current position to any cell containing the
    # specified target_kind.  Cells occupied by other entities are treated
    # as obstacles, except the target cell itself.
    # ------------------------------------------------------------------
    import collections
    import numpy as np

    def find_path(cur_state, target_kind):
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                occupied = np.any(grid[nx, ny, :] > 0)
                # Allow stepping onto the target cell even if it is occupied.
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # If no path is found (should not happen in a well‑formed scenario)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources for the goal.
    # ------------------------------------------------------------------
    required = world.cookbook.primitives_for(goal_idx)   # {primitive_kind: count}
    for prim_kind, count in required.items():
        for _ in range(count):
            # Move to a cell containing the primitive.
            path_to_prim = find_path(state, prim_kind)
            for act in path_to_prim:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive that is now under the agent.
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path_to_ws = find_path(state, workshop_kind)
        for act in path_to_ws:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the item.
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # Return the complete action sequence.
    return actions


