    # Reset environment and get initial state
    env.reset()
    state = env._current_state

    # ------------------------------------------------------------------
    # Determine the index of the goal item ("arrow")
    # ------------------------------------------------------------------
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow goal not found in cookbook")

    # ------------------------------------------------------------------
    # Action specifications (indices)
    # ------------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to find a walkable path (list of actions) between two cells
    # ------------------------------------------------------------------
    def bfs_path(start, target):
        from collections import deque

        h, w, _ = state.grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN), (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT), (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # allow stepping onto the target even if occupied
                    if not state.grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # no path found

    # ------------------------------------------------------------------
    # Helper: Move the agent to an absolute position using the planner
    # ------------------------------------------------------------------
    def move_to(pos):
        nonlocal actions, state
        while state.pos != pos:
            path = bfs_path(state.pos, pos)
            if not path:      # stuck – abort further movement
                break
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == pos:
                    break

    # ------------------------------------------------------------------
    # Helper: Locate the nearest cell containing a given kind index
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: Choose a free cell (including the target cell itself) adjacent to a given cell
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the cell itself if it is free
        if not state.grid[y, x, :].any():
            return (y, x)
        # Search 8‑neighbourhood for a free tile
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        # Fallback: current position (should always be free)
        return state.pos

    # ------------------------------------------------------------------
    # 1) Collect all primitive resources required for the arrow
    # ------------------------------------------------------------------
    needed_primitives = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    for kind_idx, cnt in needed_primitives.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                # Primitive not present on the map – skip it
                continue
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)       # pick up / collect
            env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # 2) Go to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj_ws = adjacent_free(ws_pos)
            move_to(adj_ws)
            actions.append(ACT_USE)       # craft at workshop
            env.step(ACT_USE)
            state = env._current_state

    # Return the assembled list of actions
    return actions


    # Reset the environment and get the initial state.
    env.reset()
    state = env._current_state

    # Determine the index of the goal item (arrow).
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow goal not found in the cookbook")

    # Action indices.
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions to move from start to goal.
    # Allows stepping onto the goal cell even if occupied.
    # ------------------------------------------------------------------
    def bfs_path(start, goal):
        from collections import deque

        h, w, _ = state.grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            y, x = q.popleft()
            if (y, x) == goal:
                break
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:
                    # Allow moving onto the goal even if it is occupied.
                    if not state.grid[ny, nx, :].any() or (ny, nx) == goal:
                        visited[ny, nx] = True
                        prev[(ny, nx)] = ((y, x), act)
                        q.append((ny, nx))

        if start == goal:
            return []
        if goal not in prev:
            return []  # No path found.

        # Reconstruct actions.
        rev = []
        cur = goal
        while cur != start:
            cur, act = prev[cur]
            rev.append(act)
        rev.reverse()
        return rev

    # ------------------------------------------------------------------
    # Helper: Move the agent to an absolute position using BFS planner.
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal actions, state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:  # Stuck; abort.
                break
            for a in path:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: Find the nearest cell containing a specific kind index.
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: Return a free cell (including the target itself) adjacent to `cell`.
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the cell itself if it is free.
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        # Fallback to current position (should never happen in well‑formed maps).
        return state.pos

    # ------------------------------------------------------------------
    # 1) Collect all primitive resources required for the goal.
    # ------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                # Primitive not present; skip.
                continue
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)          # Pick up / collect.
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if required) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj_ws = adjacent_free(ws_pos)
            move_to(adj_ws)
            actions.append(ACT_USE)          # Craft at workshop.
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # Return the assembled list of actions.
    return actions

