    # code...


    # Reset environment and obtain references to the underlying world objects.
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # name ↔ integer id mapping

    # Action identifiers (match CraftLab.action_specs())
    spec = env.action_specs()
    DOWN = spec.get('DOWN', 0)
    UP = spec.get('UP', 1)
    LEFT = spec.get('LEFT', 2)
    RIGHT = spec.get('RIGHT', 3)
    USE = spec.get('USE', 4)

    # ------------------------------------------------------------------
    # Identify the target item (arrow) and the primitive ingredients required.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # no such goal in this world

    goal_idx = index[goal_name]          # integer id for the arrow
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                         # final action sequence

    # ------------------------------------------------------------------
    # Helper: Bread‑first search returning a list of move actions from start to target.
    # The target cell may be occupied (primitive or workshop); all other cells
    # must be empty (i.e. no entity of any kind present).
    # ------------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        """Return a list of move actions (DOWN/UP/LEFT/RIGHT) to reach target."""
        if start == target:
            return []

        h, w = state.grid.shape[:2]
        queue = deque([start])
        visited = {start}
        parent = {}

        moves = [(DOWN, (1, 0)),
                 (UP,   (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT,(0, 1))]

        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        if target not in parent and start != target:
            return []          # no path found

        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find any cell currently holding this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive missing – abort early.
                return actions
            tr, tc = prim_cells[0]

            # Move to the primitive cell.
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # no workshop information

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # workshop not present

    wr, wc = workshop_cells[0]

    # Move to the workshop cell.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions

