    # Reset environment and fetch initial objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Goal index for the arrow (or whatever the current task is)
    goal_idx = env.task.goal

    # Map action names to integer codes from the environment spec
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    # Direction vectors paired with their corresponding movement actions
    move_dirs = [
        (1, 0, ACTION_DOWN),   # down
        (-1, 0, ACTION_UP),    # up
        (0, -1, ACTION_LEFT),  # left
        (0, 1, ACTION_RIGHT),  # right
    ]

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions leading to a cell
    # that contains `target_kind`.  The agent may step onto empty cells or
    # directly onto the target cell; any other occupied cell is treated as
    # an obstacle.
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def find_path(cur_state, target_kind):
        """Return a list of movement actions that brings the agent to a
        cell containing `target_kind`. If already on such a cell, return
        an empty list."""
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos

        # Already on a target cell
        if grid[start[0], start[1], target_kind] > 0:
            return []

        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()

            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue

                cell = grid[nx, ny, :]
                occupied = np.any(cell > 0)

                # Can move onto empty cells or the target cell itself
                if occupied and cell[target_kind] == 0:
                    continue

                new_path = path + [act]
                # If this neighbor contains the target, we're done
                if cell[target_kind] > 0:
                    return new_path

                visited.add((nx, ny))
                q.append(((nx, ny), new_path))

        # No reachable target (should not happen in a valid scenario)
        return []

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items for the goal.
    # ------------------------------------------------------------------
    required_primitives = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    for kind_idx, needed_cnt in required_primitives.items():
        for _ in range(needed_cnt):
            # Move to the nearest cell that holds the primitive
            path_to_primitive = find_path(state, kind_idx)
            for a in path_to_primitive:
                _, state = state.step(a)
                actions.append(a)

            # Pick up the primitive (USE action)
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path_to_workshop = find_path(state, workshop_kind)
        for a in path_to_workshop:
            _, state = state.step(a)
            actions.append(a)

        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # Return the full action sequence that should accomplish the task
    return actions


