    from collections import deque

    def bfs_path(cur_state, target_kind):
        """
        Bread‑first search that returns a list of movement actions leading the
        agent to any cell containing `target_kind`. The agent may step onto the
        target cell even if it is occupied; otherwise it may only step onto
        empty cells (no entities present).
        """
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            # Goal reached if the target kind is present in this cell
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    # Can move onto an empty cell or directly onto the target cell
                    if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # If we exit the loop, the target is unreachable (should not happen)
        return []

    # ----------------------------------------------------------------------
    # 1) Collect all required primitive items (one at a time)
    # ----------------------------------------------------------------------
    for kind_idx, count in required.items():
        for _ in range(count):
            # Find path to the nearest cell containing this primitive
            path = bfs_path(state, kind_idx)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive with USE
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ----------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal item
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = bfs_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

