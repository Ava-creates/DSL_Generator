    # Reset environment and obtain state/world information
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Identify the goal item and its recipe
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []
    primitive_needs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Return a list of positions from start (excluded) to goal (included) or None."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Allow stepping onto the goal even if occupied
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ------------------------------------------------------------------
    # Planning: collect primitives, then craft at workshop (if any)
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)
    grid = state.grid.copy()          # mutable copy to track collected items

    # --- Collect required primitives -------------------------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                break
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(grid, axis=2)
            target = None
            path = None
            for idx in order:
                cand = tuple(locations[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    target = cand
                    path = p
                    break
            if target is None:
                continue
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            actions.append(4)                     # USE to pick up
            grid[target[0], target[1], kind_idx] = 0

    # --- Move to workshop (if required) and craft -----------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops are occupied)
            for idx in order:
                cand = tuple(workshop_cells[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    for step in p:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)                 # USE to craft
                    break
    else:
        actions.append(4)  # USE at current location if no workshop needed

    return actions


    # Reset environment and get current state/world information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # Identify the goal item ("arrow") and its recipe
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # Helper: BFS to find a walkable path from start to goal (allow stepping onto goal)
    def bfs_path(start, goal, occupied):
        w, h = occupied.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Goal cell may be occupied; treat it as walkable
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path (list of positions, excluding start, including goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    # Helper: translate a step delta into an action index
    def step_to_action(dx, dy):
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid step delta")

    actions = []
    cur_pos = tuple(state.pos)
    # mutable copy of the grid to keep track of collected primitives
    grid = state.grid.copy()

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # locate remaining cells containing this primitive
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                break  # nothing left of this kind
            # sort by Manhattan distance from current position
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(grid, axis=2)   # cells occupied by any entity
            target = None
            path = None
            for idx in order:
                cand = tuple(locations[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    target = cand
                    path = p
                    break
            if target is None:
                continue  # cannot reach any remaining instance
            # follow the path
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(step_to_action(dx, dy))
                cur_pos = step
            # pick up the primitive
            actions.append(4)                     # USE
            grid[target[0], target[1], kind_idx] = 0

    # ----------------------------------------------------------------------
    # Go to the workshop (if required) and craft the arrow
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops are occupied)
            for idx in order:
                cand = tuple(workshop_cells[idx])
                p = bfs_path(cur_pos, cand, occupied_mask)
                if p is not None:
                    for step in p:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(step_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)                 # USE to craft
                    break
    else:
        # No specific workshop required; just use at current location
        actions.append(4)  # USE

    return actions

