            elif dx < 0:
                acts += [UP] * (-dx)
            if dy > 0:
                acts += [RIGHT] * dy
            elif dy < 0:
                acts += [LEFT] * (-dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(grid, pos, kind_idx):
