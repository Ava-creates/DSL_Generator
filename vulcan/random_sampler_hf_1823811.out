    # Reset environment to obtain fresh state and world information
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal item index and its primitive requirements (one unit of the goal)
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the final crafting must happen at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # Grid dimensions and static layout (entities never move)
    grid = scenario.init_grid
    width, height, _ = grid.shape
    non_grabbable = world.non_grabbable_indices

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def cell_blocked(pos):
        """Return True if any non‑grabbable entity occupies the cell."""
        x, y = pos
        for kind in non_grabbable:
            if grid[x, y, kind] > 0:
                return True
        return False

    def neighbours(pos):
        """Yield 4‑connected traversable neighbour positions."""
        x, y = pos
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nx, ny = x + dx, y + dy
            if 0 <= nx < width and 0 <= ny < height and not cell_blocked((nx, ny)):
                yield (nx, ny)

    def bfs(start, goal):
        """Breadth‑first search returning a list of positions from start to goal."""
        if start == goal:
            return [start]
        queue = collections.deque([start])
        came_from = {start: None}
        while queue:
            cur = queue.popleft()
            for nxt in neighbours(cur):
                if nxt not in came_from:
                    came_from[nxt] = cur
                    if nxt == goal:
                        # reconstruct path
                        path = [goal]
                        while path[-1] != start:
                            path.append(came_from[path[-1]])
                        path.reverse()
                        return path
                    queue.append(nxt)
        return []  # unreachable

    def path_to_actions(path):
        """Translate a list of positions into action indices."""
        acts = []
        for (x1, y1), (x2, y2) in zip(path, path[1:]):
            dx, dy = x2 - x1, y2 - y1
            if dx == 1 and dy == 0:
                acts.append(3)   # RIGHT
            elif dx == -1 and dy == 0:
                acts.append(2)   # LEFT
            elif dx == 0 and dy == 1:
                acts.append(0)   # DOWN
            elif dx == 0 and dy == -1:
                acts.append(1)   # UP
        return acts

    def nearest_entity(kind, from_pos):
        """Find the closest cell containing at least one entity of the given kind."""
        candidates = np.argwhere(grid[:, :, kind] > 0)
        if candidates.size == 0:
            return None
        # BFS from start until a candidate cell is reached
        visited = set()
        queue = collections.deque([from_pos])
        visited.add(from_pos)
        while queue:
            cur = queue.popleft()
            if any((cur[0] == cx and cur[1] == cy) for cx, cy in candidates):
                return cur
            for nxt in neighbours(cur):
                if nxt not in visited:
                    visited.add(nxt)
                    queue.append(nxt)
        return None

    # ------------------------------------------------------------------
    # Build action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)

    # Collect each required primitive the needed number of times
    for kind, count in required.items():
        for _ in range(count):
            target = nearest_entity(kind, cur_pos)
            if target is None:
                # Primitive not present on map – skip this instance
                continue
            path = bfs(cur_pos, target)
            if not path:
                # Unreachable – skip
                continue
            actions.extend(path_to_actions(path))
            cur_pos = target
            actions.append(4)   # USE to pick up the primitive

    # If a workshop is required, move there and use
    if workshop_kind is not None:
        target = nearest_entity(workshop_kind, cur_pos)
        if target is not None:
            path = bfs(cur_pos, target)
            if path:
                actions.extend(path_to_actions(path))
                cur_pos = target
                actions.append(4)   # USE to craft at the workshop

    return actions


    # Reset environment and grab useful references
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index and primitive requirements for that goal
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the final crafting must happen at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # Shortcut to static grid and non‑grabbable entity set
    grid = scenario.init_grid
    non_grabbable = world.non_grabbable_indices
    width, height, _ = grid.shape

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def cell_blocked(pos):
        """True if any non‑grabbable entity occupies the cell."""
        x, y = pos
        for kind in non_grabbable:
            if grid[x, y, kind] > 0:
                return True
        return False

    def bfs_to_target(start, target_pos):
        """Return list of positions from start to target (inclusive) using BFS."""
        if start == target_pos:
            return [start]
        from collections import deque
        q = deque([start])
        came = {start: None}
        while q:
            cur = q.popleft()
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not cell_blocked((nx, ny)):
                    nxt = (nx, ny)
                    if nxt not in came:
                        came[nxt] = cur
                        if nxt == target_pos:
                            # reconstruct path
                            path = [target_pos]
                            while path[-1] != start:
                                path.append(came[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        return []  # unreachable

    def bfs_to_kind(start, kind):
        """Find nearest reachable cell containing `kind`. Return (path, pos) or ([], None)."""
        # Gather all candidate cells that contain the kind
        candidates = np.argwhere(grid[:, :, kind] > 0)
        if candidates.size == 0:
            return [], None

        from collections import deque
        q = deque([start])
        came = {start: None}
        while q:
            cur = q.popleft()
            # Check if current cell is a candidate
            if any((cur[0] == cx and cur[1] == cy) for cx, cy in candidates):
                # reconstruct path
                path = [cur]
                while path[-1] != start:
                    path.append(came[path[-1]])
                path.reverse()
                return path, cur
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height and not cell_blocked((nx, ny)):
                    nxt = (nx, ny)
                    if nxt not in came:
                        came[nxt] = cur
                        q.append(nxt)
        return [], None

    def path_to_actions(path):
        """Convert consecutive positions to action indices (0:D,1:U,2:L,3:R)."""
        act = []
        for (x1, y1), (x2, y2) in zip(path, path[1:]):
            dx, dy = x2 - x1, y2 - y1
            if dx == 1 and dy == 0:
                act.append(3)   # RIGHT
            elif dx == -1 and dy == 0:
                act.append(2)   # LEFT
            elif dx == 0 and dy == 1:
                act.append(0)   # DOWN
            elif dx == 0 and dy == -1:
                act.append(1)   # UP
        return act

    # ------------------------------------------------------------------
    # Build action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)

    # Collect each required primitive the needed number of times
    for kind, count in required.items():
        for _ in range(count):
            path, target = bfs_to_kind(cur_pos, kind)
            if not path:
                # cannot reach this primitive; skip it
                continue
            actions.extend(path_to_actions(path))
            actions.append(4)          # USE to pick up
            cur_pos = target

    # If a workshop is required, move there and USE to craft
    if workshop_kind is not None:
        path, target = bfs_to_kind(cur_pos, workshop_kind)
        if path:
            actions.extend(path_to_actions(path))
            actions.append(4)      # USE to craft

    return actions

