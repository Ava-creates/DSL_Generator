    # Reset environment and get references to world components
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    idx = cookbook.index                # name ↔ integer id mapping

    # Resolve action indices from the environment specification
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    # ------------------------------------------------------------------
    # Helper: BFS shortest path from start to target (target may be occupied).
    # Returns a list of movement actions (indices) to reach the target.
    # ------------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)

        if target not in parent and start != target:
            return []  # unreachable

        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Helper: Locate the nearest cell that contains a given kind (primitive
    # or workshop). Returns (action_path, cell_coords) or ([], None) if not
    # found.
    # ------------------------------------------------------------------
    def _nearest_kind(kind_idx, start):
        # Already on a cell of the desired kind.
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                occupied = state.grid[nr, nc, :].sum() != 0
                # We may step onto a cell that holds the target kind even if occupied.
                if occupied and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # Reconstruct path to this cell.
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None  # not found

    # ------------------------------------------------------------------
    # Identify the goal item ('arrow') and the primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []  # arrow not defined in this world
    goal_idx = idx[goal_name]

    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    plan = []

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            path, cell = _nearest_kind(prim_idx, state.pos)
            if cell is None:
                # Primitive missing or unreachable – abort early.
                return plan
            plan.extend(path)
            state.pos = cell
            plan.append(USE)  # pick up the primitive
            # Update simulated state.
            r, c = cell
            state.inventory[prim_idx] += 1
            state.grid[r, c, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return plan  # no workshop information; cannot craft

    workshop_idx = idx[workshop_name]
    path, cell = _nearest_kind(workshop_idx, state.pos)
    if cell is None:
        return plan  # workshop unreachable
    plan.extend(path)
    state.pos = cell
    plan.append(USE)  # craft the arrow at the workshop

    return plan


    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    index = cookbook.index

    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]

    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    from collections import deque

    def _bfs_path(start, target):
        """Return list of movement actions from start to target."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # allow stepping onto target even if occupied
                if nxt != target and state.grid[nr, nc, :].any():
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # no path found
        # reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    goal_name = "arrow"
    if goal_name not in index.contents:
        return []
    goal_idx = index[goal_name]

    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    plan = []

    # Collect required primitives
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return plan  # primitive missing
            dists = np.abs(cells - np.array(state.pos)).sum(axis=1)
            target = tuple(cells[dists.argmin()])
            move_seq = _bfs_path(state.pos, target)
            plan.extend(move_seq)
            state.pos = target
            plan.append(USE)
            r, c = target
            state.inventory[prim_idx] += 1
            state.grid[r, c, prim_idx] = 0

    # Move to workshop and craft
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return plan
    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return plan
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_seq = _bfs_path(state.pos, workshop_target)
    plan.extend(move_seq)
    state.pos = workshop_target
    plan.append(USE)

    return plan

