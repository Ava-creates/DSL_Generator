    # Reset environment and get handles to core objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # name ↔ id mapping

    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and the primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # arrow not defined in this world

    goal_idx = index[goal_name]          # integer id of the arrow item
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                         # will hold the final action list

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of move actions from start to target,
    # allowing the target cell to be occupied (so we can step onto a workshop
    # or a primitive cell).  Movement is blocked by any non‑empty cell.
    # ------------------------------------------------------------------
    def _bfs_path(start, target):
        """Return list of move actions (DOWN/UP/LEFT/RIGHT) to reach target."""
        from collections import deque

        if start == target:
            return []

        h, w = state.grid.shape[:2]
        queue = deque([start])
        visited = {start}
        parent = {}

        move_dirs = [(DOWN, (1, 0)),
                     (UP, (-1, 0)),
                     (LEFT, (0, -1)),
                     (RIGHT, (0, 1))]

        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in move_dirs:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if it is occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        # Reconstruct path
        if target not in parent and start != target:
            return []          # no path found
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 2. Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find any cell that currently contains this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more of this primitive on the map – abort.
                return actions
            tr, tc = prim_cells[0]

            # Move to the primitive cell (or adjacent, BFS handles occupancy).
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update our internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # no workshop information

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # cannot find a workshop

    wr, wc = workshop_cells[0]

    # Move to the workshop cell.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions


    # Reset environment and get references to internal structures
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook            # Cookbook
    index = cookbook.index               # name ↔ id mapping

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # arrow not defined

    goal_idx = index[goal_name]          # integer id of the arrow item
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_id: count}
    actions = []                         # result list

    # ------------------------------------------------------------------
    # Helper: generate a Manhattan move sequence from start to target.
    # ------------------------------------------------------------------
    def _move_to(start, target):
        """Return a list of move actions (DOWN/UP/RIGHT/LEFT) that walk
        from start (row, col) to target (row, col) using a greedy Manhattan
        approach. Also returns the final position after the moves."""
        r, c = start
        tr, tc = target
        seq = []
        while (r, c) != (tr, tc):
            if r < tr:
                seq.append(DOWN)
                r += 1
            elif r > tr:
                seq.append(UP)
                r -= 1
            elif c < tc:
                seq.append(RIGHT)
                c += 1
            else:  # c > tc
                seq.append(LEFT)
                c -= 1
        return seq, (r, c)

    # ------------------------------------------------------------------
    # Collect each required primitive.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find any cell that currently contains this primitive.
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # No more of this primitive on the map – give up early.
                return actions
            target_r, target_c = cells[0]

            # Move to the primitive cell.
            move_seq, new_pos = _move_to(state.pos, (target_r, target_c))
            actions.extend(move_seq)
            state.pos = new_pos

            # Pick it up.
            actions.append(USE)

            # Update our internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[target_r, target_c, prim_idx] = 0

    # ------------------------------------------------------------------
    # Go to the workshop required for crafting the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # no workshop info

    workshop_idx = index[workshop_name]

    # Locate a workshop cell.
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # cannot find a workshop

    w_r, w_c = workshop_cells[0]

    # Move to the workshop.
    move_seq, new_pos = _move_to(state.pos, (w_r, w_c))
    actions.extend(move_seq)
    state.pos = new_pos

    # Craft the arrow.
    actions.append(USE)

    return actions

