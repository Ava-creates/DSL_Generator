    import numpy as np

    # Reset the environment and fetch the initial state.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal item index for this task.
    goal_idx = env.task.goal

    # Determine required primitive resources for the goal.
    needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # Identify the workshop (if any) where the goal must be crafted.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # Helper: return all grid positions containing a given kind.
    def locate(kind):
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    # Helper: pick the nearest position (Manhattan distance) to the current agent.
    def nearest(positions):
        cur = state.pos
        best = None
        best_dist = None
        for p in positions:
            d = abs(p[0] - cur[0]) + abs(p[1] - cur[1])
            if best_dist is None or d < best_dist:
                best_dist = d
                best = p
        return best

    # Helper: move the agent from its current location to `target` using
    # simple Manhattan steps.  Action mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.
    def go_to(target):
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right
                act = 3
                new_pos = (x + 1, y)
            elif x > tx:        # need to move left
                act = 2
                new_pos = (x - 1, y)
            elif y < ty:        # need to move down
                act = 0
                new_pos = (x, y + 1)
            else:               # need to move up
                act = 1
                new_pos = (x, y - 1)

            actions.append(act)
            _, state = state.step(act)   # update state after move

    actions = []   # final list of action indices to return

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives in the needed quantities.
    # ----------------------------------------------------------------------
    for kind_idx, count in needed.items():
        for _ in range(count):
            positions = locate(kind_idx)
            if not positions:
                # Primitive missing – abort early.
                return actions
            target = nearest(positions)
            go_to(target)
            # Pick up the primitive.
            actions.append(4)          # USE action
            _, state = state.step(4)

    # ----------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item.
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = nearest(ws_positions)
            go_to(target_ws)
    # Use the crafting action at the current location (whether workshop or not).
    actions.append(4)          # USE to trigger crafting
    _, state = state.step(4)

    return actions


    import numpy as np
    from collections import deque

    # Reset the environment and obtain the initial state.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Index of the goal item for the current task.
    goal_idx = env.task.goal

    # Primitives (and counts) required to craft the goal.
    needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # Determine the workshop (if any) where the goal must be crafted.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # ----------------------------------------------------------------------
    # Helper utilities.
    # ----------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present in the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_actions(start, target):
        """Return a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) that moves from start to target,
        avoiding occupied cells."""
        occ = np.any(state.grid > 0, axis=2)          # True where blocked
        width, height = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    if not occ[nx, ny] and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # No path found – return empty list (caller will simply stay put).
        return []

    def go_to(target):
        """Move the agent from its current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_actions(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ----------------------------------------------------------------------
    # Action list that will be returned.
    # ----------------------------------------------------------------------
    actions = []

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ----------------------------------------------------------------------
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Primitive missing – abort early.
                return actions
            # Choose the nearest occurrence to the current position.
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the item.
            actions.append(4)          # USE
            _, state = state.step(4)

    # ----------------------------------------------------------------------
    # 2. Go to the appropriate workshop (if any) and craft the goal.
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)

    # Return the complete sequence of actions.
    return actions

