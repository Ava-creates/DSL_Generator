    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    # Reset the environment to a fresh state (safe in case it was not reset).
    try:
        env.reset()
    except Exception:
        pass

    # Current state and world objects.
    state = env._current_state          # CraftState
    world = env.world

    # Goal item index for this episode.
    goal_idx = env.task.goal

    # Primitive requirements for the goal (kind index → required count).
    needed_prims = world.cookbook.primitives_for(goal_idx)

    # Determine the workshop (if any) where the goal must be crafted.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, targets):
        """
        Bread‑first search returning a list of positions (excluding `start`)
        that leads to the nearest position in `targets`. Cells occupied by any
        entity are treated as blocked, except the target cells themselves.
        """
        target_set = set(targets)
        if start in target_set:
            return []
        q = deque()
        q.append((start, []))
        visited = {start}
        width, height = state.grid.shape[0], state.grid.shape[1]

        while q:
            pos, path = q.popleft()
            x, y = pos
            for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < width and 0 <= ny < height):
                    continue
                npos = (nx, ny)
                if npos in visited:
                    continue
                # Blocked if any entity occupies the cell and it is not a target.
                if np.any(state.grid[nx, ny, :] > 0) and npos not in target_set:
                    continue
                if npos in target_set:
                    return path + [npos]
                visited.add(npos)
                q.append((npos, path + [npos]))
        return []  # unreachable

    def follow_path(path):
        """Append actions for each step in `path` and update the local state."""
        nonlocal state, actions
        for nxt in path:
            x, y = state.pos
            nx, ny = nxt
            if nx > x:
                act = 3   # RIGHT
            elif nx < x:
                act = 2   # LEFT
            elif ny > y:
                act = 0   # DOWN
            else:
                act = 1   # UP
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1. Collect all required primitives.
    for kind_idx, req_cnt in needed_prims.items():
        while state.inventory[kind_idx] < req_cnt:
            prim_positions = locate(kind_idx)
            if not prim_positions:
                # Primitive not present on the map – abort planning.
                return actions
            path = bfs_path(state.pos, prim_positions)
            if not path:
                # No reachable instance – abort.
                return actions
            follow_path(path)
            # Pick up the primitive.
            actions.append(4)          # USE
            _, state = state.step(4)

    # 2. If a workshop is required, move to a free cell adjacent (or on) it.
    if workshop_idx is not None:
        workshop_cells = locate(workshop_idx)
        if workshop_cells:
            best_path = None
            best_target = None
            width, height = state.grid.shape[0], state.grid.shape[1]

            for wx, wy in workshop_cells:
                # Candidates: the workshop cell itself and its orthogonal neighbours.
                candidates = [(wx, wy),
                              (wx - 1, wy), (wx + 1, wy),
                              (wx, wy - 1), (wx, wy + 1)]
                for cx, cy in candidates:
                    if not (0 <= cx < width and 0 <= cy < height):
                        continue
                    # Cell must be free (no entities) to stand on.
                    if np.any(state.grid[cx, cy, :] > 0):
                        continue
                    path = bfs_path(state.pos, [(cx, cy)])
                    if path is not None and (best_path is None or len(path) < len(best_path)):
                        best_path = path
                        best_target = (cx, cy)

            if best_path is not None:
                follow_path(best_path)
                # Now we are adjacent (or on) the workshop; ready to craft.
            else:
                # No reachable workshop location – abort.
                return actions

    # 3. Trigger crafting (USE action). This works whether we are on a workshop
    #    cell or adjacent to it; the environment handles the check.
    actions.append(4)   # USE
    _, state = state.step(4)

    # Return the compiled list of actions.
    return actions


    # Try the improved planner first; if it returns no actions, fall back to the basic planner.
    actions = make_arrow_v1(env)
    if not actions:
        actions = make_arrow_v0(env)
    return actions

