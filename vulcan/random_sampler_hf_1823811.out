    import numpy as np
    from collections import deque

    # Action constants (match CraftLab.action_specs)
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    # ------------------------------------------------------------------
    # Helper: BFS to any free cell adjacent (4‑connected) to a target cell
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, target, blocked):
        """Return a list of movement actions that brings the agent from *start*
        to any empty cell that is 4‑connected to *target*.
        If no such path exists, returns an empty list."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []          # target completely surrounded

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Reset / obtain current state
    # ------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []   # cannot obtain a state

    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []   # arrow not defined

    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # locate workshop name from recipe
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []   # no workshop info

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []   # workshop not indexed

    # ------------------------------------------------------------------
    # Local mutable copies for planning
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of occupied cells

    plan = []

    # ------------------------------------------------------------------
    # Helper: move to a free cell adjacent to *target*
    # ------------------------------------------------------------------
    def move_to(target):
        """Move (and record actions) to a free cell adjacent to *target*.
        Updates *pos* and *plan*."""
        nonlocal pos, plan
        path = bfs_to_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)
        return True

    # ------------------------------------------------------------------
    # Helper: collect a primitive located at *cell* (kind_idx)
    # ------------------------------------------------------------------
    def collect(cell, kind_idx):
        """Move next to *cell*, issue USE, and update simulated state."""
        nonlocal grid, occupied, inventory, plan, pos
        if not move_to(cell):
            return False
        plan.append(USE)
        x, y = cell
        if grid[x, y, kind_idx] > 0:
            grid[x, y, kind_idx] = 0
            occupied[x, y] = np.any(grid[x, y, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # No more of this primitive on the map – abort planning
                return plan
            # Choose the closest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not collect(target, prim_idx):
                return plan

    # ------------------------------------------------------------------
    # Move to workshop and craft the arrow (just USE while adjacent)
    # ------------------------------------------------------------------
    # Workshop cells are static; use original scenario grid to locate them
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    if not move_to(workshop_target):
        return plan
    plan.append(USE)   # crafting action

    return plan


    # ----------------------------------------------------------------------
    # Setup and obtain current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # no arrow defined

    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # locate workshop name from recipe
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                     # no workshop info

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # workshop not indexed

    # ----------------------------------------------------------------------
    # Local mutable copies for planning
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells

    plan = []

    # ----------------------------------------------------------------------
    # Constants and helpers
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    from collections import deque

    def bfs_to_adjacent(start, target, blocked):
        """Return a list of movement actions that brings the agent from *start*
        to any empty cell that is 4‑connected to *target*.
        If unreachable, returns an empty list."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []          # target completely surrounded

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []  # unreachable

    def move_and_use(target, kind_idx):
        """Move adjacent to *target* (contains *kind_idx*) and issue USE.
        Updates simulated pos, grid, occupied, inventory. Returns False on failure."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_to_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # execute movement actions in simulation
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # perform USE
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            # pick up primitive or interact with workshop
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect required primitives
    # ----------------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # primitive not present; abort planning
                return plan
            # choose nearest by Manhattan distance
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Go to workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan

