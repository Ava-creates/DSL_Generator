    # Reset environment and obtain initial references.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index for the current task.
    goal_idx = env.task.goal

    # Primitive requirements for the goal (recursively expanded).
    needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # Determine workshop (if any) where the goal must be crafted.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    import numpy as np
    from collections import deque

    def manhattan(a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    def locate(kind):
        """Return a list of (x, y) positions where `kind` occurs in the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Bread‑first search returning a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that moves from `start` to `target` while avoiding occupied cells.
        """
        occ = np.any(state.grid > 0, axis=2)          # True where blocked
        width, height = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    if not occ[nx, ny] and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # If no path found (should be rare), fall back to empty list.
        return []

    def go_to(target):
        """Move from current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Action list to be returned.
    # ------------------------------------------------------------------
    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Primitive missing – abort early.
                return actions
            # Choose the nearest occurrence (Manhattan distance).
            target = min(positions, key=lambda p: manhattan(p, state.pos))
            go_to(target)
            # Pick up the item.
            actions.append(4)          # USE
            _, state = state.step(4)

    # ------------------------------------------------------------------
    # 2. Go to the workshop (if required) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target = min(ws_positions, key=lambda p: manhattan(p, state.pos))
            go_to(target)
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)

    # Return the compiled action sequence.
    return actions


    import numpy as np
    from collections import deque

    # Reset environment and get initial state/world
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

