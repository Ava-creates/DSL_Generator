    # Reset environment to a fresh start (ignore if not needed)
    try:
        env.reset()
    except Exception:
        pass

    # Access underlying objects
    scenario = getattr(env, "scenario", None) or getattr(env, "scn", None)
    world = getattr(env, "world", None) or getattr(env, "wrld", None)

    # Basic info
    init_pos = tuple(scenario.init_pos) if scenario is not None else (0, 0)
    grid = np.array(scenario.init_grid, copy=True)

    # Action mapping (expects keys like "DOWN","UP","LEFT","RIGHT","USE")
    act_map = env.action_specs() if hasattr(env, "action_specs") else {
        "DOWN": 0, "UP": 1, "LEFT": 2, "RIGHT": 3, "USE": 4
    }

    # Determine goal index for "arrow"
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = world.cookbook.index.get("arrow")

    # Recipe info
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Helper: Manhattan move generator
    def _move(cur, target):
        actions = []
        x, y = cur
        tx, ty = target
        while x < tx:
            actions.append(act_map["RIGHT"])
            x += 1
        while x > tx:
            actions.append(act_map["LEFT"])
            x -= 1
        while y < ty:
            actions.append(act_map["DOWN"])
            y += 1
        while y > ty:
            actions.append(act_map["UP"])
            y -= 1
        return actions, (x, y)

    # Locate all primitive instances on the map
    primitive_locs = {}
    for kind in primitives_needed:
        ys, xs = np.where(grid[:, :, kind] > 0)
        primitive_locs[kind] = list(zip(xs.tolist(), ys.tolist()))

    # Locate workshop cells (if any)
    workshop_cells = []
    if workshop_kind is not None:
        wy, wx = np.where(grid[:, :, workshop_kind] > 0)
        workshop_cells = list(zip(wx.tolist(), wy.tolist()))
    if not workshop_cells:
        workshop_cells = [init_pos]  # fallback to current position

    # Helper: pick nearest location and remove it from list
    def _pop_nearest(cur, locs):
        if not locs:
            return None
        dists = [abs(cur[0] - x) + abs(cur[1] - y) for (x, y) in locs]
        idx = int(np.argmin(dists))
        return locs.pop(idx)

    actions = []
    cur_pos = init_pos

    # Collect required primitives
    for kind, cnt in primitives_needed.items():
        for _ in range(cnt):
            target = _pop_nearest(cur_pos, primitive_locs.get(kind, []))
            if target is None:
                continue  # no more of this primitive on map
            move_seq, cur_pos = _move(cur_pos, target)
            actions.extend(move_seq)
            actions.append(act_map["USE"])
            # Update grid to reflect pickup
            grid[target[1], target[0], kind] = 0

    # Move to a workshop and craft
    workshop_target = _pop_nearest(cur_pos, workshop_cells)
    if workshop_target is not None:
        move_seq, cur_pos = _move(cur_pos, workshop_target)
        actions.extend(move_seq)
        actions.append(act_map["USE"])

    return actions


    import numpy as np
    from collections import deque

    # Reset the environment if possible.
    try:
        env.reset()
    except Exception:
        pass

    # Mapping from action names to integer indices.
    act_map = env.action_specs()
    # Define movement directions and helper mappings.
    moves = [(1, 0, "DOWN"), (-1, 0, "UP"), (0, 1, "RIGHT"), (0, -1, "LEFT")]
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}
    name_to_action = {name: act_map[name] for name in act_map}

    # Access scenario and world objects (different attribute names may be used).
    scenario = getattr(env, "scenario", None) or getattr(env, "scn", None)
    world = getattr(env, "world", None) or getattr(env, "wrld", None)

    if scenario is None or world is None:
        raise RuntimeError("Could not locate scenario or world in the environment.")

    # Determine the goal index (arrow) either from the task or by name.
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Goal 'arrow' not found in cookbook.")

    # Recipe information.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Working copies of the grid and occupancy mask.
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell.
    cur_pos = tuple(scenario.init_pos)  # (row, col)

    actions = []

    # ----------------------------------------------------------------------
    # Helper: BFS to a free cell adjacent to a target cell.
    # ----------------------------------------------------------------------
    def bfs_adj(start, target, occ_mask):
        """Return a list of direction names to reach a free neighbour of target."""
        tr, tc = target
        # All free neighbours of the target that can be stood on.
        adj = [
            (tr + dr, tc + dc, name)
            for dr, dc, name in moves
            if 0 <= tr + dr < occ_mask.shape[0]
            and 0 <= tc + dc < occ_mask.shape[1]
            and not occ_mask[tr + dr, tc + dc]
        ]
        if not adj:
            return []  # No reachable neighbour.

        # BFS from start.
        q = deque([start])
        parent = {start: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if any(cur == (ar, ac) for ar, ac, _ in adj):
                # Reconstruct path of direction names.
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path
            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ_mask.shape[0]
                    and 0 <= nc < occ_mask.shape[1]
                    and not occ_mask[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # No path found.

    # ----------------------------------------------------------------------
    # Helper: follow a list of direction names, updating position and actions.
    # ----------------------------------------------------------------------
    def follow(path):
        nonlocal cur_pos
        for dname in path:
            actions.append(name_to_action[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ----------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ----------------------------------------------------------------------
    for prim_kind, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate remaining instances of this primitive.
            ys, xs = np.where(grid[:, :, prim_kind] > 0)
            if len(xs) == 0:
                break  # No more instances left.
            # Choose the nearest one (Manhattan distance).
            candidates = list(zip(xs, ys))  # (col, row) order matches grid indexing.
            target = min(
                candidates,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )
            # Move to a free neighbour of the primitive.
            path = bfs_adj(cur_pos, target, occ)
            follow(path)
            # Use action to pick it up.
            actions.append(name_to_action["USE"])
            # Update grid and occupancy mask.
            tx, ty = target
            grid[tx, ty, :] = 0
            occ[tx, ty] = False

    # ----------------------------------------------------------------------
    # Move to the workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        wy, wx = np.where(grid[:, :, workshop_kind] > 0)
        if len(wx) == 0:
            # Fall back to the original scenario grid if the workshop was removed.
            wy, wx = np.where(scenario.init_grid[:, :, workshop_kind] > 0)
        if len(wx) > 0:
            workshop_pos = (wx[0], wy[0])  # (col, row)
            path = bfs_adj(cur_pos, workshop_pos, occ)
            follow(path)
            actions.append(name_to_action["USE"])
    else:
        # No explicit workshop; attempt to use at current location.
        actions.append(name_to_action["USE"])

    return actions

