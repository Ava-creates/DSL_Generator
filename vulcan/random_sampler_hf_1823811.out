    # reset environment to start a fresh episode
    env.reset()
    state = env._current_state  # current CraftState

    # determine the goal index (arrow) – try to read from the task, otherwise fall back to name lookup
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index["arrow"]

    # primitives (and counts) required to craft the goal
    primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # map action names to integers using the environment spec
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # -------------------------------------------------------------------------
    # Helper: move the agent to an absolute position (ignoring obstacles)
    # -------------------------------------------------------------------------
    def move_to(target_pos):
        nonlocal actions, state
        while state.pos != target_pos:
            y, x = state.pos
            ty, tx = target_pos
            if y < ty:
                act, dy, dx = ACT_DOWN, 1, 0
            elif y > ty:
                act, dy, dx = ACT_UP, -1, 0
            elif x < tx:
                act, dy, dx = ACT_RIGHT, 0, 1
            else:
                act, dy, dx = ACT_LEFT, 0, -1
            actions.append(act)
            _, _, _ = env.step(act)          # step returns (reward, done, obs) – we ignore them
            state = env._current_state

    # -------------------------------------------------------------------------
    # Helper: locate the nearest cell that contains a given kind index
    # -------------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    dist = abs(i - state.pos[0]) + abs(j - state.pos[1])
                    if best_dist is None or dist < best_dist:
                        best_dist = dist
                        best = (i, j)
        return best

    # -------------------------------------------------------------------------
    # Helper: given a target cell, pick an adjacent free cell (or stay if none)
    # -------------------------------------------------------------------------
    def adjacent_free(target):
        grid = state.grid
        h, w, _ = grid.shape
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = target[0] + dy, target[1] + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not grid[ny, nx, :].any():
                        return (ny, nx)
        # fall back – maybe the target itself is free
        return target

    # -------------------------------------------------------------------------
    # Collect all required primitives
    # -------------------------------------------------------------------------
    for kind_idx, needed in primitives.items():
        for _ in range(needed):
            pos = find_nearest(kind_idx)
            if pos is None:
                # primitive not present – cannot continue (environment will be unsolvable)
                continue
            adj = adjacent_free(pos)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # -------------------------------------------------------------------------
    # Move to the appropriate workshop and craft the goal item
    # -------------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(workshop_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            move_to(adj)
            actions.append(ACT_USE)          # use at workshop to craft
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    return actions


    # Helper to move from current position to a target cell using Manhattan moves
    def _move_to(target, cur, act_list):
        tx, ty = target
        x, y = cur
        # move in x direction
        while x < tx:
            act_list.append(env.DOWN)
            x += 1
        while x > tx:
            act_list.append(env.UP)
            x -= 1
        # move in y direction
        while y < ty:
            act_list.append(env.RIGHT)
            y += 1
        while y > ty:
            act_list.append(env.LEFT)
            y -= 1
        return (x, y)

    # Access scenario, grid and starting position
    scenario = getattr(env, "scenario", None)
    if scenario is None:
        scenario = env._current_state.scenario
    grid = scenario.init_grid
    pos = scenario.init_pos

    world = env.world
    cookbook = world.cookbook

    # Index of the goal item "arrow"
    goal_idx = cookbook.index["arrow"]

    # Primitive requirements for the arrow
    prim_req = cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    actions = []

    # Collect each required primitive
    for prim_idx, needed in prim_req.items():
        # Find all cells that contain this primitive
        locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
        if not locations:
            continue  # no instance found; in a well‑formed scenario this shouldn't happen
        # Use the first location (any will do for a simple planner)
        target = locations[0]
        # Move to the primitive cell
        pos = _move_to(target, pos, actions)
        # Pick up the required amount (assume each cell yields one unit)
        for _ in range(needed):
            actions.append(env.USE)

    # Locate the workshop required for crafting the arrow
    workshop_name = cookbook.recipes[goal_idx].get("_at")
    if workshop_name is not None:
        workshop_idx = cookbook.index[workshop_name]
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if workshop_cells:
            ws_target = workshop_cells[0]
            pos = _move_to(ws_target, pos, actions)
            # Craft the arrow at the workshop
            actions.append(env.USE)

    return actions

