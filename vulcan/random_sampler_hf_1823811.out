    # Action indices (consistent with CraftLab)
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    from collections import deque

    def find_path(cur_state, target_kind):
        """Breadth‑first search returning a list of movement actions that leads
        the agent to any cell containing `target_kind`. The agent may step onto
        that cell even if it is occupied; otherwise it may only step onto empty
        cells."""
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    # Move onto empty cells or directly onto the target cell
                    if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # If not reachable (should not happen in a valid scenario)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            path = find_path(state, kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions


    # Reset environment and grab useful handles
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld

    # Goal item index and its primitive requirements
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}

    # Action indices (as defined by CraftLab)
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    move_dirs = [
        (1, 0, ACTION_DOWN),   # down  (increase row)
        (-1, 0, ACTION_UP),    # up
        (0, -1, ACTION_LEFT),  # left  (decrease col)
        (0, 1, ACTION_RIGHT),  # right (increase col)
    ]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions leading from the
    # current position to any cell that contains `target_kind`. The agent
    # may step onto empty cells or directly onto the target cell.
    # ------------------------------------------------------------------
    def find_path(cur_state, target_kind):
        from collections import deque

        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            # If the current cell already holds the desired kind, we are done
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    # Allow moving onto empty cells or the target cell itself
                    if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # No path found (should not happen in a solvable scenario)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    for prim_kind, needed in required.items():
        for _ in range(needed):
            # Find shortest path to a cell containing this primitive
            path = find_path(state, prim_kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive (USE action)
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

