    # Reset environment and get initial state
    env.reset()
    state = env._current_state

    # Determine the index of the goal item (arrow)
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Goal 'arrow' not found in the cookbook")

    # If we already have the arrow, no actions are needed
    if state.inventory[goal_idx] > 0:
        return []

    # Action specifications
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ----------------------------------------------------------------------
    # Helper: BFS path planner (avoids occupied cells)
    # ----------------------------------------------------------------------
    def bfs_path(start, target):
        """Return a list of actions moving from start to target."""
        from collections import deque
        h, w, _ = state.grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # allow stepping onto the target even if occupied
                    if not state.grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    # ----------------------------------------------------------------------
    # Helper: move agent to an absolute position using BFS planner
    # ----------------------------------------------------------------------
    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # cannot find a path
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ----------------------------------------------------------------------
    # Helper: locate the nearest cell containing a given kind index
    # ----------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ----------------------------------------------------------------------
    # Helper: choose a free cell (including diagonals) adjacent to a target.
    # Returns the target itself if it is free.
    # ----------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # If the cell itself is free, we can stand there.
        if not state.grid[y, x, :].any():
            return (y, x)
        # Search 8‑neighbourhood for a free spot.
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        return None  # no free adjacent cell

    # ----------------------------------------------------------------------
    # 1) Collect all primitive resources required for the goal.
    # ----------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in needed.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                continue  # primitive not present in the world
            adj = adjacent_free(src)
            if adj is None:
                continue  # cannot stand next to the primitive
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # ----------------------------------------------------------------------
    # 2) Go to the required workshop (if any) and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj_ws = adjacent_free(ws_pos)
            if adj_ws:
                move_to(adj_ws)
                actions.append(ACT_USE)
                env.step(ACT_USE)
                state = env._current_state

    return actions


    env.reset()
    state = env._current_state

    # Determine the index of the goal item (arrow)
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Goal 'arrow' not found in the cookbook")

    # Action indices
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ----------------------------------------------------------------------
    # Helper: BFS to find a sequence of actions from start to target.
    # Allows stepping onto the target even if it is occupied.
    # ----------------------------------------------------------------------
    def bfs_path(start, target):
        from collections import deque
        h, w, _ = state.grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # allow moving onto the target even if occupied
                    if not state.grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # unreachable

    # ----------------------------------------------------------------------
    # Helper: move the agent to an absolute position using BFS planner.
    # ----------------------------------------------------------------------
    def move_to(target):
        nonlocal state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # cannot find a path
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ----------------------------------------------------------------------
    # Helper: locate the nearest cell containing a given kind index.
    # ----------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ----------------------------------------------------------------------
    # Helper: choose a free cell (including diagonals) adjacent to a target.
    # Returns the target itself if it is free.
    # ----------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        return None

    # ----------------------------------------------------------------------
    # 1) Collect all primitive resources required for the goal.
    # ----------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in needed.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                continue  # primitive not present
            adj = adjacent_free(src)
            if adj is None:
                continue  # no free adjacent cell
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # ----------------------------------------------------------------------
    # 2) If the recipe requires a specific workshop, go there and use.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj_ws = adjacent_free(ws_pos)
            if adj_ws:
                move_to(adj_ws)
                actions.append(ACT_USE)
                env.step(ACT_USE)
                state = env._current_state

    return actions

