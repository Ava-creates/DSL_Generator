    # Action constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVES = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]

    import collections
    import numpy as np

    world = env.world

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _is_walkable(pos, goal, g):
        """A cell is walkable if it is empty or it is the goal cell."""
        if pos == goal:
            return True
        x, y = pos
        return not g[x, y, :].any()

    def _bfs_path(start, goal, g):
        """Return a list of positions from start to goal (inclusive) using BFS."""
        if start == goal:
            return [start]
        w, h = g.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            cx, cy = cur
            for dx, dy, _ in MOVES:
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(nxt, goal, g):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a position path into a list of action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            for dx, dy, a in MOVES:
                if x0 + dx == x1 and y0 + dy == y1:
                    acts.append(a)
                    break
        return acts

    def _move_actions(src, dst, g):
        """Return actions to move from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(src, dst, g)
        if path is None:
            # fallback to Manhattan moves (may collide with obstacles)
            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx, g):
        """Find the nearest cell containing the given kind index."""
        locations = np.argwhere(g[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = locations[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Determine recipe for 'arrow' and required primitives
    # ------------------------------------------------------------------
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # Working copies of the grid and agent position
    planning_grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)

    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_kind(cur_pos, prim_idx, planning_grid)
            if target is None:
                # Primitive not present; abort planning
                return actions
            actions += _move_actions(cur_pos, target, planning_grid)
            cur_pos = target
            actions.append(USE)  # pick up the primitive
            planning_grid[target[0], target[1], prim_idx] = 0  # remove from planning grid

    # ------------------------------------------------------------------
    # 2. Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx, planning_grid)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos, planning_grid)
            cur_pos = workshop_pos
            actions.append(USE)  # craft at the workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # index of the target item
    arrow_idx = world.cookbook.index.index('arrow')
    # primitive requirements for one arrow: {prim_idx: count}
    prim_req = world.cookbook.primitives_for(arrow_idx)

    # mutable copies of the current grid and position for planning
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)

    actions = []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _walkable(pos, goal, g):
        """True if `pos` can be stepped on (ignoring the goal cell)."""
        if pos == goal:
            return True
        x, y = pos
        return not g[x, y, :].any()

    def _bfs_path(start, goal, g):
        """Bread‑first search returning a list of positions from start to goal
        (inclusive). Returns None if no path exists."""
        if start == goal:
            return [start]
        w, h = g.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            cx, cy = cur
            for dx, dy, _ in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _walkable(nxt, goal, g):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, g):
        """Return actions to move from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(src, dst, g)
        if path is None:
            # fallback to Manhattan moves (may collide with obstacles)
            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx, g):
        """Find the nearest cell (Manhattan distance) that currently contains `kind_idx`."""
        cells = np.argwhere(g[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for kind_idx, needed in prim_req.items():
        for _ in range(needed):
            target = _nearest_kind(cur_pos, kind_idx, grid)
            if target is None:
                # primitive missing – abort planning
                return actions
            actions += _move_actions(cur_pos, target, grid)
            cur_pos = target
            actions.append(USE)          # pick up the primitive
            # remove it from the planning grid
            grid[target[0], target[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos, grid)
            cur_pos = workshop_pos
            actions.append(USE)          # craft at the workshop

    return actions

