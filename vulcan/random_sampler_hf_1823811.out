    env.reset()
    state = env._current_state

    # ------------------------------------------------------------------
    # Identify the goal index for the item "arrow".
    # ------------------------------------------------------------------
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Goal 'arrow' not found in cookbook")

    # ------------------------------------------------------------------
    # Action constants.
    # ------------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to obtain a list of actions from start to target,
    # navigating only through empty cells.
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_path(start, target):
        h, w, _ = state.grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # allow stepping onto the target even if occupied
                    if not state.grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # no path found

    # ------------------------------------------------------------------
    # Helper: move the agent to an absolute position using bfs_path.
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # cannot reach target
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell containing a given kind index.
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: pick a free cell (including diagonals) adjacent to a target.
    # Returns the target itself if it is free.
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the cell itself if free
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Collect all required primitive resources for the arrow.
    # ------------------------------------------------------------------
    needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in needed.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                continue  # primitive not present; skip
            adj = adjacent_free(src)
            if adj is None:
                continue  # no free adjacent cell; skip
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # If the recipe requires a specific workshop, go there and use.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            if adj:
                move_to(adj)
                actions.append(ACT_USE)
                env.step(ACT_USE)
                state = env._current_state

    return actions


    # Reset environment and get initial state
    env.reset()
    state = env._current_state

    # Identify the goal index for the arrow
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow goal not found in cookbook")

    # Action constants
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    # ------------------------------------------------------------------
    # Helper: BFS to find a path of actions from start to target,
    # avoiding any occupied cell (any non‑zero channel in the grid).
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_path(start, target):
        grid = state.grid
        h, w, _ = grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for dy, dx, act in ((1, 0, ACT_DOWN),
                                (-1, 0, ACT_UP),
                                (0, 1, ACT_RIGHT),
                                (0, -1, ACT_LEFT)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # allow moving onto the target even if occupied (e.g., a workshop)
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # no path found

    # ------------------------------------------------------------------
    # Helper: move the agent to an absolute position using bfs_path.
    # ------------------------------------------------------------------
    actions = []

    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                # cannot reach target; abort
                break
            for a in path:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell that contains a given kind index.
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: find a free cell adjacent (including diagonals) to a given cell.
    # Returns the cell itself if it is free.
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        grid = state.grid
        h, w, _ = grid.shape
        # Prefer the cell itself if free
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not grid[ny, nx, :].any():
                        return (ny, nx)
        # Fallback to current position (should not happen often)
        return state.pos

    # ------------------------------------------------------------------
    # Collect all required primitive resources for the arrow.
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in primitives_needed.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                continue  # primitive not present in the world
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # Go to the appropriate workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # Return the compiled action sequence
    return actions

