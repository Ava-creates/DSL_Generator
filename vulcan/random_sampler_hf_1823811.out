    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    import numpy as np
    from collections import deque

    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_actions(start, target):
        """
        Return a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) that moves the agent
        from `start` to `target`. All occupied cells are avoided except the target
        cell itself, which may be occupied (e.g., a primitive to pick up).
        """
        occupied = np.any(state.grid > 0, axis=2)
        w, h = occupied.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    # Allow stepping onto the target even if it is occupied.
                    if (nx, ny) != target and occupied[nx, ny]:
                        continue
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # No path found – return empty list.
        return []

    def go_to(target):
        """Move the agent to `target`, recording actions and updating `state`."""
        nonlocal state
        for act in bfs_actions(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1. Collect all required primitives.
    for kind, req_cnt in needed.items():
        while state.inventory[kind] < req_cnt:
            positions = locate(kind)
            if not positions:
                # Primitive not found; abort early.
                return actions
            # Choose the nearest occurrence (Manhattan distance).
            target = min(
                positions,
                key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])
            )
            go_to(target)
            # Pick up the primitive.
            actions.append(4)          # USE
            _, state = state.step(4)

    # 2. If a workshop is required, go there and craft the goal item.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(
                ws_positions,
                key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])
            )
            go_to(target_ws)
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)

    # Return the compiled list of actions.
    return actions


    import numpy as np
