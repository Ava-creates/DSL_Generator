    if goal_idx is None:
        return []                       # unknown goal

    # map of primitive kind index -> how many are required for one arrow
    needed_counts = dict(cookbook.primitives_for(goal_idx))

    # where the recipe must be performed (if specified)
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Return a list of positions from start (excluded) to goal (included)
        moving only through cells where `occupied` is False. The goal cell may be
        occupied (e.g., contains the target primitive or a workshop)."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path (exclude start, include goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Translate a movement delta to the environment's action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ----------------------------------------------------------------------
    # Planning: collect all needed primitives (greedy nearest‑first)
    # ----------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # current (x, y) location
    grid = state.grid.copy()            # mutable copy to track what remains on map

    # continue until all required primitives have been collected
    while any(cnt > 0 for cnt in needed_counts.values()):
        best_path = None
        best_loc = None
        best_kind = None

        # search for the nearest reachable primitive of any still‑needed kind
        for kind, cnt in needed_counts.items():
            if cnt <= 0:
                continue
            locations = np.argwhere(grid[:, :, kind] > 0)
            if locations.size == 0:
                continue

            # sort candidates by Manhattan distance to current position
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked
            for idx in order:
                cand = tuple(locations[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    best_path = path
                    best_loc = cand
                    best_kind = kind
                    break
            if best_path is not None:
                break   # we found the nearest reachable primitive

        if best_path is None:
            # No reachable primitive left; abort to avoid infinite loop
            break

        # follow the path to the primitive, emitting movement actions
        for step in best_path:
            dx = step[0] - cur_pos[0]
            dy = step[1] - cur_pos[1]
            actions.append(delta_to_action(dx, dy))
            cur_pos = step

        # pick up the primitive
        actions.append(4)   # USE
        grid[best_loc[0], best_loc[1], best_kind] = 0
        needed_counts[best_kind] -= 1

    # ----------------------------------------------------------------------
    # Move to the appropriate workshop (if required) and craft
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            # choose the nearest workshop cell (ignoring other entities as obstacles)
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original grid, workshops occupy cells
            for idx in order:
                target = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, target, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # No specific workshop needed; craft at the current location
        actions.append(4)

    return actions

