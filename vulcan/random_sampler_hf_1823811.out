    # Action indices (match CraftWorld's definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _is_walkable(grid, pos, ignore_kind=None):
        """Return True if `pos` is free to step on.
        Cells that contain any entity are blocked, except when the entity is
        `ignore_kind` (used to allow stepping onto a primitive we intend to pick up)."""
        x, y = pos
        cell = grid[x, y, :]
        if ignore_kind is not None and cell[ignore_kind] > 0:
            # allow stepping onto the target primitive (but no other entities)
            return np.count_nonzero(cell) == 1
        return not cell.any()

    def _bfs_path(grid, start, goal, ignore_kind=None):
        """Find a shortest 4‑connected path from `start` to `goal`.
        Returns a list of positions (including both endpoints) or None if unreachable."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(grid, nxt, ignore_kind):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Convert a list of adjacent positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent positions in path")
        return acts

    def _move_actions(grid, src, dst, ignore_kind=None):
        """Return actions to move from src to dst using BFS; fallback to Manhattan."""
        path = _bfs_path(grid, src, dst, ignore_kind)
        if path is None:
            # Manhattan fallback (may collide with obstacles but ensures progress)
            acts = []
            sx, sy = src
            dx, dy = dst[0] - sx, dst[1] - sy
            if dx > 0:
                acts += [DOWN] * dx
            elif dx < 0:
                acts += [UP] * (-dx)
            if dy > 0:
                acts += [RIGHT] * dy
            elif dy < 0:
                acts += [LEFT] * (-dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(grid, pos, kind_idx):
        """Find the nearest cell (Manhattan distance) that currently contains `kind_idx`."""
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # 1. Determine required primitives for the target item (arrow)
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}

    # ------------------------------------------------------------------
    # 2. Collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)          # current agent position
    grid = env._current_state.grid.copy()            # mutable copy for planning

    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target = _nearest_kind(grid, cur_pos, prim_idx)
            if target is None:
                # Primitive missing – abort planning early
                return actions
            # Move to the primitive, allowing stepping onto it
            actions += _move_actions(grid, cur_pos, target, ignore_kind=prim_idx)
            cur_pos = target
            actions.append(USE)                       # pick up primitive
            # Update local grid: primitive is now removed
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Move to the appropriate workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(grid, cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(grid, cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)                       # craft at workshop

    return actions


    import numpy as np
    import collections

    # Action indices – match the environment's definition
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # Index of the target item "arrow"
    arrow_idx = world.cookbook.index.index('arrow')
    # Primitive requirements for one arrow: {prim_idx: count}
    needed = world.cookbook.primitives_for(arrow_idx)

    # Work on a mutable copy of the grid so we can “consume” items we pick up
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)  # (row, col)

    def _is_walkable(g, pos, ignore_kind=None):
        """Return True if `pos` can be stepped on.
        Cells with any entity are blocked, except when the only entity
        present is the `ignore_kind` we intend to pick up or use."""
        x, y = pos
        cell = g[x, y, :]
        if ignore_kind is not None and cell[ignore_kind] > 0:
            # allow standing on the target primitive/workshop
            return np.count_nonzero(cell) == 1
        return not cell.any()

    def _bfs_path(g, start, goal, ignore_kind=None):
        """Shortest 4‑connected path from `start` to `goal` (inclusive)."""
        if start == goal:
            return [start]
        width, height = g.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in came_from and _is_walkable(g, nxt, ignore_kind):
                        came_from[nxt] = cur
                        frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct the path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of adjacent positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent positions in path")
        return acts

    def _move_actions(g, src, dst, ignore_kind=None):
        """Return actions to move from src to dst using BFS; fall back to Manhattan."""
        path = _bfs_path(g, src, dst, ignore_kind)
        if path is None:
            # Simple Manhattan fallback (may collide with obstacles)
            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(g, pos, kind_idx):
        """Find the nearest cell (Manhattan distance) containing `kind_idx`."""
        cells = np.argwhere(g[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    actions = []

    # ----------------------------------------------------------------------
    # 1) Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = _nearest_kind(grid, cur_pos, prim_idx)
            if target is None:
                # Primitive not found – abort early
                return actions
            actions += _move_actions(grid, cur_pos, target, ignore_kind=prim_idx)
            cur_pos = target
            actions.append(USE)          # pick up the primitive
            # Simulate removal of the primitive from the environment copy
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ----------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the arrow
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(grid, cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += _move_actions(grid, cur_pos, workshop_pos, ignore_kind=workshop_idx)
            cur_pos = workshop_pos
            actions.append(USE)          # craft at the workshop

    return actions

