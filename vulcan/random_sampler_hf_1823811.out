    # Reset the environment to a fresh state (ignore any errors if already reset)
    try:
        env.reset()
    except Exception:
        pass

    # ----------------------------------------------------------------------
    # Identify the goal index (the item we need to craft, e.g., "arrow").
    # ----------------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task"):
        task = getattr(env, "task")
        if hasattr(task, "goal"):
            goal_idx = task.goal
        elif isinstance(task, (list, tuple)):
            goal_idx = task[0]

    if goal_idx is None:
        # No goal information – nothing to do.
        return []

    # Action indices as defined by CraftLab.action_specs
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ----------------------------------------------------------------------
    # Determine which primitive resources are required to craft the goal.
    # ----------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    # Current mutable position of the agent.
    cur_pos = list(env._current_state.pos)          # [x, y]

    # Work on a copy of the grid for planning purposes (so we can "remove"
    # primitives once we plan to pick them up).
    grid = env._current_state.grid.copy()           # shape (W, H, n_kinds)

    # ----------------------------------------------------------------------
    # Helper: generate a Manhattan move sequence from cur_pos to target.
    # ----------------------------------------------------------------------
    def move_to(target):
        nonlocal cur_pos
        seq = []
        tx, ty = target
        # Move in x direction first.
        while cur_pos[0] < tx:
            seq.append(RIGHT)
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            seq.append(LEFT)
            cur_pos[0] -= 1
        # Then move in y direction.
        while cur_pos[1] < ty:
            seq.append(DOWN)
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            seq.append(UP)
            cur_pos[1] -= 1
        return seq

    plan = []

    # ----------------------------------------------------------------------
    # Collect each required primitive the needed number of times.
    # ----------------------------------------------------------------------
    for kind_idx, needed_cnt in primitives_needed.items():
        remaining = needed_cnt
        while remaining > 0:
            # Find all cells that still contain this primitive.
            positions = np.argwhere(grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                # No more of this primitive left on the map – abort planning.
                break

            # Choose the nearest primitive (Manhattan distance) to reduce travel.
            dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])
            nearest_idx = int(dists.argmin())
            target = tuple(positions[nearest_idx])

            # Move to the primitive and pick it up.
            plan.extend(move_to(target))
            plan.append(USE)

            # Simulate the pickup by clearing the primitive from the planning grid.
            grid[target[0], target[1], kind_idx] = 0
            remaining -= 1

    # ----------------------------------------------------------------------
    # After gathering all primitives, go to the appropriate workshop (if any)
    # and perform the crafting action.
    # ----------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
        if ws_positions.shape[0] > 0:
            # Choose the nearest workshop.
            dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])
            nearest_ws = int(dists.argmin())
            ws_target = tuple(ws_positions[nearest_ws])
            plan.extend(move_to(ws_target))
            plan.append(USE)   # Use at the workshop to craft the goal item.

    return plan


