    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _cell_occupied(pos, ignore_kind=None):
        """Return True if a cell contains any entity other than ignore_kind."""
        x, y = pos
        occ = grid[x, y, :].copy()
        if ignore_kind is not None:
            occ[ignore_kind] = 0
        return occ.any()

    def _bfs(start, goal, ignore_kind=None):
        """Bread‑first search returning a list of positions from start to goal."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        if not _cell_occupied(nxt, ignore_kind) or nxt == goal:
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _path_to_actions(path):
        """Translate a list of positions into a list of action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move(src, dst, ignore_kind=None):
        """Return actions moving from src to dst, falling back to Manhattan."""
        p = _bfs(src, dst, ignore_kind=ignore_kind)
        if p is None:
            # simple Manhattan fallback (may hit obstacles)
            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return _path_to_actions(p)

    def _nearest_reachable(pos, kind_idx, banned):
        """Find nearest reachable cell containing kind_idx not in banned."""
        candidates = np.argwhere(grid[:, :, kind_idx] > 0)
        if candidates.size == 0:
            return None
        if banned:
            mask = np.array([tuple(c) not in banned for c in candidates])
            candidates = candidates[mask]
            if candidates.size == 0:
                return None
        dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
        order = np.argsort(dists)
        for idx in order:
            cand = tuple(candidates[idx].tolist())
            if _bfs(pos, cand, ignore_kind=kind_idx) is not None:
                return cand
        return None

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    actions = []
    harvested = {k: set() for k in prim_req.keys()}

    for kind_idx, needed in prim_req.items():
        for _ in range(needed):
            target = _nearest_reachable(cur_pos, kind_idx, harvested[kind_idx])
            if target is None:
                # primitive missing/unreachable – stop planning
                return actions
            actions += _move(cur_pos, target, ignore_kind=kind_idx)
            cur_pos = target
            actions.append(USE)          # pick up primitive
            harvested[kind_idx].add(target)
            grid[target[0], target[1], kind_idx] = 0  # simulate pickup

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_target = _nearest_reachable(cur_pos, workshop_idx, set())
        if ws_target is not None:
            actions += _move(cur_pos, ws_target)
            cur_pos = ws_target
            actions.append(USE)          # craft at workshop

    return actions


    # Action indices (assumed standard mapping)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)

    # Primitive requirements for a single arrow: {prim_idx: count}
    prim_req = world.cookbook.primitives_for(goal_idx)

    # Local mutable copies of grid and agent position
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    import collections
    import numpy as np

    def _is_occupied(pos, g):
        """Return True if any entity occupies the cell at pos."""
        x, y = pos
        return g[x, y, :].any()

    def _bfs_path(start, goal, g):
        """Shortest path on grid `g` from start to goal (allow stepping onto goal)."""
        if start == goal:
            return [start]
        w, h = g.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        if not _is_occupied(nxt, g) or nxt == goal:
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _actions_from_path(path):
        """Translate a list of positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move_actions(src, dst, g):
        """Return actions to move from src to dst (BFS preferred, Manhattan fallback)."""
        path = _bfs_path(src, dst, g)
        if path is None:
            # fallback: straight Manhattan moves (may collide with obstacles)
            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return _actions_from_path(path)

    def _nearest_kind(pos, kind_idx, g, excluded):
        """Find the nearest cell containing `kind_idx` not in `excluded`."""
        locations = np.argwhere(g[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        if excluded:
            mask = np.array([tuple(coord) not in excluded for coord in locations])
            locations = locations[mask]
            if locations.size == 0:
                return None
        # Manhattan distance heuristic
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = locations[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Planning: collect all required primitives
    # ------------------------------------------------------------------
    actions = []
    harvested = {k: set() for k in prim_req.keys()}

    for kind_idx, needed in prim_req.items():
        for _ in range(needed):
            target = _nearest_kind(cur_pos, kind_idx, grid, harvested[kind_idx])
            if target is None:
                # Primitive missing/unreachable – abort planning
                return actions
            actions += _move_actions(cur_pos, target, grid)
            cur_pos = target
            actions.append(USE)                     # pick up primitive
            # Update local grid copy to reflect that the primitive is taken
            grid[target[0], target[1], kind_idx] = 0
            harvested[kind_idx].add(target)

    # ------------------------------------------------------------------
    # Move to workshop (if recipe specifies one) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_target = _nearest_kind(cur_pos, workshop_idx, grid, set())
        if ws_target is not None:
            actions += _move_actions(cur_pos, ws_target, grid)
            cur_pos = ws_target
            actions.append(USE)                     # craft at workshop

    return actions

