    actions = []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    # Action mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE
    def _move_action(dx, dy):
        if dx == 1:
            return 3          # RIGHT (increase x)
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN (increase y)
        return 1              # UP (dy == -1)

    def _cell_traversable(pos, target_kind=None):
        """A cell is traversable if empty or contains the target kind."""
        x, y = pos
        cell = grid[x, y, :]
        if cell.sum() == 0:
            return True
        if target_kind is not None and cell[target_kind] > 0:
            return True
        return False

    def _bfs_path(start, goal_cond, target_kind=None):
        """
        Bread‑first search returning a list of movement actions that brings the
        agent from ``start`` to a cell satisfying ``goal_cond``.
        Cells containing ``target_kind`` are considered traversable.
        """
        width, height = grid.shape[0], grid.shape[1]
        q = deque([start])
        came_from = {start: None}
        move_delta = {}

        while q:
            cur = q.popleft()
            if goal_cond(cur):
                # Reconstruct action list
                act_list = []
                while came_from[cur] is not None:
                    prev = came_from[cur]
                    dx = cur[0] - prev[0]
                    dy = cur[1] - prev[1]
                    act_list.append(_move_action(dx, dy))
                    cur = prev
                act_list.reverse()
                return act_list

            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in came_from and _cell_traversable(nxt, target_kind):
                        came_from[nxt] = cur
                        move_delta[nxt] = (dx, dy)
                        q.append(nxt)

        # No path found
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in needed.items():
        while inventory[prim_idx] < required_cnt:
            # Locate remaining primitives of this kind
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more primitives available – abort planning
                return actions

            # Choose the closest primitive (Manhattan distance)
            dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
            target = tuple(prim_cells[dists.argmin()])

            # Move to the primitive (allow stepping onto its cell)
            move_actions = _bfs_path(cur_pos, lambda p, t=target: p == t, target_kind=prim_idx)
            actions.extend(move_actions)
            cur_pos = target

            # Pick it up
            actions.append(4)                     # USE
            # Simulate the pickup in our copies
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Go to workshop (if needed) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size == 0:
            # No workshop found – abort
            return actions

        best_path = None
        best_target = None

        # Consider standing on the workshop cell itself (it is traversable)
        for wx, wy in ws_cells:
            target = (wx, wy)
            path = _bfs_path(cur_pos, lambda p, t=target: p == t, target_kind=workshop_idx)
            if best_path is None or len(path) < len(best_path):
                best_path = path
                best_target = target

        if best_path is not None:
            actions.extend(best_path)
            cur_pos = best_target
            actions.append(4)                     # USE to craft
    else:
        # No specific workshop – just attempt to craft at current location
        actions.append(4)                         # USE

    # Return the assembled action sequence
    return actions

