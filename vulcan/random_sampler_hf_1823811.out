    # Reset environment and get handles to the current state and world objects.
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world
    cookbook = world.cookbook
    idx = cookbook.index                # name ↔ integer id mapping

    # Action identifiers – try to read from the env, otherwise fall back to defaults.
    try:
        spec = env.action_specs()
        DOWN = spec["DOWN"]
        UP = spec["UP"]
        LEFT = spec["LEFT"]
        RIGHT = spec["RIGHT"]
        USE = spec["USE"]
    except Exception:
        DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Movement directions paired with their (dr, dc) offsets.
    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    # ----------------------------------------------------------------------
    # Helper functions.
    # ----------------------------------------------------------------------
    from collections import deque

    def bfs_path(start, target):
        """Return a list of move actions (DOWN/UP/LEFT/RIGHT) that moves
        the agent from *start* to *target*.  The target cell may be occupied;
        all other traversed cells must be empty."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Disallow stepping on occupied cells unless it is the target.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []                     # unreachable
        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def bfs_to_nearest(kind_idx, start):
        """Breadth‑first search for the closest cell containing *kind_idx*.
        Returns (path, cell) where *path* is a list of move actions to reach
        *cell*.  If no such cell is reachable, returns ([], None)."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Treat any occupied cell as blocked unless it holds the target kind.
                if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # Reconstruct path to this cell.
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None

    # ----------------------------------------------------------------------
    # Determine goal and required primitives.
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []                              # arrow not defined in this world
    goal_idx = idx[goal_name]

    # Mapping primitive kind → required count for a single arrow.
    primitive_needs = cookbook.primitives_for(goal_idx)

    actions = []                               # final action sequence

    # ----------------------------------------------------------------------
    # 1. Collect each required primitive the necessary number of times.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            path, cell = bfs_to_nearest(prim_idx, state.pos)
            if cell is None:                   # cannot find required primitive
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)                # pick up
            # Update simulated state.
            state.inventory[prim_idx] += 1
            state.grid[cell[0], cell[1], prim_idx] = 0

    # ----------------------------------------------------------------------
    # 2. Move to the workshop where the arrow can be crafted and craft it.
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                         # no workshop information
    workshop_idx = idx[workshop_name]

    path, cell = bfs_to_nearest(workshop_idx, state.pos)
    if cell is None:
        return actions                         # cannot reach workshop
    actions.extend(path)
    state.pos = cell
    actions.append(USE)                        # craft the arrow

    return actions


    # reset and obtain handles to the underlying objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    idx = cookbook.index                # name ↔ integer id mapping

    # action identifiers (consistent with CraftLab.action_specs)
    action_map = env.action_specs()
    DOWN = action_map["DOWN"]
    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    # ------------------------------------------------------------------
    # Helper: shortest path (list of move actions) from start → target.
    # The target may be occupied; all other cells on the path must be empty.
    # ------------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # disallow stepping on occupied cells unless it's the target
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # no path found
        # reconstruct actions
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Helper: locate the closest cell containing a given kind (by BFS).
    # Returns (action_path, cell_coords) or ([], None) if not found.
    # ------------------------------------------------------------------
    def _nearest_cell_of(kind_idx, start):
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # treat occupied cells as blocked unless they hold the target kind
                if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # reconstruct path to this cell
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None

    # ------------------------------------------------------------------
    # Identify goal (arrow) and required primitives.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []          # arrow not defined in this world
    goal_idx = idx[goal_name]

    primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_requirements.items():
        for _ in range(needed_cnt):
            path, cell = _nearest_cell_of(prim_idx, state.pos)
            if cell is None:
                # primitive missing – abort early
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)                     # pick up
            # update simulated state
            tr, tc = cell
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # cannot craft without a workshop

    workshop_idx = idx[workshop_name]
    path, cell = _nearest_cell_of(workshop_idx, state.pos)
    if cell is None:
        return actions  # no workshop reachable
    actions.extend(path)
    state.pos = cell
    actions.append(USE)   # craft the arrow

    return actions

