    import numpy as np
    from collections import deque

    # ------------------------------------------------------------
    # Action constants (match CraftLab.action_specs)
    # ------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    # ------------------------------------------------------------
    # Bread‑first search returning a list of move actions that brings
    # the agent from *start* to any empty cell adjacent (4‑connected)
    # to *target*.  *blocked* is a bool matrix where True means the cell
    # cannot be entered.
    # ------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []                     # target completely surrounded

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []                         # unreachable

    # ------------------------------------------------------------
    # Initialise / obtain the current state from the environment.
    # ------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass
    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------
    # Identify the goal (arrow) and the workshop required to craft it.
    # ------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                         # arrow not defined in recipes

    needed = world.cookbook.primitives_for(goal_idx)

    workshop_idx = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            try:
                workshop_idx = idx[v]
            except Exception:
                workshop_idx = None
            break
    if workshop_idx is None:
        return []                         # cannot locate workshop for arrow

    # ------------------------------------------------------------
    # Local mutable copies for planning.
    # ------------------------------------------------------------
    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()              # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)   # bool matrix: True where any entity exists

    plan = []

    # ------------------------------------------------------------
    # Helper: move adjacent to *target*, issue USE, and update simulated
    # state (grid, occupied, inventory, pos). Returns False on failure.
    # ------------------------------------------------------------
    def move_and_use(target, kind_idx):
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False                  # cannot reach adjacency
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        plan.append(USE)                  # interact with the target cell

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:    # pick up a primitive/component
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ------------------------------------------------------------
    # Collect all required primitives/components.
    # ------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                return plan                # nothing left to collect
            # Choose the closest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, kind_idx):
                return plan

    # ------------------------------------------------------------
    # Move to the workshop and craft the arrow.
    # ------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # Workshops are static; fall back to the original scenario grid.
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    # ------------------------------------------------------------
    # Return the complete action sequence.
    # ------------------------------------------------------------
    return plan


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (match CraftLab.action_specs)
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    # ----------------------------------------------------------------------
    # Bread‑first search for a path to any empty cell adjacent to *target*
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        """Return a list of move actions that brings the agent from *start*
        to an empty cell orthogonally adjacent to *target*."""
        h, w = blocked.shape
        tx, ty = target
        goals = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goals.append((gx, gy))
        if not goals:
            return []                     # target completely surrounded

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goals:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []                         # unreachable

    # ----------------------------------------------------------------------
    # Reset / obtain current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass
    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify the arrow goal and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                         # no arrow defined

    needed = world.cookbook.primitives_for(goal_idx)

    # Locate required workshop for crafting the arrow
    workshop_idx = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            try:
                workshop_idx = idx[v]
            except Exception:
                workshop_idx = None
            break
    if workshop_idx is None:
        return []                         # workshop info missing

    # ----------------------------------------------------------------------
    # Local mutable copies for planning
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                # (x, y)
    grid = state.grid.copy()              # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)   # bool matrix of blocked cells

    plan = []

    # ----------------------------------------------------------------------
    # Helper: move adjacent to *target* and issue USE; update simulated state
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Move adjacent to *target* (which contains *kind_idx*), USE,
        and update simulated position, grid, occupied map and inventory."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False                  # cannot reach adjacency
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        plan.append(USE)                  # perform interaction

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:    # pick up primitive/component
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives/components
    # ----------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                return plan                # nothing left to collect
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, kind_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # workshops are static; fall back to original scenario grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    # ----------------------------------------------------------------------
    # Return the constructed action list
    # ----------------------------------------------------------------------
    return plan

