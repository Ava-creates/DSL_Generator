        moves = []
        # X‑direction moves
        while cur_pos[0] < tx:
            moves.append(RIGHT)
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            moves.append(LEFT)
            cur_pos[0] -= 1
        # Y‑direction moves
        while cur_pos[1] < ty:
