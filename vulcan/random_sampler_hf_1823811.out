  def is_blocked(pos):
      """Return True if the cell contains any non‑grabbable entity."""
      x, y = pos
      cell = grid[x, y, :]
      if not world.non_grabbable_indices:
          return False
      idxs = list(world.non_grabbable_indices)
      return np.any(cell[idxs] > 0)

  def bfs_actions(start, target):
      """Shortest‑path actions from start to target avoiding blocked cells."""
      if start == target:
          return []
      from collections import deque
      queue = deque([start])
      visited = {start: None}
      while queue:
          cur = queue.popleft()
          if cur == target:
              break
          x, y = cur
          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):
              nx, ny = x + dx, y + dy
              if 0 <= nx < width and 0 <= ny < height:
                  nxt = (nx, ny)
                  if nxt not in visited and not is_blocked(nxt):
                      visited[nxt] = (cur, act)
                      queue.append(nxt)
      else:
          # No path found
          return []

      # Reconstruct action sequence
      seq = []
      cur = target
      while cur != start:
          prev, act = visited[cur]
          seq.append(act)
          cur = prev
      seq.reverse()
      return seq

  def nearest_cell(kind, from_pos):
      """Find the closest cell containing the given kind."""
      cells = np.argwhere(grid[:, :, kind] > 0)
      if cells.size == 0:
          return None
      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
      idx = int(np.argmin(dists))
      return tuple(cells[idx])

  # Collect all required primitive items
  for kind, cnt in required.items():
      for _ in range(cnt):
          target = nearest_cell(kind, cur_pos)
          if target is None:
              # Primitive missing – cannot complete the task
              continue
          actions.extend(bfs_actions(cur_pos, target))
          actions.append(4)          # USE to pick up the primitive
          grid[target[0], target[1], kind] = 0  # Mark as harvested
          cur_pos = target

  # Move to the appropriate workshop (if the recipe demands one)
  if workshop_kind is not None:
      target = nearest_cell(workshop_kind, cur_pos)
      if target is not None:
          actions.extend(bfs_actions(cur_pos, target))
          cur_pos = target

  # Final USE to trigger crafting of the arrow (or target item)
  actions.append(4)

  return actions

