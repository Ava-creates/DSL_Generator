    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (as used by CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Mapping from action to (dx, dy)
    ACTION_DELTAS = {
        DOWN: (0, 1),
        UP: (0, -1),
        LEFT: (-1, 0),
        RIGHT: (1, 0),
    }

    # ----------------------------------------------------------------------
    # Helper: BFS shortest path avoiding blocked cells
    def bfs(start, goals, blocked):
        """
        start : (x, y) tuple
        goals : set of (x, y) tuples we want to reach
        blocked : 2‑D bool array (True == cell cannot be entered)
        Returns a list of positions from start to the first reached goal (inclusive)
        """
        W, H = blocked.shape
        visited = np.full((W, H), False, dtype=bool)
        prev = {}
        q = deque()
        q.append(start)
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) in goals:
                # reconstruct path
                path = [(x, y)]
                while (x, y) != start:
                    x, y = prev[(x, y)]
                    path.append((x, y))
                path.reverse()
                return path
            for act, (dx, dy) in ACTION_DELTAS.items():
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny] and not visited[nx, ny]:
                    visited[nx, ny] = True
                    prev[(nx, ny)] = (x, y)
                    q.append((nx, ny))
        return None  # no reachable goal

    # ----------------------------------------------------------------------
    # Helper: convert a list of positions into a list of actions
    def path_to_actions(path):
        actions = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            dx, dy = x1 - x0, y1 - y0
            for act, (adx, ady) in ACTION_DELTAS.items():
                if (dx, dy) == (adx, ady):
                    actions.append(act)
                    break
        return actions

    # ----------------------------------------------------------------------
    # Helper: recompute blocked‑cell mask from the current grid
    def recompute_blocked(grid_arr):
        # any non‑zero entry in the kind dimension blocks movement
        return grid_arr.sum(axis=2) > 0

    # ----------------------------------------------------------------------
    # Begin planning
    state = env._current_state
    grid = state.grid.copy()                # mutable copy of the world grid
    inventory = state.inventory.copy()      # mutable copy of the inventory
    pos = tuple(state.pos)                  # (x, y)

    # The name of the target item
    goal_name = "arrow"
    goal_idx = env.world.cookbook.index[goal_name]

    # Primitive requirements for a single arrow (base resources only)
    primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    actions_plan = []

    # Current blocked‑cell mask
    blocked = recompute_blocked(grid)

    # ----------------------------------------------------------------------
    # 1) Collect all required primitives
    for prim_idx, count in primitive_requirements.items():
        for _ in range(count):
            # Find all remaining cells that contain this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                raise RuntimeError(f"required primitive {prim_idx} not found on the map")

            best_path = None
            best_actions = None
            best_target = None          # (neighbour_pos, primitive_pos)

            # For each primitive cell consider the four neighbouring cells we could stand on
            for (tx, ty) in prim_cells:
                for act, (dx, dy) in ACTION_DELTAS.items():
                    nx, ny = tx - dx, ty - dy   # neighbour from which a forward move would face the primitive
                    if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):
                        continue
                    if blocked[nx, ny]:
                        continue
                    # Find shortest path from current position to this neighbour
                    path = bfs(pos, {(nx, ny)}, blocked)
                    if path is None:
                        continue
                    acts = path_to_actions(path)
                    if best_path is None or len(acts) < len(best_actions):
                        best_path = path
                        best_actions = acts
                        best_target = ((nx, ny), (tx, ty))

            if best_path is None:
                raise RuntimeError("cannot reach a required primitive")

            # Move to the chosen neighbour
            actions_plan.extend(best_actions)
            # Use the primitive (pick it up)
            actions_plan.append(USE)

            # ------------------------------------------------------------------
            # Update simulated world state
            pos = best_target[0]                     # agent stays on the neighbour cell
            prim_x, prim_y = best_target[1]
            grid[prim_x, prim_y, :] = 0              # primitive disappears from the world
            inventory[prim_idx] += 1
            blocked = recompute_blocked(grid)        # recompute blocked mask after removal

    # ----------------------------------------------------------------------
    # 2) Craft the final item (arrow) at its required workshop
    recipe = env.world.cookbook.recipes[goal_idx]
    workshop_kind = recipe["_at"]

    # Locate any workshop of the required kind
    workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
    if not workshop_cells:
        raise RuntimeError("no workshop of the required type found for arrow")

    best_path = None
    best_actions = None
    best_target = None   # neighbour position next to the workshop

    for (wx, wy) in workshop_cells:
        for act, (dx, dy) in ACTION_DELTAS.items():
            nx, ny = wx - dx, wy - dy
            if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):
                continue
            if blocked[nx, ny]:
                continue
            path = bfs(pos, {(nx, ny)}, blocked)
            if path is None:
                continue
            acts = path_to_actions(path)
            if best_path is None or len(acts) < len(best_actions):
                best_path = path
                best_actions = acts
                best_target = (nx, ny)

    if best_path is None:
        raise RuntimeError("cannot reach a suitable workshop for arrow")

    # Move adjacent to the workshop and craft
    actions_plan.extend(best_actions)
    actions_plan.append(USE)   # this USE will trigger the crafting of the arrow

    return actions_plan

