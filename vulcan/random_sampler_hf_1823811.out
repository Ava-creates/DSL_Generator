    # Reset environment (ignore returned observation)
    try:
        env.reset()
    except Exception:
        pass

    # Mapping from action name to integer code
    act_map = env.action_specs()

    # Movement definitions
    moves = [(-1, 0, "UP"), (1, 0, "DOWN"), (0, -1, "LEFT"), (0, 1, "RIGHT")]
    name_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    # ------------------------------------------------------------------
    # Helper: breadth‑first search to any empty orthogonal neighbour of
    # a target cell. Returns a list of direction names.
    from collections import deque

    def bfs_to_adjacent(start, target, occ):
        tr, tc = target
        # All empty cells orthogonally adjacent to the target
        goal_cells = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occ.shape[0]
            and 0 <= tc + dc < occ.shape[1]
            and not occ[tr + dr, tc + dc]
        ]
        if not goal_cells:
            return []  # No reachable neighbour

        if start in goal_cells:
            return []  # Already adjacent

        q = deque([start])
        parent = {start: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if cur in goal_cells:
                # Reconstruct path
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path
            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ.shape[0]
                    and 0 <= nc < occ.shape[1]
                    and not occ[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # No path found

    # ------------------------------------------------------------------
    # Helper: execute a list of direction names, updating position and
    # appending the corresponding integer actions.
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = name_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Retrieve goal information
    goal_idx = getattr(env.task, "goal", None)
    if goal_idx is None:
        return []  # cannot determine goal

    scenario = env.scenario
    world = scenario.world

    # Primitive requirements and workshop location (if any)
    primitives_needed = world.cookbook.primitives_for(goal_idx)      # {kind_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")

    # Working copy of the grid and occupancy mask (True = blocked)
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0

    # Current agent position
    cur_pos = scenario.init_pos  # (row, col)

    actions = []

    # ------------------------------------------------------------------
    # Collect required primitives
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate remaining instances of this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more of this primitive on the map; abort collection loop
                break

            # Choose the closest instance (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to an empty neighbour of the target
            path = bfs_to_adjacent(cur_pos, target, occ)
            execute_path(path)

            # Pick up the primitive
            actions.append(act_map["USE"])

            # Update grid and occupancy mask
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the goal item
    if workshop_idx is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if not workshop_cells:
            # Workshop might have been removed from the mutable copy;
            # fall back to the original scenario grid.
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))
            )
        if workshop_cells:
            # Choose nearest workshop cell
            target_ws = min(
                workshop_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )
            path = bfs_to_adjacent(cur_pos, target_ws, occ)
            execute_path(path)
            # Use the workshop to craft
            actions.append(act_map["USE"])

    # Return the compiled action sequence
    return actions

