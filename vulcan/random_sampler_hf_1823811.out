    """
    Wrapper that selects the most capable implementation of the arrow‑making
    routine available in the current module.  It tries the newest version
    (make_arrow_v2) first and falls back to earlier versions if that function
    raises an exception (e.g., not defined or fails for the given environment).
    """
    try:
        # Preferred, most recent implementation
        return make_arrow_v2(env)
    except Exception:
        try:
            # Second‑best implementation
            return make_arrow_v1(env)
        except Exception:
            # Baseline implementation – always defined
            return make_arrow_v0(env)


