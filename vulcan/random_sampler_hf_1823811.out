    # Reset the environment (ignore errors if already reset)
    try:
        env.reset()
    except Exception:
        pass

    actions: list[int] = []

    # ------------------------------------------------------------------
    # Identify the goal item index (the item we need to craft)
    # ------------------------------------------------------------------
    goal_idx = None
    task = getattr(env, "task", None)
    if task is not None:
        goal_idx = getattr(task, "goal", None)
        if goal_idx is None and isinstance(task, (list, tuple)):
            goal_idx = task[0]

    if goal_idx is None:
        # fallback to the name "arrow" if the task does not expose the goal
        try:
            goal_idx = env.world.cookbook.index["arrow"]
        except Exception:
            return actions

    # ------------------------------------------------------------------
    # What primitive resources are required for this goal?
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    # Current mutable position of the agent
    cur_pos = list(env._current_state.pos)          # [x, y]

    # Work on a copy of the grid so we can simulate pickups / removals
    grid = env._current_state.grid.copy()

    # ------------------------------------------------------------------
    # Helper: BFS path finder that avoids non‑grabbable obstacles.
    # Returns a list of action indices that move from start to any cell in targets.
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_path(start: tuple[int, int],
                 targets: set[tuple[int, int]],
                 blocked: np.ndarray) -> list[int]:
        """Find shortest path (Manhattan) avoiding blocked cells."""
        if start in targets:
            return []

        W, H = blocked.shape
        q = deque()
        q.append((start[0], start[1], []))
        visited = np.full((W, H), False, dtype=bool)
        visited[start[0], start[1]] = True

        while q:
            x, y, path = q.popleft()
            for action, (dx, dy) in enumerate(((0, 1), (0, -1), (-1, 0), (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:
                    new_path = path + [action]   # 0:DOWN,1:UP,2:LEFT,3:RIGHT
                    if (nx, ny) in targets:
                        return new_path
                    visited[nx, ny] = True
                    q.append((nx, ny, new_path))
        # No reachable target
        return []

    # ------------------------------------------------------------------
    # Helper: compute blocked mask from the current grid copy.
    # ------------------------------------------------------------------
    def compute_blocked(g: np.ndarray) -> np.ndarray:
        """Return a bool mask where True indicates an impassable cell."""
        blocked = np.zeros(g.shape[:2], dtype=bool)
        for idx in env.world.non_grabbable_indices:
            blocked |= (g[:, :, idx] > 0)
        return blocked

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for kind_idx, needed in primitives_needed.items():
        remaining = needed
        while remaining > 0:
            # Find all cells that currently contain this primitive
            positions = np.argwhere(grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                # No more of this primitive on the map – abort collection for this kind
                break

            # Choose the reachable primitive with the smallest BFS distance
            blocked_mask = compute_blocked(grid)
            target_set = {tuple(p) for p in positions.tolist()}
            path = bfs_path(tuple(cur_pos), target_set, blocked_mask)

            if not path:
                # No reachable primitive (perhaps surrounded by water/stone)
                break

            # Determine which target we actually arrived at by simulating the path
            tmp_pos = cur_pos.copy()
            for a in path:
                if a == 0:   # DOWN
                    tmp_pos[1] += 1
                elif a == 1: # UP
                    tmp_pos[1] -= 1
                elif a == 2: # LEFT
                    tmp_pos[0] -= 1
                elif a == 3: # RIGHT
                    tmp_pos[0] += 1
            target = tuple(tmp_pos)

            # Append the movement actions and the USE action to pick up
            actions.extend(path)
            actions.append(4)                     # USE
            cur_pos[0], cur_pos[1] = target

            # Simulate the pickup in our local copy of the grid
            grid[target[0], target[1], kind_idx] = 0
            remaining -= 1

    # ------------------------------------------------------------------
    # After gathering primitives, go to the appropriate workshop (if any) and craft.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")

    if workshop_kind is not None:
        # Locate workshop cells on the (still current) grid
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
        if ws_positions.size > 0:
            blocked_mask = compute_blocked(grid)
            ws_set = {tuple(p) for p in ws_positions.tolist()}
            ws_path = bfs_path(tuple(cur_pos), ws_set, blocked_mask)
            if ws_path:
                actions.extend(ws_path)
                # Update current position to the workshop we reached
                for a in ws_path:
                    if a == 0:
                        cur_pos[1] += 1
                    elif a == 1:
                        cur_pos[1] -= 1
                    elif a == 2:
                        cur_pos[0] -= 1
                    elif a == 3:
                        cur_pos[0] += 1
        # Use the workshop to craft the goal item
        actions.append(4)   # USE
    else:
        # No specific workshop required – craft at the current location
        actions.append(4)   # USE

    return actions


    try:
        env.reset()
    except Exception:
        pass

    actions = []

    # ------------------------------------------------------------------
    # Identify the goal item index (the item we need to craft)
    # ------------------------------------------------------------------
    goal_idx = None
    task = getattr(env, "task", None)
    if task is not None:
        goal_idx = getattr(task, "goal", None)
        if goal_idx is None and isinstance(task, (list, tuple)):
            goal_idx = task[0]

    # Fallback: try to look up "arrow" directly in the cookbook
    if goal_idx is None:
        try:
            goal_idx = env.world.cookbook.index["arrow"]
        except Exception:
            return actions

    # ------------------------------------------------------------------
    # Determine which primitive resources are required for this goal
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)

    # Current mutable agent position (list for easy updates)
    cur_pos = list(env._current_state.pos)          # [x, y]

    # Work on a copy of the grid so we can simulate pickups without
    # affecting the real environment.
    grid = env._current_state.grid.copy()

    # ------------------------------------------------------------------
    # Helper: generate a Manhattan path from cur_pos to a target cell.
    # Returns a list of action indices and updates cur_pos.
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal cur_pos
        seq = []
        tx, ty = target
        while cur_pos[0] < tx:
            seq.append(3)          # RIGHT
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            seq.append(2)          # LEFT
            cur_pos[0] -= 1
        while cur_pos[1] < ty:
            seq.append(0)          # DOWN
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            seq.append(1)          # UP
            cur_pos[1] -= 1
        return seq

    # ------------------------------------------------------------------
    # Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for kind_idx, needed in primitives_needed.items():
        remaining = needed
        while remaining > 0:
            positions = np.argwhere(grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                # No more of this primitive on the map – give up on it.
                break
            # Choose the nearest primitive (Manhattan distance) to reduce travel.
            dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])
            nearest = int(np.argmin(dists))
            target = tuple(positions[nearest])
            actions.extend(move_to(target))
            actions.append(4)                      # USE to pick up
            # Simulate the pickup so we don't target the same cell again.
            grid[target[0], target[1], kind_idx] = 0
            remaining -= 1

    # ------------------------------------------------------------------
    # After gathering primitives, move to the appropriate workshop (if any)
    # and craft the goal item.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
        if ws_positions.shape[0] > 0:
            dists = np.abs(ws_positions[:, 0] - cur_pos[0]) + np.abs(ws_positions[:, 1] - cur_pos[1])
            nearest = int(np.argmin(dists))
            ws_target = tuple(ws_positions[nearest])
            actions.extend(move_to(ws_target))
        actions.append(4)          # USE to craft at the workshop
    else:
        # No specific workshop required – craft at current location.
        actions.append(4)

    return actions

