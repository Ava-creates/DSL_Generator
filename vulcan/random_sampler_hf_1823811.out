    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Index of the item we need to craft (e.g., "arrow")
    goal_idx = env.task.goal

    # All primitive resources (including transitive) required for the goal
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the final crafting must occur at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: produce a Manhattan move sequence from start -> target.
    # Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    # ------------------------------------------------------------------
    def moves_to(start: tuple[int, int],
                 target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:
        x, y = start
        tx, ty = target
        seq: list[int] = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell that still contains a given kind.
    # ------------------------------------------------------------------
    harvested: dict[int, set[tuple[int, int]]] = {}

    def nearest_cell(kind: int,
                     from_pos: tuple[int, int]) -> tuple[int, int] | None:
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        return candidates[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # Collect all required primitive items.
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # No more available cells of this kind; skip this instance.
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up the primitive
            harvested[kind].add(target)     # Mark cell as consumed

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and perform the final craft.
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)

    # Final USE triggers crafting of the goal item (e.g., arrow).
    actions.append(4)

    return actions


