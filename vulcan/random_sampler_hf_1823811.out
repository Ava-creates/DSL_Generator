    # Reset environment and obtain references
    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    index = cookbook.index

    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Identify goal index for "arrow"
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []
    goal_idx = index[goal_name]

    # Primitive requirements (including transitive ones)
    needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    plan_actions = []

    # Helper: BFS path finder (4‑connected) that treats any occupied cell as blocked,
    # except the target cell itself.
    def bfs(start, target):
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)
        occupied[target] = False
        q = collections.deque([start])
        came = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:
                    nxt = (nr, nc)
                    if nxt not in came:
                        came[nxt] = cur
                        q.append(nxt)
        else:
            return None
        # reconstruct
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came[cur]
        path.reverse()
        return path

    # Mapping from movement delta to action index
    delta2act = {(1, 0): DOWN, (-1, 0): UP, (0, 1): RIGHT, (0, -1): LEFT}

    # Collect each required primitive one by one
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return plan_actions
            target = tuple(cells[0])

            path = bfs(state.pos, target)
            if path is None:
                return plan_actions

            for (r0, c0), (r1, c1) in zip(path, path[1:]):
                act = delta2act[(r1 - r0, c1 - c0)]
                plan_actions.append(act)
                state.pos = (r1, c1)

            plan_actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # Find workshop for the goal and move there
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return plan_actions

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return plan_actions
    wpos = tuple(workshop_cells[0])

    path = bfs(state.pos, wpos)
    if path is None:
        return plan_actions
    for (r0, c0), (r1, c1) in zip(path, path[1:]):
        act = delta2act[(r1 - r0, c1 - c0)]
        plan_actions.append(act)
        state.pos = (r1, c1)

    # Craft the arrow
    plan_actions.append(USE)

    return plan_actions


    # ------------------------------------------------------------
    # Basic constants and environment reset
    # ------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    idx = cookbook.index                      # name ↔ id mapping

    # ------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements
    # ------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []                              # arrow not defined in this world
    goal_idx = idx[goal_name]

    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------
    # Helper: BFS path‑finder (4‑connected Manhattan moves)
    # ------------------------------------------------------------
    def bfs(start, target):
        """Return a list of positions from start to target (inclusive)
        using 4‑connected moves. Returns None if target unreachable."""
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)          # True where blocked
        # allow stepping onto the target even if it is occupied (primitive or workshop)
        occupied[target] = False
        q = collections.deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w:
                    if not occupied[nr, nc] and (nr, nc) not in came_from:
                        came_from[(nr, nc)] = cur
                        q.append((nr, nc))
        else:
            return None  # target never reached

        # reconstruct path
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    # ------------------------------------------------------------
    # Mapping from movement delta to action index
    # ------------------------------------------------------------
    delta_to_action = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, 1): RIGHT,
        (0, -1): LEFT,
    }

    # ------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # locate the nearest remaining instance of the primitive
            positions = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if positions.size == 0:
                return actions  # primitive missing – abort planning

            # choose nearest by Manhattan distance
            dists = np.abs(positions[:, 0] - state.pos[0]) + np.abs(positions[:, 1] - state.pos[1])
            nearest = positions[dists.argmin()]
            target = (int(nearest[0]), int(nearest[1]))

            # plan a path to the primitive
            path = bfs(state.pos, target)
            if path is None:
                return actions  # unreachable – abort planning

            # translate the path into actions and update simulated state
            for (r0, c0), (r1, c1) in zip(path, path[1:]):
                act = delta_to_action[(r1 - r0, c1 - c0)]
                actions.append(act)
                state.pos = (r1, c1)

            # pick up the primitive
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # no workshop information – cannot craft

    workshop_idx = idx[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # workshop not present in this scenario

    # pick the first workshop cell (any will do)
    w_r, w_c = int(workshop_cells[0][0]), int(workshop_cells[0][1])
    path = bfs(state.pos, (w_r, w_c))
    if path is None:
        return actions  # unreachable – abort

    for (r0, c0), (r1, c1) in zip(path, path[1:]):
        act = delta_to_action[(r1 - r0, c1 - c0)]
        actions.append(act)
        state.pos = (r1, c1)

    # craft the arrow at the workshop
    actions.append(USE)

    return actions

