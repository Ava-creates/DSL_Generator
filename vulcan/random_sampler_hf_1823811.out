    # Reset the environment to obtain the initial internal state.
    env.reset()
    # Shortcut references.
    world = env.world
    state = env._current_state          # type: CraftState
    goal = env.task.goal                # integer index of the desired item

    # ------------------------------------------------------------------
    # 1. Determine which primitive resources are required to craft the goal.
    # ------------------------------------------------------------------
    # cookbook.primitives_for returns a dict {primitive_index: count}
    needed = dict(world.cookbook.primitives_for(goal))

    actions = []  # list of action indices to be returned

    # Helper to issue an action and update the local state reference.
    def _step(act):
        """Execute action `act` in the environment and refresh `state`."""
        nonlocal state
        _, _, _ = env.step(act)          # ignore reward / done / obs
        state = env._current_state

    # ------------------------------------------------------------------
    # 2. Collect all required primitives.
