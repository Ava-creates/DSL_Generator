    # Action constants (match the environment definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)

    # Primitive requirements for a single arrow: {prim_idx: count}
    prim_req = world.cookbook.primitives_for(goal_idx)

    # Work on a mutable copy of the grid and track agent position
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)   # (row, col)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    import collections
    import numpy as np

    def _cell_blocked(pos, kind_to_ignore=None):
        """Return True if the cell at pos is occupied by any entity
        other than the optional kind_to_ignore."""
        x, y = pos
        occ = grid[x, y, :]
        if kind_to_ignore is not None:
            occ = occ.copy()
            occ[kind_to_ignore] = 0
        return occ.any()

    def _bfs(start, goal, ignore_kind=None):
        """Bread‑first search on the current grid avoiding blocked cells.
        If ignore_kind is given, that kind is treated as traversable (useful
        when the goal cell contains the item we want to pick up)."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        if not _cell_blocked(nxt, kind_to_ignore=ignore_kind) or nxt == goal:
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _path_to_actions(path):
        """Translate a list of grid positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move(src, dst, ignore_kind=None):
        """Return a list of actions moving from src to dst using BFS."""
        p = _bfs(src, dst, ignore_kind=ignore_kind)
        if p is None:
            # fallback to Manhattan moves (may collide with obstacles)
            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return _path_to_actions(p)

    def _nearest_reachable(pos, kind_idx, banned):
        """Find the nearest reachable cell containing `kind_idx`
        that is not in the `banned` set. Returns None if none reachable."""
        candidates = np.argwhere(grid[:, :, kind_idx] > 0)
        if candidates.size == 0:
            return None
        # filter out already used locations
        if banned:
            mask = np.array([tuple(c) not in banned for c in candidates])
            candidates = candidates[mask]
            if candidates.size == 0:
                return None
        # sort by Manhattan distance for efficiency
        dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
        order = np.argsort(dists)
        for idx in order:
            cand = tuple(candidates[idx].tolist())
            if _bfs(pos, cand, ignore_kind=kind_idx) is not None:
                return cand
        return None

    # ------------------------------------------------------------------
    # Planning: collect primitives
    # ------------------------------------------------------------------
    actions = []
    harvested = {k: set() for k in prim_req.keys()}

    for kind_idx, needed in prim_req.items():
        for _ in range(needed):
            target = _nearest_reachable(cur_pos, kind_idx, harvested[kind_idx])
            if target is None:
                # Primitive not found or unreachable – abort planning
                return actions
            actions += _move(cur_pos, target, ignore_kind=kind_idx)
            cur_pos = target
            actions.append(USE)          # pick up the primitive
            harvested[kind_idx].add(target)
            # Remove the primitive from our local grid copy
            grid[target[0], target[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_target = _nearest_reachable(cur_pos, workshop_idx, set())
        if ws_target is not None:
            actions += _move(cur_pos, ws_target)
            cur_pos = ws_target
            actions.append(USE)          # craft at the workshop

    return actions


    import collections
    import numpy as np

    # Action constants (match environment definition)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    goal_name = "arrow"
    goal_idx = world.cookbook.index.index(goal_name)

    # Primitive requirements for one arrow: {prim_idx: count}
    prim_req = world.cookbook.primitives_for(goal_idx)

    # Current mutable view of the grid and agent position
    grid = env._current_state.grid
    cur_pos = tuple(env._current_state.pos)  # (row, col)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def cell_blocked(pos, ignore_kind=None):
        """Return True if the cell is occupied by any entity other than ignore_kind."""
        x, y = pos
        if ignore_kind is not None and grid[x, y, ignore_kind] > 0:
            # The target entity is allowed to be present
            return False
        return grid[x, y, :].any()

    def bfs(start, goal, ignore_kind=None):
        """Bread‑first search returning a list of positions from start to goal.
        Cells occupied by any entity are avoided unless they contain ignore_kind."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        if not cell_blocked(nxt, ignore_kind) or nxt == goal:
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def path_to_actions(path):
        """Convert a list of positions to action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent positions in path")
        return acts

    def move_to(src, dst, ignore_kind=None):
        """Return actions moving from src to dst using BFS with fallback to Manhattan."""
        p = bfs(src, dst, ignore_kind)
        if p is None:
            # fallback: simple Manhattan moves (may collide with obstacles)
            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return path_to_actions(p)

    def nearest(pos, kind_idx, banned):
        """Find nearest cell containing kind_idx not in banned set."""
        candidates = np.argwhere(grid[:, :, kind_idx] > 0)
        if candidates.size == 0:
            return None
        if banned:
            mask = np.array([tuple(c) not in banned for c in candidates])
            candidates = candidates[mask]
            if candidates.size == 0:
                return None
        dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
        nearest_idx = dists.argmin()
        return tuple(candidates[nearest_idx].tolist())

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []
    harvested = {k: set() for k in prim_req.keys()}

    # 1. Collect required primitives
    for kind_idx, count in prim_req.items():
        for _ in range(count):
            target = nearest(cur_pos, kind_idx, harvested[kind_idx])
            if target is None:
                # Primitive unavailable – abort planning early
                return actions
            actions += move_to(cur_pos, target, ignore_kind=kind_idx)
            cur_pos = target
            actions.append(USE)          # pick up primitive
            harvested[kind_idx].add(target)

    # 2. Move to workshop (if recipe specifies one) and craft
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_target = nearest(cur_pos, workshop_idx, set())
        if ws_target is not None:
            actions += move_to(cur_pos, ws_target)
            cur_pos = ws_target
            actions.append(USE)          # craft at workshop

    return actions

