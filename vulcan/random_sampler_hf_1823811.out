                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay in place
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur → nxt into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
