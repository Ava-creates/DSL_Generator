    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    dirs = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]

    # ------------------------------------------------------------------
    # Helper: BFS path finder that avoids any occupied cell.
    # ------------------------------------------------------------------
    def _bfs_path(start, goal, grid):
        from collections import deque
        visited = set()
        q = deque()
        q.append((start, []))
        visited.add(start)
        w, h = grid.shape[:2]

        while q:
            (x, y), path = q.popleft()
            if (x, y) == goal:
                return path
            for dx, dy, act in dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    # cell is blocked if any kind is present (non‑zero)
                    if (grid[nx, ny, :] > 0).any():
                        continue
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return None

    # ------------------------------------------------------------------
    # Helper: Manhattan move actions (fallback when BFS fails)
    # ------------------------------------------------------------------
    def _manhattan_path(src, dst):
        actions = []
        sx, sy = src
        tx, ty = dst
        dx = tx - sx
        dy = ty - sy
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    # ------------------------------------------------------------------
    # 1. Identify the goal (arrow) and its primitive requirements
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    actions = []
    cur_pos = env._current_state.pos
    grid = env._current_state.grid

    # ------------------------------------------------------------------
    # 2. Collect each required primitive (respecting required counts)
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            # locate all cells that currently contain this primitive
            locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not locations:
                # primitive not present – abort early
                return actions
            # choose the nearest one (Manhattan distance)
            target = min(locations,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            # try to find a collision‑free path
            path = _bfs_path(cur_pos, target, grid)
            if path is None:
                path = _manhattan_path(cur_pos, target)
            actions += path
            cur_pos = target
            # pick up the primitive
            actions.append(USE)
            # update local grid view (primitive cell becomes empty)
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Move to the required workshop and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if locations:
            target = min(locations,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            path = _bfs_path(cur_pos, target, grid)
            if path is None:
                path = _manhattan_path(cur_pos, target)
            actions += path
            cur_pos = target
            # craft at the workshop
            actions.append(USE)

    return actions


    # basic constants
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    idx = world.cookbook.index
    primitives_set = world.cookbook.primitives
    recipes = world.cookbook.recipes

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Manhattan moves from src (x,y) to dst (x,y)."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_kind(pos, kind_idx):
        """Find the closest cell that currently contains an entity of kind_idx."""
        grid = env._current_state.grid
        locations = list(zip(*np.where(grid[:, :, kind_idx] > 0)))
        if not locations:
            return None
        dists = [abs(px - pos[0]) + abs(py - pos[1]) for (px, py) in locations]
        return locations[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # Planning state
    # ------------------------------------------------------------------
    actions = []
    cur_pos = env._current_state.pos
    # copy of inventory that we update as we plan actions
    inventory = env._current_state.inventory.copy()

    # ------------------------------------------------------------------
    # Recursive planner: guarantee we have `need` copies of `item_idx`
    # ------------------------------------------------------------------
    def _ensure(item_idx, need):
        nonlocal cur_pos, actions, inventory

        # already have enough?
        have = inventory[item_idx]
        if have >= need:
            return

        missing = need - have

        # --------------------------------------------------------------
        # Primitive resources – just go pick them up
        # --------------------------------------------------------------
        if item_idx in primitives_set:
            for _ in range(missing):
                target = _nearest_kind(cur_pos, item_idx)
                if target is None:
                    # cannot find the primitive – abort planning
                    return
                actions.extend(_move_actions(cur_pos, target))
                cur_pos = target
                actions.append(USE)          # pick up
                inventory[item_idx] += 1
            return

        # --------------------------------------------------------------
        # Craftable item – first obtain all ingredients
        # --------------------------------------------------------------
        recipe = recipes.get(item_idx, {})
        workshop_name = recipe.get('_at')
        # for each ingredient, compute total amount required for all missing copies
        for ing_idx, cnt in recipe.items():
            if ing_idx == '_at':
                continue
            total_needed = cnt * missing
            _ensure(ing_idx, total_needed)

        # --------------------------------------------------------------
        # Move to the appropriate workshop (if any) and craft
        # --------------------------------------------------------------
        if workshop_name is not None:
            workshop_idx = idx.index(workshop_name)
            wpos = _nearest_kind(cur_pos, workshop_idx)
            if wpos is not None:
                actions.extend(_move_actions(cur_pos, wpos))
                cur_pos = wpos

        # perform the crafting actions one by one, consuming ingredients
        for _ in range(missing):
            # consume ingredients from our simulated inventory
            for ing_idx, cnt in recipe.items():
                if ing_idx == '_at':
                    continue
                inventory[ing_idx] -= cnt
            actions.append(USE)          # craft at current location
            inventory[item_idx] += 1

    # ------------------------------------------------------------------
    # Entry point: make one 'arrow'
    # ------------------------------------------------------------------
    arrow_idx = idx.index('arrow')
    _ensure(arrow_idx, 1)

    return actions

