    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (match CraftLab.action_specs)
    # ----------------------------------------------------------------------
    # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: shortest path (BFS) to any free cell adjacent to a target cell
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        """Return a list of action indices that moves from *start* to a free
        cell 4‑connected to *target*. If no such path exists, return [].

        *blocked* is a bool ndarray where True means the cell is occupied.
        """
        h, w = blocked.shape
        tx, ty = target
        # admissible goal cells (free and adjacent)
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ----------------------------------------------------------------------
    # Reset environment and fetch current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []                     # cannot obtain state → nothing to do

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Determine goal item (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # arrow not defined in this world

    # Primitive requirements for ONE arrow
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # Workshop needed for the goal (look for special key "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                     # no workshop information

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # unknown workshop name

    # ----------------------------------------------------------------------
    # Mutable copies for planning (so we can simulate pickups)
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                       # (x, y)
    grid = state.grid.copy()                     # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)          # bool matrix of blocked cells

    plan = []                                     # final list of actions

    # ----------------------------------------------------------------------
    # Helper: move next to a cell containing *kind_idx* and USE it.
    # Updates the simulated world state.
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Navigate to a free cell adjacent to *target*, issue USE and
        update the simulated world state. Returns False if movement is
        impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # execute movement actions
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # USE action
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            # pick up a single unit
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect each required primitive (respecting the needed count)
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # locate all cells that still contain this primitive
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.shape[0] == 0:
                # primitive not present → abort planning, return what we have
                return plan
            # pick the closest one (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    # Workshops are static; if they disappeared from *grid* (because we
    # cleared a cell that happened to host the workshop), fall back to
    # the original scenario grid.
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan                     # no workshop found

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (match CraftLab.action_specs)
    # ----------------------------------------------------------------------
    # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS to a free cell adjacent to a target cell
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        """Return a list of action indices that moves from *start* to a free
        cell 4‑connected to *target*. If no such path exists, return [].

        *start* and *target* are (x, y) tuples.
        *blocked* is a bool ndarray where True means the cell is occupied.
        """
        h, w = blocked.shape
        tx, ty = target

        # all admissible goal cells (free and adjacent)
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ----------------------------------------------------------------------
    # Reset environment and obtain the current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []                     # cannot obtain state

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # arrow not defined

    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # find workshop name from recipe (keys "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                     # no workshop info

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # unknown workshop

    # ----------------------------------------------------------------------
    # Mutable copies for planning (simulate pickups)
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)               # (x, y)
    grid = state.grid.copy()             # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)  # bool matrix of blocked cells

    plan = []                             # final action list

    # ----------------------------------------------------------------------
    # Helper: move adjacent to a cell containing *kind_idx* and USE it.
    # Updates simulated world state.
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Navigate to a free cell adjacent to *target*, issue USE and
        update the simulated state. Returns False if movement impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False

        # execute movement actions
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # USE action
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            # pick up one unit
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives (respecting counts)
    # ----------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.shape[0] == 0:
                # primitive missing – abort planning
                return plan
            # choose closest by Manhattan distance
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to a workshop cell and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # workshops are static; fall back to original grid if they were cleared
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan  # no workshop found

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan

