    # Reset environment and get initial state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Goal item index
    goal_idx = env.task.goal

    # Action indices from the environment
    action_map = env.action_specs()
    ACTION_DOWN = action_map["DOWN"]
    ACTION_UP = action_map["UP"]
    ACTION_LEFT = action_map["LEFT"]
    ACTION_RIGHT = action_map["RIGHT"]
    ACTION_USE = action_map["USE"]
    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to find a shortest sequence of movement actions that
    # brings the agent to a cell containing `target_kind`. Cells occupied
    # by non‑grabbable entities are treated as obstacles, but the target
    # cell itself may be occupied (we need to step onto it to use it).
    # ------------------------------------------------------------------
    def find_path_to(state, target_kind):
        grid = state.grid
        H, W, _ = grid.shape
        start = state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    # Blocked if any non‑grabbable entity is present
                    blocked = any(grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)
                    # Allow moving onto the target cell even if occupied
                    if not blocked or grid[nx, ny, target_kind] > 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return None  # unreachable

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources for the goal.
    # ------------------------------------------------------------------
    required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    for prim_idx, count in required.items():
        for _ in range(count):
            path = find_path_to(state, prim_idx)
            if path is None:
                continue  # should not happen in valid scenarios
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use the primitive (pick up)
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        path = find_path_to(state, workshop_kind)
        if path:
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use the workshop to craft the item
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    return actions


    # Reset the environment and obtain the initial state and world objects.
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Map action names to indices using the environment specification.
    action_map = env.action_specs()
    ACTION_DOWN = action_map["DOWN"]
    ACTION_UP = action_map["UP"]
    ACTION_LEFT = action_map["LEFT"]
    ACTION_RIGHT = action_map["RIGHT"]
    ACTION_USE = action_map["USE"]
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to find a shortest sequence of movement actions that
    # brings the agent to any cell containing `target_kind`.  Cells that
    # contain non‑grabbable entities are treated as obstacles.
    # ------------------------------------------------------------------
    def bfs_path(current_state, target_kind):
        grid = current_state.grid
        H, W, _ = grid.shape
        start = current_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    # Block movement onto cells occupied by non‑grabbable items.
                    blocked = any(grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)
                    if not blocked:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # Target not reachable (should not happen in well‑formed scenarios).
        return None

    # ------------------------------------------------------------------
    # 1) Gather all primitive resources required for the goal item.
    # ------------------------------------------------------------------
    goal_idx = env.task.goal
    needed_primitives = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    for prim_idx, count in needed_primitives.items():
        for _ in range(count):
            path = bfs_path(state, prim_idx)
            if path is None:
                continue  # Skip if unreachable; unlikely in valid tasks.
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive at the current location.
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        path = bfs_path(state, workshop_kind)
        if path:
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use the workshop to craft the item.
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    return actions

