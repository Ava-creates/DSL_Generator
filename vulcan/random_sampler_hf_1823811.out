        occ = np.where(state.grid[:, :, ng] > 0)
        blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal):
        """Shortest path (list of positions) from start to goal avoiding blocked cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked_cells:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # unreachable – stay put
        return [start]

    def move_act(cur, nxt):
        """Translate adjacent step into action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3  # RIGHT
        if dx == -1:
            return 2  # LEFT
        if dy == 1:
            return 0  # DOWN
        if dy == -1:
            return 1  # UP
        raise AssertionError("Non‑adjacent move requested")

    # ------------------------------------------------------------------
    # Build action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) Collect required primitives
    for p_idx, needed in prim_counts.items():
        while state.inventory[p_idx] < needed:
            locations = find_locs(p_idx)
            if not locations:
                # No more of this primitive on the map; break to avoid infinite loop
                break
            # Choose nearest primitive by Manhattan distance
            target = min(locations,
                         key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
            # Move to the target
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_act(cur_pos, step))
                cur_pos = step
            # Pick up primitive
            actions.append(4)  # USE
            # Update simulated state
            state.inventory[p_idx] += 1
            state.grid[target[0], target[1], p_idx] = 0

    # 2) Go to workshop (if required) and craft
    if workshop_kind is not None:
        wk_locs = find_locs(workshop_kind)
        if wk_locs:
            target = min(wk_locs,
                         key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_act(cur_pos, step))
                cur_pos = step
    # Craft the arrow
    actions.append(4)  # USE

    return actions


