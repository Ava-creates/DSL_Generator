    # Reset environment and obtain initial state
    env.reset()
    state = env._current_state

    # -------------------------------------------------------------------------
    # Determine the index of the goal item ("arrow")
    # -------------------------------------------------------------------------
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Goal 'arrow' not found in cookbook")

    # -------------------------------------------------------------------------
    # Action specifications
    # -------------------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    delta_to_act = {
        (1, 0): ACT_DOWN,
        (-1, 0): ACT_UP,
        (0, 1): ACT_RIGHT,
        (0, -1): ACT_LEFT,
    }

    actions = []

    # -------------------------------------------------------------------------
    # Helper: BFS to compute a short path (as actions) between two positions,
    # allowing stepping onto the goal cell even if occupied.
    # -------------------------------------------------------------------------
    def bfs_path(start, goal):
        from collections import deque

        h, w, _ = state.grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:
                    # Allow moving onto the goal even if something occupies it
                    if not state.grid[ny, nx, :].any() or (ny, nx) == goal:
                        visited[ny, nx] = True
                        prev[(ny, nx)] = (y, x)
                        q.append((ny, nx))

        if goal not in prev and start != goal:
            return []  # no path found

        # reconstruct actions
        cur = goal
        path_actions = []
        while cur != start:
            p = prev[cur]
            dy, dx = cur[0] - p[0], cur[1] - p[1]
            path_actions.append(delta_to_act[(dy, dx)])
            cur = p
        path_actions.reverse()
        return path_actions

    # -------------------------------------------------------------------------
    # Helper: move the agent to a target cell using the BFS planner.
    # -------------------------------------------------------------------------
    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            step_actions = bfs_path(state.pos, target)
            if not step_actions:  # unreachable
                break
            for a in step_actions:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # -------------------------------------------------------------------------
    # Helper: locate the nearest cell containing a specific kind index.
    # -------------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # -------------------------------------------------------------------------
    # Helper: pick a free cell adjacent (including diagonals) to a given cell.
    # Prefer the cell itself if it is free.
    # -------------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        # fallback: stay where we are
        return state.pos

    # -------------------------------------------------------------------------
    # Collect all primitive resources required for the arrow.
    # -------------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in primitives_needed.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                # Primitive not present; abort collection for this item
                continue
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # -------------------------------------------------------------------------
    # Move to the workshop (if specified) and craft the arrow.
    # -------------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(workshop_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            move_to(adj)
    # Use the craft action at current location (or adjacent to workshop)
    actions.append(ACT_USE)
    _, _, _ = env.step(ACT_USE)
    state = env._current_state

    return actions


    env.reset()
    state = env._current_state

    # Determine the goal index for the arrow item
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow goal not found in the cookbook")

    # Action specifications
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]
    delta_to_act = {
        (1, 0): ACT_DOWN,
        (-1, 0): ACT_UP,
        (0, 1): ACT_RIGHT,
        (0, -1): ACT_LEFT,
    }

    actions = []

    # -------------------------------------------------------------------------
    # Helper: BFS to compute a sequence of actions from start to goal (free cells)
    # -------------------------------------------------------------------------
    def bfs_path(start, goal):
        from collections import deque

        h, w, _ = state.grid.shape
        visited = np.full((h, w), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True

        while q:
            cur = q.popleft()
            if cur == goal:
                break
            y, x = cur
            for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:
                    # Permit stepping onto the goal even if occupied (for collect/craft)
                    if not state.grid[ny, nx, :].any() or (ny, nx) == goal:
                        visited[ny, nx] = True
                        prev[(ny, nx)] = (y, x)
                        q.append((ny, nx))

        if goal not in prev and start != goal:
            return []  # no path found

        # Reconstruct action list
        path_actions = []
        cur = goal
        while cur != start:
            p = prev[cur]
            dy, dx = cur[0] - p[0], cur[1] - p[1]
            path_actions.append(delta_to_act[(dy, dx)])
            cur = p
        path_actions.reverse()
        return path_actions

    # -------------------------------------------------------------------------
    # Helper: move the agent to an absolute position using BFS paths
    # -------------------------------------------------------------------------
    def move_to(target):
        nonlocal actions, state
        while state.pos != target:
            step_actions = bfs_path(state.pos, target)
            if not step_actions:
                # Unable to reach target; abort further movement
                break
            for a in step_actions:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # -------------------------------------------------------------------------
    # Helper: locate the nearest cell containing a given kind index
    # -------------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # -------------------------------------------------------------------------
    # Helper: pick a free cell adjacent (including diagonals) to a target cell
    # -------------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        h, w, _ = state.grid.shape
        # Prefer the cell itself if it is free
        if not state.grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not state.grid[ny, nx, :].any():
                        return (ny, nx)
        # Fallback: stay where we are (should rarely happen)
        return state.pos

    # -------------------------------------------------------------------------
    # Collect all primitive resources required for the goal item
    # -------------------------------------------------------------------------
    primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, needed in primitives.items():
        for _ in range(needed):
            src = find_nearest(kind_idx)
            if src is None:
                raise RuntimeError(f"Required primitive {kind_idx} not found in the map")
            adj = adjacent_free(src)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # -------------------------------------------------------------------------
    # Move to the workshop (if specified) and craft the goal item
    # -------------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        workshop_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(workshop_idx)
        if ws_pos is not None:
            adj = adjacent_free(ws_pos)
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    return actions

