    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # Index of the target item "arrow"
    arrow_idx = world.cookbook.index.index('arrow')
    # Primitive requirements for one arrow (primitive index -> count)
    needed = world.cookbook.primitives_for(arrow_idx)

    # Local mutable copy of the grid to keep track of consumed items
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)  # (row, col)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def bfs(start, goal, occupied):
        """Return a list of positions from start to goal avoiding occupied cells."""
        if start == goal:
            return [start]
        H, W = occupied.shape
        q = collections.deque()
        q.append(start)
        visited = {start: None}
        while q:
            r, c = q.popleft()
            for dr, dc in ((1, 0), (-1, 0), (0, -1), (0, 1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W and not occupied[nr, nc]:
                    nxt = (nr, nc)
                    if nxt not in visited:
                        visited[nxt] = (r, c)
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(visited[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        return None  # no path found

    def pos_to_actions(path):
        """Convert a list of positions to a list of movement actions."""
        act_seq = []
        for (r1, c1), (r2, c2) in zip(path, path[1:]):
            dr, dc = r2 - r1, c2 - c1
            if dr == 1:
                act_seq.append(DOWN)
            elif dr == -1:
                act_seq.append(UP)
            elif dc == 1:
                act_seq.append(RIGHT)
            elif dc == -1:
                act_seq.append(LEFT)
        return act_seq

    def nearest(pos, kind):
        """Find the nearest cell (Manhattan) that contains the given kind."""
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        idx = dists.argmin()
        return tuple(cells[idx].tolist())

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = nearest(cur_pos, prim_idx)
            if target is None:
                # Primitive not present – abort early
                return actions
            # Compute occupied cells (any non‑zero kind blocks movement)
            occupied = np.any(grid > 0, axis=2)
            # Allow stepping onto the target cell
            occupied[target] = False
            path = bfs(cur_pos, target, occupied)
            if path is None:
                # No reachable path – abort
                return actions
            actions += pos_to_actions(path)
            cur_pos = target
            actions.append(USE)  # pick up the primitive
            # Remove the primitive from our local view
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = nearest(cur_pos, workshop_idx)
        if workshop_pos is not None:
            occupied = np.any(grid > 0, axis=2)
            occupied[workshop_pos] = False
            path = bfs(cur_pos, workshop_pos, occupied)
            if path is not None:
                actions += pos_to_actions(path)
                cur_pos = workshop_pos
                actions.append(USE)  # craft at the workshop

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # index of the target item "arrow"
    arrow_idx = world.cookbook.index.index('arrow')
    # primitive requirements for one arrow: {prim_idx: count}
    needed = world.cookbook.primitives_for(arrow_idx)

    # mutable copy of the grid to keep track of consumed items
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)  # (row, col)

    height, width = grid.shape[:2]

    # ------------------------------------------------------------------
    # helpers
    # ------------------------------------------------------------------
    def nearest(pos, kind):
        """Return the coordinates of the nearest cell containing `kind`."""
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        idx = dists.argmin()
        return tuple(cells[idx].tolist())

    def bfs_path(src, dst):
        """Return a list of movement actions to go from src to dst avoiding
        non‑empty cells (except the destination)."""
        if src == dst:
            return []

        from collections import deque

        # direction vectors and corresponding actions
        dirs = [((1, 0), DOWN), ((-1, 0), UP),
                ((0, -1), LEFT), ((0, 1), RIGHT)]

        visited = set()
        visited.add(src)
        q = deque()
        q.append((src, []))

        while q:
            (r, c), actions = q.popleft()
            for (dr, dc), act in dirs:
                nr, nc = r + dr, c + dc
                if not (0 <= nr < height and 0 <= nc < width):
                    continue
                if (nr, nc) in visited:
                    continue
                # allow stepping onto the destination even if occupied
                if (nr, nc) != dst and np.any(grid[nr, nc, :] > 0):
                    continue
                visited.add((nr, nc))
                new_actions = actions + [act]
                if (nr, nc) == dst:
                    return new_actions
                q.append(((nr, nc), new_actions))
        # no path found – fall back to empty list
        return []

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = nearest(cur_pos, prim_idx)
            if target is None:
                # primitive not found; abort early
                return actions
            # move to the primitive
            actions += bfs_path(cur_pos, target)
            cur_pos = target
            # pick it up
            actions.append(USE)
            # remove it from our local copy so we don't target it again
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = nearest(cur_pos, workshop_idx)
        if workshop_pos is not None:
            actions += bfs_path(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)   # craft at the workshop

    return actions

