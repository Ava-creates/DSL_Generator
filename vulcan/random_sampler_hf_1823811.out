    def _path_to(cur_pos, target_pos):
        cx, cy = cur_pos
        tx, ty = target_pos
        moves = []
        # Move vertically (DOWN=0, UP=1)
        while cy < ty:
            moves.append(0)   # DOWN
            cy += 1
        while cy > ty:
            moves.append(1)   # UP
            cy -= 1
        # Move horizontally (LEFT=2, RIGHT=3)
        while cx > tx:
            moves.append(2)   # LEFT
            cx -= 1
        while cx < tx:
            moves.append(3)   # RIGHT
            cx += 1
        return moves

