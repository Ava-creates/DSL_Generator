    def bfs_path(start, target):
        """
        Bread‑first search returning a list of movement actions
        (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) that moves the agent from `start` to `target`.
        Cells occupied by any entity are considered blocked, except the target
        cell itself which may contain the item we want to reach.
        """
        occ = np.any(state.grid > 0, axis=2)  # True where blocked
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
