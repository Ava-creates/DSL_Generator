    import numpy as np
    from collections import deque

    # Action constants (match CraftLab.action_specs order)
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    def bfs_to_adjacent(start, target, blocked):
        """Return a list of movement actions that brings the agent from *start*
        to any empty cell that is 4‑connected to *target*.
        If no such path exists, returns an empty list."""
        h, w = blocked.shape
        goal_cells = []
        tx, ty = int(target[0]), int(target[1])
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ----------------------------------------------------------------------
    # Initialise / reset environment
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    try:
        arrow_idx = idx["arrow"]
    except Exception:
        return []

    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at") or recipe.get("_key")
    if workshop_name is None:
        return []
    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Local mutable copies of the world state
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()         # (n_kinds,)
    occupied = np.any(grid > 0, axis=2)        # (W, H) bool

    plan_actions = []

    def move_and_use(target_coord, kind_idx):
        """Move adjacent to *target_coord* (which holds *kind_idx*) and USE.
        Updates local copies of pos, grid, occupied and inventory."""
        nonlocal pos, plan_actions, grid, occupied, inventory
        path = bfs_to_adjacent(pos, target_coord, occupied)
        if not path and pos != target_coord:
            return False
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan_actions.extend(path)
        plan_actions.append(USE)

        tx, ty = int(target_coord[0]), int(target_coord[1])
        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect required primitives (may need multiple of same kind)
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.shape[0] == 0:
                # No more of this primitive left on the map; abort early
                return plan_actions
            # Choose the nearest candidate (Manhattan distance)
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = candidates[dists.argmin()]
            if not move_and_use(target, prim_idx):
                return plan_actions

    # ----------------------------------------------------------------------
    # Move to a workshop cell and craft the arrow
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # If the workshop cell was cleared during collection (unlikely), fall back to original grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan_actions
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = workshop_cells[dists.argmin()]
    move_and_use(workshop_target, workshop_idx)

    return plan_actions


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helper: BFS to any empty cell adjacent to a target cell.
    # Returns a list of movement actions (0:DOWN,1:UP,2:LEFT,3:RIGHT)
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    def bfs_to_adjacent(start, target, blocked):
        """Find a shortest path from start to any 4‑connected empty cell next to target."""
        h, w = blocked.shape
        # cells that are valid destinations (adjacent and free)
        goal_cells = []
        tx, ty = target
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []                     # no reachable neighbour

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []                         # unreachable

    # ----------------------------------------------------------------------
    # Initialise / reset environment
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        arrow_idx = idx["arrow"]
    except Exception:
        return []

    # primitive requirements for ONE arrow
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # workshop where arrow is crafted
    recipe_dict = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe_dict.get("_at") or recipe_dict.get("_key")
    if workshop_name is None:
        return []
    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Local mutable copies of the world state
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells
    inventory = state.inventory.copy()

    plan_actions = []

    # ----------------------------------------------------------------------
    # Helper: move next to a cell containing kind_idx and USE it.
    # Updates the simulated local state.
    # ----------------------------------------------------------------------
    def move_and_use(target_coord, kind_idx):
        nonlocal pos, plan_actions, grid, occupied, inventory
        path = bfs_to_adjacent(pos, target_coord, occupied)
        if not path and pos != target_coord:
            return False
        # execute movement actions
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan_actions.extend(path)
        # USE action
        plan_actions.append(USE)
        tx, ty = target_coord
        if grid[tx, ty, kind_idx] > 0:
            # pick up / craft
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # locate nearest remaining primitive of this kind
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.size == 0:
                # nothing left – abort and return current plan
                return plan_actions
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = tuple(candidates[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan_actions

    # ----------------------------------------------------------------------
    # Move to a workshop cell and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # fallback to original grid (workshop may be empty after pickups)
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan_actions
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan_actions

