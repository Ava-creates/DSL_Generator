    import numpy as np

    # Reset environment and get the initial state
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal item index
    goal_idx = env.task.goal

    # Primitives required to craft the goal (and their counts)
    needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # Determine if a specific workshop is required for this recipe
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []   # list of action indices to be returned

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` exists on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def nearest(positions):
        """Pick the position with minimal Manhattan distance to the agent."""
        cur = state.pos
        best = None
        best_dist = None
        for p in positions:
            d = abs(p[0] - cur[0]) + abs(p[1] - cur[1])
            if best_dist is None or d < best_dist:
                best_dist = d
                best = p
        return best

    def go_to(target):
        """Move the agent step‑by‑step towards `target` using Manhattan moves."""
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right
                act = 3          # RIGHT
                new_pos = (x + 1, y)
            elif x > tx:        # need to move left
                act = 2          # LEFT
                new_pos = (x - 1, y)
            elif y < ty:        # need to move down
                act = 0          # DOWN
                new_pos = (x, y + 1)
            else:               # need to move up
                act = 1          # UP
                new_pos = (x, y - 1)

            actions.append(act)
            _, state = state.step(act)   # update internal state after move

    # ------------------------------------------------------------------
    # 1. Collect all required primitive resources.
    # ------------------------------------------------------------------
    for kind_idx, count_needed in needed.items():
        for _ in range(count_needed):
            positions = locate(kind_idx)
            if not positions:
                # Primitive not present; abort early.
                return actions
            target = nearest(positions)
            go_to(target)

            # Pick up the primitive at the current location.
            actions.append(4)          # USE action
            _, state = state.step(4)

    # ------------------------------------------------------------------
    # 2. Go to the required workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = nearest(ws_positions)
            go_to(target_ws)

    # Attempt to craft / use at the current location.
    actions.append(4)          # USE to trigger crafting
    _, state = state.step(4)

    return actions


