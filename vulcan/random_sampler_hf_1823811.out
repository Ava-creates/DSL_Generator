    def locate(kind):
        """Return a list of (x, y) tuples where `kind` is present."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    # Helper: move from the agent's current position to `target` using
    # simple Manhattan steps (actions: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT).
    # The function updates `state` and records the actions taken.
    def go_to(target):
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right
                act = 3
                new_pos = (x + 1, y)
            elif x > tx:        # need to move left
                act = 2
                new_pos = (x - 1, y)
            elif y < ty:        # need to move down
                act = 0
                new_pos = (x, y + 1)
            else:               # need to move up
                act = 1
                new_pos = (x, y - 1)

            actions.append(act)
            _, state = state.step(act)

    actions = []  # will hold the final sequence of action indices

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ----------------------------------------------------------------------
