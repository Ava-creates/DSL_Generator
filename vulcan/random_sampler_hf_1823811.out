    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Goal identification
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for one arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest path from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay put
        return [start]

    def move_action(cur, nxt):
        """Convert a step from cur to nxt into an action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not adjacent")

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) Collect all required primitives
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            locations = find_locations(prim_idx)
            if not locations:
                break  # cannot find more of this primitive
            # nearest primitive (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # pick up
            actions.append(4)   # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2) Move to workshop (if required) and craft
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

    # final craft action
    actions.append(4)   # USE
    return actions


    # Reset the environment and get the current state/world objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    idx = world.cookbook.index           # Index mapping names ↔ ids

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe information
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for ONE arrow (includes recursive decomposition)
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Workshop required for crafting the arrow, if any
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest 4‑connected path from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Cells that cannot be entered (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        queue = collections.deque([start])
        prev = {start: None}
        while queue:
            cur = queue.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        queue.append(nxt)
        # No reachable path – stay where we are
        return [start]

    def move_action(cur, nxt):
        """Translate a step from cur to nxt into the corresponding action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("Requested move is not to an adjacent cell")

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # --------------------------------------------------------------
    # 1) Collect all required primitive items
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            # Locate remaining instances of this primitive on the map
            locations = find_locations(prim_idx)
            if not locations:
                # No more copies available – cannot satisfy the goal further
                break

            # Choose the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )

            # Compute a path and translate it into actions
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive (USE)
            actions.append(4)   # USE
            # Update our planning snapshot of inventory / grid
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # --------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # --------------------------------------------------------------
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

    # Finally, issue a USE action to perform the crafting
    actions.append(4)   # USE

    return actions

