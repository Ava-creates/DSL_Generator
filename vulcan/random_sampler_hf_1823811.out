    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    import numpy as np
    from collections import deque

    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, targets):
        """
        Bread‑first search returning a list of positions (excluding `start`)
        that leads to the nearest position in `targets`. Cells occupied by any
        entity are treated as blocked, except the target cell itself.
        """
        target_set = set(targets)
        if start in target_set:
            return []
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            x, y = pos
            for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]):
                    continue
                npos = (nx, ny)
                if npos in visited:
                    continue
                # Blocked if any entity occupies the cell and it is not a target.
                if np.any(state.grid[nx, ny, :] > 0) and npos not in target_set:
                    continue
                if npos in target_set:
                    return path + [npos]
                visited.add(npos)
                q.append((npos, path + [npos]))
        return []  # unreachable

    def follow_path(path):
        """Append actions for each step in `path` and update the state."""
        nonlocal state, actions
        for nxt in path:
            x, y = state.pos
            nx, ny = nxt
            if nx > x:
                act = 3   # RIGHT
            elif nx < x:
                act = 2   # LEFT
            elif ny > y:
                act = 0   # DOWN
            else:
                act = 1   # UP
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1. Collect all required primitives.
    for kind_idx, req_cnt in needed.items():
        while state.inventory[kind_idx] < req_cnt:
            positions = locate(kind_idx)
            if not positions:
                # Primitive not present; abort early.
                return actions
            path = bfs_path(state.pos, positions)
            if not path:
                # No reachable instance.
                return actions
            follow_path(path)
            # Pick up the primitive.
            actions.append(4)          # USE
            _, state = state.step(4)

    # 2. If a workshop is required, go there.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            path = bfs_path(state.pos, ws_positions)
            if path:
                follow_path(path)

    # 3. Use action to trigger crafting (whether at a workshop or current cell).
    actions.append(4)   # USE
    _, state = state.step(4)

    # Return the compiled list of actions.
    return actions

