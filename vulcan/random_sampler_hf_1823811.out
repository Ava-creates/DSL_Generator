            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell containing at least one of `kind`
    # ------------------------------------------------------------------
    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # ------------------------------------------------------------------
    # Collect all required primitive items
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # Primitive not present on the map – skip this instance
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE to pick up the primitive

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the final item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE to craft at the workshop

    return actions


    # Reset environment and extract useful references
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Index of the goal item (arrow)
    goal_idx = env.task.goal

    # Primitive requirements (including transitive ones)
    required = world.cookbook.primitives_for(goal_idx)

    # Workshop required for final crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------
    ACTIONS = {"DOWN": 0, "UP": 1, "LEFT": 2, "RIGHT": 3, "USE": 4}
    DIRS = [(0, 1, ACTIONS["DOWN"]), (0, -1, ACTIONS["UP"]),
            (-1, 0, ACTIONS["LEFT"]), (1, 0, ACTIONS["RIGHT"])]

    def bfs_path(start, target, allow_target_kind=None):
        """Return a list of positions from start to target using BFS.
        Cells occupied by any non‑grabbable entity are treated as blocked,
        except the target cell if it contains `allow_target_kind`."""
        W, H = scenario.init_grid.shape[:2]
        q = collections.deque()
        q.append(start)
        visited = {start: None}
        while q:
            x, y = q.popleft()
            if (x, y) == target:
                # reconstruct path
                path = []
                cur = target
                while cur != start:
                    path.append(cur)
                    cur = visited[cur]
                path.append(start)
                return list(reversed(path))
            for dx, dy, _ in DIRS:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < W and 0 <= ny < H):
                    continue
                if (nx, ny) in visited:
                    continue
                # check blockage
                blocked = False
                for idx in world.non_grabbable_indices:
                    if scenario.init_grid[nx, ny, idx] > 0:
                        blocked = True
                        break
                if blocked:
                    # allow stepping onto the target if it holds the needed kind
                    if (nx, ny) == target and allow_target_kind is not None:
                        if scenario.init_grid[nx, ny, allow_target_kind] > 0:
                            blocked = False
                if not blocked:
                    visited[(nx, ny)] = (x, y)
                    q.append((nx, ny))
        return None  # no path found

    def positions_to_actions(path):
        """Convert a list of positions (including start) to action indices."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(ACTIONS["RIGHT"])
            elif x1 == x0 - 1:
                acts.append(ACTIONS["LEFT"])
            elif y1 == y0 + 1:
                acts.append(ACTIONS["DOWN"])
            elif y1 == y0 - 1:
                acts.append(ACTIONS["UP"])
        return acts

    def nearest_cell(kind, from_pos):
        """Find the nearest cell that contains at least one of `kind`."""
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # ------------------------------------------------------------------
    # Main plan: collect primitives then craft at workshop
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)

    # Collect each required primitive the required number of times
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                continue  # primitive not present; skip
            path = bfs_path(cur_pos, target, allow_target_kind=kind)
            if path is None:
                continue  # cannot reach; skip
            actions.extend(positions_to_actions(path))
            actions.append(ACTIONS["USE"])  # pick up
            cur_pos = target

    # Move to workshop (if needed) and craft the final item
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            path = bfs_path(cur_pos, target, allow_target_kind=workshop_kind)
            if path is not None:
                actions.extend(positions_to_actions(path))
                actions.append(ACTIONS["USE"])  # craft at workshop

    return actions

