    def locate(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step_action(act):
        """Execute an action and update the local `state`."""
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def bfs_path(start, target):
        """Return a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) moving from start to target.
        Occupied cells are avoided, but the target cell itself is allowed even if occupied."""
        occ = np.any(state.grid > 0, axis=2)          # True where any entity exists
        # Ensure target is considered free for stepping onto
        occ[target] = False
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # No path found

    def go_to(target):
        """Move the agent to `target`, recording actions and updating `state`."""
