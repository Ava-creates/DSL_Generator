    import collections, numpy as np

    # Reset the environment and fetch the current state and world objects
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                   # CraftWorld
    idx = world.cookbook.index          # name → integer id

    # Goal: arrow
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for one arrow
    prim_req = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}

    # Workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # Working copies for planning (so we can simulate pickups)
    inv = state.inventory.copy()
    grid = state.grid.copy()
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) positions where `kind` occurs on the current grid."""
        occ = np.where(grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal):
        """Shortest 4‑connected path from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]

        # Cells occupied by any non‑grabbable entity block movement
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # Unreachable – stay where we are
        return [start]

    def step_to_action(cur, nxt):
        """Convert a move from cur to nxt into a DMLab action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not adjacent")

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []

    # --------------------------------------------------------------
    # 1) Collect all required primitives
    # --------------------------------------------------------------
    for prim_idx, needed in prim_req.items():
        while inv[prim_idx] < needed:
            candidates = locate(prim_idx)
            if not candidates:
                # No more of this primitive on the map – give up on this item
                break
            # Choose the nearest instance (Manhattan distance)
            target = min(candidates,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            # Move to the target
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(step_to_action(cur_pos, step))
                cur_pos = step
            # Pick up the primitive
            actions.append(4)   # USE
            inv[prim_idx] += 1
            grid[target[0], target[1], prim_idx] = 0   # remove from simulated grid

    # --------------------------------------------------------------
    # 2) Move to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    if workshop_kind is not None:
        wk_locs = locate(workshop_kind)
        if wk_locs:
            target = min(wk_locs,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(step_to_action(cur_pos, step))
                cur_pos = step

    # Final crafting action at the current location
    actions.append(4)   # USE

    return actions


    # Reset the environment to a fresh start
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld
    idx = world.cookbook.index           # name → integer id

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe requirements
    # ------------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive resources needed for ONE arrow
    primitive_needs = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop (if any) where the arrow must be crafted
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) positions where `kind` occurs on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal):
        """Return a shortest 4‑connected path from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Cells occupied by any non‑grabbable entity are blocked
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No reachable path – stay where we are
        return [start]

    def move_action(cur, nxt):
        """Translate a step between adjacent cells into a DMLab action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("Non‑adjacent move requested")

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # 1) Gather all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        while state.inventory[prim_idx] < needed:
            # Locate remaining instances of this primitive
            candidates = locate(prim_idx)
            if not candidates:
                # Cannot satisfy the recipe – abort further collection
                break

            # Choose the closest instance (Manhattan distance)
            target = min(candidates,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))

            # Move along shortest path to the target cell
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive (USE)
            actions.append(4)          # USE
            # Simulate the pickup for subsequent planning
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0   # remove from world

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locs = locate(workshop_kind)
        if wk_locs:
            target = min(wk_locs,
                         key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

    # Final crafting action (USE at current location)
    actions.append(4)          # USE

    return actions

