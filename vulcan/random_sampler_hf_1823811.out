    # Reset environment and get references
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal item index (arrow)
    goal_idx = env.task.goal

    # Primitive requirements (including transitive)
    required = world.cookbook.primitives_for(goal_idx)

    # Determine workshop kind for final crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # Copy of the initial grid that we will update as we harvest items
    grid = scenario.init_grid.copy()

    # Set of non‑walkable entity indices (obstacles)
    non_walkable = set(world.non_grabbable_indices)

    # Helper: check if a cell is walkable (allow stepping on a target cell)
    def is_walkable(x: int, y: int, target: tuple[int, int] | None = None) -> bool:
        if target is not None and (x, y) == target:
            # Always allow moving onto the goal cell (it may contain a grabbable item or workshop)
            return True
        # Cell is walkable if none of the non‑walkable kinds are present
        return all(grid[x, y, idx] == 0 for idx in non_walkable)

    # Helper: A* / BFS path finder returning a list of action indices
    def find_path(start: tuple[int, int], goal: tuple[int, int]) -> list[int]:
        if start == goal:
            return []
        from collections import deque

        width, height = grid.shape[0], grid.shape[1]
        q = deque([start])
        visited = {start}
        parent: dict[tuple[int, int], tuple[tuple[int, int], int]] = {}

        # Action order matches env: 0=DOWN,1=UP,2=LEFT,3=RIGHT
        moves = [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]

        while q:
            cx, cy = q.popleft()
            if (cx, cy) == goal:
                break
            for dx, dy, act in moves:
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < width and 0 <= ny < height:
                    nxt = (nx, ny)
                    if nxt not in visited and is_walkable(nx, ny, target=goal):
                        visited.add(nxt)
                        parent[nxt] = ((cx, cy), act)
                        q.append(nxt)

        # Reconstruct actions
        if goal not in parent:
            return []  # No path found
        actions_rev: list[int] = []
        cur = goal
        while cur != start:
            prev, act = parent[cur]
            actions_rev.append(act)
            cur = prev
        actions_rev.reverse()
        return actions_rev

    # Helper: locate the nearest cell that currently contains at least one of `kind`
    def nearest_cell_of_kind(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        # Compute Manhattan distances
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = int(np.argmin(dists))
        return tuple(cells[idx].tolist())

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ----------------------------------------------------------------------
    # Collect all required primitive items
    # ----------------------------------------------------------------------
    for kind, count in required.items():
        for _ in range(count):
            target = nearest_cell_of_kind(kind, cur_pos)
            if target is None:
                # Primitive not available; skip this instance
                continue
            move_seq = find_path(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up the primitive
            # Mark the cell as empty after harvesting
            grid[target[0], target[1], :] = 0
            cur_pos = target

    # ----------------------------------------------------------------------
    # Move to workshop (if required) and craft the final item
    # ----------------------------------------------------------------------
    if workshop_kind is not None:
        workshop_target = nearest_cell_of_kind(workshop_kind, cur_pos)
        if workshop_target is not None:
            move_seq = find_path(cur_pos, workshop_target)
            actions.extend(move_seq)
            cur_pos = workshop_target

    # Final USE triggers crafting of the goal item
    actions.append(4)

    return actions


    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # index of the goal item (arrow)
    goal_idx = env.task.goal

    # primitive resources (including transitive) required to craft the goal
    required = world.cookbook.primitives_for(goal_idx)

    # workshop where the final crafting must occur (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan move sequence (DOWN=0, UP=1, LEFT=2, RIGHT=3)
    # ------------------------------------------------------------------
    def moves_to(start: tuple[int, int], target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:
        x, y = start
        tx, ty = target
        seq: list[int] = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing at least one of `kind`,
    #         ignoring cells already harvested for that kind.
    # ------------------------------------------------------------------
    harvested: dict[int, set[tuple[int, int]]] = {}

    def nearest_cell(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        return candidates[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # Collect all required primitive items
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # primitive not found; skip this instance
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up the primitive
            harvested[kind].add(target)     # mark cell as consumed

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and perform the final craft
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)

    # Final USE triggers the crafting of the goal item (arrow)
    actions.append(4)

    return actions

