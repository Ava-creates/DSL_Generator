    # Helper mappings for actions
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4

    # Shortcut references
    world = env.world                      # CraftWorld instance
    scenario = env.scenario                # CraftScenario instance
    grid = scenario.init_grid.copy()       # (W, H, n_kinds) uint8 array
    pos = tuple(scenario.init_pos)         # (x, y)

    # Identify the goal index for the item "arrow"
    try:
        goal_idx = world.cookbook.index["arrow"]
    except Exception:
        # If the environment does not expose the index mapping, fall back to name lookup
        goal_idx = None
        for name, idx in world.cookbook.index.contents.items():
            if name.lower() == "arrow":
                goal_idx = idx
                break
    if goal_idx is None:
        return []  # cannot determine goal

    # Determine primitive requirements for one arrow
    primitive_req = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    if not primitive_req:
        # Arrow might be a primitive itself; just need to craft at its workshop
        primitive_req = {}

    # ----------------------------------------------------------------------
    # Utility functions
    # ----------------------------------------------------------------------
    def is_empty(cell_x, cell_y):
        """Return True if the cell at (cell_x, cell_y) has no entities."""
        return grid[cell_x, cell_y, :].sum() == 0

    def nearest_position(start, candidates):
        """Return the candidate position (x, y) with minimal Manhattan distance."""
        if not candidates:
            return None
        sx, sy = start
        best = None
        best_dist = None
        for (cx, cy) in candidates:
            d = abs(sx - cx) + abs(sy - cy)
            if best_dist is None or d < best_dist:
                best_dist, best = d, (cx, cy)
        return best

    def move_to(cur_pos, target_pos):
        """Generate actions to move from cur_pos to target_pos using Manhattan moves."""
        actions = []
        x, y = cur_pos
        tx, ty = target_pos
        while x < tx:
            actions.append(ACTION_RIGHT)
            x += 1
        while x > tx:
            actions.append(ACTION_LEFT)
            x -= 1
        while y < ty:
            actions.append(ACTION_DOWN)
            y += 1
        while y > ty:
            actions.append(ACTION_UP)
            y -= 1
        return actions, (x, y)

    def adjacent_free_cells(px, py):
        """Return a list of free neighbour cells (including staying on the same cell if free)."""
        neighbours = []
        for dx, dy in [(0, 0), (1, 0), (-1, 0), (0, 1), (0, -1)]:
            nx, ny = px + dx, py + dy
            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and is_empty(nx, ny):
                neighbours.append((nx, ny))
        return neighbours

