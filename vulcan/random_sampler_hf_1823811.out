    actions = []

    # ------------------------------------------------------------
    # Helper: BFS path planning avoiding occupied cells
    # ------------------------------------------------------------
    from collections import deque

    def bfs_path(start, target):
        """Return a list of actions to move from start to target."""
        grid = env._current_state.grid
        h, w, _ = grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # Allow stepping onto the target even if it contains something
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        raise RuntimeError(f"No path from {start} to {target}")

    # ------------------------------------------------------------
    # Helper: move to a free cell (uses bfs_path)
    # ------------------------------------------------------------
    def move_to(target):
