    # ------------------------------------------------------------------
    # Action constants
    # ------------------------------------------------------------------
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of actions from start to target,
    # avoiding any occupied cell (any non‑zero channel in the grid).
    # ------------------------------------------------------------------
    def bfs_path(start, target):
        grid = state.grid
        h, w, _ = grid.shape
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # allow stepping onto the target even if it is occupied
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # no path found

    # ------------------------------------------------------------------
    # Helper: move agent to an absolute position using bfs_path.
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                break  # unreachable
            for a in path:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell that contains a given kind index.
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: return a free cell adjacent (including diagonal) to `cell`.
    # If the cell itself is free, it may be returned.
    # ------------------------------------------------------------------
    def adjacent_free(cell):
        y, x = cell
        grid = state.grid
        h, w, _ = grid.shape
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        # fallback: if the target cell itself is free
        if not grid[y, x, :].any():
            return (y, x)
        return None

    # ------------------------------------------------------------------
    # Collect all primitive resources required for the arrow
    # ------------------------------------------------------------------
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in needed_prims.items():
