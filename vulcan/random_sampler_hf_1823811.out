    # Reset the environment and get the initial state and world objects
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld

    # Index of the goal item we need to craft
    goal_idx = env.task.goal

    # Primitive requirements for the goal (primitive_kind -> count)
    required = world.cookbook.primitives_for(goal_idx)

    # Action indices according to CraftLab's action specification
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to find a shortest path (as a list of movement actions)
    # from the current position to any cell that contains the desired kind.
    # The search avoids any occupied cell (any non‑zero kind) except the
    # target cell itself.
    # ------------------------------------------------------------------
    def find_path_to(state, target_kind):
        grid = state.grid
        H, W, _ = grid.shape
        start = state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            # If we are standing on the target kind, we have arrived
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow stepping onto the target cell even if it is occupied
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        return None

    # ------------------------------------------------------------------
    # 1) Collect every required primitive.
    # ------------------------------------------------------------------
    for kind, count in required.items():
        for _ in range(count):
            path = find_path_to(state, kind)
            if path is None:
                # Primitive not reachable – abort collection for this item
                continue
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use (pick up) the primitive now under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop required for the goal and craft the item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path_to(state, workshop_kind)
        if path:
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use the workshop to craft the goal item
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    return actions


    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld

    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Action indices according to CraftLab's action_specs
    ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4
    move_dirs = [(1, 0, ACTION_DOWN), (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]

    actions = []

    from collections import deque

    def find_path(state, target_kind):
        """BFS returning a list of movement actions to reach a cell
        containing `target_kind`. The agent may step onto that cell even
        though it is occupied."""
        grid = state.grid
        H, W = grid.shape[:2]
        start = state.pos
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if 0 <= nx < H and 0 <= ny < W and (nx, ny) not in visited:
                    # allow moving onto empty cells or the target cell itself
                    if grid[nx, ny, :].sum() == 0 or grid[nx, ny, target_kind] > 0:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return []  # fallback (should not happen in valid scenarios)

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, count in required.items():
        for _ in range(count):
            path = find_path(state, kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive now under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

