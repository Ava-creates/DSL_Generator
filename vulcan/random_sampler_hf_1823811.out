    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    index = cookbook.index

    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Identify goal index for "arrow"
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []
    goal_idx = index[goal_name]

    # Primitive requirements (including transitive ones)
    needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    plan_actions = []

    # Helper: BFS path finder (4‑connected) that treats any occupied cell as blocked,
    # except the target cell itself.
    def bfs(start, target):
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)
        occupied[target] = False
        q = collections.deque([start])
        came = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:
                    nxt = (nr, nc)
                    if nxt not in came:
                        came[nxt] = cur
                        q.append(nxt)
        else:
            return None
        # reconstruct path
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came[cur]
        path.reverse()
        return path

    # Mapping from movement delta to action index
    delta2act = {(1, 0): DOWN, (-1, 0): UP, (0, 1): RIGHT, (0, -1): LEFT}

    # Collect each required primitive one by one, preferring the closest instance
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # Find all remaining cells containing this primitive
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return plan_actions

            # Choose the nearest cell (Manhattan distance) to current position
            distances = np.abs(cells - np.array(state.pos)).sum(axis=1)
            nearest_idx = distances.argmin()
            target = tuple(cells[nearest_idx])

            path = bfs(state.pos, target)
            if path is None:
                return plan_actions

            for (r0, c0), (r1, c1) in zip(path, path[1:]):
                act = delta2act[(r1 - r0, c1 - c0)]
                plan_actions.append(act)
                state.pos = (r1, c1)

            # Pick up the primitive
            plan_actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # Locate the workshop required for crafting the goal
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return plan_actions

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return plan_actions
    wpos = tuple(workshop_cells[0])

    path = bfs(state.pos, wpos)
    if path is None:
        return plan_actions
    for (r0, c0), (r1, c1) in zip(path, path[1:]):
        act = delta2act[(r1 - r0, c1 - c0)]
        plan_actions.append(act)
        state.pos = (r1, c1)

    # Craft the arrow at the workshop
    plan_actions.append(USE)

    return plan_actions


    # Reset the environment and obtain references to the current state and world objects
    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    index = cookbook.index                    # name ↔ id mapping

    # Action indices as defined in CraftLab
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # -------------------------------------------------------------
    # Identify the goal item ("arrow") and the primitive requirements
    # -------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        # Arrow is not part of this world’s recipe set
        return []
    goal_idx = index[goal_name]

    # primitives_for returns a dict {primitive_index: count} needed for ONE goal item
    needed_prims = cookbook.primitives_for(goal_idx)   # may be empty if goal has no recipe
    plan = []                                            # accumulated action sequence

    # -------------------------------------------------------------
    # Helper: BFS path‑finder (Manhattan moves, 4‑connected)
    # -------------------------------------------------------------
    def bfs(start, target):
        """Return a list of positions from start to target (inclusive)
        using 4‑connected moves, treating any occupied cell as blocked
        except the target cell itself. Returns None if unreachable."""
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)          # True where any entity is present
        occupied[target] = False                           # allow stepping onto the target
        q = collections.deque([start])
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and not occupied[nr, nc]:
                    nxt = (nr, nc)
                    if nxt not in came_from:
                        came_from[nxt] = cur
                        q.append(nxt)
        else:
            return None  # target never reached

        # Reconstruct path from start to target
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    # Mapping from movement delta to action index
    delta_to_action = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, 1): RIGHT,
        (0, -1): LEFT,
    }

    # -------------------------------------------------------------
    # 1. Collect each required primitive (including multiplicities)
    # -------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            # Locate any remaining instance of the primitive on the map
            candidates = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if candidates.size == 0:
                # No more of this primitive; abort planning and return what we have
                return plan
            target_r, target_c = candidates[0]   # pick the first occurrence

            # Find a path to the primitive
            path = bfs(state.pos, (target_r, target_c))
            if path is None:
                # Unreachable primitive; abort planning
                return plan

            # Convert the path into movement actions and update the simulated state
            for (r0, c0), (r1, c1) in zip(path, path[1:]):
                act = delta_to_action[(r1 - r0, c1 - c0)]
                plan.append(act)
                state.pos = (r1, c1)

            # Use the primitive (pick up)
            plan.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[target_r, target_c, prim_idx] = 0

    # -------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the goal item
    # -------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        # No workshop specified for this recipe
        return plan

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # No workshop cell present in the current scenario
        return plan
    w_r, w_c = workshop_cells[0]

    # Path to the workshop
    path_to_ws = bfs(state.pos, (w_r, w_c))
    if path_to_ws is None:
        # Workshop unreachable
        return plan

    for (r0, c0), (r1, c1) in zip(path_to_ws, path_to_ws[1:]):
        act = delta_to_action[(r1 - r0, c1 - c0)]
        plan.append(act)
        state.pos = (r1, c1)

    # Craft the arrow at the workshop
    plan.append(USE)

    return plan

