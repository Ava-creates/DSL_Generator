    # Local copy of the grid so we can “consume” items as we pick them up
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)  # (row, col)

    def manhattan_path(src, dst):
        """Return a list of movement actions to go from src to dst (Manhattan distance)."""
        actions = []
        sr, sc = src
        dr, dc = dst
        if dr > sr:
            actions += [DOWN] * (dr - sr)
        elif dr < sr:
            actions += [UP] * (sr - dr)
        if dc > sc:
            actions += [RIGHT] * (dc - sc)
        elif dc < sc:
            actions += [LEFT] * (sc - dc)
        return actions

    def nearest(pos, kind):
        """Find the nearest cell containing the given kind (ignoring empty cells)."""
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        idx = dists.argmin()
        return tuple(cells[idx].tolist())

