            prim_pos = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_pos.size == 0:
                raise RuntimeError("Required primitive not found on the grid")
            # pick the closest one (Manhattan distance)
            cur = state.pos
            dists = np.abs(prim_pos - np.array(cur)).sum(axis=1)
            target = tuple(prim_pos[dists.argmin()])

            # Find a free neighbour and a free cell behind it so we can face the target
            collected = False
            for name, (dx, dy) in dir_vec.items():
                neighbour = (target[0] - dx, target[1] - dy)
                behind = (neighbour[0] - dx, neighbour[1] - dy)
                if (0 <= neighbour[0] < state.grid.shape[0] and
                        0 <= neighbour[1] < state.grid.shape[1] and
                        0 <= behind[0] < state.grid.shape[0] and
                        0 <= behind[1] < state.grid.shape[1] and
                        walkable(neighbour) and walkable(behind)):
                    # Move to the cell behind the neighbour
                    path = bfs(state.pos, {behind})
                    if path is None:
                        continue
                    for a in path:
                        _, state = state.step(a)
                        actions.append(a)
                    # Step into the neighbour (now facing the primitive)
                    move_a = act_map[name]
                    _, state = state.step(move_a)
                    actions.append(move_a)
                    # Collect with USE
                    use_a = act_map["USE"]
                    _, state = state.step(use_a)
                    actions.append(use_a)
                    collected = True
                    break
            if not collected:
                # Fallback: just move adjacent and hope the direction is correct
                for name, (dx, dy) in dir_vec.items():
                    neighbour = (target[0] - dx, target[1] - dy)
                    if (0 <= neighbour[0] < state.grid.shape[0] and
                            0 <= neighbour[1] < state.grid.shape[1] and
                            walkable(neighbour)):
                        path = bfs(state.pos, {neighbour})
                        if path is None:
                            continue
                        for a in path:
                            _, state = state.step(a)
                            actions.append(a)
                        # Ensure we are facing the primitive
                        _, state = state.step(act_map[name])
                        actions.append(act_map[name])
                        _, state = state.step(act_map["USE"])
                        actions.append(act_map["USE"])
                        collected = True
                        break
            if not collected:
                raise RuntimeError("Failed to reach a primitive")

    # ------------------------------------------------------------------
    # 2.  Craft the arrow at its required workshop
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes[arrow_idx]
    workshop_idx = recipe.get("_at", None)

    if workshop_idx is None:
        # No specific workshop – just use the current cell
        actions.append(act_map["USE"])
        _, state = state.step(act_map["USE"])
        return actions

    # Locate the workshop on the grid
    ws_pos = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if ws_pos.size == 0:
        raise RuntimeError("Workshop for arrow not found")
    cur = state.pos
    dists = np.abs(ws_pos - np.array(cur)).sum(axis=1)
    ws_target = tuple(ws_pos[dists.argmin()])

    crafted = False
    for name, (dx, dy) in dir_vec.items():
        neighbour = (ws_target[0] - dx, ws_target[1] - dy)
        behind = (neighbour[0] - dx, neighbour[1] - dy)
        if (0 <= neighbour[0] < state.grid.shape[0] and
                0 <= neighbour[1] < state.grid.shape[1] and
                0 <= behind[0] < state.grid.shape[0] and
                0 <= behind[1] < state.grid.shape[1] and
                walkable(neighbour) and walkable(behind)):
            path = bfs(state.pos, {behind})
            if path is None:
                continue
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # Step into neighbour, now facing the workshop
            move_a = act_map[name]
            _, state = state.step(move_a)
            actions.append(move_a)
            # Craft with USE
            use_a = act_map["USE"]
            _, state = state.step(use_a)
            actions.append(use_a)
            crafted = True
            break

    if not crafted:
        # Simple fallback: move next to the workshop (any free neighbour) and USE
        for name, (dx, dy) in dir_vec.items():
            neighbour = (ws_target[0] - dx, ws_target[1] - dy)
            if (0 <= neighbour[0] < state.grid.shape[0] and
                    0 <= neighbour[1] < state.grid.shape[1] and
                    walkable(neighbour)):
                path = bfs(state.pos, {neighbour})
                if path is None:
                    continue
                for a in path:
                    _, state = state.step(a)
                    actions.append(a)
                # Ensure we face the workshop
                _, state = state.step(act_map[name])
                actions.append(act_map[name])
                _, state = state.step(act_map["USE"])
                actions.append(act_map["USE"])
                crafted = True
                break

    if not crafted:
        # Last resort: just issue a USE at the current location
        actions.append(act_map["USE"])
        _, state = state.step(act_map["USE"])

    return actions


