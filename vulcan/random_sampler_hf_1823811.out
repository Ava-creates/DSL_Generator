    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Action constants (match CraftLab.action_specs order)
    # ------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    # ------------------------------------------------------------------
    # Helper: BFS to any free neighbour of a target cell
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, target, blocked):
        """Return a list of movement actions that brings the agent from *start*
        to any empty cell adjacent to *target*. If no such path exists, return [].
        """
        h, w = blocked.shape
        tx, ty = int(target[0]), int(target[1])

        # all possible free neighbour cells of the target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []

        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ------------------------------------------------------------------
    # Reset / initialise the environment
    # ------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    # Grab the internal CraftState; if unavailable, we cannot plan.
    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ------------------------------------------------------------------
    try:
        arrow_idx = idx["arrow"]
    except Exception:
        return []                     # arrow not defined in this world

    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    recipe_dict = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe_dict.get("_at") or recipe_dict.get("_key")
    if workshop_name is None:
        return []                     # cannot locate required workshop

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # workshop name not indexed

    # ------------------------------------------------------------------
    # Local mutable copies for planning
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                    # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)         # bool matrix: any entity present

    plan_actions = []

    # ------------------------------------------------------------------
    # Helper: move adjacent to *target_coord* (which holds *kind_idx*) and USE.
    # Updates simulated position, grid, occupied, inventory.
    # ------------------------------------------------------------------
    def move_and_use(target_coord, kind_idx):
        nonlocal pos, plan_actions, grid, occupied, inventory

        path = bfs_to_adjacent(pos, target_coord, occupied)
        if not path and pos != target_coord:
            return False

        # Apply movement actions to simulated state
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan_actions.extend(path)

        # Issue USE action
        plan_actions.append(USE)

        tx, ty = int(target_coord[0]), int(target_coord[1])
        if grid[tx, ty, kind_idx] > 0:
            # Pick up one unit of the item
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ------------------------------------------------------------------
    # Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.shape[0] == 0:
                # No more instances of this primitive on the map; abort planning.
                return plan_actions
            # Choose the nearest candidate (Manhattan distance)
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = candidates[dists.argmin()]
            if not move_and_use(target, prim_idx):
                return plan_actions

    # ------------------------------------------------------------------
    # Move to a workshop and craft the arrow
    # ------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # Workshops are static; fall back to the original scenario grid.
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan_actions

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = workshop_cells[dists.argmin()]

    move_and_use(workshop_target, workshop_idx)

    return plan_actions


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (must match CraftLab.action_specs order)
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions leading to any
    # free neighbour of *target* (the target cell itself may be occupied).
    # ----------------------------------------------------------------------
    def bfs_to_adjacent(start, target, blocked):
        """Return a list of actions moving from *start* to a free neighbour of *target*.
        If no such neighbour is reachable, return an empty list."""
        h, w = blocked.shape
        tx, ty = int(target[0]), int(target[1])

        # collect all free neighbour cells around the target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []

        # BFS over free cells
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ----------------------------------------------------------------------
    # Initialise / reset environment and fetch the internal state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        # cannot obtain the underlying CraftState – give up
        return []

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        arrow_idx = idx["arrow"]
    except Exception:
        # arrow not defined in this world
        return []

    # mapping primitive_kind_idx -> count needed to craft one arrow
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # workshop where the arrow must be crafted
    recipe_dict = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe_dict.get("_at") or recipe_dict.get("_key")
    if workshop_name is None:
        return []
    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Local mutable copies for planning (so we can simulate actions)
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix: any entity present

    plan_actions = []

    # ----------------------------------------------------------------------
    # Helper: move adjacent to *target_coord* (which contains *kind_idx*) and
    # issue a USE action. Updates the simulated position, grid, occupied map
    # and inventory. Returns True on success, False otherwise.
    # ----------------------------------------------------------------------
    def move_and_use(target_coord, kind_idx):
        nonlocal pos, plan_actions, grid, occupied, inventory

        path = bfs_to_adjacent(pos, target_coord, occupied)
        if not path and pos != target_coord:
            return False

        # follow the movement actions, updating simulated position
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan_actions.extend(path)

        # perform the USE action
        plan_actions.append(USE)

        tx, ty = int(target_coord[0]), int(target_coord[1])
        if grid[tx, ty, kind_idx] > 0:
            # pick up one unit of the primitive / interact with workshop
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives according to the recipe
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # locate the nearest remaining instance of the primitive
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.shape[0] == 0:
                # no more instances on the map – abort planning
                return plan_actions
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = candidates[dists.argmin()]
            if not move_and_use(target, prim_idx):
                # movement failed (e.g., completely surrounded); abort
                return plan_actions

    # ----------------------------------------------------------------------
    # Move to a workshop cell and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # workshops are static; fall back to the original scenario layout
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan_actions

    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = workshop_cells[dists.argmin()]

    move_and_use(workshop_target, workshop_idx)

    # The plan now contains movements and USE actions that will collect the
    # primitives, reach the workshop and craft the arrow.
    return plan_actions

