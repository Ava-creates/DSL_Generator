    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []
    goal_idx = idx[goal_name]

    # Primitive requirements for the goal
    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    from collections import deque

    def bfs_path(start, target):
        """Return a list of movement actions to reach target (target may be occupied)."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # treat any occupied cell as blocked unless it is the target
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []
        # reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def nearest_cell(start, kind_idx):
        """Find the closest cell containing `kind_idx` using BFS."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # block on occupied cells unless they hold the target kind
                if state.grid[nr, nc, :].sum() != 0 and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # reconstruct path to this cell
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None

    # 1. Collect all required primitives
    for prim_idx, count in primitive_needs.items():
        for _ in range(count):
            path, cell = nearest_cell(state.pos, prim_idx)
            if cell is None:
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[cell[0], cell[1], prim_idx] = 0

    # 2. Move to the workshop and craft the arrow
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions
    workshop_idx = idx[workshop_name]
    path, cell = nearest_cell(state.pos, workshop_idx)
    if cell is None:
        return actions
    actions.extend(path)
    state.pos = cell
    actions.append(USE)

    return actions


