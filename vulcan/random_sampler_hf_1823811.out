    UP = action_map["UP"]
    LEFT = action_map["LEFT"]
    RIGHT = action_map["RIGHT"]
    USE = action_map["USE"]
    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    from collections import deque

    def _bfs_path(start, target):
        """Return list of movement actions from start to target,
        avoiding occupied cells (except the target cell)."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # No path found.
        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # Identify goal and required primitives.
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []
    goal_idx = idx[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    actions = []

    # ------------------------------------------------------------------
    # 1. Collect required primitive items.
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # Locate all cells that currently contain this primitive.
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # Primitive missing – abort early.
                return actions
            # Choose the closest cell (Manhattan distance).
            dists = np.abs(cells - np.array(state.pos)).sum(axis=1)
            tr, tc = cells[dists.argmin()]
            # Move to the cell.
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)
            # Pick it up.
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

