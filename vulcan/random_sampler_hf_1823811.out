    # Reset environment to start fresh
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index (the item we ultimately want to craft)
    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # Helper to compute Manhattan move sequence (actions: 0=DOWN,1=UP,2=LEFT,3=RIGHT)
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper to locate the nearest cell containing a given kind.
    # For primitives we avoid cells already harvested; for workshops we ignore that.
    # ------------------------------------------------------------------
    harvested = {}

    def nearest_cell(kind, from_pos, avoid_harvested=True):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        if avoid_harvested:
            used = harvested.get(kind, set())
            candidates = [tuple(c) for c in cells if tuple(c) not in used]
        else:
            candidates = [tuple(c) for c in cells]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        return candidates[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # 1) Gather all primitive resources needed for the final goal
    # ------------------------------------------------------------------
    required_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    cur_pos = tuple(state.pos)
    actions = []

    for prim_kind, cnt in required_prims.items():
        harvested.setdefault(prim_kind, set())
        for _ in range(cnt):
            target = nearest_cell(prim_kind, cur_pos)
            if target is None:
                # No remaining primitive of this kind on the map – give up
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)                     # USE to pick up
            harvested[prim_kind].add(target)      # mark as consumed

    # ------------------------------------------------------------------
    # 2) Determine crafting order (post‑order DFS over recipe graph)
    # ------------------------------------------------------------------
    recipes = world.cookbook.recipes
    primitives_set = world.cookbook.primitives

    order = []
    visited = set()

    def dfs(item):
        if item in visited:
            return
        visited.add(item)
        rec = recipes.get(item, {})
        for ing, _ in rec.items():
            if ing == "_at":
                continue
            if ing not in primitives_set:
                dfs(ing)
        order.append(item)

    dfs(goal_idx)          # order now contains intermediates then goal

    # ------------------------------------------------------------------
    # 3) Execute crafting steps following the order
    # ------------------------------------------------------------------
    for item in order:
        rec = recipes.get(item, {})
        wk_kind = None
        if "_at" in rec:
            wk = rec["_at"]
            wk_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

        if wk_kind is not None:
            # Move to nearest workshop of the required type
            target = nearest_cell(wk_kind, cur_pos, avoid_harvested=False)
            if target is not None:
                move_seq, cur_pos = moves_to(cur_pos, target)
                actions.extend(move_seq)

        # Perform the craft (or final craft) with a USE action
        actions.append(4)

    return actions


    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # index of the item we need to craft (arrow)
    goal_idx = env.task.goal

    # primitive resources (including transitive) needed for the goal
    required = world.cookbook.primitives_for(goal_idx)

    # determine if the final crafting must happen at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: generate a Manhattan move sequence (DOWN=0, UP=1, LEFT=2, RIGHT=3)
    # ------------------------------------------------------------------
    def moves_to(start: tuple[int, int], target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:
        x, y = start
        tx, ty = target
        seq: list[int] = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell that currently contains at least one
    # instance of `kind`.  We ignore cells that have already been harvested.
    # ------------------------------------------------------------------
    harvested: dict[int, set[tuple[int, int]]] = {}

    def nearest_cell(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        return candidates[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # Collect all required primitive items
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # No more of this primitive on the map – skip
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up the primitive
            harvested[kind].add(target)     # mark cell as consumed

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and perform the final craft
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)

    # Final USE triggers the crafting of the goal item
    actions.append(4)

    return actions

