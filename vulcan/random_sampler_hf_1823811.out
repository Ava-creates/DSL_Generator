    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Define goal
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Get primitive requirements
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Determine workshop if needed
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # Helper functions
    def find_locations(kind):
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1,0),(-1,0),(0,1),(0,-1)):
                nx, ny = cur[0]+dx, cur[1]+dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        return [start]

    def move_action(cur, nxt):
        dx, dy = nxt[0]-cur[0], nxt[1]-cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Non‑adjacent move")

    actions = []
    cur_pos = state.pos

    # Collect primitives
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            locations = find_locations(prim_idx)
            if not locations:
                break
            target = min(locations, key=lambda p: abs(p[0]-cur_pos[0]) + abs(p[1]-cur_pos[1]))
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE to pick up
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # Move to workshop and craft
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = min(wk_locs, key=lambda p: abs(p[0]-cur_pos[0]) + abs(p[1]-cur_pos[1]))
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
        actions.append(4)   # USE to craft
    else:
        actions.append(4)   # USE to craft

    return actions


    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # target item
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitives needed (recursively expanded)
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # workshop required for crafting, if any
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) where `kind` appears on the current grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest path from start to goal avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # cells occupied by non‑grabbable entities are blocked
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # no reachable path
        return [start]

    def move_action(cur, nxt):
        """Convert an adjacent step into a DMLab action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not adjacent")

    # ------------------------------------------------------------------
    # build the plan
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) collect all required primitives
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            locations = find_locations(prim_idx)
            if not locations:
                break  # cannot find more of this primitive
            # choose the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            # move to the target
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            # pick it up
            actions.append(4)   # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2) go to workshop (if needed) and craft the arrow
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
        actions.append(4)   # USE to craft at workshop
    else:
        actions.append(4)   # USE to craft in place

    return actions

