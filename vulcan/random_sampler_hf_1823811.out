    # Helper to move the agent to a target cell using Manhattan moves
    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            y, x = state.pos
            ty, tx = target
            if y < ty:
                act = 0          # DOWN
                new_pos = (y + 1, x)
            elif y > ty:
                act = 1          # UP
                new_pos = (y - 1, x)
            elif x < tx:
                act = 3          # RIGHT
                new_pos = (y, x + 1)
            else:
                act = 2          # LEFT
                new_pos = (y, x - 1)

            actions.append(act)
            _, state = state.step(act)

    # Collect each required primitive the needed number of times
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            # Locate any cell that currently holds the primitive
            positions = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if positions.size == 0:
                raise RuntimeError(f"Primitive {idx.get(prim_idx, prim_idx)} not found on the map.")
            # Choose the first occurrence (could be improved with nearest search)
            prim_pos = tuple(positions[0])

            # Move onto the primitive cell
            move_to(prim_pos)

            # Pick it up (USE action). The environment interprets USE on the cell the
            # agent is standing on as a pickup.
            actions.append(4)       # USE
            _, state = state.step(4)

    # Finally move to the workshop (if any) and craft the arrow
    if workshop_idx is not None:
        ws_positions = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if ws_positions.size == 0:
            raise RuntimeError(f"Workshop {workshop_name} not found on the map.")
        ws_pos = tuple(ws_positions[0])
        move_to(ws_pos)

        # Use the workshop to craft the arrow
        actions.append(4)           # USE
        _, state = state.step(4)

    return actions

