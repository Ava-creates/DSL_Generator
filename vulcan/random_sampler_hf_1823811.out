    from collections import deque

    # (action, (dr, dc))
    move_dirs = [
        (DOWN, (1, 0)),
        (UP, (-1, 0)),
        (LEFT, (0, -1)),
        (RIGHT, (0, 1)),
    ]

    def bfs_path(start, target):
        """Return list of move actions to reach `target` from `start`."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in move_dirs:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # cannot step through occupied cells unless it's the target
                if nxt != target and state.grid[nr, nc, :].any():
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)

        if target not in parent and start != target:
            return []  # unreachable

        # reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def nearest_cell(start, kind_idx):
        """Find the nearest cell containing `kind_idx`. Return (path, cell)."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in move_dirs:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # block occupied cells unless they contain the desired kind
                if state.grid[nr, nc, :].any() and state.grid[nr, nc, kind_idx] == 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if state.grid[nr, nc, kind_idx] > 0:
                    # reconstruct path to this cell
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None

    # 1. Collect required primitives
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            path, cell = nearest_cell(state.pos, prim_idx)
            if cell is None:
                return actions  # primitive not reachable
            actions.extend(path)
            state.pos = cell
            actions.append(USE)  # pick up
            state.inventory[prim_idx] += 1
            state.grid[cell[0], cell[1], prim_idx] = 0

    # 2. Move to workshop and craft the goal item
