    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest path from `start` to `goal` avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Build set of blocked cells (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay where we are
        return [start]

    def move_action(cur, nxt):
        """Convert a step from `cur` to adjacent `nxt` into an action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not to an adjacent cell")

    # ------------------------------------------------------------------
    # Build action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------------
    # 1) Gather required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in primitive_counts.items():
        # Ensure we collect exactly `needed` copies
        while state.inventory[prim_idx] < needed:
            # Locate remaining instances on the grid
            locations = find_locations(prim_idx)
            if not locations:
                # Nothing left on the map – break to avoid infinite loop
                break

            # Choose the nearest location (Manhattan distance) as heuristic
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )

            # Compute path and translate to actions
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)   # USE
            # Update simulated inventory and grid for planning purposes
            state.inventory[prim_idx] += 1
            # Remove the primitive from the grid snapshot so we don't target it again
            state.grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to workshop (if required) and craft
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            # Pick nearest workshop
            target = min(
                wk_locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
        # Craft at the workshop
        actions.append(4)   # USE
    else:
        # No specific workshop – craft where we are
        actions.append(4)   # USE

    return actions


    # Reset environment and fetch useful references
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------------
    # Identify goal and its recipe information
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for a single arrow
    needed_prims = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    # Workshop required for crafting (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper utilities
    def find_locations(kind):
        """Return list of (x, y) where the grid contains `kind`."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    # Pre‑compute blocked cells (non‑grabbable entities)
    blocked_cells = set()
    for ng in world.non_grabbable_indices:
        occ = np.where(state.grid[:, :, ng] > 0)
        blocked_cells.update(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest path from start to goal avoiding blocked cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked_cells:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # If unreachable, stay where we are
        return [start]

    def move_action(cur, nxt):
        """Convert a step from cur → nxt into a direction action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not to an adjacent cell")

    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    inventory = state.inventory.copy()

    # ------------------------------------------------------------------
    # 1) Gather required primitives (skip those already in inventory)
    for prim_idx, total_needed in needed_prims.items():
        already = int(inventory[prim_idx])
        to_collect = total_needed - already
        for _ in range(to_collect):
            prim_locs = find_locations(prim_idx)
            if not prim_locs:
                # Primitive not present on map – cannot proceed
                raise RuntimeError(f"Required primitive {idx.get(prim_idx, prim_idx)} not found")
            # Choose nearest location by BFS distance (fast approximation via Manhattan)
            target = min(
                prim_locs,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE to pick up
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Move to workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if not wk_locs:
            raise RuntimeError("Required workshop for arrow not found on the map")
        target = min(
            wk_locs,
            key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
        )
        path = bfs_path(cur_pos, target)
        for step in path[1:]:
            actions.append(move_action(cur_pos, step))
            cur_pos = step
        actions.append(4)   # USE to craft at the workshop
    else:
        # No specific workshop – craft in place
        actions.append(4)   # USE

    return actions

