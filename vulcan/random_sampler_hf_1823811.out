    # Reset the environment to a fresh state.
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    idx = cookbook.index                # name ↔ id mapping

    # Resolve action indices (fallback to common defaults if missing).
    action_map = env.action_specs()
    DOWN = action_map.get("DOWN", 0)
    UP = action_map.get("UP", 1)
    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    # Define possible moves for BFS.
    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    from collections import deque

    def _bfs_path(start, target):
        """Return a list of movement actions to reach `target` from `start`,
        avoiding occupied cells (except the target cell itself)."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        # If target was never reached, return an empty path.
        if target not in parent and start != target:
            return []
        # Reconstruct the path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []                       # Arrow not defined in this world.
    goal_idx = idx[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                     # Final action sequence.

    # ------------------------------------------------------------------
    # Phase 1: Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate all cells currently containing this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive missing – abort early.
                return actions
            # Choose the nearest cell (Manhattan distance).
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            tr, tc = prim_cells[dists.argmin()]
            # Move to the primitive cell.
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)
            # Pick up the primitive.
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # Phase 2: Go to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                 # No workshop information.
    workshop_idx = idx[workshop_name]

    # Locate workshop cells.
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                 # No workshop present.
    # Choose the nearest workshop cell.
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]
    # Move to the workshop.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)
    # Craft the arrow.
    actions.append(USE)

    return actions


    # Reset environment and obtain references
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    idx = cookbook.index                # name ↔ id mapping

    # Resolve action indices (fallback to defaults if missing)
    action_map = env.action_specs()
    DOWN = action_map.get("DOWN", 0)
    UP = action_map.get("UP", 1)
    LEFT = action_map.get("LEFT", 2)
    RIGHT = action_map.get("RIGHT", 3)
    USE = action_map.get("USE", 4)

    # ------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []                       # arrow not defined in this world
    goal_idx = idx[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                         # final action sequence

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of move actions from start to target.
    # The target cell may be occupied; all other cells must be empty.
    # ------------------------------------------------------------------
    from collections import deque
    moves = [(DOWN, (1, 0)),
             (UP, (-1, 0)),
             (LEFT, (0, -1)),
             (RIGHT, (0, 1))]

    def _bfs_path(start, target):
        """Return list of movement actions (DOWN/UP/LEFT/RIGHT) to reach target."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # allow stepping onto target even if occupied
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)

        if target not in parent and start != target:
            return []  # no path found
        # reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # Phase 1: Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # locate cells containing this primitive
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                return actions  # primitive missing; abort early
            # choose nearest by Manhattan distance
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            tr, tc = prim_cells[dists.argmin()]

            # move to primitive cell
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # pick up
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # Phase 2: Go to workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # no workshop info

    workshop_idx = idx[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # workshop absent

    # choose nearest workshop cell
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]

    # move to workshop
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # craft arrow
    actions.append(USE)

    return actions

