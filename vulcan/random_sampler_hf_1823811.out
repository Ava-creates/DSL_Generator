    import numpy as np
    from collections import deque

    # reset environment and fetch current state/world
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # goal information (arrow)
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # ------------------------------------------------------------------
    # Helper: BFS that treats the destination cell as walkable even if occupied
    # ------------------------------------------------------------------
    def bfs_path(start, goal, occupied):
        w, h = occupied.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path (exclude start, include goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    # Helper: convert delta to action index (0:DOWN,1:UP,2:LEFT,3:RIGHT,4:USE)
    def delta_to_action(dx, dy):
        if dx == 1:
            return 3
        if dx == -1:
            return 2
        if dy == 1:
            return 0
        if dy == -1:
            return 1
        raise ValueError("Invalid movement delta")

    actions = []
    cur_pos = tuple(state.pos)
    grid = state.grid.copy()                     # mutable copy for tracking pickups

    # --------------------------------------------------------------
    # Collect all required primitives
    # --------------------------------------------------------------
    for kind_idx, need in primitive_needs.items():
        for _ in range(need):
            # locate remaining instances of this primitive
            cells = np.argwhere(grid[:, :, kind_idx] > 0)
            if cells.size == 0:
                break
            # order by Manhattan distance from current position
            dists = np.abs(cells[:, 0] - cur_pos[0]) + np.abs(cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(grid, axis=2)
            chosen_path = None
            target = None
            for idx in order:
                cand = tuple(cells[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    chosen_path = path
                    target = cand
                    break
            if chosen_path is None:
                continue
            for step in chosen_path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            actions.append(4)                      # USE to pick up
            grid[target[0], target[1], kind_idx] = 0

    # --------------------------------------------------------------
    # Move to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original grid (workshops are occupied)
            for idx in order:
                cand = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)                  # USE to trigger crafting
                    break

    return actions


    import numpy as np
    from collections import deque

    # Reset the environment and fetch the current state and world information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # Identify the target item ("arrow") and its recipe
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # Helper: BFS to find a walkable path from start to goal (allow stepping onto goal)
    def bfs_path(start, goal, occupied):
        w, h = occupied.shape
        visited = np.full((w, h), False, dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Goal cell may be occupied; treat it as walkable
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path (list of positions, excluding start, including goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    # Helper: translate a step difference into an action index
    def step_to_action(dx, dy):
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid step")

    actions = []
    cur_pos = tuple(state.pos)
    # Work on a mutable copy of the grid to keep track of collected primitives
    grid = state.grid.copy()

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # locate all remaining cells containing this primitive
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # nothing left of this kind – abort early
                break
            # sort locations by Manhattan distance from current position
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            path_found = None
            target_cell = None
            # try each candidate until a reachable one is found
            occupied_mask = np.any(grid, axis=2)
            for idx in order:
                cand = tuple(locations[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    path_found = path
                    target_cell = cand
                    break
            if path_found is None:
                # cannot reach any remaining instance; give up on this primitive
                continue
            # follow the path, emitting movement actions
            for step in path_found:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(step_to_action(dx, dy))
                cur_pos = step
            # pick up the primitive
            actions.append(4)                     # USE
            grid[target_cell[0], target_cell[1], kind_idx] = 0

    # ----------------------------------------------------------------------
    # Go to the workshop (if required) and craft the arrow
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            # choose the nearest reachable workshop cell
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # the original grid (workshop cells are occupied)
            for idx in order:
                cand = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(step_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)                 # USE to trigger crafting
                    break

    return actions

