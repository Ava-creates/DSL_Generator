    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    import numpy as np
    from collections import deque

    def locate(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Compute a shortest 4‑connected path from `start` to `target`,
        avoiding occupied cells (except the target cell itself).
        Returns a list of positions (excluding `start`) or [] if unreachable.
        """
        w, h = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)
        occupied[target] = False          # allow stepping onto target
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for dx, dy in ((0, 1), (0, -1), (-1, 0), (1, 0)):
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                npos = (nx, ny)
                if npos in visited:
                    continue
                if occupied[nx, ny]:
                    continue
                visited.add(npos)
                q.append((npos, path + [npos]))
        return []

    def follow_path(path):
        """Convert a list of positions into actions, update `state`, and record actions."""
        nonlocal state, actions
        for nxt in path:
            x, y = state.pos
            nx, ny = nxt
            if nx > x:
                act = 3          # RIGHT
            elif nx < x:
                act = 2          # LEFT
            elif ny > y:
                act = 0          # DOWN
            else:
                act = 1          # UP
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build action sequence
    # ------------------------------------------------------------------
    actions = []

    # 1) Collect all required primitives
    for kind_idx, req_cnt in needed.items():
        while state.inventory[kind_idx] < req_cnt:
            positions = locate(kind_idx)
            if not positions:                     # primitive not on map
                return actions
            # Find the reachable instance with the shortest path
            best_path = None
            for pos in positions:
                path = bfs_path(state.pos, pos)
                if path and (best_path is None or len(path) < len(best_path)):
                    best_path = path
            if best_path is None:                 # none reachable
                return actions
            follow_path(best_path)
            # Pick up the primitive
            actions.append(4)                     # USE
            _, state = state.step(4)

    # 2) If a specific workshop is needed, move to it
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            # Choose the closest reachable workshop
            best_path = None
            for pos in ws_positions:
                path = bfs_path(state.pos, pos)
                if path and (best_path is None or len(path) < len(best_path)):
                    best_path = path
            if best_path:
                follow_path(best_path)

    # 3) Perform the crafting action (USE)
    actions.append(4)                     # USE
    _, state = state.step(4)

    return actions

