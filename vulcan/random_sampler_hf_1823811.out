    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Return a list of actions that move Manhattan‑wise from src to dst."""
        actions = []
        sr, sc = src
        dr, dc = dst
        dr_diff = dr - sr
        dc_diff = dc - sc
        if dr_diff > 0:
            actions.extend([DOWN] * dr_diff)
        elif dr_diff < 0:
            actions.extend([UP] * (-dr_diff))
        if dc_diff > 0:
            actions.extend([RIGHT] * dc_diff)
        elif dc_diff < 0:
            actions.extend([LEFT] * (-dc_diff))
        return actions

    def _nearest_kind(pos, kind_idx, grid):
        """Find the nearest cell (Manhattan distance) that contains `kind_idx`."""
        coords = np.argwhere(grid[:, :, kind_idx] > 0)
        if coords.size == 0:
            return None
        dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
        nearest = coords[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # 1. Determine the recipe for an arrow
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    # primitives_needed: {primitive_kind_idx: count}
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # ------------------------------------------------------------------
    # 2. Collect required primitives
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)
    grid = env._current_state.grid.copy()

    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target = _nearest_kind(cur_pos, prim_idx, grid)
            if target is None:
                # Primitive missing – abort planning
                return actions
            actions += _move_actions(cur_pos, target)
            cur_pos = target
            actions.append(USE)          # pick up the primitive
            # remove the primitive from our local copy of the grid
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 3. Move to the workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = _nearest_kind(cur_pos, workshop_idx, grid)
        if workshop_pos is not None:
            actions += _move_actions(cur_pos, workshop_pos)
            cur_pos = workshop_pos
            actions.append(USE)          # craft at the workshop

    return actions


    # Action indices
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def _bfs(start, goal, grid):
        """Return a list of positions from start to goal using BFS.
        Cells containing any entity are treated as obstacles, except the goal
        cell itself (which holds the target item). Returns None if unreachable."""
        rows, cols = grid.shape[:2]
        visited = np.full((rows, cols), False, dtype=bool)
        parent = {}
        dq = collections.deque()
        dq.append(start)
        visited[start[0], start[1]] = True

        while dq:
            r, c = dq.popleft()
            if (r, c) == goal:
                # reconstruct path
                path = []
                cur = goal
                while cur != start:
                    path.append(cur)
                    cur = parent[cur]
                path.append(start)
                path.reverse()
                return path
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < rows and 0 <= nc < cols and not visited[nr, nc]:
                    # block if any kind present, unless it's the goal cell
                    if (nr, nc) == goal:
                        blocked = False
                    else:
                        blocked = grid[nr, nc, :].any()
                    if not blocked:
                        visited[nr, nc] = True
                        parent[(nr, nc)] = (r, c)
                        dq.append((nr, nc))
        return None

    def _find_nearest_and_path(pos, kind_idx, grid):
        """Locate the nearest cell containing `kind_idx` and return the cell
        together with a BFS path from `pos` to that cell. Returns (None, None)
        if no reachable cell exists."""
        cells = np.argwhere(grid[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None, None
        # Sort candidates by Manhattan distance for efficiency
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        order = np.argsort(dists)
        for idx in order:
            target = tuple(cells[idx].tolist())
            path = _bfs(pos, target, grid)
            if path is not None:
                return target, path
        return None, None

    def _pos_to_action(src, dst):
        """Translate a step from src to dst into an action index."""
        dr = dst[0] - src[0]
        dc = dst[1] - src[1]
        if dr == 1:
            return DOWN
        if dr == -1:
            return UP
        if dc == -1:
            return LEFT
        if dc == 1:
            return RIGHT
        raise ValueError("Invalid move step")

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    world = env.world
    arrow_idx = world.cookbook.index.index('arrow')
    primitives_needed = world.cookbook.primitives_for(arrow_idx)

    # Work on a copy of the current grid so we can mark collected items as empty
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)

    plan_actions = []

    # 1) Collect all required primitives
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            target, path = _find_nearest_and_path(cur_pos, prim_idx, grid)
            if target is None:
                # Primitive not reachable – abort planning
                return plan_actions
            # Convert path (list of positions) into actions, skipping the start cell
            for step in path[1:]:
                plan_actions.append(_pos_to_action(cur_pos, step))
                cur_pos = step
            # Pick up the primitive
            plan_actions.append(USE)
            # Mark the cell as empty for subsequent navigation
            grid[target[0], target[1], prim_idx] = 0

    # 2) Move to the workshop and craft the arrow
    workshop_name = world.cookbook.recipes.get(arrow_idx, {}).get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        target, path = _find_nearest_and_path(cur_pos, workshop_idx, grid)
        if target is not None:
            for step in path[1:]:
                plan_actions.append(_pos_to_action(cur_pos, step))
                cur_pos = step
            plan_actions.append(USE)   # craft at the workshop

    return plan_actions

