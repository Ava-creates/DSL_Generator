    # Helper: BFS that returns a list of move actions from start to target.
    # The target cell may be occupied (primitive or workshop); all other
    # cells must be empty.
    # ------------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        """Return list of move actions (DOWN/UP/LEFT/RIGHT) from start to target."""
        if start == target:
            return []

        h, w = state.grid.shape[:2]
        queue = deque([start])
        visited = {start}
        parent = {}

        moves = [(DOWN, (1, 0)),
                 (UP,   (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT,(0, 1))]

        while queue:
            cur = queue.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Disallow stepping on occupied cells except the final target.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                queue.append(nxt)

        if target not in parent and start != target:
            return []      # no path found

        # Reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive the needed number of times.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate all cells currently holding this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive missing – abort early.
                return actions

            # Choose the nearest primitive cell (by BFS path length).
            best_path = None
            best_cell = None
            best_len = None
            for cell in prim_cells:
                tr, tc = int(cell[0]), int(cell[1])
                path = _bfs_path(state.pos, (tr, tc))
                if not path:
                    continue
                if best_len is None or len(path) < best_len:
                    best_len = len(path)
                    best_path = path
                    best_cell = (tr, tc)

            if best_path is None:
                # No reachable primitive – abort.
                return actions

            # Move to the chosen primitive cell.
            actions.extend(best_path)
            state.pos = best_cell

            # Pick it up.
            actions.append(USE)

            # Update internal copy of the state.
            state.inventory[prim_idx] += 1
            tr, tc = best_cell
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # workshop info missing

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # no workshop on the map

    # Choose the nearest workshop cell.
    best_path = None
    best_cell = None
    best_len = None
    for cell in workshop_cells:
        wr, wc = int(cell[0]), int(cell[1])
        path = _bfs_path(state.pos, (wr, wc))
        if not path:
            continue
        if best_len is None or len(path) < best_len:
            best_len = len(path)
            best_path = path
            best_cell = (wr, wc)

    if best_path is None:
        return actions                     # cannot reach workshop

    # Move to the workshop.
    actions.extend(best_path)
    state.pos = best_cell

    # Craft the arrow.
    actions.append(USE)

    return actions

