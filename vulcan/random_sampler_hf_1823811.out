    # ----------------------------------------------------------------------
    # Helper utilities
    # ----------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Return a list of positions (excluding start, including goal) that
        leads from start to goal moving only through cells where occupied==False.
        The goal cell may be occupied (resource or workshop)."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path backwards
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Convert a movement delta into the environment's action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ----------------------------------------------------------------------
    # Planning
    # ----------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # current (x, y) of the agent
    grid = state.grid.copy()            # mutable copy to track collected items

    # ------------------------------------------------------------------
    # 1) Collect required primitives
    # ------------------------------------------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # locate remaining instances of this primitive
            candidates = np.argwhere(grid[:, :, kind_idx] > 0)
            if candidates.size == 0:
                break  # none left on the map
            # order by Manhattan distance from current position
            dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked
            target = None
            path = None
            for idx in order:
                cand = tuple(candidates[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    target = cand
                    break
            if target is None:
                continue   # could not reach any remaining instance

            # follow the path
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # pick up the primitive
            actions.append(4)          # USE
            grid[target[0], target[1], kind_idx] = 0   # remove from mutable copy

    # ------------------------------------------------------------------
    # 2) Move to workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # workshops are occupied cells
            for idx in order:
                target = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, target, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # no specific workshop, craft at current location
        actions.append(4)   # USE

    return actions


    # Reset environment and get current state and world information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world
    cookbook = world.cookbook

    # --------------------------------------------------------------
    # Identify the goal ("arrow") and retrieve its recipe information
    # --------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    if goal_idx is None:
        return []                       # unknown goal, nothing to do

    # Primitive ingredients required (may be empty)
    primitive_needs = cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Return a list of positions (excluding start, including goal) that
        leads from start to goal moving only through cells where occupied==False.
        The goal cell may be occupied (e.g., a resource or workshop)."""
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Allow stepping onto the goal even if occupied
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path backwards
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Convert a movement delta into an action index used by the env."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # --------------------------------------------------------------
    # Planning: collect primitives, move to workshop, craft
    # --------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # current (x, y) of the agent
    grid = state.grid.copy()            # mutable copy to track collected items

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------------
    for kind_idx, needed in primitive_needs.items():
        for _ in range(needed):
            # Find all remaining cells containing this primitive
            candidates = np.argwhere(grid[:, :, kind_idx] > 0)
            if candidates.size == 0:
                break  # no more of this primitive on the map
            # Order candidates by Manhattan distance from current position
            dists = np.abs(candidates[:, 0] - cur_pos[0]) + np.abs(candidates[:, 1] - cur_pos[1])
            order = np.argsort(dists)

            occupied_mask = np.any(grid, axis=2)   # treat any entity as blocked
            target = None
            path = None
            for idx in order:
                cand = tuple(candidates[idx])
                path = bfs_path(cur_pos, cand, occupied_mask)
                if path is not None:
                    target = cand
                    break
            if target is None:
                continue   # could not reach any remaining instance

            # Follow the path, emitting movement actions
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # Use action to pick up the primitive
            actions.append(4)          # USE
            # Remove the primitive from our mutable copy
            grid[target[0], target[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # workshops are occupied but reachable
            for idx in order:
                target = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, target, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # No specific workshop required; craft at current location
        actions.append(4)   # USE to trigger crafting

    return actions

