    # Reset environment and get initial references
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld
    idx = world.cookbook.index           # name ↔ integer id

    # Goal item
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for one arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Workshop needed for crafting the arrow
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    actions = []
    cur_pos = state.pos

    # --------------------------------------------------------------
    # Helper utilities
    # --------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) cells that currently contain `kind`."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def move_action(cur, nxt):
        """Convert a step from cur → nxt (adjacent) into an action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Non‑adjacent move requested")

    def bfs(start, goal):
        """Shortest‑path BFS ignoring non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Build set of blocked coordinates (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # No path found – stay where we are
        return [start]

    # --------------------------------------------------------------
    # Collect required primitives
    # --------------------------------------------------------------
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            # Locate a remaining instance of the primitive
            locations = find_locations(prim_idx)
            if not locations:
                # Either already in inventory or unavailable; skip
                continue
            target = locations[0]                       # pick first occurrence

            # Move to the cell containing the primitive
            path = bfs(cur_pos, target)
            for step in path[1:]:                       # skip current position
                act = move_action(cur_pos, step)
                actions.append(act)
                cur_pos = step
                # Execute action to keep `state` up‑to‑date
                env.step(act)
                state = env._current_state

            # Pick up the primitive
            actions.append(4)                           # USE
            env.step(4)
            state = env._current_state

    # --------------------------------------------------------------
    # Move to workshop and craft the arrow
    # --------------------------------------------------------------
    if workshop_kind is not None:
        wk_locs = find_locations(workshop_kind)
        if wk_locs:
            target = wk_locs[0]
            path = bfs(cur_pos, target)
            for step in path[1:]:
                act = move_action(cur_pos, step)
                actions.append(act)
                cur_pos = step
                env.step(act)
                state = env._current_state

            # Craft at the workshop
            actions.append(4)          # USE
            env.step(4)
            state = env._current_state

    return actions


