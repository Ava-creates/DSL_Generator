    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_actions(start, target):
        """
        Compute a list of action indices (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) that moves
        from `start` to `target` while avoiding occupied cells. The target cell
        may be occupied (e.g., a workshop or a primitive) and is treated as free.
        """
        occupied = np.any(state.grid > 0, axis=2)          # True where blocked
        w, h = occupied.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    # Allow stepping onto the target even if occupied
                    if not occupied[nx, ny] or (nx, ny) == target:
                        nxt = (nx, ny)
                        if nxt not in visited:
                            visited.add(nxt)
                            q.append((nxt, path + [act]))
        return []   # unreachable

    def move_to(target):
        """Move agent to `target`, recording actions and updating `state`."""
        nonlocal state
        for act in bfs_actions(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

