    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    goal_idx = env.task.goal
    needed = world.cookbook.primitives_for(goal_idx)

    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    ws_name = recipe.get('_at')
    if ws_name is not None:
        workshop_idx = world.cookbook.index[ws_name]

    import numpy as np
    from collections import deque

    def locate(kind):
        """Return list of (x, y) positions where kind is present."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_actions(start, target):
        """Return list of actions to move from start to target."""
        occupied = np.any(state.grid > 0, axis=2)
        w, h = occupied.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    if (nx, ny) != target and occupied[nx, ny]:
                        continue
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        return []

    def go_to(target):
        """Move agent to target, updating state and recording actions."""
        nonlocal state
        for act in bfs_actions(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    actions = []

    # Collect primitives
    for kind, req_cnt in needed.items():
        while state.inventory[kind] < req_cnt:
            positions = locate(kind)
            if not positions:
                # Primitive not found; abort.
                return actions
            # Choose nearest by Manhattan distance
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            actions.append(4)  # USE to pick up
            _, state = state.step(4)

    # Craft at workshop if required
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
    # Use to craft (or craft without specific workshop)
    actions.append(4)
    _, state = state.step(4)

    return actions

