    # Reset the environment to a fresh state if possible
    try:
        env.reset()
    except Exception:
        pass

    # ------------------------------------------------------------------
    # Identify the goal index (the item we need to craft, e.g., "arrow")
    # ------------------------------------------------------------------
    goal_idx = None
    if hasattr(env, "task"):
        task = getattr(env, "task")
        if hasattr(task, "goal"):
            goal_idx = task.goal
        elif isinstance(task, (list, tuple)):
            goal_idx = task[0]

    # If we cannot determine the goal, return an empty plan
    if goal_idx is None:
        return []

    # ------------------------------------------------------------------
    # Determine which primitive resources are needed for this goal
    # ------------------------------------------------------------------
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}
    if not primitives_needed:
        # No recipe – nothing to collect; just try to craft at current location
        primitives_needed = {}

    # ------------------------------------------------------------------
    # Get a mutable copy of the current grid and the agent's position
    # ------------------------------------------------------------------
    state = env._current_state
    cur_pos = list(state.pos)                 # [x, y]
    grid = state.grid.copy()                  # shape (W, H, n_kinds)

    actions = []                              # List of action integers to return

    # ------------------------------------------------------------------
    # Helper: generate Manhattan moves from cur_pos to target (x, y)
    # ------------------------------------------------------------------
    def move_to(target):
        """Append actions to move from cur_pos to target and update cur_pos."""
        nonlocal cur_pos
        seq = []
        tx, ty = target
        # Move in x direction
        while cur_pos[0] < tx:
            seq.append(3)          # RIGHT
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            seq.append(2)          # LEFT
            cur_pos[0] -= 1
        # Move in y direction
        while cur_pos[1] < ty:
            seq.append(0)          # DOWN
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            seq.append(1)          # UP
            cur_pos[1] -= 1
        return seq

    # ------------------------------------------------------------------
    # Collect each required primitive, one unit at a time
    # ------------------------------------------------------------------
    for kind_idx, total_needed in primitives_needed.items():
        needed = total_needed
        while needed > 0:
            # Locate all cells containing this primitive
            positions = np.argwhere(grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                # No more of this primitive on the map – abort collection
                break

            # Choose the closest primitive (Manhattan distance) to current position
            dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])
            nearest_idx = int(np.argmin(dists))
            target = tuple(positions[nearest_idx])

            # Move to the primitive's cell
            actions.extend(move_to(target))
            # Use (collect) the primitive
            actions.append(4)            # USE
            # Simulate removal of the primitive from the grid copy
            grid[target[0], target[1], kind_idx] = 0
            needed -= 1

    # ------------------------------------------------------------------
    # After gathering primitives, go to the required workshop (if any) and craft
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        # Find any workshop cell of the required type
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
        if ws_positions.shape[0] > 0:
            ws_target = tuple(ws_positions[0])
            actions.extend(move_to(ws_target))
            actions.append(4)            # USE to craft at the workshop
        else:
            # No workshop found; attempt to craft at current location anyway
            actions.append(4)
    else:
        # No specific workshop – attempt to craft at current location
        actions.append(4)

    return actions

