    ]

    actions = []

    def find_path(cur_state, target_kind):
        """BFS returning a list of movement actions that brings the agent
        to a cell containing `target_kind`. The agent may step onto empty
        cells or directly onto the target cell; other occupied cells are
        treated as obstacles."""
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        from collections import deque
        q = deque([(start, [])])
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                occupied = grid[nx, ny, :].sum() > 0
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        return []

