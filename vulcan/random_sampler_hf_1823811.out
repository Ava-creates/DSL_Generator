    # ------------------------------------------------------------------
    # helper utilities
    # ------------------------------------------------------------------
    def find_locations(kind, excluded):
        """Return list of (x, y) where `kind` is present and not excluded."""
        occ = np.where(state.grid[:, :, kind] > 0)
        locs = list(zip(occ[0].tolist(), occ[1].tolist()))
        return [loc for loc in locs if loc not in excluded]

    def move_action(cur, nxt):
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("non‑adjacent move")

    def bfs(start, goal):
        """Shortest Manhattan path avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # cells occupied by non‑grabbable entities are impassable
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # no path found – stay in place
        return [start]

    # ------------------------------------------------------------------
    # build the action sequence
    # ------------------------------------------------------------------
    actions = []
    cur_pos = state.pos
    used_locations = set()   # cells already harvested

    # 1) Gather each required primitive
    for prim_idx, needed in primitive_counts.items():
        for _ in range(needed):
            locations = find_locations(prim_idx, used_locations)
            if not locations:
                raise RuntimeError(f"Primitive {idx.get(prim_idx, prim_idx)} not found on map")
            # nearest primitive (Manhattan)
            target = min(locations,
                         key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)          # USE to pick up
            used_locations.add(target)

    # 2) Move to workshop (if required) and craft
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind, set())
        if not wk_locations:
            raise RuntimeError("Required workshop not found on map")
        target = min(wk_locations,
                     key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
        path = bfs(cur_pos, target)
        for step in path[1:]:
            actions.append(move_action(cur_pos, step))
            cur_pos = step
        actions.append(4)              # USE to craft
    else:
        # no specific workshop – just USE at current location
        actions.append(4)

    return actions

