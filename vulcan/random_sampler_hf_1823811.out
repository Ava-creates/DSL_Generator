        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == goal:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
