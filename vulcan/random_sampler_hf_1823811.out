    import collections
    import numpy as np

    # Reset environment and get initial state/world references
    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Goal item and its primitive requirements
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Action indices as defined by the environment
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    # Direction vectors paired with action indices
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    def bfs_path(cur_state, target_kind):
        """
        Breadth‑first search that returns a list of movement actions leading
        from the agent's current position to any cell containing `target_kind`.
        The search may step onto empty cells or the target cell itself,
        but avoids other occupied cells.
        """
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                occupied = np.any(grid[nx, ny, :] > 0)
                # Allow stepping onto the target cell even if occupied
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # No reachable target found (should not happen in valid scenarios)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, count in required.items():
        for _ in range(count):
            path = bfs_path(state, kind_idx)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive now under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = bfs_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions


    # Reset the environment and obtain the current state and world objects
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld

    # Goal item index and the primitive requirements for one instance of the goal
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Map action names to integer indices used by the environment
    action_map = env.action_specs()
    ACTION_DOWN = action_map['DOWN']
    ACTION_UP = action_map['UP']
    ACTION_LEFT = action_map['LEFT']
    ACTION_RIGHT = action_map['RIGHT']
    ACTION_USE = action_map['USE']

    # Direction vectors paired with their corresponding movement actions
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []  # the list we will return

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions leading from the
    # current agent position to any cell that contains the target kind.
    # The search can walk on empty cells or the target cell itself; it
    # avoids stepping onto other occupied cells (unless that cell is the
    # target).
    # ------------------------------------------------------------------
    import collections
    import numpy as np

    def find_path(cur_state, target_kind):
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # If we get here the target is unreachable; return empty list.
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind_idx, needed in required.items():
        for _ in range(needed):
            # Find a path to the nearest instance of the primitive.
            path = find_path(state, kind_idx)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Use the primitive (pick it up).
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the item.
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

