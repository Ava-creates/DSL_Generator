    # Reset the environment to start a new episode.
    env.reset()

    # Index of the target item “arrow” in the world’s cookbook.
    arrow_idx = env._current_state.world.cookbook.index["arrow"]

    actions = []
    max_steps = 10000  # safety bound to avoid infinite loops.

    for _ in range(max_steps):
        # If the goal is already satisfied, stop collecting actions.
        if env._current_state.satisfies("make", arrow_idx):
            break

        # The simplest possible action: “USE” (index 4).  Repeated USE
        # attempts let the agent pick up adjacent primitives and, when
        # enough ingredients are present, automatically craft the target.
        act = 4
        actions.append(act)

        # Apply the action; the step method returns (reward, done, obs).
        _, done, _ = env.step(act)

        # If the episode ends for any reason, abort early.
        if done:
            break

    return actions


    actions = []
    # reset environment and obtain initial state
    env.reset()
    state = env._current_state          # current CraftState
    world = env.world                    # CraftWorld instance
    goal = env.task.goal                 # index of the target item (arrow)

    # primitives required to craft the goal
    needed = world.cookbook.primitives_for(goal).copy()

    # helper: positions of a given kind on the grid
    def find_positions(kind):
        return list(zip(*np.where(state.grid[:, :, kind] > 0)))

    # helper: check whether a cell is empty (no entities)
    def is_empty(pos):
        x, y = pos
        return state.grid[x, y, :].sum() == 0

    # helper: move the agent to a target cell using Manhattan moves
    # updates the global `state` and records actions
    def move_to(target):
        nonlocal state
        curx, cury = state.pos
        tx, ty = target
        # move in x direction
        while curx != tx:
            if curx < tx:
                act = 3          # RIGHT
                curx += 1
            else:
                act = 2          # LEFT
                curx -= 1
            actions.append(act)
            _, state = state.step(act)
        # move in y direction
        while cury != ty:
            if cury < ty:
                act = 0          # DOWN
                cury += 1
            else:
                act = 1          # UP
                cury -= 1
            actions.append(act)
            _, state = state.step(act)

    # mapping from delta (primitive relative position) to action index
    delta_to_action = {(1, 0): 3, (-1, 0): 2, (0, 1): 0, (0, -1): 1}
    opposite = {0: 1, 1: 0, 2: 3, 3: 2}

    # helper: ensure the agent is facing the target cell and issue USE
    def face_and_use(delta):
        nonlocal state
        needed_dir = delta_to_action[delta]
        # try to adjust direction by stepping one cell opposite then back,
        # if that opposite cell is free; otherwise assume we are already facing correctly
        curx, cury = state.pos
        # compute opposite step
        if needed_dir == 3:   # need to face RIGHT
            opp_step = (curx - 1, cury)
        elif needed_dir == 2: # need to face LEFT
            opp_step = (curx + 1, cury)
        elif needed_dir == 0: # need to face DOWN
            opp_step = (curx, cury - 1)
        else:                 # need to face UP
            opp_step = (curx, cury + 1)

        if (0 <= opp_step[0] < state.grid.shape[0] and
                0 <= opp_step[1] < state.grid.shape[1] and
                is_empty(opp_step)):
            # move opposite, then back to set direction
            act_opp = opposite[needed_dir]
            actions.append(act_opp)
            _, state = state.step(act_opp)
            actions.append(needed_dir)
            _, state = state.step(needed_dir)
        # finally use
        actions.append(4)      # USE
        _, state = state.step(4)

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for kind, cnt in needed.items():
        for _ in range(cnt):
            # locate a primitive of this kind
            positions = find_positions(kind)
            if not positions:
                raise RuntimeError("Required primitive not found on the map")
            px, py = positions[0]

            # find an adjacent empty cell and the direction delta to the primitive
            adj = None
            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nx, ny = px + dx, py + dy
                if (0 <= nx < state.grid.shape[0] and
                        0 <= ny < state.grid.shape[1] and
                        is_empty((nx, ny))):
                    adj = (nx, ny, (dx, dy))
                    break
            if adj is None:
                raise RuntimeError("No free cell adjacent to required primitive")
            nx, ny, delta = adj

            # navigate to that adjacent cell
            move_to((nx, ny))
            # face the primitive and pick it up
            face_and_use(delta)

    # ----------------------------------------------------------------------
    # Craft the goal at its required workshop
    # ----------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is None:
        raise RuntimeError("Workshop type not specified in recipe")

    # locate a workshop of the needed type
    workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))
    if not workshop_cells:
        raise RuntimeError("Required workshop not present on the map")
    wx, wy = workshop_cells[0]

    # find an adjacent free cell to the workshop
    adj = None
    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
        nx, ny = wx + dx, wy + dy
        if (0 <= nx < state.grid.shape[0] and
                0 <= ny < state.grid.shape[1] and
                is_empty((nx, ny))):
            adj = (nx, ny, (dx, dy))
            break
    if adj is None:
        raise RuntimeError("No free cell adjacent to workshop")
    nx, ny, delta = adj

    # move next to the workshop and use to craft
    move_to((nx, ny))
    face_and_use(delta)

    # return the compiled action list
    return actions

