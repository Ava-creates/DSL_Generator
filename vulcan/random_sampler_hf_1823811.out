    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions: list[int] = []

    # ------------------------------------------------------------------
    # Helper: BFS pathfinding on free cells (allows stepping onto target)
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_path(start: tuple[int, int], target: tuple[int, int]) -> list[int]:
        grid = env._current_state.grid
        h, w, _ = grid.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:
                    # target may be occupied (e.g., workshop); allow stepping onto it
                    if not grid[ny, nx, :].any() or (ny, nx) == target:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        raise RuntimeError(f"No path from {start} to {target}")

    # ------------------------------------------------------------------
    # Helper: Move agent to a given cell using the BFS planner
    # ------------------------------------------------------------------
    def move_to(target: tuple[int, int]) -> None:
        nonlocal state
        while state.pos != target:
            path = bfs_path(state.pos, target)
            for a in path:
                actions.append(a)
                env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: Find the nearest cell that contains a given kind index
    # ------------------------------------------------------------------
    def find_nearest(kind_idx: int) -> tuple[int, int] | None:
        grid = env._current_state.grid
        h, w, _ = grid.shape
        py, px = state.pos
        best: tuple[int, int] | None = None
        best_dist = float("inf")
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - py) + abs(j - px)
                    if d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: Return a free cell (including the cell itself) adjacent to a target
    # ------------------------------------------------------------------
    def adjacent_free(cell: tuple[int, int]) -> tuple[int, int] | None:
        y, x = cell
        grid = env._current_state.grid
        h, w, _ = grid.shape
        # Prefer the cell itself if it is free
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
                    return (ny, nx)
        return None

    # ------------------------------------------------------------------
    # Collect all primitive resources required for the arrow
    # ------------------------------------------------------------------
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, count in needed_prims.items():
        for _ in range(count):
            src = find_nearest(kind_idx)
            if src is None:
                raise RuntimeError(f"Primitive {kind_idx} not found on map")
            adj = adjacent_free(src)
            if adj is None:
                raise RuntimeError(f"No free cell adjacent to primitive {kind_idx}")
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # If the recipe requires a workshop, move there and craft the arrow
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos is None:
            raise RuntimeError(f"Workshop '{workshop_name}' not found on map")
        adj = adjacent_free(ws_pos)
        if adj is None:
            raise RuntimeError(f"No free cell adjacent to workshop '{workshop_name}'")
        move_to(adj)
        actions.append(ACT_USE)
        env.step(ACT_USE)
        state = env._current_state

    # Return the full action sequence
    return actions

