    # Reset environment to obtain initial state.
    _ = env.reset()
    act_map = env.action_specs()  # mapping from action name to integer

    # Directions and helper deltas.
    moves = [(1, 0, "DOWN"), (-1, 0, "UP"), (0, 1, "RIGHT"), (0, -1, "LEFT")]
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    # ------------------------------------------------------------------
    # Bread‑first search that returns a list of direction names leading
    # from `start` to any free cell adjacent to `target`.
    from collections import deque

    def bfs_adj(start, target, occ):
        tr, tc = target
        # cells we are allowed to stand on (free neighbours of target)
        adj = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occ.shape[0]
            and 0 <= tc + dc < occ.shape[1]
            and not occ[tr + dr, tc + dc]
        ]
        if not adj:
            return []  # no reachable neighbour

        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in adj:
                # reconstruct path of direction names
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ.shape[0]
                    and 0 <= nc < occ.shape[1]
                    and not occ[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # no path found

    # ------------------------------------------------------------------
    # Extract world / recipe information.
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal  # integer index of the desired item

    # Primitive requirements for the goal.
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    # Workshop location (if any) for the goal.
    workshop_idx = world.cookbook.recipes.get(goal_idx, {}).get("_at")

    # Working copies of the initial grid and occupancy mask.
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell.
    cur_pos = scenario.init_pos  # (row, col)

    actions = []

    # Helper to execute a list of direction names, updating position & actions.
    def follow(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Collect all required primitives.
    for prim_idx, needed in primitives_needed.items():
        for _ in range(needed):
            # Find all remaining cells that still contain this primitive.
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                break  # nothing left (should not happen in a solvable scenario)

            # Choose the closest instance (Manhattan distance).
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to an empty neighbour of the target cell.
            path = bfs_adj(cur_pos, target, occ)
            follow(path)

            # Use action to pick up the primitive.
            actions.append(act_map["USE"])

            # Update grid / occupancy: primitive disappears after pickup.
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the goal item.
    if workshop_idx is not None:
        # Locate workshop cells (they are static in the original scenario grid).
        workshop_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0)))
        if workshop_cells:
            target = workshop_cells[0]  # any workshop cell suffices
            path = bfs_adj(cur_pos, target, occ)
            follow(path)
            # Craft by using the workshop.
            actions.append(act_map["USE"])

    # Return the complete action sequence.
    return actions


    # Reset the environment and obtain the mapping from action names to indices.
    _ = env.reset()
    act_map = env.action_specs()

    # Direction vectors and helper dictionaries.
    moves = [(1, 0, "DOWN"), (-1, 0, "UP"), (0, 1, "RIGHT"), (0, -1, "LEFT")]
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    from collections import deque

    # Bread‑first search that returns a list of direction names leading from
    # `start` to any free neighbour of `target`.  The occupancy mask `occ`
    # is True on blocked cells.
    def bfs_adj(start, target, occ):
        tr, tc = target
        # All free cells adjacent to the target that the agent could stand on.
        adj = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occ.shape[0]
            and 0 <= tc + dc < occ.shape[1]
            and not occ[tr + dr, tc + dc]
        ]
        if not adj:
            return []

        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in adj:
                # Reconstruct the path of direction names.
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ.shape[0]
                    and 0 <= nc < occ.shape[1]
                    and not occ[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []

    # ----------------------------------------------------------------------
    # Extract scenario / world information.
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal  # integer index of the item we need to make.

    # Recipe information.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Working copies of the grid and a binary occupancy mask.
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0  # True where any entity occupies the cell.
    cur_pos = scenario.init_pos  # (row, col)

    actions = []

    # Helper that executes a list of direction names, updating `cur_pos`
    # and appending the corresponding action indices to `actions`.
    def follow(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ----------------------------------------------------------------------
    # 1) Collect every required primitive the needed number of times.
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate all remaining instances of this primitive.
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more instances left – break early.
                break

            # Choose the closest instance (Manhattan distance).
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to a free neighbour of the target cell.
            path = bfs_adj(cur_pos, target, occ)
            follow(path)

            # Pick up the primitive.
            actions.append(act_map["USE"])

            # Update the grid / occupancy mask to reflect the collected item.
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # ----------------------------------------------------------------------
    # 2) Go to the workshop (if the recipe requires one) and craft the goal.
    if workshop_idx is not None:
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))
        if not workshop_cells:
            # The workshop might have been overwritten in `grid`; fall back
            # to the original scenario grid.
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0))
            )
        if workshop_cells:
            target = workshop_cells[0]  # Any workshop cell suffices.
            path = bfs_adj(cur_pos, target, occ)
            follow(path)
            # Craft by using the workshop.
            actions.append(act_map["USE"])

    # Return the complete action sequence.
    return actions

