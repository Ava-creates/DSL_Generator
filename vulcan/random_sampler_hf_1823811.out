    # Reset the environment and get the initial state.
    obs = env.reset()
    state = env._current_state

    # Identify the goal item index (the task stores a tuple (name, index)).
    goal_name, goal_idx = env.task.goal

    # Primitive requirements for the goal (primitive kind index -> count).
    required = env.world.cookbook.primitives_for(goal_idx).copy()

    # Action indices as defined by the environment.
    ACTION_DOWN = 0
    ACTION_UP = 1
    ACTION_LEFT = 2
    ACTION_RIGHT = 3
    ACTION_USE = 4

    # -------------------------------------------------------------------------
    # Helper functions (local to this method)
    # -------------------------------------------------------------------------
    def _vec_to_action(dx, dy):
        """Convert a direction vector to the corresponding action index."""
        if dx == 0 and dy == 1:
            return ACTION_DOWN
        if dx == 0 and dy == -1:
            return ACTION_UP
        if dx == -1 and dy == 0:
            return ACTION_LEFT
        if dx == 1 and dy == 0:
            return ACTION_RIGHT
        raise ValueError("Invalid direction vector")

    def _empty_adjacent(pos, grid):
        """Return an empty neighbouring cell of `pos` (or None)."""
        x, y = pos
        w, h = grid.shape[:2]
        for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:
            nx, ny = x + dx, y + dy
            if 0 <= nx < w and 0 <= ny < h:
                if not grid[nx, ny, :].any():
                    return (nx, ny)
        return None

    def _bfs_path(start, targets, blocked):
        """Bread‑first search returning a list of actions from start to any target."""
        w, h = blocked.shape
        queue = collections.deque()
        queue.append((start, []))
        visited = {start}
        while queue:
            (x, y), path = queue.popleft()
            if (x, y) in targets:
                return path
            for dx, dy, act in [(0, 1, ACTION_DOWN), (0, -1, ACTION_UP),
                                (-1, 0, ACTION_LEFT), (1, 0, ACTION_RIGHT)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    queue.append(((nx, ny), path + [act]))
        return None

    def _orient_towards(agent_pos, agent_dir, target):
        """
        Produce actions that make the agent face `target`.
        If already facing, returns empty list; otherwise tries to turn by stepping
        one cell away and back.
        """
        ax, ay = agent_pos
        tx, ty = target
        dx, dy = tx - ax, ty - ay
        needed = _vec_to_action(dx, dy)
        if agent_dir == needed:
            return []
        # Try to turn by moving one cell opposite to the needed direction and back.
        ox, oy = ax - dx, ay - dy
        w, h = state.grid.shape[:2]
        if 0 <= ox < w and 0 <= oy < h and not state.grid[ox, oy, :].any():
            return [_vec_to_action(-dx, -dy), needed]
        # Fallback: just attempt the needed direction (may be blocked).
        return [needed]

    actions = []

    # -------------------------------------------------------------------------
    # Main planning loop: collect missing primitives, then craft at a workshop.
    # -------------------------------------------------------------------------
    while True:
        # Goal achieved?
        if state.inventory[goal_idx] > 0:
            break

        # Determine which primitives are still missing.
        missing = {k: v - state.inventory[k] for k, v in required.items()
                   if state.inventory[k] < v}

        if missing:
            # Choose a missing primitive (arbitrary selection).
            prim_idx = next(iter(missing))

            # Locate an instance of this primitive on the grid.
            prim_positions = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
            if not prim_positions:
                # No more instances left; give up on this primitive.
                required.pop(prim_idx, None)
                continue

            # Pick the closest instance.
            px, py = min(prim_positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))

            # Find an empty cell adjacent to the primitive.
            adj = _empty_adjacent((px, py), state.grid)
            if adj is None:
                # Cannot approach this instance; try another primitive later.
                required.pop(prim_idx, None)
                continue

            # Cells that are occupied (any non‑zero kind).
            blocked = state.grid.any(axis=2)

            # Compute a path to the adjacent cell.
            path = _bfs_path(state.pos, {adj}, blocked)
            if path is None:
                # Unreachable; discard this primitive.
                required.pop(prim_idx, None)
                continue

            # Execute movement actions.
            for a in path:
                _, _ = env.step(a)
                actions.append(a)
                state = env._current_state

            # Face the primitive and collect it.
            orient = _orient_towards(state.pos, state.dir, (px, py))
            for a in orient:
                _, _ = env.step(a)
                actions.append(a)
                state = env._current_state

            _, _ = env.step(ACTION_USE)
            actions.append(ACTION_USE)
            state = env._current_state
            continue

        # All required primitives are in inventory – go to a workshop to craft.
        workshop_idx = None
        for w_idx in env.world.workshop_indices:
            if state.grid[:, :, w_idx].any():
                workshop_idx = w_idx
                break
        if workshop_idx is None:
            # No workshop present; cannot craft.
            break

        workshop_pos = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))[0]
        adj = _empty_adjacent(workshop_pos, state.grid)
        if adj is None:
            break

        blocked = state.grid.any(axis=2)
        path = _bfs_path(state.pos, {adj}, blocked)
        if path is None:
            break

        for a in path:
            _, _ = env.step(a)
            actions.append(a)
            state = env._current_state

        orient = _orient_towards(state.pos, state.dir, workshop_pos)
        for a in orient:
            _, _ = env.step(a)
            actions.append(a)
            state = env._current_state

        # Craft the goal item.
        _, _ = env.step(ACTION_USE)
        actions.append(ACTION_USE)
        state = env._current_state

    return actions


    # Constants for actions as defined in the environment
    ACTION_DOWN = 0
    ACTION_UP = 1
    ACTION_LEFT = 2
    ACTION_RIGHT = 3
    ACTION_USE = 4

    actions = []

    # Reset the environment to start a fresh episode
    env.reset()
    state = env._current_state
    world = env.world

    # Goal item index (the arrow)
    goal_idx = env.task.goal

    # Determine primitive requirements for the goal
    needed_primitives = world.cookbook.primitives_for(goal_idx)

    # Helper to move towards a target coordinate using Manhattan steps
    def move_towards(pos, target):
        px, py = pos
        tx, ty = target
        if px < tx:
            return ACTION_RIGHT
        if px > tx:
            return ACTION_LEFT
        if py < ty:
            return ACTION_DOWN
        if py > ty:
            return ACTION_UP
        return None

    # Collect each required primitive
    for prim_idx, required_cnt in needed_primitives.items():
        while state.inventory[prim_idx] < required_cnt:
            # Find any remaining instance of this primitive on the grid
            locs = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if locs.size == 0:
                # No more primitives of this type; break to avoid infinite loop
                break
            target_pos = tuple(locs[0][:2].tolist())

            # Navigate to the primitive location
            while state.pos != target_pos:
                act = move_towards(state.pos, target_pos)
                if act is None:
                    break
                reward, done, _ = env.step(act)
                actions.append(act)
                state = env._current_state
                if done:
                    return actions

            # Pick up the primitive
            reward, done, _ = env.step(ACTION_USE)
            actions.append(ACTION_USE)
            state = env._current_state
            if done:
                return actions

    # After gathering primitives, go to the appropriate workshop and craft
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        # Locate a workshop of the required type
        workshop_locs = np.argwhere(state.grid[:, :, workshop_kind] > 0)
        if workshop_locs.size > 0:
            workshop_pos = tuple(workshop_locs[0][:2].tolist())

            # Navigate to the workshop
            while state.pos != workshop_pos:
                act = move_towards(state.pos, workshop_pos)
                if act is None:
                    break
                reward, done, _ = env.step(act)
                actions.append(act)
                state = env._current_state
                if done:
                    return actions

            # Craft the final item
            reward, done, _ = env.step(ACTION_USE)
            actions.append(ACTION_USE)

    return actions

