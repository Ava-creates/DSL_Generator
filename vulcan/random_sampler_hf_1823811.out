    import numpy as np

    # Reset environment and obtain initial state
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal item index
    goal_idx = env.task.goal

    # Determine required primitive resources for the goal
    needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # Identify workshop (if any) required for crafting the goal
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []   # final list of action indices to return

    # ----------------------------------------------------------------------
    # Helper functions
    # ----------------------------------------------------------------------
    def locate(kind):
        """Return list of grid positions containing the given kind."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def nearest(positions):
        """Return the position nearest to the agent (Manhattan distance)."""
        cur = state.pos
        best = None
        best_dist = None
        for p in positions:
            d = abs(p[0] - cur[0]) + abs(p[1] - cur[1])
            if best_dist is None or d < best_dist:
                best_dist = d
                best = p
        return best

    def go_to(target):
        """Move the agent from its current location to `target` using Manhattan steps."""
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:          # need to move right
                act = 3          # RIGHT
                new_pos = (x + 1, y)
            elif x > tx:        # need to move left
                act = 2          # LEFT
                new_pos = (x - 1, y)
            elif y < ty:        # need to move down
                act = 0          # DOWN
                new_pos = (x, y + 1)
            else:               # need to move up
                act = 1          # UP
                new_pos = (x, y - 1)

            actions.append(act)
            _, state = state.step(act)   # update state after move

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives in the needed quantities.
    # ----------------------------------------------------------------------
    for kind_idx, count in needed.items():
        for _ in range(count):
            positions = locate(kind_idx)
            if not positions:
                # Primitive missing – abort early.
                return actions
            target = nearest(positions)
            go_to(target)
            # Pick up the primitive.
            actions.append(4)          # USE action
            _, state = state.step(4)

    # ----------------------------------------------------------------------
    # 2. Move to the workshop (if required) and craft the goal item.
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = nearest(ws_positions)
            go_to(target_ws)

    # Use the crafting action at the current location (whether workshop or not).
    actions.append(4)          # USE to trigger crafting
    _, state = state.step(4)

    return actions


    import numpy as np
    from collections import deque

    # Reset environment and fetch initial state.
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # Goal item index.
    goal_idx = env.task.goal

    # Required primitive resources.
    needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Workshop (if any) where the goal must be crafted.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # Helper: locate all positions of a given kind on the current grid.
    def locate(kind):
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    # Helper: BFS pathfinder avoiding non‑grabbable obstacles.
    non_grabbable = world.non_grabbable_indices

    def bfs(start, targets):
        """Return list of positions from start (excluded) to a target, or [] if unreachable."""
        target_set = set(targets)
        if start in target_set:
            return []
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            x, y = pos
            for dx, dy, _ in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]):
                    continue
                npos = (nx, ny)
                if npos in visited:
                    continue
                # Determine if cell is passable.
                blocked = False
                cell = state.grid[nx, ny, :]
                for idx in non_grabbable:
                    if cell[idx] > 0 and npos not in target_set:
                        blocked = True
                        break
                if blocked:
                    continue
                if npos in target_set:
                    return path + [npos]
                visited.add(npos)
                q.append((npos, path + [npos]))
        return []  # unreachable

    # Helper: move along a list of positions using action indices.
    def follow_path(path):
        """Append actions for each step in path and update state."""
        nonlocal state, actions
        for nxt in path:
            x, y = state.pos
            nx, ny = nxt
            if nx > x:
                act = 3   # RIGHT
            elif nx < x:
                act = 2   # LEFT
            elif ny > y:
                act = 0   # DOWN
            else:
                act = 1   # UP
            actions.append(act)
            _, state = state.step(act)

    actions = []   # final action list to return

    # ----------------------------------------------------------------------
    # 1. Collect required primitives.
    # ----------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind_idx)
            if not positions:
                # Primitive not present; abort early.
                return actions
            # Find nearest reachable primitive via BFS.
            path = bfs(state.pos, positions)
            if not path:  # cannot reach any instance
                return actions
            follow_path(path)
            # Pick up the primitive.
            actions.append(4)   # USE
            _, state = state.step(4)

    # ----------------------------------------------------------------------
    # 2. Move to workshop (if needed) and craft the goal.
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            path = bfs(state.pos, ws_positions)
            if path:
                follow_path(path)
    # Use action to trigger crafting at current location.
    actions.append(4)   # USE
    _, state = state.step(4)

    return actions

