    from collections import deque
    import numpy as np

    def bfs_path(start, target):
        """Shortest movement action list from start to target, avoiding occupied cells."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Block any non‑empty cell unless it is the target.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # No path found.
        # Reconstruct actions.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def nearest_of(kind_idx, start):
        """Find nearest cell containing `kind_idx`. Returns (action_path, cell) or ([], None)."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                has_target = state.grid[nr, nc, kind_idx] > 0
                occupied = state.grid[nr, nc, :].sum() != 0
                if occupied and not has_target:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                if has_target:
                    # Reconstruct path to this cell.
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                q.append(nxt)
        return [], None

    goal_name = "arrow"
    if goal_name not in index.contents:
        return []
    goal_idx = index[goal_name]

    # Primitive requirements for one arrow.
    needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    # 1. Collect all required primitives.
    for prim_idx, cnt in needed.items():
        for _ in range(cnt):
            path, cell = nearest_of(prim_idx, state.pos)
            if cell is None:
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)
            state.inventory[prim_idx] += 1
            tr, tc = cell
            state.grid[tr, tc, prim_idx] = 0

    # 2. Move to the workshop and craft the arrow.
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions
    workshop_idx = index[workshop_name]
    path, cell = nearest_of(workshop_idx, state.pos)
    if cell is None:
        return actions
    actions.extend(path)
    state.pos = cell
    actions.append(USE)

    return actions

