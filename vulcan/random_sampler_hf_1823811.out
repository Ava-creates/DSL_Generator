    import numpy as np

    # Action identifiers (as defined in the environment)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    MOVE_DELTA = {
        DOWN:  (0, 1),
        UP:    (0, -1),
        LEFT:  (-1, 0),
        RIGHT: (1, 0),
    }

    def _adjacent(p1, p2):
        """Return True if p1 and p2 are orthogonally adjacent."""
        return (abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])) == 1

    def _move_towards(src, dst):
        """Generate a list of movement actions that brings src next to dst.
        The last movement direction will be towards dst, so a subsequent USE
        will act on the cell containing dst."""
        actions = []
        cur = list(src)
        while not _adjacent(tuple(cur), dst):
            dx = dst[0] - cur[0]
            dy = dst[1] - cur[1]
            if dx != 0:
                act = RIGHT if dx > 0 else LEFT
            else:
                act = DOWN if dy > 0 else UP
            actions.append(act)
            delta = MOVE_DELTA[act]
            cur[0] += delta[0]
            cur[1] += delta[1]
        return actions

    # ------------------------------------------------------------------
    # 1. Resolve goal index for the arrow
    # ------------------------------------------------------------------
    try:
        goal_idx = env.world.cookbook.index["arrow"]
    except Exception:
        return []  # cannot locate the goal

    # ------------------------------------------------------------------
    # 2. Shortcut: already have the goal in inventory?
    # ------------------------------------------------------------------
    state = getattr(env, "_current_state", None)
    if state is None:
        # Try to obtain a fresh state via reset (if available)
        try:
            obs = env.reset()
            state = env._current_state
        except Exception:
            return []  # no access to state
    if state.inventory[goal_idx] > 0:
        return []  # nothing to do

    # ------------------------------------------------------------------
    # 3. Determine all primitive requirements (recursive expansion)
    # ------------------------------------------------------------------
    cookbook = env.world.cookbook
    primitive_set = cookbook.primitives
    recipe_cache = {}

    def _expand(goal):
        """Return a dict {primitive_idx: count} needed for goal."""
        if goal in primitive_set:
            return {goal: 1}
        if goal in recipe_cache:
            return recipe_cache[goal].copy()
        rec = cookbook.recipes.get(goal, {})
        needed = {}
        for ing, cnt in rec.items():
            if ing == "_at":
                continue
            sub = _expand(ing)
            for k, v in sub.items():
                needed[k] = needed.get(k, 0) + v * cnt
        recipe_cache[goal] = needed.copy()
        return needed

    needed_prims = _expand(goal_idx)

    # ------------------------------------------------------------------
    # 4. Build a plan: collect primitives then craft at workshop
    # ------------------------------------------------------------------
    actions_plan = []
    cur_pos = tuple(state.pos)

    # Helper to locate the first occurrence of a kind on the grid
    def _find_one(kind):
        coords = np.argwhere(state.grid[:, :, kind] > 0)
        if coords.shape[0] == 0:
            return None
        # pick the closest to current position (Manhattan)
        dists = np.abs(coords[:, 0] - cur_pos[0]) + np.abs(coords[:, 1] - cur_pos[1])
        best = coords[dists.argmin()]
        return (int(best[0]), int(best[1]))

    # Collect each required primitive (respecting required count)
    for prim_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            target = _find_one(prim_idx)
            if target is None:
                # primitive not present on the map – abort planning
                return []
            # move adjacent to the primitive and use
            actions_plan.extend(_move_towards(cur_pos, target))
            actions_plan.append(USE)  # pick up
            # update simulated position (after last move)
            # The last movement direction points toward the primitive,
            # so after the move we are adjacent; we stay in that cell.
            # Re‑compute position after the sequence:
            for act in actions_plan[-(len(_move_towards(cur_pos, target))):]:
                delta = MOVE_DELTA[act]
                cur_pos = (cur_pos[0] + delta[0], cur_pos[1] + delta[1])
            # After USE we remain in the same cell
            # Remove the collected primitive from the grid copy so that
            # subsequent searches do not pick the same instance.
            state.grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 5. Move to the workshop for the final crafting step
    # ------------------------------------------------------------------
    final_recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = final_recipe.get("_at")
    if workshop_idx is None:
        # No specific workshop – assume crafting can happen anywhere.
        return actions_plan

    # locate a workshop cell
    workshop_pos = _find_one(workshop_idx)
    if workshop_pos is None:
        return actions_plan  # cannot find workshop, return what we have

    actions_plan.extend(_move_towards(cur_pos, workshop_pos))
    actions_plan.append(USE)  # craft the arrow

    return actions_plan


    # ----------------------------------------------------------------------
    # Helper utilities (local to this function)
    # ----------------------------------------------------------------------
    # Action indices as defined by the environment
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    # movement vectors corresponding to the action indices
    _DIRS = {
        DOWN: (1, 0),
        UP: (-1, 0),
        LEFT: (0, -1),
        RIGHT: (0, 1),
    }

    def _in_bounds(p, shape):
        """Check if a position lies within the grid."""
        x, y = p
        return 0 <= x < shape[0] and 0 <= y < shape[1]

    def _cell_empty(pos, grid):
        """Return True if the cell at `pos` contains no entities."""
        return grid[pos[0], pos[1], :].sum() == 0

    def _adjacent_empty(target, grid):
        """Find an empty neighbour of `target`. Returns None if none exist."""
        w, h = grid.shape[:2]
        for dx, dy in [( -1, 0), (1, 0), (0, -1), (0, 1)]:
            nb = (target[0] + dx, target[1] + dy)
            if 0 <= nb[0] < w and 0 <= nb[1] < h and _cell_empty(nb, grid):
                return nb
        return None

    def _manhattan_path(start, goal):
        """Yield a list of actions that moves from `start` to `goal`
        using a simple Manhattan walk (ignoring obstacles)."""
        actions = []
        x, y = start
        gx, gy = goal
        # vertical moves
        while x < gx:
            actions.append(DOWN); x += 1
        while x > gx:
            actions.append(UP);   x -= 1
        # horizontal moves
        while y < gy:
            actions.append(RIGHT); y += 1
        while y > gy:
            actions.append(LEFT);  y -= 1
        return actions

    def _ensure_facing(pos, neighbor, target, actions):
        """
        After arriving at `neighbor`, make sure the agent is facing `target`.
        If the last movement already points to the target, nothing is added.
        Otherwise a small bounce (step away then back) is performed to set
        the direction correctly.
        Returns the (possibly updated) position after the bounce.
        """
        # Desired direction from neighbor towards target
        dx = target[0] - neighbor[0]
        dy = target[1] - neighbor[1]
        if dx == 1:
            desired = DOWN
        elif dx == -1:
            desired = UP
        elif dy == 1:
            desired = RIGHT
        elif dy == -1:
            desired = LEFT
        else:
            # target is not orthogonal – should not happen
            return neighbor

        # What direction did we just move in?
        last_dir = actions[-1] if actions else None
        if last_dir == desired:
            return neighbor

        # Try to step one cell opposite to `desired` (if possible) and back.
        opp = {DOWN: UP, UP: DOWN, LEFT: RIGHT, RIGHT: LEFT}[desired]
        ox, oy = _DIRS[opp]
        w, h = grid.shape[:2]
        away = (neighbor[0] + ox, neighbor[1] + oy)
        if 0 <= away[0] < w and 0 <= away[1] < h and _cell_empty(away, grid):
            actions.append(opp)          # step away
            actions.append(desired)      # step back (now facing target)
            return neighbor  # position unchanged after bounce
        else:
            # If we cannot bounce, simply add the desired direction; the
            # agent will move onto the target cell (which is blocked) but
            # the environment will ignore the move – we still get the
            # correct facing for the upcoming USE.
            actions.append(desired)
            return neighbor

    # ----------------------------------------------------------------------
    # Begin planning
    # ----------------------------------------------------------------------
    # Retrieve the index of the goal item ("arrow")
    try:
        goal_idx = env.world.cookbook.index["arrow"]
    except Exception:
        return []   # cannot locate the goal in this environment

    # Access the current state (assumes the environment has already been reset)
    cur_state = getattr(env, "_current_state", None)
    if cur_state is None:
        return []

    # Quick exit if we already have the goal
    if cur_state.inventory[goal_idx] > 0:
        return []

    # Local copies that we will update while planning
    pos = tuple(cur_state.pos)
    grid = cur_state.grid.copy()
    inventory = cur_state.inventory.copy()
    actions = []

    # Obtain the recipe for the arrow (may be empty if primitive)
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    if not recipe:
        # Arrow is a primitive – nothing to craft, just need to collect it
        # (handled below as a generic collection step)
        needed = {goal_idx: 1}
        workshop_kind = None
    else:
        workshop_kind = recipe.get("_at", None)
        needed = {k: v for k, v in recipe.items() if k != "_at"}

    # ------------------------------------------------------------------
    # 1) Collect all required ingredients (primitives or intermediate items)
    # ------------------------------------------------------------------
    for kind, count in needed.items():
        # How many more of this kind we still need?
        missing = count - inventory[kind]
        while missing > 0:
            # Locate the nearest instance of this kind on the grid
            locations = np.argwhere(grid[:, :, kind] > 0)
            if locations.size == 0:
                # No more items of this kind – abort planning
                return actions
            dists = np.abs(locations - np.array(pos)).sum(axis=1)
            target = tuple(locations[dists.argmin()])

            # Find an empty neighbour from which we can interact
            neighbor = _adjacent_empty(target, grid)
            if neighbor is None:
                # Cannot reach this item – abort
                return actions

            # Move to that neighbour
            move_seq = _manhattan_path(pos, neighbor)
            actions.extend(move_seq)
            pos = neighbor

            # Ensure we are facing the target cell
            _ensure_facing(pos, neighbor, target, actions)

            # Perform USE to pick up the item
            actions.append(USE)

            # Simulate the effect on inventory and grid
            inventory[kind] += 1
            grid[target[0], target[1], kind] = 0
            missing -= 1

    # ------------------------------------------------------------------
    # 2) Craft the final item at its workshop (if a workshop is required)
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        # Locate the nearest workshop of the required type
        locations = np.argwhere(grid[:, :, workshop_kind] > 0)
        if locations.size == 0:
            return actions
        dists = np.abs(locations - np.array(pos)).sum(axis=1)
        target = tuple(locations[dists.argmin()])

        neighbor = _adjacent_empty(target, grid)
        if neighbor is None:
            return actions

        move_seq = _manhattan_path(pos, neighbor)
        actions.extend(move_seq)
        pos = neighbor

        _ensure_facing(pos, neighbor, target, actions)

        # Use the workshop to craft the item
        actions.append(USE)

        # Simulate crafting: consume ingredients and produce the goal
        for k, v in needed.items():
            inventory[k] = max(0, inventory[k] - v)
        inventory[goal_idx] += 1

    # Return the complete action list
    return actions

