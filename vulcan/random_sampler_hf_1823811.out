    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def bfs_path(start, target, grid, allow_target_kind=None):
        """Return a list of positions from start to target using BFS.
        `grid` is the current occupancy grid (numpy array). Cells that
        contain any non‑grabbable entity are treated as blocked,
        except the target cell if it holds `allow_target_kind`."""
        W, H = grid.shape[:2]
        q = collections.deque([start])
        visited = {start: None}
        while q:
            x, y = q.popleft()
            if (x, y) == target:
                # reconstruct path
                path = []
                cur = target
                while cur != start:
                    path.append(cur)
                    cur = visited[cur]
                path.append(start)
                return list(reversed(path))
            for dx, dy, _ in DIRS:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < W and 0 <= ny < H):
                    continue
                if (nx, ny) in visited:
                    continue
