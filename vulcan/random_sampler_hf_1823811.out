    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind that hasn't
    # been harvested yet.
    # ------------------------------------------------------------------
    harvested = {}

    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
