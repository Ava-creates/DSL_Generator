    from collections import deque
    import numpy as np

    def bfs_path(start, target):
        """Return a list of movement actions from start to target."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        moves = [(DOWN, (1, 0)),
                 (UP, (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT, (0, 1))]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Allow stepping onto the target even if occupied (e.g., workshop)
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # no path found
        # reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # 1. Collect required primitives (respect multiplicities)
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return actions  # primitive not available
            dists = np.abs(cells[:, 0] - state.pos[0]) + np.abs(cells[:, 1] - state.pos[1])
            target = tuple(cells[dists.argmin()])

            move_seq = bfs_path(state.pos, target)
            actions.extend(move_seq)
            state.pos = target

            actions.append(USE)  # pick up primitive
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2. Go to the appropriate workshop and craft the arrow
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # no workshop defined
    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # workshop not present
    dists = np.abs(workshop_cells[:, 0] - state.pos[0]) + np.abs(workshop_cells[:, 1] - state.pos[1])
    workshop_pos = tuple(workshop_cells[dists.argmin()])

    move_seq = bfs_path(state.pos, workshop_pos)
    actions.extend(move_seq)
    state.pos = workshop_pos

    actions.append(USE)  # craft the arrow

    return actions

