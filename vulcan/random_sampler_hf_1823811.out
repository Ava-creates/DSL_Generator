    while any(cnt > 0 for cnt in needed.values()):
        # Find the nearest primitive that we still need.
        best_kind = None
        best_pos = None
        best_dist = None
        for kind, cnt in needed.items():
            if cnt <= 0:
                continue
            # Locate all cells containing this kind.
            positions = np.argwhere(state.grid[:, :, kind] > 0)
            for (x, y) in positions:
                dist = abs(x - state.pos[0]) + abs(y - state.pos[1])
                if (best_dist is None) or (dist < best_dist):
