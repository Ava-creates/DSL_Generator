    # Reset environment to obtain fresh state and world information
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index and its primitive requirements
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Determine workshop (if any) where final crafting must happen
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # Shortcut references
    grid = scenario.init_grid                     # static initial layout
    non_grabbable = world.non_grabbable_indices   # set of indices that block movement
    width, height, _ = grid.shape

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def is_blocked(pos):
        """Return True if the cell at `pos` contains any non‑grabbable entity."""
        x, y = pos
        # any non‑grabbable kind present in this cell?
        for kind in non_grabbable:
            if grid[x, y, kind] > 0:
                return True
        return False

    def neighbors(pos):
        """Yield traversable neighbour positions (4‑connected)."""
        x, y = pos
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nx, ny = x + dx, y + dy
            if 0 <= nx < width and 0 <= ny < height and not is_blocked((nx, ny)):
                yield (nx, ny)

    def bfs_path(start, goal):
        """Breadth‑first search returning a list of positions from start to goal (inclusive)."""
        if start == goal:
            return [start]
        queue = collections.deque([start])
        came_from = {start: None}
        while queue:
            cur = queue.popleft()
            for nxt in neighbors(cur):
                if nxt not in came_from:
                    came_from[nxt] = cur
                    if nxt == goal:
                        # reconstruct path
                        path = [goal]
                        while path[-1] != start:
                            path.append(came_from[path[-1]])
                        path.reverse()
                        return path
                    queue.append(nxt)
        # No path found – return empty list
        return []

    def positions_to_actions(path):
        """Convert a list of positions (adjacent steps) to action indices."""
        act_seq = []
        for (x1, y1), (x2, y2) in zip(path, path[1:]):
            dx, dy = x2 - x1, y2 - y1
            if dx == 1 and dy == 0:
                act_seq.append(3)   # RIGHT
            elif dx == -1 and dy == 0:
                act_seq.append(2)   # LEFT
            elif dx == 0 and dy == 1:
                act_seq.append(0)   # DOWN
            elif dx == 0 and dy == -1:
                act_seq.append(1)   # UP
        return act_seq

    def nearest_entity(kind, from_pos):
        """Find the closest cell (by BFS distance) that contains at least one `kind`."""
        # Gather all candidate cells
        candidates = np.argwhere(grid[:, :, kind] > 0)
        if candidates.size == 0:
            return None
        # BFS from `from_pos` until we hit any candidate
        visited = set()
        queue = collections.deque([(from_pos, 0)])
        visited.add(from_pos)
        while queue:
            cur, _ = queue.popleft()
            # Check if current cell is a candidate
            if any((cur[0] == cx and cur[1] == cy) for cx, cy in candidates):
                return cur
            for nxt in neighbors(cur):
                if nxt not in visited:
                    visited.add(nxt)
                    queue.append((nxt, 0))
        return None

    # ------------------------------------------------------------------
    # Main plan construction
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)

    # Collect each required primitive the necessary number of times
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_entity(kind, cur_pos)
            if target is None:
                # Primitive not present – skip (cannot be collected)
                continue
            path = bfs_path(cur_pos, target)
            if not path:
                continue  # unreachable; skip
            actions.extend(positions_to_actions(path))
            cur_pos = target
            actions.append(4)   # USE to pick up the primitive

    # Move to workshop (if required) and craft the final item
    if workshop_kind is not None:
        target = nearest_entity(workshop_kind, cur_pos)
        if target is not None:
            path = bfs_path(cur_pos, target)
            if path:
                actions.extend(positions_to_actions(path))
                cur_pos = target
                actions.append(4)   # USE to craft at the workshop

    return actions


    # Reset the environment to a fresh start
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Index of the goal item (arrow)
    goal_idx = env.task.goal

    # Primitive ingredients needed for one arrow (recursively expanded)
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the final crafting must happen at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions = []
    cur_pos = tuple(state.pos)   # (x, y)

    # ------------------------------------------------------------------
    # Helper: generate Manhattan moves from start to target.
    # Action indices: DOWN=0, UP=1, LEFT=2, RIGHT=3
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate the nearest cell that currently contains at least one
    # entity of the given kind in the original grid.
    # ------------------------------------------------------------------
    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # ------------------------------------------------------------------
    # Collect each required primitive (might need multiple copies)
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # Primitive not present on the map – cannot collect it.
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE to pick up the primitive

    # ------------------------------------------------------------------
    # If a workshop is required for the final craft, move there and use.
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE to craft at the workshop

    return actions

