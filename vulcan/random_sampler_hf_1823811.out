    def bfs_path(start, goal):
        """Return a list of positions from start to goal using BFS."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt in came_from:
                        continue
                    # allow stepping onto the goal even if occupied
                    if nxt != goal and not is_walkable(nxt):
                        continue
                    came_from[nxt] = cur
                    frontier.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def actions_from_path(path):
        """Translate a list of positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def move_to(src, dst):
        """Return actions moving from src to dst, preferring BFS shortest path."""
        p = bfs_path(src, dst)
        if p is None:
            # fallback to Manhattan moves (may collide with obstacles)
            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return actions_from_path(p)

    def nearest_of_kind(pos, kind_idx, forbidden=set()):
        """Find the nearest cell containing kind_idx not in forbidden."""
