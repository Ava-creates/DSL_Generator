    # reset environment and get initial state
    env.reset()
    state = env._current_state

    # determine goal index for arrow
    if hasattr(env, "task") and hasattr(env.task, "goal"):
        goal_idx = env.task.goal
    else:
        goal_idx = env.world.cookbook.index.get("arrow")
        if goal_idx is None:
            raise ValueError("Arrow goal not found in cookbook")

    # action constants
    act_spec = env.action_specs()
    ACT_DOWN = act_spec["DOWN"]
    ACT_UP = act_spec["UP"]
    ACT_LEFT = act_spec["LEFT"]
    ACT_RIGHT = act_spec["RIGHT"]
    ACT_USE = act_spec["USE"]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS to compute a path of actions from start to target,
    # avoiding any occupied cell (any non‑zero channel in the grid).
    # ------------------------------------------------------------------
    def bfs_path(start, target):
        grid = state.grid
        h, w, _ = grid.shape
        q = collections.deque()
        q.append((start, []))
        visited = {start}
        while q:
            (y, x), path = q.popleft()
            if (y, x) == target:
                return path
            for act, dy, dx in (
                (ACT_DOWN, 1, 0),
                (ACT_UP, -1, 0),
                (ACT_RIGHT, 0, 1),
                (ACT_LEFT, 0, -1),
            ):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not grid[ny, nx, :].any() and (ny, nx) not in visited:
                        visited.add((ny, nx))
                        q.append(((ny, nx), path + [act]))
        return []  # no path found

    # ------------------------------------------------------------------
    # Helper: move agent to an absolute position using bfs_path.
    # ------------------------------------------------------------------
    def move_to(target):
        nonlocal state, actions
        while state.pos != target:
            path = bfs_path(state.pos, target)
            if not path:
                # cannot reach target; abort movement
                break
            for a in path:
                actions.append(a)
                _, _, _ = env.step(a)
                state = env._current_state
                if state.pos == target:
                    break

    # ------------------------------------------------------------------
    # Helper: locate nearest cell that contains a given kind index.
    # ------------------------------------------------------------------
    def find_nearest(kind_idx):
        grid = state.grid
        h, w, _ = grid.shape
        best = None
        best_dist = None
        for i in range(h):
            for j in range(w):
                if grid[i, j, kind_idx] > 0:
                    d = abs(i - state.pos[0]) + abs(j - state.pos[1])
                    if best_dist is None or d < best_dist:
                        best_dist = d
                        best = (i, j)
        return best

    # ------------------------------------------------------------------
    # Helper: pick a free cell adjacent (including diagonals) to a target.
    # Returns the target itself if it is free.
    # ------------------------------------------------------------------
    def adjacent_free(target):
        grid = state.grid
        h, w, _ = grid.shape
        ty, tx = target
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = ty + dy, tx + dx
                if 0 <= ny < h and 0 <= nx < w:
                    if not grid[ny, nx, :].any():
                        return (ny, nx)
        # fallback: if target cell itself is free
        if not grid[ty, tx, :].any():
            return (ty, tx)
        return None

    # ------------------------------------------------------------------
    # Collect all required primitives for the arrow.
    # ------------------------------------------------------------------
    primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in primitives.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                continue  # primitive not present; skip
            adj = adjacent_free(src)
            if adj is None:
                continue  # no free adjacent cell; skip
            move_to(adj)
            actions.append(ACT_USE)
            _, _, _ = env.step(ACT_USE)
            state = env._current_state

    # ------------------------------------------------------------------
    # Go to the appropriate workshop (if any) and craft the arrow.
    # ------------------------------------------------------------------
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name:
        ws_idx = env.world.cookbook.index[workshop_name]
        ws_pos = find_nearest(ws_idx)
        if ws_pos:
            adj = adjacent_free(ws_pos)
            if adj:
                move_to(adj)
                actions.append(ACT_USE)
                _, _, _ = env.step(ACT_USE)
                state = env._current_state

    return actions


