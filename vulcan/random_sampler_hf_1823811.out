    actions = []

    def move_and_use(cur, target):
        """Move from cur (x,y) to target (x,y) using Manhattan moves and append USE."""
        x, y = cur
        tx, ty = target
        # horizontal
        while x < tx:
            actions.append(3)   # RIGHT
            x += 1
        while x > tx:
            actions.append(2)   # LEFT
            x -= 1
        # vertical
        while y < ty:
            actions.append(0)   # DOWN
            y += 1
        while y > ty:
            actions.append(1)   # UP
            y -= 1
        # interact
        actions.append(4)       # USE
        return (x, y)

    cur_pos = tuple(state.pos)

    # Collect each required primitive the necessary number of times.
    for kind_idx, needed in primitive_reqs.items():
        # Locations where this primitive is present.
        locations = np.argwhere(state.grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            continue
        # Walk to locations, cycling if fewer distinct cells than needed.
        for i in range(needed):
            target = tuple(locations[i % len(locations)])
            cur_pos = move_and_use(cur_pos, target)

    # Go to the workshop and craft the goal item.
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            cur_pos = move_and_use(cur_pos, tuple(workshop_cells[0]))
            # One extra USE to trigger crafting (some implementations need it).
            actions.append(4)

    return actions


