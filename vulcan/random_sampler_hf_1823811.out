        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions


    import collections
    import numpy as np

    # Reset environment and get initial references
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                    # type: CraftWorld

    # Goal item index
    goal_idx = env.task.goal

    # Primitive requirements for the goal (primitive_kind -> count)
    required = world.cookbook.primitives_for(goal_idx)

    # Action indices as defined by the environment
    action_map = env.action_specs()
    ACTION_DOWN = action_map.get('DOWN')
    ACTION_UP = action_map.get('UP')
    ACTION_LEFT = action_map.get('LEFT')
    ACTION_RIGHT = action_map.get('RIGHT')
    ACTION_USE = action_map.get('USE')

    # Direction vectors paired with their action indices
    move_dirs = [
        (1, 0, ACTION_DOWN),
        (-1, 0, ACTION_UP),
        (0, -1, ACTION_LEFT),
        (0, 1, ACTION_RIGHT),
    ]

    actions = []

    def find_path(cur_state, target_kind):
        """
        Breadth‑first search returning a list of movement actions that leads
        from the agent's current position to any cell containing `target_kind`.
        The search may step onto empty cells or the target cell itself,
        but avoids other occupied cells.
        """
        grid = cur_state.grid
        H, W = grid.shape[:2]
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # Should not happen in a valid scenario
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, count in required.items():
        for _ in range(count):
            path = find_path(state, kind)
            for act in path:
                _, state = state.step(act)
                actions.append(act)
            # Pick up the primitive now under the agent
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for act in path:
            _, state = state.step(act)
            actions.append(act)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

