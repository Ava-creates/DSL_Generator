    # Reset environment to obtain initial state and task information
    env.reset()
    # Goal index for the item to be crafted (arrow)
    goal_idx = getattr(env, "task", None)
    if goal_idx is None:
        # Fallback: try to get from task attribute if it's a namedtuple
        goal_idx = getattr(env, "task", None)
        if isinstance(goal_idx, tuple):
            goal_idx = goal_idx[0]
    if isinstance(goal_idx, tuple):
        goal_idx = goal_idx[0]
    # If still not an int, try to read from the current state (may store goal elsewhere)
    if not isinstance(goal_idx, int):
        raise ValueError("Unable to determine goal index from environment.")

    # Obtain the primitive requirements for the goal
    primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}
    # Determine the workshop index where the goal must be crafted
    workshop_idx = None
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        workshop_idx = recipe["_at"]
    else:
        # Some recipes may use the key "_key" for workshop location
        workshop_idx = recipe.get("_key", None)
    if workshop_idx is None:
