    # reset environment and get handles
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index               # name ↔ id mapping

    # action indices
    act_map = env.action_specs()
    DOWN = act_map["DOWN"]
    UP = act_map["UP"]
    LEFT = act_map["LEFT"]
    RIGHT = act_map["RIGHT"]
    USE = act_map["USE"]

    # --------------------------------------------------------------
    # identify goal and required primitives
    # --------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # goal not present in this world
    goal_idx = index[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # --------------------------------------------------------------
    # helper: BFS that returns a list of movement actions
    # --------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        """Return list of movement actions from start to target."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        moves = [(DOWN, (1, 0)),
                 (UP,   (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT,(0, 1))]
        q = deque([start])
        visited = {start}
        parent = {}                     # child -> (parent, action)

        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # allow stepping onto the target even if occupied
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)

        if target not in parent and start != target:
            return []   # no path found

        # reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # --------------------------------------------------------------
    # 1. collect required primitives (respecting multiplicities)
    # --------------------------------------------------------------
    for prim_idx, cnt in primitive_needs.items():
        for _ in range(cnt):
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return actions               # primitive missing, abort
            # pick nearest cell (Manhattan distance)
            dists = np.abs(cells[:, 0] - state.pos[0]) + np.abs(cells[:, 1] - state.pos[1])
            target = tuple(cells[dists.argmin()])

            # move there
            move_seq = _bfs_path(state.pos, target)
            actions.extend(move_seq)
            state.pos = target

            # pick up
            actions.append(USE)
            state.inventory[prim_idx] += 1
            tr, tc = target
            state.grid[tr, tc, prim_idx] = 0

    # --------------------------------------------------------------
    # 2. go to workshop and craft the arrow
    # --------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # no workshop info

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # workshop not present

    dists = np.abs(workshop_cells[:, 0] - state.pos[0]) + np.abs(workshop_cells[:, 1] - state.pos[1])
    wr, wc = tuple(workshop_cells[dists.argmin()])

    # move to workshop
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # craft
    actions.append(USE)

    return actions


