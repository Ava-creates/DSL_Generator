    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)  # RIGHT
            x += 1
        while x > tx:
            seq.append(2)  # LEFT
            x -= 1
        while y < ty:
            seq.append(0)  # DOWN
            y += 1
        while y > ty:
            seq.append(1)  # UP
            y -= 1
        return seq, (x, y)

    harvested: dict[int, set[tuple[int, int]]] = {}

    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        idx = int(np.argmin(dists))
        return candidates[idx]

    for kind, cnt in required.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)  # USE to pick up
            harvested[kind].add(target)

    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)

    actions.append(4)  # final USE to craft
    return actions


    # Reset environment and fetch core objects
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    goal_idx = env.task.goal

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def moves_to(start, target):
        """Return a list of movement actions (0‑4) to go from start to target."""
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)          # RIGHT
            x += 1
        while x > tx:
            seq.append(2)          # LEFT
            x -= 1
        while y < ty:
            seq.append(0)          # DOWN
            y += 1
        while y > ty:
            seq.append(1)          # UP
            y -= 1
        return seq, (x, y)

    def nearest_cell(kind, from_pos, grid, taken=None):
        """Find nearest cell containing at least one entity of `kind`.
        If `taken` is provided it is a set of coordinates that should be ignored."""
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        if taken is not None:
            cells = np.array([c for c in cells if tuple(c) not in taken])
            if cells.size == 0:
                return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = int(np.argmin(dists))
        return tuple(cells[idx])

    # ------------------------------------------------------------------
    # Determine full crafting order (ingredients before products)
    # ------------------------------------------------------------------
    recipes = world.cookbook.recipes

    def dfs(item, visited, order):
        if item in visited:
            return
        visited.add(item)
        recipe = recipes.get(item, {})
        for ing, cnt in recipe.items():
            if ing == "_at":
                continue
            if cnt <= 0:
                continue
            dfs(ing, visited, order)
        order.append(item)

    craft_order = []
    dfs(goal_idx, set(), craft_order)          # post‑order: ingredients first, goal last

    # ------------------------------------------------------------------
    # Collect all required primitive resources
    # ------------------------------------------------------------------
    primitives_needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    grid_copy = scenario.init_grid.copy()                         # mutable copy for tracking pickups
    taken_primitives = set()                                      # cells already harvested
    actions = []
    cur_pos = tuple(state.pos)

    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            target = nearest_cell(prim_idx, cur_pos, grid_copy, taken_primitives)
            if target is None:
                # No more of this primitive on the map – give up on this piece
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)          # USE to pick up
            # Mark this cell as consumed
            grid_copy[target[0], target[1], prim_idx] = 0
            taken_primitives.add(target)

    # ------------------------------------------------------------------
    # Perform crafting steps following the computed order
    # ------------------------------------------------------------------
    for item_idx in craft_order:
        # Skip primitives – they are already in inventory
        if item_idx in world.cookbook.primitives:
            continue
        recipe = recipes.get(item_idx, {})
        wk = recipe.get("_at", None)
        if wk is None:
            # No specific workshop – just try to USE at current location
            actions.append(4)
            continue
        # Resolve workshop kind to integer index if needed
        if isinstance(wk, str):
            wk_idx = world.cookbook.index[wk]
        else:
            wk_idx = wk
        # Locate nearest workshop cell
        target = nearest_cell(wk_idx, cur_pos, scenario.init_grid)
        if target is None:
            # No workshop found – skip
            continue
        move_seq, cur_pos = moves_to(cur_pos, target)
        actions.extend(move_seq)
        actions.append(4)              # USE to craft at this workshop

    # ------------------------------------------------------------------
    # Ensure a final USE in case the last step was just moving
    # ------------------------------------------------------------------
    actions.append(4)

    return actions

