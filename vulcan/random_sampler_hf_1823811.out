        grid = env._current_state.grid
        h, w, _ = grid.shape
        if not grid[y, x, :].any():
            return (y, x)
        for dy in (-1, 0, 1):
            for dx in (-1, 0, 1):
                ny, nx = y + dy, x + dx
                if 0 <= ny < h and 0 <= nx < w and not grid[ny, nx, :].any():
