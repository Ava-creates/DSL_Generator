    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    def find_locations(kind):
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))
        queue = collections.deque([start])
        prev = {start: None}
        while queue:
            cur = queue.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        queue.append(nxt)
        return [start]

    def move_action(cur, nxt):
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Non‑adjacent movement requested")

    actions = []
    cur_pos = state.pos

    # Collect required primitives
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            locations = find_locations(prim_idx)
            if not locations:
                # No more of this primitive on the grid; abort.
                break
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE to pick up
            # Update planning state
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # Move to workshop if required
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            target = min(
                wk_locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

    # Craft the arrow
    actions.append(4)   # USE at current location

    return actions


    # Reset environment and get current planning snapshot
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------
    # Identify goal and its recipe
    # ------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for a single arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Workshop required for crafting (if any)
    workshop_kind = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) where `kind` exists on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest Manhattan path avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # cells occupied by non‑grabbable entities are blocked
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        queue = collections.deque([start])
        prev = {start: None}
        while queue:
            cur = queue.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        queue.append(nxt)
        # No path found – stay where we are
        return [start]

    def move_action(cur, nxt):
        """Translate a step into an action index (DOWN=0, UP=1, LEFT=2, RIGHT=3)."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Requested move is not to an adjacent cell")

    # ------------------------------------------------------------
    # Build action sequence
    # ------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # 1) Collect all required primitives
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            # locate remaining copies of the primitive
            locations = find_locations(prim_idx)
            if not locations:
                # cannot find more – break out of loop for this primitive
                break

            # pick the nearest instance (Manhattan distance)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )

            # move to the target cell
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # pick up (USE)
            actions.append(4)   # USE
            # update planning snapshot
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2) Move to required workshop (if any) and craft
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            target = min(
                wk_locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

    # 3) Craft the arrow (USE at current location)
    actions.append(4)   # USE

    return actions

