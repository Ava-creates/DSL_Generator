    def locate(kind):
        """Return a list of (x, y) positions where `kind` occurs on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """Bread‑first search returning a list of actions that moves from `start`
        to `target` while avoiding blocked cells. The target cell is treated as
        walkable even if it currently contains an entity."""
        occ = np.any(state.grid > 0, axis=2)          # occupied cells
        occ[target[0], target[1]] = False             # allow stepping onto target
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # no path found

    def go_to(target):
        """Move the agent from its current position to `target`,
        recording the actions and updating the state."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for kind, count in needed.items():
        for _ in range(count):
            positions = locate(kind)
            if not positions:
                # Primitive not present; abort early.
                return actions
