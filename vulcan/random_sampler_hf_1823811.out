    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    from collections import deque
    import numpy as np

    def bfs_path(start, target):
        """Return list of movement actions from start to target,
        allowing stepping onto target even if occupied."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Block any non‑empty cell unless it is the target.
                if nxt != target and state.grid[nr, nc].any():
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # No path.
        # Reconstruct actions.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # Goal item.
    goal_name = "arrow"
    if goal_name not in idx.contents:
        return []
    goal_idx = idx[goal_name]

    # Primitive requirements.
    primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            # Locate nearest cell containing the primitive.
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                return actions  # Primitive missing.
            dists = np.abs(cells - np.array(state.pos)).sum(axis=1)
            tr, tc = cells[dists.argmin()]
            # Move there.
            move_seq = bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)
            # Pick it up.
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions
    workshop_idx = idx[workshop_name]

    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]
    move_seq = bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)
    actions.append(USE)  # Craft.

    return actions


    env.reset()
    state = env._current_state
    world = env.scenario.world
    cookbook = world.cookbook
    index = cookbook.index

    # Resolve action identifiers.
    act_map = env.action_specs()
    DOWN = act_map["DOWN"]
    UP = act_map["UP"]
    LEFT = act_map["LEFT"]
    RIGHT = act_map["RIGHT"]
    USE = act_map["USE"]
    moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]

    from collections import deque

    def bfs_path(start, target):
        """Return list of movement actions from start to target,
        avoiding occupied cells (except the target cell)."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # Allow stepping onto the target even if occupied.
                if nxt != target and state.grid[nr, nc].any():
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []  # No path found.
        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    def find_nearest(kind_idx, start):
        """Locate the nearest cell containing `kind_idx`.
        Returns (action_path, cell_coords) or ([], None) if not found."""
        if state.grid[start[0], start[1], kind_idx] > 0:
            return [], start
        h, w = state.grid.shape[:2]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                if nxt in visited:
                    continue
                # If the cell holds the target kind we can step onto it.
                if state.grid[nr, nc, kind_idx] > 0:
                    parent[nxt] = (cur, act)
                    # Reconstruct path to this cell.
                    path = []
                    cur2 = nxt
                    while cur2 != start:
                        prev2, act2 = parent[cur2]
                        path.append(act2)
                        cur2 = prev2
                    path.reverse()
                    return path, nxt
                # Otherwise the cell must be empty to traverse.
                if state.grid[nr, nc].any():
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        return [], None

    # ------------------------------------------------------------------
    # Determine goal and required primitives.
    # ------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []
    goal_idx = index[goal_name]

    needed_prims = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    # ------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, count in needed_prims.items():
        for _ in range(count):
            path, cell = find_nearest(prim_idx, state.pos)
            if cell is None:
                # Primitive not reachable; abort early.
                return actions
            actions.extend(path)
            state.pos = cell
            actions.append(USE)  # Pick up primitive.
            # Update simulated state.
            state.inventory[prim_idx] += 1
            tr, tc = cell
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None or workshop_name not in index.contents:
        return actions
    workshop_idx = index[workshop_name]

    path, cell = find_nearest(workshop_idx, state.pos)
    if cell is None:
        return actions
    actions.extend(path)
    state.pos = cell
    actions.append(USE)  # Craft the arrow.

    return actions

