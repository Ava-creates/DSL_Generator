    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # Helper to generate a Manhattan path (ignoring obstacles)
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # Track which resource cells have already been used
    used_cells = {}

    # Find the nearest unused cell of a given kind
    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = used_cells.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        return candidates[int(np.argmin(dists))]

