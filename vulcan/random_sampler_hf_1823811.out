    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Goal item
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]

    # Primitive requirements for one arrow
    primitive_needs = cookbook.primitives_for(goal_idx)  # {kind_idx: count}

    # Workshop required for crafting (if any)
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    # Copy of the grid to track collected items
    grid = state.grid.copy()
    cur_pos = tuple(state.pos)

    actions = []

    def move_to(cur, target):
        """Append moves to actions to go from cur to target (Manhattan)."""
        x, y = cur
        tx, ty = target
        # Horizontal moves
        while x < tx:
            actions.append(3)   # RIGHT
            x += 1
        while x > tx:
            actions.append(2)   # LEFT
            x -= 1
        # Vertical moves
        while y < ty:
            actions.append(0)   # DOWN
            y += 1
        while y > ty:
            actions.append(1)   # UP
            y -= 1
        return (x, y)

    # Collect all required primitives
    for kind_idx, needed in primitive_needs.items():
        while needed > 0:
            # Find all remaining cells containing this primitive
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # No more primitives of this kind on the map; abort early
                break
            # Choose the nearest one (Manhattan distance)
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            nearest = locations[dists.argmin()]
            target = tuple(nearest)
            cur_pos = move_to(cur_pos, target)
            actions.append(4)   # USE to pick up
            # Update the simulated grid
            grid[target[0], target[1], kind_idx] = 0
            needed -= 1

    # Move to workshop (if required) and craft the arrow
    if workshop_idx is not None:
        # Workshop cells are static; locate any of them in the original grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            target = tuple(workshop_cells[0])
            cur_pos = move_to(cur_pos, target)
            actions.append(4)   # USE to craft
    else:
        # No specific workshop, just use at current location
        actions.append(4)   # USE to craft

    return actions


    # Reset environment and fetch core objects
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Identify the goal (arrow) and its recipe
    goal_name = "arrow"
    goal_idx = cookbook.index[goal_name]
    primitive_reqs = cookbook.primitives_for(goal_idx)          # {kind_idx: count}
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_idx = cookbook.index[recipe["_at"]]

    actions = []
    cur_pos = tuple(state.pos)

    # Helper to move Manhattan‑style from cur to target and update cur_pos
    def move_to(cur, target):
        x, y = cur
        tx, ty = target
        while x < tx:
            actions.append(3)   # RIGHT
            x += 1
        while x > tx:
            actions.append(2)   # LEFT
            x -= 1
        while y < ty:
            actions.append(0)   # DOWN
            y += 1
        while y > ty:
            actions.append(1)   # UP
            y -= 1
        return (x, y)

    # Work on a mutable copy of the grid so we can “remove” primitives after picking them up
    grid = state.grid.copy()

    # Collect each required primitive the needed number of times
    for kind_idx, needed in primitive_reqs.items():
        for _ in range(needed):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # No more of this primitive on the map – give up early
                break
            # Choose the nearest occurrence (Manhattan distance)
            dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
            nearest = locations[dists.argmin()]
            target = tuple(nearest)
            cur_pos = move_to(cur_pos, target)
            actions.append(4)               # USE to pick it up
            # Remove the primitive from our copy of the grid
            grid[target[0], target[1], kind_idx] = 0

    # If a workshop is required, go there and issue a USE to craft
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            nearest = workshop_cells[dists.argmin()]
            cur_pos = move_to(cur_pos, tuple(nearest))
            actions.append(4)               # USE to trigger crafting

    return actions

