    # Reset environment to start fresh
    _ = env.reset()

    # Mapping from action names to integer IDs
    act_map = env.action_specs()

    # Direction vectors and names for movement
    moves = [(1, 0, "DOWN"), (-1, 0, "UP"), (0, 1, "RIGHT"), (0, -1, "LEFT")]
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    # ------------------------------------------------------------------
    # Helper: breadth‑first search to a free cell adjacent to a target
    # ------------------------------------------------------------------
    from collections import deque

    def bfs_adjacent(start, target, occupied):
        tr, tc = target
        # Candidate neighbour cells where the agent may stand
        neighbours = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occupied.shape[0]
            and 0 <= tc + dc < occupied.shape[1]
            and not occupied[tr + dr, tc + dc]
        ]
        if not neighbours:
            return []  # no reachable neighbour

        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in neighbours:
                # Reconstruct path of direction names
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occupied.shape[0]
                    and 0 <= nc < occupied.shape[1]
                    and not occupied[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # unreachable

    # ------------------------------------------------------------------
    # Extract problem specifics
    # ------------------------------------------------------------------
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal  # integer index of the desired item

    # Primitive resources required for the goal
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    # Workshop index (if any) where the goal must be crafted
    workshop_idx = world.cookbook.recipes.get(goal_idx, {}).get("_at")

    # Working copies of the initial grid and occupancy mask
    grid = scenario.init_grid.copy()
    occupied = grid.sum(axis=2) > 0  # True where any entity occupies the cell
    cur_pos = scenario.init_pos  # (row, col)

    actions = []

    # ------------------------------------------------------------------
    # Helper: follow a list of direction names, updating position & action list
    # ------------------------------------------------------------------
    def follow(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Collect required primitives one by one
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Find remaining cells containing this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more of this primitive on the map; break early
                break

            # Choose the nearest primitive (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to a free neighbour of the primitive cell
            path = bfs_adjacent(cur_pos, target, occupied)
            follow(path)

            # Use action to pick up the primitive
            actions.append(act_map["USE"])

            # Update grid and occupancy: primitive disappears after pickup
            r, c = target
            grid[r, c, :] = 0
            occupied[r, c] = False

    # ------------------------------------------------------------------
    # Move to required workshop (if any) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0)))
        if workshop_cells:
            ws_target = workshop_cells[0]  # pick the first workshop cell
            path = bfs_adjacent(cur_pos, ws_target, occupied)
            follow(path)
            actions.append(act_map["USE"])
        else:
            # No workshop found; attempt to craft at current location
            actions.append(act_map["USE"])
    else:
        # No specific workshop required; craft at current location
        actions.append(act_map["USE"])

    return actions


