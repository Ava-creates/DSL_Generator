    # Reset environment and obtain references
    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal index and required primitive counts (expanded to primitives only)
    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if final crafting must happen at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    # Action constants (as used by CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Helper: convert a step between two adjacent cells into an action index
    def _step_to_action(p_from, p_to):
        x0, y0 = p_from
        x1, y1 = p_to
        if x1 == x0 + 1:
            return RIGHT
        if x1 == x0 - 1:
            return LEFT
        if y1 == y0 + 1:
            return DOWN
        if y1 == y0 - 1:
            return UP
        raise ValueError("Non‑adjacent step supplied")

    # Helper: BFS to find a path from start to any walkable cell that is
    # orthogonally adjacent to a target cell.
    def _bfs_to_adjacent(start, target):
        width, height, _ = scenario.init_grid.shape
        # candidate landing cells (orthogonal neighbours of target that are empty)
        candidates = []
        tx, ty = target
        for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:
            nx, ny = tx + dx, ty + dy
            if 0 <= nx < width and 0 <= ny < height:
                if scenario.init_grid[nx, ny, :].sum() == 0:
                    candidates.append((nx, ny))
        if not candidates:
            # fallback: if target cell itself is empty (unlikely) allow stepping on it
            if scenario.init_grid[tx, ty, :].sum() == 0:
                candidates.append((tx, ty))

        # BFS over empty cells
        queue = collections.deque([start])
        visited = {start: None}
        while queue:
            cur = queue.popleft()
            if cur in candidates:
                # reconstruct path
                path = []
                while cur is not None:
                    path.append(cur)
                    cur = visited[cur]
                path.reverse()
                return path
            x, y = cur
            for dx, dy in [(1,0), (-1,0), (0,1), (0,-1)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    if (nx, ny) not in visited and scenario.init_grid[nx, ny, :].sum() == 0:
                        visited[(nx, ny)] = cur
                        queue.append((nx, ny))
        # No reachable adjacent cell
        return None

    # Helper: locate the nearest cell that still contains a given kind
    def _nearest_kind(kind, from_pos, grid):
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    actions = []
    cur_pos = tuple(state.pos)

    # Work on a mutable copy of the initial grid so we can “consume” resources
    grid_copy = scenario.init_grid.copy()

    # --------------------------------------------------------------
    # Collect all required primitive resources
    # --------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = _nearest_kind(kind, cur_pos, grid_copy)
            if target is None:
                # Primitive not present – skip (cannot be collected)
                continue
            path = _bfs_to_adjacent(cur_pos, target)
            if path is None:
                # No path to an adjacent cell – skip this resource
                continue
            # Translate path positions into actions
            for i in range(1, len(path)):
                actions.append(_step_to_action(path[i-1], path[i]))
            # Perform USE to pick up the primitive
            actions.append(USE)
            # Update current position (we stay at the last cell of the path)
            cur_pos = path[-1]
            # Mark the resource as taken so we don't reuse the same cell
            grid_copy[target[0], target[1], kind] = 0

    # --------------------------------------------------------------
    # Move to the workshop (if required) and craft the final item
    # --------------------------------------------------------------
    if workshop_kind is not None:
        target = _nearest_kind(workshop_kind, cur_pos, scenario.init_grid)
        if target is not None:
            path = _bfs_to_adjacent(cur_pos, target)
            if path is not None:
                for i in range(1, len(path)):
                    actions.append(_step_to_action(path[i-1], path[i]))
                actions.append(USE)  # craft at the workshop

    return actions


    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    goal_idx = env.task.goal
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the final recipe requires a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan move sequence (ignores obstacles for simplicity)
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ------------------------------------------------------------------
    # Helper: locate nearest cell containing a given kind in a grid
    # ------------------------------------------------------------------
    def nearest_cell(kind, from_pos, grid):
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # Keep a mutable copy of the initial grid so we can “remove” items once taken
    grid_copy = scenario.init_grid.copy()

    # ------------------------------------------------------------------
    # Collect all required primitive items
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos, grid_copy)
            if target is None:
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)                     # USE to pick up the primitive
            grid_copy[target[0], target[1], kind] = 0   # mark as taken

    # ------------------------------------------------------------------
    # Move to workshop (if required) and craft the final item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)                     # USE to craft at the workshop

    return actions

