    # Action identifiers
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # Index of the target item ("arrow")
    goal_idx = world.cookbook.index.index('arrow')
    # Mapping primitive_kind_idx -> required count
    primitive_requirements = world.cookbook.primitives_for(goal_idx)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _cell_blocked(pos, grid):
        """Return True if any entity occupies the cell."""
        x, y = pos
        return grid[x, y, :].any()

    def _bfs(start, goal, grid):
        """Bread‑first search avoiding blocked cells (goal cell may be occupied)."""
        if start == goal:
            return [start]
        w, h = grid.shape[:2]
        frontier = collections.deque([start])
        came_from = {start: None}
        while frontier:
            cur = frontier.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came_from:
                        # Allow stepping onto the goal even if it is occupied
                        if not _cell_blocked(nxt, grid) or nxt == goal:
                            came_from[nxt] = cur
                            frontier.append(nxt)
        else:
            return None  # No path found

        # Reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came_from[path[-1]])
        path.reverse()
        return path

    def _path_to_actions(path):
        """Translate a list of positions into action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move(src, dst, grid):
        """Return a list of actions moving from src to dst (BFS preferred)."""
        bfs_path = _bfs(src, dst, grid)
        if bfs_path is None:
            # Fallback to Manhattan moves (may intersect obstacles)
            acts = []
            sx, sy = src
            dx, dy = dst
            if dx > sx:
                acts += [DOWN] * (dx - sx)
            elif dx < sx:
                acts += [UP] * (sx - dx)
            if dy > sy:
                acts += [RIGHT] * (dy - sy)
            elif dy < sy:
                acts += [LEFT] * (sy - dy)
            return acts
        return _path_to_actions(bfs_path)

    def _nearest(pos, kind_idx, grid, excluded):
        """Find nearest cell containing `kind_idx` not in `excluded` set."""
        candidates = np.argwhere(grid[:, :, kind_idx] > 0)
        if candidates.size == 0:
            return None
        if excluded:
            mask = np.array([tuple(c) not in excluded for c in candidates])
            candidates = candidates[mask]
            if candidates.size == 0:
                return None
        dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
        nearest = candidates[dists.argmin()]
        return tuple(nearest.tolist())

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(env._current_state.pos)
    # Work on a mutable copy of the grid to “consume” harvested primitives
    mutable_grid = env._current_state.grid.copy()
    # Track harvested locations per primitive kind to avoid re‑using them
    harvested = {k: set() for k in primitive_requirements.keys()}

    # 1) Collect all required primitives
    for kind_idx, needed_cnt in primitive_requirements.items():
        for _ in range(needed_cnt):
            target = _nearest(cur_pos, kind_idx, mutable_grid, harvested[kind_idx])
            if target is None:
                # Primitive not available – abort planning
                return actions
            actions += _move(cur_pos, target, mutable_grid)
            cur_pos = target
            actions.append(USE)                # pick up primitive
            # Remove the primitive from our local copy
            mutable_grid[target[0], target[1], kind_idx] = 0
            harvested[kind_idx].add(target)

    # 2) Move to the workshop (if required) and craft the goal item
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_target = _nearest(cur_pos, workshop_idx, mutable_grid, set())
        if ws_target is not None:
            actions += _move(cur_pos, ws_target, mutable_grid)
            cur_pos = ws_target
            actions.append(USE)                # craft at workshop

    # Return the full action sequence
    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
    world = env.world

    # index of the goal item ("arrow")
    goal_idx = world.cookbook.index.index('arrow')
    # primitive requirements for one arrow (recursive)
    prim_req = world.cookbook.primitives_for(goal_idx)

    # mutable copy of the grid – we will clear primitives as we pick them up
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)

    def _cell_blocked(pos, g):
        """True if any entity occupies the cell."""
        x, y = pos
        return g[x, y, :].any()

    def _bfs(start, goal, g):
        """Bread‑first search avoiding blocked cells (except the goal)."""
        if start == goal:
            return [start]
        w, h = g.shape[:2]
        q = collections.deque([start])
        came = {start: None}
        while q:
            cur = q.popleft()
            if cur == goal:
                break
            x, y = cur
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    nxt = (nx, ny)
                    if nxt not in came:
                        if not _cell_blocked(nxt, g) or nxt == goal:
                            came[nxt] = cur
                            q.append(nxt)
        else:
            return None  # no path found

        # reconstruct path
        path = [goal]
        while path[-1] != start:
            path.append(came[path[-1]])
        path.reverse()
        return path

    def _path_to_actions(path):
        """Convert a list of positions to a list of action indices."""
        if not path or len(path) < 2:
            return []
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(DOWN)
            elif x1 == x0 - 1:
                acts.append(UP)
            elif y1 == y0 + 1:
                acts.append(RIGHT)
            elif y1 == y0 - 1:
                acts.append(LEFT)
            else:
                raise ValueError("Non‑adjacent steps in path")
        return acts

    def _move(src, dst, g):
        """Return actions moving from src to dst (BFS preferred)."""
        p = _bfs(src, dst, g)
        if p is None:  # fallback to Manhattan moves
            acts = []
            sx, sy = src
            tx, ty = dst
            if tx > sx:
                acts += [DOWN] * (tx - sx)
            elif tx < sx:
                acts += [UP] * (sx - tx)
            if ty > sy:
                acts += [RIGHT] * (ty - sy)
            elif ty < sy:
                acts += [LEFT] * (sy - ty)
            return acts
        return _path_to_actions(p)

    def _nearest(pos, kind_idx, g, banned):
        """Find the nearest cell containing kind_idx not in banned."""
        cells = np.argwhere(g[:, :, kind_idx] > 0)
        if cells.size == 0:
            return None
        if banned:
            mask = np.array([tuple(c) not in banned for c in cells])
            cells = cells[mask]
            if cells.size == 0:
                return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        nearest = cells[dists.argmin()]
        return tuple(nearest.tolist())

    actions = []
    # keep track of which primitive locations have already been harvested
    harvested = {k: set() for k in prim_req.keys()}

    # --------------------------------------------------------------
    # 1) Collect all required primitives
    # --------------------------------------------------------------
    for kind_idx, needed in prim_req.items():
        for _ in range(needed):
            target = _nearest(cur_pos, kind_idx, grid, harvested[kind_idx])
            if target is None:
                # primitive not available – abort early
                return actions
            actions += _move(cur_pos, target, grid)
            cur_pos = target
            actions.append(USE)          # pick it up
            grid[target[0], target[1], kind_idx] = 0
            harvested[kind_idx].add(target)

    # --------------------------------------------------------------
    # 2) Go to workshop (if required) and craft the arrow
    # --------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        ws_target = _nearest(cur_pos, workshop_idx, grid, set())
        if ws_target is not None:
            actions += _move(cur_pos, ws_target, grid)
            cur_pos = ws_target
            actions.append(USE)   # craft at the workshop

    return actions

