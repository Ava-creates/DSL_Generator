    # Helper: map direction deltas to action indices (DOWN,UP,LEFT,RIGHT)
    _DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}

    def _is_free(cell_x, cell_y, grid):
        """A cell is free if no kind occupies it."""
        return not grid[cell_x, cell_y, :].any()

    def _bfs(start, goal_kind, grid):
        """Return a list of positions from start to a cell containing goal_kind."""
        w, h = grid.shape[:2]
        q = collections.deque()
        q.append((start, [start]))
        visited = {start}
        while q:
            (x, y), path = q.popleft()
            if grid[x, y, goal_kind]:
                return path
            for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited and _is_free(nx, ny, grid):
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [(nx, ny)]))
        raise RuntimeError("No reachable cell for kind %d" % goal_kind)

    def _positions_to_actions(path):
        """Convert a list of positions to a list of movement actions."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            dx, dy = x1 - x0, y1 - y0
            acts.append(_DIR2ACT[(dx, dy)])
        return acts

