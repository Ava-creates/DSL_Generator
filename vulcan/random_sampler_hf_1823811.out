    import numpy as np

    # Reset the environment to obtain a fresh state
    env.reset()
    state = env._current_state
    world = env.world
    cookbook = world.cookbook

    # Index of the target item ("arrow")
    arrow_idx = cookbook.index["arrow"]

    # Primitive requirements for one arrow
    primitive_needs = cookbook.primitives_for(arrow_idx)  # {kind_idx: count}

    actions = []

    # Helper to move towards a target position using simple Manhattan steps
    def move_adjacent_to(target_x, target_y):
        """Move the agent until it is in a Manhattan‑distance‑1 cell from (target_x, target_y)."""
        nonlocal actions, state
        while abs(state.pos[0] - target_x) + abs(state.pos[1] - target_y) > 1:
            ax, ay = state.pos
            if ax < target_x:
                act = 0          # DOWN
            elif ax > target_x:
                act = 1          # UP
            elif ay < target_y:
                act = 3          # RIGHT
            else:
                act = 2          # LEFT
            reward, done, _ = env.step(act)
            actions.append(act)
            state = env._current_state

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for p_kind, needed in primitive_needs.items():
        while needed > 0:
            # Locate remaining instances of this primitive on the grid
            grid = state.grid
            locations = np.argwhere(grid[:, :, p_kind] > 0)
            if locations.size == 0:
                # No more of this primitive available – break to avoid infinite loop
                break

            # Choose the nearest location (Manhattan distance)
            ax, ay = state.pos
            dists = np.abs(locations - np.array([ax, ay])).sum(axis=1)
            tx, ty = locations[dists.argmin()]

            # Move next to the primitive and use the USE action to pick it up
            move_adjacent_to(tx, ty)

            # The last movement direction already points toward the primitive,
            # so a single USE action will collect it.
            reward, done, _ = env.step(4)   # USE
            actions.append(4)
            state = env._current_state
            needed -= 1

    # ------------------------------------------------------------------
    # 2. Craft the arrow at its designated workshop
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is not None:
        workshop_idx = cookbook.index[workshop_name]

        # Find any workshop cell (there should be at least one)
        grid = state.grid
        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size > 0:
            wx, wy = ws_cells[0]

            # Move adjacent to the workshop and invoke USE to craft
            move_adjacent_to(wx, wy)

            reward, done, _ = env.step(4)   # USE (craft)
            actions.append(4)
            state = env._current_state

    return actions

