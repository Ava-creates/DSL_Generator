    import numpy as np
    from collections import deque

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    # Action mapping (same as CraftLab)
    _ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT, _ACTION_USE = 0, 1, 2, 3, 4
    _DELTA_TO_ACTION = {
        (0, 1): _ACTION_DOWN,
        (0, -1): _ACTION_UP,
        (-1, 0): _ACTION_LEFT,
        (1, 0): _ACTION_RIGHT,
    }

    def _is_free(grid, x, y, target_kind=None):
        """Return True if cell (x, y) can be stepped on.
        It is free when empty, or when it contains the *target_kind*
        (so we can move onto a primitive or workshop to interact with it)."""
        if target_kind is not None and grid[x, y, target_kind] > 0:
            return True
        return grid[x, y, :].sum() == 0

    def _neighbors(pos, w, h):
        x, y = pos
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nx, ny = x + dx, y + dy
            if 0 <= nx < w and 0 <= ny < h:
                yield (nx, ny), (dx, dy)

    def _bfs_path(grid, start, goal_cond, target_kind=None):
        """Bread‑first search returning a list of actions that moves the
        agent from ``start`` to any cell satisfying ``goal_cond``.
        ``target_kind`` is treated as passable (used when we need to step
        onto a primitive or workshop)."""
        w, h = grid.shape[0], grid.shape[1]
        q = deque([start])
        came_from = {start: None}
        move_from = {}

        while q:
            cur = q.popleft()
            if goal_cond(cur):
                # reconstruct actions
                actions = []
                while came_from[cur] is not None:
                    dx, dy = move_from[cur]
                    actions.append(_DELTA_TO_ACTION[(dx, dy)])
                    cur = came_from[cur]
                actions.reverse()
                return actions

            for nxt, delta in _neighbors(cur, w, h):
                if nxt not in came_from and _is_free(grid, *nxt, target_kind):
                    came_from[nxt] = cur
                    move_from[nxt] = delta
                    q.append(nxt)

        # No path found
        return []

    # ------------------------------------------------------------------
    # Begin planning
    # ------------------------------------------------------------------
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world                   # type: CraftWorld
    goal_idx = env.task.goal            # integer index of the desired item

    # What primitives (and how many) are required for the goal?
    needed = world.cookbook.primitives_for(goal_idx).copy()   # {prim_idx: count}

    # Determine if the recipe requires a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # Working copies – we will update them as we virtually execute actions
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    cur_pos = tuple(state.pos)

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect each required primitive
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in needed.items():
        while inventory[prim_idx] < required_cnt:
            # Locate all cells that currently contain this primitive
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more primitives left on the map – abort early
                return actions

            # Choose the closest primitive (Manhattan distance)
            dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
            target = tuple(prim_cells[dists.argmin()])

            # Move to the primitive using BFS (treat the primitive cell as passable)
            move_actions = _bfs_path(grid, cur_pos, lambda p, t=target: p == t,
                                     target_kind=prim_idx)
            actions.extend(move_actions)
            cur_pos = target

            # Pick it up
            actions.append(_ACTION_USE)
            # Update simulated world state
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if required) and craft the goal
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        # Find all workshop cells
        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size == 0:
            # No workshop present – abort
            return actions

        # Choose the nearest reachable workshop cell
        dists = np.abs(ws_cells[:, 0] - cur_pos[0]) + np.abs(ws_cells[:, 1] - cur_pos[1])
        ws_target = tuple(ws_cells[dists.argmin()])

        # Move to the workshop (treat workshop cell as passable)
        move_actions = _bfs_path(grid, cur_pos,
                                 lambda p, t=ws_target: p == t,
                                 target_kind=workshop_idx)
        actions.extend(move_actions)
        cur_pos = ws_target

        # Craft by using the workshop
        actions.append(_ACTION_USE)

    else:
        # No specific workshop – just attempt to craft at the current location
        actions.append(_ACTION_USE)

    # Return the complete action list
    return actions


