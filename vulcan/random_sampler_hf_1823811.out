    from collections import deque
    import numpy as np

    def locate(kind):
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_actions(start, targets):
        if not targets:
            return []
        target_set = set(targets)
        if start in target_set:
            return []
        w, h = state.grid.shape[:2]
        q = deque()
        q.append((start, []))
        visited = {start}
        moves = [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]  # DOWN,UP,LEFT,RIGHT
        while q:
            (x, y), path = q.popleft()
            for dx, dy, act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                npos = (nx, ny)
                if npos in visited:
                    continue
                blocked = False
                if npos not in target_set:
                    cell = state.grid[nx, ny, :]
                    for idx in world.non_grabbable_indices:
                        if cell[idx] > 0:
                            blocked = True
                            break
                if blocked:
                    continue
                if npos in target_set:
                    return path + [act]
                visited.add(npos)
                q.append((npos, path + [act]))
        return []

    actions = []

    def move_along(seq):
        nonlocal state, actions
        for a in seq:
            actions.append(a)
            _, state = state.step(a)

    # Gather needed primitives
    for kind_idx, req_cnt in needed.items():
        while state.inventory[kind_idx] < req_cnt:
            prim_positions = locate(kind_idx)
            if not prim_positions:
                return actions
            path = bfs_actions(state.pos, prim_positions)
            if not path:
                return actions
            move_along(path)
            actions.append(4)  # USE to pick up
            _, state = state.step(4)

    # Move to workshop if required
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            path = bfs_actions(state.pos, ws_positions)
            if path:
                move_along(path)

    # Craft the goal item
    actions.append(4)  # USE to craft
    _, state = state.step(4)

    return actions


    # Reset environment and obtain initial state/world information
    env.reset()
    state = env._current_state          # CraftState
    world = env.world

    # Goal item index for this episode.
    goal_idx = env.task.goal

    # Primitive requirements for the goal (primitive kind -> required count).
    needed = world.cookbook.primitives_for(goal_idx)

    # Determine workshop (if any) where the goal must be crafted.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    ws_name = recipe.get('_at')
    if ws_name is not None:
        workshop_idx = world.cookbook.index[ws_name]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    from collections import deque

    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs(start, targets):
        """
        Bread‑first search returning a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that moves the agent from `start` to the nearest position in `targets`.
        Cells containing any non‑grabbable entity are treated as blocked,
        except when the cell is a target itself.
        """
        if not targets:
            return []
        target_set = set(targets)
        if start in target_set:
            return []

        w, h = state.grid.shape[:2]
        q = deque()
        q.append((start, []))
        visited = {start}
        # (dx, dy, action_id)
        moves = [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]

        while q:
            (x, y), path = q.popleft()
            for dx, dy, act in moves:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < w and 0 <= ny < h):
                    continue
                npos = (nx, ny)
                if npos in visited:
                    continue

                # Determine if the cell is passable.
                blocked = False
                if npos not in target_set:
                    cell = state.grid[nx, ny, :]
                    for idx in world.non_grabbable_indices:
                        if cell[idx] > 0:
                            blocked = True
                            break
                if blocked:
                    continue

                if npos in target_set:
                    return path + [act]
                visited.add(npos)
                q.append((npos, path + [act]))
        # No reachable target.
        return []

    def execute(seq):
        """Execute a sequence of actions, updating `state` and recording them."""
        nonlocal state
        for a in seq:
            actions.append(a)
            _, state = state.step(a)

    # ------------------------------------------------------------------
    # Build the action plan.
    # ------------------------------------------------------------------
    actions = []

    # 1. Gather all required primitives.
    for kind_idx, required_cnt in needed.items():
        while state.inventory[kind_idx] < required_cnt:
            prim_positions = locate(kind_idx)
            if not prim_positions:
                # Primitive not present – abort early.
                return actions
            path_to_prim = bfs(state.pos, prim_positions)
            if not path_to_prim:
                # Unreachable primitive – abort.
                return actions
            execute(path_to_prim)
            # Pick up the primitive.
            actions.append(4)          # USE action
            _, state = state.step(4)

    # 2. If a specific workshop is required, go there.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            path_to_ws = bfs(state.pos, ws_positions)
            if path_to_ws:
                execute(path_to_ws)

    # 3. Use the craft action (USE) to create the goal item at the current location.
    actions.append(4)                  # USE
    _, state = state.step(4)

    # Return the complete action list.
    return actions

