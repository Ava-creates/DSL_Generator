                for idx in world.non_grabbable_indices:
                    if grid[nx, ny, idx] > 0:
                        blocked = True
                        break
                if blocked:
                    if (nx, ny) == target and allow_target_kind is not None:
                        if grid[nx, ny, allow_target_kind] > 0:
                            blocked = False
                if not blocked:
                    visited[(nx, ny)] = (x, y)
                    q.append((nx, ny))
        return None  # no path found

    def positions_to_actions(path):
        """Translate a position path (including start) to a list of actions."""
        acts = []
        for (x0, y0), (x1, y1) in zip(path, path[1:]):
            if x1 == x0 + 1:
                acts.append(ACTION_RIGHT)
            elif x1 == x0 - 1:
                acts.append(ACTION_LEFT)
            elif y1 == y0 + 1:
                acts.append(ACTION_DOWN)
            elif y1 == y0 - 1:
                acts.append(ACTION_UP)
        return acts

    def nearest_cell(kind, from_pos, grid):
        """Find the nearest cell that contains at least one entity of `kind`."""
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])
        idx = dists.argmin()
        return tuple(cells[idx])

    # ------------------------------------------------------------------
    # Planning
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)
    # Work on a mutable copy of the grid so we can mark primitives as taken
    grid_copy = scenario.init_grid.copy()

    # Collect required primitives
    for kind, count in required.items():
        for _ in range(count):
            target = nearest_cell(kind, cur_pos, grid_copy)
            if target is None:
                # No more of this primitive left; abort this item
                continue
            path = bfs_path(cur_pos, target, grid_copy, allow_target_kind=kind)
            if path is None:
                continue
            actions.extend(positions_to_actions(path))
            actions.append(ACTION_USE)  # pick up
            # Mark as taken
            grid_copy[target[0], target[1], kind] = 0
            cur_pos = target

    # Move to workshop (if needed) and craft
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos, scenario.init_grid)
        if target is not None:
            path = bfs_path(cur_pos, target, scenario.init_grid, allow_target_kind=workshop_kind)
            if path is not None:
                actions.extend(positions_to_actions(path))
                actions.append(ACTION_USE)  # craft
    else:
        # If there is a recipe but no specific workshop, a final USE may trigger crafting
        if world.cookbook.recipes.get(goal_idx):
            actions.append(ACTION_USE)

    return actions

