    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (match CraftLab.action_specs)
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS to a free cell adjacent to a target cell
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        """Return a list of actions moving from *start* to any free 4‑adjacent
        cell of *target*. Empty list if unreachable."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ----------------------------------------------------------------------
    # Reset environment and obtain the current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []                     # cannot obtain a state

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe information
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # no arrow defined in the recipes

    # Primitive requirements for a single arrow (recursively flattened)
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # Locate the workshop required for crafting the arrow
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                     # workshop information missing

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # workshop not indexed

    # ----------------------------------------------------------------------
    # Local mutable copies for planning simulation
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells

    plan = []                                   # list of action indices

    # ----------------------------------------------------------------------
    # Helper: move adjacent to *target* cell containing *kind_idx* and USE
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Navigate to a free cell adjacent to *target*, issue USE,
        and update the simulated world state. Returns False on failure."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False

        # Simulate movement actions
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # Issue USE action
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            # Pick up the item (or interact with a workshop)
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitive items
    # ----------------------------------------------------------------------
    for prim_idx, cnt in primitives_needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, prim_idx] > 0)
            if locations.size == 0:
                # Primitive not present on the map – abort planning
                return plan
            # Choose the nearest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # Workshops are static; fall back to the original scenario grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Constants matching CraftLab.action_specs
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS to a free cell adjacent to a target cell
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        """Return a list of actions moving from *start* to any free
        4‑connected cell next to *target*. Empty list if unreachable."""
        h, w = blocked.shape
        tx, ty = target
        # all free neighbours of the target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ----------------------------------------------------------------------
    # Reset environment and fetch the current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []                     # cannot obtain a state

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # no arrow defined in the recipes

    # primitives needed for one arrow
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # locate the workshop name in the recipe (key "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                     # recipe missing workshop info

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                     # workshop not indexed

    # ----------------------------------------------------------------------
    # Local mutable copies for planning
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                 # (x, y)
    grid = state.grid.copy()               # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)    # bool matrix of blocked cells

    plan = []                               # list of action integers

    # ----------------------------------------------------------------------
    # Helper: move adjacent to a cell containing *kind_idx* and USE it
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Navigate adjacent to *target*, issue USE, and update the
        simulated world. Returns False if movement impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # simulate the moves
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # USE action
        plan.append(USE)

        tx, ty = target
        # if the cell holds the requested kind, pick it up (except workshops)
        if grid[tx, ty, kind_idx] > 0 and kind_idx != workshop_idx:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        else:
            # interacting with a workshop – we just assume crafting succeeds
            pass
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives (or sub‑components)
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.shape[0] == 0:
                # primitive missing – abort planning, return what we have
                return plan
            # choose the nearest by Manhattan distance
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = tuple(candidates[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # workshops are static; fall back to the original scenario grid
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan

