    # Initialise environment and obtain useful references.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    goal_idx = env.task.goal
    # Primitive requirements for the goal (expanded recursively).
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine the workshop required for crafting the goal, if any.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    ws_name = recipe.get('_at')
    if ws_name is not None:
        workshop_idx = world.cookbook.index[ws_name]

    actions = []   # final list of action indices to return.

    import numpy as np
    from collections import deque

    def locate(kind):
        """
        Return a list of (x, y) positions where `kind` exists on the current grid.
        """
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def step_action(act):
        """
        Execute a single action in the simulated environment, updating the local `state`.
        """
        nonlocal state
        _, new_state = state.step(act)
        state = new_state

    def bfs_path(start, target):
        """
        Bread‑first search that returns a list of movement actions (0‑DOWN,1‑UP,
        2‑LEFT,3‑RIGHT) moving from `start` to `target`. Cells occupied by any entity
        are treated as blocked, except the `target` cell itself.
        """
        occ = np.any(state.grid > 0, axis=2)          # occupancy mask
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h:
                    # Allow stepping onto the target even if it is occupied.
                    if (nx, ny) != target and occ[nx, ny]:
                        continue
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # No path found – return empty list.
        return []

    def go_to(target):
        """
        Move the agent from its current position to `target` using the shortest
        path found by `bfs_path`. Each movement action is recorded and applied.
        """
        for act in bfs_path(state.pos, target):
            actions.append(act)
            step_action(act)

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources.
    # ------------------------------------------------------------------
    for kind, required_cnt in needed.items():
        while state.inventory[kind] < required_cnt:
            positions = locate(kind)
            if not positions:
                # Primitive not present anywhere – abort early.
                return actions
            # Choose the nearest occurrence (Manhattan distance).
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the primitive.
            actions.append(4)          # USE action
            step_action(4)

    # ------------------------------------------------------------------
    # 2) Go to the required workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
            actions.append(4)          # USE to trigger crafting
            step_action(4)

    # Return the compiled list of actions.
    return actions


