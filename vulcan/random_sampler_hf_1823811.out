    # Reset the environment to obtain a fresh state.
    env.reset()
    state = env._current_state

    # Access world and recipe information.
    world = env.world
    cookbook = world.cookbook

    # Index of the target item ("arrow").
    arrow_idx = cookbook.index["arrow"]

    # Primitive requirements for one arrow (primitive index → count).
    primitive_requirements = cookbook.primitives_for(arrow_idx)

    # Action constants (as defined by CraftLab.action_specs).
    MOVE_ACTIONS = [0, 1, 2, 3]   # DOWN, UP, LEFT, RIGHT (order may vary)
    USE_ACTION = 4                # USE / interact

    actions = []
    max_steps = 2000
    steps = 0

    # Main planning loop: keep acting until the arrow is in the inventory
    # or we exceed a safety bound.
    while not state.satisfies("", arrow_idx) and steps < max_steps:
        # Determine which primitives are still needed.
        missing_prims = [
            p_idx
            for p_idx, count in primitive_requirements.items()
            if state.inventory[p_idx] < count
        ]

        acted = False

        # If any needed primitive is adjacent, try to collect it.
        for p_idx in missing_prims:
            if state.next_to(p_idx):
                actions.append(USE_ACTION)
                _, _, _ = env.step(USE_ACTION)
                state = env._current_state
                acted = True
                break

        if acted:
            continue

        # If we already have all required primitives, attempt to craft.
        if not missing_prims:
            actions.append(USE_ACTION)
            _, _, _ = env.step(USE_ACTION)
            state = env._current_state
            steps += 1
            continue

        # Otherwise move randomly (simple exploration).
        act = int(np.random.choice(MOVE_ACTIONS))
        actions.append(act)
        _, _, _ = env.step(act)
        state = env._current_state
        steps += 1

    return actions


    # ----------------------------------------------------------------------
    # Helper utilities (local to the function)
    # ----------------------------------------------------------------------
    # direction → (dx, dy)  (grid is indexed as (x, y))
    DIR2DELTA = {
        0: (0, 1),   # DOWN
        1: (0, -1),  # UP
        2: (-1, 0),  # LEFT
        3: (1, 0),   # RIGHT
    }

    # reverse map from delta to direction index
    DELTA2DIR = {v: k for k, v in DIR2DELTA.items()}

    def bfs(start, goal_set, walkable):
        """Return a list of positions from start to the first cell in goal_set.
        start, goal_set elements are (x, y) tuples. walkable is a 2‑D bool
        array where True means the agent can occupy the cell.
        """
        from collections import deque

        q = deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            if cur in goal_set:
                # reconstruct path
                path = []
                while cur != start:
                    path.append(cur)
                    cur = prev[cur]
                path.reverse()
                return path
            x, y = cur
            for dx, dy in DIR2DELTA.values():
                nx, ny = x + dx, y + dy
                if 0 <= nx < walkable.shape[0] and 0 <= ny < walkable.shape[1]:
                    if walkable[nx, ny] and (nx, ny) not in prev:
                        prev[(nx, ny)] = cur
                        q.append((nx, ny))
        return []  # no path found

    # ----------------------------------------------------------------------
    # Initialise environment and retrieve problem data
    # ----------------------------------------------------------------------
    # Reset the environment to obtain a fresh state
    env.reset()
    state = env._current_state               # type: CraftState
    grid = state.grid                         # (W, H, n_kinds)
    pos = tuple(state.pos)                    # (x, y)
    direction = state.dir                     # int 0‑4
    inventory = state.inventory.copy()        # 1‑D array length n_kinds

    # Goal index (the item we want to craft)
    goal_idx = getattr(env, "task", None)
    if goal_idx is None:
        raise RuntimeError("Environment does not expose a task attribute.")
    # In CraftLab the task is a namedtuple Task(goal, steps)
    goal_idx = env.task.goal

    # Primitive requirements for the goal (may be empty if goal is primitive)
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    actions = []  # final action list to be returned

    # ----------------------------------------------------------------------
    # Main collection loop – gather each required primitive
    # ----------------------------------------------------------------------
    for prim_kind, needed_cnt in needed_prims.items():
        # keep collecting until we have enough of this primitive
        while inventory[prim_kind] < needed_cnt:
            # locate all cells that currently contain the primitive
            prim_cells = np.argwhere(grid[:, :, prim_kind] > 0)
            if prim_cells.size == 0:
                raise RuntimeError(f"Primitive kind {prim_kind} not present on the map.")
            # pick the closest primitive (Manhattan distance)
            dists = np.abs(prim_cells[:, 0] - pos[0]) + np.abs(prim_cells[:, 1] - pos[1])
            target_idx = int(np.argmin(dists))
            target_cell = tuple(prim_cells[target_idx])

            # we need to move to a *adjacent* cell (3×3 neighbourhood)
            # compute all free cells that are adjacent to the target
            adj_candidates = []
            tx, ty = target_cell
            for dx in (-1, 0, 1):
                for dy in (-1, 0, 1):
                    if dx == 0 and dy == 0:
                        continue
                    ax, ay = tx + dx, ty + dy
                    if 0 <= ax < grid.shape[0] and 0 <= ay < grid.shape[1]:
                        # a cell is walkable if no entity occupies it (sum across kinds == 0)
                        if grid[ax, ay].sum() == 0:
                            adj_candidates.append((ax, ay))
            if not adj_candidates:
                raise RuntimeError("No walkable adjacent cell to the primitive.")

            # choose the adjacent cell with shortest path from current position
            walkable = (grid.sum(axis=2) == 0)  # 2‑D bool array
            path = bfs(pos, set(adj_candidates), walkable)
            if not path:
                raise RuntimeError("Failed to find a path to the primitive.")

            # execute movement actions along the path
            for nxt in path:
                dx, dy = nxt[0] - pos[0], nxt[1] - pos[1]
                dir_action = DELTA2DIR[(dx, dy)]
                actions.append(dir_action)
                # step the environment to keep state consistent
                _, new_state = env.step(dir_action)
                state = env._current_state
                grid = state.grid
                pos = tuple(state.pos)
                direction = state.dir
                inventory = state.inventory.copy()

            # now we are on an adjacent cell; turn to face the primitive
            fx, fy = target_cell[0] - pos[0], target_cell[1] - pos[1]
            wanted_dir = DELTA2DIR[(np.sign(fx), np.sign(fy))]
            # rotate to the desired direction (could be multiple turns, but the
            # simplest way is to set direction directly by issuing moves that
            # result in the same facing direction)
            if direction != wanted_dir:
                # issue a move that does *not* change position but changes facing:
                # we achieve this by moving away and back, but a simpler hack is to
                # just move in the desired direction and then step back.
                actions.append(wanted_dir)          # move towards the primitive
                _, _ = env.step(wanted_dir)
                # move back to original cell
                back_dir = DELTA2DIR[(-np.sign(fx), -np.sign(fy))]
                actions.append(back_dir)
                _, _ = env.step(back_dir)
                # update state after the two moves
                state = env._current_state
                pos = tuple(state.pos)
                direction = state.dir
                inventory = state.inventory.copy()
                # now facing the primitive
                if direction != wanted_dir:
                    # if still mismatched (e.g., because of edge cases), just set it
                    # by issuing a dummy move that doesn't change position
                    pass

            # finally, use the primitive (collect)
            actions.append(4)  # USE action
            reward, _ = env.step(4)
            state = env._current_state
            grid = state.grid
            pos = tuple(state.pos)
            direction = state.dir
            inventory = state.inventory.copy()

    # ----------------------------------------------------------------------
    # Crafting phase – try to craft the goal item
    # ----------------------------------------------------------------------
    # Determine where the required workshop is (if any)
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at", None)

    if workshop_kind is not None:
        # locate any workshop cell of the required kind
        workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
        if workshop_cells.size == 0:
            raise RuntimeError("Required workshop not present on the map.")
        # pick the closest workshop
        dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
        w_idx = int(np.argmin(dists))
        workshop_pos = tuple(workshop_cells[w_idx])
        # move to the workshop (exact cell)
        walkable = (grid.sum(axis=2) == 0) | (np.arange(grid.shape[2]) == workshop_kind)[:, None, None].any(axis=0)
        path = bfs(pos, {workshop_pos}, walkable)
        for nxt in path:
            dx, dy = nxt[0] - pos[0], nxt[1] - pos[1]
            dir_action = DELTA2DIR[(dx, dy)]
            actions.append(dir_action)
            _, _ = env.step(dir_action)
            state = env._current_state
            pos = tuple(state.pos)
            direction = state.dir
            inventory = state.inventory.copy()

    # Repeatedly issue USE until the goal appears in inventory
    # (most recipes craft with a single USE when standing on the workshop)
    max_craft_tries = 10
    for _ in range(max_craft_tries):
        if state.inventory[goal_idx] > 0:
            break
        actions.append(4)  # USE / craft
        _, _ = env.step(4)
        state = env._current_state
        inventory = state.inventory.copy()

    # Return the complete action list
    return actions

