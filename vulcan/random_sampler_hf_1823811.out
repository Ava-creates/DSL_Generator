            locations = find_locations(prim_idx)
            if not locations:
                raise RuntimeError(f"Primitive {idx.get(prim_idx, prim_idx)} not found on map")
            # nearest primitive location (Manhattan distance)
            target = min(locations,
                         key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
            path = bfs(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
            actions.append(4)   # USE to pick up

    # 2) Move to workshop (if required) and craft
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if not wk_locations:
            raise RuntimeError("Required workshop not found on map")
        target = min(wk_locations,
                     key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1]))
