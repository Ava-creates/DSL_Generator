    import numpy as np
    from collections import deque

    # Reset environment and fetch initial objects
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index and primitive requirements
    goal_idx = env.task.goal
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine required workshop (if any)
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    actions = []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) positions where `kind` is present."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Return a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) that moves
        from `start` to `target` while avoiding occupied cells.
        The target cell itself may be occupied (e.g., a primitive to pick up).
        """
        occ = np.any(state.grid > 0, axis=2)          # True where blocked
        width, height = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    # allow stepping onto target even if it is currently occupied
                    if not occ[nx, ny] or (nx, ny) == target:
                        if (nx, ny) not in visited:
                            visited.add((nx, ny))
                            q.append(((nx, ny), path + [act]))
        # No path found – return empty list (caller will stay put)
        return []

    def move_to(target):
        """Move agent from current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # 1. Collect all required primitives
    # ------------------------------------------------------------------
    for kind, count in needed.items():
        for _ in range(count):
            positions = locate(kind)
            if not positions:
                # Primitive missing – abort early
                return actions
            # Choose the nearest occurrence to reduce travel distance
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            move_to(target)
            # Pick up the primitive
            actions.append(4)          # USE
            _, state = state.step(4)

    # ------------------------------------------------------------------
    # 2. Go to workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            move_to(target_ws)
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)
    else:
        # No specific workshop; attempt to craft at current location
        actions.append(4)
        _, state = state.step(4)

    return actions


    import numpy as np
    from collections import deque

    # Reset the environment and obtain the initial state.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Index of the goal item for the current task.
    goal_idx = env.task.goal

    # Primitive requirements for the goal.
    needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # Determine workshop (if any) where the goal must be crafted.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # ----------------------------------------------------------------------
    # Helper utilities.
    # ----------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present in the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """Return a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) that moves from start to target,
        avoiding occupied cells. The target cell may be occupied (contains the item)."""
        occ = np.any(state.grid > 0, axis=2)          # True where blocked
        occ[target] = False                           # allow stepping onto target
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # No path found

    def go_to(target):
        """Move the agent from its current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ----------------------------------------------------------------------
    # Action list that will be returned.
    # ----------------------------------------------------------------------
    actions = []

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ----------------------------------------------------------------------
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Primitive missing – abort early.
                return actions
            # Sort candidates by Manhattan distance to current position.
            positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            # Try each location until a reachable one is found.
            for target in positions:
                if bfs_path(state.pos, target):
                    go_to(target)
                    actions.append(4)          # USE to pick up
                    _, state = state.step(4)
                    break
            else:
                # No reachable instance of this primitive.
                return actions

    # ----------------------------------------------------------------------
    # 2. Go to the appropriate workshop (if any) and craft the goal.
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            ws_positions.sort(key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(ws_positions[0])
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)
    else:
        # No specific workshop – attempt to craft at current location.
        actions.append(4)
        _, state = state.step(4)

    return actions

