    import numpy as np
    from collections import deque

    # Reset the environment and obtain the initial state/world.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Index of the goal item for this task.
    goal_idx = env.task.goal

    # Primitive requirements for the goal (expanded recursively).
    needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # Determine required workshop (if any) from the recipe.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    if "_at" in recipe:
        workshop_name = recipe["_at"]
        workshop_idx = world.cookbook.index[workshop_name]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """
        Bread‑first search returning a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that moves from `start` to `target` while avoiding occupied cells.
        The target cell is treated as traversable even if currently occupied.
        """
        occ = np.any(state.grid > 0, axis=2)          # True where any entity occupies the cell
        occ[target[0], target[1]] = False            # allow stepping onto target
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # no path found

    def go_to(target):
        """Move the agent from its current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build the action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1. Collect all required primitives.
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Required primitive not present; abort early.
                return actions
            # Choose the nearest occurrence (Manhattan distance).
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the item.
            actions.append(4)          # USE
            _, state = state.step(4)

    # 2. Go to the workshop (if required) and craft the goal item.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)

    # Return the compiled list of actions.
    return actions


