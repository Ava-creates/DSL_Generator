    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    goal_idx = env.task.goal

    # Primitive counts required (including transitive) for the goal item
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the final crafting must occur at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: Manhattan move sequence (DOWN=0, UP=1, LEFT=2, RIGHT=3)
    # ------------------------------------------------------------------
    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # Keep track of cells already harvested so we don't try to pick the same item twice
    harvested = {}

    # ------------------------------------------------------------------
    # Helper: locate nearest cell that still contains at least one `kind`
    # ------------------------------------------------------------------
    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        return candidates[int(np.argmin(dists))]

    # ------------------------------------------------------------------
    # Collect all required primitive items
    # ------------------------------------------------------------------
    for kind, cnt in required.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                # Primitive not available (or already harvested); skip
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up the primitive
            harvested[kind].add(target)     # mark this cell as consumed

    # ------------------------------------------------------------------
    # Move to the required workshop (if any) and craft the final item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)

    # Final USE triggers crafting of the goal item
    actions.append(4)

    return actions


    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    goal_idx = env.task.goal

    # ----------------------------------------------------------------------
    # Recursively count all items (primitive and intermediate) required for goal
    # ----------------------------------------------------------------------
    def _accumulate(item: int, mult: int, counts: dict):
        counts[item] = counts.get(item, 0) + mult
        recipe = world.cookbook.recipes.get(item)
        if recipe:
            for ing, cnt in recipe.items():
                if ing == "_at":
                    continue
                _accumulate(ing, mult * cnt, counts)

    total_counts: dict[int, int] = {}
    _accumulate(goal_idx, 1, total_counts)

    primitive_set = world.cookbook.primitives
    primitive_reqs = {k: v for k, v in total_counts.items() if k in primitive_set}
    craft_reqs = {k: v for k, v in total_counts.items() if k not in primitive_set}

    # ----------------------------------------------------------------------
    # Determine a post‑order crafting sequence (dependencies before dependents)
    # ----------------------------------------------------------------------
    order: list[int] = []
    visited: set[int] = set()

    def _dfs(item: int):
        if item in visited or item in primitive_set:
            return
        visited.add(item)
        recipe = world.cookbook.recipes.get(item, {})
        for ing, cnt in recipe.items():
            if ing == "_at":
                continue
            _dfs(ing)
        order.append(item)

    _dfs(goal_idx)

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ----------------------------------------------------------------------
    # Helper: Manhattan moves (DOWN=0, UP=1, LEFT=2, RIGHT=3)
    # ----------------------------------------------------------------------
    def _moves_to(start: tuple[int, int], target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:
        x, y = start
        tx, ty = target
        seq: list[int] = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # ----------------------------------------------------------------------
    # Helper: nearest cell containing a given kind (ignores already harvested primitives)
    # ----------------------------------------------------------------------
    harvested: dict[int, set[tuple[int, int]]] = {}

    def _nearest_cell(kind: int, from_pos: tuple[int, int]) -> tuple[int, int] | None:
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        used = harvested.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in used]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        return candidates[int(np.argmin(dists))]

    # ----------------------------------------------------------------------
    # Collect required primitive resources
    # ----------------------------------------------------------------------
    for kind, cnt in primitive_reqs.items():
        harvested.setdefault(kind, set())
        for _ in range(cnt):
            target = _nearest_cell(kind, cur_pos)
            if target is None:
                continue
            move_seq, cur_pos = _moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to pick up primitive
            harvested[kind].add(target)

    # ----------------------------------------------------------------------
    # Perform crafting steps in post‑order
    # ----------------------------------------------------------------------
    for item in order:
        needed = craft_reqs.get(item, 0)
        if needed == 0:
            continue
        recipe = world.cookbook.recipes.get(item, {})
        wk = recipe.get("_at")
        if wk is None:
            # No specific workshop; just USE the required number of times
            actions.extend([4] * needed)
            continue
        wk_idx = wk if isinstance(wk, int) else world.cookbook.index[wk]
        for _ in range(needed):
            target = _nearest_cell(wk_idx, cur_pos)
            if target is not None:
                move_seq, cur_pos = _moves_to(cur_pos, target)
                actions.extend(move_seq)
            actions.append(4)               # USE to craft the item

    return actions

