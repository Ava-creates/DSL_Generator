    """
    Generate a sequence of actions that makes an ``arrow`` in the given CraftLab
    environment.  The routine works by:
      1. Determining the primitive resources needed for the arrow.
      2. Repeatedly moving to the closest instance of each required primitive,
         picking it up with the ``USE`` action.
      3. Moving to the appropriate workshop and crafting the arrow there.

    The function updates a local copy of the state (position, inventory,
    grid) so that subsequent planning steps see the effect of previous moves.
    If any required object (primitive or workshop) cannot be found or a path
    cannot be computed, the actions accumulated up to that point are returned.

    Parameters
    ----------
    env : CraftLab
        The environment instance (already imported from the Craft library).

    Returns
    -------
    List[int]
        A list of action indices (as defined by ``env.action_specs()``) that,
        when executed sequentially, will produce an ``arrow`` in the agent's
        inventory.
    """
    # ----------------------------------------------------------------------
    # Initialisation
    # ----------------------------------------------------------------------
    env.reset()
    state = env._current_state          # CraftState
    world = env.scenario.world          # CraftWorld
    cookbook = world.cookbook           # Cookbook
    index = cookbook.index              # name ↔ integer id mapping

    # Resolve action indices from the environment spec.
    act_map = env.action_specs()
    DOWN = act_map["DOWN"]
    UP = act_map["UP"]
    LEFT = act_map["LEFT"]
    RIGHT = act_map["RIGHT"]
    USE = act_map["USE"]

    # ----------------------------------------------------------------------
    # Identify the goal (arrow) and its primitive requirements.
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []                       # Arrow not defined in this world.

    goal_idx = index[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                     # Accumulated action sequence.

    # ----------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions from start to target.
    # Cells occupied by any entity are treated as obstacles, except the
    # target cell itself (which may be occupied by the primitive or workshop).
    # ----------------------------------------------------------------------
    from collections import deque
    import numpy as np

    h, w = state.grid.shape[:2]
    move_defs = [
        (DOWN, (1, 0)),
        (UP, (-1, 0)),
        (LEFT, (0, -1)),
        (RIGHT, (0, 1)),
    ]

    def bfs_path(start, target):
        """Return a list of move actions to go from start to target."""
        if start == target:
            return []

        q = deque([start])
        visited = {start}
        parent = {}

        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in move_defs:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)

                # Disallow stepping on occupied cells unless it's the target.
                if nxt != target and state.grid[nr, nc].any():
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)

        # If target wasn't reached, return empty list.
        if target not in parent and start != target:
            return []

        # Reconstruct path.
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ----------------------------------------------------------------------
    # Phase 1: Collect each primitive the required number of times.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate all cells currently holding this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive unavailable – abort early.
                return actions

            # Choose the nearest primitive cell (Manhattan distance).
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            tr, tc = prim_cells[dists.argmin()]

            # Move to the primitive cell.
            move_seq = bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)          # update simulated position

            # Pick it up.
            actions.append(USE)

            # Update simulated state: inventory gains one, grid cell cleared.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ----------------------------------------------------------------------
    # Phase 2: Go to the workshop for the arrow and craft it.
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # No workshop information.

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # Workshop not present.

    # Choose the nearest workshop cell.
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]

    # Move to the workshop.
    move_seq = bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions

