    required = world.cookbook.primitives_for(goal_idx)

    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions = []
    cur_pos = tuple(state.pos)

    def moves_to(start, target):
        x, y = start
        tx, ty = target
        seq = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    used = {}

    def nearest_cell(kind, from_pos):
        cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        taken = used.get(kind, set())
        candidates = [tuple(c) for c in cells if tuple(c) not in taken]
        if not candidates:
            return None
        dists = [abs(c[0] - from_pos[0]) + abs(c[1] - from_pos[1]) for c in candidates]
        idx = int(np.argmin(dists))
        return candidates[idx]

    for kind, cnt in required.items():
        used.setdefault(kind, set())
        for _ in range(cnt):
            target = nearest_cell(kind, cur_pos)
            if target is None:
                continue
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)   # USE to pick up primitive
            used[kind].add(target)

    if workshop_kind is not None:
        target = nearest_cell(workshop_kind, cur_pos)
        if target is not None:
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)

    actions.append(4)   # final USE to craft the arrow
    return actions


    env.reset()
    world = env.world
    scenario = env.scenario
    state = env._current_state

    # Goal we need to craft (arrow)
    goal_idx = env.task.goal

    # All primitive resources (including transitive) required for the goal
    required = world.cookbook.primitives_for(goal_idx)

    # Determine if the final crafting must happen at a specific workshop
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else world.cookbook.index[wk]

    actions: list[int] = []
    cur_pos = tuple(state.pos)

    # ------------------------------------------------------------------
    # Helper: generate Manhattan move sequence (action indices)
    #   Mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    # ------------------------------------------------------------------
    def moves_to(start: tuple[int, int], target: tuple[int, int]) -> tuple[list[int], tuple[int, int]]:
        x, y = start
        tx, ty = target
        seq: list[int] = []
        while x < tx:
            seq.append(3)   # RIGHT
            x += 1
        while x > tx:
            seq.append(2)   # LEFT
            x -= 1
        while y < ty:
            seq.append(0)   # DOWN
            y += 1
        while y > ty:
            seq.append(1)   # UP
            y -= 1
        return seq, (x, y)

    # Keep track of cells already harvested so we don't try to pick the same item twice
    harvested: set[tuple[int, int]] = set()

    # ------------------------------------------------------------------
    # Collect all required primitive items
    # ------------------------------------------------------------------
    for kind, count in required.items():
        for _ in range(count):
            # Locate all cells containing this primitive kind
            cells = np.argwhere(scenario.init_grid[:, :, kind] > 0)
            if cells.size == 0:
                continue  # none left on the map

            # Filter out cells already used
            candidates = [tuple(c) for c in cells if tuple(c) not in harvested]
            if not candidates:
                continue

            # Choose the nearest candidate (Manhattan distance)
            dists = [abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]) for c in candidates]
            target = candidates[int(np.argmin(dists))]

            # Move to the primitive and pick it up
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to collect
            harvested.add(target)           # mark as taken

    # ------------------------------------------------------------------
    # Move to the workshop (if required) and craft the final item
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        cells = np.argwhere(scenario.init_grid[:, :, workshop_kind] > 0)
        if cells.size > 0:
            candidates = [tuple(c) for c in cells]
            dists = [abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]) for c in candidates]
            target = candidates[int(np.argmin(dists))]
            move_seq, cur_pos = moves_to(cur_pos, target)
            actions.extend(move_seq)
            actions.append(4)               # USE to craft at the workshop
    else:
        # No specific workshop: just attempt a USE at the current location
        actions.append(4)

    return actions

