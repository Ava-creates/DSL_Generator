    # Collect all primitive resources required for the arrow
    # ------------------------------------------------------------------
    needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    for kind_idx, cnt in needed_prims.items():
        for _ in range(cnt):
            src = find_nearest(kind_idx)
            if src is None:
                raise RuntimeError(f"Required primitive {kind_idx} not present on map")
            adj = adjacent_free(src)
            if adj is None:
                raise RuntimeError(f"No free cell adjacent to primitive {kind_idx}")
            move_to(adj)
            actions.append(ACT_USE)
            env.step(ACT_USE)
            state = env._current_state

