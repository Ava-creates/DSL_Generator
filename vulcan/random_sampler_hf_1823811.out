    # Reset environment and obtain current state/world
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # Goal definition (hard‑coded for arrow)
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for one arrow
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Determine required workshop (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # Working copies of grid and inventory for planning
    grid = state.grid.copy()
    inv = state.inventory.copy()
    cur = state.pos  # current simulated position

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def find_positions(kind):
        """Return list of (x, y) where `kind` is present on the planning grid."""
        occ = np.where(grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal):
        """Shortest path avoiding non‑grabbable cells; returns list of cells."""
        if start == goal:
            return [start]
        W, H = grid.shape[:2]

        # blocked cells = any non‑grabbable entity
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        from collections import deque
        q = deque([start])
        prev = {start: None}
        while q:
            curp = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = curp[0] + dx, curp[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    if (nx, ny) not in prev:
                        prev[(nx, ny)] = curp
                        if (nx, ny) == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append((nx, ny))
        # No path found – stay in place
        return [start]

    def move_to(target):
        """Generate actions to move from current `cur` to `target`."""
        nonlocal cur
        actions_local = []
        path = bfs(cur, target)
        for step in path[1:]:
            dx = step[0] - cur[0]
            dy = step[1] - cur[1]
            if dx == 1:
                act = 3   # RIGHT
            elif dx == -1:
                act = 2   # LEFT
            elif dy == 1:
                act = 0   # DOWN
            elif dy == -1:
                act = 1   # UP
            else:
                raise AssertionError("Non‑adjacent move generated")
            actions_local.append(act)
            cur = step
        return actions_local

    # ------------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------------
    actions = []

    # 1) Collect all required primitives
    for prim_idx, needed in primitive_counts.items():
        while inv[prim_idx] < needed:
            positions = find_positions(prim_idx)
            if not positions:
                # No more of this primitive on the map – give up collecting
                break
            # Choose nearest instance (Manhattan distance heuristic)
            target = min(
                positions,
                key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1])
            )
            actions.extend(move_to(target))
            actions.append(4)                     # USE to pick up
            inv[prim_idx] += 1
            grid[target[0], target[1], prim_idx] = 0   # remove from planning grid

    # 2) Go to the workshop (if required) and craft
    if workshop_kind is not None:
        wk_positions = find_positions(workshop_kind)
        if wk_positions:
            target = min(
                wk_positions,
                key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1])
            )
            actions.extend(move_to(target))
    # Craft (or craft at current location if no workshop needed)
    actions.append(4)   # USE

    return actions


    # Reset environment and get current state/world information
    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------
    # Identify goal and its recipe
    # ------------------------------------------------------------
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # Primitive requirements for one instance of the goal
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # Determine required workshop (if any)
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------
    def find_locations(kind):
        """Return list of (x, y) coordinates where `kind` is present."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs_path(start, goal):
        """Shortest path from `start` to `goal` avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        W, H = state.grid.shape[:2]

        # Build a set of blocked cells (non‑grabbable entities)
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        queue = collections.deque([start])
        prev = {start: None}
        while queue:
            cur = queue.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # Reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        queue.append(nxt)
        # No path found – stay in place
        return [start]

    def move_action(cur, nxt):
        """Translate a step from `cur` to adjacent `nxt` into an action index."""
        dx = nxt[0] - cur[0]
        dy = nxt[1] - cur[1]
        if dx == 1:
            return 3   # RIGHT
        if dx == -1:
            return 2   # LEFT
        if dy == 1:
            return 0   # DOWN
        if dy == -1:
            return 1   # UP
        raise AssertionError("Non‑adjacent movement requested")

    # ------------------------------------------------------------
    # Build the action sequence
    # ------------------------------------------------------------
    actions = []
    cur_pos = state.pos

    # ------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            # Locate remaining instances of the primitive on the grid
            locations = find_locations(prim_idx)
            if not locations:
                # No more copies available – abort collection for this primitive
                break

            # Choose the nearest instance (Manhattan distance heuristic)
            target = min(
                locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )

            # Compute path and translate into actions
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step

            # Pick up the primitive
            actions.append(4)   # USE
            # Update the planning snapshot of inventory/grid
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft
    # ------------------------------------------------------------
    if workshop_kind is not None:
        wk_locations = find_locations(workshop_kind)
        if wk_locations:
            # Choose nearest workshop
            target = min(
                wk_locations,
                key=lambda loc: abs(loc[0] - cur_pos[0]) + abs(loc[1] - cur_pos[1])
            )
            path = bfs_path(cur_pos, target)
            for step in path[1:]:
                actions.append(move_action(cur_pos, step))
                cur_pos = step
    # Craft the arrow (USE at current location)
    actions.append(4)   # USE

    return actions

