    # Helper: BFS to a cell adjacent to a target kind
    from collections import deque

    def _bfs_to_adjacent(start_pos, target_kind, grid):
        """Return a list of action indices that moves the agent from start_pos to a cell
        adjacent (4‑connected) to any cell containing target_kind.  Returns None if no path."""
        W, H, _ = grid.shape
        # occupancy mask: any non‑zero entry blocks movement
        blocked = np.any(grid, axis=2)

        # movement vectors matching action indices: 0‑DOWN, 1‑UP, 2‑LEFT, 3‑RIGHT
        dx = [0, 0, -1, 1]
        dy = [1, -1, 0, 0]

        def in_bounds(x, y):
            return 0 <= x < W and 0 <= y < H

        # pre‑compute cells that contain the target kind
        target_cells = set(zip(*np.where(grid[:, :, target_kind] > 0)))

        # BFS over positions
        visited = set()
        q = deque()
        q.append((start_pos, []))
        visited.add(start_pos)

        while q:
            (x, y), path = q.popleft()
            # check adjacency to any target cell
            for nx, ny in [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]:
                if (nx, ny) in target_cells:
                    return path  # already adjacent, no more moves needed
            # explore neighbours
            for a in range(4):
                nx, ny = x + dx[a], y + dy[a]
                if not in_bounds(nx, ny):
                    continue
                if blocked[nx, ny]:
                    continue
                if (nx, ny) in visited:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [a]))
        return None

    # Reset environment and obtain the underlying state
    try:
        env.reset()
    except Exception:
        pass
    state = env._current_state  # type: CraftState

    # Identify goal index
    goal_idx = getattr(env, "task", None)
    if goal_idx is not None and hasattr(goal_idx, "goal"):
        goal = goal_idx.goal
    else:
        # fallback: try to read from scenario (may be stored as an attribute)
        goal = getattr(env, "goal", None)
        if goal is None:
            raise RuntimeError("Cannot determine goal index from environment.")

    # Shortcuts to world and cookbook
    world = env.world
    cookbook = world.cookbook

    # Determine primitive requirements for the goal
    required_prims = cookbook.primitives_for(goal)  # dict {kind_idx: count}

    actions = []

    # ----------------------------------------------------------------------
    # 1. Gather required primitive items
    # ----------------------------------------------------------------------
    for prim_kind, needed in list(required_prims.items()):
        while needed > 0:
            # Find path to a cell adjacent to a cell containing this primitive
            path = _bfs_to_adjacent(state.pos, prim_kind, state.grid)
            if path is None:
                raise RuntimeError(f"Cannot reach primitive kind {prim_kind}")
            # Execute movement actions
            for a in path:
                reward, state = state.step(a)
                actions.append(a)
            # Use action to pick up the primitive
            reward, state = state.step(4)   # 4 == USE
            actions.append(4)
            needed -= 1

    # ----------------------------------------------------------------------
    # 2. Craft the goal at its workshop (if a workshop is required)
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal, {})
    workshop_kind = recipe.get("_at", None)

    if workshop_kind is not None:
        # Move adjacent to the required workshop and USE to craft
        path = _bfs_to_adjacent(state.pos, workshop_kind, state.grid)
        if path is None:
            raise RuntimeError(f"Cannot reach workshop kind {workshop_kind}")
        for a in path:
            reward, state = state.step(a)
            actions.append(a)
        reward, state = state.step(4)   # USE to craft
        actions.append(4)
    else:
        # Goal may be a primitive itself; if not yet in inventory, collect it
        if state.inventory[goal] == 0:
            path = _bfs_to_adjacent(state.pos, goal, state.grid)
            if path is None:
                raise RuntimeError(f"Cannot reach goal primitive {goal}")
            for a in path:
                reward, state = state.step(a)
                actions.append(a)
            reward, state = state.step(4)
            actions.append(4)

    # Return the compiled action list
    return actions


    import numpy as np
    from collections import deque

    # Helper: map movement delta to action index (consistent with CraftLab spec)
    _DIR2ACT = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }

    def _bfs(start, target, blocked):
        """
        Simple BFS that returns a list of actions to move from start to target.
        start, target are (x, y) tuples.
        blocked is a 2‑D bool array where True means the cell cannot be entered.
        """
        W, H = blocked.shape
        q = deque()
        q.append((start, []))
        seen = {start}
        while q:
            (x, y), path = q.popleft()
            if (x, y) == target:
                return path
            for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:
                nx, ny = x + dx, y + dy
                if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny]:
                    if (nx, ny) not in seen:
                        seen.add((nx, ny))
                        act = _DIR2ACT[(dx, dy)]
                        q.append(((nx, ny), path + [act]))
        # No path found
        return []

    # ----------------------------------------------------------------------
    # Begin main routine
    # ----------------------------------------------------------------------
    # Reset environment (ignore if not present)
    try:
        obs = env.reset()
    except Exception:
        obs = env.observations() if hasattr(env, "observations") else None
        if obs is None:
            raise RuntimeError("Unable to obtain initial observation from the environment.")

    # Determine goal index (the item we have to produce)
    try:
        goal_idx = env.task.goal
    except Exception:
        # fallback: try to read from observation dict
        goal_name = obs.get("task_name", "")
        # assume goal name is like "make[arrow]" – extract inner part
        import re
        m = re.search(r"\[(\w+)\]", goal_name)
        if not m:
            raise RuntimeError("Cannot infer goal from environment.")
        item_str = m.group(1)
        goal_idx = env.world.cookbook.index.index(item_str)

    # Access the cookbook and recipes
    cookbook = env.world.cookbook
    # Primitive requirements for one unit of the goal
    prim_req = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}

    # Initial grid (allocentric one‑hot view)
    # The observation dict contains the full grid under features_dict['features_global']
    if isinstance(obs, dict) and "features_dict" in obs:
        grid = obs["features_dict"]["features_global"]
    else:
        # Direct access via the hidden state (works for standard CraftLab)
        grid = env._current_state.grid
    # grid shape: (W, H, n_kinds)
    W, H, _ = grid.shape

    # Helper to locate cells containing a particular kind
    def _find_cells(kind_idx):
        mask = grid[:, :, kind_idx] > 0
        xs, ys = np.where(mask)
        return list(zip(xs.tolist(), ys.tolist()))

    # Current agent position (from hidden state)
    try:
        cur_pos = tuple(env._current_state.pos)
    except Exception:
        # fallback: try to infer from observation (center of egocentric view)
        # This is a rough guess; we assume the agent starts near the middle.
        cur_pos = (W // 2, H // 2)

    actions = []

    # ------------------------------------------------------------------
    # Collect required primitives
    # ------------------------------------------------------------------
    for prim_idx, needed in prim_req.items():
        # locate all sources of this primitive
        sources = _find_cells(prim_idx)
        if not sources:
            raise RuntimeError(f"Primitive {prim_idx} not found on the map.")
        src_iter = iter(sources)
        for _ in range(needed):
            # pick the next not‑yet‑used source (simple greedy)
            try:
                target = next(src_iter)
            except StopIteration:
                # restart iterator if we ran out of distinct cells
                src_iter = iter(sources)
                target = next(src_iter)

            # Build a blocked map: any non‑empty cell is blocked except the target cell
            occupied = grid.sum(axis=2) > 0
            occupied[target] = False  # allow stepping onto the primitive cell
            # also allow current position (already free)
            occupied[cur_pos] = False

            # Compute path
            path = _bfs(cur_pos, target, occupied)
            actions.extend(path)
            # simulate movement to update cur_pos
            for act in path:
                if act == 0:   # DOWN
                    cur_pos = (cur_pos[0], cur_pos[1] + 1)
                elif act == 1: # UP
                    cur_pos = (cur_pos[0], cur_pos[1] - 1)
                elif act == 2: # LEFT
                    cur_pos = (cur_pos[0] - 1, cur_pos[1])
                elif act == 3: # RIGHT
                    cur_pos = (cur_pos[0] + 1, cur_pos[1])

            # Use action to pick up the primitive
            actions.append(4)  # USE
            # Update internal grid representation to reflect collection
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # Move to the workshop and craft the goal
    # ------------------------------------------------------------------
    # Find workshop kind from the recipe entry ("_at")
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is None:
        raise RuntimeError("Goal does not specify a workshop location.")

    workshop_cells = _find_cells(workshop_kind)
    if not workshop_cells:
        raise RuntimeError("Workshop cell not found on the map.")
    # Choose the first workshop cell
    workshop_target = workshop_cells[0]

    # Build blocked map again (now primitives have been removed)
    occupied = grid.sum(axis=2) > 0
    occupied[workshop_target] = False  # we can step onto the workshop cell
    occupied[cur_pos] = False

    path = _bfs(cur_pos, workshop_target, occupied)
    actions.extend(path)
    for act in path:
        if act == 0:
            cur_pos = (cur_pos[0], cur_pos[1] + 1)
        elif act == 1:
            cur_pos = (cur_pos[0], cur_pos[1] - 1)
        elif act == 2:
            cur_pos = (cur_pos[0] - 1, cur_pos[1])
        elif act == 3:
            cur_pos = (cur_pos[0] + 1, cur_pos[1])

    # Final USE to craft the arrow
    actions.append(4)  # USE

    # Return the compiled action sequence
    return actions

