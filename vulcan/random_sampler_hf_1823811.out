    import collections
    import numpy as np

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions leading to a cell
    # that contains `target_kind`. The agent may step onto empty cells or
    # directly onto the target cell; any other occupied cell is treated as
    # an obstacle.
    # ------------------------------------------------------------------
    def find_path(cur_state, target_kind):
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos

        # Already standing on a target cell
        if grid[start[0], start[1], target_kind] > 0:
            return []

        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue

                cell = grid[nx, ny, :]
                occupied = np.any(cell > 0)

                # Allow movement onto empty cells or the target cell itself
                if occupied and cell[target_kind] == 0:
                    continue

                # If the neighbour already holds the target, we can stop here
                if cell[target_kind] > 0:
                    return path + [act]

                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # No reachable target (should not happen in a valid scenario)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    required = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    for kind_idx, count in required.items():
        for _ in range(count):
            path = find_path(state, kind_idx)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # Pick up the primitive using the USE action
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions


    env.reset()
    state = env._current_state          # CraftState
    world = env.world                    # CraftWorld

    # Index of the item we need to craft
    goal_idx = env.task.goal

    # Action indices according to the environment specification
    act_map = env.action_specs()
    ACTION_DOWN = act_map['DOWN']
    ACTION_UP = act_map['UP']
    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']

    # (dx, dy, action) for the four movement directions
    move_dirs = [
        (1, 0, ACTION_DOWN),   # down
        (-1, 0, ACTION_UP),    # up
        (0, -1, ACTION_LEFT),  # left
        (0, 1, ACTION_RIGHT),  # right
    ]

    actions = []

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of movement actions leading to a cell
    # that contains `target_kind`. The agent may step onto empty cells or
    # directly onto the target cell; any other occupied cell is treated as
    # an obstacle.
    # ------------------------------------------------------------------
    def find_path(cur_state, target_kind):
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos

        # Already standing on the target
        if grid[start[0], start[1], target_kind] > 0:
            return []

        from collections import deque
        visited = {start}
        q = deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue

                cell = grid[nx, ny, :]
                occupied = np.any(cell > 0)

                # Can move if the cell is empty or contains the target kind
                if occupied and cell[target_kind] == 0:
                    continue

                if cell[target_kind] > 0:
                    return path + [act]

                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))

        # No reachable target (should not happen in a valid scenario)
        return []

    # ------------------------------------------------------------------
    # 1) Collect all required primitive items.
    # ------------------------------------------------------------------
    required = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
    for kind_idx, count in required.items():
        for _ in range(count):
            path = find_path(state, kind_idx)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # Pick up the primitive using the USE action
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        # Use the workshop to craft the item
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    return actions

