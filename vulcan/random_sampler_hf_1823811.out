        return []                       # arrow not defined in this world
    goal_idx = index[goal_name]
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []                         # will accumulate the plan

    # ------------------------------------------------------------------
    # Helper: BFS returning a list of movement actions from start to target.
    # All cells occupied by any entity are treated as obstacles, except the
    # target cell itself (which may contain a primitive or a workshop).
    # ------------------------------------------------------------------
    from collections import deque

    def _bfs_path(start, target):
        """Return list of actions (DOWN/UP/LEFT/RIGHT) to reach target."""
        if start == target:
            return []
        h, w = state.grid.shape[:2]
        moves = [(DOWN, (1, 0)),
                 (UP, (-1, 0)),
                 (LEFT, (0, -1)),
                 (RIGHT, (0, 1))]
        q = deque([start])
        visited = {start}
        parent = {}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            for act, (dr, dc) in moves:
                nr, nc = cur[0] + dr, cur[1] + dc
                if not (0 <= nr < h and 0 <= nc < w):
                    continue
                nxt = (nr, nc)
                # Disallow stepping on occupied cells except the target.
                if nxt != target and state.grid[nr, nc, :].sum() != 0:
                    continue
                if nxt in visited:
                    continue
                visited.add(nxt)
                parent[nxt] = (cur, act)
                q.append(nxt)
        if target not in parent and start != target:
            return []          # no path found
        # Reconstruct path
        path = []
        cur = target
        while cur != start:
            prev, act = parent[cur]
            path.append(act)
            cur = prev
        path.reverse()
        return path

    # ------------------------------------------------------------------
    # 1. Collect each required primitive (respecting multiplicities).
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Find any cell currently holding this primitive.
            prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # Primitive not present – abort early.
                return actions
            # Choose the nearest cell (Manhattan distance).
            dists = np.abs(prim_cells - np.array(state.pos)).sum(axis=1)
            tr, tc = prim_cells[dists.argmin()]

            # Move to the primitive.
            move_seq = _bfs_path(state.pos, (tr, tc))
            actions.extend(move_seq)
            state.pos = (tr, tc)

            # Pick it up.
            actions.append(USE)

            # Update our internal copy of the state.
            state.inventory[prim_idx] += 1
            state.grid[tr, tc, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop for the arrow and craft it.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions                     # no workshop info

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions                     # workshop not on map

    # Choose nearest workshop cell.
    dists = np.abs(workshop_cells - np.array(state.pos)).sum(axis=1)
    wr, wc = workshop_cells[dists.argmin()]

    # Move to workshop.
    move_seq = _bfs_path(state.pos, (wr, wc))
    actions.extend(move_seq)
    state.pos = (wr, wc)

    # Craft the arrow.
    actions.append(USE)

    return actions

