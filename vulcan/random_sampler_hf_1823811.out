    env.reset()
    state = env._current_state
    world = env.world
    idx = world.cookbook.index

    # target item
    goal_name = "arrow"
    goal_idx = idx[goal_name]

    # primitives needed (expanded)
    primitive_counts = world.cookbook.primitives_for(goal_idx)

    # workshop required for crafting, if any
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = None
    if "_at" in recipe:
        wk = recipe["_at"]
        workshop_kind = wk if isinstance(wk, int) else idx[wk]

    # ------------------------------------------------------------------
    # Helper functions
    # ------------------------------------------------------------------
    def find_positions(kind):
        """Return list of (x, y) where `kind` occurs on the grid."""
        occ = np.where(state.grid[:, :, kind] > 0)
        return list(zip(occ[0].tolist(), occ[1].tolist()))

    def bfs(start, goal):
        """Shortest 4‑connected path avoiding non‑grabbable cells."""
        if start == goal:
            return [start]
        w, h = state.grid.shape[:2]

        # cells occupied by non‑grabbable entities block movement
        blocked = set()
        for ng in world.non_grabbable_indices:
            occ = np.where(state.grid[:, :, ng] > 0)
            blocked.update(zip(occ[0].tolist(), occ[1].tolist()))

        q = collections.deque([start])
        prev = {start: None}
        while q:
            cur = q.popleft()
            for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nx, ny = cur[0] + dx, cur[1] + dy
                if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in blocked:
                    nxt = (nx, ny)
                    if nxt not in prev:
                        prev[nxt] = cur
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(prev[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        # unreachable – stay where we are
        return [start]

    def to_action(cur, nxt):
        """Convert adjacent step to DMLab action index."""
        dx, dy = nxt[0] - cur[0], nxt[1] - cur[1]
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise AssertionError("Requested move is not adjacent")

    # ------------------------------------------------------------------
    # Build action sequence
    # ------------------------------------------------------------------
    actions = []
    cur = state.pos

    # 1) Collect all required primitives
    for prim_idx, needed in primitive_counts.items():
        while state.inventory[prim_idx] < needed:
            candidates = find_positions(prim_idx)
            if not candidates:
                # no more of this primitive on the map
                break
            # choose the nearest instance (Manhattan distance)
            target = min(
                candidates,
                key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1])
            )
            # move to the target
            path = bfs(cur, target)
            for step in path[1:]:
                actions.append(to_action(cur, step))
                cur = step
            # pick up the primitive
            actions.append(4)                      # USE
            state.inventory[prim_idx] += 1
            state.grid[target[0], target[1], prim_idx] = 0

    # 2) Move to workshop (if required) and craft the arrow
    if workshop_kind is not None:
        wk_locs = find_positions(workshop_kind)
        if wk_locs:
            target = min(
                wk_locs,
                key=lambda p: abs(p[0] - cur[0]) + abs(p[1] - cur[1])
            )
            path = bfs(cur, target)
            for step in path[1:]:
                actions.append(to_action(cur, step))
                cur = step

    # final crafting action
    actions.append(4)  # USE

    return actions

