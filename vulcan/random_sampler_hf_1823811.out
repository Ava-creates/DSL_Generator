    # Reset environment to start fresh and obtain task information
    _ = env.reset()
    act_map = env.action_specs()                     # mapping from action name to int code

    # Directions and their deltas for movement
    moves = [
        ("DOWN", (1, 0)),
        ("UP", (-1, 0)),
        ("RIGHT", (0, 1)),
        ("LEFT", (0, -1)),
    ]
    dir_to_delta = {name: delta for name, delta in moves}

    # --------------------------------------------------------------
    # Helper: BFS that finds a path (as a list of direction names) from
    # start position to any empty cell adjacent to the target cell.
    # --------------------------------------------------------------
    def bfs_to_adjacent(start, target, occupied):
        tr, tc = target
        # All walkable neighbours of the target
        neighbours = [
            (tr + dr, tc + dc)
            for _, (dr, dc) in moves
            if 0 <= tr + dr < occupied.shape[0]
            and 0 <= tc + dc < occupied.shape[1]
            and not occupied[tr + dr, tc + dc]
        ]
        if not neighbours:
            return []  # no reachable adjacent cell

        from collections import deque
        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in neighbours:
                # reconstruct path
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for name, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occupied.shape[0]
                    and 0 <= nc < occupied.shape[1]
                    and not occupied[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # no path found

    # --------------------------------------------------------------
    # Helper: execute a list of direction names, updating the running
    # position and appending the corresponding action codes.
    # --------------------------------------------------------------
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # --------------------------------------------------------------
    # Gather scenario / world information
    # --------------------------------------------------------------
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal                         # integer index of the desired item

    # Primitive requirements (flattened) and workshop location (if any)
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")

    # Working copies of the grid and occupancy mask
    grid = scenario.init_grid.copy()
    occupied = grid.sum(axis=2) > 0                 # True where any entity occupies the cell

    # Current agent state
    cur_pos = scenario.init_pos                     # (row, col)

    # Action list to be returned
    actions = []

    # --------------------------------------------------------------
    # Collect each required primitive the required number of times
    # --------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Find all remaining cells containing this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more of this primitive left; abort early
                break

            # Choose the closest instance (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to an empty neighbour of the target
            path = bfs_to_adjacent(cur_pos, target, occupied)
            execute_path(path)

            # Pick up the primitive
            actions.append(act_map["USE"])

            # Update grid/occupancy: primitive disappears after pickup
            r, c = target
            grid[r, c, :] = 0
            occupied[r, c] = False

    # --------------------------------------------------------------
    # Move to the workshop (if required) and craft the goal item
    # --------------------------------------------------------------
    if workshop_kind is not None:
        # Locate a workshop cell of the appropriate kind
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            # If the workshop was removed during collection, fall back to original grid
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0))
            )
        if workshop_cells:
            target = workshop_cells[0]  # any workshop works
            path = bfs_to_adjacent(cur_pos, target, occupied)
            execute_path(path)
            actions.append(act_map["USE"])

    return actions


    # Reset environment to obtain fresh scenario/state
    _ = env.reset()

    # Mapping from action names to integer codes used by the environment
    act_map = env.action_specs()

    # Define movement directions and their deltas
    moves = [
        ("DOWN", (1, 0)),
        ("UP", (-1, 0)),
        ("RIGHT", (0, 1)),
        ("LEFT", (0, -1)),
    ]
    dir_to_delta = {name: delta for name, delta in moves}

    # ------------------------------------------------------------------
    # Helper: breadth‑first search for a path (as a list of action names)
    # that brings the agent to any empty cell adjacent to the target cell.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, target, occupied):
        tr, tc = target
        # Gather empty neighbours of the target that can be stood on
        adjacent = [
            (tr + dr, tc + dc)
            for _, (dr, dc) in moves
            if 0 <= tr + dr < occupied.shape[0]
            and 0 <= tc + dc < occupied.shape[1]
            and not occupied[tr + dr, tc + dc]
        ]
        if not adjacent:
            return []  # No reachable neighbour

        from collections import deque

        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in adjacent:
                # Reconstruct the path of action names
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for name, (dr, dc) in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occupied.shape[0]
                    and 0 <= nc < occupied.shape[1]
                    and not occupied[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # No path found

    # ------------------------------------------------------------------
    # Shortcut to execute a list of direction names, updating position.
    # ------------------------------------------------------------------
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Gather task‑specific information from the environment
    # ------------------------------------------------------------------
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal  # integer index of the desired item

    # Determine which primitive resources are needed for the goal
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")

    # Working copies of the grid and an occupancy mask (True = blocked)
    grid = scenario.init_grid.copy()
    occupied = grid.sum(axis=2) > 0

    # Current agent state
    cur_pos = scenario.init_pos  # (row, col)

    # List that will accumulate the actions to return
    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive the required number of times
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Find all remaining cells that contain this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # No more instances left; break early
                break

            # Choose the closest instance (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # Move to an empty neighbour of the target cell
            path = bfs_to_adjacent(cur_pos, target, occupied)
            execute_path(path)

            # Pick up the primitive
            actions.append(act_map["USE"])

            # Update grid/occupancy to reflect the collected primitive
            r, c = target
            grid[r, c, :] = 0
            occupied[r, c] = False

    # ------------------------------------------------------------------
    # If the recipe requires a specific workshop, move there and craft
    # ------------------------------------------------------------------
    if workshop_kind is not None:
        # Locate workshop cells (they are static, so also check original grid)
        workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
        if not workshop_cells:
            workshop_cells = list(
                zip(*np.where(scenario.init_grid[:, :, workshop_kind] > 0))
            )
        if workshop_cells:
            target = workshop_cells[0]  # any workshop will do
            path = bfs_to_adjacent(cur_pos, target, occupied)
            execute_path(path)
            actions.append(act_map["USE"])

    # Return the complete action sequence
    return actions

