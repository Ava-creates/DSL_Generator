    # Helper: breadth‑first search on the current grid.
    from collections import deque

    def bfs(start, goals, grid):
        """Return a list of actions (0‑4) moving from start to any cell in goals."""
        # movement deltas correspond to action indices: 0‑DOWN, 1‑UP, 2‑LEFT, 3‑RIGHT
        deltas = [(0, 1), (0, -1), (-1, 0), (1, 0)]
        visited = {start}
        q = deque([(start, [])])
        while q:
            pos, path = q.popleft()
            if pos in goals:
                return path
            for a, (dx, dy) in enumerate(deltas):
                nx, ny = pos[0] + dx, pos[1] + dy
                if nx < 0 or ny < 0 or nx >= grid.shape[0] or ny >= grid.shape[1]:
                    continue
                # a cell is traversable if it is empty or it is one of the goal cells
                if not grid[nx, ny].any() or (nx, ny) in goals:
                    npos = (nx, ny)
                    if npos not in visited:
                        visited.add(npos)
                        q.append((npos, path + [a]))
        return None

    # ----------------------------------------------------------------------
    # Main planning loop
    # ----------------------------------------------------------------------
    state = env._current_state               # current CraftState
    world = state.world                       # reference to CraftWorld
    cookbook = world.cookbook

    # index of the target item (arrow)
    arrow_idx = cookbook.index.get("arrow")
    if arrow_idx is None:
        # fallback: try capitalised name
        arrow_idx = cookbook.index.get("Arrow")
    if arrow_idx is None:
        return []  # cannot find recipe – nothing to do

    # primitive requirements for a single arrow
    primitive_req = cookbook.primitives_for(arrow_idx)   # {prim_idx: count}
    actions = []

    # repeat until we have at least one arrow in inventory
    while state.inventory[arrow_idx] == 0:
        # ------------------------------------------------------------------
        # Determine which primitives we still need
        # ------------------------------------------------------------------
        missing = {
            p_idx: cnt - state.inventory[p_idx]
            for p_idx, cnt in primitive_req.items()
            if state.inventory[p_idx] < cnt
        }

        if missing:
            # --------------------------------------------------------------
            # Find the nearest cell that contains any missing primitive
            # --------------------------------------------------------------
            target_cells = set()
            for p_idx in missing:
                xs, ys = np.where(state.grid[:, :, p_idx] > 0)
                for x, y in zip(xs, ys):
                    target_cells.add((int(x), int(y)))

            # BFS to the closest such cell
            path = bfs(state.pos, target_cells, state.grid)
            if path is None:
                # no reachable primitive – give up
                break

            # Execute the movement actions
            for a in path:
                actions.append(a)
                _, state = state.step(a)

            # Use action to pick up the primitive (action index 4)
            actions.append(4)
            _, state = state.step(4)
        else:
            # --------------------------------------------------------------
            # All primitives are collected – go to the required workshop
            # --------------------------------------------------------------
            recipe = cookbook.recipes.get(arrow_idx, {})
            workshop_name = recipe.get("_at")
            if not workshop_name:
                break
            workshop_idx = cookbook.index.get(workshop_name)
            if workshop_idx is None:
                break

            xs, ys = np.where(state.grid[:, :, workshop_idx] > 0)
            if len(xs) == 0:
                break
            workshop_pos = (int(xs[0]), int(ys[0]))

            path = bfs(state.pos, {workshop_pos}, state.grid)
            if path is None:
                break

            for a in path:
                actions.append(a)
                _, state = state.step(a)

            # Use action to craft the arrow
            actions.append(4)
            _, state = state.step(4)

    return actions


    # Reset the environment to start a fresh episode.
    # Some environments may require a seed argument; try without and with seed=0.
    try:
        _ = env.reset()
    except Exception:  # pragma: no cover
        _ = env.reset(seed=0)

    # Obtain the list of possible action indices from the environment.
    # `action_specs` returns a dict like {'DOWN': 0, 'UP': 1, ...}.
    action_dict = env.action_specs()
    possible_actions = list(action_dict.values())

    # Determine a reasonable step limit.  Many CraftWorld environments expose
    # `max_steps`; fall back to a default if it is missing.
    max_steps = getattr(env, "max_steps", 500)

    # Record the sequence of actions we issue.
    plan = []

    # Walk the episode, picking random actions until the task is done
    # (or we hit the step limit).  The `step` method returns
    # (reward, done, observation) according to the CraftLab API.
    done = False
    for _ in range(max_steps):
        if done:
            break
        # Sample a random action from the available set.
        act = int(np.random.choice(possible_actions))
        plan.append(act)

        # Execute the action.
        _, done, _ = env.step(act)

        # If the environment reports completion, stop early.
        if done:
            break

    # Return the collected action sequence.
    return plan

