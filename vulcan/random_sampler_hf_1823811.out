        # Move in x direction.
        while cur_pos[0] < tx:
            actions.append(RIGHT)
            cur_pos[0] += 1
        while cur_pos[0] > tx:
            actions.append(LEFT)
            cur_pos[0] -= 1
        # Move in y direction.
        while cur_pos[1] < ty:
            actions.append(DOWN)
            cur_pos[1] += 1
        while cur_pos[1] > ty:
            actions.append(UP)
            cur_pos[1] -= 1
        return actions

    plan = []

    # Collect each required primitive the necessary number of times.
    for kind_idx, needed_count in primitives_needed.items():
        remaining = needed_count
        while remaining > 0:
            # Locate all cells that currently contain this primitive.
            positions = np.argwhere(grid[:, :, kind_idx] > 0)
            if positions.size == 0:
                # No more of this primitive on the map; cannot continue.
                break

            # Choose the nearest primitive (Manhattan distance).
            dists = np.abs(positions[:, 0] - cur_pos[0]) + np.abs(positions[:, 1] - cur_pos[1])
            nearest_idx = int(dists.argmin())
            target = tuple(positions[nearest_idx])

            # Move to the primitive and pick it up.
            plan.extend(move_to(target))
            plan.append(USE)

            # Simulate the pickup: remove the primitive from the planning grid.
            grid[target[0], target[1], kind_idx] = 0
            remaining -= 1

    # After gathering primitives, go to the appropriate workshop (if any) and craft.
    recipe = env.world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get("_at")
    if workshop_kind is not None:
        ws_positions = np.argwhere(grid[:, :, workshop_kind] > 0)
