    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # index of the target item "arrow"
    arrow_idx = world.cookbook.index.index('arrow')
    # primitive requirements for one arrow (primitive index -> count)
    needed = dict(world.cookbook.primitives_for(arrow_idx))

    # mutable copy of the grid to keep track of consumed items
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)  # (row, col)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def occupied_mask(g):
        """Return a 2‑D boolean mask where True means the cell is blocked."""
        return np.any(g > 0, axis=2)

    def a_star(start, goal, occ):
        """A* search on the 2‑D grid avoiding cells where occ is True."""
        if start == goal:
            return [start]
        H, W = occ.shape
        import heapq
        open_set = []
        # heap entries: (f_score, g_score, position, parent)
        start_f = abs(start[0] - goal[0]) + abs(start[1] - goal[1])
        heapq.heappush(open_set, (start_f, 0, start, None))
        came_from = {}
        g_score = {start: 0}
        while open_set:
            _, g, current, _ = heapq.heappop(open_set)
            if current == goal:
                # reconstruct path
                path = [goal]
                while path[-1] != start:
                    path.append(came_from[path[-1]])
                path.reverse()
                return path
            r, c = current
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W and not occ[nr, nc]:
                    neighbor = (nr, nc)
                    tentative_g = g + 1
                    if neighbor not in g_score or tentative_g < g_score[neighbor]:
                        g_score[neighbor] = tentative_g
                        f = tentative_g + abs(nr - goal[0]) + abs(nc - goal[1])
                        heapq.heappush(open_set, (f, tentative_g, neighbor, current))
                        came_from[neighbor] = current
        return None  # no path found

    def path_to_actions(path):
        """Convert a list of positions to a list of movement actions."""
        act_seq = []
        for (r1, c1), (r2, c2) in zip(path, path[1:]):
            dr, dc = r2 - r1, c2 - c1
            if dr == 1:
                act_seq.append(DOWN)
            elif dr == -1:
                act_seq.append(UP)
            elif dc == 1:
                act_seq.append(RIGHT)
            elif dc == -1:
                act_seq.append(LEFT)
        return act_seq

    def nearest_primitive(pos):
        """Find the nearest primitive (by Manhattan distance) that we still need."""
        best_kind = None
        best_cell = None
        best_dist = 10**9
        for kind, cnt in needed.items():
            if cnt <= 0:
                continue
            cells = np.argwhere(grid[:, :, kind] > 0)
            if cells.size == 0:
                continue
            dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
            idx = dists.argmin()
            dist = dists[idx]
            if dist < best_dist:
                best_dist = dist
                best_kind = kind
                best_cell = tuple(cells[idx].tolist())
        if best_kind is None:
            return None, None
        return best_kind, best_cell

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    while any(cnt > 0 for cnt in needed.values()):
        prim_kind, target = nearest_primitive(cur_pos)
        if target is None:
            # No reachable primitive left – abort early
            break
        occ = occupied_mask(grid)
        # allow stepping onto the primitive cell itself
        occ[target] = False
        path = a_star(cur_pos, target, occ)
        if path is None:
            # Primitive unreachable; remove this instance from the grid and try another
            grid[target[0], target[1], prim_kind] = 0
            continue
        actions += path_to_actions(path)
        cur_pos = target
        actions.append(USE)          # pick up the primitive
        # update local view
        grid[target[0], target[1], prim_kind] = 0
        needed[prim_kind] -= 1

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        # locate any workshop cell (there may be several)
        cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if cells.size > 0:
            dists = np.abs(cells[:, 0] - cur_pos[0]) + np.abs(cells[:, 1] - cur_pos[1])
            idx = dists.argmin()
            workshop_pos = tuple(cells[idx].tolist())
            occ = occupied_mask(grid)
            occ[workshop_pos] = False
            path = a_star(cur_pos, workshop_pos, occ)
            if path is not None:
                actions += path_to_actions(path)
                cur_pos = workshop_pos
                actions.append(USE)  # craft at the workshop

    return actions


    # Action identifiers
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    world = env.world
    # Index of the target item "arrow"
    arrow_idx = world.cookbook.index.index('arrow')
    # Primitive requirements for one arrow (primitive index -> count)
    needed = world.cookbook.primitives_for(arrow_idx)

    # Local mutable copy of the grid to keep track of consumed items
    grid = env._current_state.grid.copy()
    cur_pos = tuple(env._current_state.pos)  # (row, col)

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    import collections

    def bfs(start, goal, occupied):
        """Return a list of positions from start to goal avoiding occupied cells."""
        if start == goal:
            return [start]
        H, W = occupied.shape
        q = collections.deque([start])
        visited = {start: None}
        while q:
            r, c = q.popleft()
            for dr, dc in ((1, 0), (-1, 0), (0, -1), (0, 1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W and not occupied[nr, nc]:
                    nxt = (nr, nc)
                    if nxt not in visited:
                        visited[nxt] = (r, c)
                        if nxt == goal:
                            # reconstruct path
                            path = [goal]
                            while path[-1] != start:
                                path.append(visited[path[-1]])
                            path.reverse()
                            return path
                        q.append(nxt)
        return None  # no path found

    def pos_to_actions(path):
        """Convert a list of positions to a list of movement actions."""
        acts = []
        for (r1, c1), (r2, c2) in zip(path, path[1:]):
            dr, dc = r2 - r1, c2 - c1
            if dr == 1:
                acts.append(DOWN)
            elif dr == -1:
                acts.append(UP)
            elif dc == 1:
                acts.append(RIGHT)
            elif dc == -1:
                acts.append(LEFT)
        return acts

    def nearest(pos, kind):
        """Find the nearest cell (Manhattan) that contains the given kind."""
        cells = np.argwhere(grid[:, :, kind] > 0)
        if cells.size == 0:
            return None
        dists = np.abs(cells[:, 0] - pos[0]) + np.abs(cells[:, 1] - pos[1])
        idx = dists.argmin()
        return tuple(cells[idx].tolist())

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, count in needed.items():
        for _ in range(count):
            target = nearest(cur_pos, prim_idx)
            if target is None:
                # Primitive not present – abort early
                return actions
            # Cells occupied by any entity block movement
            occupied = np.any(grid > 0, axis=2)
            # Allow stepping onto the target cell to pick up the item
            occupied[target] = False
            path = bfs(cur_pos, target, occupied)
            if path is None:
                # No reachable path – abort
                return actions
            actions += pos_to_actions(path)
            cur_pos = target
            actions.append(USE)  # pick up the primitive
            # Remove the primitive from our local view
            grid[target[0], target[1], prim_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the workshop (if required) and craft the arrow
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(arrow_idx, {})
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index.index(workshop_name)
        workshop_pos = nearest(cur_pos, workshop_idx)
        if workshop_pos is not None:
            occupied = np.any(grid > 0, axis=2)
            occupied[workshop_pos] = False
            path = bfs(cur_pos, workshop_pos, occupied)
            if path is not None:
                actions += pos_to_actions(path)
                cur_pos = workshop_pos
                actions.append(USE)  # craft at the workshop

    return actions

