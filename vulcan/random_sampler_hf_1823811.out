    # Reset the environment to obtain the initial observation and state.
    env.reset()
    state = env._current_state               # type: CraftState
    world = env.world                         # CraftWorld instance
    cookbook = world.cookbook                 # Cookbook with recipes and index

    # Identify the goal index for the item "arrow".
    goal_idx = cookbook.index["arrow"]

    # Determine which primitive resources are required to craft one arrow.
    # The dict maps primitive kind indices → required count.
    primitives_needed = cookbook.primitives_for(goal_idx)

    # Identify the workshop where the final arrow must be crafted.
    # The recipe dict contains a special key "_at" giving the workshop name.
    final_recipe = cookbook.recipes[goal_idx]
    final_workshop_name = final_recipe["_at"]
    final_workshop_idx = cookbook.index[final_workshop_name]

    actions = []          # list of action integers to be returned

    # Helper to execute an action in the environment and keep the local state up‑to‑date.
    def _do(act: int):
        nonlocal state
        env.step(act)                     # (reward, done, obs) are ignored here
        state = env._current_state

    # Helper to move the agent towards a target cell using Manhattan moves.
    # This simple strategy first moves horizontally, then vertically.
    def _move_to(target):
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:
                _do(3)                      # RIGHT
            elif x > tx:
                _do(2)                      # LEFT
            elif y < ty:
                _do(0)                      # DOWN
            elif y > ty:
                _do(1)                      # UP

    # ----------------------------------------------------------------------
    # 1. Collect all required primitive items.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # Locate any cell that currently contains the required primitive.
            # state.grid is (WIDTH, HEIGHT, n_kinds); a positive value means presence.
            positions = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if positions.size == 0:
                raise RuntimeError("Required primitive not found in the world.")
            # Choose the nearest occurrence (Manhattan distance).
            cur = np.array(state.pos)
            dists = np.abs(positions - cur).sum(axis=1)
            nearest = tuple(positions[dists.argmin()])
            # Move to that cell and collect the item.
            _move_to(nearest)
            actions.append(4)                # USE to pick up the primitive
            _do(4)

    # ----------------------------------------------------------------------
    # 2. Move to the workshop where the final arrow can be crafted.
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(state.grid[:, :, final_workshop_idx] > 0)
    if workshop_cells.size == 0:
        raise RuntimeError("No workshop of the required type found.")
    cur = np.array(state.pos)
    dists = np.abs(workshop_cells - cur).sum(axis=1)
    workshop_target = tuple(workshop_cells[dists.argmin()])
    _move_to(workshop_target)

    # ----------------------------------------------------------------------
    # 3. Craft the arrow (and any intermediate items automatically).
    # ----------------------------------------------------------------------
    actions.append(4)                        # USE at the workshop
    _do(4)

    # Return the complete action sequence.
    return actions

