    ACTION_LEFT = act_map['LEFT']
    ACTION_RIGHT = act_map['RIGHT']
    ACTION_USE = act_map['USE']
    move_dirs = [(1, 0, ACTION_DOWN),
                 (-1, 0, ACTION_UP),
                 (0, -1, ACTION_LEFT),
                 (0, 1, ACTION_RIGHT)]

    import collections
    import numpy as np

    def find_path(cur_state, target_kind):
        """Breadth‑first search returning a list of movement actions that
        brings the agent onto a cell containing `target_kind`.  The search
        may step onto empty cells or directly onto the target cell, but
        avoids other occupied cells."""
        grid = cur_state.grid
        H, W, _ = grid.shape
        start = cur_state.pos
        visited = {start}
        q = collections.deque([(start, [])])

        while q:
            (x, y), path = q.popleft()
            if grid[x, y, target_kind] > 0:
                return path
            for dx, dy, act in move_dirs:
                nx, ny = x + dx, y + dy
                if not (0 <= nx < H and 0 <= ny < W):
                    continue
                if (nx, ny) in visited:
                    continue
                # Allow stepping onto the target cell even if occupied.
                occupied = np.any(grid[nx, ny, :] > 0)
                if occupied and grid[nx, ny, target_kind] == 0:
                    continue
                visited.add((nx, ny))
                q.append(((nx, ny), path + [act]))
        # No reachable cell (should not happen in a valid scenario).
        return []

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect each required primitive the necessary number of times.
    # ------------------------------------------------------------------
    for kind_idx, count in required.items():
        for _ in range(count):
            path = find_path(state, kind_idx)
            for a in path:
                _, state = state.step(a)
                actions.append(a)
            # Pick up the primitive located under the agent.
            _, state = state.step(ACTION_USE)
            actions.append(ACTION_USE)

    # ------------------------------------------------------------------
    # 2) Move to the appropriate workshop (if any) and craft the goal.
    # ------------------------------------------------------------------
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_kind = recipe.get('_at')
    if workshop_kind is not None:
        path = find_path(state, workshop_kind)
        for a in path:
            _, state = state.step(a)
            actions.append(a)
        # Use the workshop to craft the item.
        _, state = state.step(ACTION_USE)
        actions.append(ACTION_USE)

    # Return the complete action sequence required to make the arrow.
    return actions

