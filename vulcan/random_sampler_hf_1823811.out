    actions = []

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) positions where `kind` is present on the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_path(start, target):
        """Breadth‑first search returning a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that moves from `start` to `target` while avoiding blocked cells."""
        occ = np.any(state.grid > 0, axis=2)          # True where any entity occupies the cell
        # Allow stepping onto the target cell even if it currently holds the needed item/workshop
        occ[target[0], target[1]] = False
        w, h = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # no path found

    def go_to(target):
        """Move agent from its current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_path(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Primitive missing; abort early
                return actions
            # Choose the nearest occurrence (Manhattan distance)
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the item
            actions.append(4)          # USE
            _, state = state.step(4)

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if required) and craft the goal item
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target = min(ws_positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)

    return actions

