    import numpy as np
    from collections import deque

    # Reset the environment and fetch the initial state/world.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index for the current task.
    goal_idx = env.task.goal

    # Primitive requirements for the goal (recursively expanded).
    needed = world.cookbook.primitives_for(goal_idx)   # dict {kind_idx: count}

    # Determine workshop (if any) where the goal must be crafted.
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = None
    workshop_name = recipe.get('_at')
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # ----------------------------------------------------------------------
    # Helper utilities.
    # ----------------------------------------------------------------------
    def locate(kind):
        """Return a list of (x, y) positions where `kind` occurs in the grid."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_actions(start, target):
        """
        Breadth‑first search returning a list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT)
        that moves from `start` to `target` while avoiding occupied cells.
        """
        occ = np.any(state.grid > 0, axis=2)          # True where blocked
        width, height = occ.shape
        q = deque()
        q.append((start, []))
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)),
                                  (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < width and 0 <= ny < height:
                    if not occ[nx, ny] and (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [act]))
        # No path found – return empty list.
        return []

    def go_to(target):
        """Move the agent from its current position to `target`, recording actions."""
        nonlocal state
        for act in bfs_actions(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ----------------------------------------------------------------------
    # Action list to be returned.
    # ----------------------------------------------------------------------
    actions = []

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ----------------------------------------------------------------------
    for kind, cnt in needed.items():
        for _ in range(cnt):
            positions = locate(kind)
            if not positions:
                # Primitive missing – abort early.
                return actions
            # Choose the nearest occurrence (Manhattan distance).
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the item.
            actions.append(4)          # USE
            _, state = state.step(4)

    # ----------------------------------------------------------------------
    # 2. Go to the workshop (if required) and craft the goal.
    # ----------------------------------------------------------------------
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)

    # Return the compiled action sequence.
    return actions


    import numpy as np
    from collections import deque

    # Reset environment and get initial state/world.
    env.reset()
    state = env._current_state          # type: CraftState
    world = env.world

    # Goal index for the current task.
    goal_idx = env.task.goal

    # Primitive requirements for the goal.
    needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}

    # Determine workshop index if recipe specifies one.
    workshop_idx = None
    recipe = world.cookbook.recipes.get(goal_idx, {})
    ws_name = recipe.get('_at')
    if ws_name is not None:
        workshop_idx = world.cookbook.index[ws_name]

    # ------------------------------------------------------------------
    # Helper utilities.
    # ------------------------------------------------------------------
    def locate(kind):
        """Return list of (x, y) positions where `kind` is present."""
        inds = np.argwhere(state.grid[:, :, kind] > 0)
        return [tuple(p) for p in inds]

    def bfs_actions(start, target):
        """Return list of actions (0‑DOWN,1‑UP,2‑LEFT,3‑RIGHT) to move from start to target."""
        occ = np.any(state.grid > 0, axis=2)          # blocked cells
        w, h = occ.shape
        q = deque([(start, [])])
        visited = {start}
        while q:
            pos, path = q.popleft()
            if pos == target:
                return path
            x, y = pos
            for act, (dx, dy) in ((0, (0, 1)), (1, (0, -1)), (2, (-1, 0)), (3, (1, 0))):
                nx, ny = x + dx, y + dy
                if 0 <= nx < w and 0 <= ny < h and not occ[nx, ny] and (nx, ny) not in visited:
                    visited.add((nx, ny))
                    q.append(((nx, ny), path + [act]))
        return []  # no path found

    def go_to(target):
        """Move agent to target, recording actions and updating state."""
        nonlocal state
        for act in bfs_actions(state.pos, target):
            actions.append(act)
            _, state = state.step(act)

    # ------------------------------------------------------------------
    # Build action sequence.
    # ------------------------------------------------------------------
    actions = []

    # 1. Collect required primitives.
    for kind, cnt in needed.items():
        for _ in range(cnt):
            # Re‑locate the kind after each pickup because the grid changes.
            positions = locate(kind)
            if not positions:
                # Primitive not found – abort early.
                return actions
            # Choose nearest occurrence (Manhattan distance).
            target = min(positions,
                         key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target)
            # Pick up the item.
            actions.append(4)          # USE
            _, state = state.step(4)

    # 2. If a workshop is required, go there and craft.
    if workshop_idx is not None:
        ws_positions = locate(workshop_idx)
        if ws_positions:
            target_ws = min(ws_positions,
                            key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))
            go_to(target_ws)
            actions.append(4)          # USE to trigger crafting
            _, state = state.step(4)

    # Return the compiled action list.
    return actions

