    import numpy as np
    from collections import deque

    # Action mapping: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    _delta_to_action = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }

    def _is_free(grid, x, y):
        """A cell is free if it contains no entities."""
        return grid[x, y, :].sum() == 0

    def _neighbors(pos, width, height):
        x, y = pos
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nx, ny = x + dx, y + dy
            if 0 <= nx < width and 0 <= ny < height:
                yield (nx, ny), (dx, dy)

    def _bfs_path(grid, start, goal_cond):
        """
        Bread‑first search returning a list of actions that moves the agent
        from ``start`` to any cell satisfying ``goal_cond``.
        """
        width, height = grid.shape[0], grid.shape[1]
        q = deque([start])
        came_from = {start: None}
        move_from = {}

        while q:
            cur = q.popleft()
            if goal_cond(cur):
                # reconstruct path
                actions = []
                while came_from[cur] is not None:
                    dx, dy = move_from[cur]
                    actions.append(_delta_to_action[(dx, dy)])
                    cur = came_from[cur]
                actions.reverse()
                return actions

            for nxt, delta in _neighbors(cur, width, height):
                if nxt not in came_from and _is_free(grid, *nxt):
                    came_from[nxt] = cur
                    move_from[nxt] = delta
                    q.append(nxt)

        # No path found
        return []

    # ------------------------------------------------------------------
    # Begin planning
    # ------------------------------------------------------------------
    state = env._current_state          # type: CraftState
    world = env.world                   # type: CraftWorld
    goal_idx = env.task.goal            # integer index of the desired item

    # Primitive requirements for the goal
    needed = world.cookbook.primitives_for(goal_idx).copy()  # {prim_idx: count}
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')   # may be None
    workshop_idx = None
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # Working copies that we update as we simulate actions
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    cur_pos = tuple(state.pos)

    actions = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives
    # ------------------------------------------------------------------
    for prim_idx, required_cnt in needed.items():
        while inventory[prim_idx] < required_cnt:
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more primitives left – abort
                return actions

            # Choose the closest primitive (Manhattan distance)
            dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
            target = tuple(prim_cells[dists.argmin()])

            # Move to the primitive
            move_actions = _bfs_path(grid, cur_pos, lambda p, t=target: p == t)
            actions.extend(move_actions)
            cur_pos = target

            # Pick it up
            actions.append(4)   # USE
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if any) and craft the goal
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size == 0:
            return actions

        width, height = grid.shape[0], grid.shape[1]
        best_path = None
        best_target = None

        for wx, wy in ws_cells:
            # Consider the workshop cell itself and its 4 orthogonal neighbours
            candidates = [(wx, wy)] + [(wx + dx, wy + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]
            for cx, cy in candidates:
                if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):
                    path = _bfs_path(grid, cur_pos, lambda p, t=(cx, cy): p == t)
                    if best_path is None or len(path) < len(best_path):
                        best_path = path
                        best_target = (cx, cy)

        if best_path is not None:
            actions.extend(best_path)
            cur_pos = best_target
            actions.append(4)   # USE to craft

    # Return the assembled action list
    return actions


    import numpy as np
    from collections import deque

    # Map movement deltas to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)
    _delta_to_action = {
        (0, 1): 0,   # DOWN
        (0, -1): 1,  # UP
        (-1, 0): 2,  # LEFT
        (1, 0): 3,   # RIGHT
    }

    def _is_free(grid, x, y):
        """A cell is free if it contains no entities."""
        return grid[x, y, :].sum() == 0

    def _neighbors(pos, width, height):
        """Yield orthogonal neighbour positions and their deltas."""
        x, y = pos
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nx, ny = x + dx, y + dy
            if 0 <= nx < width and 0 <= ny < height:
                yield (nx, ny), (dx, dy)

    def _bfs_path(grid, start, goal_cond):
        """
        Bread‑first search returning a list of actions that moves the agent
        from ``start`` to any cell satisfying ``goal_cond``.
        """
        width, height = grid.shape[0], grid.shape[1]
        q = deque([start])
        came_from = {start: None}
        move_from = {start: None}
        while q:
            cur = q.popleft()
            if goal_cond(cur):
                # Reconstruct action list.
                actions = []
                while came_from[cur] is not None:
                    dx, dy = move_from[cur]
                    actions.append(_delta_to_action[(dx, dy)])
                    cur = came_from[cur]
                actions.reverse()
                return actions
            for nxt, delta in _neighbors(cur, width, height):
                if nxt not in came_from and _is_free(grid, *nxt):
                    came_from[nxt] = cur
                    move_from[nxt] = delta
                    q.append(nxt)
        # No path found.
        return []

    # ------------------------------------------------------------------
    # Access current environment state.
    # ------------------------------------------------------------------
    state = env._current_state          # CraftState
    world = env.world                   # CraftWorld
    goal_idx = env.task.goal

    # Primitive requirements for the goal.
    needed_prims = world.cookbook.primitives_for(goal_idx).copy()
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get('_at')
    workshop_idx = None
    if workshop_name is not None:
        workshop_idx = world.cookbook.index[workshop_name]

    # Local mutable copies for planning.
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    cur_pos = tuple(state.pos)

    plan = []

    # ------------------------------------------------------------------
    # 1) Collect all required primitives.
    # ------------------------------------------------------------------
    for prim_idx, req_cnt in needed_prims.items():
        while inventory[prim_idx] < req_cnt:
            prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
            if prim_cells.size == 0:
                # No more of this primitive on the map – abort planning.
                return plan
            # Choose the closest primitive (Manhattan distance).
            dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])
            target = tuple(prim_cells[dists.argmin()])

            # Move to the chosen primitive.
            moves = _bfs_path(grid, cur_pos, lambda p, t=target: p == t)
            plan.extend(moves)
            cur_pos = target

            # Use (pick up) the primitive.
            plan.append(4)   # USE
            grid[cur_pos[0], cur_pos[1], prim_idx] = 0
            inventory[prim_idx] += 1

    # ------------------------------------------------------------------
    # 2) Go to the workshop (if required) and craft the goal.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
        if ws_cells.size == 0:
            return plan

        width, height = grid.shape[0], grid.shape[1]
        best_path = None
        best_target = None

        for wx, wy in ws_cells:
            # Consider the workshop cell itself and its orthogonal neighbours.
            candidates = [(wx, wy),
                          (wx - 1, wy), (wx + 1, wy),
                          (wx, wy - 1), (wx, wy + 1)]
            for cx, cy in candidates:
                if 0 <= cx < width and 0 <= cy < height and _is_free(grid, cx, cy):
                    path = _bfs_path(grid, cur_pos,
                                     lambda p, t=(cx, cy): p == t)
                    if best_path is None or len(path) < len(best_path):
                        best_path = path
                        best_target = (cx, cy)

        if best_path is None:
            return plan

        plan.extend(best_path)
        cur_pos = best_target
        plan.append(4)   # USE to craft at the workshop

    return plan

