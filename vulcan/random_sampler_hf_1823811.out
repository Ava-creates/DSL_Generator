    def _move_actions(src, dst):
        """Manhattan moves from src to dst (ignores obstacles)."""
        x, y = src
        tx, ty = dst
        acts = []
        dx = tx - x
        dy = ty - y
        if dx > 0:
            acts += [DOWN] * dx
        elif dx < 0:
            acts += [UP] * (-dx)
        if dy > 0:
            acts += [RIGHT] * dy
        elif dy < 0:
            acts += [LEFT] * (-dy)
        return acts

    def _nearest_kind(pos, kind_idx):
