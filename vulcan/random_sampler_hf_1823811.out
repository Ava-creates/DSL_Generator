    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Helpers
    # ----------------------------------------------------------------------
    # Action ordering matches CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # (dx, dy) for each move
    USE = 4

    def bfs_adjacent(start, target, blocked):
        """Return a list of movement actions that brings the agent from *start*
        to any empty cell that is 4‑connected to *target*. If unreachable, return [].
        """
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []
        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ----------------------------------------------------------------------
    # Reset / obtain current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass
    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify arrow goal and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                     # no arrow defined

    # Primitive (or sub‑component) counts required for one arrow
    needed = world.cookbook.primitives_for(goal_idx)

    # Locate workshop required for crafting the arrow (stored under "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []
    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []

    # ----------------------------------------------------------------------
    # Local mutable copies for planning
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells

    plan = []

    # ----------------------------------------------------------------------
    # Helper to move adjacent to a cell and USE it
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Move adjacent to *target* (contains *kind_idx*) and issue USE.
        Updates simulated pos, grid, occupied, inventory. Returns False on failure."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # Execute movement actions in the simulated state
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # Perform USE
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            # Pick up one unit of the requested kind
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required items (primitives or already‑crafted components)
    # ----------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            # Find all cells that currently contain the needed kind
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # No more of this kind on the map – abort planning
                return plan
            # Choose the nearest instance (Manhattan distance)
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, kind_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # Fallback to original scenario grid (workshops are static)
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    # ----------------------------------------------------------------------
    # Return the constructed action sequence
    # ----------------------------------------------------------------------
    return plan


    import numpy as np
    from collections import deque

    # ----------------------------------------------------------------------
    # Action constants (match CraftLab.action_specs)
    # ----------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT
    USE = 4

    # ----------------------------------------------------------------------
    # Helper: BFS to any free cell adjacent to a target cell
    # ----------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        """Return list of actions moving from *start* to a free 4‑adjacent cell of *target*.
        If none reachable, return empty list."""
        h, w = blocked.shape
        tx, ty = target
        # all possible adjacent cells that are inside the grid and not blocked
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []                     # target completely surrounded

        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []                         # unreachable

    # ----------------------------------------------------------------------
    # Reset / fetch current state
    # ----------------------------------------------------------------------
    try:
        env.reset()
    except Exception:
        pass

    state = getattr(env, "_current_state", None)
    if state is None:
        return []                         # cannot obtain state

    world = env.world
    idx = world.cookbook.index

    # ----------------------------------------------------------------------
    # Identify goal (arrow) and its recipe
    # ----------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []                         # arrow not defined

    # primitives needed for one arrow
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # workshop required for arrow (stored under "_at" or "_key")
    workshop_name = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_name = v
            break
    if workshop_name is None:
        return []                         # no workshop info

    try:
        workshop_idx = idx[workshop_name]
    except Exception:
        return []                         # workshop not indexed

    # ----------------------------------------------------------------------
    # Local mutable copies for planning
    # ----------------------------------------------------------------------
    pos = tuple(state.pos)                 # (x, y)
    grid = state.grid.copy()               # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)    # bool matrix of blocked cells

    plan = []

    # ----------------------------------------------------------------------
    # Helper: move adjacent to a cell containing *kind_idx* and USE it
    # ----------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Navigate adjacent to *target* and issue USE.
        Updates simulated pos, grid, occupied, inventory.
        Returns False if movement impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # simulate movements
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # USE action
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            # pick up one unit
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ----------------------------------------------------------------------
    # Collect all required primitives
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            candidates = np.argwhere(grid[:, :, prim_idx] > 0)
            if candidates.shape[0] == 0:
                # no more of this primitive on the map – abort planning
                return plan
            # choose the closest by Manhattan distance
            dists = np.abs(candidates[:, 0] - pos[0]) + np.abs(candidates[:, 1] - pos[1])
            target = tuple(candidates[dists.argmin()])
            if not move_and_use(target, prim_idx):
                return plan

    # ----------------------------------------------------------------------
    # Move to the workshop and craft the arrow
    # ----------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.shape[0] == 0:
        # fall back to static scenario grid (workshops never disappear)
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.shape[0] == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    # ----------------------------------------------------------------------
    # Return the constructed action list
    # ----------------------------------------------------------------------
    return plan

