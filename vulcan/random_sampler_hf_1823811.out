    import numpy as np

    # Action indices as defined in CraftWorld
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Return a list of actions that move Manhattan‑style from src to dst."""
        actions = []
        x, y = src
        tx, ty = dst
        # vertical moves
        if tx > x:
            actions += [DOWN] * (tx - x)
        elif tx < x:
            actions += [UP] * (x - tx)
        # horizontal moves
        if ty > y:
            actions += [RIGHT] * (ty - y)
        elif ty < y:
            actions += [LEFT] * (y - ty)
        return actions

    def _nearest_kind(pos, kind_idx, grid):
        """Find the coordinates of the nearest cell containing `kind_idx`."""
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = locations[dists.argmin()]
        return int(nearest[0]), int(nearest[1])

    # ------------------------------------------------------------------
