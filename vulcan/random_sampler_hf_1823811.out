    # Reset environment and obtain current state
    try:
        env.reset()
    except Exception:
        pass
    state = getattr(env, "_current_state", None)
    if state is None:
        return []

    world = env.world
    idx = world.cookbook.index

    # Target item index for "arrow"
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []

    # Primitive requirements for ONE arrow
    needed = world.cookbook.primitives_for(goal_idx)

    # Locate workshop required for crafting the arrow
    workshop_idx = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_idx = idx.get(v, None)
            break
    if workshop_idx is None:
        return []

    # ------------------------------------------------------------------
    # Planning helpers
    # ------------------------------------------------------------------
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4
    from collections import deque

    def bfs_adjacent(start, target, blocked):
        """Return actions to move from *start* to any free cell adjacent to *target*."""
        h, w = blocked.shape
        tx, ty = target
        goals = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goals.append((gx, gy))
        if not goals:
            return []
        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goals:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ------------------------------------------------------------------
    # Simulated mutable copies
    # ------------------------------------------------------------------
    pos = tuple(state.pos)
    grid = state.grid.copy()
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)  # bool matrix of blocked cells
    plan = []

    def move_and_use(target, kind_idx):
        """Navigate adjacent to *target*, issue USE, and update simulated state."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] dy)
        plan.extend(path)
        plan.append(USE)
        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ------------------------------------------------------------------
    # Collect required primitives/components
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                return plan
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, kind_idx):
                return plan

    # ------------------------------------------------------------------
    # Move to workshop and craft the arrow
    # ------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan


    # Reset environment and obtain the current CraftState.
    try:
        env.reset()
    except Exception:
        pass
    state = getattr(env, "_current_state", None)
    if state is None:
        return []  # No state available.

    world = env.world
    idx = world.cookbook.index

    # ------------------------------------------------------------------
    # Identify the goal item ("arrow") and its recipe information.
    # ------------------------------------------------------------------
    try:
        goal_idx = idx["arrow"]
    except Exception:
        return []  # Arrow not defined.

    # Primitive (or sub‑component) requirements for a single arrow.
    needed = world.cookbook.primitives_for(goal_idx)

    # Determine the workshop required for crafting the arrow.
    workshop_idx = None
    for k, v in world.cookbook.recipes.get(goal_idx, {}).items():
        if k in ("_at", "_key"):
            workshop_idx = idx.get(v, None)
            break
    if workshop_idx is None:
        return []  # No workshop info.

    # ------------------------------------------------------------------
    # Prepare mutable copies of the world for planning.
    # ------------------------------------------------------------------
    pos = tuple(state.pos)                     # (x, y)
    grid = state.grid.copy()                   # (W, H, n_kinds)
    inventory = state.inventory.copy()
    occupied = np.any(grid > 0, axis=2)        # bool matrix of blocked cells

    plan = []                                   # final action list

    # Action constants (match CraftLab.action_specs ordering).
    DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT
    USE = 4

    from collections import deque

    # ------------------------------------------------------------------
    # Helper: BFS to a free cell adjacent to a target cell.
    # ------------------------------------------------------------------
    def bfs_adjacent(start, target, blocked):
        """Return a list of actions moving from *start* to any empty cell
        that is 4‑connected to *target*. Empty list if unreachable."""
        h, w = blocked.shape
        tx, ty = target
        goal_cells = []
        for a, (dx, dy) in enumerate(DIRS):
            gx, gy = tx + dx, ty + dy
            if 0 <= gx < h and 0 <= gy < w and not blocked[gx, gy]:
                goal_cells.append((gx, gy))
        if not goal_cells:
            return []
        q = deque([(start, [])])
        visited = {start}
        while q:
            (cx, cy), path = q.popleft()
            if (cx, cy) in goal_cells:
                return path
            for a, (dx, dy) in enumerate(DIRS):
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < h and 0 <= ny < w and not blocked[nx, ny]:
                    if (nx, ny) not in visited:
                        visited.add((nx, ny))
                        q.append(((nx, ny), path + [a]))
        return []

    # ------------------------------------------------------------------
    # Helper: Move adjacent to *target* containing *kind_idx* and USE it.
    # Simulate the effect on the planning copies.
    # ------------------------------------------------------------------
    def move_and_use(target, kind_idx):
        """Navigate to a free cell next to *target*, issue USE, and update
        simulated world state. Returns False if movement impossible."""
        nonlocal pos, plan, grid, occupied, inventory
        path = bfs_adjacent(pos, target, occupied)
        if not path and pos != target:
            return False
        # Execute movement actions.
        for a in path:
            dx, dy = DIRS[a]
            pos = (pos[0] + dx, pos[1] + dy)
        plan.extend(path)

        # USE action.
        plan.append(USE)

        tx, ty = target
        if grid[tx, ty, kind_idx] > 0:
            grid[tx, ty, kind_idx] = 0
            occupied[tx, ty] = np.any(grid[tx, ty, :] > 0)
            inventory[kind_idx] += 1
        return True

    # ------------------------------------------------------------------
    # Collect all required primitives/components.
    # ------------------------------------------------------------------
    for kind_idx, cnt in needed.items():
        for _ in range(cnt):
            locations = np.argwhere(grid[:, :, kind_idx] > 0)
            if locations.size == 0:
                # Primitive not present on map – stop planning.
                return plan
            # Choose the nearest instance (Manhattan distance).
            dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
            target = tuple(locations[dists.argmin()])
            if not move_and_use(target, kind_idx):
                return plan

    # ------------------------------------------------------------------
    # Move to the workshop and craft the arrow.
    # ------------------------------------------------------------------
    workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        # Fall back to original scenario grid if workshop was cleared.
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size == 0:
            return plan
    dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
    workshop_target = tuple(workshop_cells[dists.argmin()])
    move_and_use(workshop_target, workshop_idx)

    return plan

