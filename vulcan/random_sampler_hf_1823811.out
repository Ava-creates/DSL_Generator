    # ----------------------------------------------------------------------
    # Setup and helpers
    # ----------------------------------------------------------------------
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # reset env and pull useful references
    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    index = cookbook.index                    # name ↔ id mapping

    # ----------------------------------------------------------------------
    # Goal identification
    # ----------------------------------------------------------------------
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []  # arrow not defined in this world
    goal_idx = index[goal_name]

    # ----------------------------------------------------------------------
    # Primitive requirements for one arrow
    # ----------------------------------------------------------------------
    primitive_needs = cookbook.primitives_for(goal_idx)   # {prim_idx: count}
    actions = []

    # ----------------------------------------------------------------------
    # Simple BFS path‑finder that treats any occupied cell as blocked,
    # except the target cell itself (so we can step onto a primitive / workshop).
    # ----------------------------------------------------------------------
    def bfs(start, target):
        """Return a list of positions from start to target (inclusive) using
        4‑connected Manhattan moves. Returns None if target unreachable."""
        h, w = state.grid.shape[:2]
        occupied = np.any(state.grid > 0, axis=2)          # True where blocked
        # allow stepping onto the target even if it is occupied
        occupied[target] = False
        q = collections.deque()
        q.append(start)
        came_from = {start: None}
        while q:
            cur = q.popleft()
            if cur == target:
                break
            r, c = cur
            for dr, dc in [(1,0), (-1,0), (0,1), (0,-1)]:
                nr, nc = r+dr, c+dc
                if 0 <= nr < h and 0 <= nc < w:
                    if not occupied[nr, nc] and (nr, nc) not in came_from:
                        came_from[(nr, nc)] = cur
                        q.append((nr, nc))
        else:
            return None  # never reached target

        # reconstruct path
        path = []
        cur = target
        while cur is not None:
            path.append(cur)
            cur = came_from[cur]
        path.reverse()
        return path

    # ----------------------------------------------------------------------
    # Translate a step (delta) into an action index.
    # ----------------------------------------------------------------------
    delta_to_action = {
        (1, 0): DOWN,
        (-1, 0): UP,
        (0, 1): RIGHT,
        (0, -1): LEFT,
    }

    # ----------------------------------------------------------------------
    # 1. Collect all required primitives.
    # ----------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # locate any remaining instance of this primitive
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # nothing left – abort planning
                return actions

            target_r, target_c = cells[0]

            # find path to that cell
            path = bfs(state.pos, (target_r, target_c))
            if path is None:
                # unreachable – abort
                return actions

            # convert path (list of positions) to actions
            for (r0, c0), (r1, c1) in zip(path, path[1:]):
                act = delta_to_action[(r1 - r0, c1 - c0)]
                actions.append(act)
                state.pos = (r1, c1)

            # pick up the primitive
            actions.append(USE)
            state.inventory[prim_idx] += 1
            state.grid[target_r, target_c, prim_idx] = 0

    # ----------------------------------------------------------------------
    # 2. Go to the workshop and craft the arrow.
    # ----------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # no workshop info – cannot craft

    workshop_idx = index[workshop_name]
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # no workshop cell found

    w_r, w_c = workshop_cells[0]

    path = bfs(state.pos, (w_r, w_c))
    if path is None:
        return actions  # unreachable

    for (r0, c0), (r1, c1) in zip(path, path[1:]):
        act = delta_to_action[(r1 - r0, c1 - c0)]
        actions.append(act)
        state.pos = (r1, c1)

    # craft the arrow at the workshop
    actions.append(USE)

    return actions


    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset environment and obtain references
    env.reset()
    state = env._current_state               # CraftState
    world = env.scenario.world                # CraftWorld
    cookbook = world.cookbook                 # Cookbook
    index = cookbook.index                    # name ↔ id mapping

    # Goal item name
    goal_name = "arrow"
    if goal_name not in index.contents:
        return []  # arrow not defined

    goal_idx = index[goal_name]

    # Primitives needed for one arrow
    primitive_needs = cookbook.primitives_for(goal_idx)  # {prim_idx: count}
    actions = []

    # Simple Manhattan movement helper
    def _move_to(start, target):
        """Return list of move actions from start to target (row,col)."""
        r, c = start
        tr, tc = target
        seq = []
        while (r, c) != (tr, tc):
            if r < tr:
                seq.append(DOWN)
                r += 1
            elif r > tr:
                seq.append(UP)
                r -= 1
            elif c < tc:
                seq.append(RIGHT)
                c += 1
            else:  # c > tc
                seq.append(LEFT)
                c -= 1
        return seq, (r, c)

    # ------------------------------------------------------------------
    # 1. Collect required primitives.
    # ------------------------------------------------------------------
    for prim_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            # Locate a cell that currently holds this primitive
            cells = np.argwhere(state.grid[:, :, prim_idx] > 0)
            if cells.size == 0:
                # Primitive missing – abort planning.
                return actions
            target_r, target_c = cells[0]

            # Move next to the primitive cell
            move_seq, new_pos = _move_to(state.pos, (target_r, target_c))
            actions.extend(move_seq)
            state.pos = new_pos

            # Pick it up
            actions.append(USE)

            # Update internal copy of state
            state.inventory[prim_idx] += 1
            state.grid[target_r, target_c, prim_idx] = 0

    # ------------------------------------------------------------------
    # 2. Go to the workshop and craft the arrow.
    # ------------------------------------------------------------------
    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions  # No workshop info

    workshop_idx = index[workshop_name]

    # Find a workshop cell
    workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
    if workshop_cells.size == 0:
        return actions  # No workshop cell

    w_r, w_c = workshop_cells[0]

    # Move to workshop
    move_seq, new_pos = _move_to(state.pos, (w_r, w_c))
    actions.extend(move_seq)
    state.pos = new_pos

    # Craft the arrow
    actions.append(USE)

    return actions

