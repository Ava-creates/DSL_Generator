    # Reset environment to obtain fresh observation and task info
    _ = env.reset()
    act_map = env.action_specs()          # e.g. {'DOWN':0,'UP':1,'LEFT':2,'RIGHT':3,'USE':4}
    # movement vectors and names (order does not matter)
    moves = [
        (1, 0, "DOWN"),
        (-1, 0, "UP"),
        (0, 1, "RIGHT"),
        (0, -1, "LEFT"),
    ]
    # opposite direction lookup (used to ensure we face the target when using)
    opposite = {"UP": "DOWN", "DOWN": "UP", "LEFT": "RIGHT", "RIGHT": "LEFT"}

    # Helper: BFS that returns a list of direction names that brings the agent
    # to a cell adjacent to `target` *and* leaves the agent facing `target`.
    from collections import deque

    def bfs_adjacent(start_pos, target_pos, occ_grid):
        tr, tc = target_pos
        # map each free neighbour of the target to the direction the agent must be
        # facing when standing on that neighbour (i.e. direction from neighbour → target)
        neighbour_need = {}
        for dr, dc, name in moves:
            nr, nc = tr + dr, tc + dc
            if 0 <= nr < occ_grid.shape[0] and 0 <= nc < occ_grid.shape[1]:
                if not occ_grid[nr, nc]:          # free cell
                    neighbour_need[(nr, nc)] = opposite[name]

        # BFS over free cells
        q = deque([start_pos])
        parent = {start_pos: None}
        parent_move = {}
        while q:
            cur = q.popleft()
            if cur in neighbour_need:
                # we have reached a suitable neighbour; check orientation
                need_dir = neighbour_need[cur]
                if parent_move.get(cur) == need_dir:
                    # reconstruct path
                    path = []
                    node = cur
                    while parent[node] is not None:
                        path.append(parent_move[node])
                        node = parent[node]
                    path.reverse()
                    return path
            # explore neighbours
            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occ_grid.shape[0]
                    and 0 <= nc < occ_grid.shape[1]
                    and not occ_grid[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        # No path found – return empty list (the caller will simply skip)
        return []

    # Mapping from direction name to delta for position updates
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}

    # Extract world information
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal                     # integer index of the desired item

    # Retrieve recipe for the goal and the list of required primitives
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")             # may be None for primitive goals
    primitives_needed = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}

    # Working copies of the grid and occupancy mask
    grid = scenario.init_grid.copy()
    occ = grid.sum(axis=2) > 0                  # True where any entity occupies the cell

    cur_pos = scenario.init_pos
    actions = []

    # Helper to execute a list of direction names: update actions list and cur_pos
    def follow_path(dir_names):
        nonlocal cur_pos
        for dname in dir_names:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------
    # 1) Collect all required primitive items
    # ------------------------------------------------------------
    for prim_idx, needed_cnt in primitives_needed.items():
        for _ in range(needed_cnt):
            # locate all cells that currently contain this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # primitive not present any more; abort collection loop
                break
            # pick the closest primitive (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )
            # find path to a suitable adjacent cell
            path = bfs_adjacent(cur_pos, target, occ)
            follow_path(path)
            # use the primitive
            actions.append(act_map["USE"])
            # update internal grid/occupancy to reflect that the primitive was taken
            r, c = target
            grid[r, c, :] = 0
            occ[r, c] = False

    # ------------------------------------------------------------
    # 2) Move to the workshop (if any) and craft the goal item
    # ------------------------------------------------------------
    if workshop_idx is not None:
        # locate workshop cells (they are static in the original scenario grid)
        workshop_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0)))
        if workshop_cells:
            target = workshop_cells[0]  # any workshop cell works
            path = bfs_adjacent(cur_pos, target, occ)
            follow_path(path)
            actions.append(act_map["USE"])

    return actions


    # Reset environment to get a fresh scenario and observation
    _ = env.reset()
    act_map = env.action_specs()  # maps action names to integer indices

    # Define movement directions
    moves = [
        (1, 0, "DOWN"),
        (-1, 0, "UP"),
        (0, 1, "RIGHT"),
        (0, -1, "LEFT"),
    ]
    dir_to_delta = {name: (dr, dc) for dr, dc, name in moves}
    from collections import deque

    # ------------------------------------------------------------------
    # Helper: BFS that returns a list of action names moving the agent from
    # start to any free cell adjacent to the target cell.
    # ------------------------------------------------------------------
    def bfs_to_adjacent(start, target, occupied):
        tr, tc = target
        # candidate goal cells: free neighbours of target
        goal_cells = [
            (tr + dr, tc + dc)
            for dr, dc, _ in moves
            if 0 <= tr + dr < occupied.shape[0]
            and 0 <= tc + dc < occupied.shape[1]
            and not occupied[tr + dr, tc + dc]
        ]
        if not goal_cells:
            return []  # no reachable adjacent cell

        q = deque([start])
        parent = {start: None}
        parent_move = {}

        while q:
            cur = q.popleft()
            if cur in goal_cells:
                # reconstruct path of action names
                path = []
                while parent[cur] is not None:
                    path.append(parent_move[cur])
                    cur = parent[cur]
                path.reverse()
                return path

            r, c = cur
            for dr, dc, name in moves:
                nr, nc = r + dr, c + dc
                if (
                    0 <= nr < occupied.shape[0]
                    and 0 <= nc < occupied.shape[1]
                    and not occupied[nr, nc]
                    and (nr, nc) not in parent
                ):
                    parent[(nr, nc)] = cur
                    parent_move[(nr, nc)] = name
                    q.append((nr, nc))
        return []  # no path found

    # ------------------------------------------------------------------
    # Helper: execute a list of direction names, updating cur_pos and actions.
    # ------------------------------------------------------------------
    def execute_path(path_dirs):
        nonlocal cur_pos
        for dname in path_dirs:
            actions.append(act_map[dname])
            dr, dc = dir_to_delta[dname]
            cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

    # ------------------------------------------------------------------
    # Gather references to scenario, world and the goal index.
    # ------------------------------------------------------------------
    scenario = env.scenario
    world = scenario.world
    goal_idx = env.task.goal

    # Load recipe information
    recipe = world.cookbook.recipes.get(goal_idx, {})
    workshop_idx = recipe.get("_at")
    primitives_needed = world.cookbook.primitives_for(goal_idx)

    # Work on a mutable copy of the initial grid
    grid = scenario.init_grid.copy()
    occupied = grid.sum(axis=2) > 0  # True where any entity occupies the cell

    cur_pos = scenario.init_pos
    actions = []

    # ------------------------------------------------------------------
    # 1. Collect each required primitive (respecting multiplicities).
    # ------------------------------------------------------------------
    for prim_idx, count in primitives_needed.items():
        for _ in range(count):
            # locate all cells that still contain this primitive
            prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
            if not prim_cells:
                # primitive not present any more; break out
                break

            # choose the nearest primitive cell (Manhattan distance)
            target = min(
                prim_cells,
                key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]),
            )

            # move adjacent to the primitive and pick it up
            path = bfs_to_adjacent(cur_pos, target, occupied)
            execute_path(path)
            actions.append(act_map["USE"])

            # update grid / occupied after pickup
            r, c = target
            grid[r, c, :] = 0
            occupied[r, c] = False

    # ------------------------------------------------------------------
    # 2. Move to the appropriate workshop (if the recipe specifies one) and craft.
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        # locate workshop cells (they stay static)
        workshop_cells = list(zip(*np.where(scenario.init_grid[:, :, workshop_idx] > 0)))
        if workshop_cells:
            target = workshop_cells[0]  # any workshop cell works
            path = bfs_to_adjacent(cur_pos, target, occupied)
            execute_path(path)
            actions.append(act_map["USE"])

    # Return the full action sequence
    return actions

