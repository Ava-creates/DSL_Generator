    recipe = cookbook.recipes.get(goal_idx, {})
    workshop_name = recipe.get("_at")
    if workshop_name is None:
        return actions
    workshop_idx = index[workshop_name]
    path, cell = find_nearest(workshop_idx, state.pos)
    if cell is None:
        return actions
    actions.extend(path)
    state.pos = cell
    actions.append(USE)

    return actions


