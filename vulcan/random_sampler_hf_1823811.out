    # Action indices (standard for CraftWorld)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    def _move_actions(src, dst):
        """Return a list of actions that moves from src to dst using
        Manhattan moves.  This ignores obstacles – it is a simple
        heuristic that works for most generated scenarios."""
        actions = []
        x, y = src
        tx, ty = dst
        dx = tx - x
        dy = ty - y
        if dx > 0:
            actions += [DOWN] * dx
        elif dx < 0:
            actions += [UP] * (-dx)
        if dy > 0:
            actions += [RIGHT] * dy
        elif dy < 0:
            actions += [LEFT] * (-dy)
        return actions

    def _nearest_kind(pos, kind_idx):
        """Find the nearest cell (Manhattan distance) that contains the
        requested kind index.  Returns None if the kind does not appear."""
        grid = env._current_state.grid
        locations = np.argwhere(grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None
        dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
        nearest = int(dists.argmin())
        return tuple(locations[nearest].tolist())

    # ------------------------------------------------------------------
    # 1. Identify the goal (arrow) and its primitive requirements
    # ------------------------------------------------------------------
