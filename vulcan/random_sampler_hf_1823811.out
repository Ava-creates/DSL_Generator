    # ------------------------------------------------------------------
    # Helper utilities
    # ------------------------------------------------------------------
    from collections import deque
    import numpy as np

    def bfs_path(start, goal, occupied):
        """Return a walkable path (list of positions) from start to goal.
        `occupied` is a bool mask where True means blocked. Goal cell may be occupied.
        """
        w, h = occupied.shape
        visited = np.zeros((w, h), dtype=bool)
        prev = {}
        q = deque([start])
        visited[start] = True
        while q:
            x, y = q.popleft()
            if (x, y) == goal:
                break
            for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                    # Allow stepping onto the goal even if it is occupied
                    if (nx, ny) == goal or not occupied[nx, ny]:
                        visited[nx, ny] = True
                        prev[(nx, ny)] = (x, y)
                        q.append((nx, ny))
        if not visited[goal]:
            return None
        # reconstruct path (exclude start, include goal)
        path = []
        cur = goal
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        path.reverse()
        return path

    def delta_to_action(dx, dy):
        """Map a movement delta to the environment's action index."""
        if dx == 1:
            return 3          # RIGHT
        if dx == -1:
            return 2          # LEFT
        if dy == 1:
            return 0          # DOWN
        if dy == -1:
            return 1          # UP
        raise ValueError("Invalid movement delta")

    # ------------------------------------------------------------------
    # Planning state
    # ------------------------------------------------------------------
    actions = []
    cur_pos = tuple(state.pos)          # current (x, y)
    # mutable copy of the grid to keep track of which primitives are still on the map
    mutable_grid = state.grid.copy()

    # ------------------------------------------------------------------
    # Helper to locate the nearest reachable primitive of a given kind
    # ------------------------------------------------------------------
    def find_nearest(kind_idx, from_pos):
        """Return (target_cell, path) for the closest reachable primitive of kind_idx."""
        locations = np.argwhere(mutable_grid[:, :, kind_idx] > 0)
        if locations.size == 0:
            return None, None
        # order by Manhattan distance
        dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])
        order = np.argsort(dists)
        occupied_mask = np.any(mutable_grid, axis=2)   # any entity blocks movement
        for idx in order:
            target = tuple(locations[idx])
            path = bfs_path(from_pos, target, occupied_mask)
            if path is not None:
                return target, path
        return None, None

    # ------------------------------------------------------------------
    # 1) Collect all required primitive resources
    # ------------------------------------------------------------------
    for kind_idx, needed_cnt in primitive_needs.items():
        for _ in range(needed_cnt):
            target, path = find_nearest(kind_idx, cur_pos)
            if target is None:
                # No reachable instance left; abort collection of this primitive
                break
            # Walk to the primitive
            for step in path:
                dx = step[0] - cur_pos[0]
                dy = step[1] - cur_pos[1]
                actions.append(delta_to_action(dx, dy))
                cur_pos = step
            # Pick it up
            actions.append(4)                     # USE
            # Remove it from mutable copy so we don't try to collect again
            mutable_grid[target[0], target[1], kind_idx] = 0

    # ------------------------------------------------------------------
    # 2) Move to the required workshop (if any) and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)
        if workshop_cells.size > 0:
            # Choose the closest workshop cell
            dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
            order = np.argsort(dists)
            occupied_mask = np.any(state.grid, axis=2)   # original occupancy (workshops block)
            for idx in order:
                target = tuple(workshop_cells[idx])
                path = bfs_path(cur_pos, target, occupied_mask)
                if path is not None:
                    for step in path:
                        dx = step[0] - cur_pos[0]
                        dy = step[1] - cur_pos[1]
                        actions.append(delta_to_action(dx, dy))
                        cur_pos = step
                    actions.append(4)   # USE to trigger crafting
                    break
    else:
        # No specific workshop required – craft at current location
        actions.append(4)   # USE

    return actions

