    # Constants for actions (according to CraftLab's action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Helper to generate a simple Manhattan path (ignores obstacles)
    def _move_path(start_pos, target_pos):
        """Return a list of actions moving from start_pos to target_pos."""
        sx, sy = start_pos
        tx, ty = target_pos
        path = []
        # horizontal moves
        while sx < tx:
            path.append(RIGHT)
            sx += 1
        while sx > tx:
            path.append(LEFT)
            sx -= 1
        # vertical moves
        while sy < ty:
            path.append(DOWN)
            sy += 1
        while sy > ty:
            path.append(UP)
            sy -= 1
        return path

    # ------------------------------------------------------------------
    # Access world and recipe information
    # ------------------------------------------------------------------
    world = env.world                       # CraftWorld instance
    scenario = env.scenario                 # CraftScenario instance
    grid = scenario.init_grid.copy()        # (W, H, n_kinds) numpy array
    pos = tuple(scenario.init_pos)          # (x, y) start position

    # Index of the target item "arrow"
    arrow_idx = world.cookbook.index["arrow"]
    recipe = world.cookbook.recipes[arrow_idx]

    # Separate primitive requirements from the workshop spec
    workshop_idx = recipe.get("_at", None)
    primitive_reqs = {k: v for k, v in recipe.items() if k != "_at"}

    actions = []

    # ------------------------------------------------------------------
    # Collect each required primitive (respecting required counts)
    # ------------------------------------------------------------------
    for prim_idx, count in primitive_reqs.items():
        for _ in range(count):
            # locate any remaining instance of this primitive on the map
            locs = np.argwhere(grid[:, :, prim_idx] > 0)
            if locs.size == 0:
                # no more primitives of this type; abort (should not happen)
                continue
            target_x, target_y = locs[0]  # pick the first occurrence
            # move to the primitive
            actions.extend(_move_path(pos, (target_x, target_y)))
            pos = (target_x, target_y)
            # pick it up
            actions.append(USE)
            # update the simulated grid (remove one instance)
            grid[target_x, target_y, prim_idx] -= 1

    # ------------------------------------------------------------------
    # Go to the appropriate workshop and craft the arrow
    # ------------------------------------------------------------------
    if workshop_idx is not None:
        # find a workshop cell of the required type
        workshop_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
        if workshop_locs.size == 0:
            # fallback: stay where we are if no workshop found
            pass
        else:
            wx, wy = workshop_locs[0]
            actions.extend(_move_path(pos, (wx, wy)))
            pos = (wx, wy)

    # final USE to craft the arrow
    actions.append(USE)

    return actions


    # Constants for actions (matching CraftLab.action_specs)
    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

    # Reset the environment and get the initial state
    env.reset()
    state = env._current_state

    # Goal index (the item we need to craft)
    goal_idx = env.task.goal

    # Helper: move the agent towards a target position using the
    # simplest Manhattan‑distance greedy policy.
    def _move_to(target):
        nonlocal state
        while state.pos != target:
            x, y = state.pos
            tx, ty = target
            if x < tx:
                act = RIGHT
            elif x > tx:
                act = LEFT
            elif y < ty:
                act = DOWN
            else:
                act = UP
            actions.append(act)
            # env.step returns (reward, done, obs); we only need the updated state
            env.step(act)
            state = env._current_state

    actions = []

    # Scan the whole grid repeatedly (a few passes are enough for the tiny
    # CraftWorld maps).  At each cell we try to use the cell in front of us.
    # This will collect any primitive that is present and, once all required
    # primitives are in the inventory, will also trigger the crafting at the
    # appropriate workshop.
    grid_shape = state.grid.shape[:2]  # (width, height)
    max_passes = 3
    for _ in range(max_passes):
        for y in range(grid_shape[1]):
            for x in range(grid_shape[0]):
                # Move to the cell (x, y)
                _move_to((x, y))

                # Try to use the cell we are facing
                actions.append(USE)
                env.step(USE)
                state = env._current_state

                # Check if we have already crafted the goal item
                if state.satisfies("", goal_idx):
                    return actions

    # If after the passes we still haven't satisfied the goal (unlikely),
    # fall back to a random walk until the goal is met or a large step limit
    # is reached.
    import random
    step_limit = 1000
    for _ in range(step_limit):
        if state.satisfies("", goal_idx):
            break
        act = random.choice([DOWN, UP, LEFT, RIGHT, USE])
        actions.append(act)
        env.step(act)
        state = env._current_state

    return actions

