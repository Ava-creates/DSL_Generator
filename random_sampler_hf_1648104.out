"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that, when executed in the given CraftWorld
  environment, will result in the agent possessing a ``stick`` in its
  inventory.

  The implementation works generically for any CraftWorld instance:
    1. Look up the recipe for ``stick``.
    2. For each required primitive, move to the nearest cell that
       contains it and issue a ``USE`` action to collect it.
    3. After all primitives are collected, move to the appropriate
       workshop (as indicated by the ``_at`` field of the recipe) and
       issue a ``USE`` action to craft the stick.

  The function does **not** step the environment – it only returns the
  sequence of action indices.  The returned actions can be fed to
  ``env.step(action)`` in order.

  Note
  ----
  The exact mapping of action indices is taken from the default
  CraftWorld definition:

      0 – DOWN
      1 – UP
      2 – LEFT
      3 – RIGHT
      4 – USE

  Parameters
  ----------
  env : object
      An instance of ``CraftLab`` (or any wrapper that exposes the same
      attributes used below: ``world`` and ``_current_state``).

  Returns
  -------
  list[int]
      Ordered list of actions that will craft a stick.
  """
  # ------------------------------------------------------------------
  # Helper: simple Manhattan‑grid path planner (no obstacles considered)
  # ------------------------------------------------------------------
  def _plan_path(start, goal):
      """Return a list of movement actions (0‑3) to go from start to goal."""
      actions = []
      y, x = start
      gy, gx = goal
      # vertical moves first
      while y != gy:
          if gy > y:            # need to go DOWN
              actions.append(0)
              y += 1
          else:                 # need to go UP
              actions.append(1)
              y -= 1
      # then horizontal moves
      while x != gx:
          if gx > x:            # need to go RIGHT
              actions.append(3)
              x += 1
          else:                 # need to go LEFT
              actions.append(2)
              x -= 1
      return actions

  # ------------------------------------------------------------------
  # Begin main routine
  # ------------------------------------------------------------------
  world = env.world                     # CraftWorld instance
  state = env._current_state            # current CraftState
  grid = state.grid                      # (W, H, n_kinds) array
  pos = state.pos                        # (y, x) tuple

  # 1️⃣  Identify the index of the target item (stick)
  stick_idx = world.cookbook.index['stick']

  # 2️⃣  Determine which primitives are required for one stick
  #     ``primitives_for`` returns a dict {primitive_idx: count}
  required = world.cookbook.primitives_for(stick_idx)

  # Container for the final action sequence
  plan = []

  # ------------------------------------------------------------------
  # 3️⃣  Collect each required primitive
  # ------------------------------------------------------------------
  for prim_idx, needed in required.items():
      for _ in range(needed):
          # locate all cells that currently contain the primitive
          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
          if prim_cells.size == 0:
              # No primitive left on the map – abort planning
              raise RuntimeError(f"Primitive {prim_idx} not found on the grid.")
          # pick the nearest one (Manhattan distance)
          dists = np.sum(np.abs(prim_cells - np.array(pos)), axis=1)
          target_cell = prim_cells[dists.argmin()]
          # move next to the cell (we stop on the cell itself – the
          # environment will still allow USE on the same location)
          plan.extend(_plan_path(pos, tuple(target_cell)))
          # collect it
          plan.append(4)                     # USE
          # Update our simulated position and grid so that the next
          # iteration works with the new state (lightweight copy).
          pos = tuple(target_cell)
          # remove the primitive from the grid (as if it were picked up)
          grid[pos[0], pos[1], prim_idx] = 0

  # ------------------------------------------------------------------
  # 4️⃣  Go to the workshop that can craft a stick and craft it
  # ------------------------------------------------------------------
  # The recipe dictionary may contain a special key "_at" that tells us
  # the required workshop kind (as a string, e.g. "workbench").
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get('_at')
  if workshop_name is not None:
      wk_idx = world.cookbook.index[workshop_name]
      wk_cells = np.argwhere(grid[:, :, wk_idx] > 0)
      if wk_cells.size == 0:
          raise RuntimeError(f"Workshop '{workshop_name}' not found on the grid.")
      dists = np.sum(np.abs(wk_cells - np.array(pos)), axis=1)
      wk_target = wk_cells[dists.argmin()]
      plan.extend(_plan_path(pos, tuple(wk_target)))
      plan.append(4)                         # USE to craft the stick

  return plan


