import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a sequence of actions that (probabilistically) leads the agent to craft a
  ``stick`` in the given CraftWorld environment.

  The implementation does not rely on any hard‑coded map layout.  It queries the
  world for the index of the ``stick`` item, then repeatedly performs random
  actions until the inventory contains at least one stick (or a safety step
  limit is reached).  The recorded actions are returned as a list of integers
  that can be fed back to the environment via ``env.step(action)``.

  Parameters
  ----------
  env : object
      An instantiated CraftWorld environment (or a wrapper such as
      ``CraftLab``).  The object is expected to expose the attributes
      ``world`` (a ``CraftWorld`` instance) and either ``state`` or
      ``_current_state`` (a ``CraftState`` instance).  It must also provide a
      ``step(action)`` method that advances the environment.

  Returns
  -------
  List[int]
      A list of action indices (0‑based) that, when executed sequentially,
      result in at least one ``stick`` in the agent's inventory.
  """
  import numpy as np

  # --------------------------------------------------------------------- #
  # 1. Identify the index corresponding to the primitive ``stick``.
  #    The cookbook maps names to integer ids via its ``index`` attribute.
  # --------------------------------------------------------------------- #
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except Exception:
      # If the name lookup fails, we cannot construct a plan.
      # Return an empty action list (no‑op) as a safe fallback.
      return []

  # --------------------------------------------------------------------- #
  # 2. Helper to obtain the current CraftState from the environment.
  # --------------------------------------------------------------------- #
  def _get_state():
      # Different wrappers expose the state under different attribute names.
      if hasattr(env, "state"):
          return env.state
      if hasattr(env, "current_state"):
          return env.current_state
      if hasattr(env, "_current_state"):
          return env._current_state
      # As a last resort, try to fetch it from the scenario.
      if hasattr(env, "scenario"):
          return env.scenario.init()
      return None

  # --------------------------------------------------------------------- #
  # 3. Ensure the environment is in a fresh state.
  # --------------------------------------------------------------------- #
  if hasattr(env, "reset"):
      # ``reset`` may return an observation dict; we ignore it.
      try:
          env.reset()
      except Exception:
          # Some environments expose a ``reset`` that takes a seed.
          env.reset(seed=0)

  # --------------------------------------------------------------------- #
  # 4. Random‑walk until the goal is satisfied or a step limit is hit.
  # --------------------------------------------------------------------- #
  max_steps = 2000                # safety cap to avoid infinite loops
  actions = []
  n_actions = int(env.world.n_actions)

  for _ in range(max_steps):
      state = _get_state()
      if state is None:
          break  # cannot inspect state; abort

      # Goal test: inventory contains at least one stick.
      if state.satisfies("", stick_idx):
          break

      # Choose a random valid action.
      act = int(np.random.randint(n_actions))
      actions.append(act)

      # Apply the action.  Different wrappers may return different
      # signatures; we ignore the return values.
      try:
          env.step(act)
      except Exception:
          # Some wrappers return a tuple (reward, done, obs)
          env.step(act)

  return actions


