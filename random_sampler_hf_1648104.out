import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a deterministic list of actions that makes a ``stick`` in the given
  CraftWorld environment.

  The function works by:
  1. Resetting the environment.
  2. Querying the recipe for ``stick`` to find required primitive items and the
     workshop (if any) where the stick must be crafted.
  3. Repeatedly moving the agent to the nearest cell that contains a needed
     primitive, using the ``USE`` action to pick it up.
  4. Finally moving to the workshop (if required) and invoking ``USE`` once
     more to craft the stick.

  The returned list can be fed back to the environment via successive calls
  to ``env.step(action)``.  The implementation assumes the standard action
  ordering used by ``CraftLab``:

      0 → DOWN
      1 → UP
      2 → LEFT
      3 → RIGHT
      4 → USE
  """
  import numpy as np

  # --------------------------------------------------------------------- #
  # Helper utilities
  # --------------------------------------------------------------------- #
  # Mapping from relative movement to the action index used by CraftLab.
  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4

  def manhattan(a, b):
      return np.abs(a[0] - b[0]) + np.abs(a[1] - b[1])

  def nearest_position(grid, kind, cur_pos):
      """Return the closest (row, col) that contains ``kind`` or ``None``."""
      locations = np.argwhere(grid[:, :, kind] > 0)
      if locations.size == 0:
          return None
      dists = np.apply_along_axis(lambda p: manhattan(p, cur_pos), 1, locations)
      return tuple(locations[dists.argmin()])

  def move_towards(cur, target):
      """Yield actions that move from ``cur`` towards ``target`` (Manhattan)."""
      y, x = cur
      ty, tx = target
      while (y, x) != (ty, tx):
          if y < ty:
              yield ACTION_DOWN
              y += 1
          elif y > ty:
              yield ACTION_UP
              y -= 1
          elif x < tx:
              yield ACTION_RIGHT
              x += 1
          elif x > tx:
              yield ACTION_LEFT
              x -= 1

  # --------------------------------------------------------------------- #
  # Initialise / reset environment
  # --------------------------------------------------------------------- #
  # ``env.reset`` returns the first observation but we only need the internal
  # state that the environment stores.
  env.reset()
  actions = []

  # Shortcut to the underlying world / cookbook objects.
  world = env.world                     # CraftWorld instance
  cookbook = world.cookbook             # Cookbook instance
  state = env._current_state            # CraftState instance (current)

  # --------------------------------------------------------------------- #
  # Identify the recipe for ``stick``
  # --------------------------------------------------------------------- #
  try:
      stick_idx = cookbook.index["stick"]
  except KeyError:                      # pragma: no cover
      # If the environment does not contain a ``stick`` item we simply
      # return an empty action list – the caller will treat this as a
      # no‑op scenario.
      return actions

  recipe = cookbook.recipes.get(stick_idx, {})
  # Ingredients are everything except the special ``_at`` key.
  ingredients = {k: v for k, v in recipe.items() if k != "_at"}
  workshop_kind = recipe.get("_at", None)

  # --------------------------------------------------------------------- #
  # Collect all required primitives
  # --------------------------------------------------------------------- #
  for kind, needed_cnt in ingredients.items():
      # Keep collecting until we have enough of this kind in the inventory.
      while state.inventory[kind] < needed_cnt:
          # Find the nearest cell containing the needed primitive.
          target = nearest_position(state.grid, kind, state.pos)
          if target is None:            # pragma: no cover
              # No more instances of this primitive are present – cannot
              # continue.  Break out and let the caller deal with the
              # incomplete plan.
              break

          # Move step‑by‑step towards the target cell.
          for act in move_towards(state.pos, target):
              obs, _, _, _ = env.step(act)   # ignore returned values
              actions.append(act)
              state = env._current_state

          # We are now standing on the cell that holds the primitive.
          # Use the ``USE`` action to pick it up.
          obs, _, _, _ = env.step(ACTION_USE)
          actions.append(ACTION_USE)
          state = env._current_state

  # --------------------------------------------------------------------- #
  # Craft the stick at the required workshop (if any)
  # --------------------------------------------------------------------- #
  if workshop_kind is not None:
      # Move to the nearest workshop cell.
      target = nearest_position(state.grid, workshop_kind, state.pos)
      if target is not None:
          for act in move_towards(state.pos, target):
              obs, _, _, _ = env.step(act)
              actions.append(act)
              state = env._current_state

      # Finally, invoke ``USE`` to perform the crafting action.
      obs, _, _, _ = env.step(ACTION_USE)
      actions.append(ACTION_USE)
      state = env._current_state

  # --------------------------------------------------------------------- #
  # Return the accumulated action list.
  # --------------------------------------------------------------------- #
  return actions


