import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will make a **stick** in the given
  CraftWorld environment.

  The implementation works for any version of the environment that follows
  the API described in the prompt:

  * ``env.world`` is a :class:`CraftWorld` instance.
  * ``env.world.cookbook`` provides the recipe information.
  * ``env._current_state`` holds the current :class:`CraftState`.
  * The action space is assumed to be:
        0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT, 4 – USE

  The algorithm is:

  1.  Look up the index of the goal item (``stick``).
  2.  Retrieve the primitive requirements for that goal via
      ``cookbook.primitives_for``.
  3.  For each required primitive (and the required count) find a cell
      that contains it and plan a shortest path from the agent’s current
      position to that cell, avoiding non‑grabbable entities.
  4.  Append the movement actions for the path and a ``USE`` action to
      collect the primitive.
  5.  After all primitives have been collected, move to the workshop
      required for the final crafting step (the ``_at`` field of the
      recipe) and issue a final ``USE`` to craft the stick.

  The function returns a flat ``list[int]`` containing the actions.
  """
  # ------------------------------------------------------------------ #
  # Helper utilities
  # ------------------------------------------------------------------ #
  import collections

  # Mapping from (dx, dy) to the action index expected by the environment.
  # The mapping follows the convention used by the original CraftWorld:
  #   0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT
  DIR_TO_ACTION = {
      (0, 1): 0,   # down  (y+1)
      (0, -1): 1,  # up    (y-1)
      (-1, 0): 2,  # left  (x-1)
      (1, 0): 3,   # right (x+1)
  }

  def bfs(start, goal_cells, walkable):
      """Bread‑first search returning a list of positions from ``start`` to
      the nearest cell in ``goal_cells`` (both given as (x, y) tuples).

      ``walkable`` is a 2‑D boolean array where ``True`` indicates that the
      agent can step on the cell.
      """
      w, h = walkable.shape
      q = collections.deque([start])
      prev = {start: None}
      while q:
          cur = q.popleft()
          if cur in goal_cells:
              # reconstruct path
              path = []
              while cur != start:
                  path.append(cur)
                  cur = prev[cur]
              path.reverse()
              return path
          x, y = cur
          for dx, dy in DIR_TO_ACTION.keys():
              nx, ny = x + dx, y + dy
              if 0 <= nx < w and 0 <= ny < h and walkable[nx, ny]:
                  nxt = (nx, ny)
                  if nxt not in prev:
                      prev[nxt] = cur
                      q.append(nxt)
      raise RuntimeError("No reachable goal cell found.")

  # ------------------------------------------------------------------ #
  # 1. Identify the goal (stick) and its primitive requirements
  # ------------------------------------------------------------------ #
  cookbook = env.world.cookbook
  stick_idx = cookbook.index["stick"]          # index of the goal item
  primitive_requirements = cookbook.primitives_for(stick_idx)
  # primitive_requirements: {primitive_idx: count, ...}

  # ------------------------------------------------------------------ #
  # 2. Determine static information about the world layout
  # ------------------------------------------------------------------ #
  state = env._current_state
  grid = state.grid                               # (W, H, n_kinds)
  W, H, _ = grid.shape

  # Cells that are blocked for movement: any non‑zero entry that is *not*
  # a primitive (i.e. belongs to the set of non‑grabbable entities).
  # ``env.world.non_grabbable_indices`` holds the set of such indices.
  blocked = np.zeros((W, H), dtype=bool)
  for idx in env.world.non_grabbable_indices:
      blocked |= grid[:, :, idx] > 0
  # The agent can walk on empty cells and on cells that contain primitives
  # (they are pick‑up-able) – we treat those as walkable.
  walkable = ~blocked

  # ------------------------------------------------------------------ #
  # 3. Plan actions to collect each required primitive
  # ------------------------------------------------------------------ #
  actions = []
  cur_pos = state.pos  # (x, y)

  for prim_idx, count in primitive_requirements.items():
      # locate *all* cells that currently contain this primitive
      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
      prim_cells = [tuple(c) for c in prim_cells]

      if not prim_cells:
          raise RuntimeError(f"Primitive {cookbook.index.get(prim_idx, prim_idx)} "
                             "not present in the current grid.")

      for _ in range(count):
          # Find the nearest instance of the primitive
          path = bfs(cur_pos, set(prim_cells), walkable)

          # Convert the path (list of positions) into movement actions
          for (x0, y0), (x1, y1) in zip([cur_pos] + path[:-1], path):
              dx, dy = x1 - x0, y1 - y0
              actions.append(DIR_TO_ACTION[(dx, dy)])
              cur_pos = (x1, y1)

          # At the primitive location we issue a USE action to pick it up
          actions.append(4)  # USE
          # After picking up, the primitive disappears from the grid; we
          # update our local view so that future path‑finding does not treat
          # it as an obstacle.
          grid[cur_pos[0], cur_pos[1], prim_idx] = 0

          # Remove the used cell from the list (if multiple of the same
          # primitive are required we may need to come back to another cell)
          prim_cells = [c for c in prim_cells if c != cur_pos]

          # If we still need more of this primitive but have exhausted the
          # known cells, we raise an error – in a well‑formed scenario this
          # should not happen.
          if not prim_cells and _ < count - 1:
              raise RuntimeError("Not enough instances of required primitive.")

  # ------------------------------------------------------------------ #
  # 4. Move to the appropriate workshop and craft the stick
  # ------------------------------------------------------------------ #
  # The workshop name is stored under the special key "_at" in the recipe.
  recipe = cookbook.recipes[stick_idx]
  workshop_name = recipe["_at"]
  workshop_idx = cookbook.index[workshop_name]

  # Locate the workshop cell(s) – there should be at least one.
  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
  if len(workshop_cells) == 0:
      raise RuntimeError(f"Workshop '{workshop_name}' not found in the grid.")
  # Choose the closest workshop cell
  workshop_cells = [tuple(c) for c in workshop_cells]
  path = bfs(cur_pos, set(workshop_cells), walkable)

  for (x0, y0), (x1, y1) in zip([cur_pos] + path[:-1], path):
      dx, dy = x1 - x0, y1 - y0
      actions.append(DIR_TO_ACTION[(dx, dy)])
      cur_pos = (x1, y1)

  # Final USE to craft the stick
  actions.append(4)  # USE

  return actions


