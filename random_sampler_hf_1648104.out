"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a simple action sequence that collects the required primitives for a
  ``stick`` and then crafts it at the appropriate workshop.

  This implementation makes a number of simplifying assumptions:
  * The environment follows the ``CraftWorld`` API described in the prompt.
  * Action indices follow the mapping: DOWN→0, UP→1, LEFT→2, RIGHT→3, USE→4.
  * The grid is static (i.e., primitives do not move) and the agent can move
    freely through empty cells.
  * There is at least one instance of each required primitive and of the
    required workshop on the map.

  The function works by:
  1. Looking up the index of the ``stick`` item.
  2. Querying the recipe to obtain required primitive kinds and the workshop
     index (``_at`` entry).
  3. For each required primitive, moving to the first available cell that
     contains it and issuing a ``USE`` action to pick it up.
  4. Finally moving to a workshop cell and issuing ``USE`` to craft the stick.

  The returned list can be fed directly to ``env.step`` in a loop.
  """
  import numpy as np

  # -------------------------------------------------------------------------
  # Helper: translate a Manhattan move into actions.
  # -------------------------------------------------------------------------
  def move_to(cur_pos, target_pos, action_list):
      """
      Append actions that move from ``cur_pos`` to ``target_pos`` using
      Manhattan (grid) moves.  The function mutates ``action_list`` and returns
      the new position.
      """
      x, y = cur_pos
      tx, ty = target_pos

      # Move in x direction (columns) – LEFT/RIGHT
      while x < tx:
          action_list.append(3)   # RIGHT
          x += 1
      while x > tx:
          action_list.append(2)   # LEFT
          x -= 1

      # Move in y direction (rows) – DOWN/UP
      while y < ty:
          action_list.append(0)   # DOWN
          y += 1
      while y > ty:
          action_list.append(1)   # UP
          y -= 1

      return (x, y)

  # -------------------------------------------------------------------------
  # 1. Identify the stick index and its recipe.
  # -------------------------------------------------------------------------
  world = env.world
  scenario = env.scenario

  # Index of the target item (stick)
  stick_idx = world.cookbook.index["stick"]

  # Full recipe dictionary for the stick (may contain "_at" entry)
  recipe = world.cookbook.recipes.get(stick_idx, {})

  # Separate primitive requirements from the special keys (e.g., "_at")
  primitive_reqs = {k: v for k, v in recipe.items() if not k.startswith("_")}
  workshop_idx = recipe.get("_at")  # workshop where crafting must occur

  # -------------------------------------------------------------------------
  # 2. Locate all entities on the static initial grid.
  # -------------------------------------------------------------------------
  grid = scenario.init_grid  # shape (W, H, n_kinds)
  # Current agent position (start)
  cur_pos = tuple(scenario.init_pos)

  actions = []

  # -------------------------------------------------------------------------
  # 3. Collect each required primitive.
  # -------------------------------------------------------------------------
  for prim_idx, needed in primitive_reqs.items():
      # Find all cells that currently contain this primitive.
      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)

      # Simple strategy: take the first ``needed`` cells (no path planning).
      for i in range(needed):
          if i >= len(prim_cells):
              # Not enough primitives on the map – abort early.
              break
          target = tuple(prim_cells[i])
          # Move to the primitive location.
          cur_pos = move_to(cur_pos, target, actions)
          # Pick it up.
          actions.append(4)   # USE
          # After collection, we could update the grid to reflect the removal,
          # but for the purpose of generating a static action list it is not
          # required.

  # -------------------------------------------------------------------------
  # 4. Move to the workshop and craft the stick.
  # -------------------------------------------------------------------------
  if workshop_idx is not None:
      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
      if len(workshop_cells) > 0:
          target = tuple(workshop_cells[0])
          cur_pos = move_to(cur_pos, target, actions)
          actions.append(4)   # USE to craft

  return actions


