import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a ``stick`` in the given CraftLab
  environment.

  The function works generically:
  1.  Looks up the recipe for ``stick`` in the world's ``Cookbook``.
  2.  Collects all required primitive items by moving to the closest cell
      that contains each primitive and using the ``USE`` action.
  3.  Moves to the required workshop (specified by ``_at`` in the recipe)
      and performs ``USE`` again to craft the stick.

  The returned list contains integer action ids defined by the environment:
      0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT, 4 – USE
  """
  import numpy as np

  # ------------------------------------------------------------------ #
  # Helper: Manhattan‑move from current position to a target position.
  # ------------------------------------------------------------------ #
  def move_actions(cur, target):
      """Return a list of movement actions to go from cur -> target."""
      actions = []
      x, y = cur
      tx, ty = target
      # move in x direction
      while x != tx:
          if x < tx:
              actions.append(3)          # RIGHT
              x += 1
          else:
              actions.append(2)          # LEFT
              x -= 1
      # move in y direction
      while y != ty:
          if y < ty:
              actions.append(0)          # DOWN
              y += 1
          else:
              actions.append(1)          # UP
              y -= 1
      return actions, (x, y)

  # ------------------------------------------------------------------ #
  # Helper: Find the nearest cell (Manhattan distance) that contains a
  #         given kind index. Returns (x, y) or None if not present.
  # ------------------------------------------------------------------ #
  def nearest_of_kind(state_grid, kind_idx, start_pos):
      """Locate the closest cell containing `kind_idx`."""
      layer = state_grid[:, :, kind_idx]
      ys, xs = np.where(layer > 0)
      if len(xs) == 0:
          return None
      dists = np.abs(xs - start_pos[0]) + np.abs(ys - start_pos[1])
      best = np.argmin(dists)
      return (int(xs[best]), int(ys[best]))

  # ------------------------------------------------------------------ #
  # Main logic
  # ------------------------------------------------------------------ #
  world = env.world
  cookbook = world.cookbook

  # index of the goal item ``stick``
  stick_idx = cookbook.index["stick"]

  # recipe dictionary for the stick (ingredients + "_at")
  recipe = cookbook.recipes[stick_idx]

  # ------------------------------------------------------------------ #
  # 1. Gather required primitives.
  # ------------------------------------------------------------------ #
  # primitives are all entries except the special key "_at"
  primitive_requirements = {
      ing_idx: cnt
      for ing_idx, cnt in recipe.items()
      if ing_idx != "_at"
  }

  # current state information
  state = env._current_state
  grid = state.grid
  pos = state.pos                     # (x, y) tuple
  action_plan = []

  for kind_idx, needed_cnt in primitive_requirements.items():
      for _ in range(needed_cnt):
          target = nearest_of_kind(grid, kind_idx, pos)
          if target is None:
              # primitive not present – cannot continue; return what we have.
              return action_plan
          moves, pos = move_actions(pos, target)
          action_plan.extend(moves)
          # pick up the primitive
          action_plan.append(4)       # USE
          # after a successful USE the primitive disappears from the grid;
          # we do not need to update `grid` here because the environment
          # will handle it when the actions are executed.

  # ------------------------------------------------------------------ #
  # 2. Go to the workshop and craft the stick.
  # ------------------------------------------------------------------ #
  workshop_name = recipe["_at"]
  workshop_idx = cookbook.index[workshop_name]

  target = nearest_of_kind(grid, workshop_idx, pos)
  if target is not None:
      moves, pos = move_actions(pos, target)
      action_plan.extend(moves)
      action_plan.append(4)           # USE to craft the stick

  return action_plan


