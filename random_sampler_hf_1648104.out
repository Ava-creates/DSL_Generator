import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a sequence of actions to complete the task of making a stick 
  in the given CraftWorld environment. This function dynamically 
  determines the necessary steps based on the environment's state 
  and recipe requirements.

  Args:
      env: The CraftWorld environment instance.

  Returns:
      List[int]: A list of action indices that the agent can execute 
      to complete the task of making a stick.
  """
  # Helper function to find the position of a specific item in the grid
  def find_item(grid, item_index):
      positions = np.argwhere(grid[:, :, item_index] > 0)
      if len(positions) > 0:
          return tuple(positions[0])
      return None

  # Helper function to move to a target position
  def move_to(state, target):
      actions = []
      pos = np.array(state.pos)
      target = np.array(target)
      while not np.array_equal(pos, target):
          diff = target - pos
          if diff[0] > 0:
              actions.append(3)  # RIGHT
              pos[0] += 1
          elif diff[0] < 0:
              actions.append(2)  # LEFT
              pos[0] -= 1
          elif diff[1] > 0:
              actions.append(0)  # DOWN
              pos[1] += 1
          elif diff[1] < 0:
              actions.append(1)  # UP
              pos[1] -= 1
      return actions

  # Helper function to collect an item at the current position
  def collect(state):
      actions = []
      # Face any direction (e.g., down) and use the USE action
      actions.append(4)  # USE
      return actions

  # Initialize empty action sequence
  action_sequence = []

  # Get the initial state from the environment
  state = env.reset()
  grid = state.grid

  # Get indices for the relevant items
  stick_index = env.world.cookbook.index.index("stick")
  # Retrieve the recipe for the stick
  stick_recipe = env.world.cookbook.recipes.get(stick_index, {})
  # Get the primitive needed for the stick (e.g., "wood")
  primitive_index = None
  for ingredient, count in stick_recipe.items():
      if ingredient != "_at" and count > 0:
          primitive_index = ingredient
          break

  if primitive_index is None:
      # No primitive needed, just craft directly
      action_sequence.append(4)  # USE to craft
      return action_sequence

  # Find the primitive in the grid
  primitive_pos = find_item(grid, primitive_index)
  if primitive_pos is None:
      # Primitive not found, cannot proceed
      return action_sequence

  # Move to the primitive location
  action_sequence.extend(move_to(state, primitive_pos))

  # Collect the primitive
  action_sequence.extend(collect(state))

  # After collecting, the primitive should be in inventory
  # Move back to a workshop location for stick crafting
  workshop_index = stick_recipe.get("_at")
  workshop_pos = find_item(grid, workshop_index)
  if workshop_pos is None:
      # No workshop found, cannot craft
      return action_sequence

  # Move to the workshop
  action_sequence.extend(move_to(state, workshop_pos))

  # Craft the stick at the workshop
  action_sequence.append(4)  # USE to craft

  return action_sequence


