import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a ``stick`` in the given CraftWorld
  environment.

  The function:
    1. Looks up the recipe for ``stick`` in the world's cookbook.
    2. Finds the required primitive resources on the current grid.
    3. Moves the agent to each primitive, uses the ``USE`` action to pick it up,
       and finally moves to the required workshop (if any) and uses ``USE`` to
       craft the stick.

  The returned list contains action indices compatible with the environment's
  action space:

      0 – DOWN
      1 – UP
      2 – LEFT
      3 – RIGHT
      4 – USE

  The implementation is deliberately simple: it assumes the grid is free of
  obstacles that would block a Manhattan‑style path.  If a needed primitive or
  workshop cannot be found, the function simply skips that step.

  Parameters
  ----------
  env : object
      An instantiated CraftLab / CraftWorld environment.  It must expose the
      attributes ``_current_state`` (a ``CraftState``) and ``world`` (a
      ``CraftWorld``).

  Returns
  -------
  List[int]
      A list of action indices that, when executed sequentially, should
      result in the agent possessing at least one ``stick``.
  """
  import numpy as np

  # --------------------------------------------------------------------- #
  # Helper constants – match the environment's action specifications.
  # --------------------------------------------------------------------- #
  ACTION_DOWN = 0
  ACTION_UP = 1
  ACTION_LEFT = 2
  ACTION_RIGHT = 3
  ACTION_USE = 4

  # --------------------------------------------------------------------- #
  # Grab the current state and world objects.
  # --------------------------------------------------------------------- #
  state = env._current_state          # type: CraftState
  world = env.world                    # type: CraftWorld

  # --------------------------------------------------------------------- #
  # Identify the index for the target item (``stick``) and fetch its recipe.
  # --------------------------------------------------------------------- #
  stick_idx = world.cookbook.index["stick"]
  recipe = world.cookbook.recipes.get(stick_idx, {})

  # Separate primitive requirements from the workshop specification.
  primitives_needed = {k: v for k, v in recipe.items() if k != "_at"}
  workshop_idx = recipe.get("_at", None)

  actions = []          # final action list to be returned
  pos = state.pos       # current (x, y) position of the agent
  grid = state.grid     # (WIDTH, HEIGHT, n_kinds) occupancy tensor

  # --------------------------------------------------------------------- #
  # Utility: locate any cell that contains a given kind (primitive or workshop).
  # --------------------------------------------------------------------- #
  def locate_kind(kind):
      """Return the (x, y) coordinate of the first cell containing ``kind``."""
      locations = np.argwhere(grid[:, :, kind] > 0)
      if locations.size == 0:
          return None
      # ``np.argwhere`` returns rows as (x, y); keep the first match.
      return tuple(locations[0].tolist())

  # --------------------------------------------------------------------- #
  # Utility: generate a Manhattan path from the current position to ``target``.
  # --------------------------------------------------------------------- #
  def move_to(target):
      """Append actions that move the agent from ``pos`` to ``target``."""
      nonlocal pos, actions
      if target is None:
          return
      tx, ty = target
      x, y = pos

      # Move horizontally (x‑axis) first.
      while x < tx:
          actions.append(ACTION_RIGHT)
          x += 1
      while x > tx:
          actions.append(ACTION_LEFT)
          x -= 1

      # Then move vertically (y‑axis).
      while y < ty:
          actions.append(ACTION_DOWN)
          y += 1
      while y > ty:
          actions.append(ACTION_UP)
          y -= 1

      pos = (x, y)

  # --------------------------------------------------------------------- #
  # Collect all required primitives according to the recipe.
  # --------------------------------------------------------------------- #
  for kind, count in primitives_needed.items():
      for _ in range(count):
          loc = locate_kind(kind)
          if loc is None:
              # Primitive not found – skip this instance.
              continue
          move_to(loc)
          actions.append(ACTION_USE)   # pick up the primitive

  # --------------------------------------------------------------------- #
  # Finally, go to the workshop (if the recipe specifies one) and craft.
  # --------------------------------------------------------------------- #
  if workshop_idx is not None:
      workshop_loc = locate_kind(workshop_idx)
      if workshop_loc is not None:
          move_to(workshop_loc)
          actions.append(ACTION_USE)   # craft the stick

  return actions


