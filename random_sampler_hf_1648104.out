"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will collect the required primitives for a
  ``stick`` and then craft it at the appropriate workshop.

  The function works with a *reset* ``CraftLab`` environment (i.e. the
  environment already has an initial state).  It inspects the world
  description (``env.world``) and the current state (``env._current_state``)
  to plan a sequence of moves and ``USE`` actions.

  The action space is assumed to be:
      0 – DOWN   (dx = 0, dy = +1)
      1 – UP     (dx = 0, dy = -1)
      2 – LEFT   (dx = -1, dy = 0)
      3 – RIGHT  (dx = +1, dy = 0)
      4 – USE    (interact with the cell the agent is facing)

  The returned list can be fed directly to ``env.step`` in a loop.
  """
  import collections

  # ----------------------------------------------------------------------
  # Helper utilities
  # ----------------------------------------------------------------------
  ACTIONS = {
      0: (0, 1),   # DOWN
      1: (0, -1),  # UP
      2: (-1, 0),  # LEFT
      3: (1, 0)    # RIGHT
  }

  def in_bounds(x, y, w, h):
      return 0 <= x < w and 0 <= y < h

  def cell_has_kind(grid, x, y, kind):
      """True if the cell at (x, y) contains at least one entity of `kind`."""
      return grid[x, y, kind] > 0

  def cell_is_empty(grid, x, y):
      """A cell is empty when *all* kind‑layers are zero."""
      return not grid[x, y].any()

  def bfs_to_adjacent(start, target, grid):
      """
      Breadth‑first search for the shortest path from ``start`` to any empty
      cell that is orthogonally adjacent to ``target``.  Returns a tuple
      ``(path, facing)`` where ``path`` is a list of movement actions (0‑3)
      and ``facing`` is the direction (0‑3) the agent must have to be looking
      at ``target`` when it reaches the final cell.
      """
      w, h = grid.shape[0], grid.shape[1]
      q = collections.deque()
      q.append((start, []))
      visited = {start}

      while q:
          (x, y), actions = q.popleft()

          # are we adjacent to the target?
          if abs(x - target[0]) + abs(y - target[1]) == 1:
              # determine which direction we need to be facing
              dx, dy = target[0] - x, target[1] - y
              for act, (mx, my) in ACTIONS.items():
                  if (mx, my) == (dx, dy):
                      return actions, act
          # expand neighbours
          for act, (mx, my) in ACTIONS.items():
              nx, ny = x + mx, y + my
              if not in_bounds(nx, ny, w, h):
                  continue
              if (nx, ny) in visited:
                  continue
              if not cell_is_empty(grid, nx, ny):
                  continue
              visited.add((nx, ny))
              q.append(((nx, ny), actions + [act]))
      raise RuntimeError("No reachable adjacent cell found.")

  # ----------------------------------------------------------------------
  # Start planning
  # ----------------------------------------------------------------------
  state = env._current_state          # type: CraftState
  world = env.world                    # type: CraftWorld
  grid = state.grid.copy()             # current grid (will be updated locally)

  # ----------------------------------------------------------------------
  # Identify indices for stick, its recipe and required primitives
  # ----------------------------------------------------------------------
  stick_name = "stick"
  stick_idx = world.cookbook.index[stick_name]

  # recipe dict for the stick (ingredients + optional "_at")
  stick_recipe = world.cookbook.recipes[stick_idx]

  # workshop where the stick must be crafted
  workshop_idx = None
  if "_at" in stick_recipe:
      workshop_idx = stick_recipe["_at"]
      # If the stored value is a string name, resolve it to an index
      if isinstance(workshop_idx, str):
          workshop_idx = world.cookbook.index[workshop_idx]

  # primitive requirements (ignore the special "_at" key)
  primitive_reqs = {
      k: v for k, v in stick_recipe.items() if k != "_at"
  }

  actions_plan = []

  # ----------------------------------------------------------------------
  # Collect each required primitive the needed number of times
  # ----------------------------------------------------------------------
  for prim_idx, count in primitive_reqs.items():
      for _ in range(count):
          # locate the *nearest* primitive of this kind
          w, h = grid.shape[0], grid.shape[1]
          prim_positions = [
              (x, y) for x in range(w) for y in range(h)
              if cell_has_kind(grid, x, y, prim_idx)
          ]
          if not prim_positions:
              raise RuntimeError(f"Primitive {prim_idx} not found on the map.")

          # pick the closest one (Manhattan distance)
          px, py = min(
              prim_positions,
              key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])
          )

          # plan path to an adjacent cell
          path, facing = bfs_to_adjacent(state.pos, (px, py), grid)
          actions_plan.extend(path)

          # after the moves the agent's direction is the direction of the last
          # move; we must turn to ``facing`` before using.  The only way to
          # change direction without a dedicated turn action is to move one
          # step away and back.
          if path:
              last_move = path[-1]
              if last_move != facing:
                  # move one step opposite to the desired facing direction
                  opposite = {0: 1, 1: 0, 2: 3, 3: 2}[facing]
                  dx, dy = ACTIONS[opposite]
                  back_x, back_y = state.pos[0] + dx, state.pos[1] + dy
                  if in_bounds(back_x, back_y, w, h) and cell_is_empty(grid, back_x, back_y):
                      actions_plan.append(opposite)          # step away
                      actions_plan.append(facing)            # step forward (back to original)
                  else:
                      # If we cannot step away, just add a dummy move that
                      # keeps us inside the map (e.g., a left‑right pair)
                      actions_plan.append(opposite)
                      actions_plan.append(facing)

          # finally, USE to pick up the primitive
          actions_plan.append(4)  # USE
          # update local state to keep planning consistent
          # (remove the primitive from the grid and add to inventory)
          grid[px, py, prim_idx] = 0
          state.inventory[prim_idx] += 1
          # agent stays on the same cell after USE; position unchanged

  # ----------------------------------------------------------------------
  # Move to the workshop and craft the stick
  # ----------------------------------------------------------------------
  if workshop_idx is not None:
      # locate nearest workshop cell
      w, h = grid.shape[0], grid.shape[1]
      workshop_positions = [
          (x, y) for x in range(w) for y in range(h)
          if cell_has_kind(grid, x, y, workshop_idx)
      ]
      if not workshop_positions:
          raise RuntimeError("Required workshop not found on the map.")

      wx, wy = min(
          workshop_positions,
          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1])
      )
      # path to adjacent cell of the workshop
      path, facing = bfs_to_adjacent(state.pos, (wx, wy), grid)
      actions_plan.extend(path)

      # ensure correct facing as before
      if path and path[-1] != facing:
          opposite = {0: 1, 1: 0, 2: 3, 3: 2}[facing]
          dx, dy = ACTIONS[opposite]
          back_x, back_y = state.pos[0] + dx, state.pos[1] + dy
          if in_bounds(back_x, back_y, w, h) and cell_is_empty(grid, back_x, back_y):
              actions_plan.append(opposite)
              actions_plan.append(facing)
          else:
              actions_plan.append(opposite)
              actions_plan.append(facing)

      # USE to craft the stick
      actions_plan.append(4)  # USE

  return actions_plan


