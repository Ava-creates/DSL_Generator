import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  # Reset environment to start fresh
  obs = env.reset()
  # Determine the primitive needed for a stick (usually "tree")
  # Find the tree location in the grid
  tree_idx = env.world.cookbook.index("tree")
  # Simple BFS to find tree position
  from collections import deque
  start = env._current_state.pos
  visited = set()
  queue = deque([(start, [])])
  while queue:
      (x, y), path = queue.popleft()
      if (x, y) in visited:
          continue
      visited.add((x, y))
      # Check if tree is at this location
      if env._current_state.grid[x, y, tree_idx] > 0:
          # Move to tree and use action to collect
          actions = []
          # Convert path to actions (simple direction mapping)
          for (px, py) in path:
              if px > x: actions.append(3)  # LEFT
              elif px < x: actions.append(2)  # RIGHT
              if py > y: actions.append(1)  # UP
              elif py < y: actions.append(0)  # DOWN
          actions.append(4)  # USE to collect
          return actions
      # Add neighbors
      for dx, dy, a in [(-1,0,2),(1,0,3),(0,-1,0),(0,1,1)]:
          nx, ny = x+dx, y+dy
          if 0 <= nx < env.world.craft_scenario.grid.shape[0] and 0 <= ny < env.world.craft_scenario.grid.shape[1]:
              queue.append(((nx, ny), path+[(x, y)]))
  # If no tree found, return empty actions
  return []


