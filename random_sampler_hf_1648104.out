import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that will result in the agent possessing a
  ``stick`` in its inventory.

  The implementation works for any ``CraftWorld`` / ``CraftLab`` environment
  that follows the API described in the specification.  It extracts the
  recipe for ``stick`` from the world's ``Cookbook``, navigates to each required
  primitive, picks it up, then moves to the appropriate workshop and crafts
  the stick.

  The returned list contains integer action IDs as defined by the environment
  (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE).
  """
  # get indices
  idx_stick = env.world.cookbook.index["stick"]
  # find required primitives
  needed = env.world.cookbook.primitives_for(idx_stick)  # dict {prim_idx: count}
  actions = []

  # helper to find nearest cell containing a given kind
  def locate(kind_idx):
      grid = env._current_state.grid if hasattr(env, "_current_state") else env.scenario.init_grid
      # grid shape (W,H,K)
      w, h, _ = grid.shape
      pos = env._current_state.pos if hasattr(env, "_current_state") else env.scenario.init_pos
      # BFS to nearest cell with kind_idx
      from collections import deque
      visited = set()
      q = deque([(pos, [])])
      while q:
          (x, y), path = q.popleft()
          if (x, y) in visited:
              continue
          visited.add((x, y))
          if grid[x, y, kind_idx] > 0:
              return path
          # explore neighbours
          for a, (dx, dy) in enumerate([(0,1),(0,-1),(-1,0),(1,0)]):
              nx, ny = x+dx, y+dy
              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:
                  q.append(((nx, ny), path+[a]))
      return None

  # collect each primitive the required number of times
  for prim_idx, count in needed.items():
      for _ in range(count):
          path = locate(prim_idx)
          if path is None:
              continue
          actions.extend(path)
          actions.append(4)   # USE to pick up

  # move to workshop for stick if any (_at key)
  recipe = env.world.cookbook.recipes.get(idx_stick, {})
  workshop_name = recipe.get("_at")
  if workshop_name:
      wk_idx = env.world.cookbook.index[workshop_name]
      path = locate(wk_idx)
      if path:
          actions.extend(path)
  # finally craft
  actions.append(4)  # USE at workshop
  return actions


