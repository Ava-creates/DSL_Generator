import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that will cause the agent to craft a stick in the
  provided CraftWorld environment.
  The function first tries to use a built‑in planner (env.plan).  If the
  planner is not present it falls back to a very simple heuristic:
  it repeatedly executes the USE action (env.action_space['USE'] or 4)
  while moving randomly until a stick appears in the inventory.
  """
  # try planner
  if hasattr(env, "plan"):
      try:
          plan = env.plan("stick")
          return list(plan)
      except Exception:
          pass

  # determine action indices
  try:
      use_action = env.action_space["USE"]
  except Exception:
      # fallback to typical index 4
      use_action = 4
  # try moving actions
  move_actions = [0,1,2,3]  # DOWN,UP,LEFT,RIGHT typical order
  actions = []
  # simple loop limited steps
  max_steps = 200
  for _ in range(max_steps):
      # attempt to use (collect/craft)
      actions.append(use_action)
      # check if goal satisfied via env observation?
      # if env has method 'has_item' we can query, else break after max_steps
      if hasattr(env, "has_item"):
          if env.has_item("stick"):
              break
      # move randomly
      actions.append(np.random.choice(move_actions))
  return actions


