import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes the agent craft a ``stick`` in the
  given CraftWorld environment.

  The implementation is completely generic – it does **not** rely on any
  hard‑coded map layout.  It works by:

  1.  Querying the world’s ``Cookbook`` for the index of the goal item
      (``stick``) and the primitive ingredients required to craft it.
  2.  Repeatedly locating the closest cell that contains a required primitive,
      moving the agent there (using a shortest‑path BFS that respects blocked
      cells) and executing the ``USE`` action to pick it up.
  3.  After all ingredients have been collected, locating the appropriate
      workshop (if the recipe specifies one) and using ``USE`` there to craft
      the stick.
  4.  Returning the full sequence of action indices.

  The function assumes the standard action encoding used by the CraftWorld
  implementation:

      0 – DOWN
      1 – UP
      2 – LEFT
      3 – RIGHT
      4 – USE   (collect / craft)

  Parameters
  ----------
  env : object
      A running CraftWorld / CraftLab environment.  The function expects the
      environment to expose the following attributes (as defined in the
      code base description):

      * ``world`` – the ``CraftWorld`` instance.
      * ``_current_state`` – the current ``CraftState``.
      * ``task`` – a ``Task`` named‑tuple with a ``goal`` field that holds the
        integer index of the desired item.

  Returns
  -------
  List[int]
      A list of action indices that, when fed to ``env.step(action)`` in order,
      will result in the agent possessing at least one ``stick``.
  """
  import collections

  # --------------------------------------------------------------------- #
  # Helper functions
  # --------------------------------------------------------------------- #
  def bfs(start, target_kind):
      """
      Bread‑first search for the nearest cell that contains ``target_kind``.
      Returns a list of movement actions (DOWN/UP/LEFT/RIGHT) that bring the
      agent from ``start`` to the target cell, or ``None`` if no reachable
      cell exists.
      """
      W, H, K = state.grid.shape
      visited = np.full((W, H), False, dtype=bool)
      q = collections.deque()
      q.append((start, []))
      visited[start] = True

      # movement deltas and corresponding action indices
      moves = [((0, 1), 0),   # DOWN
               ((0, -1), 1),  # UP
               ((-1, 0), 2),  # LEFT
               ((1, 0), 3)]   # RIGHT

      while q:
          (x, y), path = q.popleft()
          # if the current cell contains the target kind, we are done
          if state.grid[x, y, target_kind] > 0:
              return path

          for (dx, dy), act in moves:
              nx, ny = x + dx, y + dy
              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                  # a cell is *blocked* if any non‑zero entry exists for a
                  # non‑grabbable kind (environment entities).  We treat a
                  # cell as passable if it contains only empty (0) or
                  # grabbable items.
                  cell = state.grid[nx, ny]
                  blocked = False
                  for kind_idx, cnt in enumerate(cell):
                      if cnt > 0 and kind_idx in world.non_grabbable_indices:
                          blocked = True
                          break
                  if not blocked:
                      visited[nx, ny] = True
                      q.append(((nx, ny), path + [act]))
      return None

  # --------------------------------------------------------------------- #
  # Main logic
  # --------------------------------------------------------------------- #
  world = env.world
  state = env._current_state

  # 1. Identify the goal index for “stick”.
  stick_idx = world.cookbook.index["stick"]
  # 2. Determine which primitives (and how many) are needed.
  primitives_needed = world.cookbook.primitives_for(stick_idx)

  actions = []

  # --------------------------------------------------------------------- #
  # Collect each required primitive.
  # --------------------------------------------------------------------- #
  for prim_idx, count in primitives_needed.items():
      for _ in range(count):
          # locate the nearest instance of this primitive
          path = bfs(state.pos, prim_idx)
          if path is None:
              raise RuntimeError(f"Cannot reach primitive {prim_idx}")

          # execute movement actions
          for act in path:
              obs, reward, done, info = env.step(act)
              actions.append(act)
              state = env._current_state   # update reference after the step

          # now we are on the cell containing the primitive – use it
          obs, reward, done, info = env.step(4)   # USE
          actions.append(4)
          state = env._current_state

  # --------------------------------------------------------------------- #
  # Craft the stick at the required workshop (if any).
  # --------------------------------------------------------------------- #
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at", None)

  if workshop_name is not None:
      workshop_idx = world.cookbook.index[workshop_name]
      path = bfs(state.pos, workshop_idx)
      if path is None:
          raise RuntimeError(f"Cannot reach workshop {workshop_name}")

      for act in path:
          obs, reward, done, info = env.step(act)
          actions.append(act)
          state = env._current_state

      # use the workshop to craft the stick
      obs, reward, done, info = env.step(4)   # USE
      actions.append(4)
      state = env._current_state
  else:
      # No specific workshop – a simple USE on the current cell crafts.
      obs, reward, done, info = env.step(4)
      actions.append(4)
      state = env._current_state

  return actions


