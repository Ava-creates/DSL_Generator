"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of action indices that will obtain a ``stick`` in the given
  CraftWorld environment.

  The implementation:
    1. Reads the recipe for ``stick`` from the world's cookbook.
    2. For each required primitive, finds a (currently) reachable cell that
       contains the primitive, moves to it with Manhattan moves, and issues a
       ``USE`` action to pick it up.
    3. Moves to the workshop (if the recipe specifies one) and issues a final
       ``USE`` to craft the stick.

  The returned list can be fed directly to ``env.step(action)``.
  """
  import numpy as np

  # ------------------------------------------------------------------ #
  # Helper: Manhattan movement actions (ignores obstacles for simplicity)
  # ------------------------------------------------------------------ #
  def _move_actions(cur, target, move_map):
      """Return a list of movement actions that brings ``cur`` to ``target``."""
      cx, cy = cur
      tx, ty = target
      actions = []

      while cx < tx:
          actions.append(move_map["RIGHT"])
          cx += 1
      while cx > tx:
          actions.append(move_map["LEFT"])
          cx -= 1
      while cy < ty:
          actions.append(move_map["DOWN"])
          cy += 1
      while cy > ty:
          actions.append(move_map["UP"])
          cy -= 1
      return actions, (cx, cy)

  # ------------------------------------------------------------------ #
  # Retrieve recipe information
  # ------------------------------------------------------------------ #
  world = env.world                     # CraftWorld instance
  cookbook = world.cookbook
  stick_idx = cookbook.index["stick"]   # integer index of the goal item

  recipe = cookbook.recipes.get(stick_idx, {})
  if not recipe:
      raise ValueError("No recipe found for 'stick'.")

  # Workshop location (may be None)
  workshop_name = recipe.get("_at")

  # Primitive requirements: keep only integer keys (kind indices)
  primitive_requirements = {
      k: v for k, v in recipe.items()
      if isinstance(k, int) and k != "_key"
  }

  # ------------------------------------------------------------------ #
  # Action mapping
  # ------------------------------------------------------------------ #
  action_spec = env.action_specs()      # e.g. {"DOWN":0, "UP":1, ...}
  move_map = {
      "RIGHT": action_spec["RIGHT"],
      "LEFT":  action_spec["LEFT"],
      "DOWN":  action_spec["DOWN"],
      "UP":    action_spec["UP"],
  }
  USE = action_spec["USE"]

  # ------------------------------------------------------------------ #
  # Planning – collect primitives
  # ------------------------------------------------------------------ #
  cur_pos = env._current_state.pos      # (x, y)
  grid = env._current_state.grid.copy()  # copy so we can modify it locally

  plan = []

  for kind_idx, needed in primitive_requirements.items():
      for _ in range(needed):
          # locate all cells holding this primitive
          locations = np.argwhere(grid[:, :, kind_idx] > 0)
          if locations.size == 0:
              raise RuntimeError(
                  f"Required primitive (kind {kind_idx}) not present in the grid."
              )
          # pick the location with minimal Manhattan distance to current pos
          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
          nearest_idx = np.argmin(dists)
          target = tuple(locations[nearest_idx])  # (x, y)

          # move to the primitive and pick it up
          moves, cur_pos = _move_actions(cur_pos, target, move_map)
          plan.extend(moves)
          plan.append(USE)               # collect

          # simulate removal of the primitive from the grid copy
          grid[target[0], target[1], kind_idx] = 0

  # ------------------------------------------------------------------ #
  # Planning – go to workshop and craft the stick
  # ------------------------------------------------------------------ #
  if workshop_name is not None:
      workshop_idx = cookbook.index[workshop_name]
      workshop_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
      if workshop_locs.size == 0:
          raise RuntimeError(f"Workshop '{workshop_name}' not found in the grid.")
      # choose the first workshop location (any works)
      workshop_pos = tuple(workshop_locs[0])

      moves, cur_pos = _move_actions(cur_pos, workshop_pos, move_map)
      plan.extend(moves)
      plan.append(USE)                   # craft the stick

  return plan


