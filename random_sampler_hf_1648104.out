"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a ``stick`` in the given CraftWorld
  environment.

  The function works for any ``CraftLab`` / ``CraftWorld`` environment that
  follows the API described in the prompt.  It performs a very simple
  “go‑to‑resource → collect → go‑to‑workshop → craft” loop:

  1.  Look up the index of the goal item (``stick``) in the world’s
      ``Cookbook``.
  2.  Determine which primitive kinds are required to craft one stick using
      ``Cookbook.primitives_for``.
  3.  Repeatedly move the agent until it has collected all required primitives.
  4.  Move the agent to the workshop required for the ``stick`` recipe and
      perform the ``USE`` action to craft the item.
  5.  Stop as soon as the inventory contains at least one ``stick`` or a
      safety step limit is reached.

  The returned list contains integer action IDs that can be fed directly to
  ``env.step(action)``.
  """
  # --------------------------------------------------------------------- #
  # Helper utilities
  # --------------------------------------------------------------------- #
  def _action_id(name):
      """Translate action name (e.g. 'UP') to the integer ID used by the env."""
      return env.action_specs()[name]

  ACTION_UP = _action_id("UP")
  ACTION_DOWN = _action_id("DOWN")
  ACTION_LEFT = _action_id("LEFT")
  ACTION_RIGHT = _action_id("RIGHT")
  ACTION_USE = _action_id("USE")

  # Mapping from a direction delta to the corresponding action ID
  DIR_TO_ACTION = {
      (0, -1): ACTION_UP,
      (0, 1): ACTION_DOWN,
      (-1, 0): ACTION_LEFT,
      (1, 0): ACTION_RIGHT,
  }

  # --------------------------------------------------------------------- #
  # Initialise the environment and obtain static information
  # --------------------------------------------------------------------- #
  # Reset the environment to obtain the initial state
  obs = env.reset()
  state = env._current_state                     # type: CraftState
  world = env.world                               # type: CraftWorld
  cookbook = world.cookbook

  # Index of the goal item (stick)
  stick_idx = cookbook.index["stick"]

  # Primitive requirements for a single stick (dict {kind_idx: count})
  primitive_reqs = cookbook.primitives_for(stick_idx)

  # Identify the workshop required for the stick recipe.
  # The recipe dict contains a special key "_at" that stores the workshop name.
  workshop_name = cookbook.recipes[stick_idx].get("_at")
  if workshop_name is None:
      # Fallback – if the recipe does not specify a workshop, we assume the
      # workshop is the same as the goal name (many recipes follow that
      # convention).
      workshop_name = "workshop"
  workshop_idx = cookbook.index[workshop_name]

  # --------------------------------------------------------------------- #
  # Simple path‑finding utilities
  # --------------------------------------------------------------------- #
  def _find_nearest(kind_idx):
      """
      Return the (x, y) coordinate of the closest cell that contains an
      entity of ``kind_idx``.  If none are present, return ``None``.
      """
      positions = np.argwhere(state.grid[:, :, kind_idx] > 0)
      if positions.size == 0:
          return None
      # Manhattan distance to the agent
      dists = np.abs(positions[:, 0] - state.pos[0]) + np.abs(positions[:, 1] - state.pos[1])
      nearest = positions[np.argmin(dists)]
      return tuple(nearest.tolist())

  def _move_towards(target):
      """
      Produce a single movement action that brings the agent one step closer
      to ``target`` (a tuple ``(x, y)``).  If the agent is already on the target
      cell, ``None`` is returned.
      """
      if target is None or state.pos == target:
          return None
      dx = target[0] - state.pos[0]
      dy = target[1] - state.pos[1]

      # Prefer horizontal movement if both axes differ
      if dx != 0:
          step = (np.sign(dx), 0)
      else:
          step = (0, np.sign(dy))

      return DIR_TO_ACTION[step]

  # --------------------------------------------------------------------- #
  # Main planning loop
  # --------------------------------------------------------------------- #
  actions = []
  MAX_STEPS = 1000                     # safety guard to avoid infinite loops

  while len(actions) < MAX_STEPS:
      # 1. Check if we already have a stick → finish
      if state.inventory[stick_idx] > 0:
          break

      # 2. Determine which primitive we still need
      needed = {}
      for kind_idx, cnt in primitive_reqs.items():
          have = state.inventory[kind_idx]
          if have < cnt:
              needed[kind_idx] = cnt - have

      # 3. If we still need primitives, head towards the nearest missing one
      if needed:
          # Pick the primitive with the smallest Manhattan distance
          nearest_kind = min(needed.keys(),
                             key=lambda k: np.min(
                                 np.abs(np.argwhere(state.grid[:, :, k] > 0) -
                                        np.array(state.pos)).sum(axis=1)
                                 if np.argwhere(state.grid[:, :, k] > 0).size else 1e9))
          target_pos = _find_nearest(nearest_kind)

          # If we are already adjacent (including the same cell) to the primitive,
          # use the USE action to collect it.
          if target_pos is not None and state.next_to(nearest_kind):
              actions.append(ACTION_USE)
              reward, new_state = state.step(ACTION_USE)
              state = new_state
              continue

          # Otherwise, move one step towards it.
          move_action = _move_towards(target_pos)
          if move_action is not None:
              actions.append(move_action)
              reward, new_state = state.step(move_action)
              state = new_state
              continue
          else:
              # No reachable primitive – break to avoid deadlock.
              break
      else:
          # 4. All primitives collected – go to the workshop and craft.
          workshop_pos = _find_nearest(workshop_idx)

          # If we are next to the workshop, craft the stick.
          if workshop_pos is not None and state.next_to(workshop_idx):
              actions.append(ACTION_USE)
              reward, new_state = state.step(ACTION_USE)
              state = new_state
              continue

          # Otherwise, move towards the workshop.
          move_action = _move_towards(workshop_pos)
          if move_action is not None:
              actions.append(move_action)
              reward, new_state = state.step(move_action)
              state = new_state
              continue
          else:
              # No workshop found – abort.
              break

  return actions


