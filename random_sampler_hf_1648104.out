import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that lets the agent craft a ``stick`` in the
  provided :class:`CraftWorld` environment.

  The implementation works generically:
  1.  Look up the recipe for ``stick``.
  2.  Locate the required primitive items in the initial grid.
  3.  Move the agent to each primitive, ``USE`` to pick it up.
  4.  Move to the appropriate workshop (``_at`` field of the recipe) and
      ``USE`` to craft the stick.

  Actions follow the CraftWorld convention:
      0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT, 4 – USE
  """
  # --------------------------------------------------------------------- #
  # 1.  Resolve indices for the goal (stick) and its recipe.
  # --------------------------------------------------------------------- #
  world = env                     # ``env`` is a CraftWorld instance
  idx = world.cookbook.index
  stick_idx = idx["stick"]        # index of the goal item

  # recipe for the stick (may be empty if stick is a primitive)
  recipe = world.cookbook.recipes.get(stick_idx, {})

  # workshop where the stick must be crafted (if any)
  workshop_kind = recipe.get("_at")

  # primitive ingredients (exclude the special ``_at`` key)
  needed = {k: v for k, v in recipe.items() if k != "_at"}

  # --------------------------------------------------------------------- #
  # 2.  Build a scenario that contains the goal – this gives us the grid
  #     layout and the agent's starting position.
  # --------------------------------------------------------------------- #
  scenario = world.sample_scenario_with_goal(stick_idx)
  grid = scenario.init_grid
  pos = scenario.init_pos          # (row, col)

  # --------------------------------------------------------------------- #
  # 3.  Helper to convert a Manhattan move into action indices.
  # --------------------------------------------------------------------- #
  def _move_actions(src, dst):
      """Return a list of actions that moves from src to dst (Manhattan)."""
      sx, sy = src
      dx, dy = dst
      acts = []

      # vertical movement
      while sx < dx:
          acts.append(0)   # DOWN
          sx += 1
      while sx > dx:
          acts.append(1)   # UP
          sx -= 1

      # horizontal movement
      while sy < dy:
          acts.append(3)   # RIGHT
          sy += 1
      while sy > dy:
          acts.append(2)   # LEFT
          sy -= 1
      return acts

  # --------------------------------------------------------------------- #
  # 4.  Pre‑compute locations of every primitive kind we need.
  # --------------------------------------------------------------------- #
  primitive_locs = {}
  for kind_idx in needed:
      locs = np.argwhere(grid[:, :, kind_idx] == 1)
      primitive_locs[kind_idx] = [tuple(p) for p in locs]

  # workshop locations (if required)
  workshop_locs = []
  if workshop_kind is not None:
      ws = np.argwhere(grid[:, :, workshop_kind] == 1)
      workshop_locs = [tuple(p) for p in ws]

  # --------------------------------------------------------------------- #
  # 5.  Collect all required primitives.
  # --------------------------------------------------------------------- #
  actions = []
  for kind_idx, count in needed.items():
      for _ in range(count):
          # If we run out of known locations we simply abort – the
          # environment will handle the failure.
          if not primitive_locs[kind_idx]:
              continue

          # Choose the nearest available instance.
          distances = [
              abs(pos[0] - p[0]) + abs(pos[1] - p[1])
              for p in primitive_locs[kind_idx]
          ]
          nearest_i = int(np.argmin(distances))
          target = primitive_locs[kind_idx][nearest_i]

          # Move to the primitive and pick it up.
          actions.extend(_move_actions(pos, target))
          pos = target
          actions.append(4)               # USE → pick up

          # Remove this instance so we don't try to collect it again.
          primitive_locs[kind_idx].pop(nearest_i)

  # --------------------------------------------------------------------- #
  # 6.  Go to the workshop (if one exists) and craft the stick.
  # --------------------------------------------------------------------- #
  if workshop_locs:
      distances = [
          abs(pos[0] - p[0]) + abs(pos[1] - p[1])
          for p in workshop_locs
      ]
      nearest_i = int(np.argmin(distances))
      target = workshop_locs[nearest_i]

      actions.extend(_move_actions(pos, target))
      pos = target
      actions.append(4)   # USE → craft the stick

  return actions


