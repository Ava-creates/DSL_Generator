from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that makes a stick in the given CraftLab environment.
  The function assumes the environment has been reset and the current state
  can be accessed via ``env._current_state`` (a ``CraftState`` instance).
  It uses a very simple breadth‑first search planner to move the agent to
  the required resources, pick them up and finally craft the stick at the
  appropriate workshop.
  """
  # imports inside function to avoid top‑level dependencies
  from collections import deque
  import numpy as np

  # Helper to translate a movement delta into an action index.
  ACTIONS = {
      (1, 0): 0,   # DOWN
      (-1, 0): 1,  # UP
      (0, -1): 2,  # LEFT
      (0, 1): 3,   # RIGHT
  }
  USE = 4

  # ----------------------------------------------------------------------
  # 1.  Gather recipe information for ``stick``.
  # ----------------------------------------------------------------------
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except Exception:
      # No stick defined – nothing to do.
      return []

  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  # ingredients are all keys except “_at”
  ingredients = {k: v for k, v in recipe.items() if k != "_at"}
  workshop_name = recipe.get("_at", None)

  # ----------------------------------------------------------------------
  # 2.  Convenience access to the current state.
  # ----------------------------------------------------------------------
  state = env._current_state          # type: CraftState
  grid = state.grid                    # (W, H, K) uint8
  pos = tuple(state.pos)               # (x, y)
  inv = state.inventory.copy()         # (K,)

  # Set of indices that block movement (environment objects)
  non_grabbable = set(env.world.cookbook.non_grabbable_indices)

  # ----------------------------------------------------------------------
  # 3.  Simple 2‑D BFS that returns a list of positions from start to goal.
  # ----------------------------------------------------------------------
  def bfs(start, goal_cells, avoid=set()):
      """Return a list of positions (including start) that reaches any cell in *goal_cells*.
      *avoid* is a set of (x, y) positions that are considered blocked in addition
      to the static non‑grabbable objects.
      """
      W, H = grid.shape[:2]
      visited = np.full((W, H), False, dtype=bool)
      prev = dict()
      q = deque()
      q.append(start)
      visited[start] = True

      while q:
          x, y = q.popleft()
          if (x, y) in goal_cells:
              # reconstruct path
              path = [(x, y)]
              while (x, y) != start:
                  x, y = prev[(x, y)]
                  path.append((x, y))
              path.reverse()
              return path
          for dx, dy in [(1,0),(-1,0),(0,1),(0,-1)]:
              nx, ny = x + dx, y + dy
              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                  # cell is walkable if no non‑grabbable entity and not in avoid
                  if (nx, ny) in avoid:
                      continue
                  cell_block = np.any(grid[nx, ny, list(non_grabbable)] > 0)
                  if cell_block:
                      continue
                  visited[nx, ny] = True
                  prev[(nx, ny)] = (x, y)
                  q.append((nx, ny))
      return None  # unreachable

  # ----------------------------------------------------------------------
  # 4.  Helper that turns a path (list of positions) into action indices.
  # ----------------------------------------------------------------------
  def path_to_actions(path):
      """Convert a list of positions (including start) into a list of movement actions."""
      actions = []
      for (x0, y0), (x1, y1) in zip(path, path[1:]):
          dx, dy = x1 - x0, y1 - y0
          actions.append(ACTIONS[(dx, dy)])
      return actions

  # ----------------------------------------------------------------------
  # 5.  Collect all required ingredients.
  # ----------------------------------------------------------------------
  plan = []  # final list of actions we will return

  for ing_idx, needed in ingredients.items():
      while inv[ing_idx] < needed:
          # locate a cell that currently contains this ingredient
          locations = np.argwhere(grid[:, :, ing_idx] > 0)
          if locations.size == 0:
              # ingredient not present – cannot continue
              return plan
          # pick the first location (could be improved)
          tx, ty = locations[0]
          # compute all walkable neighbours of the target cell
          neighbours = []
          for dx, dy in [(1,0),(-1,0),(0,1),(0,-1)]:
              nx, ny = tx + dx, ty + dy
              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:
                  # neighbour must be empty (no non‑grabbable)
                  if not np.any(grid[nx, ny, list(non_grabbable)] > 0):
                      neighbours.append((nx, ny))
          if not neighbours:
              return plan

          # Find a path to any neighbour
          path = bfs(pos, set(neighbours))
          if path is None:
              # unreachable
              return plan
          # Convert to actions
          actions = path_to_actions(path)
          # Execute the moves on the environment so that ``pos`` and ``grid`` stay in sync
          for a in actions:
              reward, new_state = env.step(a)
              plan.append(a)
              state = new_state
              grid = state.grid
              pos = tuple(state.pos)
              inv = state.inventory
          # At this point we are on a neighbour cell.  We need to face the target
          # and issue a USE action.
          # Determine direction we need to look at the target.
          dx = tx - pos[0]
          dy = ty - pos[1]
          # Choose a temporary move that sets the correct direction.
          # We first try a “bounce” move (away → towards) if possible.
          needed_dir = None
          if dx == -1 and dy == 0:
              needed_dir = 1          # UP
              bounce = (1, 0)          # DOWN then UP
          elif dx == 1 and dy == 0:
              needed_dir = 0          # DOWN
              bounce = (-1, 0)         # UP then DOWN
          elif dx == 0 and dy == -1:
              needed_dir = 2          # LEFT
              bounce = (0, 1)          # RIGHT then LEFT
          elif dx == 0 and dy == 1:
              needed_dir = 3          # RIGHT
              bounce = (0, -1)         # LEFT then RIGHT
          else:
              needed_dir = None

          if needed_dir is not None:
              # try the bounce if the opposite cell is free
              ox, oy = pos[0] + bounce[0], pos[1] + bounce[1]
              if (0 <= ox < grid.shape[0] and 0 <= oy < grid.shape[1] and
                      not np.any(grid[ox, oy, list(non_grabbable)] > 0)):
                  # perform bounce
                  plan.append(ACTIONS[bounce])
                  reward, new_state = env.step(ACTIONS[bounce])
                  state = new_state
                  grid = state.grid
                  pos = tuple(state.pos)
                  inv = state.inventory
              # now move towards the target (which also sets the direction)
              plan.append(needed_dir)
              reward, new_state = env.step(needed_dir)
              state = new_state
              grid = state.grid
              pos = tuple(state.pos)
              inv = state.inventory

          # finally use the item
          plan.append(USE)
          reward, new_state = env.step(USE)
          state = new_state
          grid = state.grid
          pos = tuple(state.pos)
          inv = state.inventory
          # loop continues until we have enough of this ingredient

  # ----------------------------------------------------------------------
  # 6.  Move to the workshop (if any) and craft the stick.
  # ----------------------------------------------------------------------
  if workshop_name is not None:
      try:
          workshop_idx = env.world.cookbook.index[workshop_name]
      except Exception:
          workshop_idx = None
      if workshop_idx is not None:
          # locate a workshop cell
          ws = np.argwhere(grid[:, :, workshop_idx] > 0)
          if ws.size > 0:
              wx, wy = ws[0]
              # find walkable neighbours of the workshop
              ws_neighbours = []
              for dx, dy in [(1,0),(-1,0),(0,1),(0,-1)]:
                  nx, ny = wx + dx, wy + dy
                  if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:
                      if not np.any(grid[nx, ny, list(non_grabbable)] > 0):
                          ws_neighbours.append((nx, ny))
              if ws_neighbours:
                  path = bfs(pos, set(ws_neighbours))
                  if path is not None:
                      actions = path_to_actions(path)
                      for a in actions:
                          reward, new_state = env.step(a)
                          plan.append(a)
                          state = new_state
                          grid = state.grid
                          pos = tuple(state.pos)
                          inv = state.inventory
                      # Face the workshop (same bounce trick)
                      dx = wx - pos[0]
                      dy = wy - pos[1]
                      needed_dir = None
                      bounce = None
                      if dx == -1 and dy == 0:
                          needed_dir = 1; bounce = (1,0)
                      elif dx == 1 and dy == 0:
                          needed_dir = 0; bounce = (-1,0)
                      elif dx == 0 and dy == -1:
                          needed_dir = 2; bounce = (0,1)
                      elif dx == 0 and dy == 1:
                          needed_dir = 3; bounce = (0,-1)
                      if needed_dir is not None:
                          ox, oy = pos[0] + bounce[0], pos[1] + bounce[1]
                          if (0 <= ox < grid.shape[0] and 0 <= oy < grid.shape[1] and
                                  not np.any(grid[ox, oy, list(non_grabbable)] > 0)):
                              plan.append(ACTIONS[bounce])
                              reward, new_state = env.step(ACTIONS[bounce])
                              state = new_state
                              grid = state.grid
                              pos = tuple(state.pos)
                              inv = state.inventory
                          plan.append(needed_dir)
                          reward, new_state = env.step(needed_dir)
                          state = new_state
                          grid = state.grid
                          pos = tuple(state.pos)
                          inv = state.inventory
                      # Use (craft) action
                      plan.append(USE)
                      reward, new_state = env.step(USE)
                      state = new_state
                      # final state not needed
  # Return the full list of actions
  return plan


