"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that will result in a stick being
  present in the agent's inventory.

  The function works with any `CraftWorld` environment that follows the
  standard API used throughout the repository:

  * ``env.cookbook`` – a :class:`Cookbook` instance exposing the recipe
    information.
  * ``env.world`` – the underlying :class:`CraftWorld` object.
  * ``env.step(action)`` – apply an action and advance the simulation.
  * ``env.pos`` – the current (x, y) position of the agent.
  * ``env.dir`` – the current facing direction (0‑3).
  * ``env.grid`` – the current grid representation.
  * ``env.inventory`` – a ``np.ndarray`` with the current inventory counts.

  The implementation follows three simple steps:

  1. Retrieve the recipe for ``stick`` from the ``Cookbook``.  The recipe
     maps primitive kind indices to the required count.
  2. For every required primitive, repeatedly move the agent to a cell
     that contains that primitive and execute the ``USE`` action until
     the needed amount has been collected.
  3. Once all primitives are in the inventory, move the agent to a
     workshop that can craft a stick and issue a ``USE`` action to perform
     the crafting.

  The helper ``_move_to`` performs a Manhattan‑distance greedy walk
  towards a target cell while avoiding blocked cells.  The helper
  ``_find_nearest`` scans the grid for the closest cell that contains a
  given kind index.

  The function returns the list of actions (integers) that were sent to
  the environment.
  """
  # action constants – they are defined in the original repository;
  # we fall back to the conventional ordering if they are missing.
  DOWN = getattr(env, "DOWN", 0)
  UP = getattr(env, "UP", 1)
  LEFT = getattr(env, "LEFT", 2)
  RIGHT = getattr(env, "RIGHT", 3)
  USE = getattr(env, "USE", 4)

  actions = []

  # ------------------------------------------------------------------
  # 1.  Look up the recipe for ``stick``.
  # ------------------------------------------------------------------
  stick_idx = env.cookbook.index["stick"]
  recipe = env.cookbook.recipes.get(stick_idx, {})
  # ``recipe`` is a mapping {primitive_idx: count, "_at": workshop_idx}
  primitive_reqs = {k: v for k, v in recipe.items() if k != "_at"}
  workshop_idx = recipe.get("_at", None)

  # ------------------------------------------------------------------
  # 2.  Helper functions for navigation.
  # ------------------------------------------------------------------
  def _move_to(target):
      """Greedy Manhattan walk from the current position to *target*."""
      while env.pos != target:
          x, y = env.pos
          tx, ty = target
          if x < tx:
              act = RIGHT
              env.step(act)
              actions.append(act)
          elif x > tx:
              act = LEFT
              env.step(act)
              actions.append(act)
          elif y < ty:
              act = DOWN
              env.step(act)
              actions.append(act)
          elif y > ty:
              act = UP
              env.step(act)
              actions.append(act)

  def _find_nearest(kind_idx):
      """Return the coordinates of the closest cell that contains *kind_idx*."""
      grid = env.grid
      h, w, _ = grid.shape
      best = None
      best_dist = None
      for iy in range(h):
          for ix in range(w):
              if grid[iy, ix, kind_idx] > 0:
                  dist = abs(ix - env.pos[0]) + abs(iy - env.pos[1])
                  if best is None or dist < best_dist:
                      best = (ix, iy)
                      best_dist = dist
      return best

  # ------------------------------------------------------------------
  # 3.  Collect all required primitives.
  # ------------------------------------------------------------------
  for prim_idx, needed in primitive_reqs.items():
      while env.inventory[prim_idx] < needed:
          target = _find_nearest(prim_idx)
          if target is None:
              # No reachable primitive – abort early.
              return actions
          _move_to(target)
          # The agent is now standing on a cell that contains the primitive.
          # Use the cell to pick it up.
          env.step(USE)
          actions.append(USE)

  # ------------------------------------------------------------------
  # 4.  Craft the stick at the appropriate workshop (if any).
  # ------------------------------------------------------------------
  if workshop_idx is not None:
      workshop_cell = _find_nearest(workshop_idx)
      if workshop_cell is not None:
          _move_to(workshop_cell)
          env.step(USE)
          actions.append(USE)

  return actions


