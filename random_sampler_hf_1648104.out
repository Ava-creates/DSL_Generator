import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that will collect the required primitives
  and craft a ``stick`` in a CraftWorld environment.

  The function works with the standard CraftLab / CraftWorld API:
  - ``env.reset()`` returns the initial observation dictionary.
  - ``env.step(action)`` returns ``(reward, done, observation)``.
  - ``env.world`` (or ``env`` itself if it is a CraftWorld) provides
    access to the recipe book.

  The action space is:
      0 = DOWN, 1 = UP, 2 = LEFT, 3 = RIGHT, 4 = USE
  The function returns a list of these integers.

  The algorithm:
  1. Determine the recipe for ``stick`` and the primitive requirements.
  2. Repeatedly locate the nearest needed primitive, move adjacent to it,
     and ``USE`` to pick it up.
  3. After all primitives are gathered, move adjacent to the required
     workshop and ``USE`` to craft the stick.
  """
  import numpy as np
  import collections

  # ----------------------------------------------------------------------
  # Helper utilities
  # ----------------------------------------------------------------------
  # movement directions matching the action indices
  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # (dx, dy) for DOWN,UP,LEFT,RIGHT
  ACTION_USE = 4

  def get_world(obj):
      """Extract the CraftWorld instance from the env."""
      if hasattr(obj, "world"):
          return obj.world
      if hasattr(obj, "cookbook"):
          return obj
      raise ValueError("Cannot locate CraftWorld instance in the given env.")

  def get_agent_pos(obs):
      """Convert normalized position to integer grid coordinates."""
      pos_norm = obs["features_dict"]["pos"]          # shape (2,)
      grid = obs["features_dict"]["features_global"]
      w, h = grid.shape[0], grid.shape[1]
      # clamp and round to nearest cell index
      x = int(round(pos_norm[0] * (w - 1)))
      y = int(round(pos_norm[1] * (h - 1)))
      x = max(0, min(w - 1, x))
      y = max(0, min(h - 1, y))
      return (x, y)

  def bfs(start, blocked):
      """Bread‑first search on the 2‑D grid."""
      w, h = blocked.shape
      visited = np.full((w, h), False, dtype=bool)
      parent = {}                     # (x,y) -> (px,py,action)
      dist = np.full((w, h), -1, dtype=int)

      dq = collections.deque()
      dq.append(start)
      visited[start] = True
      dist[start] = 0

      while dq:
          x, y = dq.popleft()
          for act, (dx, dy) in enumerate(DIRS):
              nx, ny = x + dx, y + dy
              if 0 <= nx < w and 0 <= ny < h:
                  if not visited[nx, ny] and not blocked[nx, ny]:
                      visited[nx, ny] = True
                      dist[nx, ny] = dist[x, y] + 1
                      parent[(nx, ny)] = (x, y, act)
                      dq.append((nx, ny))
      return dist, parent

  def reconstruct_path(parent, start, goal):
      """Reconstruct the action list from start to goal using the parent map."""
      actions = []
      cur = goal
      while cur != start:
          px, py, act = parent[cur]
          actions.append(act)
          cur = (px, py)
      actions.reverse()
      return actions

  def nearest_reachable_neighbor(start, blocked, targets):
      """
      For a set of target cells (e.g. primitives or workshops) find the
      reachable neighbour cell with the smallest BFS distance.
      Returns (neighbor_coord, parent_map, target_coord, distance) or (None,…)
      """
      dist, parent = bfs(start, blocked)
      best = None
      best_dist = None
      best_target = None
      for (tx, ty) in targets:
          for dx, dy in DIRS:
              nx, ny = tx + dx, ty + dy
              if 0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]:
                  if not blocked[nx, ny]:
                      d = dist[nx, ny]
                      if d >= 0 and (best_dist is None or d < best_dist):
                          best = (nx, ny)
                          best_dist = d
                          best_target = (tx, ty)
      if best is None:
          return None, None, None, None
      return best, parent, best_target, best_dist

  # ----------------------------------------------------------------------
  # Begin planning
  # ----------------------------------------------------------------------
  # 1. Reset environment and grab initial observation
  obs = env.reset()
  world = get_world(env)

  # 2. Identify the index for the "stick" item
  try:
      stick_idx = world.cookbook.index["stick"]
  except Exception as e:
      raise ValueError("Stick item not found in the world index.") from e

  # 3. Primitive requirements for one stick
  primitive_requirements = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}
  if not primitive_requirements:
      # No recipe – nothing to do
      return []

  # 4. Workshop location required for the stick recipe (may be None)
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_idx = recipe.get("_at", None)

  # 5. Initialise tracking variables
  actions_plan = []
  agent_pos = get_agent_pos(obs)

  # ----------------------------------------------------------------------
  # Helper to step the environment and keep observation/state up‑to‑date
  # ----------------------------------------------------------------------
  def step_and_update(action):
      """Execute an action and refresh local vars."""
      nonlocal obs, agent_pos
      reward, done, obs = env.step(action)   # ignore reward / done here
      agent_pos = get_agent_pos(obs)

  # ----------------------------------------------------------------------
  # 6. Collect required primitives
  # ----------------------------------------------------------------------
  while True:
      # current inventory
      inventory = obs["features_dict"]["inventory"]
      # compute how many of each primitive are still needed
      needed = {p: max(0, cnt - int(inventory[p])) for p, cnt in primitive_requirements.items()}
      # stop when all needed are satisfied
      if all(v == 0 for v in needed.values()):
          break

      # pick a primitive that is still needed (simple deterministic choice)
      prim_idx = next(p for p, v in needed.items() if v > 0)

      # locate all cells that currently contain this primitive
      grid = obs["features_dict"]["features_global"]
      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
      if prim_cells.size == 0:
          # primitive not present – cannot continue
          raise RuntimeError(f"Required primitive (index {prim_idx}) not found on the grid.")

      # compute blocked cells (any non‑empty cell is an obstacle)
      blocked = np.any(grid > 0, axis=2)

      # find nearest reachable neighbour of any instance of the primitive
      neighbor, parent_map, target_cell, _ = nearest_reachable_neighbor(agent_pos, blocked, prim_cells)
      if neighbor is None:
          raise RuntimeError("No reachable primitive found.")

      # move to the neighbour cell
      move_actions = reconstruct_path(parent_map, agent_pos, neighbor)
      for a in move_actions:
          actions_plan.append(a)
          step_and_update(a)

      # now adjacent to the primitive – use to pick it up
      actions_plan.append(ACTION_USE)
      step_and_update(ACTION_USE)

  # ----------------------------------------------------------------------
  # 7. Craft the stick at the required workshop (if any)
  # ----------------------------------------------------------------------
  if workshop_idx is not None:
      # locate workshop cells
      grid = obs["features_dict"]["features_global"]
      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
      if workshop_cells.size == 0:
          raise RuntimeError("Workshop required for stick not found on the grid.")

      # recompute blocked map (workshop cells are also obstacles)
      blocked = np.any(grid > 0, axis=2)

      # find nearest reachable neighbour of a workshop
      neighbor, parent_map, _, _ = nearest_reachable_neighbor(agent_pos, blocked, workshop_cells)
      if neighbor is None:
          raise RuntimeError("No reachable workshop cell found.")

      # move to neighbour
      move_actions = reconstruct_path(parent_map, agent_pos, neighbor)
      for a in move_actions:
          actions_plan.append(a)
          step_and_update(a)

      # use to craft the stick
      actions_plan.append(ACTION_USE)
      step_and_update(ACTION_USE)

  # ----------------------------------------------------------------------
  # 8. Verify that a stick is now in the inventory (optional)
  # ----------------------------------------------------------------------
  final_inventory = obs["features_dict"]["inventory"]
  if final_inventory[stick_idx] == 0:
      # If, for some reason, crafting failed, we still return the actions we tried.
      # The caller can inspect the final state if needed.
      pass

  return actions_plan


