import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  # reset
  obs = env.reset()
  # get goal index for stick
  stick_idx = env.world.cookbook.index['stick']
  # get required primitives
  req = env.world.cookbook.primitives_for(stick_idx)
  # collect each primitive
  actions = []
  state = env._current_state if hasattr(env, "_current_state") else None
  # helper to find nearest cell with given kind
  def find_nearest(kind):
      grid = state.grid
      pos = state.pos
      # compute Manhattan distances
      best = None
      best_dist = 1e9
      for x in range(grid.shape[0]):
          for y in range(grid.shape[1]):
              if grid[x,y,kind] > 0:
                  d = abs(x-pos[0]) + abs(y-pos[1])
                  if d < best_dist:
                      best_dist = d
                      best = (x,y)
      return best
  # movement actions mapping
  ACTIONS = {"UP":0,"DOWN":1,"LEFT":2,"RIGHT":3,"USE":4}
  # simple path: move horizontally then vertically
  def path_to(target):
      cur = state.pos
      seq = []
      dx = target[0] - cur[0]
      dy = target[1] - cur[1]
      if dx > 0:
          seq += [ACTIONS["DOWN"]]*dx
      elif dx < 0:
          seq += [ACTIONS["UP"]]*(-dx)
      if dy > 0:
          seq += [ACTIONS["RIGHT"]]*dy
      elif dy < 0:
          seq += [ACTIONS["LEFT"]]*(-dy)
      return seq
  # collect primitives
  for prim_idx, cnt in req.items():
      for _ in range(cnt):
          target = find_nearest(prim_idx)
          if target is None:
              continue
          actions += path_to(target)
          actions.append(ACTIONS["USE"])
          # step env to update state
          for a in actions[-(len(path_to(target))+1):]:
              _, done, _ = env.step(a)
              if done:
                  break
          state = env._current_state
  # craft stick at its workshop
  # find workshop cell for stick
  workshop_kind = env.world.workshop_indices[stick_idx] if isinstance(env.world.workshop_indices, dict) else None
  # but recipes have _at field; we can locate any cell with that kind
  workshop_kind = None
  # iterate recipes to get _at
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  at_kind = None
  for k,v in recipe.items():
      if k == "_at":
          at_kind = v
          break
  if at_kind is not None:
      workshop_kind = at_kind
  if workshop_kind is not None:
      target = find_nearest(workshop_kind)
      if target:
          actions += path_to(target)
          actions.append(ACTIONS["USE"])
  return actions


