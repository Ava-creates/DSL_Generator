import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of action indices that will (in principle) collect the
  required primitives for a ``stick`` and then craft it at the appropriate
  workshop.

  The implementation is deliberately generic – it does **not** rely on any
  particular map layout.  It uses the recipe information stored in the
  ``CraftWorld``/``Cookbook`` objects to discover which primitive items are
  needed and where the workshop for the target item is located.  The agent
  then moves in Manhattan fashion to the first occurrence of each primitive,
  uses the ``USE`` action the required number of times, and finally moves to
  a workshop cell and uses ``USE`` again to craft the stick.

  The function assumes the following about the environment API (which holds
  for the standard ``CraftLab`` wrapper used in the tests):

  * ``env.world`` – the ``CraftWorld`` instance.
  * ``env.scenario`` – the ``CraftScenario`` instance.
  * ``env.scenario.init_grid`` – a ``(W, H, K)`` numpy array where
    ``grid[x, y, k] > 0`` indicates the presence of an entity of kind ``k``
    at cell ``(x, y)``.
  * ``env.scenario.init_pos`` – the starting ``(x, y)`` coordinates of the
    agent.
  * Action indices: ``DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4`` (as defined in
    the original source).

  The returned list can be fed to ``env.step(action)`` repeatedly; the
  function does **not** execute the actions itself.
  """
  import numpy as np

  # ----------------------------------------------------------------------
  # Helper to convert a direction into the corresponding action index.
  # ----------------------------------------------------------------------
  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4

  # ----------------------------------------------------------------------
  # Retrieve the index of the goal item (``stick``) and its recipe.
  # ----------------------------------------------------------------------
  world = env.world
  cookbook = world.cookbook
  stick_idx = cookbook.index["stick"]                     # goal kind id
  stick_recipe = cookbook.recipes.get(stick_idx, {})

  # ----------------------------------------------------------------------
  # Determine the primitive requirements for a single stick.
  # ----------------------------------------------------------------------
  primitive_needs = cookbook.primitives_for(stick_idx)   # {kind_id: count}
  # ``primitives_for`` already expands recursive recipes, giving us the
  # flat list of primitive kinds that must be collected.

  # ----------------------------------------------------------------------
  # Locate the workshop where a stick can be crafted.
  # ----------------------------------------------------------------------
  workshop_name = stick_recipe.get("_at")
  workshop_idx = None
  if workshop_name is not None:
      workshop_idx = cookbook.index[workshop_name]

  # ----------------------------------------------------------------------
  # Initialise the plan.
  # ----------------------------------------------------------------------
  actions = []
  cur_x, cur_y = env.scenario.init_pos                     # agent start

  # ----------------------------------------------------------------------
  # Simple Manhattan‑movement helper.
  # ----------------------------------------------------------------------
  def move_to(target_x, target_y):
      """Append actions that move the agent from its current position to
      ``(target_x, target_y)`` using only horizontal then vertical moves."""
      nonlocal cur_x, cur_y, actions
      # Horizontal moves
      while cur_x < target_x:
          actions.append(ACTION_RIGHT)
          cur_x += 1
      while cur_x > target_x:
          actions.append(ACTION_LEFT)
          cur_x -= 1
      # Vertical moves
      while cur_y < target_y:
          actions.append(ACTION_DOWN)
          cur_y += 1
      while cur_y > target_y:
          actions.append(ACTION_UP)
          cur_y -= 1

  # ----------------------------------------------------------------------
  # Collect each required primitive.
  # ----------------------------------------------------------------------
  grid = env.scenario.init_grid
  for prim_idx, needed_cnt in primitive_needs.items():
      # Find *any* cell that currently contains the primitive.
      locations = np.argwhere(grid[:, :, prim_idx] > 0)
      if locations.size == 0:
          # No such primitive on the map – in a well‑formed scenario this
          # should never happen, but we guard against it.
          continue
      # Use the first discovered location.
      target_x, target_y = tuple(locations[0])

      # Move next to the primitive (we simply move onto the cell; the
      # environment will treat the cell as empty once the item is picked up).
      move_to(target_x, target_y)

      # Pick up the primitive the required number of times.
      for _ in range(needed_cnt):
          actions.append(ACTION_USE)

      # After a ``USE`` the primitive disappears from the grid, but we do
      # not update ``grid`` here – the plan only needs the sequence of
      # actions.

  # ----------------------------------------------------------------------
  # Finally, go to the workshop and craft the stick.
  # ----------------------------------------------------------------------
  if workshop_idx is not None:
      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
      if workshop_cells.size > 0:
          wx, wy = tuple(workshop_cells[0])
          move_to(wx, wy)
          actions.append(ACTION_USE)   # craft at the workshop

  return actions


