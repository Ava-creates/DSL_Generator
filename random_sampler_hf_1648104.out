"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a ``stick`` in a CraftWorld
  environment.

  The function works for a generic ``CraftLab`` (or compatible) object:
  * it queries the recipe for ``stick``,
  * finds the required primitive items,
  * navigates to each primitive, picks it up,
  * navigates to the appropriate workshop and crafts the stick.

  The returned list contains integer action codes that match the
  ``CraftLab.action_specs`` mapping:

      0 – DOWN   (y + 1)
      1 – UP     (y - 1)
      2 – LEFT   (x - 1)
      3 – RIGHT  (x + 1)
      4 – USE    (interact with the cell in front)

  The implementation does **not** execute the actions; it only
  computes a feasible sequence based on the initial grid layout.
  """
  import numpy as np

  # ------------------------------------------------------------------ #
  # Helper utilities
  # ------------------------------------------------------------------ #
  # Action constants – they match the ordering used in CraftLab.action_specs
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
  ACTION_VECTORS = {
      DOWN:  (0, 1),
      UP:    (0, -1),
      LEFT:  (-1, 0),
      RIGHT: (1, 0),
  }

  def inside_grid(x, y, w, h):
      return 0 <= x < w and 0 <= y < h

  def manhattan_path(start, goal):
      """
      Very simple path generator that first moves horizontally then
      vertically.  Returns a list of movement actions (DOWN/UP/LEFT/RIGHT).
      """
      sx, sy = start
      gx, gy = goal
      actions = []

      # horizontal movement
      while sx != gx:
          if gx > sx:
              actions.append(RIGHT)
              sx += 1
          else:
              actions.append(LEFT)
              sx -= 1

      # vertical movement
      while sy != gy:
          if gy > sy:
              actions.append(DOWN)
              sy += 1
          else:
              actions.append(UP)
              sy -= 1

      return actions

  # ------------------------------------------------------------------ #
  # 1.  Identify the goal (stick) and its recipe
  # ------------------------------------------------------------------ #
  # Reset the environment to obtain a fresh state (if not already done)
  # ``env.reset`` returns an observation dict; the internal state is stored
  # in ``env._current_state``.
  env.reset()
  state = env._current_state

  # Index of the target item (stick)
  stick_idx = env.world.cookbook.index["stick"]

  # Primitive requirements for one stick (dict {primitive_idx: count})
  primitives_needed = env.world.cookbook.primitives_for(stick_idx)

  # Workshop kind where a stick must be crafted
  workshop_idx = env.world.cookbook.recipes[stick_idx]["_at"]

  # ------------------------------------------------------------------ #
  # 2.  Locate all entities on the grid
  # ------------------------------------------------------------------ #
  grid = state.grid                     # shape (W, H, n_kinds)
  W, H, _ = grid.shape

  # Helper: return list of (x, y) coordinates where a given kind is present
  def locate_kind(kind):
      mask = grid[:, :, kind] > 0
      ys, xs = np.where(mask)          # note: numpy returns (row, col) = (y, x)
      return list(zip(xs.tolist(), ys.tolist()))

  # Locations of each required primitive (may be many)
  primitive_locations = {
      p_idx: locate_kind(p_idx) for p_idx in primitives_needed
  }

  # Locations of the workshop(s) for the stick
  workshop_locs = locate_kind(workshop_idx)

  # ------------------------------------------------------------------ #
  # 3.  Build the action sequence
  # ------------------------------------------------------------------ #
  actions = []
  cur_pos = state.pos                    # (x, y)

  # -------------------------------------------------------------- #
  # 3a. Collect all needed primitives
  # -------------------------------------------------------------- #
  for p_idx, needed_cnt in primitives_needed.items():
      # We will greedily take the closest available instance each time
      for _ in range(needed_cnt):
          # Find the nearest location of this primitive (Manhattan distance)
          candidates = primitive_locations[p_idx]
          if not candidates:
              # No more instances on the map – this should not happen in a
              # well‑formed scenario, but we break to avoid an infinite loop.
              break

          distances = [abs(px - cur_pos[0]) + abs(py - cur_pos[1]) for (px, py) in candidates]
          nearest = candidates[int(np.argmin(distances))]

          # Move to the primitive cell
          actions.extend(manhattan_path(cur_pos, nearest))
          cur_pos = nearest

          # Pick it up
          actions.append(USE)

          # Remove this instance from the list so we don't reuse it
          primitive_locations[p_idx].remove(nearest)

  # -------------------------------------------------------------- #
  # 3b. Go to the workshop and craft the stick
  # -------------------------------------------------------------- #
  if workshop_locs:
      # Choose the closest workshop
      distances = [abs(wx - cur_pos[0]) + abs(wy - cur_pos[1]) for (wx, wy) in workshop_locs]
      target_ws = workshop_locs[int(np.argmin(distances))]

      actions.extend(manhattan_path(cur_pos, target_ws))
      cur_pos = target_ws

      # Craft the stick
      actions.append(USE)

  # ------------------------------------------------------------------ #
  # Return the computed action list
  # ------------------------------------------------------------------ #
  return actions


