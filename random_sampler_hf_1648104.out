import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generates a sequence of actions to craft a stick in the given CraftWorld environment.
  This implementation attempts to locate the required primitives for a stick,
  move the agent to collect them, and then perform the crafting action at the appropriate workshop.
  """
  # Helper functions
  def find_nearest(item_index):
      """Find the nearest cell containing the specified item index."""
      min_dist = float('inf')
      target = None
      for x in range(env.world.WIDTH):
          for y in range(env.world.HEIGHT):
              if env.current_state.grid[x, y, item_index] > 0:
                  dist = abs(x - env.current_state.pos[0]) + abs(y - env.current_state.pos[1])
                  if dist < min_dist:
                      min_dist = dist
                      target = (x, y)
      return target

  def move_to(target):
      """Generate actions to move the agent from current position to target position."""
      actions = []
      cur_x, cur_y = env.current_state.pos
      tgt_x, tgt_y = target
      # Simple Manhattan path: first adjust x, then y
      while cur_x != tgt_x:
          if tgt_x > cur_x:
              actions.append(env.world.ACTIONS['RIGHT'])
              cur_x += 1
          else:
              actions.append(env.world.ACTIONS['LEFT'])
              cur_x -= 1
      while cur_y != tgt_y:
          if tgt_y > cur_y:
              actions.append(env.world.ACTIONS['UP'])
              cur_y += 1
          else:
              actions.append(env.world.ACTIONS['DOWN'])
              cur_y -= 1
      return actions

  # Main logic
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except KeyError:
      # Stick not defined in this world
      return []

  # Retrieve primitive requirements for a stick
  primitives_needed = env.world.cookbook.primitives_for(stick_idx)
  if not primitives_needed:
      # No recipe; assume stick is a primitive itself
      return []

  action_plan = []

  # Collect each required primitive
  for prim_idx, count in primitives_needed.items():
      for _ in range(count):
          # Locate nearest primitive instance
          primitive_pos = find_nearest(prim_idx)
          if primitive_pos is None:
              # Primitive not found; cannot complete task
              return []
          # Move to the primitive location
          action_plan.extend(move_to(primitive_pos))
          # Use action to pick up the primitive
          action_plan.append(env.world.ACTIONS['USE'])

  # After collecting, move to the appropriate workshop for crafting
  workshop_tag = env.world.cookbook.recipes[stick_idx].get("_at")
  if workshop_tag:
      workshop_idx = env.world.cookbook.index[workshop_tag]
      workshop_pos = find_nearest(workshop_idx)
      if workshop_pos:
          action_plan.extend(move_to(workshop_pos))
  # Craft the stick
  action_plan.append(env.world.ACTIONS['USE'])
  return action_plan


