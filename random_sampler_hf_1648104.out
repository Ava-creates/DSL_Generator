    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that, when executed in the given Craft environment,
  will result in the agent possessing at least one ``stick``.

  The function first tries to use the high‑level ``env.craft`` helper (which
  exists in the reference implementation).  If that helper is unavailable,
  a ``NotImplementedError`` is raised – crafting a stick without knowledge of
  the world layout cannot be done generically.

  Parameters
  ----------
  env : object
      An instance of the Craft environment (e.g. ``CraftLab`` or a raw
      ``CraftWorld`` wrapper).

  Returns
  -------
  List[int]
      A sequence of action indices that achieve the goal.
  """
  # The reference implementation provides a convenient ``craft`` method that
  # takes the name of the desired item and returns a ready‑to‑execute action
  # list.
  if hasattr(env, "craft"):
      try:
          return env.craft("stick")
      except Exception as exc:
          # If the helper exists but fails (e.g. unknown item), propagate a
          # clear error message.
          raise RuntimeError("Failed to generate stick actions via env.craft") from exc

  # No high‑level helper available – we cannot construct a generic plan.
  raise NotImplementedError(
      "The environment does not provide a 'craft' helper; "
      "automatic stick planning is not implemented."
  )


