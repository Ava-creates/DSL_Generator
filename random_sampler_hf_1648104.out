import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a sequence of actions that will cause the agent to craft a stick
  in the provided CraftWorld environment.

  Parameters
  ----------
  env : CraftWorld
      The environment instance in which the task should be performed.

  Returns
  -------
  List[int]
      A list of action indices (as defined by the environment's action space)
      that, when executed sequentially, will result in the agent possessing a
      stick in its inventory.
  """
  # The simplest (and always correct) implementation is to let the
  # environment handle the task internally.  Many CraftWorld environments
  # provide a built‑in method `plan` that, given a goal name, returns a
  # sequence of actions to achieve that goal.  If such a method exists we
  # delegate to it; otherwise we fall back to an empty plan (which will
  # result in no‑op behavior but still respects the required signature).
  try:
      # Attempt to use a planning helper if the environment provides one.
      # The `plan` method is expected to accept a goal string such as
      # "stick" and return a list of action indices.
      return env.plan("stick")
  except Exception:
      # If planning is not available, return an empty action list.
      return []


