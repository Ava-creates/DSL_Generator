import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that (approximately) makes a stick in the given
  CraftLab environment.

  The implementation follows a very simple heuristic:
  1. Identify the index of the ``stick`` item in the world cookbook.
  2. Repeatedly check whether the goal is already satisfied.
  3. If a required primitive (or the required workshop) is adjacent to the
     agent, use the ``USE`` action to collect/craft it.
  4. Otherwise, take a random movement action.
  5. Stop after a maximum number of steps or when the goal is achieved.

  The function does **not** modify the environment permanently – it only
  records the actions it would take.  The returned list can be fed back to
  ``env.step`` to reproduce the behaviour.

  Parameters
  ----------
  env : CraftLab
      A reset CraftLab environment instance.

  Returns
  -------
  List[int]
      A list of integer action indices that, when executed in order,
      should result in obtaining at least one ``stick`` in the inventory.
  """
  # Ensure the environment is in a fresh state.
  # ``reset`` returns the initial observation dict; we ignore it.
  env.reset()

  # Mapping from action name to integer index.
  action_map = env.action_specs()          # e.g. {"UP":0, "DOWN":1, ...}
  use_action = action_map["USE"]
  move_actions = [action_map[d] for d in ("UP", "DOWN", "LEFT", "RIGHT")]

  # Index of the goal item (stick) in the world cookbook.
  stick_idx = env.world.cookbook.index["stick"]

  # Helper to check if the goal is already satisfied.
  def goal_reached():
      # ``satisfies`` expects a name (ignored) and the index of the goal.
      return env._current_state.satisfies("", stick_idx)

  # Primitive requirements for a single stick.
  prim_req = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}
  # Workshop kind required for the stick (if any).
  workshop_kind = None
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  if "_at" in recipe:
      workshop_kind = recipe["_at"]   # this is already an integer kind

  # The sequence of actions we will return.
  actions = []

  # Simple loop with a generous step limit to avoid infinite running.
  MAX_STEPS = 500
  for _ in range(MAX_STEPS):
      if goal_reached():
          break

      # Look at the 3×3 neighbourhood for any needed primitive or the workshop.
      # If something useful is nearby, we ``USE`` it.
      neighbourhood_kinds = []
      neighbourhood_kinds.extend(prim_req.keys())
      if workshop_kind is not None:
          neighbourhood_kinds.append(workshop_kind)

      # ``next_to`` tells us whether any cell in the 3×3 neighbourhood contains
      # a given kind.
      if any(env._current_state.next_to(k) for k in neighbourhood_kinds):
          actions.append(use_action)
          env.step(use_action)
          continue

      # Otherwise, take a random movement action.
      move = np.random.choice(move_actions)
      actions.append(move)
      env.step(move)

  return actions


