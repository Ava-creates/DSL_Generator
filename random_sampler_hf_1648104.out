import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a simple action sequence that attempts to craft a ``stick`` in the
  given Craft environment.

  The implementation follows a very naïve planner:
    1.  Query the world’s cookbook for the recipe of ``stick``.
    2.  Determine which primitive items are required and how many of each.
    3.  Locate the nearest cell containing each required primitive on the
        current grid and move towards it with Manhattan moves.
    4.  Use the ``USE`` action (index 4) to pick up the primitive.
    5.  After all primitives are collected, move to the workshop required by
        the recipe (if any) and ``USE`` again to craft the stick.

  The planner ignores obstacles and assumes that Manhattan moves are
  sufficient (which is true for the default CraftWorld maps).  The function
  returns a list of integer actions that can be fed directly to ``env.step``.

  Parameters
  ----------
  env : CraftLab (or compatible) instance
      The environment to act in.  It must expose the attributes used by the
      CraftWorld implementation (``world``, ``_current_state`` etc.).

  Returns
  -------
  List[int]
      A sequence of actions (0 = DOWN, 1 = UP, 2 = LEFT, 3 = RIGHT, 4 = USE)
      that, when executed from the initial state, should result in the
      agent possessing at least one ``stick``.
  """
  import numpy as np

  # ------------------------------------------------------------------ #
  # Helper: produce Manhattan‑style actions from start → goal.
  # ------------------------------------------------------------------ #
  def manhattan_path(start, goal):
      """Return a list of actions moving from start to goal using Manhattan moves."""
      actions = []
      x, y = start
      gx, gy = goal
      # vertical moves (DOWN / UP)
      while x < gx:
          actions.append(0)   # DOWN
          x += 1
      while x > gx:
          actions.append(1)   # UP
          x -= 1
      # horizontal moves (RIGHT / LEFT)
      while y < gy:
          actions.append(3)   # RIGHT
          y += 1
      while y > gy:
          actions.append(2)   # LEFT
          y -= 1
      return actions

  # ------------------------------------------------------------------ #
  # Initialise the episode and fetch useful references.
  # ------------------------------------------------------------------ #
  env.reset()                                 # start a fresh episode
  state = env._current_state                  # current CraftState
  world = env.world                           # CraftWorld instance
  cookbook = world.cookbook

  # ------------------------------------------------------------------ #
  # Identify the goal index for ``stick`` and fetch its recipe.
  # ------------------------------------------------------------------ #
  stick_idx = cookbook.index.get("stick")
  if stick_idx is None:
      raise ValueError("The world does not contain a 'stick' item.")

  recipe = cookbook.recipes.get(stick_idx, {})
  # ``_at`` designates the required workshop; everything else are primitives.
  workshop_idx = recipe.get("_at")
  primitive_requirements = {
      int(k): int(v) for k, v in recipe.items() if k != "_at"
  }

  # ------------------------------------------------------------------ #
  # Action list that will be returned.
  # ------------------------------------------------------------------ #
  plan = []

  # ------------------------------------------------------------------ #
  # Main planning loop: collect primitives, then craft.
  # ------------------------------------------------------------------ #
  while True:
      # Goal reached?
      if state.inventory[stick_idx] > 0:
          break

      # Determine which primitive we still need (if any).
      missing = {
          kind: max(0, cnt - state.inventory[kind])
          for kind, cnt in primitive_requirements.items()
      }
      needed_kind = None
      for kind, cnt in missing.items():
          if cnt > 0:
              needed_kind = kind
              break

      if needed_kind is not None:
          # ---------------------------------------------------------- #
          # Locate the nearest cell that contains the required primitive.
          # ---------------------------------------------------------- #
          locations = np.argwhere(state.grid[:, :, needed_kind] > 0)
          if locations.size == 0:
              raise RuntimeError(
                  f"Required primitive (kind {needed_kind}) not present on the map."
              )
          # Manhattan distance to each candidate location.
          cur_pos = np.array(state.pos)
          dists = np.sum(np.abs(locations - cur_pos), axis=1)
          target_cell = tuple(locations[dists.argmin()])

          # ---------------------------------------------------------- #
          # Move to the primitive cell and pick it up.
          # ---------------------------------------------------------- #
          plan.extend(manhattan_path(state.pos, target_cell))
          plan.append(4)                     # USE to collect

          # Simulate the steps so that subsequent planning uses the updated state.
          for a in plan[-(len(manhattan_path(state.pos, target_cell)) + 1):]:
              reward, new_state = env.step(a)
              state = new_state           # update local reference
      else:
          # ---------------------------------------------------------- #
          # All primitives collected – go to the workshop (if required) and craft.
          # ---------------------------------------------------------- #
          if workshop_idx is not None:
              workshop_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
              if workshop_locs.size == 0:
                  raise RuntimeError("Required workshop not found on the map.")
              # choose the first workshop location (any works for this simple planner)
              target_workshop = tuple(workshop_locs[0])
              plan.extend(manhattan_path(state.pos, target_workshop))
              # simulate movement
              for a in plan[-len(manhattan_path(state.pos, target_workshop)):]:
                  reward, new_state = env.step(a)
                  state = new_state

          # Craft the stick.
          plan.append(4)                     # USE to craft
          # Final step (craft) – we don’t need to simulate further; the loop will exit.
          break

  return plan


