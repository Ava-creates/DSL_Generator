import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will collect the required primitives and then
  craft a ``stick`` in the given CraftWorld environment.

  The implementation works for the standard CraftLab interface used in the
  code base described above.  It assumes the following action encoding
  (the same convention used by `CraftWorld`):

      0 – DOWN
      1 – UP
      2 – LEFT
      3 – RIGHT
      4 – USE   (collect / craft)

  The function performs three high‑level steps:

  1.  Determine which primitive items are needed to craft a ``stick``.
  2.  For each required primitive, locate the nearest instance on the map,
      navigate to it and ``USE`` to pick it up.
  3.  Locate the workshop where a ``stick`` can be crafted, move there and
      ``USE`` to craft the item.

  The returned list can be fed directly to ``env.step(action)`` in a loop.
  """
  import collections
  import numpy as np

  # --------------------------------------------------------------------- #
  # Helper utilities
  # --------------------------------------------------------------------- #
  # Action constants – match the ordering used by CraftWorld
  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = range(5)

  # Mapping from delta (row, col) to action index
  _DELTA_TO_ACTION = {
      ( 1,  0): ACTION_DOWN,
      (-1,  0): ACTION_UP,
      ( 0, -1): ACTION_LEFT,
      ( 0,  1): ACTION_RIGHT,
  }

  def bfs(start, goal_mask, blocked_mask):
      """
      Bread‑first‑search returning a list of actions that moves the agent from
      ``start`` to the nearest cell satisfying ``goal_mask`` while avoiding
      cells where ``blocked_mask`` is True.

      Parameters
      ----------
      start : tuple[int, int]
          (row, col) of the agent.
      goal_mask : np.ndarray (H, W) of bool
          True where the goal item is present.
      blocked_mask : np.ndarray (H, W) of bool
          True where the cell cannot be entered.

      Returns
      -------
      list[int]
          Sequence of actions (DOWN/UP/LEFT/RIGHT) that reaches the goal.
          Empty list if start already satisfies the goal.
      """
      if goal_mask[start]:
          return []

      H, W = goal_mask.shape
      q = collections.deque()
      q.append(start)
      visited = np.full((H, W), False, dtype=bool)
      visited[start] = True
      # parent stores (prev_row, prev_col, action_to_current)
      parent = dict()

      while q:
          r, c = q.popleft()
          for drc, act in _DELTA_TO_ACTION.items():
              dr, dc = drc
              nr, nc = r + dr, c + dc
              if 0 <= nr < H and 0 <= nc < W and not visited[nr, nc] and not blocked_mask[nr, nc]:
                  visited[nr, nc] = True
                  parent[(nr, nc)] = (r, c, act)
                  if goal_mask[nr, nc]:
                      # reconstruct path
                      path = []
                      cur = (nr, nc)
                      while cur != start:
                          pr, pc, a = parent[cur]
                          path.append(a)
                          cur = (pr, pc)
                      path.reverse()
                      return path
                  q.append((nr, nc))
      # No reachable goal – return empty list (caller will treat as failure)
      return []

  # --------------------------------------------------------------------- #
  # Extract world information
  # --------------------------------------------------------------------- #
  world = env.world                     # CraftWorld instance
  cookbook = world.cookbook              # Cookbook with recipes
  scenario = env.scenario                # CraftScenario instance

  # Initial grid and position (the grid is a (H, W, n_kinds) array)
  grid = scenario.init_grid.copy()
  pos = scenario.init_pos                # (row, col)

  # --------------------------------------------------------------------- #
  # Identify the goal (stick) and its recipe
  # --------------------------------------------------------------------- #
  stick_idx = cookbook.index["stick"]
  # Primitive requirements for a single stick (dict {kind_idx: count})
  primitive_req = cookbook.primitives_for(stick_idx)

  # The workshop where a stick can be crafted is stored under the special key
  # "_at" in the recipe dictionary.
  workshop_name = cookbook.recipes[stick_idx]["_at"]
  workshop_idx = cookbook.index[workshop_name]

  # --------------------------------------------------------------------- #
  # Pre‑compute a mask of blocked cells (any non‑zero entity blocks movement)
  # --------------------------------------------------------------------- #
  # A cell is blocked if any kind other than the agent occupies it.
  blocked_mask = grid.sum(axis=2) > 0

  # --------------------------------------------------------------------- #
  # Action sequence construction
  # --------------------------------------------------------------------- #
  actions = []

  # --------------------------------------------------------------------- #
  # 1. Collect each required primitive
  # --------------------------------------------------------------------- #
  for kind_idx, needed in primitive_req.items():
      for _ in range(needed):
          # Locate the nearest cell that currently contains the primitive.
          # The grid may contain multiple copies; we simply look for any.
          goal_mask = grid[:, :, kind_idx] > 0

          # Compute path to the primitive, avoiding blocked cells.
          path = bfs(pos, goal_mask, blocked_mask)
          actions.extend(path)                # move actions
          # Update position after moving
          for a in path:
              dr, dc = {ACTION_DOWN: (1, 0), ACTION_UP: (-1, 0),
                        ACTION_LEFT: (0, -1), ACTION_RIGHT: (0, 1)}[a]
              pos = (pos[0] + dr, pos[1] + dc)

          # Once we are on the primitive cell, use the USE action to pick it up.
          actions.append(ACTION_USE)

          # Simulate the effect of picking up the item:
          #   - Decrease the count in the grid
          #   - Mark the cell as empty (may become traversable)
          grid[pos[0], pos[1], kind_idx] = max(0, grid[pos[0], pos[1], kind_idx] - 1)
          blocked_mask = grid.sum(axis=2) > 0   # recompute blocked mask

  # --------------------------------------------------------------------- #
  # 2. Move to the workshop that can craft a stick
  # --------------------------------------------------------------------- #
  workshop_mask = grid[:, :, workshop_idx] > 0
  path_to_ws = bfs(pos, workshop_mask, blocked_mask)
  actions.extend(path_to_ws)

  # Update position after the move
  for a in path_to_ws:
      dr, dc = {ACTION_DOWN: (1, 0), ACTION_UP: (-1, 0),
                ACTION_LEFT: (0, -1), ACTION_RIGHT: (0, 1)}[a]
      pos = (pos[0] + dr, pos[1] + dc)

  # --------------------------------------------------------------------- #
  # 3. Craft the stick at the workshop
  # --------------------------------------------------------------------- #
  actions.append(ACTION_USE)   # USE while facing the workshop cell

  # The returned list of actions can now be executed in the environment.
  return actions


