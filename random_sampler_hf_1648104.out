import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a ``stick`` in the given CraftWorld
  environment.

  The implementation is generic:
  1. Look up the index of the ``stick`` item in the recipe book.
  2. Query the recipe for the required primitive resources and the workshop
     where the item must be crafted.
  3. For each required primitive, locate the nearest instance on the grid,
     move the agent to that cell and ``USE`` it to pick it up.
  4. After all primitives are collected, move to a workshop of the appropriate
     type and ``USE`` again to craft the stick.

  The function works with the *CraftLab* wrapper (the object returned by
  ``env_factory``).  It uses the public ``reset`` and ``step`` methods of the
  wrapper and inspects the underlying ``CraftState`` through the private
  ``_current_state`` attribute (this is the standard way the library exposes
  the state for planning).

  Parameters
  ----------
  env :
      An instance of :class:`CraftLab` (or any compatible wrapper) that has
      the attributes ``world`` (a :class:`CraftWorld`) and the methods
      ``reset`` and ``step``.

  Returns
  -------
  List[int]
      A list of action indices that, when fed sequentially to ``env.step``,
      will result in the agent possessing at least one ``stick``.
  """
  # --------------------------------------------------------------------- #
  # Helper utilities
  # --------------------------------------------------------------------- #
  # Action mapping used by CraftLab (see ``action_specs`` in the docs)
  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4

  def manhattan_move(src, dst):
      """Yield a sequence of actions that moves from src to dst using Manhattan
      steps (no obstacle avoidance – the environment will block illegal moves,
      but the planner will simply try again)."""
      x, y = src
      tx, ty = dst
      while (x, y) != (tx, ty):
          if x < tx:
              yield ACTION_RIGHT
              x += 1
          elif x > tx:
              yield ACTION_LEFT
              x -= 1
          elif y < ty:
              yield ACTION_DOWN
              y += 1
          elif y > ty:
              yield ACTION_UP
              y -= 1

  def locate_entities(grid, kind_idx):
      """Return a list of (x, y) positions where ``kind_idx`` is present."""
      # grid shape: (WIDTH, HEIGHT, n_kinds)
      locations = np.argwhere(grid[:, :, kind_idx] > 0)
      # ``np.argwhere`` returns (x, y) pairs; convert to list of tuples
      return [tuple(pos) for pos in locations]

  # --------------------------------------------------------------------- #
  # 1. Initialise the environment and obtain the current state
  # --------------------------------------------------------------------- #
  obs = env.reset()                     # reset returns the initial observation
  state = env._current_state            # internal CraftState after reset
  grid = state.grid.copy()              # current occupancy grid
  pos = state.pos                       # agent's (x, y) position

  # --------------------------------------------------------------------- #
  # 2. Identify the recipe for ``stick``
  # --------------------------------------------------------------------- #
  # The cookbook holds a bidirectional ``Index`` mapping names↔ids.
  stick_name = "stick"
  try:
      stick_idx = env.world.cookbook.index[stick_name]
  except Exception as exc:
      raise ValueError(f"Stick not found in the recipe index: {exc}")

  # Primitive requirements (e.g. {wood_idx: 2, stone_idx: 1})
  primitive_requirements = env.world.cookbook.primitives_for(stick_idx)

  # Workshop where the stick must be crafted (the recipe dict contains a
  # special ``_at`` key pointing to a workshop kind).
  recipe_dict = env.world.cookbook.recipes.get(stick_idx, {})
  workshop_kind = recipe_dict.get("_at")
  if workshop_kind is None:
      raise ValueError("The stick recipe does not specify a workshop ('_at').")

  # --------------------------------------------------------------------- #
  # 3. Collect each required primitive
  # --------------------------------------------------------------------- #
  actions = []

  for prim_idx, needed_qty in primitive_requirements.items():
      # Collect the primitive ``needed_qty`` times.
      for _ in range(needed_qty):
          # Locate all cells that currently contain the primitive.
          prim_locations = locate_entities(grid, prim_idx)
          if not prim_locations:
              raise RuntimeError(
                  f"Unable to locate primitive with index {prim_idx} on the grid."
              )
          # Choose the *closest* location (Manhattan distance).
          target = min(prim_locations,
                       key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))

          # Move to the target cell.
          for act in manhattan_move(pos, target):
              actions.append(act)
              reward, done, info = env.step(act)
              state = env._current_state
              grid = state.grid
              pos = state.pos

          # Pick up the primitive (USE).  The environment will automatically
          # decrement the count on the grid and increment the inventory.
          actions.append(ACTION_USE)
          reward, done, info = env.step(ACTION_USE)
          state = env._current_state
          grid = state.grid
          pos = state.pos  # position does not change on USE

  # --------------------------------------------------------------------- #
  # 4. Move to a workshop of the required type and craft the stick
  # --------------------------------------------------------------------- #
  workshop_locations = locate_entities(grid, workshop_kind)
  if not workshop_locations:
      raise RuntimeError("No workshop of the required type found on the grid.")

  # Choose the nearest workshop.
  target_ws = min(workshop_locations,
                  key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))

  # Move to the workshop cell.
  for act in manhattan_move(pos, target_ws):
      actions.append(act)
      reward, done, info = env.step(act)
      state = env._current_state
      grid = state.grid
      pos = state.pos

  # Craft the stick (USE while standing on/adjacent to the workshop).
  actions.append(ACTION_USE)
  env.step(ACTION_USE)  # final step; we do not need the returned values

  return actions


