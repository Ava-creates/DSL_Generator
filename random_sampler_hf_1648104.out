import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a sequence of actions to complete the task of making a stick in the given environment.
  The function discovers the required primitives from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.
  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making a stick.
  """
  # Identify the index for the stick item
  stick_index = env.world.cookbook.index("stick")
  # Get the primitive requirements for a stick
  stick_primitives = env.world.cookbook.primitives_for(stick_index)

  actions = []

  # Gather each required primitive
  for primitive, count in stick_primitives.items():
      # Find the location(s) of the primitive in the grid
      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive] > 0)

      # Collect the required number of each primitive
      for _ in range(count):
          # Choose the nearest primitive location
          agent_pos = np.array(env._current_state.pos)
          distances = np.linalg.norm(primitive_positions - agent_pos, axis=1)
          nearest_idx = np.argmin(distances)
          target_pos = tuple(primitive_positions[nearest_idx])

          # Move to the target position (simple Manhattan path)
          while env._current_state.pos != target_pos:
              cur_x, cur_y = env._current_state.pos
              tar_x, tar_y = target_pos

              if cur_x < tar_x:
                  actions.append(env.world.n_actions.DOWN)   # Move down
              elif cur_x > tar_x:
                  actions.append(env.world.n_actions.UP)     # Move up
              elif cur_y < tar_y:
                  actions.append(env.world.n_actions.RIGHT) # Move right
              elif cur_y > tar_y:
                  actions.append(env.world.n_actions.LEFT)  # Move left

              # Execute the move to update the internal state
              _, _ = env.step(actions[-1])

          # Use action to collect the primitive
          actions.append(env.world.n_actions.USE)
          _, _ = env.step(actions[-1])

          # Remove the collected primitive location
          primitive_positions = np.delete(primitive_positions, nearest_idx, axis=0)

  # Move to the workshop for crafting sticks (assume workshop is at position with the stick's _at index)
  workshop_index = env.world.cookbook.recipes[stick_index]["_at"]
  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)

  if workshop_positions.size > 0:
      workshop_pos = tuple(workshop_positions[0])
      while env._current_state.pos != workshop_pos:
          cur_x, cur_y = env._current_state.pos
          tar_x, tar_y = workshop_pos

          if cur_x < tar_x:
              actions.append(env.world.n_actions.DOWN)
          elif cur_x > tar_x:
              actions.append(env.world.n_actions.UP)
          elif cur_y < tar_y:
              actions.append(env.world.n_actions.RIGHT)
          elif cur_y > tar_y:
              actions.append(env.world.n_actions.LEFT)

          _, _ = env.step(actions[-1])

  # Finally, use the workshop to craft the stick
  actions.append(env.world.n_actions.USE)
  _, _ = env.step(actions[-1])

  return actions


