"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a stick in the given Craft environment.

  The implementation:
    1. Reset the environment to obtain the initial state.
    2. Determine the goal item index (the stick) from the task description.
    3. Query the cookbook for the primitive requirements of the goal.
    4. For each required primitive:
        * locate the nearest instance on the grid,
        * navigate to a cell adjacent to it,
        * use the ``USE`` action to pick it up.
    5. Locate the required workshop for the goal, navigate next to it and
       ``USE`` to craft the stick.
    6. Return the list of actions (integers) that achieve the goal.

  The function works with the public API of the Craft environment
  (CraftLab / CraftWorld) and does not rely on any internal
  implementation details beyond what the documentation describes.
  """
  import re
  import numpy as np
  from collections import deque

  # ----------------------------------------------------------------------
  # Helper functions
  # ----------------------------------------------------------------------
  def manhattan_path(start, goal):
      """Return a list of (dx, dy) steps to move from start to goal using
      Manhattan moves. The order is first vertical then horizontal."""
      (sx, sy), (gx, gy) = start, goal
      steps = []
      dy = gy - sy
      steps += [(0, 1)] * max(dy, 0) + [(0, -1)] * max(-dy, 0)
      dx = gx - sx
      steps += [(1, 0)] * max(dx, 0) + [(-1, 0)] * max(-dx, 0)
      return steps

  def step_to_action(dx, dy):
      """Map a delta (dx, dy) to the corresponding action index."""
      if dx == 1 and dy == 0:
          return 3   # RIGHT
      if dx == -1 and dy == 0:
          return 2   # LEFT
      if dx == 0 and dy == 1:
          return 0   # DOWN
      if dx == 0 and dy == -1:
          return 1   # UP
      raise ValueError(f"Invalid step ({dx},{dy})")

  def adjacent_cells(pos, width, height):
      """Yield all positions adjacent (including diagonals) to ``pos``
      that are inside the grid bounds."""
      x, y = pos
      for dx in (-1, 0, 1):
          for dy in (-1, 0, 1):
              if dx == 0 and dy == 0:
                  continue
              nx, ny = x + dx, y + dy
              if 0 <= nx < width and 0 <= ny < height:
                  yield (nx, ny)

  def find_nearest(target_kind, cur_pos, grid, blocked_kinds):
      """Find the nearest cell containing ``target_kind`` that is reachable
      from ``cur_pos`` without stepping on any ``blocked_kinds``. Returns
      the cell coordinates or ``None`` if not found."""
      width, height, _ = grid.shape
      visited = np.zeros((width, height), dtype=bool)
      q = deque()
      q.append((cur_pos, []))
      visited[cur_pos[0], cur_pos[1]] = True

      while q:
          (x, y), path = q.popleft()
          # If this cell holds the target kind, we are done.
          if grid[x, y, target_kind] > 0:
              return (x, y), path
          # Explore neighbours (4‑connected)
          for dx, dy, act in ((1, 0, 3), (-1, 0, 2), (0, 1, 0), (0, -1, 1)):
              nx, ny = x + dx, y + dy
              if not (0 <= nx < width and 0 <= ny < height):
                  continue
              if visited[nx, ny]:
                  continue
              # Cell is blocked if any non‑zero count of a blocked kind is present.
              if any(grid[nx, ny, k] > 0 for k in blocked_kinds):
                  continue
              visited[nx, ny] = True
              q.append(((nx, ny), path + [act]))
      return None, None

  # ----------------------------------------------------------------------
  # 1. Reset environment and obtain initial state
  # ----------------------------------------------------------------------
  obs = env.reset()
  # The underlying state object is stored inside the env (implementation detail)
  # but we can retrieve it via the private attribute used by CraftLab.
  state = env._current_state  # type: CraftState
  grid = state.grid
  width, height, n_kinds = grid.shape
  pos = tuple(state.pos)   # (x, y)

  # ----------------------------------------------------------------------
  # 2. Determine goal index (the stick)
  # ----------------------------------------------------------------------
  # The task name is of the form "make[stick]" or similar.
  task_name = obs.get("task_name", "")
  # Try to extract the name inside brackets.
  match = re.search(r"\[(\w+)\]", task_name)
  if not match:
      # Fallback: assume env.task.goal exists.
      try:
          goal_idx = env.task.goal
      except Exception:
          raise ValueError("Cannot determine goal item from task description.")
  else:
      item_name = match.group(1)
      goal_idx = state.world.cookbook.index[item_name]

  # ----------------------------------------------------------------------
  # 3. Get primitive requirements for the goal
  # ----------------------------------------------------------------------
  cookbook = state.world.cookbook
  primitive_requirements = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}

  actions = []

  # ----------------------------------------------------------------------
  # 4. Collect each required primitive
  # ----------------------------------------------------------------------
  for prim_idx, needed in primitive_requirements.items():
      while needed > 0:
          # Find nearest instance of the primitive.
          # When moving we must treat all non‑grabbable and other primitives
          # as obstacles, except the target primitive itself.
          blocked = state.world.non_grabbable_indices.union(
              set(cookbook.kinds) - {prim_idx}
          )
          target_pos, move_actions = find_nearest(
              prim_idx, pos, grid, blocked
          )
          if target_pos is None:
              raise RuntimeError(f"Cannot locate required primitive {prim_idx}")

          # Execute movement actions to reach the primitive cell.
          actions.extend(move_actions)
          # Update our simulated position.
          for a in move_actions:
              if a == 0:   # DOWN
                  pos = (pos[0], pos[1] + 1)
              elif a == 1: # UP
                  pos = (pos[0], pos[1] - 1)
              elif a == 2: # LEFT
                  pos = (pos[0] - 1, pos[1])
              elif a == 3: # RIGHT
                  pos = (pos[0] + 1, pos[1])

          # At this point we are on the cell that contains the primitive.
          # Use the USE action to pick it up.
          actions.append(4)  # USE
          # Simulate the USE effect: update grid and inventory.
          # The environment will do this when we actually run the actions,
          # but we keep our local copy consistent for planning.
          grid[pos[0], pos[1], prim_idx] -= 1
          state.inventory[prim_idx] += 1
          needed -= 1

  # ----------------------------------------------------------------------
  # 5. Go to the required workshop and craft the stick
  # ----------------------------------------------------------------------
  # The recipe contains an "_at" entry specifying the workshop kind.
  workshop_kind = cookbook.recipes[goal_idx]["_at"]
  # Locate any workshop cell of this kind.
  workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
  if workshop_cells.size == 0:
      raise RuntimeError("No workshop of required type found.")
  # Choose the closest workshop (Manhattan distance).
  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
  workshop_idx = np.argmin(dists)
  workshop_pos = tuple(workshop_cells[workshop_idx])

  # Move adjacent to the workshop (any of the 8 neighbours).
  # We'll pick the neighbour with the smallest Manhattan distance.
  best_adj = None
  best_dist = None
  for adj in adjacent_cells(workshop_pos, width, height):
      # Check that the adjacent cell is not blocked.
      if any(grid[adj[0], adj[1], k] > 0 for k in state.world.non_grabbable_indices):
          continue
      dist = abs(adj[0] - pos[0]) + abs(adj[1] - pos[1])
      if best_dist is None or dist < best_dist:
          best_dist = dist
          best_adj = adj
  if best_adj is None:
      raise RuntimeError("Cannot reach workshop.")

  # Move to the chosen adjacent cell.
  for dx, dy in manhattan_path(pos, best_adj):
      act = step_to_action(dx, dy)
      actions.append(act)
      # Update simulated position.
      if act == 0:
          pos = (pos[0], pos[1] + 1)
      elif act == 1:
          pos = (pos[0], pos[1] - 1)
      elif act == 2:
          pos = (pos[0] - 1, pos[1])
      elif act == 3:
          pos = (pos[0] + 1, pos[1])

  # Finally, use the workshop to craft the stick.
  actions.append(4)  # USE

  return actions


