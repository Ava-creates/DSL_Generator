## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that will obtain a ``stick`` in the given
  :class:`CraftWorld` / :class:`CraftLab` environment.

  The implementation works for any world configuration that follows the
  recipe format used by ``CraftWorld``:

  * It queries the ``Cookbook`` for the primitive ingredients required to
    craft a stick.
  * It navigates to the nearest cell that contains each required primitive,
    picks it up (``USE``), and repeats until all ingredients are collected.
  * It then navigates to a workshop that can craft a stick and executes
    ``USE`` to perform the crafting action.

  The returned list can be fed directly to ``env.step(action)`` (or the
  higher‑level ``env`` wrappers) to complete the task.

  Note
  ----
  The function does **not** execute the actions; it only plans them based
  on the current state returned by ``env.reset()``.  It therefore updates a
  local copy of the grid and inventory to keep the plan consistent.
  """
  # ----------------------------------------------------------------------
  # Helper utilities
  # ----------------------------------------------------------------------
  def manhattan_path(start, goal):
      """Return a list of movement actions (DOWN,UP,LEFT,RIGHT) that moves
      from ``start`` to ``goal`` using a simple Manhattan walk."""
      ax, ay = start
      bx, by = goal
      actions = []
      # move in x direction
      while ax < bx:
          actions.append(RIGHT)
          ax += 1
      while ax > bx:
          actions.append(LEFT)
          ax -= 1
      # move in y direction (y grows downwards in the grid)
      while ay < by:
          actions.append(DOWN)
          ay += 1
      while ay > by:
          actions.append(UP)
          ay -= 1
      return actions

  def adjacent_position(target, avoid=None):
      """Return a position adjacent to ``target`` that is inside the grid
      and (optionally) not blocked by ``avoid`` (a set of coordinates)."""
      tx, ty = target
      candidates = [(tx - 1, ty), (tx + 1, ty), (tx, ty - 1), (tx, ty + 1)]
      for cx, cy in candidates:
          if 0 <= cx < WIDTH and 0 <= cy < HEIGHT:
              if avoid is None or (cx, cy) not in avoid:
                  return (cx, cy)
      # fallback – just return the target itself (will be handled later)
      return target

  # ----------------------------------------------------------------------
  # Initialise environment and retrieve useful constants
  # ----------------------------------------------------------------------
  # Reset to obtain a fresh state and the underlying objects
  env.reset()
  state = env._current_state          # CraftState instance
  world = env.world                    # CraftWorld instance
  cw = world.cookbook                  # Cookbook instance

  # Grid dimensions
  WIDTH, HEIGHT, _ = state.grid.shape

  # Action indices (the env knows the mapping)
  action_map = env.action_specs()
  DOWN = action_map["DOWN"]
  UP = action_map["UP"]
  LEFT = action_map["LEFT"]
  RIGHT = action_map["RIGHT"]
  USE = action_map["USE"]

  # ----------------------------------------------------------------------
  # Determine the recipe for a stick
  # ----------------------------------------------------------------------
  stick_idx = cw.index["stick"]
  # primitives needed (dict: primitive_kind_idx -> count)
  primitives_needed = cw.primitives_for(stick_idx).copy()
  # workshop where a stick can be crafted
  recipe = cw.recipes.get(stick_idx, {})
  workshop_idx = recipe.get("_at", None)

  # ----------------------------------------------------------------------
  # Local mutable copies of grid, position and inventory for planning
  # ----------------------------------------------------------------------
  grid = state.grid.copy()
  pos = tuple(state.pos)          # (x, y)
  inventory = state.inventory.copy()

  plan_actions = []

  # ----------------------------------------------------------------------
  # Helper to update the local copies after a USE action
  # ----------------------------------------------------------------------
  def perform_use(agent_pos, direction):
      """Simulate a USE action from ``agent_pos`` looking ``direction``.
      Updates ``grid`` and ``inventory`` accordingly."""
      dx, dy = {
          RIGHT: (1, 0),
          LEFT: (-1, 0),
          DOWN: (0, 1),
          UP: (0, -1)
      }[direction]
      tx, ty = agent_pos[0] + dx, agent_pos[1] + dy
      if not (0 <= tx < WIDTH and 0 <= ty < HEIGHT):
          return  # nothing to use

      cell = grid[tx, ty, :]
      # If there is a primitive item, pick it up
      prim_kinds = [k for k in world.grabbable_indices if cell[k] > 0]
      if prim_kinds:
          pk = prim_kinds[0]
          inventory[pk] += 1
          grid[tx, ty, pk] = 0
          return

      # If there is a workshop and we have the required ingredients,
      # craft the output (which is the item we are currently planning for)
      if cell[workshop_idx] > 0:
          # Verify we have enough primitives
          ok = True
          for p_idx, cnt in primitives_needed_original.items():
              if inventory[p_idx] < cnt:
                  ok = False
                  break
          if ok:
              # Consume ingredients
              for p_idx, cnt in primitives_needed_original.items():
                  inventory[p_idx] -= cnt
              # Add the crafted stick
              inventory[stick_idx] += 1

  # Keep a copy of the original primitive requirements for crafting check
  primitives_needed_original = primitives_needed.copy()

  # ----------------------------------------------------------------------
  # Collect all required primitives
  # ----------------------------------------------------------------------
  for prim_idx, needed_cnt in list(primitives_needed.items()):
      while needed_cnt > 0:
          # Locate the closest cell that still contains this primitive
          locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              raise RuntimeError(
                  f"Could not find required primitive {cw.index.get(prim_idx, prim_idx)}"
              )
          # Manhattan distance to current position
          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
          nearest = locations[dists.argmin()]
          target_cell = tuple(nearest.tolist())

          # Choose an adjacent cell from which we can USE
          adj = adjacent_position(target_cell, avoid={pos})
          # Move to the adjacent cell
          plan_actions.extend(manhattan_path(pos, adj))
          pos = adj

          # Determine direction we need to face to look at the primitive
          if target_cell[0] > pos[0]:
              facing = RIGHT
          elif target_cell[0] < pos[0]:
              facing = LEFT
          elif target_cell[1] > pos[1]:
              facing = DOWN
          else:
              facing = UP

          # Use to pick up the primitive
          plan_actions.append(USE)
          perform_use(pos, facing)

          # Update bookkeeping
          needed_cnt -= 1
          primitives_needed[prim_idx] = needed_cnt

  # ----------------------------------------------------------------------
  # Move to a workshop that can craft a stick and craft it
  # ----------------------------------------------------------------------
  if workshop_idx is None:
      raise RuntimeError("No workshop specified for crafting a stick.")

  # Find any workshop cell
  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
  if workshop_cells.size == 0:
      raise RuntimeError("No workshop cell found in the current grid.")
  workshop_cell = tuple(workshop_cells[0].tolist())

  # Move adjacent to the workshop
  adj_ws = adjacent_position(workshop_cell, avoid={pos})
  plan_actions.extend(manhattan_path(pos, adj_ws))
  pos = adj_ws

  # Face the workshop
  if workshop_cell[0] > pos[0]:
      facing_ws = RIGHT
  elif workshop_cell[0] < pos[0]:
      facing_ws = LEFT
  elif workshop_cell[1] > pos[1]:
      facing_ws = DOWN
  else:
      facing_ws = UP

  # Use to craft the stick
  plan_actions.append(USE)
  perform_use(pos, facing_ws)

  # ----------------------------------------------------------------------
  # Return the planned action list
  # ----------------------------------------------------------------------
  return plan_actions


