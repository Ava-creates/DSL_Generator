import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that will collect the required primitives for a
  ``stick`` and then craft it.  The implementation works with any
  ``CraftLab``‑like environment that follows the API described in the
  specification.

  The algorithm is simple:
  1.  Reset the environment to obtain the initial state.
  2.  Query the recipe for ``stick`` to obtain the needed primitives.
  3.  For each required primitive:
      a.  Locate the nearest instance of that primitive on the map.
      b.  Move the agent next to it (using BFS on empty cells).
      c.  Issue a ``USE`` action to pick it up.
  4.  Locate the workshop where ``stick`` must be crafted.
      (the workshop index is stored in the recipe under the special key
      ``"_at"``).
  5.  Move next to the workshop and issue a ``USE`` action to craft the
      stick.

  The function only returns the action list; it does **not** step the
  environment itself.
  """
  import collections
  import numpy as np

  # ----------------------------------------------------------------------
  # Helper utilities
  # ----------------------------------------------------------------------
  # Action indices (as defined by CraftLab.action_specs())
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
  ACTION_DELTAS = {
      DOWN:  (0,  1),
      UP:    (0, -1),
      LEFT:  (-1, 0),
      RIGHT: (1,  0),
  }

  def bfs(start, goal_pred, blocked):
      """Return a list of actions that moves the agent from *start* to a cell
      satisfying *goal_pred* while avoiding *blocked* cells.

      *start* – (x, y) tuple.
      *goal_pred* – callable ``lambda (x, y): bool``.
      *blocked* – 2‑D boolean array where ``True`` means the cell cannot be
                   entered.
      """
      W, H = blocked.shape
      q = collections.deque()
      q.append((start, []))
      visited = np.zeros((W, H), dtype=bool)
      visited[start] = True

      while q:
          (x, y), path = q.popleft()
          if goal_pred((x, y)):
              return path
          for a, (dx, dy) in ACTION_DELTAS.items():
              nx, ny = x + dx, y + dy
              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                  if not blocked[nx, ny]:
                      visited[nx, ny] = True
                      q.append(((nx, ny), path + [a]))
      raise RuntimeError("No path found")

  # ----------------------------------------------------------------------
  # 1. Reset environment and fetch the initial state
  # ----------------------------------------------------------------------
  env.reset()
  state = env._current_state                     # type: CraftState
  grid = state.grid                               # (W, H, n_kinds)
  W, H, n_kinds = grid.shape

  # ----------------------------------------------------------------------
  # 2. Determine which primitive indices are needed for a stick
  # ----------------------------------------------------------------------
  # The name of the goal item is assumed to be ``"stick"``.
  stick_idx = state.world.cookbook.index["stick"]
  # ``primitives_for`` returns a dict {primitive_idx: count}
  required = state.world.cookbook.primitives_for(stick_idx)

  # ----------------------------------------------------------------------
  # 3. Build a mask of cells that are blocked for movement
  # ----------------------------------------------------------------------
  # A cell is blocked if any non‑zero entry exists in its kind dimension
  # (i.e. something occupies the tile).  Cells that contain the agent are
  # also considered free.
  blocked = np.any(grid > 0, axis=2)               # shape (W, H)
  # The agent starts on an empty cell; ensure that cell is marked free.
  ax, ay = state.pos
  blocked[ax, ay] = False

  actions = []

  # ----------------------------------------------------------------------
  # 4. Collect each required primitive
  # ----------------------------------------------------------------------
  for prim_idx, count in required.items():
      for _ in range(count):
          # Locate all cells that contain this primitive
          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
          if prim_cells.size == 0:
              raise RuntimeError(f"Primitive {prim_idx} not found on map")

          # Choose the closest one (Manhattan distance) to the current pos
          dists = np.abs(prim_cells[:, 0] - ax) + np.abs(prim_cells[:, 1] - ay)
          target_cell = tuple(prim_cells[dists.argmin()])

          # We need to stand on a *free* neighbour of the target cell.
          def is_adjacent(pos):
              x, y = pos
              return (abs(x - target_cell[0]) + abs(y - target_cell[1])) == 1

          # Compute path to any adjacent free cell
          path = bfs((ax, ay), is_adjacent, blocked)
          actions.extend(path)

          # Update position after following the path
          for a in path:
              dx, dy = ACTION_DELTAS[a]
              ax, ay = ax + dx, ay + dy

          # Use action to pick up the primitive
          actions.append(USE)

          # Update the environment model:
          #   - remove the primitive from the grid
          #   - add it to the inventory
          grid[target_cell[0], target_cell[1], prim_idx] = 0
          state.inventory[prim_idx] += 1

          # The current cell (ax, ay) is still free, but the target cell
          # becomes free now, so we keep the same ``blocked`` mask (it was
          # already ``True`` because of the primitive, we clear it now).
          blocked[target_cell[0], target_cell[1]] = False

  # ----------------------------------------------------------------------
  # 5. Move to the workshop for the stick and craft it
  # ----------------------------------------------------------------------
  # The workshop index is stored in the recipe under the special key "_at".
  # ``recipes`` is a dict {output_idx: {ingredient_idx: cnt, "_at": workshop_idx}}.
  workshop_idx = state.world.cookbook.recipes[stick_idx]["_at"]

  # Locate all workshop cells
  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
  if workshop_cells.size == 0:
      raise RuntimeError("No workshop for stick found on map")

  # Choose the nearest workshop cell
  dists = np.abs(workshop_cells[:, 0] - ax) + np.abs(workshop_cells[:, 1] - ay)
  target_ws = tuple(workshop_cells[dists.argmin()])

  # Path to a neighbour of the workshop
  def is_adjacent_ws(pos):
      x, y = pos
      return (abs(x - target_ws[0]) + abs(y - target_ws[1])) == 1

  path = bfs((ax, ay), is_adjacent_ws, blocked)
  actions.extend(path)

  # Update position after moving
  for a in path:
      dx, dy = ACTION_DELTAS[a]
      ax, ay = ax + dx, ay + dy

  # Final USE action to craft the stick
  actions.append(USE)

  # ----------------------------------------------------------------------
  # 6. Return the full action list
  # ----------------------------------------------------------------------
  return actions


