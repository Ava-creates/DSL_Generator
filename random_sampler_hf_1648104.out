"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that will make a *stick* in the given
  CraftLab environment.

  The implementation follows a very simple planner:

  1.  Look up the index of the item ``stick`` in the world cookbook.
  2.  Query the recipe for ``stick`` to obtain the required primitive
      kinds and their counts as well as the workshop where the item must
      be crafted.
  3.  For each required primitive:
      *   Find the nearest cell that contains the primitive.
      *   Move the agent to that cell (using Manhattan moves only).
      *   Execute the ``USE`` action to pick it up.
  4.  Move to the required workshop and execute ``USE`` once to craft
      the stick.

  The function does **not** try to be optimal – it merely produces a
  correct sequence of actions for any environment that follows the
  specification described in the prompt.
  """
  # ------------------------------------------------------------------
  # Helper utilities
  # ------------------------------------------------------------------
  # Action constants – they match the ordering used by CraftLab.
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

  def manhattan(a, b):
      """Manhattan distance between two (x, y) tuples."""
      return abs(a[0] - b[0]) + abs(a[1] - b[1])

  def move_towards(src, dst):
      """
      Generate a list of movement actions that brings the agent from
      ``src`` to ``dst`` using only horizontal and vertical steps.
      The function prefers horizontal moves first, then vertical.
      """
      actions = []
      x, y = src
      tx, ty = dst

      # Horizontal moves
      while x < tx:
          actions.append(RIGHT)
          x += 1
      while x > tx:
          actions.append(LEFT)
          x -= 1

      # Vertical moves
      while y < ty:
          actions.append(DOWN)
          y += 1
      while y > ty:
          actions.append(UP)
          y -= 1

      return actions

  # ------------------------------------------------------------------
  # Access the underlying CraftState from the Lab wrapper.
  # ------------------------------------------------------------------
  state = env._current_state          # type: CraftState
  world = env.world                    # type: CraftWorld
  cookbook = world.cookbook

  # ------------------------------------------------------------------
  # 1. Find the index of the target item ("stick").
  # ------------------------------------------------------------------
  stick_idx = cookbook.index["stick"]

  # ------------------------------------------------------------------
  # 2. Retrieve the recipe for the stick.
  # ------------------------------------------------------------------
  recipe = cookbook.recipes.get(stick_idx, {})
  # ``recipe`` is a dict where keys are ingredient indices (int) and
  # values are required counts (int).  The workshop is stored under the
  # special key "_at".
  workshop_idx = recipe.get("_at")
  # Remove the workshop entry so that we are left only with primitive
  # requirements.
  primitive_requirements = {
      k: v for k, v in recipe.items() if k != "_at"
  }

  # ------------------------------------------------------------------
  # 3. Collect all required primitives.
  # ------------------------------------------------------------------
  actions = []
  cur_pos = state.pos  # (x, y)

  for prim_idx, needed in primitive_requirements.items():
      # Find all cells that currently contain this primitive.
      # ``grid`` has shape (W, H, n_kinds) and is one‑hot.
      locations = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
      # If for some reason there are no locations (should not happen in
      # a valid scenario) we simply skip.
      if not locations:
          continue

      # Repeatedly collect the required number of that primitive.
      for _ in range(needed):
          # Choose the nearest location (Manhattan distance).
          nearest = min(locations, key=lambda p: manhattan(cur_pos, p))

          # Move to that location.
          actions.extend(move_towards(cur_pos, nearest))
          cur_pos = nearest

          # Pick it up.
          actions.append(USE)

          # Update the internal view of the grid – after a successful
          # ``USE`` the primitive disappears from the cell.
          # (We do not modify the real environment here; the plan is
          #  based on the assumption that the action will succeed.)
          # Remove the used location from future consideration.
          locations.remove(nearest)

  # ------------------------------------------------------------------
  # 4. Move to the workshop and craft the stick.
  # ------------------------------------------------------------------
  if workshop_idx is not None:
      # Locate all workshop cells of the required type.
      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
      if workshop_cells:
          # Choose the nearest workshop.
          target_ws = min(workshop_cells, key=lambda p: manhattan(cur_pos, p))
          actions.extend(move_towards(cur_pos, target_ws))
          cur_pos = target_ws
          # Craft the stick.
          actions.append(USE)

  return actions


