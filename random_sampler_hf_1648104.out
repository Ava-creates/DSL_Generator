"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a sequence of actions that will cause the agent to craft a stick
  in the provided CraftWorld environment.

  This generic implementation queries the environment for the recipe
  for a stick, collects any required primitives, moves to the appropriate
  workshop, and performs the craft action.  If the environment does not
  provide enough information to construct a plan, it falls back to an
  empty action list.

  Parameters
  ----------
  env : CraftLab or compatible CraftWorld environment
      The environment in which the stick must be crafted.

  Returns
  -------
  List[int]
      A list of action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)
      that will result in a stick being added to the agent's inventory.
  """
  # Action constants (as defined in the environment)
  ACTION_DOWN = 0
  ACTION_UP = 1
  ACTION_LEFT = 2
  ACTION_RIGHT = 3
  ACTION_USE = 4

  # Helper to compute Manhattan distance
  def manhattan(a, b):
      return abs(a[0] - b[0]) + abs(a[1] - b[1])

  # Retrieve the index for the stick item from the world index
  try:
      stick_idx = env.world.cookbook.index("stick")
  except Exception:
      # If stick is not defined, we cannot craft it
      return []

  # Get the recipe for the stick (primitive requirements and workshop)
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  if not recipe:
      # No recipe means stick is a primitive; just collect it if possible
      required = {stick_idx: 1}
      workshop_idx = None
  else:
      # Separate ingredients from the special "_at" key
      workshop_name = recipe.get("_at", None)
      workshop_idx = env.world.cookbook.index(workshop_name) if workshop_name else None
      required = {k: v for k, v in recipe.items() if k != "_at"}

  # ------------------------------------------------------------------
  # 1. Collect all required primitive items
  # ------------------------------------------------------------------
  actions = []
  # Keep track of items already collected
  collected = {k: 0 for k in required}

  # Simple BFS to locate nearest instance of a required primitive
  from collections import deque

  # Function to find the nearest cell containing a given kind
  def find_nearest(kind):
      start = env._current_state.pos
      visited = set()
      q = deque([(start, [])])
      while q:
          (x, y), path = q.popleft()
          if (x, y) in visited:
              continue
          visited.add((x, y))
          # Check if this cell contains the desired kind
          if env._current_state.grid[x, y, kind] > 0:
              return path
          # Explore neighbours (4‑connected)
          for dx, dy, act in [(-1, 0, ACTION_UP), (1, 0, ACTION_DOWN),
                              (0, -1, ACTION_LEFT), (0, 1, ACTION_RIGHT)]:
              nx, ny = x + dx, y + dy
              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:
                  q.append(((nx, ny), path + [act]))
      return None

  # Collect each required primitive
  for kind, count in required.items():
      while collected[kind] < count:
          path = find_nearest(kind)
          if path is None:
              # Cannot find required primitive; abort plan
              return []
          actions.extend(path)
          # Use action to pick up the primitive
          actions.append(ACTION_USE)
          # Simulate the action on the environment to update state
          for a in path + [ACTION_USE]:
              _, _ = env.step(a)
          collected[kind] += 1

  # ------------------------------------------------------------------
  # 2. Move to the appropriate workshop (if required) and craft
  # ------------------------------------------------------------------
  if workshop_idx is not None:
      # Find nearest workshop cell
      path_to_workshop = find_nearest(workshop_idx)
      if path_to_workshop is None:
          return []
      actions.extend(path_to_workshop)
      for a in path_to_workshop:
          _, _ = env.step(a)

  # Finally, perform the crafting action
  actions.append(ACTION_USE)
  # Apply the final USE action to actually craft the stick
  _, _ = env.step(ACTION_USE)

  return actions


