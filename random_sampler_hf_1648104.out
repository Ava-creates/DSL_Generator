## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that makes the agent craft a ``stick`` in the
  provided ``CraftLab`` environment.

  The implementation is completely generic – it works for any
  ``CraftWorld`` configuration as long as a recipe for ``stick`` exists.
  The steps are:

  1.  Locate the index of the item ``stick`` in the world’s ``Cookbook``.
  2.  Ask the ``Cookbook`` for the primitive requirements of that item.
  3.  For each required primitive:
      *   Find the *nearest* cell that currently holds the primitive.
      *   Move the agent to that cell (using Manhattan moves).
      *   Issue a ``USE`` action to pick the primitive up.
  4.  After all primitives are in the inventory, move to a workshop that
      can craft ``stick`` (the workshop type is stored in the recipe under
      the special key ``"_at"``) and issue a final ``USE`` to craft it.

  The function does **not** execute the actions – it only returns the
  integer action sequence.  The caller can feed the list to ``env.step``.
  """
  # --------------------------------------------------------------------- #
  # Helper constants – they match the action ordering used by CraftWorld. #
  # --------------------------------------------------------------------- #
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

  # --------------------------------------------------------------------- #
  # Helper utilities.                                                   #
  # --------------------------------------------------------------------- #
  def manhattan_path(src, dst):
      """Return a list of moves (DOWN/UP/LEFT/RIGHT) that walks from src to dst."""
      sx, sy = src
      dx, dy = dst
      moves = []
      # vertical movement
      while sx < dx:
          moves.append(DOWN)
          sx += 1
      while sx > dx:
          moves.append(UP)
          sx -= 1
      # horizontal movement
      while sy < dy:
          moves.append(RIGHT)
          sy += 1
      while sy > dy:
          moves.append(LEFT)
          sy -= 1
      return moves

  def nearest_position(grid, kind_idx, start_pos):
      """Find the nearest cell (Manhattan distance) that contains ``kind_idx``."""
      h, w = grid.shape[:2]
      best = None
      best_dist = None
      # ``grid`` is (WIDTH, HEIGHT, n_kinds)
      for x in range(w):
          for y in range(h):
              if grid[x, y, kind_idx] > 0:
                  dist = abs(x - start_pos[0]) + abs(y - start_pos[1])
                  if best_dist is None or dist < best_dist:
                      best_dist = dist
                      best = (x, y)
      return best

  # --------------------------------------------------------------------- #
  # 1.  Resolve the index of ``stick``.                                   #
  # --------------------------------------------------------------------- #
  cookbook = env.world.cookbook
  stick_idx = cookbook.index['stick']           # raises KeyError if not present

  # --------------------------------------------------------------------- #
  # 2.  Primitive requirements for the recipe.                           #
  # --------------------------------------------------------------------- #
  # ``primitives_for`` returns a dict {primitive_idx: count}.
  primitive_needs = cookbook.primitives_for(stick_idx)

  # The workshop where the stick must be crafted is stored under the key
  # ``"_at"`` in the recipe dict.
  workshop_kind = cookbook.recipes[stick_idx].get('_at', None)

  # --------------------------------------------------------------------- #
  # 3.  Reset the environment to obtain a fresh state.                    #
  # --------------------------------------------------------------------- #
  # ``env.reset`` returns an observation dict – we only need the internal
  # state to read the grid and the agent’s position.
  env.reset()
  state = env._current_state          # type: CraftState
  actions = []

  # --------------------------------------------------------------------- #
  # 4.  Collect every required primitive.                                 #
  # --------------------------------------------------------------------- #
  for prim_idx, count in primitive_needs.items():
      for _ in range(count):
          # locate the nearest instance of the primitive
          target = nearest_position(state.grid, prim_idx, state.pos)
          if target is None:
              raise RuntimeError(f"Primitive {prim_idx} not found on the map.")
          # move to the primitive
          actions += manhattan_path(state.pos, target)
          # pick it up
          actions.append(USE)
          # simulate the move locally so that subsequent searches use the
          # updated position (the environment itself will also move when the
          # actions are executed by the caller).
          state.pos = target

  # --------------------------------------------------------------------- #
  # 5.  Move to the appropriate workshop and craft the stick.            #
  # --------------------------------------------------------------------- #
  if workshop_kind is not None:
      workshop_pos = nearest_position(state.grid, workshop_kind, state.pos)
      if workshop_pos is None:
          raise RuntimeError("No workshop of the required type found on the map.")
      actions += manhattan_path(state.pos, workshop_pos)
      actions.append(USE)   # craft at the workshop
  else:
      # If the recipe does not require a workshop we can simply USE at the
      # current location.
      actions.append(USE)

  return actions


