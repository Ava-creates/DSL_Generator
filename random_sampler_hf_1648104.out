## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  # get stick index
  stick_idx = env.world.cookbook.index["stick"]
  # get primitives required
  prims = env.world.cookbook.primitives_for(stick_idx)
  actions = []
  # get current grid and position
  grid = env.scenario.init_grid
  pos = list(env.scenario.init_pos)
  # helper to find nearest cell with given kind
  def find_nearest(kind):
      h,w,_ = grid.shape
      best = None
      bestd = 1e9
      for y in range(h):
          for x in range(w):
              if grid[y,x,kind] > 0:
                  d = abs(x-pos[0]) + abs(y-pos[1])
                  if d < bestd:
                      bestd = d
                      best = (x,y)
      return best
  # move function
  def move_to(target):
      tx,ty = target
      while pos[0] < tx:
          actions.append(3) # RIGHT
          pos[0]+=1
      while pos[0] > tx:
          actions.append(2) # LEFT
          pos[0]-=1
      while pos[1] < ty:
          actions.append(0) # DOWN
          pos[1]+=1
      while pos[1] > ty:
          actions.append(1) # UP
          pos[1]-=1
  # collect primitives
  for kind,count in prims.items():
      for _ in range(count):
          loc = find_nearest(kind)
          if loc is None:
              raise ValueError("Primitive not found")
          move_to(loc)
          actions.append(4) # USE to pick up
  # after collecting, need to craft at workshop
  # find workshop for stick: recipe includes _at key
  recipe = env.world.cookbook.recipes[stick_idx]
  workshop_kind = recipe.get("_at")
  if workshop_kind is not None:
      # find nearest workshop cell
      loc = find_nearest(workshop_kind)
      if loc is None:
          raise ValueError("Workshop not found")
      move_to(loc)
      actions.append(4) # USE to craft
  return actions


