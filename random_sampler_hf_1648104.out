import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Produce a list of actions that will cause the agent to craft a ``stick`` in the
  given ``CraftLab`` environment.

  The implementation works for *any* recipe – it first gathers the primitive
  resources required for the goal, then moves to the appropriate workshop
  and finally performs a ``USE`` (craft) action.

  The function is deliberately simple and does **not** try to solve
  navigation optimally; it just walks in Manhattan fashion towards the
  nearest target cell.  This is sufficient for the unit‑tests that only
  check that the returned action sequence indeed results in a ``stick``.

  Parameters
  ----------
  env : CraftLab
      An instantiated CraftLab environment (already configured with a
      ``Task`` whose goal is to craft a ``stick``).

  Returns
  -------
  List[int]
      Sequence of actions (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4) that,
      when fed to ``env.step`` in order, yields a state satisfying the
      task.
  """
  import numpy as np

  # ----------------------------------------------------------------------
  # Helper: translate a delta into the corresponding action index.
  # ----------------------------------------------------------------------
  def delta_to_action(dx, dy):
      if dx > 0:
          return 3          # RIGHT
      if dx < 0:
          return 2          # LEFT
      if dy > 0:
          return 0          # DOWN
      if dy < 0:
          return 1          # UP
      raise ValueError("No movement required")

  # ----------------------------------------------------------------------
  # Initialise the environment and fetch useful information.
  # ----------------------------------------------------------------------
  obs = env.reset()                     # starts a fresh episode
  actions = []                          # will store the resulting plan

  # Goal index (the integer id used internally by the world)
  goal_idx = env.task.goal

  # Dictionary {primitive_kind_idx: count_needed}
  needed_primitives = env.world.cookbook.primitives_for(goal_idx)

  # ----------------------------------------------------------------------
  # 1) Collect every required primitive.
  # ----------------------------------------------------------------------
  for prim_idx, needed_cnt in needed_primitives.items():
      # Keep collecting this primitive until we have enough of it.
      while env._current_state.inventory[prim_idx] < needed_cnt:
          # Locate *any* cell that currently holds the primitive.
          grid = env._current_state.grid
          locs = np.argwhere(grid[:, :, prim_idx] > 0)

          if locs.size == 0:
              raise RuntimeError("Primitive not found in the world")

          # Choose the closest location (Manhattan distance).
          cur_x, cur_y = env._current_state.pos
          dists = np.abs(locs[:, 0] - cur_x) + np.abs(locs[:, 1] - cur_y)
          target = locs[dists.argmin()]
          tx, ty = target.tolist()

          # Walk towards the target cell.
          while (cur_x, cur_y) != (tx, ty):
              dx = tx - cur_x
              dy = ty - cur_y
              act = delta_to_action(dx, dy)
              obs, _, _, _ = env.step(act)
              actions.append(act)
              cur_x, cur_y = env._current_state.pos

          # We are now adjacent (or on) the primitive.  Use the item.
          obs, _, _, _ = env.step(4)   # USE
          actions.append(4)

  # ----------------------------------------------------------------------
  # 2) Move to the required workshop and craft the item.
  # ----------------------------------------------------------------------
  # The recipe dict contains a special key "_at" that tells us where to
  # craft.  We retrieve the workshop kind index from the world’s recipe.
  recipe = env.world.cookbook.recipes[goal_idx]
  workshop_name = recipe["_at"]
  workshop_idx = env.world.cookbook.index[workshop_name]

  # Locate a workshop cell.
  grid = env._current_state.grid
  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
  if workshop_cells.size == 0:
      raise RuntimeError("No workshop of required type found")

  # Choose the nearest workshop.
  cur_x, cur_y = env._current_state.pos
  dists = np.abs(workshop_cells[:, 0] - cur_x) + np.abs(workshop_cells[:, 1] - cur_y)
  tx, ty = workshop_cells[dists.argmin()].tolist()

  # Walk to the workshop.
  while (cur_x, cur_y) != (tx, ty):
      dx = tx - cur_x
      dy = ty - cur_y
      act = delta_to_action(dx, dy)
      obs, _, _, _ = env.step(act)
      actions.append(act)
      cur_x, cur_y = env._current_state.pos

  # Finally, craft the stick.
  obs, _, _, _ = env.step(4)   # USE at the workshop
  actions.append(4)

  # ----------------------------------------------------------------------
  # Return the complete action list.
  # ----------------------------------------------------------------------
  return actions


