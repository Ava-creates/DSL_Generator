import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that will craft a ``stick`` in the given
  ``CraftWorld`` environment.

  The function tries the following strategies (in order):

  1. If the environment provides a ``plan_to_craft`` method, use it to
     obtain a plan for the ``stick`` index.
  2. If the environment provides a ``craft`` method, use it to obtain a
     plan for the ``stick`` index.
  3. As a last resort, look up the ``stick`` index in the cookbook and,
     if the index is found, return an empty plan (the caller can decide
     how to handle the missing planning capability).

  Parameters
  ----------
  env : object
      An instance of a ``CraftWorld`` environment (or a wrapper such as
      ``CraftLab``) that contains a ``world`` attribute with a ``cookbook``
      and optionally ``plan_to_craft`` / ``craft`` helper methods.

  Returns
  -------
  list[int]
      A list of action IDs (e.g. ``0``=DOWN, ``1``=UP, ``2``=LEFT,
      ``3``=RIGHT, ``4``=USE) that, when executed sequentially, will
      produce a ``stick`` in the agent's inventory.  An empty list is
      returned if no planning method is available or the ``stick`` item
      cannot be located in the recipe index.
  """
  # ------------------------------------------------------------------
  # 1. Find the integer index that corresponds to the item name "stick".
  # ------------------------------------------------------------------
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except Exception:
      # If the index lookup fails we cannot construct a plan.
      return []

  # ------------------------------------------------------------------
  # 2. Prefer the high‑level planning helper if it exists.
  # ------------------------------------------------------------------
  if hasattr(env, "plan_to_craft"):
      try:
          plan = env.plan_to_craft(stick_idx)
          # ``plan`` may be any iterable; convert it to a plain list.
          return list(plan)
      except Exception:
          # If the helper raises, fall back to the next method.
          pass

  # ------------------------------------------------------------------
  # 3. Fall back to the generic ``craft`` method that many wrappers
  #    expose.  It is expected to return a sequence of actions.
  # ------------------------------------------------------------------
  if hasattr(env, "craft"):
      try:
          plan = env.craft(stick_idx)
          return list(plan)
      except Exception:
          pass

  # ------------------------------------------------------------------
  # 4. No automatic planner available – return an empty plan.
  # ------------------------------------------------------------------
  return []


