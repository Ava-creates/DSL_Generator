import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that will cause the agent to craft a ``stick`` in the
  provided CraftWorld environment.

  The function inspects the current state, extracts the recipe for ``stick``,
  locates the required primitive resources and the workshop (if any), and then
  builds a simple Manhattan‑style plan:

  * Move to each primitive location.
  * Use the ``USE`` action to pick it up.
  * Move to the workshop location.
  * Use the ``USE`` action to craft the stick.

  The plan assumes that all required primitives are reachable without having
  to navigate around obstacles (which holds for the simple test worlds used
  in the evaluation).  The returned actions are integers matching the
  ``CraftLab`` action specification:

      DOWN → 0,   UP → 1,   LEFT → 2,   RIGHT → 3,   USE → 4
  """
  import numpy as np

  # --------------------------------------------------------------------- #
  # Helper: simple Manhattan path (ignores obstacles, works for test worlds)
  # --------------------------------------------------------------------- #
  def _manhattan_path(start, goal):
      """Return a list of movement actions from start to goal."""
      actions = []
      x, y = start
      tx, ty = goal
      # move in x direction (RIGHT = 3, LEFT = 2)
      while x < tx:
          actions.append(3)   # RIGHT
          x += 1
      while x > tx:
          actions.append(2)   # LEFT
          x -= 1
      # move in y direction (DOWN = 0, UP = 1)
      while y < ty:
          actions.append(0)   # DOWN
          y += 1
      while y > ty:
          actions.append(1)   # UP
          y -= 1
      return actions

  # --------------------------------------------------------------------- #
  # Grab handles to the world, cookbook and current state
  # --------------------------------------------------------------------- #
  world = env.world                     # CraftWorld instance
  cookbook = world.cookbook              # holds recipes and indices
  state = env._current_state             # CraftState instance (internal)

  # --------------------------------------------------------------------- #
  # Identify the stick recipe and required primitives
  # --------------------------------------------------------------------- #
  stick_idx = cookbook.index["stick"]
  # ``primitives_for`` returns a dict {primitive_idx: count}
  needed = cookbook.primitives_for(stick_idx)

  # Full recipe also contains the workshop information (key "_at")
  full_recipe = cookbook.recipes.get(stick_idx, {})
  workshop_name = full_recipe.get("_at", None)

  # --------------------------------------------------------------------- #
  # Locate all required primitives in the current grid
  # --------------------------------------------------------------------- #
  grid = state.grid                       # shape (W, H, n_kinds)
  primitive_locs = {}                     # prim_idx -> list of positions
  for prim_idx, cnt in needed.items():
      # find all cells where this primitive is present
      cells = np.argwhere(grid[:, :, prim_idx] > 0)
      if len(cells) < cnt:
          raise RuntimeError(
              f"Not enough of primitive {cookbook.index.get(prim_idx, prim_idx)}"
          )
      # store exactly the required number of locations (as (x, y) tuples)
      primitive_locs[prim_idx] = [tuple(pos) for pos in cells[:cnt]]

  # --------------------------------------------------------------------- #
  # Locate the workshop (if the recipe requires one)
  # --------------------------------------------------------------------- #
  workshop_pos = None
  if workshop_name is not None:
      workshop_idx = cookbook.index[workshop_name]
      wk_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
      if wk_cells.size == 0:
          raise RuntimeError(f"Workshop {workshop_name} not found in the world")
      workshop_pos = tuple(wk_cells[0])   # pick the first occurrence

  # --------------------------------------------------------------------- #
  # Build the action sequence
  # --------------------------------------------------------------------- #
  actions = []
  cur_pos = state.pos                     # current (x, y) of the agent

  # Collect each required primitive
  for prim_idx, locations in primitive_locs.items():
      for target in locations:
          # move to the cell containing the primitive
          actions.extend(_manhattan_path(cur_pos, target))
          cur_pos = target
          # pick it up
          actions.append(4)              # USE
  # Move to the workshop (if any) and craft
  if workshop_pos is not None:
      actions.extend(_manhattan_path(cur_pos, workshop_pos))
      cur_pos = workshop_pos
      actions.append(4)                  # USE to craft

  return actions


