import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of low‑level action indices that will cause the agent to
  obtain at least one ``stick`` in the supplied CraftWorld environment.

  The implementation is deliberately generic: it queries the world’s
  ``Cookbook`` for the index and primitive requirements of a stick and
  then asks the environment (if possible) for a concrete plan.  If the
  environment does not expose a planning helper we fall back to any
  available ``craft`` method; otherwise an empty plan is returned.

  Parameters
  ----------
  env : object
      An instance of the CraftWorld environment (or a compatible mock).

  Returns
  -------
  List[int]
      Sequence of action indices that achieve the goal.
  """
  # ------------------------------------------------------------------
  # 1. Resolve the integer index for the goal item ``stick``.
  # ------------------------------------------------------------------
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except Exception:  # Defensive fallback if world/cookbook missing
      return []

  # ------------------------------------------------------------------
  # 2. Determine which primitive resources are required to craft a stick.
  # ------------------------------------------------------------------
  try:
      primitive_requirements = env.world.cookbook.primitives_for(stick_idx)
  except Exception:
      primitive_requirements = {}

  # ------------------------------------------------------------------
  # 3. Ask the environment for a concrete plan, if it provides one.
  # ------------------------------------------------------------------
  plan = []
  if hasattr(env, "plan_to_craft"):
      try:
          plan = env.plan_to_craft(stick_idx, primitive_requirements)
      except Exception:
          plan = []

  # ------------------------------------------------------------------
  # 4. Fallback: use a direct ``craft`` helper if available.
  # ------------------------------------------------------------------
  elif hasattr(env, "craft"):
      try:
          # ``craft`` may accept either the name or the index.
          plan = env.craft("stick")
      except Exception:
          plan = []

  # Ensure a list of ints is returned.
  return list(plan)


