import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a simple plan (as a list of action indices) that collects the
  required primitives for a ``stick`` and then crafts it at the appropriate
  workshop.

  The implementation is deliberately straightforward:
  * It queries the world’s ``Cookbook`` for the recipe of ``stick``.
  * For each required primitive it finds the first occurrence of that primitive
    on the current grid, moves the agent there with Manhattan moves (ignoring
    obstacles) and performs a ``USE`` action to pick it up.
  * After all primitives are collected it moves to the workshop specified in
    the recipe and performs a ``USE`` action to craft the stick.

  The function works with the standard CraftWorld / CraftLab API where
  actions are indexed as:
      0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT, 4 – USE

  Args:
      env: An instance of ``CraftLab`` (or any compatible wrapper) that
           provides access to the underlying ``CraftWorld`` via ``env.world``
           and the current state via ``env._current_state``.

  Returns:
      List[int]: A list of action indices that, when executed sequentially,
                 will (attempt to) produce a stick.
  """
  # --------------------------------------------------------------------- #
  # Helper functions for movement and action generation.
  # --------------------------------------------------------------------- #
  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4

  def manhattan_path(start, goal):
      """Return a list of movement actions (no USE) that walk from start to goal."""
      sx, sy = start
      gx, gy = goal
      actions = []
      # Move in x direction first
      while sx < gx:
          actions.append(ACTION_RIGHT)
          sx += 1
      while sx > gx:
          actions.append(ACTION_LEFT)
          sx -= 1
      # Then move in y direction
      while sy < gy:
          actions.append(ACTION_DOWN)
          sy += 1
      while sy > gy:
          actions.append(ACTION_UP)
          sy -= 1
      return actions

  # --------------------------------------------------------------------- #
  # Retrieve world and indexing information.
  # --------------------------------------------------------------------- #
  world = env.world                     # CraftWorld instance
  state = env._current_state            # CraftState instance
  grid = state.grid                      # (W, H, n_kinds) occupancy array
  pos = tuple(state.pos)                 # (x, y) current agent position
  idx = world.cookbook.index             # Index mapping names ↔ integers

  # --------------------------------------------------------------------- #
  # Identify the goal item (stick) and its recipe.
  # --------------------------------------------------------------------- #
  try:
      stick_name = "stick"
      stick_idx = idx[stick_name]
  except Exception as e:
      raise ValueError(f"Cannot find index for item '{stick_name}': {e}")

  # Primitive requirements for one stick.
  primitives_needed = world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}
  if not primitives_needed:
      # No recipe – nothing to do.
      return []

  # --------------------------------------------------------------------- #
  # Collect each required primitive.
  # --------------------------------------------------------------------- #
  plan = []
  for prim_idx, count in primitives_needed.items():
      # Locate the primitive on the grid (first occurrence).
      locations = np.argwhere(grid[:, :, prim_idx] > 0)
      if locations.size == 0:
          # Primitive not present – cannot continue; skip.
          continue
      # Choose the first location.
      target_x, target_y = locations[0]
      # Move to the primitive location.
      plan.extend(manhattan_path(pos, (target_x, target_y)))
      pos = (target_x, target_y)
      # Pick up the required number of times (USE action).
      for _ in range(count):
          plan.append(ACTION_USE)
      # After picking up, the primitive cell is now empty; we keep the
      # current position for the next iteration.

  # --------------------------------------------------------------------- #
  # Move to the workshop specified in the recipe and craft the stick.
  # --------------------------------------------------------------------- #
  # The recipe dictionary contains a special key "_at" indicating the workshop.
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if workshop_name:
      workshop_idx = idx[workshop_name]
      # Find a workshop cell.
      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
      if ws_locs.size > 0:
          wx, wy = ws_locs[0]
          plan.extend(manhattan_path(pos, (wx, wy)))
          pos = (wx, wy)
          # Use the workshop to craft.
          plan.append(ACTION_USE)

  return plan


