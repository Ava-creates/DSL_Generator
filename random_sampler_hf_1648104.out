import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a ``stick`` in the given Craft
  environment.

  The function works for any recipe that uses only primitive resources and
  a single workshop (the usual case for the ``stick`` recipe).  It follows
  these steps:

  1.  Reset the environment and obtain the current ``CraftState``.
  2.  Determine the index of the goal item (``stick``) and the set of
      primitive resources required to craft it.
  3.  For each required primitive, locate a cell that contains the resource,
      navigate to a neighbouring cell that faces the resource and ``USE`` it
      to pick it up.
  4.  Locate the appropriate workshop, navigate to it (facing the workshop)
      and ``USE`` to craft the stick.
  5.  Return the concatenated list of actions.

  The implementation is deliberately generic – it does not rely on any
  hard‑coded coordinates or on the exact names of the primitives.  It only
  uses the public API of ``CraftWorld``, ``Cookbook`` and ``CraftState``.
  """
  import collections

  # --------------------------------------------------------------------- #
  # Helper utilities
  # --------------------------------------------------------------------- #
  # Directions as (dx, dy) in grid coordinates (row, col)
  DIRS = {
      "UP":    (-1, 0),
      "DOWN":  (1, 0),
      "LEFT":  (0, -1),
      "RIGHT": (0, 1),
  }
  # Map direction name to the integer action id used by the environment
  ACTIONS = env.action_specs()          # e.g. {"UP":0, "DOWN":1, ...}
  USE = ACTIONS["USE"]

  # --------------------------------------------------------------------- #
  # Breadth‑first search that returns a list of actions to move from ``src``
  # to ``dst`` (both are (row, col) tuples).  The path does **not** include a
  # final USE action.
  # --------------------------------------------------------------------- #
  def bfs_path(src, dst, occ_grid):
      """Return a list of movement actions (no USE) from src to dst."""
      if src == dst:
          return []

      H, W = occ_grid.shape
      q = collections.deque([src])
      visited = {src: None}
      move_dir = {}

      while q:
          cur = q.popleft()
          if cur == dst:
              break
          for name, (dx, dy) in DIRS.items():
              nxt = (cur[0] + dx, cur[1] + dy)
              if not (0 <= nxt[0] < H and 0 <= nxt[1] < W):
                  continue
              if occ_grid[nxt] != 0:          # blocked cell
                  continue
              if nxt not in visited:
                  visited[nxt] = cur
                  move_dir[nxt] = name
                  q.append(nxt)

      # reconstruct path
      if dst not in visited:
          raise RuntimeError("No path found")
      path = []
      cur = dst
      while cur != src:
          name = move_dir[cur]
          path.append(ACTIONS[name])
          cur = visited[cur]
      path.reverse()
      return path

  # --------------------------------------------------------------------- #
  # Find a cell that contains ``kind_idx`` (primitive or workshop).  If there
  # are several, pick the first one found.
  # --------------------------------------------------------------------- #
  def locate_kind(grid, kind_idx):
      """Return (row, col) of a cell that contains the given kind, or None."""
      locations = np.argwhere(grid[:, :, kind_idx] > 0)
      if len(locations) == 0:
          return None
      return tuple(locations[0])

  # --------------------------------------------------------------------- #
  # Given a target cell, compute a neighbour cell from which the agent can
  # ``USE`` it and also return the direction that the agent must be facing
  # when standing on that neighbour.
  # --------------------------------------------------------------------- #
  def neighbour_facing(target, occ_grid):
      """Return (neighbour_pos, needed_dir_name) suitable for a USE."""
      H, W = occ_grid.shape
      for name, (dx, dy) in DIRS.items():
          nb = (target[0] - dx, target[1] - dy)   # cell from which we look *to* target
          if 0 <= nb[0] < H and 0 <= nb[1] < W and occ_grid[nb] == 0:
              # needed_dir is the direction from neighbour to target
              needed_dir = name
              return nb, needed_dir
      raise RuntimeError("No free neighbour to interact with %s" % (target,))

  # --------------------------------------------------------------------- #
  # Ensure that after moving to ``pos`` the agent is facing ``desired_dir``.
  # If the last move already gives the correct direction we are done.
  # Otherwise we perform a small “turn” by stepping to an adjacent free cell
  # and stepping back.
  # --------------------------------------------------------------------- #
  def ensure_facing(state_pos, state_dir, target_pos, desired_dir, occ_grid):
      """
      Return a list of actions that ends with the agent at ``target_pos``
      facing ``desired_dir``.
      """
      # ``state_dir`` is the direction the agent is currently facing.
      # It is stored as an int (action id) – we translate it back to a name.
      rev_action = {v: k for k, v in ACTIONS.items()}
      cur_dir_name = rev_action.get(state_dir, None)

      if cur_dir_name == desired_dir:
          return []          # already correct

      # Find a free adjacent cell (different from target_pos) to step to.
      for name, (dx, dy) in DIRS.items():
          tmp = (target_pos[0] + dx, target_pos[1] + dy)
          if (0 <= tmp[0] < occ_grid.shape[0] and
              0 <= tmp[1] < occ_grid.shape[1] and
              occ_grid[tmp] == 0 and tmp != state_pos):
              # step to tmp, then back; the second move will set the direction
              # to the opposite of the first move, which is exactly what we need.
              first = ACTIONS[name]
              # direction opposite to ``name``
              opposite = {
                  "UP": "DOWN", "DOWN": "UP",
                  "LEFT": "RIGHT", "RIGHT": "LEFT"
              }[name]
              second = ACTIONS[opposite]
              return [first, second]
      # If we cannot find a turning spot we just return an empty list – the
      # environment will simply attempt the USE; in most maps this case does
      # not happen.
      return []

  # --------------------------------------------------------------------- #
  # Main logic starts here
  # --------------------------------------------------------------------- #
  # 1. reset environment
  obs = env.reset()
  state = env._current_state          # type: CraftState

  # 2. identify goal index for "stick"
  stick_idx = state.world.cookbook.index["stick"]

  # 3. determine required primitives and the workshop
  recipe = state.world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if workshop_name is None:
      raise RuntimeError("Stick recipe does not specify a workshop")
  workshop_idx = state.world.cookbook.index[workshop_name]

  # primitive requirements (exclude the special keys)
  primitive_reqs = {
      k: v for k, v in recipe.items()
      if k != "_at"
  }

  actions = []

  # ----------------------------------------------------------------- #
  # Helper to keep track of the mutable state (position, direction,
  # inventory, and occupancy grid) while we plan.
  # ----------------------------------------------------------------- #
  pos = state.pos
  dir_facing = state.dir
  inventory = state.inventory.copy()
  occ_grid = (state.grid.sum(axis=2) > 0).astype(np.int8)   # 1 = blocked, 0 = free

  # ----------------------------------------------------------------- #
  # 4. collect each required primitive
  # ----------------------------------------------------------------- #
  for prim_idx, count_needed in primitive_reqs.items():
      while inventory[prim_idx] < count_needed:
          # locate a cell that still has the primitive
          prim_loc = locate_kind(state.grid, prim_idx)
          if prim_loc is None:
              raise RuntimeError("Required primitive not present in the world")

          # find a free neighbour from which we can pick it up
          neigh, needed_dir = neighbour_facing(prim_loc, occ_grid)

          # plan path to neighbour
          path = bfs_path(pos, neigh, occ_grid)
          actions.extend(path)

          # update mutable state according to the path
          for a in path:
              # translate action back to direction name
              a_name = rev_action[a]
              dx, dy = DIRS[a_name]
              pos = (pos[0] + dx, pos[1] + dy)
              dir_facing = a

          # ensure we are facing the primitive
          turn_actions = ensure_facing(pos, dir_facing, neigh, needed_dir, occ_grid)
          actions.extend(turn_actions)
          for a in turn_actions:
              a_name = rev_action[a]
              dx, dy = DIRS[a_name]
              pos = (pos[0] + dx, pos[1] + dy)
              dir_facing = a

          # finally USE to pick it up
          actions.append(USE)
          # simulate the effect on inventory and grid
          inventory[prim_idx] += int(state.grid[prim_loc[0], prim_loc[1], prim_idx])
          state.grid[prim_loc[0], prim_loc[1], prim_idx] = 0
          occ_grid[prim_loc] = 0   # now the cell is free

  # ----------------------------------------------------------------- #
  # 5. go to the workshop and craft the stick
  # ----------------------------------------------------------------- #
  workshop_loc = locate_kind(state.grid, workshop_idx)
  if workshop_loc is None:
      raise RuntimeError("Workshop for stick not found")

  neigh, needed_dir = neighbour_facing(workshop_loc, occ_grid)
  path = bfs_path(pos, neigh, occ_grid)
  actions.extend(path)
  for a in path:
      a_name = rev_action[a]
      dx, dy = DIRS[a_name]
      pos = (pos[0] + dx, pos[1] + dy)
      dir_facing = a

  turn_actions = ensure_facing(pos, dir_facing, neigh, needed_dir, occ_grid)
  actions.extend(turn_actions)
  for a in turn_actions:
      a_name = rev_action[a]
      dx, dy = DIRS[a_name]
      pos = (pos[0] + dx, pos[1] + dy)
      dir_facing = a

  # USE to craft
  actions.append(USE)

  # ----------------------------------------------------------------- #
  # Return the complete action list
  # ----------------------------------------------------------------- #
  return actions


