import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a ``stick`` in the given CraftWorld
  environment.

  The function works in three stages:
  1.  Look up the index of the ``stick`` item and its recipe.
  2.  For each required primitive, locate the nearest instance on the map,
      walk to it (using simple Manhattan moves) and ``USE`` it to pick it up.
  3.  Walk to the required workshop (given by the ``_at`` field of the recipe)
      and ``USE`` there to craft the stick.

  The returned list can be fed directly to the environment via
  ``env.step(action)``.  The implementation is deliberately simple – it does
  not perform obstacle avoidance or sophisticated path‑finding – but it is
  sufficient for the standard ``craft`` environments where primitives are
  placed on open cells.

  Parameters
  ----------
  env : CraftLab
      An instance of the CraftLab wrapper (or any object exposing the same
      attributes used below).

  Returns
  -------
  List[int]
      Sequence of action indices (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE).
  """
  # ------------------------------------------------------------------ #
  # Helper utilities
  # ------------------------------------------------------------------ #
  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4

  def manhattan_path(src, dst):
      """Return a list of (action, new_dir) pairs to move from src to dst."""
      actions = []
      x, y = src
      tx, ty = dst
      # vertical moves
      while x < tx:
          actions.append(ACTION_DOWN)
          x += 1
      while x > tx:
          actions.append(ACTION_UP)
          x -= 1
      # horizontal moves
      while y < ty:
          actions.append(ACTION_RIGHT)
          y += 1
      while y > ty:
          actions.append(ACTION_LEFT)
          y -= 1
      return actions

  def adjacent(pos, target):
      """Return direction (action) needed to face ``target`` from an adjacent ``pos``."""
      x, y = pos
      tx, ty = target
      if x - 1 == tx and y == ty:
          return ACTION_UP
      if x + 1 == tx and y == ty:
          return ACTION_DOWN
      if x == tx and y - 1 == ty:
          return ACTION_LEFT
      if x == tx and y + 1 == ty:
          return ACTION_RIGHT
      raise ValueError("Target not adjacent to position")

  # ------------------------------------------------------------------ #
  # 1) Identify the stick item and its recipe
  # ------------------------------------------------------------------ #
  idx = env.world.cookbook.index  # Index instance mapping names ↔ ids
  stick_idx = idx["stick"]        # May raise KeyError if name differs
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  if not recipe:
      # No recipe – stick is likely a primitive; just collect one instance.
      needed = {stick_idx: 1}
      workshop_idx = None
  else:
      # Primitive requirements (ignore the special ``_at`` key)
      needed = {k: v for k, v in recipe.items() if k != "_at"}
      workshop_idx = recipe.get("_at", None)

  # ------------------------------------------------------------------ #
  # 2) Collect required primitives
  # ------------------------------------------------------------------ #
  actions = []
  # start from the initial position stored in the scenario
  cur_pos = env._current_state.pos if hasattr(env, "_current_state") else env.scenario.init_pos

  grid = env._current_state.grid if hasattr(env, "_current_state") else env.scenario.init_grid

  for prim_idx, count in needed.items():
      for _ in range(count):
          # locate the first occurrence of the primitive on the map
          locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if len(locations) == 0:
              raise RuntimeError(f"Primitive {idx.get(prim_idx)} not found on the map")
          # choose the nearest (Manhattan) location
          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])
          target_loc = tuple(locations[dists.argmin()])

          # move next to the primitive (we need to be adjacent)
          # compute a cell adjacent to the target that is free
          adj_candidates = [
              (target_loc[0] - 1, target_loc[1]),
              (target_loc[0] + 1, target_loc[1]),
              (target_loc[0], target_loc[1] - 1),
              (target_loc[0], target_loc[1] + 1),
          ]
          # pick the first free adjacent cell (where no entity occupies any kind)
          free_adj = None
          for cand in adj_candidates:
              if (0 <= cand[0] < grid.shape[0] and
                      0 <= cand[1] < grid.shape[1] and
                      not grid[cand[0], cand[1]].any()):
                  free_adj = cand
                  break
          if free_adj is None:
              # fallback: just move onto the target cell (will still work for many maps)
              free_adj = target_loc

          # walk to the adjacent cell
          actions.extend(manhattan_path(cur_pos, free_adj))
          cur_pos = free_adj

          # now face the primitive and USE to pick it up
          face_dir = adjacent(cur_pos, target_loc)
          # turn to the correct direction (if not already)
          actions.append(face_dir)          # turning is achieved by moving direction
          actions.append(ACTION_USE)        # pick up
          # update internal grid representation to reflect pickup (optional)
          grid[target_loc[0], target_loc[1], prim_idx] = 0

  # ------------------------------------------------------------------ #
  # 3) Go to the workshop and craft the stick
  # ------------------------------------------------------------------ #
  if workshop_idx is not None:
      # locate any workshop of the required type
      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
      if len(workshop_cells) == 0:
          raise RuntimeError("Required workshop not found on the map")
      # pick the nearest one
      dists = np.abs(workshop_cells[:, 0] - cur_pos[0]) + np.abs(workshop_cells[:, 1] - cur_pos[1])
      workshop_loc = tuple(workshop_cells[dists.argmin()])

      # move adjacent to the workshop (same logic as above)
      adj_candidates = [
          (workshop_loc[0] - 1, workshop_loc[1]),
          (workshop_loc[0] + 1, workshop_loc[1]),
          (workshop_loc[0], workshop_loc[1] - 1),
          (workshop_loc[0], workshop_loc[1] + 1),
      ]
      free_adj = None
      for cand in adj_candidates:
          if (0 <= cand[0] < grid.shape[0] and
                  0 <= cand[1] < grid.shape[1] and
                  not grid[cand[0], cand[1]].any()):
              free_adj = cand
              break
      if free_adj is None:
          free_adj = workshop_loc

      actions.extend(manhattan_path(cur_pos, free_adj))
      cur_pos = free_adj

      # face the workshop and USE to craft
      face_dir = adjacent(cur_pos, workshop_loc)
      actions.append(face_dir)
      actions.append(ACTION_USE)

  return actions


