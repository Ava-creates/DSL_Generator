import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that allows the agent to craft a ``stick`` in the
  given ``CraftLab``/``CraftWorld`` environment.

  The implementation is generic: it reads the recipe for ``stick`` from the
  world's ``Cookbook``, locates the required primitive resources on the grid,
  moves the agent to each of them and performs a ``USE`` action to pick them up,
  then moves to the appropriate workshop (as indicated by the ``_at`` field of
  the recipe) and uses ``USE`` once more to craft the stick.

  The action encoding follows the convention used by ``CraftLab``:

      0 – DOWN
      1 – UP
      2 – LEFT
      3 – RIGHT
      4 – USE (collect / craft)

  Parameters
  ----------
  env : CraftLab
      An instantiated CraftLab environment (already reset).

  Returns
  -------
  List[int]
      A list of action indices that, when executed sequentially, will result in
      the agent possessing at least one ``stick`` in its inventory.
  """
  import numpy as np

  # --------------------------------------------------------------------- #
  # Helper: simple Manhattan movement from (x0, y0) to (x1, y1)
  # --------------------------------------------------------------------- #
  def _move_actions(cur, target):
      """Return a list of actions moving from cur to target (Manhattan)."""
      actions = []
      x, y = cur
      tx, ty = target
      # vertical moves
      while x < tx:
          actions.append(0)   # DOWN
          x += 1
      while x > tx:
          actions.append(1)   # UP
          x -= 1
      # horizontal moves
      while y < ty:
          actions.append(3)   # RIGHT
          y += 1
      while y > ty:
          actions.append(2)   # LEFT
          y -= 1
      return actions

  # --------------------------------------------------------------------- #
  # Access the underlying state and world objects
  # --------------------------------------------------------------------- #
  state = env._current_state               # CraftState
  world = env.world                         # CraftWorld
  cookbook = world.cookbook                 # Cookbook

  # --------------------------------------------------------------------- #
  # Identify the goal index for "stick"
  # --------------------------------------------------------------------- #
  try:
      stick_idx = cookbook.index["stick"]
  except KeyError:                         # pragma: no cover
      # If the world does not contain a stick, we cannot craft it.
      return []

  # --------------------------------------------------------------------- #
  # Determine which primitives (and how many of each) are needed.
  # --------------------------------------------------------------------- #
  needed = cookbook.primitives_for(stick_idx)   # {prim_idx: count}
  actions = []
  cur_pos = tuple(state.pos)                     # mutable copy

  # --------------------------------------------------------------------- #
  # Work on a temporary copy of the grid so we can “remove” items once they
  # are collected (this avoids picking the same primitive twice).
  # --------------------------------------------------------------------- #
  grid = np.copy(state.grid)

  # --------------------------------------------------------------------- #
  # Collect each required primitive.
  # --------------------------------------------------------------------- #
  for prim_idx, qty in needed.items():
      # Locate all cells that currently contain this primitive
      locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
      # Take as many as needed (the recipe guarantees enough exist)
      for loc in locations[:qty]:
          # Move to the primitive
          actions.extend(_move_actions(cur_pos, loc))
          cur_pos = loc
          # Pick it up
          actions.append(4)                     # USE
          # Update the temporary grid to reflect the item being taken
          grid[loc[0], loc[1], prim_idx] = 0

  # --------------------------------------------------------------------- #
  # Move to the workshop where a stick can be crafted.
  # --------------------------------------------------------------------- #
  recipe = cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if workshop_name:
      # Resolve the workshop index and find a cell that hosts it
      ws_idx = cookbook.index.get(workshop_name)
      if ws_idx is not None:
          ws_locs = list(zip(*np.where(grid[:, :, ws_idx] > 0)))
          if ws_locs:
              ws_target = ws_locs[0]            # any workshop cell works
              actions.extend(_move_actions(cur_pos, ws_target))
              cur_pos = ws_target
              # Craft the stick
              actions.append(4)                 # USE

  return actions


