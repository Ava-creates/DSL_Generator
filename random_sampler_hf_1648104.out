"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will collect the required primitives for a
  ``stick`` and then craft it at the appropriate workshop.

  The implementation uses the environment's public API (reset, step, and the
  ``CraftWorld``/``Cookbook`` objects) to locate needed items, move the agent,
  and invoke ``USE`` actions.  It does not attempt any sophisticated planning;
  it simply moves greedily (Manhattan distance) towards the nearest required
  object and picks it up.

  Returns
  -------
  list[int]
      Sequence of action indices (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE)
      that can be executed in the given environment to obtain a stick.
  """
  # --------------------------------------------------------------------- #
  # Helper constants – these match the action mapping used by CraftLab.
  # --------------------------------------------------------------------- #
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

  # --------------------------------------------------------------------- #
  # Reset the environment to obtain a fresh state.
  # --------------------------------------------------------------------- #
  env.reset()
  state = env._current_state          # type: CraftState
  world = env.world                    # type: CraftWorld
  cookbook = world.cookbook

  # --------------------------------------------------------------------- #
  # Identify the goal index for ``stick`` and the primitive requirements.
  # --------------------------------------------------------------------- #
  try:
      stick_idx = cookbook.index["stick"]
  except Exception as exc:
      raise ValueError("The recipe database does not contain a 'stick' entry.") from exc

  # primitives_for returns a dict {primitive_index: count} needed for one stick.
  needed_primitives = cookbook.primitives_for(stick_idx)

  # --------------------------------------------------------------------- #
  # Locate the workshop where a stick must be crafted.
  # --------------------------------------------------------------------- #
  try:
      workshop_name = cookbook.recipes[stick_idx]["_at"]
      workshop_idx = cookbook.index[workshop_name]
  except Exception as exc:
      raise ValueError("Unable to determine the workshop for 'stick'.") from exc

  actions = []

  # --------------------------------------------------------------------- #
  # Utility: find the nearest cell that contains a given kind (primitive or
  # workshop).  Returns a tuple (x, y) in grid coordinates or None.
  # --------------------------------------------------------------------- #
  def find_nearest(kind_idx):
      grid_layer = state.grid[:, :, kind_idx]          # shape (W, H)
      positions = np.argwhere(grid_layer > 0)          # list of (x, y)
      if positions.size == 0:
          return None
      # Manhattan distance from current position
      cur = np.array(state.pos)                        # (x, y)
      dists = np.abs(positions - cur).sum(axis=1)
      return tuple(positions[np.argmin(dists)])

  # --------------------------------------------------------------------- #
  # Utility: move greedily (Manhattan) from the current position to a target.
  # The function updates ``state`` and records each movement action.
  # --------------------------------------------------------------------- #
  def move_to(target):
      nonlocal state
      while state.pos != target:
          px, py = state.pos
          tx, ty = target
          if px < tx:
              act = DOWN
          elif px > tx:
              act = UP
          elif py < ty:
              act = RIGHT
          else:  # py > ty
              act = LEFT
          actions.append(act)
          _, new_state = env.step(act)
          state = new_state

  # --------------------------------------------------------------------- #
  # Collect each required primitive the necessary number of times.
  # --------------------------------------------------------------------- #
  for prim_idx, count in needed_primitives.items():
      for _ in range(count):
          loc = find_nearest(prim_idx)
          if loc is None:
              # Primitive not present – give up early.
              return actions
          move_to(loc)
          # Use the item (the cell we are on contains the primitive; a USE
          # action on the cell in front works even if we are on the same cell
          # because the environment treats it as a pick‑up).
          actions.append(USE)
          _, new_state = env.step(USE)
          state = new_state

  # --------------------------------------------------------------------- #
  # Finally, go to the workshop and craft the stick.
  # --------------------------------------------------------------------- #
  workshop_loc = find_nearest(workshop_idx)
  if workshop_loc is not None:
      move_to(workshop_loc)
      actions.append(USE)          # craft at the workshop
      _, new_state = env.step(USE)
      state = new_state

  return actions


