import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that will make a stick in the given CraftWorld
  environment.

  The implementation:
  1. Looks up the index of the item named ``stick``.
  2. Determines which primitive resources are required for a stick
     (using ``world.cookbook.primitives_for``).
  3. For each required primitive, moves the agent to the nearest cell that
     contains the primitive and issues a ``USE`` action to pick it up.
  4. Finally moves to the workshop (if the recipe specifies one) and issues
     another ``USE`` to craft the stick.

  Action encoding (as used by the environment):
      0 – DOWN
      1 – UP
      2 – LEFT
      3 – RIGHT
      4 – USE
  """
  import numpy as np

  # ------------------------------------------------------------------ #
  # Helper to move from a current position to a target position using
  # Manhattan moves and the action encoding described above.
  # ------------------------------------------------------------------ #
  def _move_to(pos, target, actions):
      """Append actions that move ``pos`` to ``target`` (in‑place)."""
      cur_r, cur_c = pos
      trg_r, trg_c = target
      while (cur_r, cur_c) != (trg_r, trg_c):
          if cur_r < trg_r:
              actions.append(0)          # DOWN
              cur_r += 1
          elif cur_r > trg_r:
              actions.append(1)          # UP
              cur_r -= 1
          elif cur_c < trg_c:
              actions.append(3)          # RIGHT
              cur_c += 1
          elif cur_c > trg_c:
              actions.append(2)          # LEFT
              cur_c -= 1
      return (cur_r, cur_c)

  # ------------------------------------------------------------------ #
  # Gather required objects.
  # ------------------------------------------------------------------ #
  world = env.world
  # Index of the goal item ``stick``.
  stick_idx = world.cookbook.index["stick"]
  # Primitive requirements for a single stick.
  primitive_reqs = world.cookbook.primitives_for(stick_idx)

  # Current state information.
  state = env._current_state
  grid = state.grid
  pos = state.pos

  actions = []

  # ------------------------------------------------------------------ #
  # Collect each primitive the required number of times.
  # ------------------------------------------------------------------ #
  for prim_idx, needed in primitive_reqs.items():
      for _ in range(needed):
          # Find all cells that currently contain the primitive.
          locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              # No such primitive on the map – nothing we can do.
              continue
          # Choose the nearest location (Manhattan distance).
          dists = np.abs(locations[:, 0] - pos[0]) + np.abs(locations[:, 1] - pos[1])
          nearest = locations[dists.argmin()]
          target = (int(nearest[0]), int(nearest[1]))

          # Move next to the primitive (the agent must stand on the cell to
          # pick it up in this implementation).
          pos = _move_to(pos, target, actions)

          # Pick up the primitive.
          actions.append(4)   # USE
          # Update our internal copy of the grid so that subsequent searches
          # do not try to pick the same item again.
          grid[target[0], target[1], prim_idx] = 0

  # ------------------------------------------------------------------ #
  # Craft the stick at its designated workshop (if any).
  # ------------------------------------------------------------------ #
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_idx = recipe.get("_at")
  if workshop_idx is not None:
      # Locate a workshop of the required type.
      locations = np.argwhere(grid[:, :, workshop_idx] > 0)
      if locations.size > 0:
          target = (int(locations[0][0]), int(locations[0][1]))
          pos = _move_to(pos, target, actions)
          actions.append(4)   # USE to craft

  return actions


