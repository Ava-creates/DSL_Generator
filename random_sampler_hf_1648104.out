import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a sequence of actions to complete the task of making a stick
  in the given CraftWorld environment. The function gathers the required
  primitives from the recipe for 'stick' and then crafts the stick.

  Args:
      env: The CraftLab environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task.
  """
  # Helper functions
  def find_nearest(item_idx, grid, pos):
      """Find the nearest cell containing the given item index."""
      h, w, _ = grid.shape
      best = None
      best_dist = float('inf')
      for y in range(h):
          for x in range(w):
              if grid[y, x, item_idx] > 0:
                  dist = abs(x - pos[0]) + abs(y - pos[1])
                  if dist < best_dist:
                      best_dist = dist
                      best = (x, y)
      return best

  def move_towards(target, pos, direction):
      """Generate actions to move towards target from pos."""
      actions = []
      x, y = pos
      tx, ty = target
      # simple Manhattan path: horizontal then vertical
      while x != tx:
          if tx > x:
              # face right
              if direction != 0:
                  actions.append(4)  # USE to turn (simplified)
                  direction = 0
              actions.append(0)  # DOWN (right)
              x += 1
          else:
              if direction != 2:
                  actions.append(4)
                  direction = 2
              actions.append(2)  # LEFT
              x -= 1
      while y != ty:
          if ty > y:
              if direction != 1:
                  actions.append(4)
                  direction = 1
              actions.append(1)  # UP
              y += 1
          else:
              if direction != 3:
                  actions.append(4)
                  direction = 3
              actions.append(3)  # DOWN (left)
              y -= 1
      return actions, direction

  # Main logic
  # Get the world and scenario
  state = env._current_state
  grid = state.grid
  pos = state.pos
  direction = state.dir

  # Identify stick index
  stick_name = "stick"
  stick_idx = state.world.cookbook.index(stick_name)

  # Get required primitives for stick
  recipe = state.world.cookbook.recipes.get(stick_idx, {})
  # recipe format includes "_key": workshop; we only need ingredients
  primitives_needed = {k: v for k, v in recipe.items() if isinstance(k, int)}

  actions_plan = []

  # Collect each required primitive
  for prim_idx, count in primitives_needed.items():
      for _ in range(count):
          # Find nearest primitive location
          target = find_nearest(prim_idx, grid, pos)
          if target is None:
              raise ValueError("Required primitive not found in grid")
          # Move to the primitive
          move_actions, direction = move_towards(target, pos, direction)
          actions_plan.extend(move_actions)
          pos = target
          # Use action to pick up (USE)
          actions_plan.append(4)  # USE to collect
          # Update internal state simulation (optional)
          # For simplicity we don't update grid here; env will handle it

  # After collecting, move to workshop for crafting stick
  workshop_idx = recipe.get("_key")
  if workshop_idx is not None:
      workshop_target = find_nearest(workshop_idx, grid, pos)
      if workshop_target is not None:
          move_actions, direction = move_towards(workshop_target, pos, direction)
          actions_plan.extend(move_actions)
          pos = workshop_target

  # Finally, use action to craft the stick
  actions_plan.append(4)  # USE to craft

  return actions_plan


