import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that allows the agent to craft a ``stick``.
  The plan is simple:
    1.  Determine which primitive items are required for a stick and where they are.
    2.  Move to each primitive, use the ``USE`` action to pick it up.
    3.  Move to the required workshop and ``USE`` again to craft the stick.

  The implementation assumes the environment has already been reset, i.e. it
  possesses a ``_current_state`` attribute of type :class:`CraftState`.  The
  action ordering follows the specification in ``CraftLab.action_specs``:
      0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT, 4 – USE
  """
  import numpy as np

  # ------------------------------------------------------------------ #
  # Helper: generate a Manhattan‑style path from ``src`` to ``dst``.
  # ------------------------------------------------------------------ #
  def _move_path(src, dst):
      """Return a list of actions (DOWN/UP/LEFT/RIGHT) that moves from src to dst."""
      actions = []
      x, y = src
      tx, ty = dst
      # vertical moves (DOWN = 0, UP = 1)
      while x < tx:
          actions.append(0)   # DOWN
          x += 1
      while x > tx:
          actions.append(1)   # UP
          x -= 1
      # horizontal moves (LEFT = 2, RIGHT = 3)
      while y < ty:
          actions.append(3)   # RIGHT
          y += 1
      while y > ty:
          actions.append(2)   # LEFT
          y -= 1
      return actions

  # ------------------------------------------------------------------ #
  # 1.  Locate the indices for ``stick`` and its recipe.
  # ------------------------------------------------------------------ #
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except Exception:
      # No ``stick`` defined – nothing to do.
      return []

  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  # Primitive requirements (ignore the special keys ``_key`` and ``_at``)
  primitive_reqs = {k: v for k, v in recipe.items() if k not in ("_key", "_at")}
  # Workshop where the stick must be crafted
  workshop_name = recipe.get("_at")
  if workshop_name is None:
      # No workshop information – cannot craft.
      return []
  workshop_idx = env.world.cookbook.index[workshop_name]

  # ------------------------------------------------------------------ #
  # 2.  Gather current state information.
  # ------------------------------------------------------------------ #
  state = env._current_state          # type: CraftState
  grid = state.grid                    # shape (W, H, n_kinds)
  pos = state.pos                      # (x, y)

  actions_plan = []

  # ------------------------------------------------------------------ #
  # 3.  Collect each required primitive the necessary number of times.
  # ------------------------------------------------------------------ #
  for prim_idx, needed in primitive_reqs.items():
      for _ in range(needed):
          # Find any cell that still contains the primitive.
          locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              # Primitive not present – give up (return what we have).
              return actions_plan
          target = tuple(locations[0])   # pick the first occurrence

          # Move to the primitive.
          actions_plan.extend(_move_path(pos, target))
          pos = target

          # Pick it up.
          actions_plan.append(4)          # USE
          # Simulate removal from the grid so we don't try to pick the same
          # instance again (optional, but keeps the planner consistent).
          grid[pos[0], pos[1], prim_idx] = 0

  # ------------------------------------------------------------------ #
  # 4.  Move to the required workshop and craft the stick.
  # ------------------------------------------------------------------ #
  workshop_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
  if workshop_locs.size == 0:
      # No workshop found – cannot finish the plan.
      return actions_plan
  workshop_pos = tuple(workshop_locs[0])

  actions_plan.extend(_move_path(pos, workshop_pos))
  # Final USE to craft the stick.
  actions_plan.append(4)

  return actions_plan


