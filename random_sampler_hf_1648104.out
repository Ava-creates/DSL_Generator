## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that will collect the required primitives
  for a ``stick`` and then craft it at the appropriate workshop.
  The function works for any CraftWorld environment that follows the
  standard API (CraftLab / CraftWorld).

  Parameters
  ----------
  env : object
      The CraftLab / CraftWorld environment instance.

  Returns
  -------
  List[int]
      A sequence of action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)
      that will produce a stick.
  """
  # ------------------------------------------------------------------
  # Helper: move from current position to a target (x, y) using Manhattan
  # steps.  The action ordering follows the convention used in CraftWorld:
  #   0: DOWN  (y + 1)
  #   1: UP    (y - 1)
  #   2: LEFT  (x - 1)
  #   3: RIGHT (x + 1)
  #   4: USE   (interact / craft)
  # ------------------------------------------------------------------
  def _move_to(cur, target, actions):
      cx, cy = cur
      tx, ty = target
      while cx < tx:
          actions.append(3)   # RIGHT
          cx += 1
      while cx > tx:
          actions.append(2)   # LEFT
          cx -= 1
      while cy < ty:
          actions.append(0)   # DOWN
          cy += 1
      while cy > ty:
          actions.append(1)   # UP
          cy -= 1
      return [cx, cy]

  # ------------------------------------------------------------------
  # Initialise environment and obtain the starting state.
  # ------------------------------------------------------------------
  env.reset()
  state = env._current_state          # current CraftState
  world = env.world                    # CraftWorld instance

  # ------------------------------------------------------------------
  # Identify the index of the goal item ("stick").
  # ------------------------------------------------------------------
  stick_idx = world.cookbook.index.get("stick")
  if stick_idx is None:
      # If the world does not contain a stick item, return empty list.
      return []

  # ------------------------------------------------------------------
  # Determine which primitive resources are required to craft a stick.
  # ------------------------------------------------------------------
  primitives_needed = world.cookbook.primitives_for(stick_idx)  # {kind_idx: count}
  actions = []
  cur_pos = list(state.pos)   # [x, y]

  # ------------------------------------------------------------------
  # For each required primitive, locate a cell containing it,
  # move there, and use the "USE" action to pick it up.
  # ------------------------------------------------------------------
  for kind_idx, needed_cnt in primitives_needed.items():
      for _ in range(needed_cnt):
          # Find any cell that currently holds the primitive.
          # The grid is (W, H, n_kinds); we look at the slice for kind_idx.
          locations = np.argwhere(state.grid[:, :, kind_idx] > 0)
          if locations.size == 0:
              # No such primitive is present – cannot continue.
              continue
          # Choose the first location (could be improved with nearest search).
          ty, tx = locations[0]   # note: argwhere returns (y, x)
          cur_pos = _move_to(cur_pos, (tx, ty), actions)
          actions.append(4)      # USE to collect the primitive

  # ------------------------------------------------------------------
  # After gathering all primitives, move to the appropriate workshop and
  # craft the stick.  The workshop name is stored in the recipe under
  # the special key "_at".
  # ------------------------------------------------------------------
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if workshop_name:
      workshop_idx = world.cookbook.index.get(workshop_name)
      if workshop_idx is not None:
          # Locate any workshop cell of this type.
          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
          if ws_locs.size > 0:
              wy, wx = ws_locs[0]
              cur_pos = _move_to(cur_pos, (wx, wy), actions)
              actions.append(4)  # USE to craft the stick

  return actions


