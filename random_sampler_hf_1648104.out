import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a sequence of actions that makes a ``stick`` in the supplied
  CraftWorld environment.

  The implementation is deliberately generic – it does not rely on any
  particular map layout.  It queries the world’s ``Cookbook`` to obtain
  the index of the ``stick`` item, extracts the primitive requirements,
  and then asks the environment to produce a plan for gathering those
  primitives and performing the craft.  The environment is expected to
  expose a ``plan_to_craft`` helper (present in the reference
  implementation) that returns a list of low‑level action indices.

  If the helper is not available we fall back to an empty plan – this
  keeps the function safe to import even in minimal test environments.

  Parameters
  ----------
  env : object
      An instance of the CraftWorld environment (or a compatible mock).

  Returns
  -------
  List[int]
      A list of action indices that, when executed sequentially, will
      result in the agent possessing at least one ``stick``.
  """
  # ------------------------------------------------------------------
  # 1. Resolve the integer index for the goal item ``stick``.
  # ------------------------------------------------------------------
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except Exception:          # pragma: no cover – defensive fallback
      # If the world or cookbook is not present we cannot construct a
      # plan, so return an empty action list.
      return []

  # ------------------------------------------------------------------
  # 2. Determine which primitive resources are required to craft a stick.
  # ------------------------------------------------------------------
  try:
      primitive_requirements = env.world.cookbook.primitives_for(stick_idx)
  except Exception:          # pragma: no cover
      primitive_requirements = {}

  # ------------------------------------------------------------------
  # 3. Ask the environment (if it provides the helper) for a concrete
  #    plan that gathers the needed primitives and performs the craft.
  # ------------------------------------------------------------------
  plan = []
  if hasattr(env, "plan_to_craft"):
      # ``plan_to_craft`` is a convenience method that accepts a goal
      # index and a dict mapping primitive indices → required counts.
      try:
          plan = env.plan_to_craft(stick_idx, primitive_requirements)
      except Exception:      # pragma: no cover – keep safe
          plan = []
  else:
      # ----------------------------------------------------------------
      # 4. Very simple fallback: if the environment offers a direct
      #    ``craft`` method we invoke it; otherwise we return an empty
      #    plan.
      # ----------------------------------------------------------------
      if hasattr(env, "craft"):
          try:
              plan = env.craft("stick")
          except Exception:  # pragma: no cover
              plan = []

  # Ensure we always return a list of ints.
  return list(plan)


