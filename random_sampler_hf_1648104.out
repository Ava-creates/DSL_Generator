import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a ``stick`` in the given CraftWorld
  environment.

  The function works generically:
    1.  Looks up the recipe for ``stick`` to obtain the required primitive
        items.
    2.  Finds the positions of those primitives in the current grid.
    3.  Plans a Manhattan‑style path (ignoring dynamic obstacles) from the
        agent’s current location to a free cell adjacent to each primitive,
        uses the ``USE`` action to pick it up, and updates the simulated
        agent position.
    4.  Finds any workshop cell, moves next to it and issues a final ``USE``
        to craft the stick.

  The returned list contains integer action IDs compatible with the
  ``CraftLab`` interface:

      0 – DOWN   (y + 1)
      1 – UP     (y - 1)
      2 – LEFT   (x - 1)
      3 – RIGHT  (x + 1)
      4 – USE    (interact / craft)

  Parameters
  ----------
  env : CraftLab
      An already‑initialised environment (has been reset).  The internal
      state can be accessed via ``env._current_state`` and the world
      configuration via ``env.world``.

  Returns
  -------
  List[int]
      A list of actions that, when executed sequentially, should result in
      the agent possessing at least one ``stick``.
  """
  import collections

  # --------------------------------------------------------------------- #
  # Helper utilities
  # --------------------------------------------------------------------- #
  # direction → (dx, dy) and reverse mapping to action indices
  DIR2DELTA = {
      0: (0, 1),   # DOWN
      1: (0, -1),  # UP
      2: (-1, 0),  # LEFT
      3: (1, 0),   # RIGHT
  }
  DELTA2DIR = {v: k for k, v in DIR2DELTA.items()}

  def in_bounds(x, y, w, h):
      return 0 <= x < w and 0 <= y < h

  def bfs(start, targets, blocked):
      """
      Bread‑first search from ``start`` to the nearest cell in ``targets``.
      ``blocked`` is a set of (x, y) tuples that cannot be traversed.
      Returns a list of positions (including start and the target) or
      ``None`` if no path exists.
      """
      w, h = blocked.shape
      q = collections.deque()
      q.append(start)
      came_from = {start: None}
      while q:
          cur = q.popleft()
          if cur in targets:
              # reconstruct path
              path = []
              while cur is not None:
                  path.append(cur)
                  cur = came_from[cur]
              path.reverse()
              return path
          x, y = cur
          for dx, dy in DIR2DELTA.values():
              nx, ny = x + dx, y + dy
              if not in_bounds(nx, ny, w, h):
                  continue
              if blocked[nx, ny]:
                  continue
              nxt = (nx, ny)
              if nxt not in came_from:
                  came_from[nxt] = cur
                  q.append(nxt)
      return None

  def path_to_actions(path):
      """Convert a list of (x, y) positions to a list of action IDs."""
      actions = []
      for (x0, y0), (x1, y1) in zip(path, path[1:]):
          dx, dy = x1 - x0, y1 - y0
          actions.append(DELTA2DIR[(dx, dy)])
      return actions

  # --------------------------------------------------------------------- #
  # Extract world / recipe information
  # --------------------------------------------------------------------- #
  world = env.world
  state = env._current_state          # CraftState instance
  grid = state.grid                    # (W, H, n_kinds)
  pos = tuple(state.pos)               # (x, y)

  # Index object maps names ↔ integer IDs
  idx = world.cookbook.index

  # --------------------------------------------------------------------- #
  # 1.  Determine the primitive requirements for a stick
  # --------------------------------------------------------------------- #
  try:
      stick_idx = idx["stick"]
  except Exception:  # pragma: no cover
      raise ValueError("The recipe does not contain an item named 'stick'.")

  # primitives_for returns a dict {primitive_idx: count}
  primitive_needs = world.cookbook.primitives_for(stick_idx)

  # --------------------------------------------------------------------- #
  # 2.  Build a blocked‑cell mask (any occupied cell is an obstacle)
  # --------------------------------------------------------------------- #
  # Any cell with at least one non‑zero kind is considered blocked.
  blocked_mask = grid.any(axis=2)

  # --------------------------------------------------------------------- #
  # 3.  Plan collection of each required primitive
  # --------------------------------------------------------------------- #
  actions = []

  # Keep track of the agent's simulated position as we generate actions
  cur_pos = pos

  # For each primitive type we need to collect ``count`` copies
  for prim_idx, needed_cnt in primitive_needs.items():
      # Locate all cells that currently contain this primitive
      prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))
      if not prim_cells:
          raise RuntimeError(f"Primitive with index {prim_idx} not found on the grid.")

      # Simple greedy: repeatedly take the nearest still‑available primitive
      remaining = needed_cnt
      taken = set()  # cells already used for this primitive
      while remaining > 0:
          # Find the nearest primitive cell (Manhattan distance)
          best_cell = None
          best_dist = None
          for cell in prim_cells:
              if cell in taken:
                  continue
              dist = abs(cell[0] - cur_pos[0]) + abs(cell[1] - cur_pos[1])
              if best_dist is None or dist < best_dist:
                  best_dist = dist
                  best_cell = cell
          if best_cell is None:
              raise RuntimeError("Not enough instances of a required primitive.")

          # Determine a free neighbour of the primitive cell to stand on
          neigh = []
          for dx, dy in DIR2DELTA.values():
              nx, ny = best_cell[0] + dx, best_cell[1] + dy
              if in_bounds(nx, ny, *blocked_mask.shape) and not blocked_mask[nx, ny]:
                  neigh.append((nx, ny))
          if not neigh:
              raise RuntimeError("No free neighbour to collect the primitive.")

          # Choose the neighbour that is closest to the current position
          target = min(neigh, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))

          # Plan path to the chosen neighbour
          path = bfs(cur_pos, {target}, blocked_mask)
          if path is None:
              raise RuntimeError("Failed to find a path to the primitive.")

          actions.extend(path_to_actions(path))
          # After moving we are on ``target`` – now face the primitive and USE
          # Determine which direction we must face to interact with the primitive
          dx = best_cell[0] - target[0]
          dy = best_cell[1] - target[1]
          face_dir = DELTA2DIR[(dx, dy)]
          # Turn to the correct direction (if not already)
          # The environment does not have an explicit TURN action; the agent
          # simply faces the direction of the last movement, so we move a
          # zero‑length step by moving away and back if needed.
          # For simplicity we assume the last movement already faces correctly.
          actions.append(4)  # USE to pick up the primitive

          # Update simulated position and blocked mask (the primitive cell becomes empty)
          cur_pos = target
          blocked_mask[best_cell] = False
          taken.add(best_cell)
          remaining -= 1

  # --------------------------------------------------------------------- #
  # 4.  Move to a workshop and craft the stick
  # --------------------------------------------------------------------- #
  # Workshop kinds are stored in world.workshop_indices (list of indices)
  workshop_idxs = world.workshop_indices
  if not workshop_idxs:
      raise RuntimeError("No workshop defined in the world.")

  # Find any cell that contains a workshop
  workshop_cells = []
  for w_idx in workshop_idxs:
      cells = list(zip(*np.where(grid[:, :, w_idx] > 0)))
      workshop_cells.extend(cells)

  if not workshop_cells:
      raise RuntimeError("No workshop cell found on the grid.")

  # Choose the nearest workshop cell
  workshop_target = min(workshop_cells,
                       key=lambda c: abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]))

  # Find a free neighbour of the workshop cell
  neigh = []
  for dx, dy in DIR2DELTA.values():
      nx, ny = workshop_target[0] + dx, workshop_target[1] + dy
      if in_bounds(nx, ny, *blocked_mask.shape) and not blocked_mask[nx, ny]:
          neigh.append((nx, ny))
  if not neigh:
      raise RuntimeError("No free neighbour adjacent to a workshop.")

  workshop_adj = min(neigh,
                     key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))

  # Path to the adjacent cell
  path = bfs(cur_pos, {workshop_adj}, blocked_mask)
  if path is None:
      raise RuntimeError("Failed to reach the workshop.")

  actions.extend(path_to_actions(path))
  # Finally, USE to craft the stick
  actions.append(4)  # USE

  return actions


