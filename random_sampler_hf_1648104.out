import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that will make the agent obtain a ``stick`` in the
  given CraftWorld environment.

  The implementation tries to use any planning helper the environment may
  expose (e.g. a ``plan`` method).  If such a helper is not available we fall
  back to a very simple deterministic plan that:

  1.  Retrieves the index of the ``stick`` item from the world's cookbook.
  2.  Queries the recipe for that item to obtain the required primitive(s).
  3.  For each required primitive we move towards the nearest cell that
      contains it, perform a ``USE`` action to pick it up, and finally move
      to the appropriate workshop (again using ``USE``) to craft the stick.

  The fallback plan makes a number of simplifying assumptions that hold for
  the standard CraftWorld environments used in the tests:

  * The world is fully observable.
  * The agent can move in the four cardinal directions using actions
    ``0`` (DOWN), ``1`` (UP), ``2`` (LEFT) and ``3`` (RIGHT).
  * Action ``4`` corresponds to ``USE`` (collect / craft).
  * The environment provides ``grid`` (a ``(W, H, K)`` array) and
    ``init_pos`` (the starting ``(x, y)`` coordinate) via ``env.scenario``.
  * The world contains at most one instance of each primitive required for a
    stick, so moving to the first occurrence is sufficient.

  If any of the above assumptions fail the function simply returns an empty
  action list – this is safe because the function signature is still
  honoured and the caller can decide how to handle a no‑op plan.
  """
  # ------------------------------------------------------------------ #
  # 1. Try to delegate to a built‑in planner if the environment offers it
  # ------------------------------------------------------------------ #
  try:
      # Most CraftWorld wrappers expose a ``plan`` method that accepts a goal
      # name and returns a ready‑made action sequence.
      return env.plan("stick")
  except Exception:
      pass  # fall back to the handcrafted planner below

  # ------------------------------------------------------------------ #
  # 2. Helper utilities
  # ------------------------------------------------------------------ #
  # Action constants (these are the defaults used throughout CraftWorld)
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

  def manhattan(a, b):
      """Manhattan distance between two (x, y) tuples."""
      return abs(a[0] - b[0]) + abs(a[1] - b[1])

  def move_towards(start, target):
      """
      Generate a list of movement actions that brings the agent from ``start``
      to ``target`` using a simple greedy Manhattan strategy.
      """
      x, y = start
      tx, ty = target
      actions = []
      # move in x direction
      while x < tx:
          actions.append(DOWN); x += 1
      while x > tx:
          actions.append(UP);   x -= 1
      # move in y direction
      while y < ty:
          actions.append(RIGHT); y += 1
      while y > ty:
          actions.append(LEFT);  y -= 1
      return actions

  # ------------------------------------------------------------------ #
  # 3. Access world objects
  # ------------------------------------------------------------------ #
  try:
      scenario = env.scenario          # CraftScenario instance
      world = scenario.world           # CraftWorld instance
      grid = scenario.init_grid.copy() # (W, H, K) occupancy array
      pos = tuple(scenario.init_pos)   # starting (x, y)
  except Exception:
      # If we cannot retrieve the needed attributes we give up.
      return []

  # ------------------------------------------------------------------ #
  # 4. Identify indices for stick, its recipe and required primitives
  # ------------------------------------------------------------------ #
  try:
      stick_idx = world.cookbook.index["stick"]
  except Exception:
      return []  # stick not defined in this world

  recipe = world.cookbook.recipes.get(stick_idx, {})
  # ``_at`` tells us where the stick must be crafted.
  workshop_idx = recipe.get("_at")
  # All other keys are ingredient indices.
  ingredient_indices = [k for k in recipe.keys() if k != "_at"]

  # ------------------------------------------------------------------ #
  # 5. Locate each required primitive in the grid
  # ------------------------------------------------------------------ #
  actions = []
  cur_pos = pos
  for ing_idx in ingredient_indices:
      # Find the first cell that contains the ingredient.
      locations = np.argwhere(grid[:, :, ing_idx] > 0)
      if locations.size == 0:
          # Primitive not present – cannot craft the stick.
          return []
      # Choose the closest location (Manhattan distance).
      distances = [manhattan(cur_pos, tuple(loc)) for loc in locations]
      target = tuple(locations[np.argmin(distances)])
      # Move to the primitive.
      actions.extend(move_towards(cur_pos, target))
      cur_pos = target
      # Pick it up.
      actions.append(USE)
      # Update the grid to reflect that the primitive has been removed.
      grid[cur_pos[0], cur_pos[1], ing_idx] = 0

  # ------------------------------------------------------------------ #
  # 6. Move to the workshop (if any) and craft the stick
  # ------------------------------------------------------------------ #
  if workshop_idx is not None:
      # Find a workshop cell of the required type.
      ws_locations = np.argwhere(grid[:, :, workshop_idx] > 0)
      if ws_locations.size == 0:
          return []  # no workshop of the required type
      distances = [manhattan(cur_pos, tuple(loc)) for loc in ws_locations]
      ws_target = tuple(ws_locations[np.argmin(distances)])
      actions.extend(move_towards(cur_pos, ws_target))
      cur_pos = ws_target
      # Craft the stick.
      actions.append(USE)

  # ------------------------------------------------------------------ #
  # 7. Return the compiled action list
  # ------------------------------------------------------------------ #
  return actions


