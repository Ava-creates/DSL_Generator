"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a ``stick`` in the given
  CraftWorld environment.  The function works for any environment that
  follows the DMLab‑style interface used by the ``CraftLab`` wrapper.

  The algorithm is simple:
    1.  Look up the index of the ``stick`` item in the cookbook.
    2.  Retrieve the primitive requirements for a single stick.
    3.  For each required primitive, locate a cell that contains the
        primitive, move the agent next to that cell and ``USE`` to pick
        it up (repeating until the required count is satisfied).
    4.  Locate the workshop where a stick can be crafted (the ``_at``
        entry of the recipe), move next to it and ``USE`` to craft the
        stick.

  The function does **not** execute the actions – it only returns the
  list of integer actions that can later be fed to ``env.step``.
  The implementation is deliberately straightforward and does not
  attempt sophisticated path‑finding; it simply walks Manhattan‑style
  towards the target coordinates.

  Parameters
  ----------
  env : CraftLab
      An instance of the CraftLab environment (already reset).

  Returns
  -------
  List[int]
      A list of action indices that, when executed in order, will
      result in at least one ``stick`` in the agent's inventory.
  """
  # ------------------------------------------------------------------
  # Helper constants – action indices used by CraftLab
  # ------------------------------------------------------------------
  ACTION_DOWN = 0
  ACTION_UP = 1
  ACTION_LEFT = 2
  ACTION_RIGHT = 3
  ACTION_USE = 4

  # ------------------------------------------------------------------
  # Helper functions for movement and interaction
  # ------------------------------------------------------------------
  def manhattan_move(cur_pos, target_pos):
      """Return a list of actions that move from cur_pos to target_pos."""
      x, y = cur_pos
      tx, ty = target_pos
      actions = []
      # first move in x direction
      while x < tx:
          actions.append(ACTION_RIGHT)
          x += 1
      while x > tx:
          actions.append(ACTION_LEFT)
          x -= 1
      # then move in y direction
      while y < ty:
          actions.append(ACTION_DOWN)
          y += 1
      while y > ty:
          actions.append(ACTION_UP)
          y -= 1
      return actions

  # ------------------------------------------------------------------
  # Access to world data
  # ------------------------------------------------------------------
  world = env.world                     # CraftWorld instance
  cookbook = world.cookbook             # Cookbook instance
  state = env._current_state            # CraftState instance
  grid = state.grid                      # (W, H, n_kinds) array
  pos = tuple(state.pos)                # (x, y)

  # ------------------------------------------------------------------
  # Identify the stick item and its recipe
  # ------------------------------------------------------------------
  stick_idx = cookbook.index["stick"]
  # The recipe dict contains primitive indices and a special key "_at"
  recipe = cookbook.recipes[stick_idx]

  # ------------------------------------------------------------------
  # Determine which workshop is required for crafting the stick
  # ------------------------------------------------------------------
  workshop_name = recipe["_at"]
  workshop_idx = cookbook.index[workshop_name]

  # ------------------------------------------------------------------
  # Determine primitive requirements (exclude the special "_at" key)
  # ------------------------------------------------------------------
  primitive_requirements = {
      i_kind: cnt
      for i_kind, cnt in recipe.items()
      if i_kind != "_at"
  }

  # ------------------------------------------------------------------
  # Action list we will build and return
  # ------------------------------------------------------------------
  action_plan = []

  # ------------------------------------------------------------------
  # Helper to locate a cell containing a given kind (any occurrence)
  # ------------------------------------------------------------------
  def locate_kind(kind):
      """Return coordinates (x, y) of any cell that contains `kind`."""
      locations = np.argwhere(grid[:, :, kind] > 0)
      if len(locations) == 0:
          raise RuntimeError(f"Cannot find required kind {kind} in the grid.")
      # pick the first location (could be improved)
      return tuple(locations[0][:2])

  # ------------------------------------------------------------------
  # Collect each required primitive
  # ------------------------------------------------------------------
  for prim_idx, needed in primitive_requirements.items():
      while state.inventory[prim_idx] < needed:
          # locate a source cell for this primitive
          src_x, src_y = locate_kind(prim_idx)

          # move next to the source cell (we stand on the same cell)
          # the USE action works on the cell we are standing on.
          moves = manhattan_move(pos, (src_x, src_y))
          action_plan.extend(moves)
          pos = (src_x, src_y)

          # pick up the primitive
          action_plan.append(ACTION_USE)

          # simulate the effect locally so we know our next position /
          # inventory without having to query the environment.
          # This is cheap because we only need the inventory count.
          # (In a real run the environment would update these.)
          state.inventory[prim_idx] += 1

  # ------------------------------------------------------------------
  # Move to the workshop and craft the stick
  # ------------------------------------------------------------------
  # locate any workshop cell of the required type
  ws_x, ws_y = locate_kind(workshop_idx)

  # move next to the workshop
  moves = manhattan_move(pos, (ws_x, ws_y))
  action_plan.extend(moves)
  pos = (ws_x, ws_y)

  # craft the stick
  action_plan.append(ACTION_USE)

  return action_plan


