"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that will make a ``stick`` in the given
  CraftLab environment.

  The algorithm:
    1. Look up the stick recipe.
    2. Collect each required primitive by moving to a cell that
       contains it and using the ``USE`` action.
    3. Move to the required workshop (if the recipe specifies one)
       and ``USE`` to craft the stick.

  The function does **not** execute the actions – it only returns the
  sequence of integer action indices that can later be fed to
  ``env.step``.
  """
  # ------------------------------------------------------------------
  # Helpers
  # ------------------------------------------------------------------
  ACTIONS = env.action_specs()          # e.g. {'DOWN':0, 'UP':1, ...}
  ACTION_USE = ACTIONS["USE"]
  ACTION_DOWN = ACTIONS["DOWN"]
  ACTION_UP = ACTIONS["UP"]
  ACTION_LEFT = ACTIONS["LEFT"]
  ACTION_RIGHT = ACTIONS["RIGHT"]

  def manhattan_move(cur, target):
      """Return a list of actions moving from ``cur`` to ``target``."""
      x, y = cur
      tx, ty = target
      moves = []
      while x < tx:
          moves.append(ACTION_RIGHT); x += 1
      while x > tx:
          moves.append(ACTION_LEFT);  x -= 1
      while y < ty:
          moves.append(ACTION_DOWN); y += 1
      while y > ty:
          moves.append(ACTION_UP);   y -= 1
      return moves

  def locate_kind(grid, kind):
      """Return coordinates (x, y) of any cell that currently holds ``kind``."""
      locs = np.argwhere(grid[:, :, kind] > 0)
      if len(locs) == 0:
          raise RuntimeError(f"Cannot find required kind {kind} on the map.")
      return tuple(locs[0][:2])

  # ------------------------------------------------------------------
  # Access world / recipe information
  # ------------------------------------------------------------------
  world = env.world
  cookbook = world.cookbook
  stick_idx = cookbook.index["stick"]
  recipe = cookbook.recipes[stick_idx]

  # Primitive requirements (exclude the special key "_at")
  primitive_req = {k: v for k, v in recipe.items() if k != "_at"}

  # Workshop (if any)
  workshop_name = recipe.get("_at")
  workshop_idx = cookbook.index[workshop_name] if workshop_name else None

  # ------------------------------------------------------------------
  # Current state snapshot (used only for planning)
  # ------------------------------------------------------------------
  state = env._current_state
  pos = tuple(state.pos)                 # (x, y)
  grid = state.grid.copy()               # we will update it locally
  inventory = state.inventory.copy()

  action_plan = []

  # ------------------------------------------------------------------
  # Collect required primitives
  # ------------------------------------------------------------------
  for prim_idx, needed in primitive_req.items():
      while inventory[prim_idx] < needed:
          # Find a cell containing the primitive
          src = locate_kind(grid, prim_idx)

          # Move to that cell
          action_plan.extend(manhattan_move(pos, src))
          pos = src

          # Pick it up
          action_plan.append(ACTION_USE)

          # Simulate the effect locally
          inventory[prim_idx] += 1
          grid[src[0], src[1], prim_idx] = 0   # primitive consumed

  # ------------------------------------------------------------------
  # Move to workshop and craft (if a workshop is required)
  # ------------------------------------------------------------------
  if workshop_idx is not None:
      ws = locate_kind(grid, workshop_idx)

      action_plan.extend(manhattan_move(pos, ws))
      pos = ws

      # Craft the stick
      action_plan.append(ACTION_USE)

  return action_plan


