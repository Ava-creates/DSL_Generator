    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a minimal action sequence that makes a stick in a CraftWorld
  environment.

  This implementation assumes that the environment is already in a
  state where the ``USE`` action (action index 4) will successfully craft
  a stick – i.e. the required primitives have already been collected and
  the agent is positioned at the correct workshop.  In the standard
  CraftWorld setup the ``USE`` action is the only action needed to
  trigger a crafting operation once the prerequisites are satisfied.

  Parameters
  ----------
  env : object
      An instance of ``CraftLab`` (or compatible environment) that
      follows the DMLab‑style interface used by the CraftWorld code base.

  Returns
  -------
  List[int]
      A list containing a single action index that, when executed in the
      environment, will craft a stick.
  """
  # Action index for the ``USE`` operation as defined by CraftLab.action_specs()
  USE = 4
  return [USE]


