## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a stick in the given CraftWorld environment.

  The implementation works by:
  1. Querying the cookbook for the recipe of ``stick``.
  2. Collecting all required primitive resources.
  3. Moving to the appropriate workshop and using it to craft the stick.

  The function directly interacts with the environment (calls ``env.step``) to
  keep the internal state up‑to‑date while it builds the action list.

  Parameters
  ----------
  env : CraftLab (or compatible) environment
      An instantiated CraftWorld environment.  It must expose the attributes
      ``world`` (the ``CraftWorld`` instance) and ``_current_state`` (the
      ``CraftState`` instance).

  Returns
  -------
  List[int]
      A list of action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4) that,
      when executed sequentially in the environment, result in a stick
      appearing in the agent's inventory.
  """
  import collections

  # ----------------------------------------------------------------------
  # Helper utilities
  # ----------------------------------------------------------------------
  # Action constants – match the mapping used in CraftLab.action_specs()
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
  ACTIONS = {(1, 0): DOWN, (-1, 0): UP, (0, -1): LEFT, (0, 1): RIGHT}

  def bfs(start, targets, passable):
      """Bread‑first search returning a list of positions from start to the
      nearest cell in ``targets``.  ``passable`` is a boolean 2‑D array where
      True indicates the cell can be entered."""
      W, H = passable.shape
      q = collections.deque()
      q.append((start, []))
      visited = set([start])
      while q:
          (x, y), path = q.popleft()
          if (x, y) in targets:
              return path + [(x, y)]
          for dx, dy in [(1, 0), (-1, 0), (0, -1), (0, 1)]:
              nx, ny = x + dx, y + dy
              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                  if passable[nx, ny]:
                      visited.add((nx, ny))
                      q.append(((nx, ny), path + [(x, y)]))
      raise RuntimeError("No path found")

  def positions_of_kind(grid, kind):
      """Return a set of (x, y) positions where ``kind`` is present."""
      xs, ys = (grid[:, :, kind] > 0).nonzero()
      return set(zip(xs.tolist(), ys.tolist()))

  # ----------------------------------------------------------------------
  # 1. Identify the recipe for a stick
  # ----------------------------------------------------------------------
  # Index of the target item
  stick_idx = env.world.cookbook.index["stick"]
  # Primitive requirements (kind index -> count)
  primitive_needs = dict(env.world.cookbook.primitives_for(stick_idx))

  # ----------------------------------------------------------------------
  # 2. Collect each required primitive
  # ----------------------------------------------------------------------
  actions = []
  state = env._current_state
  grid = state.grid
  W, H, _ = grid.shape

  # Passable cells are those that are completely empty (no entity)
  # We also allow stepping onto a cell that contains the primitive we are
  # about to collect – it will be treated as passable for the purpose of
  # navigation.
  base_passable = (grid.sum(axis=2) == 0)

  for prim_kind, needed_cnt in primitive_needs.items():
      while needed_cnt > 0:
          # Locate all cells that currently contain this primitive
          prim_cells = positions_of_kind(grid, prim_kind)
          if not prim_cells:
              raise RuntimeError(f"Cannot find required primitive {prim_kind}")

          # Allow the target cell itself to be considered passable for the
          # final step (so we can step onto it)
          passable = base_passable.copy()
          for (x, y) in prim_cells:
              passable[x, y] = True

          # Compute a path from the agent's current position to the nearest
          # primitive cell.
          path = bfs(state.pos, prim_cells, passable)

          # Convert the path (list of positions) into movement actions.
          for (x0, y0), (x1, y1) in zip(path, path[1:]):
              dx, dy = x1 - x0, y1 - y0
              act = ACTIONS[(dx, dy)]
              actions.append(act)
              # Step the environment so that internal state stays in sync.
              env.step(act)
              state = env._current_state
              grid = state.grid

          # We are now on the primitive cell.  Use the USE action to pick it
          # up.  (If the environment automatically picks up on entry, the USE
          # will be a harmless no‑op.)
          actions.append(USE)
          env.step(USE)
          state = env._current_state
          grid = state.grid

          needed_cnt -= 1

  # ----------------------------------------------------------------------
  # 3. Move to the workshop and craft the stick
  # ----------------------------------------------------------------------
  # The workshop kind is stored under the special key "_at" in the recipe.
  workshop_kind = env.world.cookbook.recipes[stick_idx]["_at"]
  workshop_cells = positions_of_kind(grid, workshop_kind)
  if not workshop_cells:
      raise RuntimeError("No workshop of the required type found in the map")

  # Re‑compute passable map (now that primitives have been removed)
  base_passable = (grid.sum(axis=2) == 0)
  passable = base_passable.copy()
  for (x, y) in workshop_cells:
      passable[x, y] = True

  path = bfs(state.pos, workshop_cells, passable)

  for (x0, y0), (x1, y1) in zip(path, path[1:]):
      dx, dy = x1 - x0, y1 - y0
      act = ACTIONS[(dx, dy)]
      actions.append(act)
      env.step(act)
      state = env._current_state
      grid = state.grid

  # Finally, use the workshop to craft the stick.
  actions.append(USE)
  env.step(USE)

  # Return the complete action list.
  return actions


