"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that will collect the necessary primitives and craft a
  ``stick`` in the given CraftLab environment.

  The implementation is generic – it does not rely on a particular map layout.
  It queries the world’s ``Cookbook`` for the recipe, locates the required
  primitive items and the appropriate workshop, and then generates a simple
  Manhattan‑style plan (move horizontally, then vertically) to fetch the items
  and finally craft the stick.

  Parameters
  ----------
  env : CraftLab
      An instantiated CraftLab environment (already reset).

  Returns
  -------
  List[int]
      Sequence of action indices that can be fed to ``env.step`` to complete
      the task.
  """
  # --------------------------------------------------------------------- #
  # Helper utilities
  # --------------------------------------------------------------------- #
  import numpy as np

  # Mapping from action name to integer index (the env provides this dict)
  ACTIONS = env.action_specs()
  DOWN = ACTIONS["DOWN"]
  UP   = ACTIONS["UP"]
  LEFT = ACTIONS["LEFT"]
  RIGHT= ACTIONS["RIGHT"]
  USE  = ACTIONS["USE"]

  # --------------------------------------------------------------------- #
  # 1. Identify the goal (stick) and its recipe
  # --------------------------------------------------------------------- #
  # The name used in the recipe file is assumed to be ``stick``.
  goal_name = "stick"
  try:
      goal_idx = env.world.cookbook.index[goal_name]
  except Exception as exc:                     # pragma: no cover
      raise ValueError(f"Goal '{goal_name}' not found in cookbook.") from exc

  # ``primitives_for`` returns a dict {primitive_idx: count}
  primitives_needed = env.world.cookbook.primitives_for(goal_idx)

  # The workshop where the stick must be crafted is stored under the
  # ``_at`` key of the recipe.
  workshop_kind = None
  recipe = env.world.cookbook.recipes.get(goal_idx, {})
  if "_at" in recipe:
      workshop_kind = recipe["_at"]
  else:                                        # pragma: no cover
      raise ValueError(f"Recipe for '{goal_name}' does not specify a workshop.")

  # --------------------------------------------------------------------- #
  # 2. Locate entities on the current grid
  # --------------------------------------------------------------------- #
  def find_nearest(grid, kind):
      """Return the Manhattan‑closest cell that contains ``kind`` (or None)."""
      positions = np.argwhere(grid[:, :, kind] > 0)
      if positions.size == 0:
          return None
      cur_pos = np.array(env._current_state.pos)
      # Manhattan distance
      dists = np.abs(positions - cur_pos).sum(axis=1)
      return tuple(positions[dists.argmin()])

  # --------------------------------------------------------------------- #
  # 3. Generate a movement plan to a target cell (simple horiz‑then‑vert)
  # --------------------------------------------------------------------- #
  def plan_path(start, target):
      """Yield actions to move from ``start`` to ``target``."""
      y, x = start          # grid is (row, col) == (y, x)
      ty, tx = target
      # Horizontal moves (left/right)
      while x < tx:
          yield RIGHT
          x += 1
      while x > tx:
          yield LEFT
          x -= 1
      # Vertical moves (down/up)
      while y < ty:
          yield DOWN
          y += 1
      while y > ty:
          yield UP
          y -= 1

  # --------------------------------------------------------------------- #
  # 4. Assemble the full action list
  # --------------------------------------------------------------------- #
  actions = []

  # Helper to move to a location and optionally USE
  def go_and_use(pos, use=False):
      nonlocal actions
      actions.extend(plan_path(env._current_state.pos, pos))
      if use:
          actions.append(USE)

  # --------------------------------------------------------------------- #
  # 5. Collect each required primitive
  # --------------------------------------------------------------------- #
  for prim_idx, count in primitives_needed.items():
      for _ in range(count):
          # Find the nearest instance of the primitive
          target = find_nearest(env._current_state.grid, prim_idx)
          if target is None:                     # pragma: no cover
              raise RuntimeError(f"Cannot find required primitive (idx={prim_idx}).")
          go_and_use(target, use=True)
          # Simulate the steps so that subsequent calls see the updated state
          for a in actions[-(len(list(plan_path(env._current_state.pos, target)))+1):]:
              _, _ = env.step(a)

  # --------------------------------------------------------------------- #
  # 6. Move to the workshop and craft the stick
  # --------------------------------------------------------------------- #
  workshop_pos = find_nearest(env._current_state.grid, workshop_kind)
  if workshop_pos is None:                     # pragma: no cover
      raise RuntimeError("Workshop for stick not found on the map.")
  go_and_use(workshop_pos, use=True)

  # The actions list now contains a full plan; we return it without executing
  # the final USE (the caller may wish to execute it step‑by‑step).
  return actions


