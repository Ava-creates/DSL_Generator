import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that will allow the agent to craft a
  ``stick`` in the provided CraftWorld environment.

  The function inspects the environment's recipe for a stick, collects
  the required primitive resources, and then moves to the appropriate
  workshop to craft the final item.

  Parameters
  ----------
  env : object
      An instance of the CraftWorld environment (or a wrapper such as
      ``CraftLab``).  The function expects the object to expose the
      attributes ``world`` (a ``CraftWorld`` instance) and
      ``_current_state`` (a ``CraftState`` instance) – which is the case
      for the standard DMLab‑style wrapper.

  Returns
  -------
  List[int]
      A list of action indices (DOWN, UP, LEFT, RIGHT, USE) that, when
      executed sequentially, will result in the agent possessing a
      ``stick`` in its inventory.
  """
  # ------------------------------------------------------------------
  # Helper to move from one grid coordinate to another using Manhattan
  # moves.  This does NOT account for obstacles; it assumes a clear path.
  # ------------------------------------------------------------------
  def _move_actions(start, goal):
      sx, sy = start
      gx, gy = goal
      actions = []

      # horizontal moves (x axis)
      while sx < gx:
          actions.append(RIGHT)
          sx += 1
      while sx > gx:
          actions.append(LEFT)
          sx -= 1

      # vertical moves (y axis)
      while sy < gy:
          actions.append(DOWN)
          sy += 1
      while sy > gy:
          actions.append(UP)
          sy -= 1

      return actions

  # ------------------------------------------------------------------
  # 1. Identify the index of the goal item (``stick``) and its recipe.
  # ------------------------------------------------------------------
  cookbook = env.world.cookbook
  try:
      stick_idx = cookbook.index["stick"]
  except KeyError:
      raise ValueError("The environment does not contain a recipe for 'stick'.")

  # Primitive requirements for one stick (e.g. ``{'log': 1}``).
  primitive_requirements = cookbook.primitives_for(stick_idx)

  # Full recipe (contains the ``_at`` key that tells us where to craft).
  recipe = cookbook.recipes.get(stick_idx, {})

  # ------------------------------------------------------------------
  # 2. Get the current state of the world.
  # ------------------------------------------------------------------
  # ``CraftLab`` stores the active state in ``_current_state``.
  state = getattr(env, "_current_state", None)
  if state is None:
      # Fallback for a raw ``CraftScenario``/``CraftState`` usage.
      state = env.scenario.init()

  grid = state.grid
  pos = tuple(state.pos)  # (x, y)

  action_plan = []

  # ------------------------------------------------------------------
  # 3. Collect each required primitive the required number of times.
  # ------------------------------------------------------------------
  for prim_idx, count in primitive_requirements.items():
      for _ in range(count):
          # Locate any cell that currently contains the primitive.
          locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              # Primitive not present – in a fully generated scenario this
              # should not happen, but we break to avoid an infinite loop.
              raise RuntimeError(
                  f"Required primitive (index {prim_idx}) not found on the grid."
              )
          # Choose the first found location.
          target = tuple(locations[0][:2])

          # Move to the primitive.
          action_plan.extend(_move_actions(pos, target))
          # Pick it up / collect.
          action_plan.append(USE)

          # Update our simulated position (the environment will update the
          # grid after the step, but we keep a local copy for planning).
          pos = target
          # Remove the primitive from our local copy to avoid re‑picking it.
          grid[target[0], target[1], prim_idx] = 0

  # ------------------------------------------------------------------
  # 4. Move to the appropriate workshop and craft the stick.
  # ------------------------------------------------------------------
  workshop_kind = None
  # The workshop is stored under the special key ``"_at"`` in the recipe.
  for key, value in recipe.items():
      if key == "_at":
          workshop_kind = value
          break

  if workshop_kind is not None:
      # Locate a workshop of the required type.
      workshop_locs = np.argwhere(grid[:, :, workshop_kind] > 0)
      if workshop_locs.size == 0:
          raise RuntimeError(
              f"Required workshop (index {workshop_kind}) not found on the grid."
          )
      workshop_pos = tuple(workshop_locs[0][:2])

      # Move to the workshop.
      action_plan.extend(_move_actions(pos, workshop_pos))
      # Use the workshop to craft the stick.
      action_plan.append(USE)

  return action_plan


