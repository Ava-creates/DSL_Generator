import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  import numpy as np
  actions = []
  # action mapping (as used by CraftWorld)
  ACTION_DOWN = 0
  ACTION_UP = 1
  ACTION_LEFT = 2
  ACTION_RIGHT = 3
  ACTION_USE = 4

  world = env.world
  # index of the goal item "stick"
  stick_idx = world.cookbook.index.get("stick")
  if stick_idx is None:
      # unknown goal
      return actions

  # primitive requirements for one stick
  required = world.cookbook.primitives_for(stick_idx)

  # get current state (might be stored in env._current_state)
  if hasattr(env, "_current_state"):
      state = env._current_state
  else:
      # create a fresh state from the scenario
      state = env.scenario.init()
  grid = state.grid
  pos = list(state.pos)   # mutable copy [x, y]

  def nearest_location(kind):
      """Return the (x, y) of the nearest cell that contains `kind`."""
      locations = np.argwhere(grid[:, :, kind] > 0)
      if locations.shape[0] == 0:
          return None
      # Manhattan distance
      dists = np.sum(np.abs(locations - pos), axis=1)
      return locations[np.argmin(dists)]

  def move_to(target):
      """Append actions that move the agent from current pos to target (x, y)."""
      nonlocal pos
      tx, ty = target
      # move in x direction (width axis)
      while pos[0] < tx:
          actions.append(ACTION_RIGHT)
          pos[0] += 1
      while pos[0] > tx:
          actions.append(ACTION_LEFT)
          pos[0] -= 1
      # move in y direction (height axis)
      while pos[1] < ty:
          actions.append(ACTION_DOWN)
          pos[1] += 1
      while pos[1] > ty:
          actions.append(ACTION_UP)
          pos[1] -= 1

  # collect each required primitive the required number of times
  for kind, cnt in required.items():
      for _ in range(cnt):
          loc = nearest_location(kind)
          if loc is None:
              # primitive not present – give up
              continue
          move_to(loc.tolist())
          actions.append(ACTION_USE)   # pick up the primitive

  # finally go to a workshop that can craft a stick and use it
  # the workshop type is stored in the recipe under the key "_at"
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_kind = recipe.get("_at")
  if workshop_kind is not None:
      # workshop_kind may be a name; translate to index if needed
      if isinstance(workshop_kind, str):
          workshop_idx = world.cookbook.index.get(workshop_kind)
      else:
          workshop_idx = workshop_kind
      if workshop_idx is not None:
          ws_loc = nearest_location(workshop_idx)
          if ws_loc is not None:
              move_to(ws_loc.tolist())
              actions.append(ACTION_USE)   # craft the stick

  return actions


