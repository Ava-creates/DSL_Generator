import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will cause the agent to craft a ``stick``.
  The implementation works with the generic CraftWorld API exposed by the
  ``env`` object (which contains a ``state`` attribute of type ``CraftState``).

  The algorithm is straightforward:
  1.  Query the recipe for ``stick`` via the world’s ``Cookbook``.
  2.  For each required primitive, locate the nearest cell that contains it,
      walk to that cell and ``USE`` it (collecting the item).
  3.  After all primitives are in the inventory, locate any workshop that can
      craft a stick, walk to it and ``USE`` again to perform the crafting.
  4.  Return the concatenated list of actions.

  The function makes no assumptions about the exact layout of the world –
  it simply uses Manhattan distance to decide a greedy (but sufficient)
  path.  The action indices follow the convention used throughout the
  CraftWorld code base:

      0 → DOWN
      1 → UP
      2 → LEFT
      3 → RIGHT
      4 → USE   (collect / craft)

  Parameters
  ----------
  env : object
      An instance of the CraftWorld environment.  It must expose the
      attributes ``state`` (a ``CraftState``) and ``world`` (a ``CraftWorld``).

  Returns
  -------
  List[int]
      A sequence of action indices that, when executed in order, will result
      in at least one ``stick`` in the agent’s inventory.
  """
  # ------------------------------------------------------------------ #
  # Helper utilities
  # ------------------------------------------------------------------ #
  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4

  def manhattan(a, b):
      return abs(a[0] - b[0]) + abs(a[1] - b[1])

  def greedy_path(start, goal):
      """Yield a list of movement actions that walk from ``start`` to ``goal``."""
      x, y = start
      gx, gy = goal
      actions = []
      # move in x direction
      while x != gx:
          if gx > x:
              actions.append(ACTION_RIGHT)
              x += 1
          else:
              actions.append(ACTION_LEFT)
              x -= 1
      # move in y direction
      while y != gy:
          if gy > y:
              actions.append(ACTION_DOWN)
              y += 1
          else:
              actions.append(ACTION_UP)
              y -= 1
      return actions

  # ------------------------------------------------------------------ #
  # 1. Identify the goal index for “stick” and its recipe.
  # ------------------------------------------------------------------ #
  stick_name = "stick"
  # The Index object maps names → integer IDs.
  stick_idx = env.world.cookbook.index[stick_name]
  if stick_idx is None:
      raise ValueError(f"Stick not found in the cookbook (name = '{stick_name}').")

  # Primitive requirements for one stick.
  primitive_requirements = env.world.cookbook.primitives_for(stick_idx)  # {prim_idx: count}
  if not primitive_requirements:
      # No recipe – stick must be a primitive itself.  In that case we only need
      # to pick it up if it exists on the map.
      primitive_requirements = {stick_idx: 1}

  # ------------------------------------------------------------------ #
  # 2. Collect all required primitives.
  # ------------------------------------------------------------------ #
  actions = []
  grid = env.state.grid           # shape (W, H, n_kinds)
  pos = tuple(env.state.pos)      # (x, y)
  inventory = env.state.inventory.copy()

  for prim_idx, needed in primitive_requirements.items():
      while inventory[prim_idx] < needed:
          # Locate the nearest cell that still contains this primitive.
          # ``grid[..., prim_idx]`` is a 2‑D boolean/int mask of where the
          # primitive exists.
          locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              raise RuntimeError(f"Required primitive (idx={prim_idx}) not present on the map.")
          # Choose the location with minimal Manhattan distance.
          dists = np.apply_along_axis(lambda loc: manhattan(pos, (loc[0], loc[1])),
                                      1, locations)
          nearest = locations[np.argmin(dists)]
          target = (int(nearest[0]), int(nearest[1]))

          # Walk to the target cell.
          actions.extend(greedy_path(pos, target))
          pos = target

          # Collect the primitive.
          actions.append(ACTION_USE)
          # Simulate the effect on the local copy of state so that subsequent
          # steps see the updated inventory and grid.
          # Remove one instance from the grid.
          grid[pos[0], pos[1], prim_idx] -= 1
          inventory[prim_idx] += 1

  # ------------------------------------------------------------------ #
  # 3. Move to a workshop that can craft a stick and perform the craft.
  # ------------------------------------------------------------------ #
  # The recipe dict stored in ``Cookbook.recipes`` contains a special key
  # "_at" indicating the workshop type required for the output.
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  workshop_type = recipe.get("_at")
  if workshop_type is None:
      # No specific workshop – the craft can be performed anywhere.
      # We simply invoke USE at the current location.
      actions.append(ACTION_USE)
      return actions

  # Convert workshop name to its index.
  workshop_idx = env.world.cookbook.index[workshop_type]
  # Find any cell that contains this workshop.
  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
  if workshop_cells.size == 0:
      raise RuntimeError(f"No workshop of type '{workshop_type}' found on the map.")

  # Choose the nearest workshop.
  dists = np.apply_along_axis(lambda loc: manhattan(pos, (loc[0], loc[1])),
                              1, workshop_cells)
  nearest_ws = workshop_cells[np.argmin(dists)]
  ws_target = (int(nearest_ws[0]), int(nearest_ws[1]))

  # Walk to the workshop.
  actions.extend(greedy_path(pos, ws_target))
  pos = ws_target

  # Craft the stick.
  actions.append(ACTION_USE)

  return actions


