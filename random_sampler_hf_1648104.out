"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that will make a ``stick`` in the supplied
  CraftLab environment.

  The function works by:
    1.  Querying the world’s recipe for the current goal (the goal is
        assumed to be a ``stick``).
    2.  Gathering all required primitive items by moving to the nearest
        cell that contains each primitive and using the ``USE`` action.
    3.  Moving to the required workshop (if the recipe specifies one) and
        using the ``USE`` action to craft the stick.

  The returned list can be fed back to the environment via
  ``env.step(action)`` to reproduce the same behaviour.

  Parameters
  ----------
  env : CraftLab
      An instantiated CraftLab environment (already reset).

  Returns
  -------
  List[int]
      Sequence of action indices that will result in the stick being in
      the agent’s inventory.
  """
  import numpy as np

  # ------------------------------------------------------------------
  # Helper utilities
  # ------------------------------------------------------------------
  # Mapping from action names to integer codes used by the environment
  action_map = env.action_specs()          # e.g. {'DOWN':0, 'UP':1, ...}
  use_action = action_map["USE"]

  # Simple step wrapper that also updates the local ``state`` reference
  def _step(a):
      nonlocal state
      _, _, _ = env.step(a)                # reward / done / info are ignored
      state = env._current_state

  # Move greedily towards a target cell (tx, ty) using Manhattan distance
  def _move_to(tx, ty):
      while state.pos != (tx, ty):
          x, y = state.pos
          dx, dy = tx - x, ty - y
          # Prefer the larger component of the distance
          if abs(dx) >= abs(dy):
              a = action_map["RIGHT"] if dx > 0 else action_map["LEFT"]
          else:
              a = action_map["DOWN"] if dy > 0 else action_map["UP"]
          actions.append(a)
          _step(a)

  # ------------------------------------------------------------------
  # Gather information about the goal (stick)
  # ------------------------------------------------------------------
  state = env._current_state
  goal_idx = env.task.goal                                   # index of the stick
  cookbook = env.world.cookbook

  # Primitive requirements for the goal
  primitive_needs = cookbook.primitives_for(goal_idx)       # {kind_idx: count}
  # Workshop required for crafting (if any)
  workshop_kind = None
  recipe = cookbook.recipes.get(goal_idx, {})
  if "_at" in recipe:
      workshop_kind = recipe["_at"]

  actions = []

  # ------------------------------------------------------------------
  # Collect each required primitive
  # ------------------------------------------------------------------
  for kind, needed in primitive_needs.items():
      for _ in range(needed):
          # Locate all cells that currently contain this primitive
          locs = np.argwhere(state.grid[:, :, kind] > 0)
          if len(locs) == 0:
              # No more primitives of this kind on the map – abort early
              return actions
          # Choose the nearest one (Manhattan distance)
          dists = np.sum(np.abs(locs - np.array(state.pos)), axis=1)
          nearest = locs[np.argmin(dists)]
          tx, ty = int(nearest[0]), int(nearest[1])

          # Move to the primitive and pick it up
          _move_to(tx, ty)
          actions.append(use_action)
          _step(use_action)

  # ------------------------------------------------------------------
  # Move to the workshop (if required) and craft the stick
  # ------------------------------------------------------------------
  if workshop_kind is not None:
      locs = np.argwhere(state.grid[:, :, workshop_kind] > 0)
      if len(locs) > 0:
          dists = np.sum(np.abs(locs - np.array(state.pos)), axis=1)
          nearest = locs[np.argmin(dists)]
          wx, wy = int(nearest[0]), int(nearest[1])
          _move_to(wx, wy)
          actions.append(use_action)
          _step(use_action)

  return actions


