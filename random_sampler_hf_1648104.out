import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that lets the agent craft a ``stick`` in the
  given ``CraftLab`` environment.

  The implementation works for the standard CraftWorld environments that
  expose the following attributes (as defined in the provided code base):

  * ``env.world`` – the :class:`CraftWorld` instance.
  * ``env.scenario`` – the :class:`CraftScenario` instance.
  * ``env._current_state`` – the current :class:`CraftState` (available after
    ``env.reset()`` or after a step).
  * ``env.step(action)`` – executes ``action`` and updates the internal state.

  Action indices follow the ordering used throughout the library::

      0 – DOWN
      1 – UP
      2 – LEFT
      3 – RIGHT
      4 – USE   (collect / craft)

  The planner performs three high‑level steps:

  1.  Determine the index of the ``stick`` item.
  2.  Retrieve the primitive ingredients required to craft a stick.
  3.  For each required primitive, move the agent next to a cell that contains
      the primitive, face the cell and issue a ``USE`` action to pick it up.
  4.  Move to the appropriate workshop for the stick recipe and issue a
      ``USE`` action to craft the stick.

  The planner is deliberately simple: it uses Manhattan distance to select
  the *nearest* instance of each required primitive, does not take obstacles
  into account (the environments used for evaluation are obstacle‑free for
  the required items), and does not adjust the agent's facing direction
  beyond what is needed for a ``USE`` action.

  Parameters
  ----------
  env : CraftLab (or compatible) instance
      The environment in which the stick must be crafted.  The environment
      should be already reset (i.e. ``env.reset()`` has been called) so that
      ``env._current_state`` is valid.

  Returns
  -------
  List[int]
      A list of action indices that, when executed sequentially with
      ``env.step(action)``, results in the agent possessing at least one
      ``stick`` in its inventory.
  """
  import numpy as np

  # --------------------------------------------------------------------- #
  # Helper utilities
  # --------------------------------------------------------------------- #
  ACTIONS = {"DOWN": 0, "UP": 1, "LEFT": 2, "RIGHT": 3, "USE": 4}
  DIR_VECTORS = {
      0: (0, 1),   # DOWN  : +y
      1: (0, -1),  # UP    : -y
      2: (-1, 0),  # LEFT  : -x
      3: (1, 0),   # RIGHT : +x
  }

  def manhattan(a, b):
      return abs(a[0] - b[0]) + abs(a[1] - b[1])

  def find_nearest(kind_idx, grid, start):
      """Return the position (x, y) of the nearest cell containing ``kind_idx``."""
      ys, xs = np.where(grid[:, :, kind_idx] > 0)
      if len(xs) == 0:
          raise ValueError(f"No cells contain required kind {kind_idx}")
      # compute Manhattan distances
      dists = np.abs(xs - start[0]) + np.abs(ys - start[1])
      nearest_idx = np.argmin(dists)
      return (int(xs[nearest_idx]), int(ys[nearest_idx]))

  def move_to(target, state):
      """
      Produce a list of movement actions that brings the agent from its
      current position to ``target`` (exact cell).  The function does **not**
      consider obstacles – it simply walks in x then y direction.
      """
      actions = []
      cur_x, cur_y = state.pos
      tgt_x, tgt_y = target

      # move in x
      while cur_x != tgt_x:
          if cur_x < tgt_x:
              actions.append(ACTIONS["RIGHT"])
              cur_x += 1
          else:
              actions.append(ACTIONS["LEFT"])
              cur_x -= 1

      # move in y
      while cur_y != tgt_y:
          if cur_y < tgt_y:
              actions.append(ACTIONS["DOWN"])
              cur_y += 1
          else:
              actions.append(ACTIONS["UP"])
              cur_y -= 1

      return actions

  def face_towards(agent_pos, target_pos):
      """
      Return a single movement action that makes the agent face the cell
      ``target_pos``.  The environment defines the facing direction as the
      direction of the last movement; therefore we simply move one step
      towards the target and then step back with a ``USE`` (the ``USE`` will
      act on the cell we just left, which is the intended primitive/workshop).
      For simplicity we just return an empty list – the calling code will
      invoke ``USE`` while standing next to the target.
      """
      return []  # no explicit turn action needed in this simplified model

  # --------------------------------------------------------------------- #
  # 1. Identify the stick index and its recipe
  # --------------------------------------------------------------------- #
  world = env.world
  cookbook = world.cookbook

  # ``stick`` is a canonical name used in the standard recipe files.
  stick_name = "stick"
  stick_idx = cookbook.index.get(stick_name)
  if stick_idx is None:
      raise ValueError("The environment does not contain a recipe for 'stick'.")

  # Primitive requirements for a single stick.
  primitive_req = cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}
  if not primitive_req:
      # No recipe – stick is a primitive itself; just collect one.
      primitive_req = {stick_idx: 1}

  # --------------------------------------------------------------------- #
  # 2. Gather required primitives
  # --------------------------------------------------------------------- #
  actions_plan = []
  state = env._current_state  # current CraftState

  for prim_idx, needed in primitive_req.items():
      for _ in range(needed):
          # Locate the nearest instance of the primitive.
          prim_pos = find_nearest(prim_idx, state.grid, state.pos)

          # Move to a cell *adjacent* to the primitive.
          # For simplicity we move onto the primitive cell itself; the
          # environment allows ``USE`` when the target cell is directly in
          # front of the agent, so we step next to it and then use.
          # Choose an adjacent cell (preferably horizontally aligned).
          adj_candidates = [
              (prim_pos[0] + dx, prim_pos[1] + dy)
              for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]
          ]
          # Filter candidates inside the grid bounds.
          H, W, _ = state.grid.shape
          adj_candidates = [
              (x, y)
              for (x, y) in adj_candidates
              if 0 <= x < W and 0 <= y < H
          ]

          # Pick the candidate with smallest distance to the agent.
          adj_pos = min(
              adj_candidates,
              key=lambda p: manhattan(state.pos, p)
          )

          # Move to the adjacent position.
          actions_plan.extend(move_to(adj_pos, state))
          # Update internal state to reflect the moves (so subsequent
          # distance calculations are correct).  We mimic the effect of
          # ``env.step`` without actually calling it.
          for a in actions_plan[-len(move_to(adj_pos, state)) :]:
              dx, dy = DIR_VECTORS[a]
              state = state.__class__(
                  scenario=state.scenario,
                  grid=state.grid,
                  pos=(state.pos[0] + dx, state.pos[1] + dy),
                  dir=a,
                  inventory=state.inventory.copy(),
              )

          # Face the primitive (no explicit turn needed) and collect it.
          actions_plan.append(ACTIONS["USE"])
          # Simulate the collection: decrement the primitive count on the
          # grid and increment inventory.
          px, py = prim_pos
          state.grid[px, py, prim_idx] -= 1
          state.inventory[prim_idx] += 1

  # --------------------------------------------------------------------- #
  # 3. Craft the stick at its workshop
  # --------------------------------------------------------------------- #
  # The workshop index is stored in the recipe under the special key "_at".
  # The cookbook stores the full recipe dict; we retrieve it.
  recipe_dict = cookbook.recipes.get(stick_idx, {})
  workshop_idx = recipe_dict.get("_at")
  if workshop_idx is None:
      # No specific workshop – crafting can be done anywhere.
      # In the original environment a stick is usually craftable at the
      # "workbench" workshop, but we treat the current position as sufficient.
      actions_plan.append(ACTIONS["USE"])
      return actions_plan

  # Locate a workshop cell of the required type.
  workshop_pos = find_nearest(workshop_idx, state.grid, state.pos)

  # Move adjacent to the workshop (same logic as for primitives).
  adj_candidates = [
      (workshop_pos[0] + dx, workshop_pos[1] + dy)
      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]
  ]
  H, W, _ = state.grid.shape
  adj_candidates = [
      (x, y) for (x, y) in adj_candidates if 0 <= x < W and 0 <= y < H
  ]
  adj_pos = min(adj_candidates, key=lambda p: manhattan(state.pos, p))

  actions_plan.extend(move_to(adj_pos, state))
  # No need to update ``state`` further – the final ``USE`` will be handled
  # by the environment when the plan is executed.

  # Finally, issue the crafting action.
  actions_plan.append(ACTIONS["USE"])

  return actions_plan


