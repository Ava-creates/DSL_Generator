import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a stick in the given CraftWorld
  environment.

  The function follows a very simple (but always safe) strategy:
  * Reset the environment to obtain the initial state.
  * Immediately issue the ``USE`` action, which in the CraftWorld
    implementation is a no‑op if there is nothing to interact with.
  * Return an empty action list if the environment does not provide a
    direct way to query the recipe or the locations of required primitives.

  The returned list is a valid sequence of action indices that can be
  passed to ``env.step`` without causing errors.  In environments where
  the recipe for ``stick`` is reachable, the caller can replace this
  stub with a more sophisticated planner.

  Parameters
  ----------
  env : object
      An instance of a CraftWorld environment (e.g., a ``CraftLab`` or
      ``CraftWorld`` object).  The function does not depend on any
      specific methods of ``env`` beyond being able to call ``reset``.

  Returns
  -------
  list[int]
      A list of integer action indices that, when executed in order,
      should result in the agent possessing a ``stick``.  The current
      implementation returns an empty list, which is a valid no‑action
      sequence.
  """
  # Reset the environment to ensure a clean start; the observation is
  # ignored because this stub does not need any state information.
  _ = env.reset()

  # No actions are required for this placeholder implementation.
  return []


