"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a deterministic sequence of actions that will obtain a ``stick`` in the
  provided CraftWorld environment.

  The implementation follows these steps:

  1.  Reset the environment to obtain the initial state.
  2.  Retrieve the index for the item ``stick`` and the primitive(s) required to
      craft it from the ``Cookbook``.
  3.  Locate one instance of each required primitive on the grid.
  4.  Plan a shortest path (BFS) from the agent’s current position to a free cell
      adjacent to the primitive, move there, turn back towards the primitive and
      execute the ``USE`` action to pick it up.
  5.  After all required primitives have been collected, locate the workshop where
      ``stick`` can be crafted, move adjacent to it, turn back towards the workshop
      and ``USE`` again to craft the stick.
  6.  Return the concatenated list of action indices.

  The function only uses the public API of the environment (``reset`` and ``step``)
  and the data stored in ``env._current_state`` after a reset.  It does **not**
  modify the environment; it merely returns a list of actions that a caller can
  feed back to the environment.

  Parameters
  ----------
  env : CraftLab
      An instance of the CraftLab environment (see ``craft.env``).

  Returns
  -------
  List[int]
      A list of action indices that, when executed sequentially, will result in
      the agent possessing a ``stick`` in its inventory.
  """
  import collections
  import numpy as np

  # --------------------------------------------------------------------- #
  # Helper utilities
  # --------------------------------------------------------------------- #
  # Action constants – they are defined in the ``craft.env`` module.
  DOWN = env.DOWN
  UP = env.UP
  LEFT = env.LEFT
  RIGHT = env.RIGHT
  USE = env.USE

  # Mapping from action index to (dx, dy) movement.
  ACTION_DELTAS = {
      DOWN: (0, 1),
      UP: (0, -1),
      LEFT: (-1, 0),
      RIGHT: (1, 0),
  }

  def bfs(start, targets, blocked):
      """
      Bread‑first‑search returning a list of actions that moves the agent from
      ``start`` to any cell in ``targets`` while avoiding ``blocked`` cells.

      Parameters
      ----------
      start : tuple[int, int]
          (x, y) start position.
      targets : set[tuple[int, int]]
          Set of goal positions.
      blocked : np.ndarray of shape (W, H) – bool
          ``True`` where the cell cannot be entered.

      Returns
      -------
      List[int] or None
          List of actions (indices) to reach a target, or ``None`` if unreachable.
      """
      W, H = blocked.shape
      q = collections.deque()
      q.append(start)
      came_from = {start: (None, None)}  # pos -> (prev_pos, action)

      while q:
          cur = q.popleft()
          if cur in targets:
              # reconstruct path
              path_actions = []
              while came_from[cur][0] is not None:
                  prev, act = came_from[cur]
                  path_actions.append(act)
                  cur = prev
              path_actions.reverse()
              return path_actions

          x, y = cur
          for act, (dx, dy) in ACTION_DELTAS.items():
              nx, ny = x + dx, y + dy
              if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny]:
                  nxt = (nx, ny)
                  if nxt not in came_from:
                      came_from[nxt] = (cur, act)
                      q.append(nxt)
      return None

  # --------------------------------------------------------------------- #
  # 1. Reset environment and fetch the initial state.
  # --------------------------------------------------------------------- #
  env.reset()
  state = env._current_state          # type: CraftState
  grid = state.grid                    # (W, H, K)
  pos = state.pos                      # (x, y)
  inventory = state.inventory.copy()   # (K,)

  W, H, K = grid.shape

  # --------------------------------------------------------------------- #
  # 2. Identify the stick item and its recipe.
  # --------------------------------------------------------------------- #
  cookbook = env.world.cookbook
  try:
      stick_idx = cookbook.index['stick']
  except KeyError:
      # No stick defined – nothing to do.
      return []

  # Primitive requirements for a single stick.
  primitive_req = cookbook.primitives_for(stick_idx)  # {prim_idx: count}
  if not primitive_req:
      # Stick is a primitive itself – just need to pick it up.
      primitive_req = {stick_idx: 1}

  # --------------------------------------------------------------------- #
  # 3. Helper to find a free neighbour of a given cell.
  # --------------------------------------------------------------------- #
  def free_neighbours(cell):
      """Return a set of empty neighbour positions next to ``cell``."""
      x, y = cell
      neigh = set()
      for dx, dy in ACTION_DELTAS.values():
          nx, ny = x + dx, y + dy
          if 0 <= nx < W and 0 <= ny < H:
              if grid[nx, ny].sum() == 0:  # empty
                  neigh.add((nx, ny))
      return neigh

  # --------------------------------------------------------------------- #
  # 4. Collect each required primitive.
  # --------------------------------------------------------------------- #
  actions_plan = []

  # Pre‑compute a static blocked map (cells that are never traversable).
  # Cells containing any entity are blocked for movement.
  static_blocked = grid.sum(axis=2) > 0

  for prim_idx, needed in primitive_req.items():
      while needed > 0:
          # Locate any cell that still contains the primitive.
          prim_locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if prim_locations.size == 0:
              # No more primitives of this type – cannot finish.
              return actions_plan
          # Choose the closest one (Manhattan distance) to current pos.
          distances = np.abs(prim_locations[:, 0] - pos[0]) + \
                      np.abs(prim_locations[:, 1] - pos[1])
          closest_idx = distances.argmin()
          prim_cell = tuple(prim_locations[closest_idx])

          # Find empty neighbour cells of the primitive.
          candidate_neigh = free_neighbours(prim_cell)
          if not candidate_neigh:
              # Primitive is completely surrounded – skip it.
              # (Very unlikely in standard maps.)
              needed -= 1
              continue

          # Compute path to the nearest reachable neighbour.
          path = bfs(pos, candidate_neigh, static_blocked)
          if path is None:
              # Unreachable – abort this primitive.
              needed -= 1
              continue

          # Append movement actions.
          actions_plan.extend(path)

          # After moving, update our simulated position.
          for act in path:
              dx, dy = ACTION_DELTAS[act]
              pos = (pos[0] + dx, pos[1] + dy)

          # We are now on a neighbour cell.  Turn back towards the primitive
          # by moving one step away (which sets the facing direction correctly)
          # and then use the USE action.
          # Determine direction from neighbour to primitive.
          px, py = prim_cell
          nx, ny = pos
          if px == nx + 1 and py == ny:
              back_act = LEFT   # we need to face RIGHT → move left then USE
          elif px == nx - 1 and py == ny:
              back_act = RIGHT
          elif py == ny + 1 and px == nx:
              back_act = UP
          else:  # py == ny - 1
              back_act = DOWN

          # Move back one step (if possible) – the cell we came from is
          # guaranteed to be empty because we just entered it.
          actions_plan.append(back_act)
          dx, dy = ACTION_DELTAS[back_act]
          pos = (pos[0] + dx, pos[1] + dy)

          # Now we are facing the primitive; pick it up.
          actions_plan.append(USE)

          # Simulate the collection in our local copies.
          grid[prim_cell[0], prim_cell[1], prim_idx] -= 1
          inventory[prim_idx] += 1
          needed -= 1

  # --------------------------------------------------------------------- #
  # 5. Move to the workshop for the stick and craft it.
  # --------------------------------------------------------------------- #
  # Determine which workshop is required.
  recipe = cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get('_at')
  if workshop_name is None:
      # No workshop needed – stick is already in inventory.
      return actions_plan
  workshop_idx = cookbook.index[workshop_name]

  # Locate any workshop cell.
  ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
  if ws_cells.size == 0:
      # No workshop on the map – cannot craft.
      return actions_plan

  # Choose the closest workshop cell.
  distances = np.abs(ws_cells[:, 0] - pos[0]) + np.abs(ws_cells[:, 1] - pos[1])
  closest_ws = tuple(ws_cells[distances.argmin()])

  # Find empty neighbour of the workshop.
  ws_neigh = free_neighbours(closest_ws)
  if not ws_neigh:
      # Workshop is surrounded – skip crafting.
      return actions_plan

  # Path to neighbour.
  path = bfs(pos, ws_neigh, static_blocked)
  if path is not None:
      actions_plan.extend(path)
      for act in path:
          dx, dy = ACTION_DELTAS[act]
          pos = (pos[0] + dx, pos[1] + dy)

  # Turn back towards the workshop (same logic as for primitives).
  wx, wy = closest_ws
  nx, ny = pos
  if wx == nx + 1 and wy == ny:
      back_act = LEFT
  elif wx == nx - 1 and wy == ny:
      back_act = RIGHT
  elif wy == ny + 1 and wx == nx:
      back_act = UP
  else:
      back_act = DOWN

  actions_plan.append(back_act)
  dx, dy = ACTION_DELTAS[back_act]
  pos = (pos[0] + dx, pos[1] + dy)

  # Use the workshop to craft the stick.
  actions_plan.append(USE)

  return actions_plan


