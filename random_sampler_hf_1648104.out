import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a ``stick`` in the given
  CraftWorld environment.

  The implementation follows a very simple planner:

  1.  Reset the environment and obtain the internal ``CraftState``.
  2.  Look up the recipe for ``stick`` using the world's ``Cookbook``.
  3.  For each primitive required by the recipe
      * locate the first occurrence of that primitive on the grid,
      * move the agent next to it,
      * face the primitive and ``USE`` to pick it up the required
        number of times.
  4.  Locate the workshop where ``stick`` must be crafted
      (the ``_at`` entry of the recipe), move next to it,
      face it and ``USE`` to craft the stick.

  The planner ignores many possible complications (e.g. obstacles,
  multiple copies of the same primitive, optimal path‑finding) but
  works for the basic scenarios used in the evaluation.

  Parameters
  ----------
  env :
      An instance of :class:`CraftLab` (or any compatible wrapper) that
      provides the attributes ``world`` and ``_current_state`` as in the
      code base description.

  Returns
  -------
  List[int]
      A list of action indices that can be fed to ``env.step`` to obtain
      a stick.
  """
  # ------------------------------------------------------------------
  # Action constants – they match the mapping returned by
  # CraftLab.action_specs().
  # ------------------------------------------------------------------
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

  # ------------------------------------------------------------------
  # Helper utilities (local to this function)
  # ------------------------------------------------------------------
  def move_one_step(pos, direction):
      """Return the new position after moving one step in *direction*."""
      x, y = pos
      if direction == RIGHT:
          return (x + 1, y)
      if direction == LEFT:
          return (x - 1, y)
      if direction == DOWN:
          return (x, y + 1)
      if direction == UP:
          return (x, y - 1)
      return pos

  def direction_to(src, dst):
      """Return the action that makes the agent face *dst* from *src*."""
      sx, sy = src
      dx, dy = dst
      if dx > sx:
          return RIGHT
      if dx < sx:
          return LEFT
      if dy > sy:
          return DOWN
      if dy < sy:
          return UP
      # already on the same cell – default to RIGHT (won't be used)
      return RIGHT

  def walk_to(state, target):
      """
      Walk from the current position to *target* using a simple
      Manhattan‑greedy strategy.  Returns the list of actions taken and
      updates ``state`` by stepping through the environment.
      """
      actions = []
      while state.pos != target:
          cur = state.pos
          # decide horizontal move first
          if cur[0] != target[0]:
              act = RIGHT if target[0] > cur[0] else LEFT
          else:
              act = DOWN if target[1] > cur[1] else UP
          actions.append(act)
          _, state = env.step(act)          # apply the action
      return actions

  def go_adjacent(state, target):
      """
      Move to a free cell that is orthogonally adjacent to *target*.
      If the target cell itself is free we simply move onto it;
      otherwise we pick the first adjacent cell that is not blocked.
      """
      grid = state.grid
      tx, ty = target
      # candidate neighbour offsets (right, left, down, up)
      neighbours = [(tx + 1, ty), (tx - 1, ty), (tx, ty + 1), (tx, ty - 1)]
      # filter inside map bounds
      W, H = grid.shape[0], grid.shape[1]
      neighbours = [(x, y) for (x, y) in neighbours
                    if 0 <= x < W and 0 <= y < H]
      # pick the first free neighbour (no entity of any kind)
      for nx, ny in neighbours:
          if not grid[nx, ny].any():          # free cell
              return walk_to(state, (nx, ny))
      # fallback – just walk to the target itself (may be blocked,
      # but this is a best‑effort simple planner)
      return walk_to(state, target)

  # ------------------------------------------------------------------
  # Start planning
  # ------------------------------------------------------------------
  env.reset()                       # put the env in a fresh start state
  state = env._current_state        # internal CraftState object
  world = env.world                  # CraftWorld instance

  # ------------------------------------------------------------------
  # 1) Identify the goal index for ``stick`` and fetch its recipe.
  # ------------------------------------------------------------------
  stick_idx = world.cookbook.index["stick"]
  recipe = world.cookbook.recipes.get(stick_idx, {})

  # ``primitives_for`` returns only the primitive part of the recipe.
  # It is more convenient because it already expands intermediate
  # items into their primitive requirements.
  primitive_needs = world.cookbook.primitives_for(stick_idx)

  # ------------------------------------------------------------------
  # 2) Collect all required primitives.
  # ------------------------------------------------------------------
  plan = []

  for prim_idx, needed in primitive_needs.items():
      # locate all cells that contain this primitive
      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
      if len(locations) == 0:
          # primitive not present – nothing we can do, skip it
          continue
      # pick the first occurrence (simple heuristic)
      prim_pos = tuple(locations[0][:2])

      # move next to the primitive
      plan += go_adjacent(state, prim_pos)

      # face the primitive (the agent is now on an adjacent cell)
      face_act = direction_to(state.pos, prim_pos)
      plan.append(face_act)
      _, state = env.step(face_act)   # turn to face

      # pick it up the required number of times
      for _ in range(needed):
          plan.append(USE)
          _, state = env.step(USE)

  # ------------------------------------------------------------------
  # 3) Craft the stick at its workshop.
  # ------------------------------------------------------------------
  # The workshop name is stored under the special key "_at" in the
  # original recipe dictionary.
  workshop_name = recipe.get("_at")
  if workshop_name is not None:
      workshop_idx = world.cookbook.index[workshop_name]
      # locate a workshop cell
      ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)
      if len(ws_locs) > 0:
          ws_pos = tuple(ws_locs[0][:2])
          plan += go_adjacent(state, ws_pos)

          # face the workshop
          face_act = direction_to(state.pos, ws_pos)
          plan.append(face_act)
          _, state = env.step(face_act)

          # finally, use the workshop to craft the stick
          plan.append(USE)
          _, state = env.step(USE)

  # ------------------------------------------------------------------
  # Return the accumulated action list.
  # ------------------------------------------------------------------
  return plan


