import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that will allow the agent to craft a stick in the given CraftWorld environment.
  The function determines the required primitive(s) for a stick from the recipe, navigates to collect them,
  moves to the appropriate workshop, and executes the craft action.

  Args:
      env: An instance of CraftWorld or a compatible environment that provides access to the world,
           the current state, and methods to query recipes and perform actions.

  Returns:
      List[int]: A list of action indices (e.g., DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4) that the agent can
                 execute sequentially to obtain a stick.
  """
  # Helper constants for actions (consistent with CraftWorld's action mapping)
  ACTION_DOWN = 0
  ACTION_UP = 1
  ACTION_LEFT = 2
  ACTION_RIGHT = 3
  ACTION_USE = 4

  # ----------------------------------------------------------------------
  # 1. Identify the index of the 'stick' item and its recipe.
  # ----------------------------------------------------------------------
  # The environment should expose its world (CraftWorld) which holds a Cookbook.
  # The Cookbook maps item names to integer indices via its Index instance.
  world = getattr(env, "world", None) or getattr(env, "craft_world", None)
  if world is None:
      raise ValueError("Environment does not expose a 'world' or 'craft_world' attribute.")

  # Access the Cookbook to resolve names to indices.
  cookbook = world.cookbook

  # Resolve the index for the target item 'stick'.
  stick_idx = cookbook.index.index("stick")
  if stick_idx is None:
      raise ValueError("The recipe database does not contain an item named 'stick'.")

  # Retrieve the recipe for a stick (if any). A stick may be a primitive, in which case
  # the recipe dict will be empty.
  stick_recipe = cookbook.recipes.get(stick_idx, {})

  # Determine required ingredients.
  # If the recipe dict contains a special key "_at", it indicates the workshop index.
  # Other keys are ingredient indices with required counts.
  workshop_idx = stick_recipe.get("_at", None)
  ingredient_requirements = {k: v for k, v in stick_recipe.items() if k != "_at"}

  # ----------------------------------------------------------------------
  # 2. Determine which ingredients are primitives that must be collected.
  # ----------------------------------------------------------------------
  # The Cookbook maintains a set of primitive indices.
  primitives_set = cookbook.primitives

  # Separate ingredients into primitives (to collect) and crafted items (to craft first).
  primitive_ingredients = {}
  crafted_ingredients = {}
  for ing_idx, count in ingredient_requirements.items():
      if ing_idx in primitives_set:
          primitive_ingredients[ing_idx] = count
      else:
          crafted_ingredients[ing_idx] = count

  # If there are crafted sub‑ingredients, we would need to recursively gather them.
  # For the purpose of the basic stick recipe, we assume only primitives are needed.
  # A full implementation could recursively call the same planner for each sub‑item.

  # ----------------------------------------------------------------------
  # 3. Utility functions for navigation and interaction.
  # ----------------------------------------------------------------------
  def manhattan(a, b):
      """Return Manhattan distance between two (x, y) positions."""
      return abs(a[0] - b[0]) + abs(a[1] - b[1])

  def find_nearest(grid, kind_idx, start_pos):
      """
      Locate the nearest cell containing the specified kind (kind_idx) from start_pos.
      Returns the position (x, y) of that cell. If not found, returns None.
      """
      height, width, _ = grid.shape
      # Simple BFS over grid positions.
      visited = set()
      queue = collections.deque()
      queue.append((start_pos, 0))
      visited.add(start_pos)

      while queue:
          (x, y), _ = queue.popleft()
          # Check if this cell has the desired kind.
          if grid[x, y, kind_idx] > 0:
              return (x, y)

          # Explore 4‑connected neighbours.
          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
              nx, ny = x + dx, y + dy
              if 0 <= nx < height and 0 <= ny < width and (nx, ny) not in visited:
                  visited.add((nx, ny))
                  queue.append(((nx, ny), 0))
      return None

  def plan_path(start, goal):
      """
      Generate a simple Manhattan‑based path from start to goal.
      Returns a list of movement actions (DOWN, UP, LEFT, RIGHT) to follow.
      This does not consider obstacles; it assumes a clear path or that the
      environment will handle collisions gracefully (e.g., by staying put).
      """
      actions = []
      x, y = start
      gx, gy = goal

      # Move vertically first.
      while x < gx:
          actions.append(ACTION_DOWN)
          x += 1
      while x > gx:
          actions.append(ACTION_UP)
          x -= 1

      # Then move horizontally.
      while y < gy:
          actions.append(ACTION_RIGHT)
          y += 1
      while y > gy:
          actions.append(ACTION_LEFT)
          y -= 1

      return actions

  # ----------------------------------------------------------------------
  # 4. Gather required primitive items.
  # ----------------------------------------------------------------------
  # Start from the environment's initial position.
  # The environment should provide a method to retrieve the current state.
  state = env.reset() if hasattr(env, "reset") else env.current_state()
  # The state dict may contain a 'features' or 'grid' entry.
  # We need the raw grid array.
  if isinstance(state, dict) and "grid" in state:
      grid = state["grid"]
  elif hasattr(state, "grid"):
      grid = state.grid
  else:
      raise ValueError("Unable to obtain the grid from the environment's initial state.")

  # The initial agent position.
  if isinstance(state, dict) and "pos" in state:
      agent_pos = tuple(state["pos"])
  elif hasattr(state, "pos"):
      agent_pos = state.pos
  else:
      raise ValueError("Unable to obtain the agent's starting position from the state.")

  # List to accumulate the final action sequence.
  action_plan = []

  # For each primitive ingredient, locate and collect the required count.
  for prim_idx, needed_qty in primitive_ingredients.items():
      collected = 0
      while collected < needed_qty:
          # Find nearest instance of the primitive.
          target_pos = find_nearest(grid, prim_idx, agent_pos)
          if target_pos is None:
              raise RuntimeError(f"Could not locate primitive with index {prim_idx} on the grid.")

          # Plan movement to the target cell.
          movement_actions = plan_path(agent_pos, target_pos)
          action_plan.extend(movement_actions)

          # After moving, the agent should be adjacent (or on) the target cell.
          # In CraftWorld, the USE action interacts with the cell directly in front
          # of the agent based on its current facing direction. For simplicity we
          # assume the agent faces the target cell after the last movement.
          # We'll append a USE action to pick up the primitive.
          action_plan.append(ACTION_USE)

          # Update the simulated position (we assume movements succeeded).
          agent_pos = target_pos

          # Update the simulated grid and inventory to reflect the pickup.
          # This is a lightweight simulation; we simply decrement the grid count.
          grid[agent_pos[0], agent_pos[1], prim_idx] -= 1
          # Increment inventory count (if tracking, not strictly needed for planning).
          # Advance collected count.
          collected += 1

  # ----------------------------------------------------------------------
  # 5. Move to the appropriate workshop (if required) and craft the stick.
  # ----------------------------------------------------------------------
  if workshop_idx is not None:
      # Locate a workshop cell of the required type.
      workshop_pos = find_nearest(grid, workshop_idx, agent_pos)
      if workshop_pos is None:
          raise RuntimeError(f"Required workshop with index {workshop_idx} not found on the grid.")

      # Plan path to the workshop.
      movement_to_workshop = plan_path(agent_pos, workshop_pos)
      action_plan.extend(movement_to_workshop)

      # Update position to workshop location.
      agent_pos = workshop_pos

  # Finally, perform the crafting action.
  # In CraftWorld, the USE action at a workshop triggers crafting of the
  # currently held ingredients into the target item.
  action_plan.append(ACTION_USE)

  # Return the computed sequence of actions.
  return action_plan


