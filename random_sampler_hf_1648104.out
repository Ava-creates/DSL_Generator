import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that will collect the required primitives
  for a stick and craft it at the appropriate workshop.

  The implementation is generic and works for any CraftWorld environment
  that follows the schema described in the prompt. It:
    1. Looks up the integer index for the item named ``"stick"``.
    2. Retrieves the primitive requirements for one stick via
       ``world.cookbook.primitives_for``.
    3. For each required primitive it finds the nearest cell that contains
       that primitive and generates Manhattan‑movement actions to reach it,
       followed by a ``USE`` action to pick it up.
    4. After all primitives are collected it moves to the workshop specified
       by the recipe (the ``"_at"`` entry) and performs a final ``USE`` to
       craft the stick.

  The function returns the list of action indices; it does **not** execute
  them.  It assumes that the action constants are defined in the ``craft``
  module (e.g. ``craft.DOWN``, ``craft.UP``, ``craft.LEFT``, ``craft.RIGHT``,
  ``craft.USE``).  If any of the required entities are missing from the grid,
  the planner simply skips them – the returned plan will still be a valid
  list of actions, albeit possibly incomplete.

  Args:
      env: An instance of ``CraftLab`` (or any wrapper that exposes the same
           attributes used below).  The function accesses ``env.world``,
           ``env._current_state`` and the ``craft`` module for action
           constants.

  Returns:
      List[int]: A list of action indices that, when executed in order,
                 should result in the agent possessing at least one stick.
  """
  import numpy as np
  from craft import craft  # action constants

  # ----------------------------------------------------------------------
  # Helper: Manhattan‑distance movement planner
  # ----------------------------------------------------------------------
  def plan_path(start, goal):
      """Yield a list of movement actions (DOWN/UP/RIGHT/LEFT) from start to goal."""
      actions = []
      cur = list(start)
      # vertical moves (row index)
      while cur[0] < goal[0]:
          actions.append(craft.DOWN)
          cur[0] += 1
      while cur[0] > goal[0]:
          actions.append(craft.UP)
          cur[0] -= 1
      # horizontal moves (col index)
      while cur[1] < goal[1]:
          actions.append(craft.RIGHT)
          cur[1] += 1
      while cur[1] > goal[1]:
          actions.append(craft.LEFT)
          cur[1] -= 1
      return actions, tuple(cur)

  # ----------------------------------------------------------------------
  # Access world, state and recipe information
  # ----------------------------------------------------------------------
  world = env.world
  state = env._current_state
  grid = state.grid  # shape (W, H, n_kinds)
  pos = state.pos    # (row, col)

  # Index of the target item "stick"
  try:
      stick_idx = world.cookbook.index["stick"]
  except Exception:
      # If the name is not present, we cannot plan; return empty plan.
      return []

  # Primitive requirements for a single stick (may be empty if stick is primitive)
  primitive_requirements = world.cookbook.primitives_for(stick_idx)

  plan = []  # accumulated action list

  # ----------------------------------------------------------------------
  # 1. Collect each required primitive the needed number of times
  # ----------------------------------------------------------------------
  for prim_idx, needed_cnt in primitive_requirements.items():
      for _ in range(needed_cnt):
          # Find all grid cells that currently contain the primitive
          locations = np.argwhere(grid[..., prim_idx] > 0)
          if locations.size == 0:
              # No instance on the map – skip (plan will be incomplete)
              continue
          # Choose the nearest location (Manhattan distance)
          dists = np.sum(np.abs(locations - np.array(pos)), axis=1)
          target_loc = locations[np.argmin(dists)]
          # Move to the primitive
          moves, pos = plan_path(pos, tuple(target_loc))
          plan.extend(moves)
          # Pick it up
          plan.append(craft.USE)

  # ----------------------------------------------------------------------
  # 2. Move to the workshop for the stick and craft it
  # ----------------------------------------------------------------------
  # The recipe dict contains an "_at" key that specifies the workshop kind
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_kind = recipe.get("_at", None)
  if workshop_kind is not None:
      # Locate all workshop cells of the required kind
      workshop_cells = np.argwhere(grid[..., workshop_kind] > 0)
      if workshop_cells.size > 0:
          dists = np.sum(np.abs(workshop_cells - np.array(pos)), axis=1)
          workshop_target = workshop_cells[np.argmin(dists)]
          moves, pos = plan_path(pos, tuple(workshop_target))
          plan.extend(moves)
          # Craft the stick
          plan.append(craft.USE)

  return plan


