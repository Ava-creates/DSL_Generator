      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a ``stick`` in a CraftWorld
  environment.

  The planner:
    1. Looks up the index of the ``stick`` item.
    2. Retrieves the primitive requirements for a stick.
    3. For each required primitive it:
       * finds a cell that contains the primitive,
       * moves the agent next to that cell,
       * uses the ``USE`` action to pick it up.
    4. Finds a workshop cell where a stick can be crafted,
       moves next to it and uses ``USE`` to craft the stick.

  The function returns the list of actions (integers) that can be fed to
  ``env.step``.  It works with the public API of the CraftWorld code base
  (index lookup, ``primitives_for`` and the ``next_to`` helper).

  Parameters
  ----------
  env : object
      A CraftLab (or compatible) environment instance.

  Returns
  -------
  list[int]
      Action sequence that, when executed, results in the agent possessing
      a ``stick`` in its inventory.
  """
  import numpy as np

  # --------------------------------------------------------------------- #
  # 1. Resolve the goal index (``stick``) and its recipe.
  # --------------------------------------------------------------------- #
  try:
      goal_idx = env.world.cookbook.index["stick"]
  except Exception:                 # stick not defined → nothing to do
      return []

  recipe = env.world.cookbook.recipes.get(goal_idx, {})

  # The workshop where the item must be crafted is stored under the
  # special key ``"_at"`` (or any key that starts with an underscore).
  workshop_kind = None
  if "_at" in recipe:
      wk_name = recipe["_at"]
      workshop_kind = env.world.cookbook.index.get(wk_name, None)
  else:                               # fallback: any key beginning with '_' ?
      for key, val in recipe.items():
          if isinstance(key, str) and key.startswith("_"):
              wk_name = val
              workshop_kind = env.world.cookbook.index.get(wk_name, None)
              break

  # --------------------------------------------------------------------- #
  # 2. Primitive requirements for a single stick.
  # --------------------------------------------------------------------- #
  prims = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}
  actions = []
  state = env._current_state   # current CraftState (private but accessible)

  # --------------------------------------------------------------------- #
  # Helper: move towards a target coordinate using Manhattan steps.
  # --------------------------------------------------------------------- #
  def move_towards(target):
      """Append actions that move the agent step‑by‑step towards *target*."""
      nonlocal actions, state
      while not state.next_to(target_kind):
          px, py = state.pos
          tx, ty = target
          # decide horizontal vs vertical step (simple Manhattan)
          if abs(tx - px) > abs(ty - py):
              act = 3 if tx > px else 2          # RIGHT or LEFT
          else:
              act = 0 if ty > py else 1          # DOWN or UP
          actions.append(act)
          # step the environment and refresh the state reference
          _, _, _ = env.step(act)
          state = env._current_state

  # --------------------------------------------------------------------- #
  # 3. Collect each required primitive.
  # --------------------------------------------------------------------- #
  for prim_idx, needed in prims.items():
      for _ in range(needed):
          # locate any cell that still contains the primitive
          prim_grid = state.grid[:, :, prim_idx]
          positions = np.argwhere(prim_grid > 0)
          if positions.size == 0:          # no more of this primitive on map
              return actions
          target_pos = positions[0]        # pick the first occurrence

          # Move next to the primitive and pick it up.
          target_kind = prim_idx
          while not state.next_to(target_kind):
              px, py = state.pos
              tx, ty = target_pos
              if abs(tx - px) > abs(ty - py):
                  act = 3 if tx > px else 2   # RIGHT / LEFT
              else:
                  act = 0 if ty > py else 1   # DOWN / UP
              actions.append(act)
              _, _, _ = env.step(act)
              state = env._current_state

          # Use action to collect the primitive.
          actions.append(4)                 # USE
          _, _, _ = env.step(4)
          state = env._current_state

  # --------------------------------------------------------------------- #
  # 4. Craft the stick at the appropriate workshop.
  # --------------------------------------------------------------------- #
  if workshop_kind is not None:
      wk_grid = state.grid[:, :, workshop_kind]
      wk_positions = np.argwhere(wk_grid > 0)
      if wk_positions.size > 0:
          wk_target = wk_positions[0]
          # Move next to the workshop.
          while not state.next_to(workshop_kind):
              px, py = state.pos
              tx, ty = wk_target
              if abs(tx - px) > abs(ty - py):
                  act = 3 if tx > px else 2
              else:
                  act = 0 if ty > py else 1
              actions.append(act)
              _, _, _ = env.step(act)
              state = env._current_state

          # Use action to craft the stick.
          actions.append(4)                 # USE
          _, _, _ = env.step(4)
          state = env._current_state

  return actions


