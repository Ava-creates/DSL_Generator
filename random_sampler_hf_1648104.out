import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that will make a stick in the given CraftLab
  environment. The planner works generically:
    1. Reset the environment.
    2. Determine the primitive resources required for a stick.
    3. Walk to each required primitive, pick it up.
    4. Walk to the appropriate workshop (if any) and craft the stick.

  Action indices follow the environment's specification:
      0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT, 4 – USE
  """
  # ------------------------------------------------------------------
  # Helper: simple Manhattan‑distance greedy movement
  # ------------------------------------------------------------------
  def move_towards(state, target):
      """Yield actions that move the agent from its current position
      to *target* (row, col) using a greedy Manhattan walk."""
      while tuple(state.pos) != tuple(target):
          dy = target[0] - state.pos[0]
          dx = target[1] - state.pos[1]
          if dy > 0:
              act = 0          # DOWN
          elif dy < 0:
              act = 1          # UP
          elif dx > 0:
              act = 3          # RIGHT
          elif dx < 0:
              act = 2          # LEFT
          else:
              break
          yield act
          _, new_state = state.step(act)
          state = new_state
      return state

  # ------------------------------------------------------------------
  # 1. Reset the environment and obtain the initial state
  # ------------------------------------------------------------------
  env.reset()
  state = env._current_state               # CraftState instance

  # ------------------------------------------------------------------
  # 2. Look up the index for the item "stick"
  # ------------------------------------------------------------------
  idx = env.world.cookbook.index
  stick_idx = idx["stick"]

  # ------------------------------------------------------------------
  # 3. Determine required primitives for one stick
  # ------------------------------------------------------------------
  # primitives_for returns a dict {primitive_idx: count}
  primitives_needed = env.world.cookbook.primitives_for(stick_idx)

  actions = []

  # ------------------------------------------------------------------
  # 4. Collect each required primitive
  # ------------------------------------------------------------------
  for prim_idx, count in primitives_needed.items():
      for _ in range(count):
          # locate all cells that currently contain the primitive
          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
          if len(locations) == 0:
              # No more primitives of this type – give up early
              return actions

          # choose the nearest one (Manhattan distance)
          dists = np.sum(np.abs(locations - np.array(state.pos)), axis=1)
          target = tuple(locations[dists.argmin()])

          # move to the primitive
          for act in move_towards(state, target):
              actions.append(act)
              _, new_state = state.step(act)
              state = new_state

          # pick it up (USE)
          actions.append(4)                  # USE
          _, new_state = state.step(4)
          state = new_state

  # ------------------------------------------------------------------
  # 5. Craft the stick at the required workshop (if any)
  # ------------------------------------------------------------------
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if workshop_name:
      workshop_idx = idx[workshop_name]

      # locate the nearest workshop cell
      locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)
      if len(locations) > 0:
          dists = np.sum(np.abs(locations - np.array(state.pos)), axis=1)
          target = tuple(locations[dists.argmin()])

          # move to the workshop
          for act in move_towards(state, target):
              actions.append(act)
              _, new_state = state.step(act)
              state = new_state

          # craft (USE)
          actions.append(4)                  # USE
          _, new_state = state.step(4)
          state = new_state

  # ------------------------------------------------------------------
  # Return the compiled action list
  # ------------------------------------------------------------------
  return actions


