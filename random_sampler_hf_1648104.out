import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  # Identify the primitive(s) required to craft a stick using the cookbook
  stick_idx = env.world.cookbook.index.index("stick")
  required = env.world.cookbook.primitives_for(stick_idx)

  # Gather actions to collect each required primitive
  actions = []
  for prim_idx, count in required.items():
      # Find the closest location of the primitive in the grid
      prim_name = env.world.cookbook.index.get(prim_idx)
      positions = np.argwhere(env._current_state.grid[:, :, prim_idx] > 0)
      if positions.size == 0:
          continue  # primitive not present, skip (unlikely in valid scenarios)

      # Choose the first found position (could be improved with pathfinding)
      target = tuple(positions[0])

      # Simple Manhattan movement towards the target
      while env._current_state.pos != target:
          cur_x, cur_y = env._current_state.pos
          tar_x, tar_y = target
          if cur_x < tar_x:
              actions.append(env.world.n_actions.DOWN)   # move down
              env.step(env.world.n_actions.DOWN)
          elif cur_x > tar_x:
              actions.append(env.world.n_actions.UP)     # move up
              env.step(env.world.n_actions.UP)
          elif cur_y < tar_y:
              actions.append(env.world.n_actions.RIGHT)  # move right
              env.step(env.world.n_actions.RIGHT)
          elif cur_y > tar_y:
              actions.append(env.world.n_actions.LEFT)   # move left
              env.step(env.world.n_actions.LEFT)

      # Once at the primitive location, use the action to pick it up
      for _ in range(count):
          actions.append(env.world.n_actions.USE)
          env.step(env.world.n_actions.USE)

  # After collecting all primitives, move to the workshop for sticks and craft
  stick_workshop_idx = env.world.cookbook.recipes[stick_idx]["_at"]
  workshop_name = env.world.cookbook.index.get(stick_workshop_idx)
  # Find workshop location
  workshop_positions = np.argwhere(env._current_state.grid[:, :, stick_workshop_idx] > 0)
  if workshop_positions.size > 0:
      workshop_target = tuple(workshop_positions[0])
      while env._current_state.pos != workshop_target:
          cur_x, cur_y = env._current_state.pos
          tar_x, tar_y = workshop_target
          if cur_x < tar_x:
              actions.append(env.world.n_actions.DOWN)
              env.step(env.world.n_actions.DOWN)
          elif cur_x > tar_x:
              actions.append(env.world.n_actions.UP)
              env.step(env.world.n_actions.UP)
          elif cur_y < tar_y:
              actions.append(env.world.n_actions.RIGHT)
              env.step(env.world.n_actions.RIGHT)
          elif cur_y > tar_y:
              actions.append(env.world.n_actions.LEFT)
              env.step(env.world.n_actions.LEFT)

  # Craft the stick
  actions.append(env.world.n_actions.USE)
  env.step(env.world.n_actions.USE)

  return actions


