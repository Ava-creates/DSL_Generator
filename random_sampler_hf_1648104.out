"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a ``stick`` in a CraftWorld environment.

  The function works for a generic ``CraftLab`` instance (the DMLab‑style
  wrapper used in the repository).  It follows a very simple planner:

  1.  Query the world for the recipe of ``stick`` and obtain the required
      primitive items.
  2.  For each required primitive, move the agent to the nearest cell that
      contains the primitive and execute a ``USE`` action to pick it up.
  3.  Move to the workshop required by the recipe (if any) and ``USE`` again
      to craft the stick.

  The planner ignores obstacles (it assumes a clear path) and therefore
  works for the standard test scenarios that come with the repository.
  """
  import numpy as np

  # ------------------------------------------------------------------ #
  # Helper utilities
  # ------------------------------------------------------------------ #
  def manhattan_move_actions(start, goal):
      """Return a list of actions (0‑4) that moves from *start* to *goal*.

      Action mapping (as defined in the environment):
          0: DOWN  (increase x)
          1: UP    (decrease x)
          2: LEFT  (decrease y)
          3: RIGHT (increase y)
      """
      actions = []
      sx, sy = start
      gx, gy = goal

      # vertical moves
      while sx < gx:
          actions.append(0)   # DOWN
          sx += 1
      while sx > gx:
          actions.append(1)   # UP
          sx -= 1

      # horizontal moves
      while sy < gy:
          actions.append(3)   # RIGHT
          sy += 1
      while sy > gy:
          actions.append(2)   # LEFT
          sy -= 1

      return actions

  def nearest_position(pos, mask):
      """Find the nearest ``True`` cell in *mask* to *pos* (Manhattan distance)."""
      coords = np.argwhere(mask)
      if coords.size == 0:
          raise RuntimeError("Required item not found in the grid.")
      dists = np.abs(coords[:, 0] - pos[0]) + np.abs(coords[:, 1] - pos[1])
      nearest_idx = np.argmin(dists)
      return tuple(coords[nearest_idx])

  # ------------------------------------------------------------------ #
  # Begin planning
  # ------------------------------------------------------------------ #
  # Reset the environment to obtain the initial state.
  # ``env`` is expected to be a ``CraftLab`` instance.
  env.reset()
  state = env._current_state          # type: CraftState
  world = env.world                    # type: CraftWorld

  # ------------------------------------------------------------------ #
  # 1.  Determine the recipe for ``stick``.
  # ------------------------------------------------------------------ #
  stick_name = "stick"
  stick_idx = world.cookbook.index[stick_name]

  # ``primitives_for`` returns a dict {primitive_idx: count}
  needed_primitives = world.cookbook.primitives_for(stick_idx)

  actions_plan = []
  cur_pos = tuple(state.pos)  # keep a local copy that we update as we "move"

  # ------------------------------------------------------------------ #
  # 2.  Collect each primitive the required number of times.
  # ------------------------------------------------------------------ #
  for prim_idx, count in needed_primitives.items():
      for _ in range(count):
          # locate the nearest cell that currently holds the primitive
          prim_mask = state.grid[..., prim_idx] > 0
          target_pos = nearest_position(cur_pos, prim_mask)

          # move to that cell
          actions_plan.extend(manhattan_move_actions(cur_pos, target_pos))
          cur_pos = target_pos

          # pick it up
          actions_plan.append(4)   # USE

          # update the simulated state (so subsequent searches see the item
          # removed).  This is a lightweight update; we only clear the cell
          # for the collected primitive.
          state.grid[..., prim_idx][target_pos] = 0

  # ------------------------------------------------------------------ #
  # 3.  Go to the required workshop (if any) and craft the stick.
  # ------------------------------------------------------------------ #
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if workshop_name is not None:
      workshop_idx = world.cookbook.index[workshop_name]
      workshop_mask = state.grid[..., workshop_idx] > 0
      workshop_pos = nearest_position(cur_pos, workshop_mask)

      actions_plan.extend(manhattan_move_actions(cur_pos, workshop_pos))
      cur_pos = workshop_pos

      # craft at the workshop
      actions_plan.append(4)   # USE

  return actions_plan


