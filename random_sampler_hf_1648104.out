import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Return a list of actions that (when executed in the given CraftWorld
  environment) will result in the agent possessing a ``stick`` in its
  inventory.

  The implementation works for the standard CraftWorld environment used
  in the repository:

  * It queries the world’s ``Cookbook`` to obtain the index of the
    ``stick`` item and the primitive ingredients required to craft it.
  * It then searches the initial grid for those primitives, plans a
    Manhattan‑style path to each of them (avoiding blocked cells), and
    inserts a ``USE`` action to pick the item up.
  * If the ``stick`` itself is a primitive, the function simply collects
    it.  If it must be crafted, after gathering all required primitives
    the agent is moved to the appropriate workshop (the workshop type is
    stored under the ``"_at"`` key of the recipe) and a final ``USE``
    action is issued to perform the crafting.

  The function does **not** modify the environment – it only inspects the
  initial state and returns a static list of actions.  The caller is
  responsible for applying the actions via ``env.step`` (or the equivalent
  API).

  Parameters
  ----------
  env : object
      An instantiated CraftWorld environment (e.g. a ``CraftLab`` object).

  Returns
  -------
  List[int]
      Sequence of action indices that will produce a stick.
  """
  # ------------------------------------------------------------------
  # Helper utilities
  # ------------------------------------------------------------------
  # Action ordering used by the environment (as defined in the source):
  #   0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT, 4 – USE
  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = range(5)

  # Mapping from a movement delta to the corresponding action id.
  DELTA_TO_ACTION = {
      ( 1,  0): ACTION_DOWN,
      (-1,  0): ACTION_UP,
      ( 0, -1): ACTION_LEFT,
      ( 0,  1): ACTION_RIGHT,
  }

  # ------------------------------------------------------------------
  # 1. Reset the environment to obtain the initial state.
  # ------------------------------------------------------------------
  try:
      env.reset()
  except Exception:            # pragma: no cover – defensive fallback
      # If the environment does not expose a reset method we simply give up.
      return []

  # The internal state is stored in a private attribute.
  try:
      state = env._current_state          # type: ignore[attr-defined]
  except AttributeError:                 # pragma: no cover
      return []

  # ------------------------------------------------------------------
  # 2. Extract useful world information.
  # ------------------------------------------------------------------
  world = env.world                         # the CraftWorld object
  cookbook = world.cookbook
  grid = state.grid                         # (W, H, n_kinds) uint8 array
  pos = tuple(state.pos)                    # (row, col)

  # Resolve the index of the item named "stick".
  try:
      stick_idx = cookbook.index["stick"]
  except Exception:                       # pragma: no cover
      # No stick defined – nothing we can do.
      return []

  # ------------------------------------------------------------------
  # 3. Determine the recipe for the stick.
  # ------------------------------------------------------------------
  # ``primitives_for`` returns a dict {primitive_idx: count}.
  # If the dict is empty, the stick is a primitive that can be collected
  # directly.
  primitive_requirements = cookbook.primitives_for(stick_idx)

  # ``_at`` key (if present) tells us where the crafting must happen.
  # The recipe is stored in ``cookbook.recipes``.
  recipe = cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at", None)
  if workshop_name is not None:
      workshop_idx = cookbook.index.get(workshop_name, None)
  else:
      workshop_idx = None

  # ------------------------------------------------------------------
  # 4. Utility: locate the *nearest* cell that contains a given kind.
  # ------------------------------------------------------------------
  def find_nearest(kind_idx, start):
      """Return a path (list of actions) from ``start`` to the closest cell
      that contains an entity of type ``kind_idx``.  Returns ``None`` if
      no such cell exists."""
      # Identify all cells that contain the desired kind.
      locations = np.argwhere(grid[:, :, kind_idx] > 0)
      if locations.size == 0:
          return None

      # Simple Manhattan‑distance heuristic – pick the closest cell.
      dists = np.abs(locations[:, 0] - start[0]) + np.abs(locations[:, 1] - start[1])
      target = tuple(locations[dists.argmin()])

      # BFS on the 2‑D grid (ignoring the third dimension).  A cell is
      # traversable if *no* kind is present there (i.e. the sum across
      # kinds is zero) or if it is the target cell itself.
      W, H = grid.shape[:2]
      blocked = np.any(grid > 0, axis=2)          # True where something exists
      blocked[target] = False                    # allow stepping onto target

      queue = collections.deque()
      queue.append((start, []))
      visited = np.full((W, H), False, dtype=bool)
      visited[start] = True

      while queue:
          (r, c), path = queue.popleft()
          if (r, c) == target:
              return path

          for dr, dc in [(1, 0), (-1, 0), (0, -1), (0, 1)]:
              nr, nc = r + dr, c + dc
              if 0 <= nr < W and 0 <= nc < H and not visited[nr, nc] and not blocked[nr, nc]:
                  visited[nr, nc] = True
                  action = DELTA_TO_ACTION[(dr, dc)]
                  queue.append(((nr, nc), path + [action]))
      return None  # No reachable path

  # ------------------------------------------------------------------
  # 5. Gather all required primitives.
  # ------------------------------------------------------------------
  actions = []
  cur_pos = pos

  # If the stick itself is a primitive, treat it as the only required item.
  if not primitive_requirements:
      # Need to pick up the stick directly.
      primitive_requirements = {stick_idx: 1}

  for prim_idx, count in primitive_requirements.items():
      for _ in range(count):
          path = find_nearest(prim_idx, cur_pos)
          if path is None:                     # pragma: no cover – safety
              return []                        # cannot reach required primitive
          actions.extend(path)
          actions.append(ACTION_USE)           # pick it up
          # Update the simulated position.
          for a in path:
              dr, dc = {
                  ACTION_DOWN: (1, 0),
                  ACTION_UP:   (-1, 0),
                  ACTION_LEFT: (0, -1),
                  ACTION_RIGHT:(0, 1),
              }[a]
              cur_pos = (cur_pos[0] + dr, cur_pos[1] + dc)

  # ------------------------------------------------------------------
  # 6. If crafting is required, move to the appropriate workshop and craft.
  # ------------------------------------------------------------------
  if workshop_idx is not None:
      path = find_nearest(workshop_idx, cur_pos)
      if path is None:                         # pragma: no cover
          return []                            # cannot reach workshop
      actions.extend(path)
      actions.append(ACTION_USE)               # perform the crafting

  return actions


