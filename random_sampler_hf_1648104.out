import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that will gather the required primitives and craft a stick.
  """
  # reset env
  obs = env.reset()
  # get scenario and world
  scenario = env.scenario
  world = scenario.world
  cookbook = world.cookbook
  # get index for stick
  try:
      stick_idx = cookbook.index["stick"]
  except Exception:
      # fallback: find any recipe that produces an item named containing 'stick'
      # iterate over index
      stick_idx = None
      for name, idx in cookbook.index.contents.items():
          if "stick" in name.lower():
              stick_idx = idx
              break
      if stick_idx is None:
          raise ValueError("Stick item not found in cookbook")
  # primitive requirements
  prim_req = cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}
  # initial grid and position
  grid = scenario.init_grid.copy()
  pos = scenario.init_pos
  actions = []
  # helper functions
  height, width, _ = grid.shape  # Actually shape (WIDTH, HEIGHT, n_kinds)
  # define move dirs
  DIRS = [(1,0), (-1,0), (0,-1), (0,1)]  # DOWN,UP,LEFT,RIGHT
  ACTIONS = [0,1,2,3]  # corresponding action ids
  def in_bounds(x,y):
      return 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]
  def is_empty(x,y):
      return not grid[x,y,:].any()
  from collections import deque
  def bfs(start, goal):
      """Return list of action ids to move from start to goal (both empty cells)."""
      q = deque()
      q.append(start)
      visited = {start: None}
      while q:
          cur = q.popleft()
          if cur == goal:
              break
          for (dx,dy), act in zip(DIRS, ACTIONS):
              nx, ny = cur[0]+dx, cur[1]+dy
              if in_bounds(nx,ny) and is_empty(nx,ny) and (nx,ny) not in visited:
                  visited[(nx,ny)] = (cur, act)
                  q.append((nx,ny))
      # reconstruct
      if goal not in visited:
          raise RuntimeError(f"Path not found from {start} to {goal}")
      path_actions = []
      cur = goal
      while visited[cur] is not None:
          prev, act = visited[cur]
          path_actions.append(act)
          cur = prev
      path_actions.reverse()
      return path_actions
  # collect primitives
  for prim_idx, needed in prim_req.items():
      # find all positions of this primitive
      prim_positions = np.argwhere(grid[:,:,prim_idx] > 0)
      # keep track of how many we have collected
      collected = 0
      while collected < needed:
          # choose nearest primitive that is still present
          best = None
          best_dist = None
          best_adj = None
          for (px,py) in prim_positions:
              if not grid[px,py,prim_idx]:
                  continue  # already taken
              # find an empty neighbor to stand on
              for (dx,dy) in DIRS:
                  nx, ny = px+dx, py+dy
                  if in_bounds(nx,ny) and is_empty(nx,ny):
                      dist = abs(nx-pos[0]) + abs(ny-pos[1])
                      if best_dist is None or dist < best_dist:
                          best = (px,py)
                          best_adj = (nx,ny)
                          best_dist = dist
              # if no neighbor, skip
          if best is None:
              raise RuntimeError("Cannot find reachable primitive")
          # move to adjacent cell
          actions += bfs(pos, best_adj)
          # after moving, update position
          pos = best_adj
          # use action to pick up
          actions.append(4)  # USE
          # simulate collection: remove from grid
          grid[best[0], best[1], prim_idx] = 0
          collected += 1
  # after collecting primitives, go to workshop for stick
  recipe = cookbook.recipes[stick_idx]
  workshop_idx = recipe["_at"]
  # find workshop positions
  workshop_positions = np.argwhere(grid[:,:,workshop_idx] > 0)
  # choose nearest reachable neighbor cell
  best = None
  best_dist = None
  best_adj = None
  for (wx,wy) in workshop_positions:
      for (dx,dy) in DIRS:
          nx, ny = wx+dx, wy+dy
          if in_bounds(nx,ny) and is_empty(nx,ny):
              dist = abs(nx-pos[0]) + abs(ny-pos[1])
              if best_dist is None or dist < best_dist:
                  best = (wx,wy)
                  best_adj = (nx,ny)
                  best_dist = dist
  if best_adj is None:
      raise RuntimeError("No reachable workshop")
  actions += bfs(pos, best_adj)
  pos = best_adj
  # craft stick
  actions.append(4)  # USE
  return actions


