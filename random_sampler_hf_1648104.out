"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that allows the agent to craft a ``stick`` in the
  given CraftWorld environment.

  The implementation follows a simple greedy plan:
    1.  Retrieve the recipe for ``stick`` from the world's cookbook.
    2.  For each required primitive, move to the nearest cell that contains the
        primitive, ``USE`` (pick it up) the needed amount and repeat.
    3.  After all primitives are collected, move to the workshop where a stick
        can be crafted (the workshop is stored in the recipe under the ``_at``
        key) and ``USE`` to craft the item.

  The returned list consists of action indices as defined by
  :class:`CraftLab` (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).

  Parameters
  ----------
  env : object
      An instance of :class:`CraftLab` (or any object that exposes the same
      attributes used below).  It must provide access to the underlying
      :class:`CraftWorld` via ``env.world`` and the current state via
      ``env._current_state`` (as used by the official DMLab wrapper).

  Returns
  -------
  list[int]
      A sequence of actions that, when executed in the environment, results
      in the agent possessing at least one ``stick``.
  """
  import numpy as np

  # --------------------------------------------------------------------- #
  # Helper to translate a movement from (x, y) to a list of actions.
  # --------------------------------------------------------------------- #
  def _move_actions(src, dst):
      """Return actions to move from src to dst using Manhattan steps."""
      sx, sy = src
      tx, ty = dst
      acts = []
      # X‑axis (RIGHT / LEFT)
      while sx < tx:
          acts.append(3)   # RIGHT
          sx += 1
      while sx > tx:
          acts.append(2)   # LEFT
          sx -= 1
      # Y‑axis (DOWN / UP)
      while sy < ty:
          acts.append(0)   # DOWN
          sy += 1
      while sy > ty:
          acts.append(1)   # UP
          sy -= 1
      return acts

  # --------------------------------------------------------------------- #
  # 1.  Identify the ``stick`` item and its recipe.
  # --------------------------------------------------------------------- #
  # ``index`` maps names → integer IDs.
  stick_name = "stick"
  try:
      stick_idx = env.world.cookbook.index[stick_name]
  except Exception as exc:
      raise RuntimeError(f"Could not find index for {stick_name!r}: {exc}")

  # Primitive requirements for one stick.
  primitive_needs = env.world.cookbook.primitives_for(stick_idx)

  # --------------------------------------------------------------------- #
  # 2.  Gather required primitives.
  # --------------------------------------------------------------------- #
  state = env._current_state          # the current CraftState
  grid = state.grid                    # (W, H, n_kinds) one‑hot occupancy
  cur_pos = state.pos                  # (x, y)

  actions = []

  for prim_idx, needed_cnt in primitive_needs.items():
      # Locate all cells that currently contain this primitive.
      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
      # Convert to list of (x, y) tuples.
      prim_locs = [(int(x), int(y)) for x, y in prim_cells]

      if not prim_locs:
          # No source of this primitive – we cannot continue.
          raise RuntimeError(f"No cells contain required primitive index {prim_idx}")

      # Sort locations by Manhattan distance from the current position.
      prim_locs.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))

      # Greedily pick the closest cells until we have enough of the primitive.
      collected = 0
      for loc in prim_locs:
          if collected >= needed_cnt:
              break
          # Move to the primitive.
          actions.extend(_move_actions(cur_pos, loc))
          cur_pos = loc
          # Pick it up.
          actions.append(4)          # USE
          collected += 1

      if collected < needed_cnt:
          raise RuntimeError(
              f"Could not collect enough of primitive {prim_idx} "
              f"(needed {needed_cnt}, got {collected})"
          )

  # --------------------------------------------------------------------- #
  # 3.  Move to the appropriate workshop and craft the stick.
  # --------------------------------------------------------------------- #
  # The workshop name is stored under the special ``_at`` key of the recipe.
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if not workshop_name:
      raise RuntimeError("Stick recipe does not specify a workshop (missing '_at')")

  # Resolve the workshop's integer ID.
  try:
      workshop_idx = env.world.cookbook.index[workshop_name]
  except Exception as exc:
      raise RuntimeError(f"Could not resolve workshop name {workshop_name!r}: {exc}")

  # Find workshop locations on the map.
  ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
  ws_locs = [(int(x), int(y)) for x, y in ws_cells]

  if not ws_locs:
      raise RuntimeError(f"No workshop of type {workshop_name!r} found on the map")

  # Choose the nearest workshop.
  ws_locs.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))
  target_ws = ws_locs[0]

  # Move to the workshop and use it to craft the stick.
  actions.extend(_move_actions(cur_pos, target_ws))
  actions.append(4)   # USE (craft)

  return actions


