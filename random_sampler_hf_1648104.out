"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will make a ``stick`` in the given
  CraftWorld environment.

  The function follows the recipe for ``stick``:
  1.  Determine which primitive items are required.
  2.  Locate each required primitive on the grid, move next to it and
      ``USE`` it to collect it.
  3.  Locate the workshop required for the final crafting step,
      move next to it and ``USE`` to craft the stick.

  The returned list can be fed directly to ``env.step(action)`` (or
  ``env.step(action, num_steps=1)``) to execute the plan.

  Parameters
  ----------
  env : CraftLab (or compatible) instance
      The environment that already contains a generated scenario.

  Returns
  -------
  list[int]
      Ordered action indices that, when executed, produce a stick.
  """
  import numpy as np

  # ------------------------------------------------------------------
  # Helper utilities
  # ------------------------------------------------------------------
  def _action_map():
      """Map action name → integer index using the env's spec."""
      specs = env.action_specs()
      return {name: idx for name, idx in specs.items()}

  ACTIONS = _action_map()
  # Basic movement directions (assumed ordering from the spec)
  MOVE_DOWN = ACTIONS["DOWN"]
  MOVE_UP = ACTIONS["UP"]
  MOVE_LEFT = ACTIONS["LEFT"]
  MOVE_RIGHT = ACTIONS["RIGHT"]
  ACTION_USE = ACTIONS["USE"]

  def _move_actions(cur, dest):
      """Greedy Manhattan moves from ``cur`` to ``dest``."""
      actions = []
      x, y = cur
      tx, ty = dest
      while x != tx:
          if tx > x:
              actions.append(MOVE_DOWN)
              x += 1
          else:
              actions.append(MOVE_UP)
              x -= 1
      while y != ty:
          if ty > y:
              actions.append(MOVE_RIGHT)
              y += 1
          else:
              actions.append(MOVE_LEFT)
              y -= 1
      return actions

  def _adjacent_free(cell, grid):
      """
      Return a free (non‑blocked) adjacent cell to ``cell``.
      Preference order: up, down, left, right.
      """
      x, y = cell
      w, h, _ = grid.shape
      candidates = [
          (x - 1, y),  # up
          (x + 1, y),  # down
          (x, y - 1),  # left
          (x, y + 1),  # right
      ]
      for nx, ny in candidates:
          if 0 <= nx < w and 0 <= ny < h:
              if grid[nx, ny].sum() == 0:          # empty cell
                  return (nx, ny)
      # If no empty neighbour, just return the original cell (the
      # planner will still try to move as close as possible).
      return cell

  # ------------------------------------------------------------------
  # 1. Identify the goal (stick) and its recipe.
  # ------------------------------------------------------------------
  cookbook = env.world.cookbook
  stick_idx = cookbook.index["stick"]
  # Primitive requirements for ONE stick (dict {primitive_idx: count})
  primitive_needs = cookbook.primitives_for(stick_idx)

  # ------------------------------------------------------------------
  # 2. Collect required primitives.
  # ------------------------------------------------------------------
  actions_plan = []
  state = env._current_state                # current CraftState
  grid = state.grid.copy()                  # (W, H, n_kinds)

  for prim_idx, needed_cnt in primitive_needs.items():
      while state.inventory[prim_idx] < needed_cnt:
          # locate a cell that still contains the primitive
          prim_locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if prim_locations.size == 0:
              raise RuntimeError(
                  f"Unable to find required primitive {cookbook.get(prim_idx, prim_idx)}"
              )
          # pick the first available location
          target_cell = tuple(prim_locations[0])

          # find a free adjacent cell to stand on
          stand_cell = _adjacent_free(target_cell, grid)

          # move from current position to the standing cell
          actions_plan.extend(_move_actions(state.pos, stand_cell))

          # after movement the agent will be facing the direction of the
          # last move; ensure we are facing the primitive before using.
          # Simple trick: move one step away (if possible) and step back.
          # This guarantees the facing direction points to the primitive.
          # We try to step away in any free direction.
          ax, ay = stand_cell
          # try to step away
          away = None
          for dx, dy, act in [(-1, 0, MOVE_UP), (1, 0, MOVE_DOWN),
                              (0, -1, MOVE_LEFT), (0, 1, MOVE_RIGHT)]:
              nx, ny = ax + dx, ay + dy
              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:
                  if grid[nx, ny].sum() == 0:
                      away = (nx, ny, act)
                      break
          if away is not None:
              # step away
              actions_plan.append(away[2])
              # step back (now facing the primitive)
              back_action = {
                  MOVE_UP: MOVE_DOWN,
                  MOVE_DOWN: MOVE_UP,
                  MOVE_LEFT: MOVE_RIGHT,
                  MOVE_RIGHT: MOVE_LEFT,
              }[away[2]]
              actions_plan.append(back_action)
          # finally use the primitive
          actions_plan.append(ACTION_USE)

          # ---------------------------------------------------------
          # Simulate the actions to keep ``state`` and ``grid`` in sync.
          # ---------------------------------------------------------
          for a in actions_plan[-(1 + (2 if away else 0) + 1):]:  # only the newly added ones
              reward, new_state = state.step(a)
              state = new_state
              grid = state.grid

  # ------------------------------------------------------------------
  # 3. Craft the stick at its required workshop.
  # ------------------------------------------------------------------
  # The recipe dict contains a special key "_at" that tells us the
  # workshop name.
  workshop_name = cookbook.recipes[stick_idx].get("_at")
  if workshop_name is None:
      raise RuntimeError("Stick recipe does not specify a workshop.")
  workshop_idx = cookbook.index[workshop_name]

  # locate any workshop cell
  ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
  if ws_locs.size == 0:
      raise RuntimeError(f"No workshop of type {workshop_name} found.")
  ws_cell = tuple(ws_locs[0])

  # stand next to the workshop
  stand_ws = _adjacent_free(ws_cell, grid)
  actions_plan.extend(_move_actions(state.pos, stand_ws))

  # ensure we are facing the workshop (same trick as above)
  ax, ay = stand_ws
  away = None
  for dx, dy, act in [(-1, 0, MOVE_UP), (1, 0, MOVE_DOWN),
                      (0, -1, MOVE_LEFT), (0, 1, MOVE_RIGHT)]:
      nx, ny = ax + dx, ay + dy
      if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:
          if grid[nx, ny].sum() == 0:
              away = (nx, ny, act)
              break
  if away is not None:
      actions_plan.append(away[2])
      back_action = {
          MOVE_UP: MOVE_DOWN,
          MOVE_DOWN: MOVE_UP,
          MOVE_LEFT: MOVE_RIGHT,
          MOVE_RIGHT: MOVE_LEFT,
      }[away[2]]
      actions_plan.append(back_action)

  # use workshop to craft the stick
  actions_plan.append(ACTION_USE)

  return actions_plan


