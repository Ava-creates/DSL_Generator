import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Simple planner that moves the agent to the nearest *stick* primitive (if it
  exists) and uses the ``USE`` action to pick it up.  The function works
  with both ``CraftLab`` and raw ``CraftWorld`` environments that expose the
  internal ``CraftState`` via ``env._current_state`` after a reset.

  The returned list of integer actions follows the action ordering used by
  ``CraftLab.action_specs()``:

      0 → DOWN
      1 → UP
      2 → LEFT
      3 → RIGHT
      4 → USE

  If a stick cannot be found (e.g. it is not a primitive or the recipe is
  missing) the function returns an empty action list.
  """
  # --------------------------------------------------------------------- #
  # 1. Reset the environment and obtain the current state object.
  # --------------------------------------------------------------------- #
  _ = env.reset()
  # ``CraftLab`` stores the state in a private attribute; ``CraftWorld`` can
  # be handled similarly because after a reset it also creates a
  # ``CraftState`` instance.
  state = getattr(env, "_current_state", None)
  if state is None:
      # Fallback for environments that directly expose the state.
      state = getattr(env, "state", None)
  if state is None:
      return []          # cannot proceed without a state object

  # --------------------------------------------------------------------- #
  # 2. Resolve the integer index for the item named "stick".
  # --------------------------------------------------------------------- #
  try:
      stick_idx = state.world.cookbook.index["stick"]
  except Exception:
      return []          # no such item in the index

  # If the stick is a primitive (i.e. can be collected directly) we can
  # attempt to locate it on the map.
  if stick_idx not in state.world.cookbook.primitives:
      # Non‑primitive items would require crafting logic which is beyond
      # the scope of this simple planner.
      return []

  # --------------------------------------------------------------------- #
  # 3. Locate the nearest cell that contains a stick primitive.
  # --------------------------------------------------------------------- #
  grid = state.grid[:, :, stick_idx]          # 2‑D occupancy of sticks
  stick_positions = list(zip(*np.where(grid > 0)))
  if not stick_positions:
      return []          # no sticks present on the map

  start = state.pos
  # Simple BFS over the 2‑D grid (ignoring the third dimension).  A cell is
  # traversable if *all* kinds have a zero count there (i.e. it is empty).
  height, width = grid.shape
  def is_free(x, y):
      # Any non‑zero entry in the full grid blocks movement.
      return not state.grid[x, y, :].any()

  # BFS queue stores (x, y, path) where path is a list of (dx, dy) moves.
  from collections import deque
  q = deque()
  visited = np.zeros((height, width), dtype=bool)
  q.append((start[0], start[1], []))
  visited[start[0], start[1]] = True

  target_path = None
  while q:
      x, y, path = q.popleft()
      if (x, y) in stick_positions:
          target_path = path
          break
      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:   # UP, DOWN, LEFT, RIGHT
          nx, ny = x + dx, y + dy
          if 0 <= nx < height and 0 <= ny < width and not visited[nx, ny]:
              if is_free(nx, ny) or (nx, ny) in stick_positions:
                  visited[nx, ny] = True
                  q.append((nx, ny, path + [(dx, dy)]))

  if target_path is None:
      return []          # no reachable stick found

  # --------------------------------------------------------------------- #
  # 4. Convert the path of (dx, dy) moves into the integer action IDs.
  # --------------------------------------------------------------------- #
  # Action mapping (consistent with CraftLab.action_specs):
  #   DOWN → 0  (dx = +1, dy = 0)
  #   UP   → 1  (dx = -1, dy = 0)
  #   LEFT → 2  (dx = 0, dy = -1)
  #   RIGHT→ 3  (dx = 0, dy = +1)
  move_to_action = {
      ( 1,  0): 0,   # DOWN
      (-1,  0): 1,   # UP
      ( 0, -1): 2,   # LEFT
      ( 0,  1): 3,   # RIGHT
  }

  actions = [move_to_action[(dx, dy)] for dx, dy in target_path]

  # After arriving on the stick cell we need to pick it up.
  actions.append(4)   # USE action

  return actions


