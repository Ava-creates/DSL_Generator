import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """Return a list of actions that makes a stick in the given CraftLab environment."""
  import numpy as np
  # reset environment to start a new episode
  env.reset()
  # get world and cookbook
  world = env.world
  # index of stick
  try:
      stick_idx = world.cookbook.index["stick"]
  except Exception:
      # fallback generic name
      stick_idx = None
  # get primitive requirements
  ingredients = {}
  if stick_idx is not None:
      ingredients = world.cookbook.primitives_for(stick_idx)
  # action list to return
  actions = []
  # maximum steps to avoid infinite loops
  max_steps = 2000
  steps = 0
  # helper to check if we can craft
  def can_craft(state):
      return all(state.inventory.get(i,0) >= cnt for i,cnt in ingredients.items())
  # main loop
  while steps < max_steps:
      state = env._current_state
      # goal achieved?
      if stick_idx is not None and state.inventory[stick_idx] > 0:
          break
      # if we have enough primitives, try to use (craft)
      if can_craft(state):
          # try to use (craft) if next to required workshop or just try USE
          act = 4  # USE
          reward, done, _ = env.step(act)
          actions.append(act)
          steps += 1
          continue
      # otherwise move randomly
      act = np.random.choice([0,1,2,3])  # DOWN,UP,LEFT,RIGHT
      reward, done, _ = env.step(act)
      actions.append(act)
      steps += 1
  return actions


