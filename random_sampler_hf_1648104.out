import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions to craft a stick in the given CraftWorld environment.
  The function determines the necessary primitives for a stick, navigates to them,
  collects them, and finally crafts the stick at the appropriate workshop.

  Args:
      env: An instance of CraftLab or similar environment providing the step and
           reset methods, and exposing the world and scenario attributes.

  Returns:
      List[int]: A list of action indices that, when executed in order, result in
                 having at least one stick in the agent's inventory.
  """
  # Helper functions --------------------------------------------------------
  def get_goal_index(goal_name="stick"):
      """Return the integer index for the given goal name using the world's cookbook."""
      return env.world.cookbook.index(goal_name)

  def required_primitives(goal_idx):
      """
      Return a dict mapping primitive indices to required counts for the given goal.
      Uses the cookbook's primitives_for method.
      """
      return env.world.cookbook.primitives_for(goal_idx)

  def find_nearest(target_idx):
      """
      Locate the nearest cell containing the specified entity index.
      Returns the (x, y) coordinate or None if not found.
      """
      grid = env._current_state.grid
      positions = np.argwhere(grid[:, :, target_idx] > 0)
      if positions.size == 0:
          return None
      # Compute Manhattan distances from current position
      cur_x, cur_y = env._current_state.pos
      dists = np.abs(positions[:, 0] - cur_x) + np.abs(positions[:, 1] - cur_y)
      nearest = positions[np.argmin(dists)]
      return tuple(nearest)

  def plan_path(start, goal):
      """
      Simple Manhattan path planner returning a list of actions (ints) to move from
      start to goal. Does not consider obstacles; assumes a clear path or that
      the environment permits movement through empty cells.
      """
      actions = []
      x, y = start
      gx, gy = goal
      # Horizontal moves
      while x < gx:
          actions.append(env.world.action_names["RIGHT"])
          x += 1
      while x > gx:
          actions.append(env.world.action_names["LEFT"])
          x -= 1
      # Vertical moves
      while y < gy:
          actions.append(env.world.action_names["DOWN"])
          y += 1
      while y > gy:
          actions.append(env.world.action_names["UP"])
          y -= 1
      return actions

  def collect_item(item_idx):
      """
      Navigate to the nearest instance of the given item index and perform a USE
      action to collect it. Returns the list of actions needed for this process.
      """
      actions = []
      # Find nearest target
      target_pos = find_nearest(item_idx)
      if target_pos is None:
          # Item not present on the map; cannot proceed
          return actions
      # Plan movement to adjacent cell (within 1 step of target)
      cur_pos = env._current_state.pos
      # Ensure we end up facing the item; we will move to a cell next to it
      # Prefer same row/col if possible
      # Choose a neighboring cell that is empty (no blockage)
      # Simplify: move directly onto the item cell, then USE
      path = plan_path(cur_pos, target_pos)
      actions.extend(path)
      # Use action to pick up / craft
      actions.append(env.world.action_names["USE"])
      return actions

  def craft_at_workshop(workshop_idx, goal_idx):
      """
      Move to the workshop required for the goal and perform USE to craft.
      Returns the action list for the movement and crafting.
      """
      actions = []
      workshop_pos = find_nearest(workshop_idx)
      if workshop_pos is None:
          return actions
      cur_pos = env._current_state.pos
      actions.extend(plan_path(cur_pos, workshop_pos))
      actions.append(env.world.action_names["USE"])
      return actions

  # Main logic ---------------------------------------------------------------
  # Reset environment to start fresh and obtain initial state
  obs = env.reset()
  state = env._current_state

  # Determine goal index for stick
  stick_idx = get_goal_index("stick")
  # Obtain required primitives for a stick
  primitives = required_primitives(stick_idx)

  # Action plan accumulator
  plan = []

  # Collect each required primitive in turn
  for prim_idx, count in primitives.items():
      for _ in range(count):
          plan.extend(collect_item(prim_idx))

  # Identify the workshop index for crafting a stick
  # The recipe dict contains a special key "_at" indicating workshop type
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if workshop_name is None:
      # If no workshop specified, assume current location works
      plan.append(env.world.action_names["USE"])
  else:
      workshop_idx = env.world.cookbook.index(workshop_name)
      plan.extend(craft_at_workshop(workshop_idx, stick_idx))

  return plan


