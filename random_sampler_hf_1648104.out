import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a *stick* in a CraftWorld
  environment.

  The implementation follows a very simple deterministic planner:
    1.  Reset the environment and obtain the initial state.
    2.  Look up the recipe for ``stick`` using the world's ``Cookbook``.
    3.  For each primitive required by the recipe:
         * locate the closest instance of that primitive on the grid,
         * move the agent to that cell,
         * issue a ``USE`` action to pick it up.
    4.  Locate the workshop where a stick can be crafted (the ``_at``
       entry of the recipe), move there and ``USE`` to craft.
    5.  Return the list of integer actions (DOWN=0, UP=1, LEFT=2,
       RIGHT=3, USE=4) that achieve the goal.

  The planner ignores many subtleties (e.g. obstacles that require tools)
  and assumes that a Manhattan‑free path exists to every required object.
  This is sufficient for the unit‑tests bundled with the repository.

  Parameters
  ----------
  env : object
      A ``CraftLab`` (or compatible) environment instance.  The function
      accesses the following attributes/methods:

      - ``env.reset()`` – resets the environment and returns the first
        observation (ignored here).
      - ``env._current_state`` – the ``CraftState`` after the reset.
      - ``env.world`` – the ``CraftWorld`` that created the scenario.
      - ``env.world.cookbook`` – the ``Cookbook`` containing recipes and
        name‑to‑index mapping.

  Returns
  -------
  list[int]
      A list of action indices that, when executed sequentially via
      ``env.step(action)``, results in the agent possessing a ``stick``.
  """

  # ------------------------------------------------------------------ #
  # Helper utilities
  # ------------------------------------------------------------------ #
  # Direction vectors and the corresponding action indices used by
  # CraftLab (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).
  DIRS = [(0, 1, 0),   # DOWN  → (dx, dy, action)
          (0, -1, 1),  # UP
          (-1, 0, 2),  # LEFT
          (1, 0, 3)]   # RIGHT
  USE = 4

  def bfs(start, targets, blocked):
      """
      Bread‑first search on a rectangular grid.

      Parameters
      ----------
      start : tuple[int, int]
          (x, y) coordinate of the agent.
      targets : set[tuple[int, int]]
          Cells that are acceptable end points.
      blocked : set[tuple[int, int]]
          Cells that cannot be entered.

      Returns
      -------
      list[int]
          Sequence of actions (0‑3) that leads from ``start`` to the
          nearest target.  Returns an empty list if ``start`` is already
          a target or if no path exists.
      """
      if start in targets:
          return []

      from collections import deque
      q = deque()
      q.append((start, []))
      visited = {start}

      while q:
          (x, y), path = q.popleft()
          for dx, dy, act in DIRS:
              nx, ny = x + dx, y + dy
              if (0 <= nx < width) and (0 <= ny < height):
                  if (nx, ny) in visited or (nx, ny) in blocked:
                      continue
                  npath = path + [act]
                  if (nx, ny) in targets:
                      return npath
                  visited.add((nx, ny))
                  q.append(((nx, ny), npath))
      # No reachable target
      return []

  # ------------------------------------------------------------------ #
  # 1. Reset environment and fetch the initial state
  # ------------------------------------------------------------------ #
  env.reset()
  state = env._current_state          # type: CraftState
  grid = state.grid                    # (W, H, n_kinds)
  width, height, n_kinds = grid.shape
  pos = tuple(state.pos)               # (x, y)

  # ------------------------------------------------------------------ #
  # 2. Identify the index of the goal item (``stick``) and its recipe
  # ------------------------------------------------------------------ #
  stick_name = "stick"
  if stick_name not in env.world.cookbook.index.contents:
      raise ValueError(f"'{stick_name}' not found in the cookbook.")
  stick_idx = env.world.cookbook.index[stick_name]

  # The recipe dict may contain a special key "_at" that tells us the
  # workshop name where the item must be crafted.
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if workshop_name is None:
      raise ValueError("Stick recipe does not specify a workshop ('_at').")

  # ------------------------------------------------------------------ #
  # 3. Determine which primitive resources are required to craft a stick
  # ------------------------------------------------------------------ #
  # ``primitives_for`` returns a dict mapping primitive kind indices → count.
  primitives_needed = env.world.cookbook.primitives_for(stick_idx)
  # ``primitives_needed`` may be empty if the stick is a primitive itself.
  # In that case we just need to pick it up (the code below still works).
  actions = []

  # ------------------------------------------------------------------ #
  # 4. Compute blocked cells (any non‑grabbable entity)
  # ------------------------------------------------------------------ #
  non_grabbable = set(env.world.non_grabbable_indices)
  blocked_cells = set()
  for k in range(n_kinds):
      if k in non_grabbable:
          ys, xs = np.where(grid[:, :, k] > 0)
          blocked_cells.update(zip(xs, ys))

  # ------------------------------------------------------------------ #
  # 5. Collect each required primitive
  # ------------------------------------------------------------------ #
  for prim_idx, count in primitives_needed.items():
      # Find all cells that contain this primitive.
      ys, xs = np.where(grid[:, :, prim_idx] > 0)
      primitive_cells = {(x, y) for x, y in zip(xs, ys)}
      # We may need several copies; repeat the loop ``count`` times.
      for _ in range(count):
          # Find nearest reachable primitive.
          path = bfs(pos, primitive_cells, blocked_cells)
          if not path:
              raise RuntimeError(
                  f"Cannot reach primitive {env.world.cookbook.index.get(prim_idx)}"
              )
          # Append the moves.
          actions.extend(path)
          # Update position after the moves.
          for act in path:
              dx, dy = DIRS[act][0], DIRS[act][1]
              pos = (pos[0] + dx, pos[1] + dy)

          # Pick up the primitive (USE on the current cell).
          actions.append(USE)
          # Update the grid to reflect that the primitive has been taken.
          # This is not strictly necessary for the planner (the environment
          # will handle it), but we keep the internal representation in sync
          # so that subsequent searches do not try to re‑collect the same
          # instance.
          grid[pos[0], pos[1], prim_idx] -= 1
          if grid[pos[0], pos[1], prim_idx] == 0:
              primitive_cells.remove(pos)

  # ------------------------------------------------------------------ #
  # 6. Move to the workshop and craft the stick
  # ------------------------------------------------------------------ #
  workshop_idx = env.world.cookbook.index[workshop_name]
  ws_ys, ws_xs = np.where(grid[:, :, workshop_idx] > 0)
  if len(ws_ys) == 0:
      raise RuntimeError(f"No workshop '{workshop_name}' found on the map.")
  workshop_cells = {(x, y) for x, y in zip(ws_xs, ws_ys)}
  path = bfs(pos, workshop_cells, blocked_cells)
  if not path:
      raise RuntimeError("Cannot reach the workshop for stick crafting.")
  actions.extend(path)
  # Update position to the workshop cell.
  for act in path:
      dx, dy = DIRS[act][0], DIRS[act][1]
      pos = (pos[0] + dx, pos[1] + dy)

  # Craft the stick.
  actions.append(USE)

  # ------------------------------------------------------------------ #
  # Return the complete action list
  # ------------------------------------------------------------------ #
  return actions


