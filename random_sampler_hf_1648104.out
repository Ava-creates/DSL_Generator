import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a sequence of actions to complete the task of making a stick 
  in the given CraftWorld environment. It determines the required 
  primitives from the recipe for 'stick', gathers them, and then 
  crafts the stick at the appropriate workshop.

  Args:
      env: An instance of CraftLab or CraftWorld environment.

  Returns:
      List[int]: A list of action indices the agent can execute to 
      complete the task of making a stick.
  """
  # Obtain the world and scenario from the environment
  world = env.world if hasattr(env, 'world') else env.scenario.world
  scenario = env.scenario if hasattr(env, 'scenario') else env

  # Get the index for the stick item
  stick_idx = world.cookbook.index.index('stick')
  if stick_idx is None:
      raise ValueError("Stick not defined in the cookbook.")

  # Determine the recipe for a stick
  recipe = world.cookbook.recipes.get(stick_idx, {})
  if not recipe:
      raise ValueError("No recipe found for stick.")

  # Identify the workshop where the stick must be crafted
  workshop_idx = recipe.get('_at')
  if workshop_idx is None:
      raise ValueError("Crafting location for stick not specified in recipe.")

  # Determine required primitive items and their counts
  primitive_requirements = {k: v for k, v in recipe.items() if k != '_at'}

  # Helper to find nearest cell containing a given kind
  def find_nearest(kind_idx, start_pos):
      # Simple BFS to locate nearest cell with the required kind
      from collections import deque
      visited = set()
      q = deque([(start_pos, [])])
      while q:
          (x, y), path = q.popleft()
          if (x, y) in visited:
              continue
          visited.add((x, y))
          if scenario.grid[x, y, kind_idx] > 0:
              return path
          # explore neighbors (4-dir)
          for a, (dx, dy) in enumerate([(0, -1), (0, 1), (-1, 0), (1, 0)]):
              nx, ny = x + dx, y + dy
              if 0 <= nx < scenario.grid.shape[0] and 0 <= ny < scenario.grid.shape[1]:
                  q.append(((nx, ny), path + [a]))
      return None

  # Helper to move along a path of actions
  def follow_path(path):
      actions = []
      for a in path:
          actions.append(a)      # move action
          actions.append(4)      # USE to interact with cell after moving
      return actions

  # Start at the initial position
  current_pos = scenario.init_pos
  actions_plan = []

  # Gather each primitive requirement
  for prim_idx, count in primitive_requirements.items():
      for _ in range(count):
          # Find nearest primitive
          path_to_prim = find_nearest(prim_idx, current_pos)
          if path_to_prim is None:
              raise RuntimeError("Required primitive not reachable.")
          # Move to primitive and pick it up
          actions_plan.extend(follow_path(path_to_prim))
          # Update current position after moves
          for move in path_to_prim:
              dx, dy = [(0, -1), (0, 1), (-1, 0), (1, 0)][move]
              current_pos = (current_pos[0] + dx, current_pos[1] + dy)

  # Move to the workshop for crafting stick
  path_to_workshop = find_nearest(workshop_idx, current_pos)
  if path_to_workshop is None:
      raise RuntimeError("Workshop for crafting stick not reachable.")
  actions_plan.extend(follow_path(path_to_workshop))

  # Finally, execute USE at the workshop to craft the stick
  actions_plan.append(4)  # USE action to craft

  return actions_plan


