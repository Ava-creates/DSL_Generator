import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  # Try to get goal index
  try:
      goal_idx = env.world.cookbook.index["stick"]
  except Exception:
      return []
  # get required primitives
  primitives = env.world.cookbook.primitives_for(goal_idx)
  actions = []
  # simple policy: loop over primitives, try to move towards any cell containing that kind
  # We'll use a naive BFS on the grid to find nearest cell with that kind.
  from collections import deque

  def find_nearest(state, kind):
      grid = state.grid
      h, w, _ = grid.shape
      visited = np.full((h, w), False)
      q = deque()
      q.append((state.pos, []))
      visited[state.pos] = True
      while q:
          (x, y), path = q.popleft()
          if grid[x, y, kind] > 0:
              return path
          for a, (dx, dy) in enumerate([(0,1),(0,-1),(1,0),(-1,0)]):  # RIGHT, LEFT, DOWN, UP?
              nx, ny = x+dx, y+dy
              if 0 <= nx < h and 0 <= ny < w and not visited[nx, ny]:
                  visited[nx, ny] = True
                  q.append(((nx, ny), path+[a]))
      return None

  # reset env to get initial state
  obs = env.reset()
  state = env._current_state if hasattr(env, "_current_state") else None
  if state is None:
      return []
  for kind, cnt in primitives.items():
      for _ in range(cnt):
          path = find_nearest(state, kind)
          if path is None:
              continue
          for a in path:
              reward, done = env.step(a)
              state = env._current_state
              actions.append(a)
          # use action to pick up (USE)
          reward, done = env.step(env.world.craftlab.action_specs()["USE"] if hasattr(env.world, "craftlab") else 4)
          actions.append(4)
          state = env._current_state
  # finally craft stick at workshop
  # assume workshop index is in recipe under "_at"
  recipe = env.world.cookbook.recipes.get(goal_idx, {})
  workshop_kind = recipe.get("_at")
  if workshop_kind is not None:
      path = find_nearest(state, workshop_kind)
      if path:
          for a in path:
              reward, done = env.step(a)
              actions.append(a)
              state = env._current_state
          # use to craft
          reward, done = env.step(4)
          actions.append(4)
  return actions


