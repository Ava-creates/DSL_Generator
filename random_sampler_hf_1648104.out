import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that would allow the agent to craft a *stick*.

  The function follows a very simple (and safe) strategy:
  1. Identify the index of the ``stick`` item using the world's cookbook.
  2. Query the cookbook for the primitive resources required to craft a stick.
  3. For each required primitive, locate the nearest cell that contains it.
     (If the primitive cannot be found, the function simply skips it.)
  4. Move the agent towards that cell using Manhattan moves (UP/DOWN/LEFT/RIGHT)
     and issue a ``USE`` action to pick up the primitive.
  5. Once all required primitives have been collected, move to a workshop that
     can craft the stick (the workshop type is stored in the recipe under the
     ``_at`` key) and issue a final ``USE`` action to perform the crafting.

  Because the exact layout of the grid and the positions of primitives /
  workshops are environment‑specific, the implementation performs a
  breadth‑first search on the current grid to find the shortest path to each
  target.  The returned list contains integer action IDs that match the
  ``CraftLab`` action specification (0‑DOWN, 1‑UP, 2‑LEFT, 3‑RIGHT, 4‑USE).

  If any step fails (e.g., a required primitive is not present), the function
  simply returns the actions accumulated up to that point.  This makes the
  implementation robust and ensures it always returns a valid list of actions.

  Parameters
  ----------
  env : CraftLab
      The environment instance providing access to the world, current state,
      and action space.

  Returns
  -------
  List[int]
      A list of action indices that, when executed sequentially in the
      environment, will result in the agent possessing at least one ``stick``.
  """
  # ----------------------------------------------------------------------
  # Helper functions
  # ----------------------------------------------------------------------
  def bfs(start, target_kind):
      """Breadth‑first search returning a list of actions to reach a cell
      containing ``target_kind``.  Returns None if unreachable."""
      from collections import deque

      # Directions: (dy, dx, action_id)
      dirs = [(-1, 0, 1), (1, 0, 0), (0, -1, 2), (0, 1, 3)]

      visited = set()
      queue = deque()
      queue.append((start, []))
      visited.add(start)

      while queue:
          (y, x), actions = queue.popleft()
          # Check current cell for the target kind
          if state.grid[y, x, target_kind] > 0:
              return actions
          # Expand neighbours
          for dy, dx, act in dirs:
              ny, nx = y + dy, x + dx
              if 0 <= ny < state.grid.shape[0] and 0 <= nx < state.grid.shape[1]:
                  if (ny, nx) not in visited:
                      # cell must be traversable (no non‑grabbable entity)
                      blocked = any(
                          state.grid[ny, nx, idx] > 0
                          for idx in env.world.non_grabbable_indices
                      )
                      if not blocked:
                          visited.add((ny, nx))
                          queue.append(((ny, nx), actions + [act]))
      return None

  # ----------------------------------------------------------------------
  # Main logic
  # ----------------------------------------------------------------------
  actions = []

  # Current state object
  state = env._current_state

  # 1. Identify the index for "stick"
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except KeyError:
      # No stick defined in the cookbook – nothing to do.
      return actions

  # 2. Determine required primitives for a stick
  prim_dict = env.world.cookbook.primitives_for(stick_idx)

  # 3. Gather each primitive
  for prim_idx, count in prim_dict.items():
      for _ in range(count):
          # Find path to the nearest cell containing this primitive
          path = bfs(state.pos, prim_idx)
          if path is None:
              # Primitive not reachable – abort further collection
              return actions
          actions.extend(path)
          # Use action to pick up the primitive
          actions.append(4)  # USE
          # Simulate the steps locally to keep ``state`` in sync
          for a in path:
              state = state.step(a)[1]  # ignore reward
          state = state.step(4)[1]

  # 4. Move to the appropriate workshop (if any)
  workshop_kind = None
  # The recipe may contain an "_at" entry specifying the workshop type
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")
  if workshop_name:
      workshop_kind = env.world.cookbook.index.get(workshop_name)
  if workshop_kind is not None:
      path = bfs(state.pos, workshop_kind)
      if path is not None:
          actions.extend(path)
          for a in path:
              state = state.step(a)[1]
          # Finally, craft the stick at the workshop
          actions.append(4)  # USE
          state = state.step(4)[1]

  return actions


