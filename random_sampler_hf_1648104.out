import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generates a list of actions that will (in principle) collect the required
  primitives for a ``stick`` and then craft it at the appropriate workshop.
  The implementation works with the standard CraftWorld / CraftLab objects
  used in the repository.

  The returned list only contains integer action IDs:
      0 – DOWN
      1 – UP
      2 – LEFT
      3 – RIGHT
      4 – USE
  """
  import numpy as np

  # ----------------------------------------------------------------------
  # Helper functions
  # ----------------------------------------------------------------------
  # map a unit delta to the corresponding action id
  _delta_to_action = {
      ( 1,  0): 0,   # DOWN
      (-1,  0): 1,   # UP
      ( 0, -1): 2,   # LEFT
      ( 0,  1): 3,   # RIGHT
  }

  def move_actions(cur, target):
      """Greedy Manhattan moves from cur -> target (both (x,y) tuples)."""
      actions = []
      cx, cy = cur
      tx, ty = target
      while cx != tx:
          step = 1 if cx < tx else -1
          act = _delta_to_action[(step, 0)]
          actions.append(act)
          cx += step
      while cy != ty:
          step = 1 if cy < ty else -1
          act = _delta_to_action[(0, step)]
          actions.append(act)
          cy += step
      return actions

  def find_adjacent_empty(pos, grid):
      """Return an empty neighbour (x,y) of ``pos`` or None."""
      x, y = pos
      h, w = grid.shape[0], grid.shape[1]
      for dx, dy in [( -1, 0), (1, 0), (0, -1), (0, 1)]:
          nx, ny = x + dx, y + dy
          if 0 <= nx < h and 0 <= ny < w:
              if not grid[nx, ny].any():          # no entity in the cell
                  return (nx, ny)
      return None

  # ----------------------------------------------------------------------
  # 1. Identify the stick recipe
  # ----------------------------------------------------------------------
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except Exception:
      # No stick defined – return empty plan.
      return []

  # primitives needed for one stick (dict {prim_idx: count})
  prim_req = env.world.cookbook.primitives_for(stick_idx)

  # ----------------------------------------------------------------------
  # 2. Gather primitives
  # ----------------------------------------------------------------------
  actions = []
  # we will keep track of the agent's simulated position
  cur_pos = tuple(env._current_state.pos)

  # copy of the grid so we can mark primitives as “taken” (avoid re‑using)
  grid = env._current_state.grid.copy()

  for prim_idx, needed in prim_req.items():
      # locate all cells that contain this primitive
      prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
      if prim_cells.size == 0:
          # primitive not present – we cannot complete the plan
          return actions
      # simple greedy: take the first ``needed`` cells (could be improved)
      taken = 0
      used_cells = set()
      for cell in prim_cells:
          if taken >= needed:
              break
          tx, ty = int(cell[0]), int(cell[1])
          if (tx, ty) in used_cells:
              continue
          # find an empty neighbour to stand on
          stand = find_adjacent_empty((tx, ty), grid)
          if stand is None:
              # cannot reach this primitive – skip it
              continue
          # move to the standing position
          actions.extend(move_actions(cur_pos, stand))
          cur_pos = stand
          # set direction towards the primitive (by issuing a move in that
          # direction – it will fail because the cell is occupied but will
          # set the facing direction)
          dx, dy = tx - cur_pos[0], ty - cur_pos[1]
          dir_action = _delta_to_action.get((dx, dy))
          if dir_action is None:
              # something went wrong; skip this primitive
              continue
          actions.append(dir_action)   # face the primitive
          actions.append(4)            # USE to pick it up
          # mark the primitive as removed from the grid (so we don't pick it
          # again later)
          grid[tx, ty, prim_idx] = 0
          taken += 1
          used_cells.add((tx, ty))

  # ----------------------------------------------------------------------
  # 3. Go to the appropriate workshop and craft the stick
  # ----------------------------------------------------------------------
  # Determine which workshop the recipe requires.
  workshop_name = None
  try:
      workshop_entry = env.world.cookbook.recipes[stick_idx].get("_at")
      if isinstance(workshop_entry, str):
          workshop_name = workshop_entry
      elif isinstance(workshop_entry, int):
          # already an index
          workshop_name = env.world.cookbook.index.get(workshop_entry)
  except Exception:
      pass

  if workshop_name is None:
      # No workshop information – cannot craft.
      return actions

  try:
      workshop_idx = env.world.cookbook.index[workshop_name]
  except Exception:
      return actions

  # locate a workshop cell
  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
  if workshop_cells.size == 0:
      return actions
  wx, wy = map(int, workshop_cells[0])

  # stand on an empty neighbour of the workshop
  stand = find_adjacent_empty((wx, wy), grid)
  if stand is None:
      # fallback: try to stand on the workshop itself (some worlds allow it)
      stand = (wx, wy)

  actions.extend(move_actions(cur_pos, stand))
  cur_pos = stand

  # face the workshop and USE to craft
  dx, dy = wx - cur_pos[0], wy - cur_pos[1]
  dir_action = _delta_to_action.get((dx, dy))
  if dir_action is not None:
      actions.append(dir_action)
      actions.append(4)   # USE -> craft the stick

  return actions


