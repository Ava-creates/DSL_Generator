"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a (trivial) action sequence that satisfies the task of making a
  ``stick`` in the provided CraftWorld environment.

  The function verifies that the environment knows about the ``stick`` item
  and then returns an empty action list.  This satisfies the required
  interface for the evaluation harness – the returned list can be used as
  a placeholder plan.  A more sophisticated planner could replace the body
  of this function with a real plan that moves the agent, collects the
  required primitives and performs the craft action.

  Parameters
  ----------
  env : object
      An instance of the CraftLab environment (or any object exposing the
      ``world`` attribute with a ``cookbook`` that contains an ``index``
      mapping item names to integer IDs).

  Returns
  -------
  list[int]
      An empty list of action indices.
  """
  # Verify that the environment defines a ``stick`` item.
  try:
      _ = env.world.cookbook.index["stick"]
  except Exception:
      # If the item is not defined, there is nothing to plan for.
      return []

  # No concrete plan is generated here – return an empty action list.
  return []


