  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that enables the agent to craft a stick
  in the given CraftWorld environment.

  The implementation works generically with the CraftWorld API:
  - It extracts the index of the "stick" item from the world's cookbook.
  - It determines whether a stick is a primitive (directly collectible) or
    must be crafted from other primitives.
  - It plans simple Manhattan‑style paths to required resources and the
    appropriate workshop (if crafting is needed) while avoiding non‑grabbable
    obstacles.
  - It uses the environment's step semantics (0:DOWN, 1:UP, 2:LEFT,
    3:RIGHT, 4:USE) to move and interact.

  The returned list can be fed directly to ``env.step(action)`` in a loop.
  """
  import collections

  # ----------------------------------------------------------------------
  # Helper functions
  # ----------------------------------------------------------------------
  def get_stick_index():
      """Return the integer index of the stick item."""
      return env.world.cookbook.index["stick"]

  def is_primitive(item_idx):
      """True if the item has no recipe (i.e., is a primitive)."""
      return len(env.world.cookbook.primitives_for(item_idx)) == 0

  def get_primitives_needed(item_idx):
      """
      For a given item, return a dict mapping primitive indices to the
      required counts (as dictated by the recipe tree).
      """
      # Recursively expand the recipe tree.
      needed = collections.Counter()

      def _expand(goal_idx, mult=1):
          # If the goal is a primitive, just count it.
          if is_primitive(goal_idx):
              needed[goal_idx] += mult
              return
          # Otherwise, fetch its immediate ingredients.
          recipe = env.world.cookbook.recipes.get(goal_idx, {})
          for ing_idx, cnt in recipe.items():
              if ing_idx == "_at":
                  continue
              _expand(ing_idx, mult * cnt)

      _expand(item_idx)
      return needed

  def find_nearest(target_mask, start):
      """
      Bread‑first search for the nearest cell satisfying ``target_mask``.
      Returns a list of positions (including start) that leads to the goal,
      or None if unreachable.
      """
      H, W = env.world.cookbook.n_kinds, env.world.cookbook.n_kinds  # dummy, will be overwritten
      grid = env._current_state.grid
      height, width = grid.shape[0], grid.shape[1]

      visited = [[False] * width for _ in range(height)]
      prev = dict()  # (x, y) -> (px, py)

      q = collections.deque()
      q.append(start)
      visited[start[0]][start[1]] = True

      while q:
          x, y = q.popleft()
          if target_mask[x, y]:
              # reconstruct path
              path = []
              cur = (x, y)
              while cur != start:
                  path.append(cur)
                  cur = prev[cur]
              path.append(start)
              path.reverse()
              return path
          # explore 4‑neighbourhood
          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
              nx, ny = x + dx, y + dy
              if 0 <= nx < height and 0 <= ny < width and not visited[nx][ny]:
                  # cell must be traversable (no non‑grabbable entities)
                  blocked = False
                  for idx in env.world.non_grabbable_indices:
                      if grid[nx, ny, idx] > 0:
                          blocked = True
                          break
                  if not blocked:
                      visited[nx][ny] = True
                      prev[(nx, ny)] = (x, y)
                      q.append((nx, ny))
      return None

  def positions_to_actions(path):
      """
      Convert a list of positions (including the starting cell) into a list
      of movement actions (0‑4). The final cell is assumed to be the target;
      a USE action (4) can be appended by the caller if needed.
      """
      actions = []
      for (x0, y0), (x1, y1) in zip(path, path[1:]):
          if x1 == x0 + 1:
              actions.append(0)   # DOWN
          elif x1 == x0 - 1:
              actions.append(1)   # UP
          elif y1 == y0 - 1:
              actions.append(2)   # LEFT
          elif y1 == y0 + 1:
              actions.append(3)   # RIGHT
          else:
              raise ValueError("Non‑adjacent steps in path")
      return actions

  # ----------------------------------------------------------------------
  # Main planning logic
  # ----------------------------------------------------------------------
  stick_idx = get_stick_index()
  actions_plan = []

  # Determine if stick is a primitive or needs crafting
  if is_primitive(stick_idx):
      # Simple collect‑and‑use scenario
      # Find any cell that contains a stick primitive
      grid = env._current_state.grid
      stick_mask = grid[:, :, stick_idx] > 0
      start_pos = env._current_state.pos
      path = find_nearest(stick_mask, start_pos)
      if path is None:
          raise RuntimeError("No stick primitive found in the world.")
      actions_plan.extend(positions_to_actions(path))
      # Use action to pick up the stick (or craft if needed)
      actions_plan.append(4)  # USE
  else:
      # Crafting scenario:
      # 1. Determine required primitives
      primitives_needed = get_primitives_needed(stick_idx)

      # 2. Collect each required primitive (ignoring multiplicities for simplicity)
      for prim_idx, count in primitives_needed.items():
          for _ in range(count):
              grid = env._current_state.grid
              prim_mask = grid[:, :, prim_idx] > 0
              start_pos = env._current_state.pos
              path = find_nearest(prim_mask, start_pos)
              if path is None:
                  raise RuntimeError(f"Required primitive {prim_idx} not found.")
              actions_plan.extend(positions_to_actions(path))
              actions_plan.append(4)  # USE to pick up the primitive

      # 3. Move to the appropriate workshop for stick crafting
      # The recipe dict contains a special key "_at" indicating the workshop index.
      workshop_idx = env.world.cookbook.recipes[stick_idx].get("_at")
      if workshop_idx is None:
          raise RuntimeError("Stick recipe missing workshop information.")
      grid = env._current_state.grid
      workshop_mask = grid[:, :, workshop_idx] > 0
      start_pos = env._current_state.pos
      path = find_nearest(workshop_mask, start_pos)
      if path is None:
          raise RuntimeError("No workshop for stick found.")
      actions_plan.extend(positions_to_actions(path))
      # 4. Use action at the workshop to craft the stick
      actions_plan.append(4)  # USE

  return actions_plan


