## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that will make a ``stick`` in the given
  CraftWorld environment.

  The implementation follows a very simple planner:

  1.  Reset the environment to obtain the initial state and the goal
      index (the index of the item that has to be crafted – ``stick``).
  2.  Query the world’s ``Cookbook`` for the primitive resources required
      to craft the goal.
  3.  For each required primitive, move the agent to the nearest cell that
      contains that primitive and execute the ``USE`` action to pick it up.
  4.  After all primitives are collected, move the agent to a workshop that
      can craft the goal (the workshop type is stored in the recipe under the
      ``_at`` key) and execute ``USE`` once more to craft the ``stick``.
  5.  Return the accumulated list of actions.

  The planner uses a breadth‑first search (BFS) on the static occupancy map
  to compute a shortest path between two cells.  It assumes the standard
  action ordering used by ``CraftLab``:

  * 0 – DOWN  (y + 1)
  * 1 – UP    (y – 1)
  * 2 – LEFT  (x – 1)
  * 3 – RIGHT (x + 1)
  * 4 – USE   (interact with the cell in front)

  The function does **not** attempt any sophisticated obstacle handling
  (e.g. using tools to clear trees) – it works for environments where the
  required primitives are reachable through empty cells.

  Parameters
  ----------
  env : CraftLab
      An instantiated CraftLab environment (already created but not yet
      reset).

  Returns
  -------
  List[int]
      A list of action indices that, when applied sequentially with
      ``env.step``, will result in the agent possessing at least one ``stick``.
  """
  import numpy as np
  from collections import deque

  # --------------------------------------------------------------------- #
  # Helper functions
  # --------------------------------------------------------------------- #
  def occupancy(grid):
      """Boolean array: True where any entity occupies the cell."""
      return grid.sum(axis=2) > 0

  def bfs(start, targets, occ):
      """
      Bread‑first search on the grid.

      Parameters
      ----------
      start : tuple (x, y)
      targets : set of (x, y) tuples – any of these is an acceptable goal.
      occ : 2‑D boolean array – True for blocked cells.

      Returns
      -------
      List[tuple] – list of positions from start (excluded) to the goal
      (included).  Empty list if no path is found.
      """
      W, H = occ.shape
      q = deque()
      q.append((start, []))
      visited = set()
      visited.add(start)

      while q:
          (x, y), path = q.popleft()
          if (x, y) in targets:
              return path  # path leads to the target, not including start

          for dx, dy, act in [ (0, -1, 1),   # UP
                               (0,  1, 0),   # DOWN
                               (-1, 0, 2),   # LEFT
                               (1,  0, 3) ]: # RIGHT
              nx, ny = x + dx, y + dy
              if 0 <= nx < W and 0 <= ny < H and not occ[nx, ny] and (nx, ny) not in visited:
                  visited.add((nx, ny))
                  q.append(((nx, ny), path + [act]))
      return []  # no path found

  # --------------------------------------------------------------------- #
  # Begin planning
  # --------------------------------------------------------------------- #
  # Reset the environment – this also creates the initial CraftState.
  obs = env.reset()
  state = env._current_state          # type: CraftState
  grid = state.grid.copy()            # (W, H, n_kinds)
  pos = state.pos                      # (x, y)

  # Goal index (the item we need to craft)
  goal_idx = env.task.goal

  # --------------------------------------------------------------------- #
  # Determine which primitives are needed and where to craft
  # --------------------------------------------------------------------- #
  # Mapping primitive_kind_idx -> required count
  primitives_needed = env.world.cookbook.primitives_for(goal_idx)

  # Workshop kind for this recipe (stored under the special key "_at")
  recipe = env.world.cookbook.recipes.get(goal_idx, {})
  workshop_kind = recipe.get("_at", None)

  # --------------------------------------------------------------------- #
  # Action list that will be returned
  # --------------------------------------------------------------------- #
  actions = []

  # --------------------------------------------------------------------- #
  # Helper to move to a target cell and update internal bookkeeping
  # --------------------------------------------------------------------- #
  def move_to(target):
      """Append actions that move the agent from its current position to target."""
      nonlocal pos, grid
      occ = occupancy(grid)
      path = bfs(pos, {target}, occ)
      actions.extend(path)
      # Simulate the moves locally so that subsequent planning uses the new position.
      for act in path:
          if act == 0:   # DOWN
              pos = (pos[0], pos[1] + 1)
          elif act == 1: # UP
              pos = (pos[0], pos[1] - 1)
          elif act == 2: # LEFT
              pos = (pos[0] - 1, pos[1])
          elif act == 3: # RIGHT
              pos = (pos[0] + 1, pos[1])

  # --------------------------------------------------------------------- #
  # Collect each required primitive
  # --------------------------------------------------------------------- #
  for prim_idx, needed_cnt in primitives_needed.items():
      while state.inventory[prim_idx] < needed_cnt:
          # Find all cells that currently contain the primitive
          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)
          if prim_cells.size == 0:
              # No more of this primitive on the map – abort planning.
              break
          # Choose the closest one (Manhattan distance)
          distances = np.abs(prim_cells[:, 0] - pos[0]) + np.abs(prim_cells[:, 1] - pos[1])
          closest = prim_cells[distances.argmin()]
          target = (int(closest[0]), int(closest[1]))

          # Move to the primitive cell
          move_to(target)

          # Use the primitive (action 4)
          actions.append(4)               # USE
          # Update local grid/inventory to reflect the pickup
          grid[target[0], target[1], prim_idx] = 0
          state.inventory[prim_idx] += 1

  # --------------------------------------------------------------------- #
  # Move to the appropriate workshop and craft the goal
  # --------------------------------------------------------------------- #
  if workshop_kind is not None:
      # Find any workshop cell (they are static)
      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
      if workshop_cells.size > 0:
          # Choose the closest workshop
          distances = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])
          closest_ws = workshop_cells[distances.argmin()]
          ws_target = (int(closest_ws[0]), int(closest_ws[1]))
          move_to(ws_target)

          # Craft the item
          actions.append(4)   # USE at the workshop

  # Return the compiled action list
  return actions


