"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a sequence of actions to complete the task of making a stick
  in the given CraftWorld environment. This implementation works for
  any version (v0, v1, v2) by dynamically extracting the recipe for a
  stick, locating the required primitives, moving to them, picking them
  up, and finally crafting the stick at the appropriate workshop.

  Args:
      env: An instance of CraftLab (or a similar wrapper) that provides
          `reset()` and `step(action)` methods. The environment must be
          reset before calling this function.

  Returns:
      List[int]: A list of action indices (DOWN=0, UP=1, LEFT=2,
      RIGHT=3, USE=4) that, when executed sequentially, will result in
      the agent having at least one stick in its inventory.
  """
  # Helper constants for actions
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

  # ------------------------------------------------------------------
  # Utility functions
  # ------------------------------------------------------------------
  def manhattan(a, b):
      """Manhattan distance between two (x, y) tuples."""
      return abs(a[0] - b[0]) + abs(a[1] - b[1])

  def direction_to(src, dst):
      """Return the action needed to move from src towards dst (one step)."""
      sx, sy = src
      dx, dy = dst
      if sx < dx:
          return DOWN
      if sx > dx:
          return UP
      if sy < dy:
          return RIGHT
      if sy > dy:
          return LEFT
      raise ValueError("Source and destination are the same")

  def shortest_path(grid, start, targets, blocked_kinds):
      """
      BFS to find the shortest path from start to any cell in targets.
      Returns a list of positions (including start) or None if unreachable.
      """
      from collections import deque
      H, W, _ = grid.shape
      visited = np.full((H, W), False, dtype=bool)
      q = deque()
      q.append((start, [start]))
      visited[start] = True
      while q:
          pos, path = q.popleft()
          if pos in targets:
              return path
          x, y = pos
          for nx, ny, act in [(x-1, y, UP), (x+1, y, DOWN),
                              (x, y-1, LEFT), (x, y+1, RIGHT)]:
              if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:
                  # cell is blocked if any non-zero entity belongs to blocked_kinds
                  cell_kinds = np.where(grid[nx, ny] > 0)[0]
                  if any(k in blocked_kinds for k in cell_kinds):
                      continue
                  visited[nx, ny] = True
                  q.append(((nx, ny), path + [(nx, ny)]))
      return None

  # ------------------------------------------------------------------
  # Reset environment and extract world information
  # ------------------------------------------------------------------
  obs = env.reset()
  state = env._current_state  # Access underlying CraftState
  world = state.world          # CraftWorld instance

  # Mapping from kind index to name (inverse of Index)
  idx_to_name = {i: name for name, i in world.cookbook.index.contents.items()}

  # ------------------------------------------------------------------
  # Identify the recipe for "stick"
  # ------------------------------------------------------------------
  # First, find the index of the stick item
  stick_name = "stick"
  if stick_name not in world.cookbook.index.contents:
      raise ValueError("Stick item not defined in the recipe file")
  stick_idx = world.cookbook.index[stick_name]

  # Retrieve the primitive requirements for a stick
  stick_prims = world.cookbook.primitives_for(stick_idx)  # dict {prim_idx: count}
  if not stick_prims:
      # If there is no recipe, the stick must be a primitive itself
      # In that case, just go collect it directly.
      stick_prims = {stick_idx: 1}
      stick_idx = None  # No crafting needed

  # ------------------------------------------------------------------
  # Locate all entities of interest on the grid
  # ------------------------------------------------------------------
  grid = state.grid.copy()
  H, W, _ = grid.shape

  # Positions of each primitive kind
  prim_positions = {}
  for prim_idx in stick_prims:
      positions = [(i, j) for i in range(H) for j in range(W)
                   if grid[i, j, prim_idx] > 0]
      if not positions:
          raise RuntimeError(f"Required primitive {idx_to_name[prim_idx]} not found on grid")
      prim_positions[prim_idx] = positions

  # Positions of workshops (where crafting must occur)
  workshop_positions = {}
  # Recipes specify a special key "_at" indicating the workshop kind
  # Retrieve the workshop kind for the stick recipe
  stick_recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_kind_name = stick_recipe.get("_at")
  if workshop_kind_name:
      workshop_idx = world.cookbook.index[workshop_kind_name]
      workshop_positions = [(i, j) for i in range(H) for j in range(W)
                            if grid[i, j, workshop_idx] > 0]
      if not workshop_positions:
          raise RuntimeError(f"Workshop {workshop_kind_name} not found on grid")
  else:
      # No specific workshop required; we can craft anywhere
      workshop_positions = None

  # ------------------------------------------------------------------
  # Determine blocked kinds (entities that cannot be traversed)
  # ------------------------------------------------------------------
  # Non-grabbable entities are obstacles (e.g., trees, water)
  blocked_kinds = set(world.non_grabbable_indices)

  # ------------------------------------------------------------------
  # Planning: simple greedy approach
  # ------------------------------------------------------------------
  actions = []
  cur_pos = state.pos

  # Helper to translate a path of positions into actions
  def path_to_actions(path):
      act_seq = []
      for a, b in zip(path, path[1:]):
          act_seq.append(direction_to(a, b))
      return act_seq

  # 1. Collect each required primitive (in any order)
  for prim_idx, needed in stick_prims.items():
      # We may need multiple copies of the same primitive
      while needed > 0:
          # Find nearest available primitive of this kind
          nearest = None
          nearest_path = None
          min_dist = float('inf')
          for pos in prim_positions[prim_idx]:
              if grid[pos[0], pos[1], prim_idx] == 0:
                  continue  # already taken
              path = shortest_path(grid, cur_pos, {pos}, blocked_kinds)
              if path is None:
                  continue
              d = len(path)
              if d < min_dist:
                  min_dist = d
                  nearest = pos
                  nearest_path = path
          if nearest is None:
              raise RuntimeError(f"Cannot reach primitive {idx_to_name[prim_idx]}")
          # Move to the primitive
          actions.extend(path_to_actions(nearest_path))
          cur_pos = nearest
          # Use action to pick it up (USE)
          actions.append(USE)
          # Update grid to reflect removal of the primitive
          grid[nearest[0], nearest[1], prim_idx] -= 1
          needed -= 1

  # 2. Move to a workshop (if required) and craft the stick
  if workshop_positions is not None:
      # Find nearest workshop
      path = shortest_path(grid, cur_pos, set(workshop_positions), blocked_kinds)
      if path is None:
          raise RuntimeError("Cannot reach required workshop")
      actions.extend(path_to_actions(path))
      cur_pos = path[-1]
  # Craft action (USE) at the workshop or current location
  actions.append(USE)

  # Return the compiled action list
  return actions


