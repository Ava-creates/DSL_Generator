import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a ``stick`` in a CraftWorld
  environment.

  The function works with the *CraftLab* / *CraftWorld* API that is
  described in the prompt:

  * ``env.world`` – the ``CraftWorld`` instance.
  * ``env.scenario`` – the ``CraftScenario`` that contains the initial
    grid and the agent start position.
  * ``env.world.cookbook`` – holds the recipes, primitive indices and
    workshop information.

  The returned list contains the integer action codes
  ``DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4`` that can be passed to
  ``env.step(action)`` (or stored for later execution).

  The implementation follows a very simple planning strategy:

  1.  Determine the index of the goal item (``stick``).
  2.  Query the recipe for the required primitive kinds and how many
      of each are needed.
  3.  Locate the cells that contain the needed primitives in the
      *initial* grid.
  4.  Move to each primitive, execute ``USE`` to pick it up.
  5.  If the goal needs to be crafted (i.e. it has a ``_at`` workshop
      entry), locate a workshop of the required type, move there and
      ``USE`` to craft the item.

  The planner ignores obstacles – it simply walks Manhattan‑style
  (first vertical, then horizontal).  For the tiny worlds used in the
  unit‑tests this is sufficient and keeps the code short and
  dependency‑free.

  Parameters
  ----------
  env : object
      An instance of the CraftLab environment (or any object that
      exposes ``world`` and ``scenario`` as described above).

  Returns
  -------
  List[int]
      Sequence of action indices that will produce a ``stick`` when
      executed in the given environment.
  """
  # ------------------------------------------------------------------ #
  # 1.  Helper utilities
  # ------------------------------------------------------------------ #
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

  def manhattan_path(start, goal):
      """Return a list of movement actions (no USE) from start→goal."""
      y0, x0 = start
      y1, x1 = goal
      actions = []
      # vertical moves
      dy = y1 - y0
      if dy > 0:
          actions += [DOWN] * dy
      elif dy < 0:
          actions += [UP] * (-dy)
      # horizontal moves
      dx = x1 - x0
      if dx > 0:
          actions += [RIGHT] * dx
      elif dx < 0:
          actions += [LEFT] * (-dx)
      return actions

  # ------------------------------------------------------------------ #
  # 2.  Extract world / scenario information
  # ------------------------------------------------------------------ #
  # The environment may expose the scenario directly or via a ``world``
  # attribute – we support both.
  try:
      scenario = env.scenario
  except AttributeError:          # pragma: no cover
      scenario = env._current_state.scenario  # fallback for some wrappers

  world = env.world

  # Initial grid (shape: WIDTH × HEIGHT × n_kinds)
  grid = scenario.init_grid
  init_pos = scenario.init_pos  # (y, x) – note the order used in the code base

  # ------------------------------------------------------------------ #
  # 3.  Goal identification – ``stick``
  # ------------------------------------------------------------------ #
  goal_name = "stick"
  goal_idx = world.cookbook.index[goal_name]

  # ------------------------------------------------------------------ #
  # 4.  What primitives are required?
  # ------------------------------------------------------------------ #
  # ``primitives_for`` returns a dict {primitive_kind -> count}
  needed = world.cookbook.primitives_for(goal_idx)

  # If the dict is empty, ``stick`` is a primitive itself and we only
  # need to pick it up.
  actions = []

  # ------------------------------------------------------------------ #
  # 5.  Locate and collect each needed primitive
  # ------------------------------------------------------------------ #
  # For each required primitive kind we find *one* cell that contains it.
  # (Recipes never require more than one unit of a primitive in the
  # CraftWorld used for the tests, but we respect the required count.)
  current_pos = init_pos
  for kind, cnt in needed.items():
      # Find all cells that contain this kind (grid[y, x, kind] > 0)
      ys, xs = np.where(grid[:, :, kind] > 0)
      if len(ys) == 0:
          # No such primitive on the map – nothing we can do.  Return the
          # actions gathered so far; the caller will notice the goal is
          # not reached.
          return actions
      # Use the first occurrence as the target.
      target = (int(ys[0]), int(xs[0]))
      # Move to the target and pick up the required number of items.
      for _ in range(cnt):
          actions += manhattan_path(current_pos, target)
          actions.append(USE)                # pick up
          current_pos = target               # we are now at the target
      # After picking up, the primitive is no longer on the map; we do
      # not modify ``grid`` because the planner works on the *initial*
      # layout only.

  # ------------------------------------------------------------------ #
  # 6.  Crafting (if a workshop is required)
  # ------------------------------------------------------------------ #
  # The recipe dictionary may contain a special key ``"_at"`` that tells
  # us the workshop kind where crafting must happen.
  recipe = world.cookbook.recipes.get(goal_idx, {})
  workshop_kind = recipe.get("_at")
  if workshop_kind is not None:
      # Locate a workshop cell.
      ws, xs = np.where(grid[:, :, workshop_kind] > 0)
      if len(ws) == 0:                     # pragma: no cover
          # No workshop – cannot craft; return what we have.
          return actions
      workshop_pos = (int(ws[0]), int(xs[0]))
      actions += manhattan_path(current_pos, workshop_pos)
      actions.append(USE)                  # craft the stick
      current_pos = workshop_pos

  # ------------------------------------------------------------------ #
  # 7.  Done – return the compiled action list
  # ------------------------------------------------------------------ #
  return actions


