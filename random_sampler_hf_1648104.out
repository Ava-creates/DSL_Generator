"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a sequence of actions that makes a stick in the given CraftLab
  environment. The algorithm is a very simple planner:
    1. Query the world recipe for ``stick`` to obtain the required primitive
       items and their counts.
    2. Repeatedly locate each needed primitive in the grid, move the agent
       to the cell, and ``USE`` (action 4) to pick it up.
    3. Locate the workshop required for the ``stick`` recipe, move the
       agent there and ``USE`` to craft the stick.

  The function works with the public API of ``CraftLab`` and the internal
  ``CraftState`` representation.  It assumes the following action encoding
  (as defined in ``CraftLab.action_specs``):

      0: DOWN   (y + 1)
      1: UP     (y - 1)
      2: LEFT   (x - 1)
      3: RIGHT  (x + 1)
      4: USE    (collect / craft)

  Parameters
  ----------
  env : CraftLab
      The environment instance (already reset).

  Returns
  -------
  List[int]
      A list of action indices that, when executed sequentially, will
      result in the agent possessing at least one ``stick``.
  """
  # ----------------------------------------------------------------------
  # Helper utilities
  # ----------------------------------------------------------------------
  def manhattan_step(pos, target):
      """Return a single movement action that brings ``pos`` one step closer
      to ``target`` (ignoring obstacles)."""
      x, y = pos
      tx, ty = target
      if x < tx:
          return 3      # RIGHT
      if x > tx:
          return 2      # LEFT
      if y < ty:
          return 0      # DOWN
      if y > ty:
          return 1      # UP
      # already at target – no movement needed
      return None

  def locate_item(grid, kind_idx):
      """Return the (x, y) coordinate of any cell that contains ``kind_idx``.
      If the item is not present, return None."""
      # grid shape: (WIDTH, HEIGHT, n_kinds)
      # we look for any non‑zero entry in the slice grid[:, :, kind_idx]
      locations = np.argwhere(grid[:, :, kind_idx] > 0)
      if locations.size == 0:
          return None
      # take the first found location
      return tuple(locations[0].tolist())

  # ----------------------------------------------------------------------
  # Access world/cookbook information
  # ----------------------------------------------------------------------
  world = env.world                      # CraftWorld instance
  state = env._current_state             # CraftState instance
  grid = state.grid.copy()               # current grid occupancy
  pos = tuple(state.pos)                 # (x, y) current position
  # ``stick`` name is fixed in the recipes; obtain its index
  stick_idx = world.cookbook.index["stick"]
  # primitives needed for a single stick (primitive_idx -> count)
  primitives = world.cookbook.primitives_for(stick_idx)

  actions = []  # the action sequence we will build

  # ----------------------------------------------------------------------
  # 1. Collect all required primitives
  # ----------------------------------------------------------------------
  for prim_idx, needed in primitives.items():
      # count how many of this primitive we have already
      have = int(state.inventory[prim_idx])
      while have < needed:
          # locate a cell that still contains the primitive
          target = locate_item(grid, prim_idx)
          if target is None:
              # No more of this primitive on the map – abort (cannot craft)
              raise RuntimeError("Required primitive not found on the grid.")
          # Move step‑by‑step towards the target
          while pos != target:
              act = manhattan_step(pos, target)
              if act is None:
                  break
              actions.append(act)
              # simulate the move to keep ``pos`` in sync with the actions
              if act == 0:   # DOWN
                  pos = (pos[0], pos[1] + 1)
              elif act == 1: # UP
                  pos = (pos[0], pos[1] - 1)
              elif act == 2: # LEFT
                  pos = (pos[0] - 1, pos[1])
              elif act == 3: # RIGHT
                  pos = (pos[0] + 1, pos[1])
              # NOTE: we do *not* update ``grid`` here – the environment will
              # do it when the action list is actually executed.
          # We are now adjacent (actually on) the primitive cell.
          # Use the item
          actions.append(4)      # USE
          # Update our internal bookkeeping
          have += 1
          state.inventory[prim_idx] += 1
          # Remove the primitive from our local copy of the grid so we do
          # not try to collect the same instance again.
          grid[target[0], target[1], prim_idx] = 0

  # ----------------------------------------------------------------------
  # 2. Go to the required workshop and craft the stick
  # ----------------------------------------------------------------------
  # The workshop kind is stored under the special key "_at" in the recipe.
  workshop_kind = world.cookbook.recipes[stick_idx]["_at"]
  workshop_pos = locate_item(grid, workshop_kind)
  if workshop_pos is None:
      raise RuntimeError("Workshop for stick not found on the grid.")
  # Move to the workshop
  while pos != workshop_pos:
      act = manhattan_step(pos, workshop_pos)
      if act is None:
          break
      actions.append(act)
      if act == 0:
          pos = (pos[0], pos[1] + 1)
      elif act == 1:
          pos = (pos[0], pos[1] - 1)
      elif act == 2:
          pos = (pos[0] - 1, pos[1])
      elif act == 3:
          pos = (pos[0] + 1, pos[1])
  # Craft the stick
  actions.append(4)  # USE at the workshop

  return actions


