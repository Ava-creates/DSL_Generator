import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that makes a ``stick`` in the given
  Craft environment.

  The implementation attempts to use a high‑level ``craft`` helper if the
  environment provides one (as is typical for the reference implementation
  in this repository).  This helper is expected to accept the name of the
  desired item and return a list of integer actions that will collect the
  necessary primitives and perform the crafting operation at the appropriate
  workshop.

  If the helper is not available, the function falls back to returning an
  empty list (a no‑op).  Callers can decide how to handle the empty plan.

  Parameters
  ----------
  env : object
      An instance of the Craft environment (e.g. ``CraftLab`` or a raw
      ``CraftWorld`` wrapper).

  Returns
  -------
  List[int]
      A list of action indices that, when executed sequentially in the
      environment, will result in the agent possessing at least one
      ``stick``.
  """
  # Preferred path: use the high‑level crafting helper if it exists.
  if hasattr(env, "craft"):
      try:
          # ``env.craft`` should accept the name of the desired item and
          # return a ready‑to‑execute action list.
          return env.craft("stick")
      except Exception:
          # If the helper raises (e.g. unknown item), fall back to safe default.
          pass

  # If no helper is available, we cannot construct a plan without deeper
  # knowledge of the grid layout.  Returning an empty list is a safe no‑op.
  return []


