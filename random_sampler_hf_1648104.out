## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that makes a ``stick`` in the given CraftWorld
  environment.  The implementation works for any environment that follows
  the API described in the prompt (CraftLab / CraftWorld).

  The algorithm:
      1.  Look up the recipe for ``stick`` in the world cookbook.
      2.  For each required primitive, repeatedly
          * locate the nearest instance of that primitive on the grid,
          * move to a free cell adjacent to it,
          * use the ``USE`` action to pick it up.
      3.  After all primitives are collected, move to the required workshop
          (as indicated by the ``_at`` field of the recipe) and ``USE`` to
          craft the stick.

  The function keeps the environment up‑to‑date by stepping through the
  actions as they are generated, so that subsequent planning steps see the
  correct agent position, direction and inventory.
  """
  import numpy as np
  from collections import deque

  # ----------------------------------------------------------------------
  # Helper: convert a delta (dx,dy) into the corresponding action constant
  # ----------------------------------------------------------------------
  def delta_to_action(dx, dy):
      if dx == 1:
          return env.RIGHT
      if dx == -1:
          return env.LEFT
      if dy == 1:
          return env.DOWN
      if dy == -1:
          return env.UP
      raise ValueError("Invalid delta for movement")

  # ----------------------------------------------------------------------
  # Helper: BFS that returns a list of movement actions taking the agent
  # from ``start`` to any free cell adjacent to ``target``.
  # ----------------------------------------------------------------------
  def bfs_to_adjacent(start, target, grid):
      H, W = grid.shape[:2]
      # cells that are blocked (any non‑zero entry)
      blocked = np.any(grid > 0, axis=2)

      # all possible adjacent positions (4‑neighbourhood)
      adjacents = []
      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
          ax, ay = target[0] + dx, target[1] + dy
          if 0 <= ax < H and 0 <= ay < W and not blocked[ax, ay]:
              adjacents.append((ax, ay))

      # If the agent is already on a valid adjacent cell, no movement needed
      if start in adjacents:
          return []

      # BFS
      q = deque([start])
      prev = {start: None}
      while q:
          cur = q.popleft()
          if cur in adjacents:
              # reconstruct path
              path = []
              while prev[cur] is not None:
                  p = prev[cur]
                  dx = cur[0] - p[0]
                  dy = cur[1] - p[1]
                  path.append(delta_to_action(dx, dy))
                  cur = p
              path.reverse()
              return path
          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
              nx, ny = cur[0] + dx, cur[1] + dy
              if 0 <= nx < H and 0 <= ny < W and not blocked[nx, ny]:
                  nxt = (nx, ny)
                  if nxt not in prev:
                      prev[nxt] = cur
                      q.append(nxt)
      raise RuntimeError("No path to target found")

  # ----------------------------------------------------------------------
  # Begin main planning
  # ----------------------------------------------------------------------
  actions = []

  # current state object (CraftLab keeps the latest state in _current_state)
  state = env._current_state

  # goal index for "stick"
  stick_idx = env.world.cookbook.index["stick"]
  # recipe dict for stick
  recipe = env.world.cookbook.recipes[stick_idx]

  # ------------------------------------------------------------------
  # 1. Collect all required primitives
  # ------------------------------------------------------------------
  # primitives_for returns a dict {primitive_idx: count}
  needed = env.world.cookbook.primitives_for(stick_idx)

  for prim_idx, required_cnt in needed.items():
      # keep collecting until we have enough of this primitive
      while state.inventory[prim_idx] < required_cnt:
          # locate any cell that currently contains the primitive
          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              raise RuntimeError(
                  f"Required primitive (index {prim_idx}) not present on grid"
              )
          # pick the closest one (Manhattan distance)
          cur_pos = np.array(state.pos)
          dists = np.sum(np.abs(locations - cur_pos), axis=1)
          target_cell = tuple(locations[dists.argmin()])

          # move to a free adjacent cell
          move_actions = bfs_to_adjacent(state.pos, target_cell, state.grid)
          for a in move_actions:
              actions.append(a)
              _, _, _ = env.step(a)          # update env/state
              state = env._current_state

          # now we are adjacent – use the primitive
          actions.append(env.USE)
          _, _, _ = env.step(env.USE)
          state = env._current_state

  # ------------------------------------------------------------------
  # 2. Go to the required workshop and craft the stick
  # ------------------------------------------------------------------
  workshop_name = recipe["_at"]
  workshop_idx = env.world.cookbook.index[workshop_name]

  # locate the workshop cell (there should be exactly one)
  wk_locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)
  if wk_locations.size == 0:
      raise RuntimeError(f"Workshop '{workshop_name}' not found on grid")
  workshop_cell = tuple(wk_locations[0])

  # move adjacent to workshop
  move_actions = bfs_to_adjacent(state.pos, workshop_cell, state.grid)
  for a in move_actions:
      actions.append(a)
      _, _, _ = env.step(a)
      state = env._current_state

  # use to craft the stick
  actions.append(env.USE)
  _, _, _ = env.step(env.USE)
  state = env._current_state

  # Return the complete action sequence
  return actions


