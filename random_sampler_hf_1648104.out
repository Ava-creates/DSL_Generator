"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """Return a list of actions that will result in the agent possessing a stick.

  The function first attempts to use the environment's built‑in planner. If the
  planner is unavailable or fails, it falls back to a simple heuristic:
  1. Query the world’s cookbook for the primitive ingredients required to craft a
     stick.
  2. For each required primitive, locate the nearest cell that contains it,
     navigate to that cell and issue a USE action to collect it.
  3. After all ingredients are in the inventory, locate the workshop where a
     stick can be crafted (the `_at` field of the recipe) and perform a USE
     action there to craft the stick.

  The returned list contains integer action codes compatible with the
  `CraftLab`/`CraftWorld` action space (0=DOWN,1=UP,2=LEFT,3=RIGHT,4=USE).
  """
  # try planner
  if hasattr(env, "plan"):
      try:
          plan = list(env.plan("stick"))
          if plan:
              return plan
      except Exception:
          pass

  # fallback simple planner
  # we need to access world components
  world = getattr(env, "world", None)
  if world is None:
      # cannot retrieve world, give up
      return []

  # obtain the cookbook and recipe for stick
  cookbook = getattr(world, "cookbook", None)
  if cookbook is None:
      return []

  # get index for stick name
  stick_idx = cookbook.index.get("stick")
  if stick_idx is None:
      # maybe alternative name
      return []

  # retrieve recipe dict
  recipe = cookbook.recipes.get(stick_idx, {})
  # ingredients are keys not starting with "_" (i.e. "_key")
  ingredients = {k: v for k, v in recipe.items() if not isinstance(k, str) or not k.startswith("_")}
  # if no ingredients, stick is primitive, just need to pick it up
  # else we need to collect them
  actions = []

  # helper to move to a target cell (x,y) from current pos using Manhattan moves
  def navigate(cur, target):
      x, y = cur
      tx, ty = target
      seq = []
      while x < tx:
          seq.append(3)  # RIGHT
          x += 1
      while x > tx:
          seq.append(2)  # LEFT
          x -= 1
      while y < ty:
          seq.append(0)  # DOWN (assuming y increases downwards)
          y += 1
      while y > ty:
          seq.append(1)  # UP
          y -= 1
      return seq

  # start from initial position
  state = env.reset()
  # env.reset may return observation dict; need to get underlying CraftState
  # Try to retrieve internal state
  if hasattr(env, "_current_state"):
      cur_state = env._current_state
  elif hasattr(env, "state"):
      cur_state = env.state
  else:
      # cannot access, give up
      return []

  pos = tuple(cur_state.pos)

  grid = cur_state.grid  # shape (W,H,n_kinds)

  # function to find nearest cell containing a given kind
  def find_nearest(kind_idx, start):
      W, H, _ = grid.shape
      visited = set()
      queue = collections.deque([(start, 0)])
      while queue:
          (x, y), d = queue.popleft()
          if (x, y) in visited:
              continue
          visited.add((x, y))
          if grid[x, y, kind_idx] > 0:
              return (x, y)
          # neighbours
          for nx, ny in ((x+1,y),(x-1,y),(x,y+1),(x,y-1)):
              if 0 <= nx < W and 0 <= ny < H:
                  queue.append(((nx, ny), d+1))
      return None

  # collect each ingredient
  for ing_idx, count in ingredients.items():
      for _ in range(count):
          target = find_nearest(ing_idx, pos)
          if target is None:
              # cannot find ingredient, abort
              return []
          actions += navigate(pos, target)
          actions.append(4)  # USE to pick up
          # simulate move to update position
          pos = target

  # after gathering, locate workshop for stick
  workshop_key = recipe.get("_at")
  if workshop_key is not None:
      # workshop_key is a string name of workshop entity
      workshop_idx = cookbook.index.get(workshop_key)
      if workshop_idx is not None:
          target = find_nearest(workshop_idx, pos)
          if target is not None:
              actions += navigate(pos, target)
              actions.append(4)  # USE to craft
              pos = target

  return actions


