import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will collect the required primitives for a
  ``stick`` and then craft it at the appropriate workshop.

  The implementation works with the standard CraftLab environment.  It
  extracts the index of the ``stick`` item from the world cookbook, determines
  the primitive requirements, finds the closest cells that contain those
  primitives, moves the agent to them using simple Manhattan moves, picks
  them up (``USE`` action), then moves to the required workshop and crafts
  the stick.

  Note: this implementation assumes there are no blocking obstacles between
  the agent and the target cells (the simple Manhattan planner will work for
  most generated scenarios).  It does not execute the actions – it only
  returns the action list for the caller to step through.
  """
  # ----------------------------------------------------------------------
  # Helper: simple Manhattan path (no obstacles) from start to goal.
  # ----------------------------------------------------------------------
  def manhattan_path(start, goal):
      """Return a list of actions (int) that moves from start to goal."""
      actions = []
      y, x = start
      gy, gx = goal
      # Down (+y) = 0, Up (-y) = 1, Left (-x) = 2, Right (+x) = 3
      while y < gy:
          actions.append(0)  # DOWN
          y += 1
      while y > gy:
          actions.append(1)  # UP
          y -= 1
      while x < gx:
          actions.append(3)  # RIGHT
          x += 1
      while x > gx:
          actions.append(2)  # LEFT
          x -= 1
      return actions

  # ----------------------------------------------------------------------
  # 1. Identify the index of the target item (``stick``) and its recipe.
  # ----------------------------------------------------------------------
  stick_name = "stick"
  stick_idx = env.world.cookbook.index[stick_name]          # integer ID
  # ``primitives_for`` returns a dict {primitive_idx: count}
  primitive_requirements = env.world.cookbook.primitives_for(stick_idx)

  # ----------------------------------------------------------------------
  # 2. Gather the current state to locate entities on the grid.
  # ----------------------------------------------------------------------
  state = env._current_state                               # current CraftState
  grid = state.grid                                         # (W, H, n_kinds)

  # ----------------------------------------------------------------------
  # 3. Collect each required primitive.
  # ----------------------------------------------------------------------
  actions = []
  cur_pos = state.pos                                      # (y, x)

  for prim_idx, needed in primitive_requirements.items():
      # Find all cells that currently contain this primitive.
      locations = np.argwhere(grid[:, :, prim_idx] > 0)
      if locations.size == 0:
          # No primitive of this type on the map – cannot complete task.
          continue
      # Simple strategy: repeatedly take the first available location.
      for _ in range(needed):
          # Refresh locations in case previous collection removed some.
          locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              break
          target = tuple(locations[0])                     # (y, x)

          # Move to the primitive.
          actions.extend(manhattan_path(cur_pos, target))
          cur_pos = target

          # Pick it up.
          actions.append(4)                               # USE
          # Update our mental copy of the grid so we don't try to pick the
          # same item again.
          grid[target[0], target[1], prim_idx] = 0

  # ----------------------------------------------------------------------
  # 4. Move to the required workshop and craft the stick.
  # ----------------------------------------------------------------------
  # The workshop index is stored under the special key "_at" in the recipe.
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  workshop_idx = recipe.get("_at", None)

  if workshop_idx is not None:
      # Locate any workshop of this type.
      workshop_locs = np.argwhere(grid[:, :, workshop_idx] > 0)
      if workshop_locs.size > 0:
          workshop_pos = tuple(workshop_locs[0])          # (y, x)

          # Move to the workshop.
          actions.extend(manhattan_path(cur_pos, workshop_pos))
          cur_pos = workshop_pos

          # Craft the stick.
          actions.append(4)                               # USE

  return actions


