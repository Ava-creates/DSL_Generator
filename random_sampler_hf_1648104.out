import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a stick in the given Craft environment.

  The function works for a typical `CraftLab` environment:
    * It extracts the recipe for a stick from the world cookbook.
    * It finds the locations of the required primitive resources.
    * It navigates to each primitive, picks it up with the USE action,
      and finally navigates to the appropriate workshop to craft the stick.

  Action indices follow the mapping used by `CraftLab`:
      DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4
  """
  # ----------------------------------------------------------------------
  # Helper utilities
  # ----------------------------------------------------------------------
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4

  def _manhattan_path(src, dst):
      """Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that move
      from src (x, y) to dst (x, y) using a simple Manhattan walk."""
      sx, sy = src
      dx, dy = dst
      actions = []
      # vertical moves (y‑axis)
      while sy < dy:
          actions.append(DOWN)
          sy += 1
      while sy > dy:
          actions.append(UP)
          sy -= 1
      # horizontal moves (x‑axis)
      while sx < dx:
          actions.append(RIGHT)
          sx += 1
      while sx > dx:
          actions.append(LEFT)
          sx -= 1
      return actions

  # ----------------------------------------------------------------------
  # 1. Get indices and recipes for the stick
  # ----------------------------------------------------------------------
  # `env` is expected to be a CraftLab instance.
  world = env.world                     # CraftWorld instance
  cookbook = world.cookbook

  # Index of the target item ("stick")
  stick_idx = cookbook.index["stick"]

  # Primitive requirements for a single stick
  # Example: {log_idx: 1, stone_idx: 2}
  primitive_req = cookbook.primitives_for(stick_idx)

  # Workshop kind where a stick must be crafted
  # The recipe dictionary always contains the special key "_at"
  workshop_idx = cookbook.recipes[stick_idx]["_at"]

  # ----------------------------------------------------------------------
  # 2. Locate primitives and workshop in the initial grid
  # ----------------------------------------------------------------------
  # The initial grid is stored in the scenario (allocentric view)
  grid = env.scenario.init_grid          # shape (W, H, n_kinds)

  # Helper to find the first cell that contains a given kind (non‑zero)
  def _find_entity(kind):
      locs = np.argwhere(grid[:, :, kind] > 0)
      if len(locs) == 0:
          raise RuntimeError(f"Entity of kind {kind} not found in the grid.")
      # Return (x, y) – note that numpy returns (row, col) = (y, x)
      y, x = locs[0]
      return (x, y)

  # Positions of each required primitive (one position per kind)
  primitive_pos = {k: _find_entity(k) for k in primitive_req.keys()}

  # Position of any workshop that can craft a stick
  workshop_pos = _find_entity(workshop_idx)

  # ----------------------------------------------------------------------
  # 3. Simulate the agent moving and collecting resources
  # ----------------------------------------------------------------------
  actions = []
  # Agent starts at the scenario's initial position
  cur_pos = env.scenario.init_pos  # (x, y)

  # Collect each primitive the required number of times
  for prim_idx, count in primitive_req.items():
      target = primitive_pos[prim_idx]
      for _ in range(count):
          # Move to the primitive
          actions.extend(_manhattan_path(cur_pos, target))
          cur_pos = target
          # Pick it up
          actions.append(USE)
          # (In a real run the primitive would disappear, but we keep the
          #  same target location for simplicity – the environment will
          #  handle the missing object on the next USE if needed.)

  # ----------------------------------------------------------------------
  # 4. Move to the workshop and craft the stick
  # ----------------------------------------------------------------------
  actions.extend(_manhattan_path(cur_pos, workshop_pos))
  cur_pos = workshop_pos
  actions.append(USE)   # crafting action

  return actions


