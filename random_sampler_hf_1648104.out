import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that (in principle) collects the
  primitives required to craft a ``stick`` and then performs the craft
  at the appropriate workshop.

  The implementation is deliberately simple: it assumes a clear
  Manhattan‑grid path to the needed items and does not account for
  obstacles.  It is sufficient for environments where the required
  resources are reachable without complex navigation.

  Parameters
  ----------
  env : object
      A CraftWorld (or CraftLab) environment instance.  The object must
      expose ``world.cookbook`` and, after a call to ``reset()``, a
      ``_current_state`` attribute of type :class:`CraftState`.

  Returns
  -------
  list[int]
      List of action IDs (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4) that,
      when executed sequentially, should result in a ``stick`` being
      present in the agent's inventory.
  """
  import numpy as np

  # ------------------------------------------------------------------
  # Helper: move the agent from its current position to a target cell.
  # ------------------------------------------------------------------
  def _append_moves(cur, target, act_list):
      """Append moves to ``act_list`` that walk from ``cur`` to ``target``."""
      x, y = cur
      tx, ty = target
      # RIGHT (3) / LEFT (2)
      while x < tx:
          act_list.append(3)   # RIGHT
          x += 1
      while x > tx:
          act_list.append(2)   # LEFT
          x -= 1
      # DOWN (0) / UP (1)
      while y < ty:
          act_list.append(0)   # DOWN
          y += 1
      while y > ty:
          act_list.append(1)   # UP
          y -= 1
      return (x, y)

  # ------------------------------------------------------------------
  # Initialise environment and obtain the current state.
  # ------------------------------------------------------------------
  try:
      env.reset()
  except Exception:
      # Some wrappers may not require an explicit reset.
      pass

  # ``CraftLab`` stores the underlying state in a private attribute.
  try:
      state = env._current_state
  except AttributeError:
      # If the object itself is already a ``CraftState``.
      state = env

  # ------------------------------------------------------------------
  # Identify the index of the target item (``stick``) and its recipe.
  # ------------------------------------------------------------------
  try:
      stick_idx = env.world.cookbook.index["stick"]
  except Exception:
      # ``stick`` not defined in this world – nothing to plan.
      return []

  # Primitive requirements for a single ``stick``.
  primitive_needs = env.world.cookbook.primitives_for(stick_idx)

  # The workshop (if any) where the stick must be crafted.
  recipe = env.world.cookbook.recipes.get(stick_idx, {})
  workshop_idx = None
  if "_at" in recipe:
      workshop_name = recipe["_at"]
      workshop_idx = env.world.cookbook.index.get(workshop_name, None)

  actions = []
  cur_pos = tuple(state.pos)   # current (x, y) location of the agent

  # ------------------------------------------------------------------
  # Collect each required primitive the necessary number of times.
  # ------------------------------------------------------------------
  for prim_idx, needed_qty in primitive_needs.items():
      for _ in range(needed_qty):
          # Locate all cells that currently contain this primitive.
          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              # Primitive not present – cannot continue planning.
              continue
          # Choose the closest occurrence (Manhattan distance).
          dists = np.sum(np.abs(locations - np.array(cur_pos)), axis=1)
          target_cell = tuple(locations[np.argmin(dists)])

          # Move to the cell and pick up the primitive.
          cur_pos = _append_moves(cur_pos, target_cell, actions)
          actions.append(4)   # USE to collect

  # ------------------------------------------------------------------
  # If a workshop is required, move to it and perform the craft.
  # ------------------------------------------------------------------
  if workshop_idx is not None:
      locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)
      if locations.size > 0:
          dists = np.sum(np.abs(locations - np.array(cur_pos)), axis=1)
          target_cell = tuple(locations[np.argmin(dists)])
          cur_pos = _append_moves(cur_pos, target_cell, actions)
          actions.append(4)   # USE to craft

  return actions


