import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that will obtain a ``stick`` in the given
  ``CraftLab`` environment.  The implementation works for any
  ``CraftWorld`` configuration by:

  1.  Querying the recipe for ``stick`` to obtain the required primitive
      kinds and their counts.
  2.  Repeatedly locating the nearest instance of each required primitive,
      moving next to it, facing it and using the ``USE`` action to pick it up.
  3.  After all primitives are in the inventory, locating a workshop of the
      appropriate type, moving next to it, facing it and using ``USE`` to
      craft the stick.

  The function does **not** step the environment – it only computes the
  sequence of actions.  It therefore works with any environment that
  follows the API described in the prompt (Gym‑style ``reset``/``step`` and
  the internal ``_current_state`` attribute used by ``CraftLab``).

  Parameters
  ----------
  env : CraftLab
      An instance of the CraftLab wrapper around a CraftWorld scenario.

  Returns
  -------
  List[int]
      A list of action indices (0‑4) that can be fed to ``env.step`` to
      obtain a stick.
  """
  import collections
  import numpy as np

  # ----------------------------------------------------------------------
  # Helper utilities
  # ----------------------------------------------------------------------
  # Action constants (match the mapping in CraftLab.action_specs)
  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4
  ACTIONS = (DOWN, UP, LEFT, RIGHT)

  # Directions as (dx, dy) for the four movement actions
  DIR2DELTA = {
      DOWN:  (0, 1),
      UP:    (0, -1),
      LEFT:  (-1, 0),
      RIGHT: (1, 0),
  }

  # ----------------------------------------------------------------------
  # Reset the environment to obtain a fresh state
  # ----------------------------------------------------------------------
  env.reset()
  state = env._current_state          # type: CraftState
  grid = state.grid.copy()            # (W, H, n_kinds)
  pos = state.pos                      # (x, y)
  inventory = state.inventory.copy()   # (n_kinds,)

  # ----------------------------------------------------------------------
  # Access the world / cookbook
  # ----------------------------------------------------------------------
  world = env.world                    # CraftWorld
  cookbook = world.cookbook
  stick_idx = cookbook.index["stick"]     # integer id of the goal

  # ----------------------------------------------------------------------
  # Determine which primitives are needed for a stick
  # ----------------------------------------------------------------------
  # ``primitives_for`` returns a dict {kind_idx: count}
  needed = cookbook.primitives_for(stick_idx).copy()   # mutable copy

  # If the stick recipe has no entry (already a primitive) just return [].
  if not needed:
      return []

  # ----------------------------------------------------------------------
  # Simple BFS that returns a list of movement actions from ``start`` to any
  # cell in ``targets`` while staying on empty cells.
  # ----------------------------------------------------------------------
  def bfs_to_targets(start, targets, occ):
      """
      Parameters
      ----------
      start : tuple[int, int]
          (x, y) start position.
      targets : set[tuple[int, int]]
          Positions we are allowed to finish on.
      occ : np.ndarray, shape (W, H)
          Boolean array, True where the cell is blocked.

      Returns
      -------
      List[int] | None
          List of movement actions (DOWN/UP/LEFT/RIGHT) to reach a target,
          or ``None`` if no path exists.
      """
      W, H = occ.shape
      q = collections.deque()
      q.append((start, []))
      visited = np.zeros((W, H), dtype=bool)
      visited[start] = True

      while q:
          (x, y), path = q.popleft()
          if (x, y) in targets:
              return path
          for a in ACTIONS:
              dx, dy = DIR2DELTA[a]
              nx, ny = x + dx, y + dy
              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:
                  if not occ[nx, ny]:           # can walk on empty cells only
                      visited[nx, ny] = True
                      q.append(((nx, ny), path + [a]))
      return None

  # ----------------------------------------------------------------------
  # Function to move adjacent to a given target cell and face it.
  # ----------------------------------------------------------------------
  def go_adjacent_and_face(agent_pos, target_pos, occ):
      """
      Returns a list of actions that moves the agent from ``agent_pos`` to a
      free cell that is orthogonally adjacent to ``target_pos`` and then
      turns the agent to face the target.

      Parameters
      ----------
      agent_pos : (x, y)
      target_pos : (x, y)
      occ : bool array (W, H) – blocked cells (including the target cell).

      Returns
      -------
      actions : List[int]
      new_pos : (x, y)   – position after the movement actions (before the
               final facing action).
      """
      tx, ty = target_pos
      # All four orthogonal neighbours of the target
      neighbour_offsets = [(0, -1), (0, 1), (-1, 0), (1, 0)]
      possible = set()
      for dx, dy in neighbour_offsets:
          nx, ny = tx + dx, ty + dy
          if 0 <= nx < occ.shape[0] and 0 <= ny < occ.shape[1]:
              if not occ[nx, ny]:          # must be free to stand on
                  possible.add((nx, ny))

      # Find path to the closest possible neighbour
      path = bfs_to_targets(agent_pos, possible, occ)
      if path is None:
          raise RuntimeError("No path to target neighbour found.")
      # After walking we will be on the neighbour that BFS returned.
      # Determine which neighbour we ended up on.
      cur = agent_pos
      for a in path:
          dx, dy = DIR2DELTA[a]
          cur = (cur[0] + dx, cur[1] + dy)

      # Choose the direction that looks from ``cur`` to the target
      dx, dy = tx - cur[0], ty - cur[1]
      if dx == 1:
          face_action = RIGHT
      elif dx == -1:
          face_action = LEFT
      elif dy == 1:
          face_action = DOWN
      elif dy == -1:
          face_action = UP
      else:
          # Should never happen (target not orthogonal)
          raise RuntimeError("Target not orthogonal to agent.")

      return path + [face_action], cur

  # ----------------------------------------------------------------------
  # Main loop – collect all required primitives
  # ----------------------------------------------------------------------
  actions = []

  # Occupancy map: any non‑zero entry in any kind means the cell is blocked.
  # (We treat workshop cells as blocked for movement – they are not walkable.)
  occupied = (grid.sum(axis=2) > 0)

  for kind, count_needed in list(needed.items()):
      # If we already have some in inventory, reduce the required amount.
      have = int(inventory[kind])
      count_needed = max(0, count_needed - have)
      while count_needed > 0:
          # Locate all cells that contain this primitive.
          prim_positions = np.argwhere(grid[:, :, kind] > 0)
          if prim_positions.shape[0] == 0:
              raise RuntimeError(f"Cannot find primitive of kind {kind}")

          # Choose the closest one (Manhattan distance) for efficiency.
          dists = np.abs(prim_positions - np.array(pos)).sum(axis=1)
          nearest_idx = int(dists.argmin())
          prim_x, prim_y = prim_positions[nearest_idx]

          # Move adjacent and face the primitive.
          move_actions, new_pos = go_adjacent_and_face(pos, (prim_x, prim_y), occupied)
          actions.extend(move_actions)

          # Use the primitive.
          actions.append(USE)

          # Update our simulated world state.
          # 1. Pick up – remove primitive from grid.
          grid[prim_x, prim_y, kind] = 0
          occupied = (grid.sum(axis=2) > 0)

          # 2. Update inventory and position.
          inventory[kind] += 1
          pos = new_pos

          count_needed -= 1

  # ----------------------------------------------------------------------
  # Craft the stick at its required workshop.
  # ----------------------------------------------------------------------
  stick_recipe = cookbook.recipes[stick_idx]
  workshop_kind = stick_recipe["_at"]

  # Find any workshop cell of that kind.
  workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
  if workshop_cells.shape[0] == 0:
      raise RuntimeError("No workshop of the required type found.")

  # Choose the closest workshop.
  dists = np.abs(workshop_cells - np.array(pos)).sum(axis=1)
  w_idx = int(dists.argmin())
  wx, wy = workshop_cells[w_idx]

  # Move adjacent and face the workshop.
  move_actions, new_pos = go_adjacent_and_face(pos, (wx, wy), occupied)
  actions.extend(move_actions)

  # Use the workshop to craft the stick.
  actions.append(USE)

  # (Optionally we could update the inventory here, but it is not needed for
  # the returned action list.)

  return actions


