"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Returns a list of actions that makes a stick in the given CraftWorld
  environment.  The implementation extracts the recipe for the item
  ``stick`` from the world’s cookbook, collects the required primitive
  resources, and finally crafts the stick at the appropriate workshop.

  The returned list can be fed directly to ``env.step(action)`` in order.
  """
  # ------------------------------------------------------------------
  # Helper utilities
  # ------------------------------------------------------------------
  # Mapping of movement actions – they are defined in the ``env`` module.
  # If they are not present we fall back to the usual integer encoding.
  DOWN = getattr(env, "DOWN", 0)
  UP = getattr(env, "UP", 1)
  LEFT = getattr(env, "LEFT", 2)
  RIGHT = getattr(env, "RIGHT", 3)
  USE = getattr(env, "USE", 4)

  # Simple Manhattan‑style path planner.
  def plan_path(start, goal):
      """Return a list of movement actions to go from start to goal."""
      x, y = start
      gx, gy = goal
      actions = []
      # move in x direction
      while x < gx:
          actions.append(RIGHT); x += 1
      while x > gx:
          actions.append(LEFT);  x -= 1
      # move in y direction
      while y < gy:
          actions.append(DOWN);  y += 1
      while y > gy:
          actions.append(UP);    y -= 1
      return actions

  # Find a free neighbour (4‑connected) of a given cell.
  def free_neighbour(cell, grid):
      """Return a coordinate adjacent to *cell* that is empty."""
      w, h, _ = grid.shape
      cx, cy = cell
      for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:
          nx, ny = cx + dx, cy + dy
          if 0 <= nx < w and 0 <= ny < h:
              # a cell is free when the sum over all kinds is zero
              if not grid[nx, ny].any():
                  return (nx, ny)
      # fallback – if no free neighbour (should not happen in normal maps)
      return cell

  # ------------------------------------------------------------------
  # Extract world information
  # ------------------------------------------------------------------
  world = env.world if hasattr(env, "world") else env._current_state.world
  cookbook = world.cookbook
  # Index of the target item (stick)
  stick_idx = cookbook.index["stick"]
  # Full recipe dict for the stick (includes ingredients and workshop)
  stick_recipe = cookbook.recipes[stick_idx]

  # ------------------------------------------------------------------
  # Determine which primitives are required (ignore the special "_at" key)
  # ------------------------------------------------------------------
  primitive_needs = {
      kind: cnt
      for kind, cnt in stick_recipe.items()
      if kind != "_at"
  }

  # ------------------------------------------------------------------
  # Starting position (the agent’s current location)
  # ------------------------------------------------------------------
  state = env._current_state
  pos = tuple(state.pos)          # (x, y)

  # ------------------------------------------------------------------
  # Build the action list
  # ------------------------------------------------------------------
  actions = []

  # ------------------------------------------------------------------
  # 1. Collect each required primitive.
  # ------------------------------------------------------------------
  grid = state.grid.copy()        # current occupancy
  for prim_kind, needed in primitive_needs.items():
      # locate all cells that contain this primitive
      prim_cells = list(zip(*np.where(grid[:, :, prim_kind] > 0)))
      # we may need multiple copies – take the first *needed* cells
      for i in range(needed):
          if not prim_cells:
              raise RuntimeError("Required primitive not found in the map")
          target = prim_cells.pop(0)               # (x, y) of the primitive
          # Move to a free neighbour of the primitive
          neigh = free_neighbour(target, grid)
          actions.extend(plan_path(pos, neigh))
          pos = neigh                               # update simulated position
          # Face the primitive (the direction after the last move already
          # points toward the neighbour; we just need to USE)
          actions.append(USE)
          # Update the simulated grid: the primitive is now in the inventory
          grid[target[0], target[1], prim_kind] -= 1
          # (the inventory is handled by the environment when actions are
          # actually executed, so we only keep the grid consistent here)

  # ------------------------------------------------------------------
  # 2. Move to the required workshop and craft the stick.
  # ------------------------------------------------------------------
  workshop_kind = stick_recipe["_at"]
  # locate a workshop of the required type
  workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))
  if not workshop_cells:
      raise RuntimeError("No workshop of the required type found")
  workshop = workshop_cells[0]
  # Move next to the workshop
  neigh = free_neighbour(workshop, grid)
  actions.extend(plan_path(pos, neigh))
  pos = neigh
  # Use the workshop to craft the stick
  actions.append(USE)

  # ------------------------------------------------------------------
  # Return the complete action list
  # ------------------------------------------------------------------
  return actions


