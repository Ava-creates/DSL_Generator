import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of actions that lets the agent craft a ``stick`` in a
  ``CraftWorld`` environment.

  The plan is completely deterministic and works for any recipe that
  requires only primitive resources (no intermediate crafted items).  It
  performs the following steps:

  1. Look up the index of the goal item ``stick`` in the world cookbook.
  2. Retrieve the primitive requirements for that goal.
  3. For each required primitive:
       * locate the first occurrence of that primitive in the initial grid,
       * move the agent to that cell using the four movement actions,
       * press ``USE`` the required number of times to pick it up.
  4. If the recipe specifies a workshop (``_at`` field), move to the first
     workshop of that type.
  5. Press ``USE`` once more to craft the stick.

  The function only uses the public attributes of the environment and does
  not depend on any hidden implementation details.

  Parameters
  ----------
  env : object
      An instance of the CraftWorld environment.  It must expose the
      attributes ``world`` (a ``CraftWorld``), ``scenario`` (a
      ``CraftScenario``) and the action constants defined in ``craft.env``
      (``UP``, ``DOWN``, ``LEFT``, ``RIGHT``, ``USE``).

  Returns
  -------
  List[int]
      A list of action indices that can be fed to ``env.step`` to obtain a
      stick.
  """
  import numpy as np

  # ----------------------------------------------------------------------
  # Helper to translate a Manhattan move into a list of actions.
  # ----------------------------------------------------------------------
  def _move_actions(start, goal):
      """Return a list of actions moving from start (x,y) to goal (x,y)."""
      sx, sy = start
      gx, gy = goal
      acts = []

      # Horizontal moves (x axis)
      while sx < gx:
          acts.append(env.RIGHT)
          sx += 1
      while sx > gx:
          acts.append(env.LEFT)
          sx -= 1

      # Vertical moves (y axis)
      while sy < gy:
          acts.append(env.DOWN)
          sy += 1
      while sy > gy:
          acts.append(env.UP)
          sy -= 1
      return acts

  # ----------------------------------------------------------------------
  # 1. Identify the goal item (stick) and its recipe.
  # ----------------------------------------------------------------------
  world = env.world
  scenario = env.scenario
  grid = scenario.init_grid                     # shape (W, H, n_kinds)

  # Resolve the index of the goal item ``stick``.
  try:
      goal_idx = world.cookbook.index["stick"]
  except Exception:               # pragma: no cover – defensive fallback
      # If the name is not present we cannot build a plan.
      return []

  # Primitive requirements for one stick.
  primitives_needed = world.cookbook.primitives_for(goal_idx)
  # ``primitives_needed`` is a dict {primitive_idx: count}.

  # ----------------------------------------------------------------------
  # 2. Collect each required primitive.
  # ----------------------------------------------------------------------
  actions = []
  # Current agent position (x, y).  ``init_pos`` follows the same order as
  # the grid axes (x = column, y = row).
  cur_pos = list(scenario.init_pos)

  for prim_idx, count in primitives_needed.items():
      # Locate the first cell that contains this primitive.
      locations = np.argwhere(grid[:, :, prim_idx] > 0)
      if locations.size == 0:
          # Primitive not present – cannot complete the task.
          return []

      # Pick the first occurrence.
      target = tuple(locations[0])   # (x, y)

      # Move to the primitive cell.
      actions.extend(_move_actions(cur_pos, target))
      cur_pos = list(target)

      # Pick up the primitive the required number of times.
      for _ in range(count):
          actions.append(env.USE)

  # ----------------------------------------------------------------------
  # 3. Go to the workshop (if the recipe specifies one) and craft.
  # ----------------------------------------------------------------------
  recipe = world.cookbook.recipes.get(goal_idx, {})
  workshop_name = recipe.get("_at")          # may be absent

  if workshop_name is not None:
      # Resolve the index of the workshop entity.
      workshop_idx = world.cookbook.index.get(workshop_name)
      if workshop_idx is not None:
          workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
          if workshop_cells.size > 0:
              workshop_pos = tuple(workshop_cells[0])
              actions.extend(_move_actions(cur_pos, workshop_pos))
              cur_pos = list(workshop_pos)

  # Finally, use the workshop (or the current cell) to craft the stick.
  actions.append(env.USE)

  return actions


