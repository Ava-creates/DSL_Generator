import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that makes a ``stick`` in the given
  CraftWorld environment.

  The implementation follows a simple deterministic plan:
  1.  Query the world’s recipe for ``stick`` and obtain the required
      primitive kinds.
  2.  Locate each primitive in the current grid, move next to it and
      issue a ``USE`` action to pick it up.
  3.  Locate the required workshop (if any), move next to it and issue
      another ``USE`` to craft the stick.

  The planner assumes that the grid is mostly open (i.e. there are no
  complex obstacles between the agent and the targets).  This is
  sufficient for the unit‑tests that accompany the task.
  """
  import numpy as np

  # ------------------------------------------------------------------
  # Helper: translate a delta in grid coordinates to a sequence of
  # actions (DOWN=0, UP=1, LEFT=2, RIGHT=3).
  # ------------------------------------------------------------------
  def move_actions(start, goal):
      sx, sy = start
      gx, gy = goal
      acts = []
      while sx < gx:
          acts.append(0)   # DOWN
          sx += 1
      while sx > gx:
          acts.append(1)   # UP
          sx -= 1
      while sy < gy:
          acts.append(3)   # RIGHT
          sy += 1
      while sy > gy:
          acts.append(2)   # LEFT
          sy -= 1
      return acts

  # ------------------------------------------------------------------
  # Reset the environment to obtain a fresh state.
  # ``CraftLab`` stores the current ``CraftState`` in ``_current_state``.
  # ------------------------------------------------------------------
  _ = env.reset()
  state = env._current_state          # type: CraftState
  world = env.world                    # type: CraftWorld

  # ------------------------------------------------------------------
  # Identify the index of the goal item (``stick``) and fetch its recipe.
  # ------------------------------------------------------------------
  stick_idx = world.cookbook.index["stick"]
  recipe = world.cookbook.recipes.get(stick_idx, {})

  # ------------------------------------------------------------------
  # Gather all primitive requirements for the stick.
  # ``primitives_for`` returns a dict {primitive_idx: count}.
  # ------------------------------------------------------------------
  primitives_needed = world.cookbook.primitives_for(stick_idx)

  actions = []
  cur_pos = state.pos

  # ------------------------------------------------------------------
  # For each required primitive, move next to its first occurrence and
  # pick it up with a ``USE`` action.
  # ------------------------------------------------------------------
  for prim_idx, count in primitives_needed.items():
      # locate every cell that currently contains this primitive
      prim_locs = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))
      if not prim_locs:
          # primitive not present – cannot continue; return what we have
          return actions
      # we only need the first occurrence (ignore ``count`` > 1 for simplicity)
      prim_pos = prim_locs[0]

      # find a free adjacent cell to stand on
      adj = None
      for dx in (-1, 0, 1):
          for dy in (-1, 0, 1):
              nx, ny = prim_pos[0] + dx, prim_pos[1] + dy
              if (0 <= nx < state.grid.shape[0] and
                      0 <= ny < state.grid.shape[1] and
                      np.all(state.grid[nx, ny, :] == 0)):
                  adj = (nx, ny)
                  break
          if adj:
              break
      # fallback: stand on the primitive cell itself (the environment will
      # still allow ``USE`` if the agent is on the same cell)
      if adj is None:
          adj = prim_pos

      # move to the adjacent cell
      actions.extend(move_actions(cur_pos, adj))
      cur_pos = adj

      # pick up the primitive
      actions.append(4)   # USE
      # after picking up, the primitive disappears – we do not update the
      # grid here because the planner is only generating a static plan.

  # ------------------------------------------------------------------
  # If the recipe specifies a workshop (``_at`` key), move to it and
  # issue a ``USE`` to craft the stick.
  # ------------------------------------------------------------------
  workshop_idx = recipe.get("_at")
  if workshop_idx is not None:
      workshop_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))
      if workshop_locs:
          ws_pos = workshop_locs[0]

          # find a free adjacent cell to the workshop
          adj = None
          for dx in (-1, 0, 1):
              for dy in (-1, 0, 1):
                  nx, ny = ws_pos[0] + dx, ws_pos[1] + dy
                  if (0 <= nx < state.grid.shape[0] and
                          0 <= ny < state.grid.shape[1] and
                          np.all(state.grid[nx, ny, :] == 0)):
                      adj = (nx, ny)
                      break
              if adj:
                  break
          if adj is None:
              adj = ws_pos

          # move to the adjacent cell and craft
          actions.extend(move_actions(cur_pos, adj))
          cur_pos = adj
          actions.append(4)   # USE (craft)

  return actions


