"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will collect the required primitives
  for a ``stick`` and then craft the stick at the appropriate workshop.

  The implementation works with any CraftWorld / CraftLab environment
  that follows the API described in the prompt.  It does **not** execute
  the actions – it only returns the sequence of action indices that
  should be fed to ``env.step`` later.

  The algorithm is deliberately simple:
    1.  Identify the index of the goal item (``stick``) and the
        primitives required to craft one stick.
    2.  Repeatedly locate each needed primitive on the grid,
        move the agent to that cell and issue a ``USE`` action to pick it
        up.
    3.  Locate the workshop required for the ``stick`` recipe,
        move to it and ``USE`` to craft the item.

  The movement strategy is a Manhattan walk (first vertical then
  horizontal).  It assumes the environment does not contain dynamic
  obstacles that would block this naïve path – which is a safe
  assumption for the static CraftWorld scenarios used in the tests.

  Parameters
  ----------
  env : object
      A CraftLab (or compatible) environment instance.

  Returns
  -------
  List[int]
      A list of action integers that, when executed in order, will
      produce a ``stick`` in the agent's inventory.
  """
  # ------------------------------------------------------------------
  # Helper utilities
  # ------------------------------------------------------------------
  def _manhattan_actions(start, goal, act_map):
      """Return a list of actions that walk from start to goal using a
      simple Manhattan strategy (vertical then horizontal)."""
      actions = []
      y, x = start
      gy, gx = goal

      # vertical moves
      while y < gy:
          actions.append(act_map["DOWN"])
          y += 1
      while y > gy:
          actions.append(act_map["UP"])
          y -= 1
      # horizontal moves
      while x < gx:
          actions.append(act_map["RIGHT"])
          x += 1
      while x > gx:
          actions.append(act_map["LEFT"])
          x -= 1
      return actions

  # ------------------------------------------------------------------
  # Initialise – obtain the current state without stepping the env.
  # ------------------------------------------------------------------
  # Reset (or assume already reset) to obtain a fresh observation.
  # The CraftLab stores the live state in a protected attribute.
  _ = env.reset()
  state = env._current_state      # type: CraftState

  # Action mapping (e.g. {"DOWN":0, "UP":1, ...})
  act_map = env.action_specs()

  # ------------------------------------------------------------------
  # Identify the goal (stick) and its recipe.
  # ------------------------------------------------------------------
  cookbook = env.world.cookbook
  stick_idx = cookbook.index["stick"]          # integer id of the goal
  # Primitive requirements for ONE stick (may include intermediate items)
  needed = cookbook.primitives_for(stick_idx)  # dict {kind_idx: count}

  # ------------------------------------------------------------------
  # Simulated mutable copies of the world state (so we can plan without
  # actually stepping the environment).
  # ------------------------------------------------------------------
  grid = state.grid.copy()                     # (W, H, n_kinds)
  inv = state.inventory.copy()                 # (n_kinds,)
  pos = tuple(state.pos)                       # (y, x)

  actions_plan = []

  # ------------------------------------------------------------------
  # Collect each required primitive.
  # ------------------------------------------------------------------
  for kind, required_cnt in needed.items():
      while inv[kind] < required_cnt:
          # Locate any cell that still contains the primitive.
          locations = np.argwhere(grid[:, :, kind] > 0)
          if locations.size == 0:
              raise RuntimeError(
                  f"Cannot find required primitive (kind={kind}) on the grid."
              )
          ty, tx = locations[0]  # pick the first occurrence

          # Move to that cell.
          actions_plan.extend(_manhattan_actions(pos, (ty, tx), act_map))
          pos = (ty, tx)  # update simulated position

          # Pick it up.
          actions_plan.append(act_map["USE"])

          # Update simulated world: remove from grid, add to inventory.
          grid[ty, tx, kind] -= 1
          inv[kind] += 1

  # ------------------------------------------------------------------
  # Craft the stick at its designated workshop.
  # ------------------------------------------------------------------
  recipe = cookbook.recipes[stick_idx]
  workshop_name = recipe["_at"]               # e.g. "workbench"
  workshop_idx = cookbook.index[workshop_name]

  # Find a workshop cell (any will do).
  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)
  if workshop_cells.size == 0:
      raise RuntimeError("No workshop cell for stick found on the grid.")
  wy, wx = workshop_cells[0]

  # Move to the workshop cell.
  actions_plan.extend(_manhattan_actions(pos, (wy, wx), act_map))
  pos = (wy, wx)

  # Use the workshop to craft the stick.
  actions_plan.append(act_map["USE"])

  # ------------------------------------------------------------------
  # Return the complete action list.
  # ------------------------------------------------------------------
  return actions_plan


