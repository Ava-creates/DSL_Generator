import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will collect the required primitives
  and craft a ``stick`` in the provided CraftLab environment.

  The implementation works with the public API exposed by the
  ``CraftLab`` / ``CraftWorld`` classes:
    * ``env.world`` – the underlying ``CraftWorld`` instance.
    * ``env._current_state`` – the active ``CraftState``.
    * ``env.action_specs()`` – mapping from action names to integer ids.
    * ``env.world.cookbook`` – recipe information.

  The strategy is a simple greedy planner:
    1. Determine which primitive items are needed for a stick.
    2. Repeatedly move to the nearest cell that contains a missing primitive,
       use the ``USE`` action to pick it up, and update the inventory.
    3. Once all required primitives are in the inventory, move to the nearest
       workshop cell and ``USE`` to craft the stick.

  The function returns the complete action list but does **not** execute
  the actions; the caller may feed the list to ``env.step`` sequentially.
  """
  # ----------------------------------------------------------------------
  # Helper utilities
  # ----------------------------------------------------------------------
  action_ids = env.action_specs()
  DIR2ACT = {
      (1, 0): action_ids["RIGHT"],
      (-1, 0): action_ids["LEFT"],
      (0, 1): action_ids["DOWN"],
      (0, -1): action_ids["UP"],
  }
  USE_ACT = action_ids["USE"]

  def manhattan_path(start, goal):
      """Return a list of (dx, dy) moves from start to goal using Manhattan steps."""
      sx, sy = start
      gx, gy = goal
      moves = []
      # first move in x, then in y (any order works for an empty grid)
      while sx != gx:
          step = 1 if gx > sx else -1
          moves.append((step, 0))
          sx += step
      while sy != gy:
          step = 1 if gy > sy else -1
          moves.append((0, step))
          sy += step
      return moves

  def bfs_to_target(state, target_kind):
      """
      Bread‑first search to the *nearest* cell that contains ``target_kind``.
      Returns a list of positions (including the start cell) that leads to the
      target.  The search may step onto the target cell even if it is occupied.
      """
      grid = state.grid
      w, h = grid.shape[:2]
      start = state.pos
      visited = np.full((w, h), False, dtype=bool)
      q = deque()
      q.append((start, [start]))
      visited[start] = True

      # a cell is walkable if it is empty (no entities) OR it is the target cell
      while q:
          (x, y), path = q.popleft()
          # check if this cell holds the desired kind
          if grid[x, y, target_kind] > 0:
              return path
          # explore 4‑neighbourhood
          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
              nx, ny = x + dx, y + dy
              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:
                  # walkable if empty
                  if grid[nx, ny].sum() == 0:
                      visited[nx, ny] = True
                      q.append(((nx, ny), path + [(nx, ny)]))
      # no reachable target found
      return None

  def moves_from_path(path):
      """Convert a list of positions to the corresponding action ids."""
      acts = []
      for (x0, y0), (x1, y1) in zip(path, path[1:]):
          delta = (x1 - x0, y1 - y0)
          acts.append(DIR2ACT[delta])
      return acts

  # ----------------------------------------------------------------------
  # 1. Identify the stick recipe
  # ----------------------------------------------------------------------
  idx = env.world.cookbook.index
  stick_idx = idx["stick"]
  # primitive requirements for a single stick (dict {prim_idx: count})
  prim_req = env.world.cookbook.primitives_for(stick_idx)

  # ----------------------------------------------------------------------
  # 2. Greedy collection of missing primitives
  # ----------------------------------------------------------------------
  actions = []
  state = env._current_state

  # Helper to query current inventory
  def have_enough(kind, needed):
      return state.inventory[kind] >= needed

  # Collect each primitive until the required amount is satisfied
  for prim_idx, needed_cnt in prim_req.items():
      while not have_enough(prim_idx, needed_cnt):
          # locate nearest cell that still contains the primitive
          path = bfs_to_target(state, prim_idx)
          if path is None:
              # cannot find the primitive – give up
              return actions
          # move along the path (excluding the start cell)
          actions += moves_from_path(path)
          # after moving, update the internal state reference
          # (the caller will actually execute the actions later)
          # For planning we simulate the movement locally:
          for a in actions[-len(path)+1:]:
              # simulate movement to keep `state.pos` consistent for the next iteration
              # This lightweight simulation mirrors the real step logic for
              # cardinal moves only.
              if a == DIR2ACT[(1, 0)]:
                  state.pos = (state.pos[0] + 1, state.pos[1])
              elif a == DIR2ACT[(-1, 0)]:
                  state.pos = (state.pos[0] - 1, state.pos[1])
              elif a == DIR2ACT[(0, 1)]:
                  state.pos = (state.pos[0], state.pos[1] + 1)
              elif a == DIR2ACT[(0, -1)]:
                  state.pos = (state.pos[0], state.pos[1] - 1)
              # direction is set to the last movement direction
              state.dir = list(DIR2ACT.values()).index(a)

          # now we are adjacent (or on) the primitive cell; use the item
          actions.append(USE_ACT)
          # simulate the pickup (increment inventory)
          state.inventory[prim_idx] += 1
          # remove the primitive from the grid (so we don't target the same cell again)
          # we simply clear the first occurrence we know about
          gx, gy = path[-1]
          state.grid[gx, gy, prim_idx] = 0

  # ----------------------------------------------------------------------
  # 3. Craft the stick at the nearest workshop
  # ----------------------------------------------------------------------
  # Any workshop is suitable – we pick the first kind listed.
  workshop_kind = env.world.workshop_indices[0]

  path = bfs_to_target(state, workshop_kind)
  if path is not None:
      actions += moves_from_path(path)
      actions.append(USE_ACT)   # craft at the workshop

  return actions


