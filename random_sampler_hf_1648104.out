"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  # reset env to get initial state
  obs = env.reset()
  state = env._current_state
  world = env.world
  idx = world.cookbook.index
  stick_idx = idx.get('stick')
  if stick_idx is None:
      return []
  # get primitives needed
  prims = world.cookbook.primitives_for(stick_idx)
  actions = []
  pos = state.pos
  direction = state.dir
  # helper mapping
  ACTIONS = {'DOWN':0,'UP':1,'LEFT':2,'RIGHT':3,'USE':4}
  # function to compute moves
  def moves_to(src, dst):
      sx, sy = src
      dx, dy = dst
      moves = []
      while sx < dx:
          moves.append(ACTIONS['DOWN']); sx+=1
      while sx > dx:
          moves.append(ACTIONS['UP']); sx-=1
      while sy < dy:
          moves.append(ACTIONS['RIGHT']); sy+=1
      while sy > dy:
          moves.append(ACTIONS['LEFT']); sy-=1
      return moves
  grid = state.grid
  for p_idx, count in prims.items():
      # find cells with this primitive
      locations = list(zip(*np.where(grid[:,:,p_idx] > 0)))
      # take first count locations
      for loc in locations[:count]:
          # move adjacent to loc
          # we can move to the cell itself then use? assume can stand on it and use to pick up
          actions += moves_to(pos, loc)
          pos = loc
          actions.append(ACTIONS['USE'])
  # after collecting, move to any workshop that crafts stick
  # find workshop index: recipe dict has _at key maybe world.cookbook.recipes[stick_idx]["_at"]
  recipe = world.cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get('_at')
  if workshop_name:
      workshop_idx = idx.get(workshop_name)
      # find workshop location
      wlocs = list(zip(*np.where(grid[:,:,workshop_idx] > 0)))
      if wlocs:
          wloc = wlocs[0]
          actions += moves_to(pos, wloc)
          pos = wloc
          actions.append(ACTIONS['USE'])
  return actions


