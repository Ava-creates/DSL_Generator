import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of low‑level actions that, when executed in the given
  CraftWorld environment, will collect all required primitives and craft a
  ``stick``.  The implementation works for any version of the environment that
  follows the API described in the specification.

  Action indices (as defined by ``CraftLab.action_specs()``):
      0 – DOWN   (increase row index)
      1 – UP     (decrease row index)
      2 – LEFT   (decrease column index)
      3 – RIGHT  (increase column index)
      4 – USE    (interact with the cell in front of the agent)
  """
  import numpy as np

  # ------------------------------------------------------------------
  # Helper: generate Manhattan‑style moves from src → tgt.
  # ------------------------------------------------------------------
  def _move_to(src, tgt):
      """Return a list of actions that moves from src to tgt."""
      actions = []
      x, y = src
      tx, ty = tgt
      while x < tx:      # move down
          actions.append(0)
          x += 1
      while x > tx:      # move up
          actions.append(1)
          x -= 1
      while y < ty:      # move right
          actions.append(3)
          y += 1
      while y > ty:      # move left
          actions.append(2)
          y -= 1
      return actions

  # ------------------------------------------------------------------
  # 1. Reset the environment and fetch the current state.
  # ------------------------------------------------------------------
  _ = env.reset()                     # returns an observation dict (ignored)
  state = env._current_state          # internal CraftState object

  # ------------------------------------------------------------------
  # 2. Identify the stick index and its recipe.
  # ------------------------------------------------------------------
  cookbook = env.world.cookbook
  stick_idx = cookbook.index["stick"]                     # goal index
  primitive_needs = cookbook.primitives_for(stick_idx)   # {prim_idx: count}
  recipe = cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")                       # workshop type (if any)
  workshop_idx = cookbook.index[workshop_name] if workshop_name else None

  # ------------------------------------------------------------------
  # 3. Collect all required primitives.
  # ------------------------------------------------------------------
  actions = []
  cur_pos = tuple(state.pos)          # keep track of the agent's position
  grid = state.grid.copy()            # local mutable copy of the grid

  for prim_idx, needed_cnt in primitive_needs.items():
      for _ in range(needed_cnt):
          # locate all cells that still contain the primitive
          locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              raise RuntimeError(f"Primitive {cookbook.index.get(prim_idx, prim_idx)} not found on the map.")
          # choose the closest one (Manhattan distance)
          dists = np.abs(locations - cur_pos).sum(axis=1)
          target = tuple(locations[dists.argmin()])

          # move to the primitive cell
          actions += _move_to(cur_pos, target)
          cur_pos = target

          # pick it up
          actions.append(4)          # USE
          # simulate removal of the primitive from the grid
          grid[target[0], target[1], prim_idx] = 0

  # ------------------------------------------------------------------
  # 4. Go to the required workshop (if any) and craft the stick.
  # ------------------------------------------------------------------
  if workshop_idx is not None:
      locations = np.argwhere(grid[:, :, workshop_idx] > 0)
      if locations.size == 0:
          raise RuntimeError("Required workshop not present in the map.")
      dists = np.abs(locations - cur_pos).sum(axis=1)
      target = tuple(locations[dists.argmin()])

      actions += _move_to(cur_pos, target)
      cur_pos = target

      actions.append(4)   # USE on the workshop to craft the stick

  return actions


