import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a list of actions that will obtain a ``stick`` in the given
  CraftWorld environment.

  The implementation works for any environment that follows the
  ``craft`` code‑base conventions:

  * ``env`` is a :class:`CraftLab` instance.
  * The underlying world can be accessed via ``env.world``.
  * The current mutable state is stored in ``env._current_state``.
  * Actions are encoded as integers:
      0 – DOWN, 1 – UP, 2 – LEFT, 3 – RIGHT, 4 – USE.
  * The goal item can be obtained from the task description
    (``env.task.goal``) or, if that attribute is missing, by looking up
    the name ``"stick"`` in the cookbook index.
  * The recipe for an item is available through
    ``env.world.cookbook.recipes[goal_idx]``.  Primitive requirements are
    the entries whose key is an integer (kind index); the optional
    ``"_at"`` entry tells at which workshop the item must be crafted.

  The planner is deliberately simple: it walks the agent with Manhattan
  moves on empty cells, picks up the required primitives, then moves to
  the appropriate workshop (if any) and issues a ``USE`` action to craft
  the final item.

  Parameters
  ----------
  env : CraftLab
      The environment instance.

  Returns
  -------
  List[int]
      A list of action indices that, when executed sequentially, will
      result in at least one ``stick`` in the agent's inventory.
  """
  import numpy as np

  # ------------------------------------------------------------------
  # Helper functions
  # ------------------------------------------------------------------
  def manhattan(a, b):
      return abs(a[0] - b[0]) + abs(a[1] - b[1])

  # Move one step towards ``target`` using Manhattan moves.
  # Returns the action taken.
  def step_towards(pos, target):
      x, y = pos
      tx, ty = target
      if x < tx:
          return 3, (x + 1, y)          # RIGHT
      if x > tx:
          return 2, (x - 1, y)          # LEFT
      if y < ty:
          return 0, (x, y + 1)          # DOWN
      if y > ty:
          return 1, (x, y - 1)          # UP
      # already there (should not happen)
      return None, pos

  # ------------------------------------------------------------------
  # Initialise environment (reset) and obtain the current state.
  # ------------------------------------------------------------------
  env.reset()
  state = env._current_state          # type: CraftState

  # ------------------------------------------------------------------
  # Determine the goal index for a ``stick``.
  # ------------------------------------------------------------------
  try:
      # Newer versions expose the goal directly.
      goal_idx = env.task.goal
  except Exception:  # pragma: no cover
      # Fallback: look up the name in the cookbook index.
      goal_idx = env.world.cookbook.index["stick"]

  # ------------------------------------------------------------------
  # Extract the primitive requirements for the goal.
  # ------------------------------------------------------------------
  # ``primitives_for`` returns a dict {kind_idx: count}
  needed = dict(env.world.cookbook.primitives_for(goal_idx))

  # ------------------------------------------------------------------
  # Main action list that will be returned.
  # ------------------------------------------------------------------
  actions = []

  # ------------------------------------------------------------------
  # Collect each required primitive.
  # ------------------------------------------------------------------
  for kind, count in needed.items():
      while count > 0:
          # Scan the current grid for cells that still contain the primitive.
          grid = state.grid
          # ``grid[:,:,kind] > 0`` gives a boolean map of cells with the item.
          primitive_cells = np.argwhere(grid[:, :, kind] > 0)
          if primitive_cells.size == 0:
              raise RuntimeError(f"Primitive of kind {kind} not found on the map.")

          # Choose the closest primitive (Manhattan distance).
          distances = [manhattan(state.pos, tuple(cell)) for cell in primitive_cells]
          target = tuple(primitive_cells[int(np.argmin(distances))])

          # Walk to a *adjacent* empty cell next to the target.
          # First, find any empty neighbour of the target.
          neighbours = [
              (target[0] + dx, target[1] + dy)
              for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]
              if 0 <= target[0] + dx < grid.shape[0] and
                 0 <= target[1] + dy < grid.shape[1]
          ]

          # Filter neighbours that are free (no entity occupies them).
          empty_neighbours = [
              n for n in neighbours if not grid[n[0], n[1]].any()
          ]

          if not empty_neighbours:
              raise RuntimeError("No free neighbour to approach the primitive.")

          # Pick the empty neighbour that is closest to the agent.
          neighbour = min(
              empty_neighbours,
              key=lambda n: manhattan(state.pos, n)
          )

          # Move step‑by‑step until we stand on the chosen neighbour.
          while state.pos != neighbour:
              act, new_pos = step_towards(state.pos, neighbour)
              actions.append(act)
              _, _ = env.step(act)          # execute the step
              state = env._current_state

          # We are now adjacent to the primitive – pick it up.
          actions.append(4)                  # USE
          _, _ = env.step(4)
          state = env._current_state
          count -= 1

  # ------------------------------------------------------------------
  # All primitives are collected – now craft the stick at its workshop
  # (if the recipe specifies one).
  # ------------------------------------------------------------------
  recipe = env.world.cookbook.recipes.get(goal_idx, {})
  workshop_kind = recipe.get("_at", None)

  if workshop_kind is not None:
      # Locate the workshop cell (workshops are non‑grabbable, i.e. they
      # occupy a cell but the agent can stand next to them).
      grid = state.grid
      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)
      if workshop_cells.size == 0:
          raise RuntimeError("Required workshop not found on the map.")
      # Choose the closest workshop.
      distances = [manhattan(state.pos, tuple(cell)) for cell in workshop_cells]
      target_ws = tuple(workshop_cells[int(np.argmin(distances))])

      # As before, move to an empty neighbour of the workshop.
      neighbours = [
          (target_ws[0] + dx, target_ws[1] + dy)
          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]
          if 0 <= target_ws[0] + dx < grid.shape[0] and
             0 <= target_ws[1] + dy < grid.shape[1]
      ]
      empty_neighbours = [
          n for n in neighbours if not grid[n[0], n[1]].any()
      ]
      if not empty_neighbours:
          raise RuntimeError("No free neighbour to approach the workshop.")
      neighbour = min(
          empty_neighbours,
          key=lambda n: manhattan(state.pos, n)
      )
      while state.pos != neighbour:
          act, new_pos = step_towards(state.pos, neighbour)
          actions.append(act)
          _, _ = env.step(act)
          state = env._current_state

      # Finally, issue a USE to craft the stick.
      actions.append(4)          # USE at the workshop
      _, _ = env.step(4)
      state = env._current_state
  else:
      # No workshop required – a final USE anywhere will attempt to craft.
      actions.append(4)
      _, _ = env.step(4)
      state = env._current_state

  # ------------------------------------------------------------------
  # Return the complete action sequence.
  # ------------------------------------------------------------------
  return actions


