import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Generate a sequence of low‑level actions that makes a ``stick`` in the
  provided CraftWorld environment.

  The function works for any environment that follows the specification
  described in the prompt.  It:
    1. Resets the environment and obtains the internal ``CraftState``.
    2. Looks up the recipe for ``stick`` (including required primitives
       and the workshop where crafting must occur).
    3. Walks to each needed primitive, picks it up, and updates a local
       copy of the grid so that the same instance is not collected twice.
    4. Walks to the required workshop (if any) and performs the craft
       action.

  Action indices (as used by the environment):
      0 – DOWN   (increase row index)
      1 – UP     (decrease row index)
      2 – LEFT   (decrease column index)
      3 – RIGHT  (increase column index)
      4 – USE    (interact with the cell in front of the agent)

  Parameters
  ----------
  env : object
      An instance of ``CraftLab`` (or any wrapper exposing the same API).

  Returns
  -------
  list[int]
      A list of actions that, when executed sequentially in the environment,
      will result in a ``stick`` appearing in the agent's inventory.
  """
  import numpy as np

  # ------------------------------------------------------------------
  # Helper: produce Manhattan‑distance actions from src -> tgt.
  # ------------------------------------------------------------------
  def _move(src, tgt):
      """Return a list of actions moving from src (row, col) to tgt."""
      actions = []
      r, c = src
      tr, tc = tgt
      while r < tr:
          actions.append(0)  # DOWN
          r += 1
      while r > tr:
          actions.append(1)  # UP
          r -= 1
      while c < tc:
          actions.append(3)  # RIGHT
          c += 1
      while c > tc:
          actions.append(2)  # LEFT
          c -= 1
      return actions

  # ------------------------------------------------------------------
  # 1. Reset environment and fetch the current state.
  # ------------------------------------------------------------------
  _ = env.reset()                     # returns observation dict (ignored)
  state = env._current_state          # CraftState instance

  # ------------------------------------------------------------------
  # 2. Look up the stick recipe.
  # ------------------------------------------------------------------
  cookbook = env.world.cookbook
  stick_idx = cookbook.index["stick"]                 # goal kind index
  primitive_needs = cookbook.primitives_for(stick_idx)  # {prim_idx: count}
  recipe = cookbook.recipes.get(stick_idx, {})
  workshop_name = recipe.get("_at")                    # workshop kind name
  workshop_idx = cookbook.index[workshop_name] if workshop_name else None

  # ------------------------------------------------------------------
  # 3. Collect required primitives.
  # ------------------------------------------------------------------
  actions = []
  cur_pos = tuple(state.pos)          # (row, col)
  grid = state.grid.copy()            # mutable copy for planning

  for prim_idx, qty in primitive_needs.items():
      for _ in range(qty):
          # locate all cells currently holding this primitive
          locations = np.argwhere(grid[:, :, prim_idx] > 0)
          if locations.size == 0:
              raise RuntimeError(f"Cannot find primitive index {prim_idx} on map.")
          # pick the nearest one (Manhattan distance)
          dists = np.abs(locations - cur_pos).sum(axis=1)
          target = tuple(locations[dists.argmin()])

          # move to the primitive cell and pick it up
          actions.extend(_move(cur_pos, target))
          actions.append(4)                     # USE to collect
          cur_pos = target

          # update our planning grid – the primitive is now in inventory
          grid[target[0], target[1], prim_idx] = 0

  # ------------------------------------------------------------------
  # 4. Go to the workshop (if required) and craft the stick.
  # ------------------------------------------------------------------
  if workshop_idx is not None:
      locations = np.argwhere(grid[:, :, workshop_idx] > 0)
      if locations.size == 0:
          raise RuntimeError("Required workshop not found on the map.")
      dists = np.abs(locations - cur_pos).sum(axis=1)
      target = tuple(locations[dists.argmin()])

      actions.extend(_move(cur_pos, target))
      actions.append(4)                     # USE to craft
      cur_pos = target

  return actions


