  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Simple (naïve) implementation that attempts to complete the
  “make stick” task by repeatedly issuing a default action
  until the environment reports that the task is done or the
  maximum number of steps is reached.

  This implementation does not try to plan optimal moves;
  it merely demonstrates a valid interaction loop with the
  CraftLab environment and returns the sequence of actions
  taken.

  Args:
      env: An instance of ``CraftLab`` (or any compatible
           environment exposing ``reset``, ``step``, ``_is_done``,
           and ``max_steps`` attributes).

  Returns:
      List[int]: List of action indices executed.
  """
  # Reset the environment to start a new episode
  obs = env.reset()
  actions = []

  # Use a simple deterministic policy: always take the first
  # action (e.g., DOWN = 0).  Stop when the task is finished or
  # when the step limit is reached.
  for _ in range(env.max_steps):
      if env._is_done():
          break
      action = 0  # default action (DOWN)
      reward, done, obs = env.step(action)
      actions.append(action)
      if done:
          break

  return actions


