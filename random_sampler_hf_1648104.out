"""

## Return only the python code
'''

import numpy as np
import time
import collections
from craft import env_factory, craft, env


def solve(env, visualise=False) -> float:
  """Runs the environment with a collect function that returns list of actions to take and returns total reward."""
  actions_to_take = make_stick(env)
  total_reward = 0.0

  for t in range(len(actions_to_take)):
    action = actions_to_take[t]
    reward, done, observations = env.step(action)
    total_reward += reward
    if done:
      break
  return [total_reward, len(actions_to_take)]


def evaluate() -> float:
  """Evaluates a collecting policy on a set of sample tasks."""
  visualise = False
  recipes_path = "craft/resources/recipes.yaml"
  hints_path = "craft/resources/hints.yaml"
  reward = 0 

  env_sampler = env_factory.EnvironmentFactory(
  recipes_path, hints_path, 0, max_steps=100, reuse_environments=False,
            visualise=visualise)

  env = env_sampler.sample_environment(task_name= 'make[stick]')
  reward = solve(env,  visualise=visualise)
  return reward


def make_stick(env):
  """Returns a sequence of actions to complete the task of make[stick] 
    in the given environment. The function gathers the required primitives 
    from the recipe for 'stick' and then crafts the stick.
  Args:
      env: The environment instance.

  Returns:
      List[int]: A list of action indices the agent can execute to complete the task of making sticks.
  """
  """
  Plan and return a sequence of actions to craft a stick in the given CraftWorld environment.
  The function extracts the recipe for a stick, gathers required primitives,
  moves the agent to collect them, and finally performs the crafting action.
  """
  # Identify the index for the 'stick' item
  stick_idx = env.world.cookbook.index["stick"]
  # Retrieve primitive requirements for a stick
  required = env.world.cookbook.primitives_for(stick_idx)

  actions = []

  # Helper to move towards a target cell (simple Manhattan approach)
  def move_to(target):
      while env._current_state.pos[0] < target[0]:
          actions.append(env.world.n_actions - 1)  # DOWN
          env.step(actions[-1])
      while env._current_state.pos[0] > target[0]:
          actions.append(env.world.n_actions - 2)  # UP
          env.step(actions[-1])
      while env._current_state.pos[1] < target[1]:
          actions.append(env.world.n_actions - 3)  # RIGHT
          env.step(actions[-1])
      while env._current_state.pos[1] > target[1]:
          actions.append(env.world.n_actions - 4)  # LEFT
          env.step(actions[-1])

  # Collect each required primitive
  for prim_idx, count in required.items():
      for _ in range(count):
          # Find nearest cell containing the primitive
          positions = np.argwhere(env._current_state.grid[:, :, prim_idx] > 0)
          if len(positions) == 0:
              continue
          # Choose the first found position (could be optimized)
          target_pos = tuple(positions[0])
          move_to(target_pos)
          # Face the primitive (assume direction doesn't matter for USE)
          actions.append(env.world.n_actions - 5)  # USE to pick up
          env.step(actions[-1])

  # Move to a workshop that can craft sticks (assume any workshop works)
  workshop_idx = env.world.workshop_indices[0]
  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)
  if len(workshop_positions) > 0:
      move_to(tuple(workshop_positions[0]))

  # Craft the stick
  actions.append(env.world.n_actions - 5)  # USE to craft
  env.step(actions[-1])

  return actions


