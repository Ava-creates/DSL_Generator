{"timestamp": "2025-11-05T14:55:52.511680", "function_name": "break_func", "function_body": "  # Initialize the episode and gather basic information\n  obs = env.reset()\n  actions = []\n  state = env._current_state                     # current CraftState\n  world = env.world\n  goal = env.task.goal                           # integer index of the goal item\n\n  # Primitive requirements for the goal (may be empty if goal is primitive)\n  needed = dict(world.cookbook.primitives_for(goal))\n\n  # Maximum number of steps to avoid infinite loops\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  for _ in range(max_steps):\n      # Terminate if the environment reports completion\n      if env._is_done():\n          break\n\n      # Current inventory snapshot\n      inventory = state.inventory\n\n      # Determine which primitives are still missing\n      remaining = {\n          k: needed[k] - inventory[k]\n          for k in needed\n          if inventory[k] < needed[k]\n      }\n\n      # If we have all required primitives, just try to USE (craft) and continue\n      if not remaining:\n          actions.append(4)                     # USE\n          _, state = env.step(4)\n          continue\n\n      # Locate the closest needed primitive on the grid\n      grid = state.grid\n      best_target = None\n      best_dist = None\n\n      for kind, need_cnt in remaining.items():\n          # Find all cells that contain this kind (count > 0)\n          positions = np.argwhere(grid[:, :, kind] > 0)\n          for (x, y) in positions:\n              dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n              if (best_dist is None) or (dist < best_dist):\n                  best_dist = dist\n                  best_target = (x, y, kind)\n\n      # If nothing is found (should not happen), abort\n      if best_target is None:\n          break\n\n      tx, ty, tkind = best_target\n      px, py = state.pos\n\n      # Decide on a movement action to approach the target\n      if tx > px:\n          act = 3                               # RIGHT\n      elif tx < px:\n          act = 2                               # LEFT\n      elif ty > py:\n          act = 0                               # DOWN\n      elif ty < py:\n          act = 1                               # UP\n      else:\n          # Agent is on the same cell as the resource; use to collect\n          act = 4                               # USE\n\n      actions.append(act)\n      _, state = env.step(act)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
