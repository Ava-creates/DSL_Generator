{"timestamp": "2025-11-05T15:51:38.739113", "function_name": "break_func", "function_body": "  \"\"\"Fallback function for obstacles that cannot be broken.\n\n  Args:\n      env: The CraftWorld environment instance.\n      obstacle: String name of the obstacle (e.g., \"stone\", \"water\").\n\n  Returns:\n      List[int]: An empty list indicating no actions can break the obstacle.\n  \"\"\"\n  return []", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-11-05T15:51:48.256554", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Determine available action indices\n  try:\n      action_space = list(env.action_specs().values())\n  except Exception:\n      # Fallback: assume standard 5 actions (DOWN, UP, LEFT, RIGHT, USE)\n      action_space = [0, 1, 2, 3, 4]\n\n  # Maximum number of steps to attempt\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  actions = []\n  # Loop until the task is finished or we hit the step limit\n  while not env._is_done() and len(actions) < max_steps:\n      a = int(np.random.choice(action_space))\n      # Execute the action; ignore returned reward/observation\n      env.step(a)\n      actions.append(a)\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-11-05T15:51:49.361788", "function_name": "break_func", "function_body": "  import numpy as np\n\n  actions = []\n  # Get the mapping of action names to indices\n  action_map = env.action_specs()\n  action_indices = list(action_map.values())\n\n  # Determine a reasonable step limit\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  # Keep acting until the task is done or we hit the step limit\n  while not env._is_done() and len(actions) < max_steps:\n      # Choose a random valid action\n      a = int(np.random.choice(action_indices))\n      # Execute the action; we ignore the reward and observation\n      _, done, _ = env.step(a)\n      actions.append(a)\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-11-05T15:52:18.894193", "function_name": "break_func", "function_body": "  import collections\n\n  # helper: convert delta to action index (DOWN=0, UP=1, LEFT=2, RIGHT=3)\n  def _delta_to_action(dx, dy):\n      if dx == 1:\n          return 3  # RIGHT\n      if dx == -1:\n          return 2  # LEFT\n      if dy == 1:\n          return 0  # DOWN\n      if dy == -1:\n          return 1  # UP\n      raise ValueError(\"Invalid delta\")\n\n  # helper: BFS to a cell adjacent (Chebyshev distance \u22641) to target\n  def _path_to_adjacent(state, target, occupied):\n      W, H = state.grid.shape[0], state.grid.shape[1]\n      start = state.pos\n      visited = set([start])\n      queue = collections.deque([(start, [])])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          # check adjacency (including diagonal)\n          if max(abs(x - target[0]), abs(y - target[1])) <= 1:\n              return path\n\n          for act, (dx, dy) in enumerate([(0, 1), (0, -1), (-1, 0), (1, 0)]):  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not occupied[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), path + [act]))\n      return None\n\n  # main solver\n  actions = []\n  state = env._current_state\n  goal = env.task.goal  # integer index of desired item\n  max_steps = 2000  # safety limit\n\n  while not state.satisfies(\"\", goal) and len(actions) < max_steps:\n      # ----- 1. Gather missing primitives -----\n      needed = env.world.cookbook.primitives_for(goal)  # dict {primitive_idx: count}\n      inventory = state.inventory\n      missing = {k: max(0, needed.get(k, 0) - inventory[k]) for k in needed}\n\n      # find a primitive we still need\n      primitive_to_collect = None\n      for kind, cnt in missing.items():\n          if cnt > 0:\n              primitive_to_collect = kind\n              break\n\n      if primitive_to_collect is not None:\n          # locate all cells containing this primitive\n          prim_cells = np.argwhere(state.grid[:, :, primitive_to_collect] == 1)\n          if prim_cells.size == 0:\n              # cannot find required primitive; abort\n              break\n\n          # pick the nearest primitive cell (Manhattan distance)\n          cur_x, cur_y = state.pos\n          dists = np.abs(prim_cells[:, 0] - cur_x) + np.abs(prim_cells[:, 1] - cur_y)\n          target_idx = int(np.argmin(dists))\n          target_cell = tuple(prim_cells[target_idx])\n\n          # compute occupied map (any non\u2011empty cell blocks movement)\n          occupied = np.any(state.grid, axis=2)\n\n          # find path to a neighbouring cell of the primitive\n          path = _path_to_adjacent(state, target_cell, occupied)\n          if path is None:\n              # no reachable path; abort\n              break\n\n          # execute movement actions\n          for act in path:\n              _, state = env.step(act)\n              actions.append(act)\n\n          # use action to pick up the primitive (USE = 4)\n          _, state = env.step(4)\n          actions.append(4)\n          continue  # re\u2011evaluate missing primitives\n\n      # ----- 2. All primitives collected \u2013 craft at workshop -----\n      # retrieve recipe for the goal\n      recipe = env.world.cookbook.recipes.get(goal, {})\n      workshop_kind = None\n      for key in recipe:\n          if not isinstance(key, int):\n              # non\u2011integer key denotes workshop type (e.g., \"_key\")\n              workshop_kind = key\n              break\n      if workshop_kind is None:\n          # try common workshop list as fallback\n          if env.world.workshop_indices:\n              workshop_kind = env.world.workshop_indices[0]\n\n      if workshop_kind is None:\n          # no workshop information; abort\n          break\n\n      # locate workshop cells\n      ws_cells = np.argwhere(state.grid[:, :, workshop_kind] == 1)\n      if ws_cells.size == 0:\n          break\n\n      # choose nearest workshop\n      cur_x, cur_y = state.pos\n      dists = np.abs(ws_cells[:, 0] - cur_x) + np.abs(ws_cells[:, 1] - cur_y)\n      target_idx = int(np.argmin(dists))\n      ws_target = tuple(ws_cells[target_idx])\n\n      occupied = np.any(state.grid, axis=2)\n      path = _path_to_adjacent(state, ws_target, occupied)\n      if path is None:\n          break\n\n      # move to workshop vicinity\n      for act in path:\n          _, state = env.step(act)\n          actions.append(act)\n\n      # use action to craft the item\n      _, state = env.step(4)\n      actions.append(4)\n\n  # return the accumulated action list (may be empty if no plan found)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
