{"timestamp": "2025-11-05T13:43:27.314569", "function_name": "break_func", "function_body": "  import numpy as np\n\n  actions = []\n  # maximum number of steps allowed in the episode\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  # goal item index\n  goal = env.task.goal\n\n  # access the cookbook for recipes and primitives\n  cookbook = env.world.cookbook\n\n  # pre\u2011compute which primitives are needed for the goal (one unit)\n  needed_prims = cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  for _ in range(max_steps):\n      # check if goal already satisfied\n      if env._current_state.inventory[goal] > 0:\n          break\n\n      inv = env._current_state.inventory\n\n      # determine which primitive (if any) we still need to collect\n      missing = {}\n      for p_idx, cnt in needed_prims.items():\n          have = inv[p_idx]\n          if have < cnt:\n              missing[p_idx] = cnt - have\n\n      # decide what kind we should target next\n      if goal in cookbook.primitives:\n          # goal itself is a primitive \u2013 just collect it\n          target_kind = goal\n      elif missing:\n          # still need some primitive\n          target_kind = next(iter(missing))\n      else:\n          # we have all primitives \u2013 go to the workshop for the goal\n          recipe = cookbook.recipes.get(goal, {})\n          target_kind = recipe.get(\"_at\", None)\n\n      # if we cannot identify a target (e.g., no workshop), just wander\n      if target_kind is None:\n          act = np.random.choice([0, 1, 2, 3])  # random move\n          actions.append(act)\n          env.step(act)\n          continue\n\n      # locate all cells that contain the target kind\n      grid = env._current_state.grid  # shape (W, H, n_kinds)\n      positions = np.argwhere(grid[:, :, target_kind] > 0)\n\n      # if nothing of that kind exists on the map, random move\n      if positions.size == 0:\n          act = np.random.choice([0, 1, 2, 3])\n          actions.append(act)\n          env.step(act)\n          continue\n\n      # pick the nearest instance (Manhattan distance)\n      cur_x, cur_y = env._current_state.pos\n      dists = np.abs(positions[:, 0] - cur_x) + np.abs(positions[:, 1] - cur_y)\n      nearest = positions[dists.argmin()]\n      tx, ty = nearest\n\n      # decide action: if adjacent, use the item/workshop; otherwise move towards it\n      manhattan = abs(cur_x - tx) + abs(cur_y - ty)\n      if manhattan == 1:\n          # adjacent \u2013 attempt to use the item/workshop\n          act = 4  # USE\n      else:\n          # move in the direction that reduces the distance\n          if tx > cur_x:\n              act = 0  # DOWN\n          elif tx < cur_x:\n              act = 1  # UP\n          elif ty < cur_y:\n              act = 2  # LEFT\n          else:\n              act = 3  # RIGHT\n\n      actions.append(act)\n      env.step(act)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-11-05T13:43:39.385809", "function_name": "break_func", "function_body": "  max_steps = 1000\n  actions = []\n  obs = env.reset()\n  done = False\n  step = 0\n  # Get list of possible action indices\n  action_vals = list(env.action_specs().values())\n  while not done and step < max_steps:\n      # Choose a random action\n      action = np.random.choice(action_vals)\n      actions.append(action)\n      reward, done, obs = env.step(action)\n      step += 1\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
