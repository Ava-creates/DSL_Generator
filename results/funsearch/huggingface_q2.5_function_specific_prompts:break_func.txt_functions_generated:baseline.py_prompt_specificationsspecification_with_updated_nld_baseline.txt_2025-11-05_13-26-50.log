{"timestamp": "2025-11-05T13:41:48.062691", "function_name": "break_func", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment to start fresh and obtain goal/item index.\n  env.reset()\n  goal = env.task.goal\n  world = env.world\n\n  # Helper to fetch the current CraftState.\n  def cur_state():\n      return env._current_state\n\n  # Primitive requirements for the target goal (may be empty if goal is primitive).\n  needed = world.cookbook.primitives_for(goal).copy()\n\n  # Simple BFS to find a path of movement actions (0\u20113) to any target cell.\n  def bfs(start, targets, blocked):\n      W, H = blocked.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(((1, 0), (-1, 0), (0, -1), (0, 1))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  actions = []\n  max_steps = getattr(env.task, \"steps\", 1000)\n\n  while not cur_state().satisfies(None, goal) and len(actions) < max_steps:\n      state = cur_state()\n      inventory = state.inventory\n\n      # Determine which primitives are still missing.\n      missing = {\n          k: needed[k] - inventory[k]\n          for k in needed\n          if needed[k] > inventory[k]\n      }\n\n      # ------------------------------------------------------------------\n      # 1) Collect missing primitives.\n      # ------------------------------------------------------------------\n      if missing:\n          # Choose an arbitrary missing primitive.\n          kind = next(iter(missing))\n\n          # Locate cells that currently contain this primitive.\n          prim_cells = np.argwhere(state.grid[:, :, kind] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort.\n              break\n\n          # Build blocked mask (non\u2011grabbable entities block movement).\n          blocked = np.zeros(state.grid.shape[:2], dtype=bool)\n          for ng in world.non_grabbable_indices:\n              blocked |= state.grid[:, :, ng] > 0\n\n          # Find all reachable cells adjacent to any primitive cell.\n          target_cells = set()\n          for px, py in prim_cells:\n              for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                  ax, ay = px + dx, py + dy\n                  if (\n                      0 <= ax < blocked.shape[0]\n                      and 0 <= ay < blocked.shape[1]\n                      and not blocked[ax, ay]\n                  ):\n                      target_cells.add((ax, ay))\n\n          # Compute path to the nearest adjacent cell.\n          path = bfs(state.pos, target_cells, blocked)\n          if path is None:\n              # Cannot reach the primitive \u2013 abort.\n              break\n\n          # Execute movement actions.\n          for a in path:\n              _, done, _ = env.step(a)\n              actions.append(a)\n              if done:\n                  return actions\n\n          # Use action (index 4) to pick up the primitive.\n          _, done, _ = env.step(4)\n          actions.append(4)\n          if done:\n              return actions\n          continue\n\n      # ------------------------------------------------------------------\n      # 2) All required primitives are in inventory \u2013 attempt to craft goal.\n      # ------------------------------------------------------------------\n      if goal in world.cookbook.recipes:\n          recipe = world.cookbook.recipes[goal]\n          workshop_kind = recipe.get(\"_at\")\n          if workshop_kind is not None:\n              # Locate workshop cells.\n              ws_cells = np.argwhere(state.grid[:, :, workshop_kind] > 0)\n              if ws_cells.size == 0:\n                  break\n\n              # Re\u2011use blocked mask.\n              blocked = np.zeros(state.grid.shape[:2], dtype=bool)\n              for ng in world.non_grabbable_indices:\n                  blocked |= state.grid[:, :, ng] > 0\n\n              # Find reachable cells adjacent to any workshop.\n              target_cells = set()\n              for wx, wy in ws_cells:\n                  for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                      ax, ay = wx + dx, wy + dy\n                      if (\n                          0 <= ax < blocked.shape[0]\n                          and 0 <= ay < blocked.shape[1]\n                          and not blocked[ax, ay]\n                      ):\n                          target_cells.add((ax, ay))\n\n              path = bfs(state.pos, target_cells, blocked)\n              if path is None:\n                  break\n\n              # Move to the workshop.\n              for a in path:\n                  _, done, _ = env.step(a)\n                  actions.append(a)\n                  if done:\n                      return actions\n\n              # Use workshop to craft.\n              _, done, _ = env.step(4)\n              actions.append(4)\n              if done:\n                  return actions\n              continue\n\n      # If we reach here, nothing more can be done.\n      break\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
