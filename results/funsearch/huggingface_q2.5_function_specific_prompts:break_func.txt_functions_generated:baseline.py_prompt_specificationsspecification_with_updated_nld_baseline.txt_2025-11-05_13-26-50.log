{"timestamp": "2025-11-05T15:16:45.883521", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Reset environment and get initial observation\n  env.reset()\n  # Mapping from action name to index\n  act_map = env.action_specs()\n  # Goal item index\n  goal_idx = env.task.goal\n  # Determine primitive requirements for one unit of the goal\n  needed = env.world.cookbook.primitives_for(goal_idx).copy()\n  actions = []\n\n  def move_action(cur_pos, target_pos):\n      \"\"\"Return an action index that moves one step towards the target.\"\"\"\n      cx, cy = cur_pos\n      tx, ty = target_pos\n      if tx > cx:\n          return act_map.get('RIGHT')\n      if tx < cx:\n          return act_map.get('LEFT')\n      if ty > cy:\n          return act_map.get('DOWN')\n      if ty < cy:\n          return act_map.get('UP')\n      return None\n\n  # Main loop: continue until the task is completed or no progress can be made\n  while not env._is_done():\n      state = env._current_state\n      inventory = state.inventory\n\n      # Update needed primitives based on current inventory\n      for k in list(needed.keys()):\n          have = int(inventory[k])\n          if have >= needed[k]:\n              needed.pop(k)\n          else:\n              needed[k] = needed[k] - have\n\n      # If we still need primitives, collect them\n      if needed:\n          # Choose any needed primitive (greedy)\n          prim_idx = next(iter(needed))\n          # Locate positions of that primitive on the grid\n          prim_grid = state.grid[:, :, prim_idx]\n          positions = np.argwhere(prim_grid > 0)\n          if positions.size == 0:\n              # No reachable primitive; break to avoid infinite loop\n              break\n          # Find the nearest primitive cell (Manhattan distance)\n          cur = np.array(state.pos)\n          dists = np.sum(np.abs(positions - cur), axis=1)\n          target = tuple(positions[dists.argmin()])\n\n          # Move towards the target primitive\n          while state.pos != target and not env._is_done():\n              act = move_action(state.pos, target)\n              if act is None:\n                  break\n              actions.append(act)\n              _, _ = env.step(act)\n              state = env._current_state\n\n          # Use the item (collect)\n          if not env._is_done():\n              use_act = act_map.get('USE')\n              if use_act is not None:\n                  actions.append(use_act)\n                  _, _ = env.step(use_act)\n      else:\n          # All primitives gathered; proceed to craft at the required workshop\n          recipe = env.world.cookbook.recipes.get(goal_idx, {})\n          workshop_idx = recipe.get('_at')\n          if workshop_idx is None:\n              # No workshop needed; task should be satisfied now\n              break\n          # Locate workshop cells\n          ws_grid = state.grid[:, :, workshop_idx]\n          ws_positions = np.argwhere(ws_grid > 0)\n          if ws_positions.size == 0:\n              break\n          cur = np.array(state.pos)\n          dists = np.sum(np.abs(ws_positions - cur), axis=1)\n          target_ws = tuple(ws_positions[dists.argmin()])\n\n          # Move to the workshop\n          while state.pos != target_ws and not env._is_done():\n              act = move_action(state.pos, target_ws)\n              if act is None:\n                  break\n              actions.append(act)\n              _, _ = env.step(act)\n              state = env._current_state\n\n          # Use the workshop to craft the goal item\n          if not env._is_done():\n              use_act = act_map.get('USE')\n              if use_act is not None:\n                  actions.append(use_act)\n                  _, _ = env.step(use_act)\n\n  # Return the sequence of actions taken\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-11-05T15:16:54.285031", "function_name": "break_func", "function_body": "  max_steps = 1000\n  actions = []\n  obs = env.reset()\n  done = False\n  step = 0\n  action_vals = list(env.action_specs().values())\n  while not done and step < max_steps:\n      action = np.random.choice(action_vals)\n      actions.append(action)\n      _, done, _ = env.step(action)\n      step += 1\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-11-05T15:16:55.395092", "function_name": "break_func", "function_body": "  import numpy as np\n\n  max_steps = 5000\n  actions = []\n  obs = env.reset()\n  done = False\n  step = 0\n  action_vals = list(env.action_specs().values())\n\n  while not done and step < max_steps:\n      a = np.random.choice(action_vals)\n      actions.append(a)\n      reward, done, obs = env.step(a)\n      step += 1\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
