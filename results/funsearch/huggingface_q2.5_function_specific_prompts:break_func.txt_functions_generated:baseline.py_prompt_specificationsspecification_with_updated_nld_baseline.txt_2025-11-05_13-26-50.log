{"timestamp": "2025-11-05T14:52:49.175036", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Retrieve current state and goal information\n  state = env._current_state\n  goal = env.task.goal\n  world = env.world\n  grid = state.grid\n  size = grid.shape[0]  # assuming square grid\n\n  # Determine which primitive items are required for the goal\n  required = world.cookbook.primitives_for(goal).copy()\n  has_recipe = goal in world.cookbook.recipes\n\n  actions = []\n\n  # Helper: Manhattan move sequence from a start to a target cell\n  def move_sequence(start, target):\n      seq = []\n      x, y = start\n      tx, ty = target\n      while x != tx:\n          if tx > x:\n              seq.append(0)   # DOWN\n              x += 1\n          else:\n              seq.append(1)   # UP\n              x -= 1\n      while y != ty:\n          if ty > y:\n              seq.append(3)   # RIGHT\n              y += 1\n          else:\n              seq.append(2)   # LEFT\n              y -= 1\n      return seq, (x, y)\n\n  # Helper: find empty neighbour cells around a given position\n  def empty_adjacent(pos):\n      x, y = pos\n      neigh = []\n      for dx, dy, act in [(-1, 0, 1), (1, 0, 0), (0, -1, 2), (0, 1, 3)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < size and 0 <= ny < size:\n              if grid[nx, ny, :].sum() == 0:\n                  neigh.append((nx, ny, act))\n      return neigh\n\n  cur_pos = state.pos\n\n  # ---------- Collect required primitives ----------\n  while any(v > 0 for v in required.values()):\n      # pick a primitive we still need\n      prim_kind = next(k for k, v in required.items() if v > 0)\n\n      # locate all cells containing this primitive\n      prim_cells = np.argwhere(grid[:, :, prim_kind] > 0)\n      if prim_cells.size == 0:\n          # nothing left on the map, break to avoid infinite loop\n          break\n\n      # choose the closest occurrence (Manhattan distance)\n      dists = np.abs(prim_cells[:, 0] - cur_pos[0]) + np.abs(prim_cells[:, 1] - cur_pos[1])\n      target_idx = int(np.argmin(dists))\n      target_cell = tuple(prim_cells[target_idx])\n\n      # find an empty adjacent cell to stand on\n      adj = empty_adjacent(target_cell)\n      if not adj:\n          # cannot reach this instance, mark as satisfied and continue\n          required[prim_kind] = 0\n          continue\n      # pick the adjacent cell with minimal distance from current position\n      adj_dists = [abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]) for c in adj]\n      best_adj = adj[int(np.argmin(adj_dists))]\n\n      # move to the chosen adjacent cell\n      move_seq, cur_pos = move_sequence(cur_pos, best_adj[:2])\n      actions.extend(move_seq)\n\n      # set facing direction toward the primitive (attempt blocked move)\n      if cur_pos[0] < target_cell[0]:\n          actions.append(0)   # DOWN (blocked)\n      elif cur_pos[0] > target_cell[0]:\n          actions.append(1)   # UP (blocked)\n      elif cur_pos[1] < target_cell[1]:\n          actions.append(3)   # RIGHT (blocked)\n      elif cur_pos[1] > target_cell[1]:\n          actions.append(2)   # LEFT (blocked)\n\n      # collect the item\n      actions.append(4)       # USE\n      required[prim_kind] -= 1\n\n  # If the goal itself is a primitive, we are done\n  if not has_recipe:\n      return actions\n\n  # ---------- Craft the goal at its workshop ----------\n  workshop_kind = world.cookbook.recipes[goal].get(\"_at\")\n  if workshop_kind is None:\n      return actions\n\n  # locate workshop cells\n  ws_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n  if ws_cells.size == 0:\n      return actions\n\n  # choose nearest workshop\n  ws_dists = np.abs(ws_cells[:, 0] - cur_pos[0]) + np.abs(ws_cells[:, 1] - cur_pos[1])\n  ws_idx = int(np.argmin(ws_dists))\n  ws_cell = tuple(ws_cells[ws_idx])\n\n  # find empty adjacent cell to the workshop\n  ws_adj = empty_adjacent(ws_cell)\n  if not ws_adj:\n      return actions\n  ws_adj_dists = [abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]) for c in ws_adj]\n  best_ws_adj = ws_adj[int(np.argmin(ws_adj_dists))]\n\n  # move next to the workshop\n  move_seq, cur_pos = move_sequence(cur_pos, best_ws_adj[:2])\n  actions.extend(move_seq)\n\n  # set facing direction toward the workshop (blocked move)\n  if cur_pos[0] < ws_cell[0]:\n      actions.append(0)   # DOWN (blocked)\n  elif cur_pos[0] > ws_cell[0]:\n      actions.append(1)   # UP (blocked)\n  elif cur_pos[1] < ws_cell[1]:\n      actions.append(3)   # RIGHT (blocked)\n  elif cur_pos[1] > ws_cell[1]:\n      actions.append(2)   # LEFT (blocked)\n\n  # craft the goal\n  actions.append(4)       # USE at workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
