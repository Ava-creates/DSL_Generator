{"timestamp": "2025-11-05T13:35:29.692368", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Reset the environment and obtain the initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal index and required primitives (if any)\n  goal = getattr(env.task, \"goal\", None)\n  required = {}\n  if goal is not None:\n      required = env.world.cookbook.primitives_for(goal)\n\n  # Determine maximum number of steps we may take\n  max_steps = getattr(env, \"max_steps\", None)\n  if max_steps is None:\n      max_steps = getattr(env.task, \"steps\", 1000)\n\n  actions = []\n\n  for _ in range(max_steps):\n      # Check if goal already satisfied\n      if goal is not None and state.satisfies(\"\", goal):\n          break\n\n      # Find a needed primitive adjacent to the agent\n      acted = False\n      for dir_idx, (dx, dy) in enumerate([(0, 1), (0, -1), (-1, 0), (1, 0)]):\n          nx, ny = state.pos[0] + dx, state.pos[1] + dy\n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              # kinds present in the neighboring cell\n              present = np.where(state.grid[nx, ny, :] > 0)[0]\n              for kind in present:\n                  if kind in required and state.inventory[kind] < required[kind]:\n                      # Face the correct direction if needed (movement actions also turn)\n                      if state.dir != dir_idx:\n                          actions.append(dir_idx)\n                          _, _ = env.step(dir_idx)\n                          state = env._current_state\n                      # Use the item\n                      actions.append(4)  # USE\n                      _, _ = env.step(4)\n                      state = env._current_state\n                      acted = True\n                      break\n              if acted:\n                  break\n\n      # If no useful adjacent primitive, take a random move\n      if not acted:\n          move = np.random.choice([0, 1, 2, 3])  # DOWN, UP, LEFT, RIGHT\n          actions.append(move)\n          _, _ = env.step(move)\n          state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
