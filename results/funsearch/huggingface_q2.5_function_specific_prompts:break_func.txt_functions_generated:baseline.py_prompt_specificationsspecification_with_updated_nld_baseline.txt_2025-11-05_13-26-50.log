{"timestamp": "2025-11-05T15:11:50.853763", "function_name": "break_func", "function_body": "  actions = []\n  # Reset the environment to start a new episode\n  env.reset()\n  # Get the goal item index from the task\n  goal_index = env.task.goal\n  # Determine step limit\n  max_steps = getattr(env, \"max_steps\", 1000)\n  # Main loop: act until goal satisfied, episode ends, or step limit reached\n  for _ in range(max_steps):\n      if env._current_state.satisfies(\"\", goal_index):\n          break\n      # Sample a random valid action\n      action = int(np.random.randint(0, env.world.n_actions))\n      # Execute action\n      _, done, _ = env.step(action)\n      actions.append(action)\n      if done:\n          break\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-11-05T15:11:51.957772", "function_name": "break_func", "function_body": "  # Initialize the environment and obtain the goal index.\n  env.reset()\n  goal_index = env.task.goal\n\n  # Determine the step limit (fallback to a reasonable default if not provided).\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  actions_taken = []\n\n  # Main loop: execute random actions until the goal is satisfied,\n  # the episode terminates, or the step budget is exhausted.\n  for _ in range(max_steps):\n      # Check goal condition.\n      if env._current_state.satisfies(\"\", goal_index):\n          break\n\n      # Sample a random valid action.\n      action = int(np.random.randint(0, env.world.n_actions))\n\n      # Perform the action.\n      _, done, _ = env.step(action)\n\n      # Record the action.\n      actions_taken.append(action)\n\n      # End loop if the environment signals termination.\n      if done:\n          break\n\n  # Return the sequence of actions taken.\n  return actions_taken", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-11-05T15:12:06.163181", "function_name": "break_func", "function_body": "  # Reset the environment and obtain the initial state\n  env.reset()\n  state = env._current_state  # current CraftState\n  goal = env.task.goal  # index of the target item\n\n  # Determine the primitive requirements for the goal (may be empty if goal is primitive)\n  needed_prims = env.world.cookbook.primitives_for(goal).copy()\n\n  actions = []\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  for _ in range(max_steps):\n      # Stop if the goal has been satisfied\n      if state.satisfies(None, goal):\n          break\n\n      # ------------------------------------------------------------------\n      # 1. Try to craft the goal if we are next to its required workshop\n      # ------------------------------------------------------------------\n      recipe = env.world.cookbook.recipes.get(goal, {})\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None and state.next_to(workshop_kind):\n          actions.append(4)            # USE\n          _, state = env.step(4)\n          continue\n\n      # ------------------------------------------------------------------\n      # 2. Try to collect any missing primitive needed for the goal\n      # ------------------------------------------------------------------\n      inventory = state.inventory\n      missing_prim = None\n      for prim, cnt in needed_prims.items():\n          if inventory[prim] < cnt:\n              missing_prim = prim\n              break\n\n      if missing_prim is not None:\n          # If the primitive is adjacent, pick it up\n          if state.next_to(missing_prim):\n              actions.append(4)        # USE\n              _, state = env.step(4)\n              continue\n\n          # Locate the nearest cell containing the needed primitive\n          grid_layer = state.grid[:, :, missing_prim]\n          positions = np.argwhere(grid_layer > 0)\n\n          if positions.size == 0:\n              # Primitive not present on the map \u2013 fallback to random move\n              act = np.random.choice([0, 1, 2, 3])\n              actions.append(act)\n              _, state = env.step(act)\n              continue\n\n          # Choose the closest instance (Manhattan distance)\n          cur_pos = np.array(state.pos)\n          dists = np.sum(np.abs(positions - cur_pos), axis=1)\n          target_pos = positions[dists.argmin()]\n\n          # Decide a movement direction that reduces the distance\n          dy = target_pos[0] - state.pos[0]\n          dx = target_pos[1] - state.pos[1]\n          if abs(dy) > abs(dx):\n              act = 0 if dy > 0 else 1          # DOWN or UP\n          else:\n              act = 2 if dx > 0 else 3          # LEFT or RIGHT\n\n          actions.append(act)\n          _, state = env.step(act)\n          continue\n\n      # ------------------------------------------------------------------\n      # 3. No specific primitive needed \u2013 perform a random walk\n      # ------------------------------------------------------------------\n      act = np.random.choice([0, 1, 2, 3])\n      actions.append(act)\n      _, state = env.step(act)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
