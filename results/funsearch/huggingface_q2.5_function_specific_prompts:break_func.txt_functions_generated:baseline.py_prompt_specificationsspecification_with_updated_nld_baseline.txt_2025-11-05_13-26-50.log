{"timestamp": "2025-11-05T14:16:21.421901", "function_name": "break_func", "function_body": "  # Reset the environment to start a new episode and obtain the initial observation.\n  obs = env.reset()\n  # Retrieve the list of possible action identifiers.\n  action_ids = list(env.action_specs().values())\n  # Store the sequence of actions that will be executed.\n  action_sequence = []\n  # Define a generous step limit to avoid infinite loops.\n  max_steps = 5000\n\n  for _ in range(max_steps):\n      # Choose an action uniformly at random.\n      act = np.random.choice(action_ids)\n      # Apply the action to the environment.\n      reward, done, obs = env.step(act)\n      # Record the action.\n      action_sequence.append(act)\n      # Stop early if the episode has terminated (goal reached or step limit hit).\n      if done:\n          break\n\n  # Return the list of actions taken during the episode.\n  return action_sequence", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-11-05T14:16:41.827915", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Reset the environment to get a fresh state and observation\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Goal index and required primitive counts (if any)\n  goal = env.task.goal\n  needed = dict(world.cookbook.primitives_for(goal))\n\n  # Helper to update needed dict based on current inventory\n  def update_needed():\n      inv = state.inventory\n      for k in list(needed.keys()):\n          if inv[k] >= needed[k]:\n              del needed[k]\n\n  actions = []\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  # Main loop: keep acting until the task is done or we hit the step limit\n  while not env._is_done() and len(actions) < max_steps:\n      update_needed()\n\n      # If no more primitives are required, just try to USE (craft) repeatedly\n      if not needed:\n          actions.append(4)                # USE action\n          _, _ = env.step(4)\n          state = env._current_state\n          continue\n\n      # Choose a primitive we still need\n      target_kind = next(iter(needed))\n\n      # Locate all cells that currently contain this primitive\n      locations = np.argwhere(state.grid[:, :, target_kind] > 0)\n      if locations.size == 0:\n          # Nothing left to collect \u2013 break to avoid infinite loop\n          break\n\n      # Find the nearest such location (Manhattan distance)\n      pos = np.array(state.pos)\n      dists = np.sum(np.abs(locations - pos), axis=1)\n      target_pos = locations[np.argmin(dists)]\n\n      # Decide on a movement action towards the target cell\n      dx = int(target_pos[0] - pos[0])\n      dy = int(target_pos[1] - pos[1])\n\n      if dx > 0:\n          act = 0          # DOWN\n      elif dx < 0:\n          act = 1          # UP\n      elif dy > 0:\n          act = 3          # RIGHT\n      elif dy < 0:\n          act = 2          # LEFT\n      else:\n          act = 4          # Already on the cell \u2013 attempt to pick up\n\n      actions.append(act)\n      _, _ = env.step(act)\n      state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-11-05T14:16:42.945965", "function_name": "break_func", "function_body": "  # Reset the environment to start a fresh episode\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  actions = []\n\n  # Try to obtain the goal index from the environment (if present)\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n\n  # Determine the set of possible actions\n  try:\n      action_vals = list(env.action_specs().values())\n  except Exception:\n      # Default to the standard 5 actions if the spec is unavailable\n      action_vals = [0, 1, 2, 3, 4]\n\n  max_steps = 500\n  for _ in range(max_steps):\n      # If we can check the goal, stop early when it is satisfied\n      if goal_idx is not None and hasattr(env, \"_current_state\"):\n          if env._current_state.satisfies(None, goal_idx):\n              break\n\n      # Pick a random action from the available actions\n      act = int(np.random.choice(action_vals))\n      actions.append(act)\n\n      # Apply the action to the environment\n      try:\n          _, done, _ = env.step(act)\n      except Exception:\n          break\n\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
