{"timestamp": "2025-11-05T15:42:54.858425", "function_name": "break_func", "function_body": "  return None", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-11-05T15:42:55.961019", "function_name": "break_func", "function_body": "  # Get reference to the world and the current state\n  world = env.world\n  state = env._current_state\n\n  # Resolve the obstacle index from its name\n  try:\n      obs_idx = world.cookbook.index[obstacle]\n  except Exception:\n      # Unknown obstacle name \u2013 nothing to do\n      return []\n\n  # Locate all cells that contain the obstacle\n  grid = state.grid\n  obs_cells = np.argwhere(grid[:, :, obs_idx] > 0)\n  if obs_cells.size == 0:\n      # No such obstacle present in the current grid\n      return []\n\n  # Helper to check if a coordinate is inside the grid bounds\n  h, w, _ = grid.shape\n  def in_bounds(r, c):\n      return 0 <= r < h and 0 <= c < w\n\n  # Cells that are occupied (any kind blocks movement)\n  occupied = np.any(grid, axis=2)\n\n  # Bread\u2011first search from the agent's position to the nearest\n  # cell that is *adjacent* to an obstacle cell.\n  start = state.pos\n  from collections import deque\n  q = deque([start])\n  visited = np.full((h, w), False, dtype=bool)\n  visited[start[0], start[1]] = True\n  parent = {}                     # maps child -> parent coordinate\n  target_adj = None               # coordinate we want to reach\n  target_dir = None               # direction (action index) to face the obstacle\n\n  # Mapping of movement deltas to action indices (as used by CraftWorld)\n  moves = [(-1, 0, 1),   # UP    -> action 1\n           ( 1, 0, 0),   # DOWN  -> action 0\n           ( 0,-1, 2),   # LEFT  -> action 2\n           ( 0, 1, 3)]   # RIGHT -> action 3\n\n  # Pre\u2011compute a set for faster \u201cis this an obstacle cell?\u201d checks\n  obs_set = {tuple(cell) for cell in obs_cells}\n\n  while q:\n      r, c = q.popleft()\n\n      # Check the four neighbours for an obstacle; if found we have our target\n      for dr, dc, act in moves:\n          nr, nc = r + dr, c + dc\n          if not in_bounds(nr, nc):\n              continue\n          if (nr, nc) in obs_set:\n              target_adj = (r, c)\n              target_dir = act\n              q.clear()\n              break\n\n      if target_adj is not None:\n          break\n\n      # Otherwise expand to free neighbouring cells\n      for dr, dc, act in moves:\n          nr, nc = r + dr, c + dc\n          if not in_bounds(nr, nc):\n              continue\n          if occupied[nr, nc]:\n              continue\n          if visited[nr, nc]:\n              continue\n          visited[nr, nc] = True\n          parent[(nr, nc)] = (r, c)\n          q.append((nr, nc))\n\n  # If we never found an adjacent cell, give up\n  if target_adj is None:\n      return []\n\n  # Reconstruct the path (as a list of movement actions) from start to target_adj\n  path = []\n  cur = target_adj\n  while cur != start:\n      pr = parent[cur]\n      dr = cur[0] - pr[0]\n      dc = cur[1] - pr[1]\n      for ddr, ddc, act in moves:\n          if dr == ddr and dc == ddc:\n              path.append(act)\n              break\n      cur = pr\n  path.reverse()                     # now from start \u2192 target_adj\n\n  # At the target cell we must be facing the obstacle before using the tool.\n  # The environment updates the facing direction automatically when we move,\n  # so we simply add the USE action after the movement.\n  path.append(4)                     # USE action (index 4 in CraftWorld)\n\n  return path", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
