{"timestamp": "2025-11-05T15:13:19.196494", "function_name": "break_func", "function_body": "  # Placeholder implementation: no actions.\n  return []", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-11-05T15:13:20.473755", "function_name": "break_func", "function_body": "  import collections\n  import numpy as np\n\n  # action constants (as defined in CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTION_DELTAS = {\n      DOWN:  (0, 1),\n      UP:    (0, -1),\n      LEFT:  (-1, 0),\n      RIGHT: (1, 0),\n  }\n  OPPOSITE = {DOWN: UP, UP: DOWN, LEFT: RIGHT, RIGHT: LEFT}\n\n  def bfs(start, grid):\n      \"\"\"Breadth\u2011first search on empty cells. Returns distance map and predecessor dict.\"\"\"\n      w, h = grid.shape[:2]\n      dist = -np.ones((w, h), dtype=int)\n      prev = {}\n      q = collections.deque()\n      sx, sy = start\n      dist[sx, sy] = 0\n      q.append(start)\n      while q:\n          x, y = q.popleft()\n          for a, (dx, dy) in ACTION_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and dist[nx, ny] == -1:\n                  if grid[nx, ny, :].sum() == 0:          # empty cell\n                      dist[nx, ny] = dist[x, y] + 1\n                      prev[(nx, ny)] = (x, y, a)          # predecessor + action taken to reach (nx,ny)\n                      q.append((nx, ny))\n      return dist, prev\n\n  def reconstruct_path(prev, start, goal):\n      \"\"\"Reconstruct list of actions from start to goal using predecessor dict.\"\"\"\n      path = []\n      cur = goal\n      while cur != start:\n          x, y, a = prev[cur]\n          path.append(a)\n          cur = (x, y)\n      path.reverse()\n      return path\n\n  def move_to(state, target_pos, actions):\n      \"\"\"Move from current position to target_pos using BFS, updating env and actions list.\"\"\"\n      start = state.pos\n      grid = state.grid\n      dist, prev = bfs(start, grid)\n      tx, ty = target_pos\n      if dist[tx, ty] == -1:\n          return False                     # unreachable\n      path = reconstruct_path(prev, start, target_pos)\n      for a in path:\n          rew, done, _ = env.step(a)\n          actions.append(a)\n          if done:\n              return True\n      return True\n\n  def face_and_use(state, neighbor, target, actions):\n      \"\"\"\n      Ensure the agent stands on `neighbor` and faces `target` (one cell away).\n      If direction is wrong, perform a small detour to set it, then USE.\n      \"\"\"\n      # direction needed to look from neighbor to target\n      dx = target[0] - neighbor[0]\n      dy = target[1] - neighbor[1]\n      needed_dir = None\n      for a, (adx, ady) in ACTION_DELTAS.items():\n          if (adx, ady) == (dx, dy):\n              needed_dir = a\n              break\n      # if already facing correctly, just use\n      if state.dir == needed_dir:\n          rew, done, _ = env.step(USE)\n          actions.append(USE)\n          return not done\n\n      # try a simple turn: move opposite then back\n      opp = OPPOSITE[needed_dir]\n      w, h = state.grid.shape[:2]\n      ox, oy = neighbor[0] + ACTION_DELTAS[opp][0], neighbor[1] + ACTION_DELTAS[opp][1]\n      if 0 <= ox < w and 0 <= oy < h and state.grid[ox, oy, :].sum() == 0:\n          # move opposite\n          rew, done, _ = env.step(opp)\n          actions.append(opp)\n          if done:\n              return False\n          # move back (now facing needed_dir)\n          rew, done, _ = env.step(needed_dir)\n          actions.append(needed_dir)\n          if done:\n              return False\n      else:\n          # fallback: try any free direction and back\n          for alt in (DOWN, UP, LEFT, RIGHT):\n              if alt == needed_dir:\n                  continue\n              ax, ay = neighbor[0] + ACTION_DELTAS[alt][0], neighbor[1] + ACTION_DELTAS[alt][1]\n              if 0 <= ax < w and 0 <= ay < h and state.grid[ax, ay, :].sum() == 0:\n                  rew, done, _ = env.step(alt)\n                  actions.append(alt)\n                  if done:\n                      return False\n                  rew, done, _ = env.step(needed_dir)\n                  actions.append(needed_dir)\n                  if done:\n                      return False\n                  break\n\n      # finally use\n      rew, done, _ = env.step(USE)\n      actions.append(USE)\n      return not done\n\n  # ----------------------------------------------------------------------\n  # Begin interaction with the environment\n  # ----------------------------------------------------------------------\n  actions_taken = []\n\n  # reset and fetch initial state\n  _ = env.reset()\n  state = env._current_state\n\n  # goal index\n  goal_idx = env.task.goal\n\n  # primitive requirements for the goal (including recursive ingredients)\n  required = dict(env.world.cookbook.primitives_for(goal_idx))\n\n  # ----------------------------------------------------------------------\n  # Collect required primitive items\n  # ----------------------------------------------------------------------\n  while any(cnt > 0 for cnt in required.values()):\n      # pick a primitive that is still needed\n      prim_idx = next(k for k, v in required.items() if v > 0)\n\n      # locate all cells containing this primitive\n      prim_cells = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if prim_cells.size == 0:\n          # cannot find the primitive \u2013 abort\n          break\n\n      # compute BFS distances from current position\n      dist, prev = bfs(state.pos, state.grid)\n\n      best_path = None\n      best_neighbor = None\n      best_target = None\n\n      # search for the closest reachable neighbor of any primitive cell\n      w, h = state.grid.shape[:2]\n      for tx, ty in prim_cells:\n          for a, (dx, dy) in ACTION_DELTAS.items():\n              nx, ny = tx - dx, ty - dy          # neighbor from which we can face the primitive\n              if 0 <= nx < w and 0 <= ny < h and state.grid[nx, ny, :].sum() == 0:\n                  if dist[nx, ny] != -1:\n                      if best_path is None or dist[nx, ny] < len(best_path):\n                          best_path = reconstruct_path(prev, state.pos, (nx, ny))\n                          best_neighbor = (nx, ny)\n                          best_target = (tx, ty)\n\n      if best_path is None:\n          # no reachable instance \u2013 abort\n          break\n\n      # execute movement to the chosen neighbor\n      for a in best_path:\n          rew, done, _ = env.step(a)\n          actions_taken.append(a)\n          if done:\n              return actions_taken\n      # update state after movement\n      state = env._current_state\n\n      # ensure facing the primitive and pick it up\n      if not face_and_use(state, best_neighbor, best_target, actions_taken):\n          return actions_taken\n\n      # refresh state and decrement requirement\n      state = env._current_state\n      required[prim_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # Craft the final goal (if it is not a primitive itself)\n  # ----------------------------------------------------------------------\n  if goal_idx not in env.world.cookbook.primitives:\n      # locate the recipe to find required workshop\n      recipe = env.world.cookbook.recipes.get(goal_idx, {})\n      workshop_idx = recipe.get(\"_at\")\n      if workshop_idx is not None:\n          # find workshop cells\n          workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if workshop_cells.size > 0:\n              # compute BFS distances once more\n              dist, prev = bfs(state.pos, state.grid)\n\n              best_path = None\n              best_neighbor = None\n              best_target = None\n\n              for wx, wy in workshop_cells:\n                  for a, (dx, dy) in ACTION_DELTAS.items():\n                      nx, ny = wx - dx, wy - dy\n                      if 0 <= nx < w and 0 <= ny < h and state.grid[nx, ny, :].sum() == 0:\n                          if dist[nx, ny] != -1:\n                              if best_path is None or dist[nx, ny] < len(best_path):\n                                  best_path = reconstruct_path(prev, state.pos, (nx, ny))\n                                  best_neighbor = (nx, ny)\n                                  best_target = (wx, wy)\n\n              if best_path is not None:\n                  # move to neighbor of workshop\n                  for a in best_path:\n                      rew, done, _ = env.step(a)\n                      actions_taken.append(a)\n                      if done:\n                          return actions_taken\n                  state = env._current_state\n                  # face workshop and issue USE to craft\n                  face_and_use(state, best_neighbor, best_target, actions_taken)\n\n  # Return the complete action sequence\n  return actions_taken", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
