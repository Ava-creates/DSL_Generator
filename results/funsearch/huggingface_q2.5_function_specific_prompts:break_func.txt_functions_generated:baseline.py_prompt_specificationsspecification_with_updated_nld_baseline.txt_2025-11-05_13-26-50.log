{"timestamp": "2025-11-05T14:36:22.400752", "function_name": "break_func", "function_body": "  import numpy as np\n  env.reset()\n  state = env._current_state\n  goal = env.task.goal\n  needed = dict(env.world.cookbook.primitives_for(goal))\n  actions = []\n  max_steps = getattr(env, \"max_steps\", 1000)\n  while not env._is_done() and len(actions) < max_steps:\n      # Update needed based on inventory\n      inv = state.inventory\n      for k in list(needed):\n          if inv[k] >= needed[k]:\n              del needed[k]\n      if not needed:\n          # Try to craft/use the goal\n          actions.append(4)  # USE\n          _, _ = env.step(4)\n          state = env._current_state\n          continue\n      # Choose a needed primitive\n      target_kind = next(iter(needed))\n      # Locate cells containing this primitive\n      locations = np.argwhere(state.grid[:, :, target_kind] > 0)\n      if locations.size == 0:\n          # Nothing to collect, attempt USE and continue\n          actions.append(4)\n          _, _ = env.step(4)\n          state = env._current_state\n          continue\n      # Find nearest location (Manhattan distance)\n      pos = np.array(state.pos)\n      dists = np.sum(np.abs(locations - pos), axis=1)\n      target_pos = locations[np.argmin(dists)]\n      # Determine movement action towards target\n      dx = int(target_pos[0] - pos[0])\n      dy = int(target_pos[1] - pos[1])\n      if dx > 0:\n          act = 0   # DOWN\n      elif dx < 0:\n          act = 1   # UP\n      elif dy > 0:\n          act = 3   # RIGHT\n      elif dy < 0:\n          act = 2   # LEFT\n      else:\n          act = 4   # USE (pick up / craft)\n      actions.append(act)\n      _, _ = env.step(act)\n      state = env._current_state\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
