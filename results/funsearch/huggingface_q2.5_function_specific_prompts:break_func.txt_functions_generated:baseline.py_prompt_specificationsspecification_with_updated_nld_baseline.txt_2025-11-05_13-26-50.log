{"timestamp": "2025-11-05T14:21:05.689084", "function_name": "break_func", "function_body": "  return None", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-11-05T14:21:06.798377", "function_name": "break_func", "function_body": "  # Reset the environment and obtain initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  goal = env.task.goal\n\n  # Action mapping (e.g., {'DOWN': 0, 'UP': 1, ...})\n  action_map = env.action_specs()\n\n  # Determine workshop kind for the goal (if any) and required primitives\n  recipe = cookbook.recipes.get(goal, {})\n  workshop_kind = recipe.get('_at')\n  required = cookbook.primitives_for(goal)  # {kind_idx: count}\n\n  actions = []\n  max_steps = getattr(env, \"max_steps\", 1000)\n  steps = 0\n\n  # Helper to move one step towards a target position\n  def step_towards(target_pos):\n      nonlocal steps, actions, state\n      dy = target_pos[0] - state.pos[0]\n      dx = target_pos[1] - state.pos[1]\n      if dy != 0:\n          act = action_map['DOWN'] if dy > 0 else action_map['UP']\n      else:\n          act = action_map['RIGHT'] if dx > 0 else action_map['LEFT']\n      _, _ = env.step(act)\n      actions.append(act)\n      state = env._current_state\n      steps += 1\n\n  # Main planning loop\n  while not env._is_done() and steps < max_steps:\n      # Recompute missing primitive counts\n      missing = {k: max(0, cnt - state.inventory[k]) for k, cnt in required.items()}\n      missing = {k: v for k, v in missing.items() if v > 0}\n\n      if missing:\n          # Choose any missing primitive (deterministic order)\n          kind = next(iter(missing))\n          # Locate nearest cell containing this primitive\n          positions = np.argwhere(state.grid[:, :, kind] > 0)\n          if positions.size == 0:\n              # No available primitive \u2013 abort planning\n              break\n          dists = np.abs(positions - np.array(state.pos)).sum(axis=1)\n          target = tuple(positions[dists.argmin()])\n\n          # Move towards the primitive cell\n          if state.pos != target:\n              step_towards(target)\n              continue\n\n          # At the primitive cell \u2013 collect it\n          act = action_map['USE']\n          _, _ = env.step(act)\n          actions.append(act)\n          state = env._current_state\n          steps += 1\n          continue\n\n      # All required primitives collected \u2013 move to workshop to craft\n      if workshop_kind is None:\n          # No workshop needed; goal should already be satisfied\n          break\n\n      # Find all workshop locations\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size == 0:\n          break  # No workshop present\n\n      # Choose the nearest cell adjacent (including diagonal) to any workshop\n      best_adj = None\n      best_dist = float('inf')\n      for w in workshop_cells:\n          for dy in (-1, 0, 1):\n              for dx in (-1, 0, 1):\n                  adj = (w[0] + dy, w[1] + dx)\n                  if (0 <= adj[0] < state.grid.shape[0] and\n                      0 <= adj[1] < state.grid.shape[1]):\n                      dist = abs(adj[0] - state.pos[0]) + abs(adj[1] - state.pos[1])\n                      if dist < best_dist:\n                          best_dist = dist\n                          best_adj = adj\n      if best_adj is None:\n          break\n\n      # Move towards the chosen adjacent cell\n      if state.pos != best_adj:\n          step_towards(best_adj)\n          continue\n\n      # At a valid crafting location \u2013 craft the goal item\n      act = action_map['USE']\n      _, _ = env.step(act)\n      actions.append(act)\n      state = env._current_state\n      steps += 1\n      continue\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
