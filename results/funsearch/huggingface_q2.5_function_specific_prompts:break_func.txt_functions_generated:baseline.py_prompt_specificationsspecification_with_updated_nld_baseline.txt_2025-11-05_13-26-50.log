{"timestamp": "2025-11-05T13:30:46.399656", "function_name": "break_func", "function_body": "  # No operation placeholder \u2013 return an empty action list\n  return []", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-11-05T13:30:47.541813", "function_name": "break_func", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment to start a fresh episode and obtain the initial state.\n  obs = env.reset()\n  state = env._current_state          # type: CraftState\n  world = state.world                 # type: CraftWorld\n  cookbook = world.cookbook\n\n  # Goal index is stored in the task of the lab wrapper.\n  goal_idx = env.task.goal\n\n  # Mapping from action int to movement delta (assumed ordering from CraftLab).\n  # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n  ACTION_DELTAS = {\n      0: (0, 1),   # DOWN  -> y + 1\n      1: (0, -1),  # UP    -> y - 1\n      2: (-1, 0),  # LEFT  -> x - 1\n      3: (1, 0),   # RIGHT -> x + 1\n  }\n\n  # Helper: compute a walkable mask (True = free cell) from the current grid.\n  def walkable_mask(grid):\n      # Any non\u2011zero entry in the kind dimension blocks the cell.\n      occupied = grid.sum(axis=2) > 0\n      return ~occupied\n\n  # Helper: BFS shortest path from start to any cell satisfying `target_cond`.\n  def bfs_path(start, target_cond, walk_mask):\n      W, H = walk_mask.shape\n      visited = np.full((W, H), False, dtype=bool)\n      prev = dict()\n      q = deque()\n      q.append(start)\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if target_cond((x, y)):\n              # reconstruct path\n              path = []\n              cur = (x, y)\n              while cur != start:\n                  px, py, act = prev[cur]\n                  path.append(act)\n                  cur = (px, py)\n              path.reverse()\n              return path\n          for act, (dx, dy) in ACTION_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and walk_mask[nx, ny]:\n                  visited[nx, ny] = True\n                  prev[(nx, ny)] = (x, y, act)\n                  q.append((nx, ny))\n      return None  # no path found\n\n  # Helper: find a free neighbour cell adjacent to (tx, ty) that is reachable.\n  def find_adjacent_free(target_pos, walk_mask):\n      tx, ty = target_pos\n      candidates = []\n      for act, (dx, dy) in ACTION_DELTAS.items():\n          nx, ny = tx + dx, ty + dy\n          if 0 <= nx < walk_mask.shape[0] and 0 <= ny < walk_mask.shape[1]:\n              if walk_mask[nx, ny]:\n                  candidates.append(((nx, ny), act))\n      return candidates\n\n  # Helper: decide which direction to face a neighbour cell to interact with target.\n  def direction_to_face(agent_pos, target_pos):\n      ax, ay = agent_pos\n      tx, ty = target_pos\n      if tx > ax:\n          return 3  # RIGHT\n      if tx < ax:\n          return 2  # LEFT\n      if ty > ay:\n          return 0  # DOWN\n      if ty < ay:\n          return 1  # UP\n      # already same cell (should not happen)\n      return 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n  cur_dir = int(state.dir)\n\n  # ----------------------------------------------------------------------\n  # 1. Gather all required primitive items.\n  # ----------------------------------------------------------------------\n  needed_prims = cookbook.primitives_for(goal_idx)  # dict {kind_idx: count}\n  # make a mutable copy\n  needed = dict(needed_prims)\n\n  while needed:\n      # pick any required primitive kind\n      kind, cnt = next(iter(needed.items()))\n      # locate all cells containing this kind\n      locations = np.argwhere(state.grid[:, :, kind] > 0)\n      if locations.size == 0:\n          # no more of this primitive on the map \u2013 cannot solve\n          break\n      # choose the first occurrence\n      tx, ty = tuple(locations[0])\n\n      # recompute walkable mask for current grid (primitives are obstacles)\n      walk_mask = walkable_mask(state.grid)\n\n      # find a free adjacent cell to stand on\n      adj_candidates = find_adjacent_free((tx, ty), walk_mask)\n      if not adj_candidates:\n          # cannot reach this primitive \u2013 skip it\n          del needed[kind]\n          continue\n\n      # pick the candidate with the shortest path\n      best_path = None\n      best_candidate = None\n      for (adj_pos, _) in adj_candidates:\n          path = bfs_path(cur_pos, lambda p: p == adj_pos, walk_mask)\n          if path is not None and (best_path is None or len(path) < len(best_path)):\n              best_path = path\n              best_candidate = (adj_pos, _)\n\n      if best_path is None:\n          # unreachable\n          del needed[kind]\n          continue\n\n      # follow the path\n      for act in best_path:\n          actions.append(act)\n          dx, dy = ACTION_DELTAS[act]\n          cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n          cur_dir = act  # after a move the agent faces the direction moved\n\n      # now we are on an adjacent free cell; set direction towards the primitive\n      desired_dir = direction_to_face(cur_pos, (tx, ty))\n      if cur_dir != desired_dir:\n          actions.append(desired_dir)   # turn by moving (the environment updates dir)\n          cur_dir = desired_dir\n\n      # use to collect\n      actions.append(4)   # USE\n      # update internal bookkeeping: assume collection succeeds and removes the item\n      # (we don't modify the real grid, but we decrement needed count)\n      cnt -= 1\n      if cnt <= 0:\n          del needed[kind]\n      else:\n          needed[kind] = cnt\n\n  # ----------------------------------------------------------------------\n  # 2. Craft the goal at its required workshop.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_kind = None\n  for k, v in recipe.items():\n      if k == \"_at\":\n          # value is the workshop kind index\n          workshop_kind = v\n          break\n  if workshop_kind is not None:\n      # locate any workshop of this kind\n      ws_locs = np.argwhere(state.grid[:, :, workshop_kind] > 0)\n      if ws_locs.size > 0:\n          wx, wy = tuple(ws_locs[0])\n\n          # recompute walkable mask (now primitives are gone from inventory, grid unchanged)\n          walk_mask = walkable_mask(state.grid)\n\n          # find adjacent free cell to the workshop\n          adj_candidates = find_adjacent_free((wx, wy), walk_mask)\n          if adj_candidates:\n              # choose reachable candidate with shortest path\n              best_path = None\n              best_adj = None\n              for (adj_pos, _) in adj_candidates:\n                  path = bfs_path(cur_pos, lambda p: p == adj_pos, walk_mask)\n                  if path is not None and (best_path is None or len(path) < len(best_path)):\n                      best_path = path\n                      best_adj = (adj_pos, _)\n\n              if best_path is not None:\n                  for act in best_path:\n                      actions.append(act)\n                      dx, dy = ACTION_DELTAS[act]\n                      cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n                      cur_dir = act\n\n                  # face the workshop\n                  desired_dir = direction_to_face(cur_pos, (wx, wy))\n                  if cur_dir != desired_dir:\n                      actions.append(desired_dir)\n                      cur_dir = desired_dir\n\n                  # use to craft\n                  actions.append(4)   # USE\n\n  # Return the list of action indices.\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
