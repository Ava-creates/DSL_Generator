{"timestamp": "2025-11-03T16:40:55.137864", "function_name": "break_func", "function_body": "  # Initialize the environment and retrieve the world and scenario\n  world = env.world\n  scenario = env.scenario\n  state = env._current_state\n\n  # Helper function to turn the agent towards a direction\n  def turn_towards(target_dir):\n      # Compute the minimal number of rotations needed\n      current_dir = state.dir\n      diff = (target_dir - current_dir) % 4\n      if diff == 1:\n          return [world.n_actions - 1]  # RIGHT turn\n      elif diff == 2:\n          return [world.n_actions - 1, world.n_actions - 1]  # two RIGHT turns\n      elif diff == 3:\n          return [world.n_actions - 2]  # LEFT turn\n      return []  # already facing target_dir\n\n  # Helper function to move forward one step\n  def move_forward():\n      return [world.n_actions - 3]  # MOVE action (DOWN in the action space)\n\n  # Helper function to use the cell in front of the agent\n  def use():\n      return [world.n_actions - 1]  # USE action\n\n  # Determine the target item index from the goal argument\n  goal_name, goal_arg = env.task.goal\n  target_idx = world.cookbook.index.index(goal_arg)\n\n  # Compute a simple BFS to find the nearest cell containing the target primitive\n  from collections import deque\n\n  width, height = state.grid.shape[:2]\n  visited = np.full((width, height), False, dtype=bool)\n  queue = deque()\n  start_pos = state.pos\n  queue.append((start_pos, []))\n  visited[start_pos] = True\n\n  # Directions: 0=UP,1=RIGHT,2=DOWN,3=LEFT\n  dir_vectors = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n  while queue:\n      (x, y), path = queue.popleft()\n      # Check if the current cell has the target primitive\n      if state.grid[x, y, target_idx] > 0:\n          # Follow the path to this cell\n          actions = []\n          cur_dir = state.dir\n          cur_pos = start_pos\n          for move_dir in path:\n              # Turn towards move_dir\n              actions.extend(turn_towards(move_dir))\n              # Move forward\n              actions.extend(move_forward())\n              # Update position and direction\n              cur_dir = move_dir\n              dx, dy = dir_vectors[move_dir]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n          # Finally, use the cell (collect the item)\n          actions.extend(use())\n          return actions\n\n      # Explore neighboring cells\n      for d, (dx, dy) in enumerate(dir_vectors):\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height and not visited[nx, ny]:\n              # Check if the cell is passable (empty or contains a grabable item)\n              cell_blocked = any(state.grid[nx, ny, idx] > 0 for idx in world.non_grabbable_indices)\n              if not cell_blocked:\n                  visited[nx, ny] = True\n                  queue.append(((nx, ny), path + [d]))\n\n  # If no reachable primitive found, return empty action list\n  return []", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
