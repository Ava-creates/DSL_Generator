{"timestamp": "2025-11-03T17:25:16.669357", "function_name": "break_func", "function_body": "  return None", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-11-03T17:25:34.845902", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Ensure the environment is reset; if already reset this is a no\u2011op.\n  try:\n      env.reset()\n  except Exception:\n      pass\n\n  state = env._current_state\n  # Goal index from the task definition.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # Determine the primitive ingredients required for the goal.\n  required = env.world.cookbook.primitives_for(goal_idx)\n  needed = {k: v for k, v in required.items() if v > 0}\n  actions = []\n\n  # Helper to move the agent one step in a given direction.\n  def step_action(act):\n      nonlocal state\n      reward, done, _ = env.step(act)\n      state = env._current_state\n      actions.append(act)\n      return reward, done\n\n  # Mapping of movement directions to action IDs (as defined in CraftLab).\n  DIRS = {\n      (1, 0): 0,   # DOWN  \u2192 increase row\n      (-1, 0): 1,  # UP    \u2192 decrease row\n      (0, -1): 2,  # LEFT  \u2192 decrease column\n      (0, 1): 3,   # RIGHT \u2192 increase column\n  }\n\n  while needed:\n      # Current agent position.\n      pos = state.pos\n\n      # Find the closest needed primitive on the grid.\n      best_dist = float(\"inf\")\n      best_pos = None\n      best_kind = None\n      grid = state.grid\n      for kind, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          locations = np.argwhere(grid[:, :, kind] > 0)\n          for loc in locations:\n              dist = abs(loc[0] - pos[0]) + abs(loc[1] - pos[1])\n              if dist < best_dist:\n                  best_dist = dist\n                  best_pos = tuple(loc)\n                  best_kind = kind\n\n      if best_pos is None:\n          # No reachable primitive found; abort.\n          break\n\n      # Plan Manhattan moves towards the target cell.\n      dr = best_pos[0] - pos[0]\n      dc = best_pos[1] - pos[1]\n\n      # Move vertically.\n      while dr != 0:\n          step = (1, 0) if dr > 0 else (-1, 0)\n          step_action(DIRS[step])\n          dr -= step[0]\n\n      # Move horizontally.\n      while dc != 0:\n          step = (0, 1) if dc > 0 else (0, -1)\n          step_action(DIRS[step])\n          dc -= step[1]\n\n      # Use the item (pick up / craft) at the current cell.\n      step_action(4)  # USE action.\n\n      # Update the count of needed primitives.\n      needed[best_kind] -= 1\n      if needed[best_kind] <= 0:\n          del needed[best_kind]\n\n      # If the goal is already satisfied, stop early.\n      if state.satisfies(\"\", goal_idx):\n          break\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-11-03T17:25:35.976200", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # Reset the environment to start a new episode\n  obs = env.reset()\n  actions = []\n  done = False\n\n  # Keep stepping until the task is done or we hit a safety limit\n  while not done and len(actions) < 1000:\n      # Sample a random valid action from the environment's action specs\n      action = np.random.choice(list(env.action_specs().values()))\n      # Perform the action; the step returns (reward, done, observation)\n      _, done, _ = env.step(action)\n      actions.append(action)\n\n  # Return the sequence of actions taken\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
