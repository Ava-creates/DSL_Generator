{"timestamp": "2025-11-03T17:44:15.016112", "function_name": "break_func", "function_body": "  return []", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-11-03T17:44:37.544493", "function_name": "break_func", "function_body": "  import numpy as np\n\n  # reset environment and get initial observation\n  obs = env.reset()\n  actions = []\n  # maximum steps to avoid infinite loops\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  for _ in range(max_steps):\n      # check if episode finished\n      if hasattr(env, \"_is_done\") and env._is_done():\n          break\n      # goal index (int) from task definition\n      goal = getattr(env, \"task\", None)\n      if goal is None:\n          break\n      goal_idx = goal.goal\n      # inventory vector\n      inventory = obs[\"features_dict\"][\"inventory\"]\n      # if goal already in inventory -> done\n      if inventory[goal_idx] > 0:\n          break\n\n      # ---------- planning ----------\n      # primitive requirements for the goal (direct primitives only)\n      needed_prims = env.world.cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n      # compute missing primitive counts\n      missing = {k: v - int(inventory[k]) for k, v in needed_prims.items() if int(inventory[k]) < v}\n      # obtain global grid view\n      grid = obs[\"features_dict\"][\"features_global\"]  # shape (W, H, n_kinds)\n      # current agent position (allocentric integer coordinates)\n      pos = env._current_state.pos\n\n      # helper to pick a movement action towards a target cell\n      def move_towards(target):\n          tx, ty = target\n          if tx < pos[0]:\n              return 1  # UP\n          if tx > pos[0]:\n              return 0  # DOWN\n          if ty < pos[1]:\n              return 2  # LEFT\n          if ty > pos[1]:\n              return 3  # RIGHT\n          return 4  # already on target -> USE\n\n      # ---------- try to collect missing primitives ----------\n      target_action = None\n      if missing:\n          # locate nearest needed primitive in the world\n          nearest_dist = np.inf\n          nearest_coord = None\n          nearest_kind = None\n          for kind in missing:\n              coords = np.argwhere(grid[:, :, kind] > 0)\n              for (x, y) in coords:\n                  d = abs(x - pos[0]) + abs(y - pos[1])\n                  if d < nearest_dist:\n                      nearest_dist = d\n                      nearest_coord = (x, y)\n                      nearest_kind = kind\n          if nearest_coord is not None:\n              # if we are adjacent (including same cell) we can USE to pick up\n              if nearest_coord == pos:\n                  target_action = 4  # USE\n              else:\n                  target_action = move_towards(nearest_coord)\n\n      # ---------- if no primitives missing, try to craft at workshop ----------\n      if target_action is None:\n          # check if we have a recipe for the goal\n          recipe = env.world.cookbook.recipes.get(goal_idx, {})\n          # workshop index is stored under special key (commonly \"_at\" or \"_key\")\n          workshop_idx = None\n          for key in (\"_at\", \"_key\"):\n              if key in recipe:\n                  workshop_idx = recipe[key]\n                  break\n          if workshop_idx is not None:\n              # find nearest workshop of required type\n              coords = np.argwhere(grid[:, :, workshop_idx] > 0)\n              if coords.size:\n                  nearest_dist = np.inf\n                  nearest_coord = None\n                  for (x, y) in coords:\n                      d = abs(x - pos[0]) + abs(y - pos[1])\n                      if d < nearest_dist:\n                          nearest_dist = d\n                          nearest_coord = (x, y)\n                  if nearest_coord is not None:\n                      if nearest_coord == pos:\n                          target_action = 4  # USE to craft\n                      else:\n                          target_action = move_towards(nearest_coord)\n\n      # ---------- fallback random move ----------\n      if target_action is None:\n          target_action = np.random.choice([0, 1, 2, 3, 4])\n\n      # execute selected action\n      actions.append(int(target_action))\n      reward, done, obs = env.step(int(target_action))\n      if done:\n          break\n\n  # return the sequence of actions taken\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
