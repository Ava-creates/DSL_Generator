{"timestamp": "2025-11-03T17:56:43.281236", "function_name": "break_func", "function_body": "  return []", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-11-03T17:56:44.389578", "function_name": "break_func", "function_body": "  # ---------- break_func_v0 ----------\n  # Simple version: break any non\u2011grabbable adjacent cell if the agent\n  # possesses *any* tool (i.e. any inventory item that is not itself a\n  # non\u2011grabbable entity).\n  def _adjacent(pos, direction):\n      # direction: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n      if direction == 0:   # DOWN\n          return (pos[0], pos[1] + 1)\n      elif direction == 1: # UP\n          return (pos[0], pos[1] - 1)\n      elif direction == 2: # LEFT\n          return (pos[0] - 1, pos[1])\n      elif direction == 3: # RIGHT\n          return (pos[0] + 1, pos[1])\n      else:\n          return pos\n\n  state = env._current_state\n  pos = state.pos\n  target = _adjacent(pos, dir)\n\n  # bounds check\n  w, h = state.grid.shape[0], state.grid.shape[1]\n  if not (0 <= target[0] < w and 0 <= target[1] < h):\n      return []\n\n  cell = state.grid[target[0], target[1], :]\n  kinds = np.where(cell > 0)[0]\n  if len(kinds) == 0:\n      return []\n  kind = kinds[0]\n\n  # only non\u2011grabbable entities are considered obstacles\n  if kind not in env.world.non_grabbable_indices:\n      return []\n\n  # check if any tool is present in the inventory (any item that is not a\n  # non\u2011grabbable entity).  This heuristic works for the default recipes.\n  tool_mask = np.ones_like(state.inventory, dtype=bool)\n  for ng in env.world.non_grabbable_indices:\n      tool_mask[ng] = False\n  if not np.any(state.inventory[tool_mask] > 0):\n      return []\n\n  # success: face the direction (by issuing the movement action) and USE\n  return [dir, craft.USE]\n\n  # ---------- break_func_v1 ----------\n  # Improved version: try to match a specific tool to the obstacle.\n  state = env._current_state\n  pos = state.pos\n  target = _adjacent(pos, dir)\n\n  w, h = state.grid.shape[0], state.grid.shape[1]\n  if not (0 <= target[0] < w and 0 <= target[1] < h):\n      return []\n\n  cell = state.grid[target[0], target[1], :]\n  kinds = np.where(cell > 0)[0]\n  if len(kinds) == 0:\n      return []\n  kind = kinds[0]\n\n  if kind not in env.world.non_grabbable_indices:\n      return []\n\n  # map obstacle kind to the required tool (based on name heuristics)\n  idx = env.world.cookbook.index\n  obstacle_name = idx.get(kind)\n  required_tool = None\n  if obstacle_name == \"stone\":\n      required_tool = idx.get(\"hammer\")\n  elif obstacle_name == \"tree\":\n      required_tool = idx.get(\"axe\")\n  elif obstacle_name == \"water\":\n      required_tool = idx.get(\"boat\")\n\n  # if we know the required tool, check its availability\n  if required_tool is not None:\n      if state.inventory[required_tool] > 0:\n          return [dir, craft.USE]\n      else:\n          return []  # tool missing\n  # fallback: any tool suffices\n  tool_mask = np.ones_like(state.inventory, dtype=bool)\n  for ng in env.world.non_grabbable_indices:\n      tool_mask[ng] = False\n  if np.any(state.inventory[tool_mask] > 0):\n      return [dir, craft.USE]\n  return []\n\n  # ---------- break_func_v2 ----------\n  # Advanced version: repeatedly break obstacles in the given direction\n  # as long as a suitable tool is available.  Returns a sequence of\n  # actions: first turn towards `dir`, then a series of USE actions.\n  actions = [dir]  # turn/face the direction first\n  state = env._current_state\n  pos = state.pos\n\n  while True:\n      target = _adjacent(pos, dir)\n      w, h = state.grid.shape[0], state.grid.shape[1]\n      if not (0 <= target[0] < w and 0 <= target[1] < h):\n          break\n\n      cell = state.grid[target[0], target[1], :]\n      kinds = np.where(cell > 0)[0]\n      if len(kinds) == 0:\n          break\n      kind = kinds[0]\n\n      if kind not in env.world.non_grabbable_indices:\n          break\n\n      # tool check (same logic as in v1)\n      idx = env.world.cookbook.index\n      obstacle_name = idx.get(kind)\n      required_tool = None\n      if obstacle_name == \"stone\":\n          required_tool = idx.get(\"hammer\")\n      elif obstacle_name == \"tree\":\n          required_tool = idx.get(\"axe\")\n      elif obstacle_name == \"water\":\n          required_tool = idx.get(\"boat\")\n\n      has_tool = False\n      if required_tool is not None:\n          has_tool = state.inventory[required_tool] > 0\n      else:\n          tool_mask = np.ones_like(state.inventory, dtype=bool)\n          for ng in env.world.non_grabbable_indices:\n              tool_mask[ng] = False\n          has_tool = np.any(state.inventory[tool_mask] > 0)\n\n      if not has_tool:\n          break\n\n      # we can break this obstacle\n      actions.append(craft.USE)\n\n      # after breaking, the cell becomes empty; continue checking the next\n      # cell further along the same direction.\n      # (no need to modify the grid here; the returned actions will be\n      # executed later by the environment.)\n  return actions", "env_interactions": 0, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-11-03T17:57:23.279630", "function_name": "break_func", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Helper: BFS to the nearest target cell using only walkable (empty) cells\n  def bfs(start, targets, walkable, w, h):\n      \"\"\"Return list of actions (0\u20113) to reach any cell in targets, or None.\"\"\"\n      if start in targets:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      # direction order matches action indices: 0=DOWN,1=UP,2=LEFT,3=RIGHT\n      dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n      while q:\n          (x, y), path = q.popleft()\n          for a, (dx, dy) in enumerate(dirs):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited and (nx, ny) in walkable:\n                  if (nx, ny) in targets:\n                      return path + [a]\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  # Reset environment and fetch initial observation/state\n  obs = env.reset()\n  actions = []\n  state = env._current_state  # CraftState instance\n  w, h, _ = state.grid.shape\n\n  # Goal index and primitive requirements\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal).copy()  # {prim_idx: count}\n  if not needed:\n      # No recipe (primitive goal) \u2013 just collect it directly\n      needed = {goal: 1}\n\n  # Direction vectors matching action ids\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # Main loop: collect needed primitives\n  while True:\n      # Update inventory view\n      inv = state.inventory\n      # Check if all required primitives are satisfied\n      all_ok = True\n      for p_idx, req_cnt in needed.items():\n          if inv[p_idx] < req_cnt:\n              all_ok = False\n              break\n      if all_ok:\n          break\n\n      # Identify a primitive still missing\n      target_prim = None\n      for p_idx, req_cnt in needed.items():\n          if inv[p_idx] < req_cnt:\n              target_prim = p_idx\n              break\n\n      # Positions of remaining primitives of this type on the map\n      prim_pos = np.argwhere(state.grid[:, :, target_prim] == 1)\n      if prim_pos.size == 0:\n          # No more primitives of this type \u2013 abort loop\n          break\n\n      # Compute walkable (empty) cells\n      empty_mask = np.all(state.grid == 0, axis=2)\n      walkable = {tuple(coord) for coord in np.argwhere(empty_mask)}\n\n      # Build set of neighbour cells (walkable) adjacent to any target primitive\n      target_neighbors = set()\n      for (tx, ty) in prim_pos:\n          for dx, dy in dirs:\n              nx, ny = tx + dx, ty + dy\n              if (nx, ny) in walkable:\n                  target_neighbors.add((nx, ny))\n\n      # Find path to the closest neighbour cell\n      path = bfs(state.pos, target_neighbors, walkable, w, h)\n      if path is None:\n          # Cannot reach \u2013 abort\n          break\n\n      # Execute movement actions\n      for a in path:\n          reward, done, obs = env.step(a)\n          actions.append(a)\n          state = env._current_state\n\n      # Now we are adjacent to a primitive of the desired type.\n      # Determine which adjacent cell holds the primitive and face it.\n      faced = False\n      for a_dir, (dx, dy) in enumerate(dirs):\n          nx, ny = state.pos[0] + dx, state.pos[1] + dy\n          if 0 <= nx < w and 0 <= ny < h and state.grid[nx, ny, target_prim] == 1:\n              # Attempt a move into the occupied cell to set direction,\n              # then use the USE action to collect.\n              reward, done, obs = env.step(a_dir)\n              actions.append(a_dir)\n              state = env._current_state\n              reward, done, obs = env.step(4)  # USE\n              actions.append(4)\n              faced = True\n              break\n      if not faced:\n          # If for some reason we are not adjacent (should not happen), just try USE.\n          reward, done, obs = env.step(4)\n          actions.append(4)\n          state = env._current_state\n\n  # After gathering primitives, try to craft the final goal at its workshop.\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_kind = recipe.get('_at')\n  if workshop_kind is not None:\n      # Locate workshop cells\n      ws_pos = np.argwhere(state.grid[:, :, workshop_kind] == 1)\n      if ws_pos.size > 0:\n          # Compute walkable cells again (grid may have changed)\n          empty_mask = np.all(state.grid == 0, axis=2)\n          walkable = {tuple(coord) for coord in np.argwhere(empty_mask)}\n          # Build neighbour set around any workshop\n          ws_neighbors = set()\n          for (wx, wy) in ws_pos:\n              for dx, dy in dirs:\n                  nx, ny = wx + dx, wy + dy\n                  if (nx, ny) in walkable:\n                      ws_neighbors.add((nx, ny))\n          # Path to nearest neighbour of a workshop\n          path = bfs(state.pos, ws_neighbors, walkable, w, h)\n          if path is not None:\n              for a in path:\n                  reward, done, obs = env.step(a)\n                  actions.append(a)\n                  state = env._current_state\n              # Face the workshop (same trick as before) and USE to craft\n              faced = False\n              for a_dir, (dx, dy) in enumerate(dirs):\n                  nx, ny = state.pos[0] + dx, state.pos[1] + dy\n                  if 0 <= nx < w and 0 <= ny < h and state.grid[nx, ny, workshop_kind] == 1:\n                      reward, done, obs = env.step(a_dir)\n                      actions.append(a_dir)\n                      state = env._current_state\n                      reward, done, obs = env.step(4)  # USE to craft\n                      actions.append(4)\n                      faced = True\n                      break\n              if not faced:\n                  reward, done, obs = env.step(4)\n                  actions.append(4)\n                  state = env._current_state\n\n  # Return the list of actions taken\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
