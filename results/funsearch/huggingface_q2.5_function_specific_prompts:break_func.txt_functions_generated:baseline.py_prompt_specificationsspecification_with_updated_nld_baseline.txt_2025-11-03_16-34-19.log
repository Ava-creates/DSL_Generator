{"timestamp": "2025-11-03T16:50:46.163500", "function_name": "break_func", "function_body": "  # Initialize environment\n  obs = env.reset()\n  # Action mapping\n  action_map = env.action_specs()\n  use_action = action_map.get(\"USE\")\n  # Movement actions (order does not matter)\n  move_actions = [\n      action_map.get(\"UP\"),\n      action_map.get(\"DOWN\"),\n      action_map.get(\"LEFT\"),\n      action_map.get(\"RIGHT\"),\n  ]\n  # Filter out any None entries (in case the spec lacks some actions)\n  move_actions = [a for a in move_actions if a is not None]\n\n  # List to record the sequence of actions taken\n  taken_actions = []\n\n  # Safety limit: use the task's step limit if available, otherwise a large default\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  # Main loop: keep acting until the task is done or we hit the step limit\n  while not getattr(env, \"_is_done\", lambda: False)() and len(taken_actions) < max_steps:\n      state = env._current_state\n\n      # Try to use any adjacent grabbable entity (including primitives or crafted items)\n      chosen_action = None\n      if use_action is not None:\n          for kind_idx in getattr(env.world, \"grabbable_indices\", []):\n              if state.next_to(kind_idx):\n                  chosen_action = use_action\n                  break\n\n      # If nothing to use, move randomly\n      if chosen_action is None:\n          # Simple random walk; could be replaced with a smarter navigation policy\n          chosen_action = np.random.choice(move_actions)\n\n      # Record and execute the action\n      taken_actions.append(chosen_action)\n      reward, done, _ = env.step(chosen_action)\n\n      # If the environment reports done, break early\n      if done:\n          break\n\n  # Return the list of actions taken (can be used for evaluation or replay)\n  return taken_actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
