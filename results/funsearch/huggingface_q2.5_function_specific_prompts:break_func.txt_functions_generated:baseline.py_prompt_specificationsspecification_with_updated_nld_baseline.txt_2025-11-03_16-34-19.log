{"timestamp": "2025-11-03T18:30:53.798932", "function_name": "break_func", "function_body": "  actions = []\n  # reset already done\n  while not env._is_done():\n      state = env._current_state\n      inventory = state.inventory\n      if inventory[goal] > 0:\n          break\n      # Determine which primitive we still need\n      missing = {k: max(0, needed.get(k, 0) - inventory[k]) for k in needed}\n      target_kind = None\n      for k, cnt in missing.items():\n          if cnt > 0:\n              target_kind = k\n              break\n      if target_kind is None:\n          # all primitives collected \u2013 go to any workshop\n          workshop_idxs = env.world.workshop_indices\n          grid = state.grid\n          target_pos = None\n          for w in workshop_idxs:\n              locs = np.argwhere(grid[:, :, w] > 0)\n              if locs.size:\n                  target_pos = tuple(locs[0])\n                  break\n          if target_pos is None:\n              break\n      else:\n          # go to a cell that still contains the primitive\n          grid = state.grid\n          locs = np.argwhere(grid[:, :, target_kind] > 0)\n          if locs.size == 0:\n              break\n          # choose the closest one (Manhattan)\n          cur = np.array(state.pos)\n          dists = np.abs(locs - cur).sum(axis=1)\n          target_pos = tuple(locs[dists.argmin()])\n      # decide next primitive action\n      y, x = state.pos\n      ty, tx = target_pos\n      if abs(y - ty) + abs(x - tx) == 1:\n          act = 4   # USE\n      else:\n          if y < ty:\n              act = 0   # DOWN\n          elif y > ty:\n              act = 1   # UP\n          elif x > tx:\n              act = 2   # LEFT\n          else:\n              act = 3   # RIGHT\n      reward, done, _ = env.step(act)\n      actions.append(act)\n      if done:\n          break\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
