{"timestamp": "2025-10-28T23:33:23.770267", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  def _hash_state(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n  max_steps = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n      if len(cur_actions) >= max_steps:\n          continue\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:33:26.053946", "function_name": "make_arrow", "function_body": "  \"\"\"Generate a sequence of actions that makes an ``arrow`` in the given CraftWorld env.\n\n  The implementation performs a breadth\u2011first search over the deterministic\n  ``CraftState`` dynamics until the inventory contains at least one ``arrow``.\n  It works for any environment that follows the interface described in the\n  provided code base.\n\n  Args:\n      env: Either a ``CraftLab`` instance or a raw ``CraftScenario``/``CraftWorld``.\n\n  Returns:\n      List[int]: Action indices (0\u20114) that achieve the goal, or an empty list if\n      no plan is found within the search limits.\n  \"\"\"\n  # -------------------------------------------------------------------------\n  # Resolve the underlying scenario and world objects from the possibly wrapped\n  # environment instance.\n  # -------------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # -------------------------------------------------------------------------\n  # Identify the index of the target item ``arrow`` using the cookbook.\n  # -------------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      # The recipe set does not contain an arrow; nothing to do.\n      return []\n\n  # -------------------------------------------------------------------------\n  # Obtain the initial state of the episode.\n  # -------------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # -------------------------------------------------------------------------\n  # Helper to produce a hashable representation of a state.  The grid can be\n  # large, but ``tobytes`` provides a compact immutable view suitable for a set.\n  # -------------------------------------------------------------------------\n  def _hash_state(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # -------------------------------------------------------------------------\n  # Breadth\u2011first search over the deterministic transition graph.\n  # -------------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  frontier = deque([Node(init_state, [])])\n  visited = {_hash_state(init_state)}\n\n  # Safety limits \u2013 these can be tuned for larger maps.\n  MAX_STEPS = 400          # maximum length of a candidate plan\n  MAX_EXPANSIONS = 10000   # total number of states examined\n\n  n_actions = getattr(world, \"n_actions\", 5)  # usually 5 (4 moves + USE)\n  expansions = 0\n\n  while frontier and expansions < MAX_EXPANSIONS:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: does the inventory contain the arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue  # prune overly long branches\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n      expansions += 1\n\n  # No viable plan found within the limits.\n  return []", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T23:33:39.777826", "function_name": "make_arrow", "function_body": "  # Retrieve world and target item index\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over (grid, inventory, position, direction) states\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      # Combine position, direction, inventory contents and a hash of the grid\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  max_plan_len = 500          # safety bound on plan length\n  max_expanded = 20000        # safety bound on number of expanded nodes\n  n_actions = getattr(world, \"n_actions\", 5)\n  expanded = 0\n\n  while frontier and expanded < max_expanded:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n      expanded += 1\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= max_plan_len:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # If no plan found within limits, return empty list\n  return []", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T23:33:55.517811", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over (state, action\u2011sequence) pairs\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      # Position, direction, inventory contents and the mutable grid uniquely identify a state\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  max_steps = 400                # safety cap to avoid infinite search\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test \u2013 have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= max_steps:\n          continue\n\n      # Expand neighbours by trying every possible action\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
