{"timestamp": "2025-10-29T00:12:56.901365", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", None)\n  if scenario is None:\n      scenario = env\n  world = getattr(scenario, \"world\", None)\n  if world is None:\n      world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # combine position, direction, inventory and grid into a hashable key\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_DEPTH = 400            # limit search depth to keep it tractable\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # goal test: have we crafted at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_DEPTH:\n          continue\n\n      # expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # no plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:13:24.932648", "function_name": "make_arrow", "function_body": "  # Ensure we have a fresh state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Access world and cookbook\n  world = getattr(env, \"world\", None) or getattr(state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # Goal: arrow\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Required primitives for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # Working copies of grid and position\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions that brings the\n  # agent from `start` to a cell adjacent to any cell in `targets`.\n  # The search treats any occupied cell (grid[...,k] > 0) as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency (including being on the target)\n          for tx, ty in target_set:\n              if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable target\n      return []\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Locate remaining instances of this primitive\n          locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # No more of this primitive on the map; break and let the episode fail later\n              break\n          # Choose the closest location (Manhattan distance)\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_loc = locations[0]\n\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [target_loc])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up the primitive (USE)\n          actions.append(USE)\n          # Update our simulated grid to reflect the pickup\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # Find all workshop cells of that type\n      workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          # Choose nearest workshop\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = workshop_locs[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [ws_target])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft (USE)\n          actions.append(USE)\n  else:\n      # No explicit workshop \u2013 attempt crafting at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:13:26.058032", "function_name": "make_arrow", "function_body": "  # Ensure we have a fresh state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Access world and cookbook\n  world = getattr(env, \"world\", None) or getattr(state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"World object not found in the environment.\")\n  cookbook = world.cookbook\n\n  # Goal: make an arrow\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow (primitive index -> count)\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # Current grid and agent position\n  grid = state.grid.copy()\n  pos = tuple(state.pos)          # (x, y)\n\n  # Action IDs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions that brings the\n  # agent from `start` to a cell adjacent to any of `targets`.\n  # The search treats any non\u2011zero cell as blocked, except the target\n  # cells themselves (since we only need to be next to them).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)      # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency (including standing on a target)\n          for tx, ty in target_set:\n              if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  # Allow stepping onto a target cell (it will be handled by adjacency check)\n                  if not occupied[nx, ny] or (nx, ny) in target_set:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found\n      return []\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Locate remaining cells containing this primitive\n          locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not locs:\n              # No more instances; break (the episode will later fail if needed)\n              break\n          # Choose the closest location (Manhattan distance)\n          locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_loc = locs[0]\n\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [target_loc])\n          actions.extend(path)\n          # Update simulated position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up the primitive\n          actions.append(USE)\n          # Mark the cell as empty in our simulated grid\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be name string or integer)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      # Find all workshop cells of this type\n      ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          # Choose nearest workshop\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_locs[0]\n\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Craft at the workshop\n          actions.append(USE)\n  else:\n      # No explicit workshop \u2013 attempt crafting at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:14:02.991812", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions to reach a cell adjacent to any target.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, blocked):\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent (Manhattan distance 1) to a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # no path found\n\n  # ------------------------------------------------------------------\n  # Helper: apply a list of actions to a position.\n  # ------------------------------------------------------------------\n  def _apply(pos, actions):\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its Cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world through the current state.\n      cur = getattr(env, \"_current_state\", None)\n      if cur is not None:\n          world = getattr(cur, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal: make an arrow.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in recipe index.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Planning state copies.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  blocked = np.any(grid, axis=2)             # occupied cells (bool)\n  plan = []                                   # accumulated actions\n  harvested = set()                           # cells already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, req_cnt in primitives_needed.items():\n      # All cells currently containing this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance to current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= req_cnt:\n              break\n          if cell in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_adjacent(pos, [cell], blocked)\n          plan.extend(path)\n          pos = _apply(pos, path)\n\n          # Pick it up.\n          plan.append(USE)\n\n          # Update planning structures: remove the primitive from the grid.\n          grid[cell[0], cell[1], prim_idx] = 0\n          blocked = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], blocked)\n          plan.extend(path)\n          pos = _apply(pos, path)\n          plan.append(USE)  # craft at the workshop\n      else:\n          # No visible workshop; attempt to craft in place.\n          plan.append(USE)\n  else:\n      # No specific workshop required.\n      plan.append(USE)\n\n  return plan", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:14:04.149702", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants \u2013 these are the same for all CraftWorld environments.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell orthogonally adjacent to any coordinate in\n  # `targets`.  Cells where `blocked` is True are treated as impassable.\n  # --------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets, blocked):\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent (Manhattan distance == 1) to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell \u2013 return empty list.\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: apply a list of actions to a position, returning the new\n  # position (ignoring direction changes \u2013 they are irrelevant for path).\n  # --------------------------------------------------------------\n  def _apply_actions(pos, actions):\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # --------------------------------------------------------------\n  # Locate the underlying CraftWorld instance and its Cookbook.\n  # --------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state.\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # --------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # --------------------------------------------------------------\n  # Determine the goal index for \"arrow\".\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements: {primitive_index: count}\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # --------------------------------------------------------------\n  # Planning state copies.\n  # --------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # (W, H, n_kinds)\n  blocked = np.any(grid, axis=2)             # occupied cells (bool)\n  plan = []                                   # accumulated actions\n  harvested = set()                           # primitives already taken\n\n  # --------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # --------------------------------------------------------------\n  for prim_idx, required_cnt in primitives_needed.items():\n      # Locate all cells currently containing this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance to current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= required_cnt:\n              break\n          if cell in harvested:\n              continue\n          # Move to a cell adjacent to the primitive.\n          path = _bfs_to_adjacent(pos, [cell], blocked)\n          plan.extend(path)\n          pos = _apply_actions(pos, path)\n\n          # Pick up the primitive.\n          plan.append(USE)\n\n          # Update planning structures.\n          grid[cell[0], cell[1], prim_idx] = 0\n          blocked = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # --------------------------------------------------------------\n  # Locate the required workshop (if any) and craft the arrow.\n  # --------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string or an integer).\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_to_adjacent(pos, [target_ws], blocked)\n          plan.extend(path)\n          pos = _apply_actions(pos, path)\n          plan.append(USE)   # craft at the workshop\n      else:\n          # No visible workshop \u2013 attempt to craft where we are.\n          plan.append(USE)\n  else:\n      # No specific workshop required.\n      plan.append(USE)\n\n  return plan", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:14:31.822379", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects from the provided environment\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\" in the cookbook\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 800          # safety cutoff for plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long trajectories\n      if len(cur_actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:14:47.549115", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 500  # safety cutoff\n  n_actions = getattr(world, \"n_actions\", 5)  # usually 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long trajectories\n      if len(cur_actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:15:18.505424", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Action identifiers \u2013 must match CraftWorld ordering.\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that stops when we reach a cell adjacent to any target.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from `start` to a cell adjacent to any `targets`.\"\"\"\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if occupied[nx, ny] or (nx, ny) in visited:\n                  continue\n              new_path = path + [act]\n              # If this new cell is adjacent to any target, we are done.\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell \u2013 return empty (caller may handle).\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the current state / world objects from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Likely a CraftLab wrapper \u2013 state stored in _current_state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # env may be CraftWorld / CraftScenario \u2013 ensure we have a state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use (or craft at workshop later).\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity occupies the cell\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells containing this primitive that we haven't taken yet.\n          cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not cells:\n              # No more of this primitive left \u2013 abort early.\n              break\n\n          # Choose the closest cell (Manhattan distance).\n          cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = cells[0]\n\n          # Plan a path to a cell adjacent to the target.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 after pickup the cell becomes empty.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          # Choose the nearest workshop.\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No visible workshop \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 craft wherever we are.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:15:19.645863", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action identifiers \u2013 must match CraftWorld ordering.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions that moves from `start` to a cell adjacent to any of `targets`.\"\"\"\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency to any target\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Retrieve current state and world from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Likely a CraftLab \u2013 state stored in _current_state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # env may be CraftWorld / CraftScenario \u2013 ensure we have a state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  # If the recipe has no ingredients, the item is a primitive \u2013 just use it.\n  if not primitives_needed:\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity occupies the cell\n\n  actions = []\n  harvested = set()                     # Cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells containing this primitive that we have not harvested yet.\n          cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not cells:\n              # No more of this primitive available; abort early.\n              break\n\n          # Choose the closest cell (Manhattan distance).\n          cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = cells[0]\n\n          # Plan a path to a cell adjacent to the target.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          # Choose nearest workshop.\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No visible workshop \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 craft wherever we are.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:15:46.504872", "function_name": "make_arrow", "function_body": "  # Resolve the scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the integer index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial CraftState for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"\n      Produce a hashable representation of a CraftState.\n      Includes position, direction, inventory contents, and the full grid.\n      \"\"\"\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  # Bread\u2011first search over state space\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 1000                     # safety bound\n  n_actions = getattr(world, \"n_actions\", 5) # default action count (incl. USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Enforce a maximum plan length to keep the search tractable\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:16:02.185125", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  def _state_key(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n  MAX_PLAN_LENGTH = 800\n  n_actions = getattr(world, \"n_actions\", 5)\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
