{"timestamp": "2025-10-28T17:23:21.215399", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects from the given environment\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Resolve the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial CraftState for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Helper to create a hashable representation of a CraftState (for visited set)\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:23:36.822613", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:24:07.874302", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  # Work on a mutable copy of the grid to reflect collected items\n  grid = state.grid.copy()             # shape (W, H, n_kinds)\n\n  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is considered blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from *start* to *goal* while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found; return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing *kind_idx* (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to *cell* not in *avoid*.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                 # (y, x)\n  taken = set()                       # primitives already collected\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions  # primitive missing; abort early\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=taken)\n          if adj is None:\n              return actions  # no place to stand; abort\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked move in the correct direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation\n          grid[target[0], target[1], prim_idx] = 0\n          taken.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand on a free neighbour of the workshop if possible\n          ws_adj = adjacent_free(ws_cell, avoid=taken)\n          if ws_adj is None:\n              ws_adj = ws_cell  # fall back to standing directly on it\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:24:09.011354", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment to obtain fresh state objects.\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (as defined by CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is considered blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # Reconstruct actions.\n              rev_actions = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev_actions.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev_actions.append(UP)\n                  elif cur[1] == px + 1:\n                      rev_actions.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev_actions.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev_actions))\n          for dy, dx, _ in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found.\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to ``cell`` not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                 # (y, x)\n  collected_cells = set()             # primitives already taken\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, avoid=collected_cells)\n          if adj is None:\n              # No free neighbour; cannot safely collect.\n              return actions\n\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked move in that direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid representation.\n          grid[target[0], target[1], prim_idx] = 0\n          collected_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand on a free neighbour of the workshop if possible.\n          ws_adj = adjacent_free(ws_cell, avoid=collected_cells)\n          if ws_adj is None:\n              # Fallback: stand directly on the workshop cell.\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move).\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:24:31.826349", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined by CraftLab)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs(start, targets, grid):\n      \"\"\"Bread\u2011first search returning a list of actions that moves the\n      agent from ``start`` to a cell adjacent to any cell in ``targets``.\n      \"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)          # any occupied cell blocks movement\n      sx, sy = start\n\n      # already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []   # unreachable\n\n  # ------------------------------------------------------------------\n  # Initialise state\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy of world grid\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index stored in the task definition\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (recursive expansion)\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive unavailable \u2013 abort planning\n              return plan\n\n          # Move adjacent to the nearest primitive\n          path = bfs(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Update position according to the path taken\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive\n          plan.append(ACTION_USE)\n\n          # Find which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              break   # safety break\n\n          # Update local grid copy and decrement count\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (name or integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:24:32.954811", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined by CraftLab)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search returning a list of actions that moves the agent\n      from ``start`` to a cell adjacent to any cell in ``targets`` while\n      avoiding blocked cells.\n      \"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)          # any occupied cell blocks movement\n      sx, sy = start\n\n      # Already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                 # mutable copy of world grid\n  pos = tuple(state.pos)                   # (x, y)\n\n  # Goal index (stored in the task definition)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (recursive expansion)\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # locate all cells that currently contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # primitive unavailable \u2013 abort planning\n              return plan\n\n          # compute path to the nearest reachable primitive (adjacent)\n          path = bfs(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # simulate movement to keep ``pos`` up\u2011to\u2011date\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # pick up the primitive\n          plan.append(ACTION_USE)\n\n          # find which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              break   # unexpected; avoid infinite loop\n\n          # update local grid copy and decrement needed count\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be a name or an integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:24:49.838918", "function_name": "make_arrow", "function_body": "  # action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: move current position (list [x, y]) towards target (list [x, y])\n  # ----------------------------------------------------------------------\n  def _move_to(cur, target, seq):\n      while cur[0] != target[0] or cur[1] != target[1]:\n          if cur[0] < target[0]:\n              seq.append(RIGHT); cur[0] += 1\n          elif cur[0] > target[0]:\n              seq.append(LEFT);  cur[0] -= 1\n          elif cur[1] < target[1]:\n              seq.append(DOWN);  cur[1] += 1\n          elif cur[1] > target[1]:\n              seq.append(UP);    cur[1] -= 1\n\n  # ----------------------------------------------------------------------\n  # Helper: locate nearest cell that currently contains at least one of\n  # the given kind index. Returns [x, y] or None.\n  # ----------------------------------------------------------------------\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Determine starting position (use the state if already created,\n  # otherwise fall back to the scenario's init position).\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid so we can \u201cremove\u201d items\n  # once they have been collected.\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n  goal_idx = env.task.goal\n\n  # ----------------------------------------------------------------------\n  # 1. Gather all primitive resources needed for the goal.\n  # ----------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Required primitive missing \u2013 abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)\n          # Mark the item as taken.\n          grid[target[1], target[0], kind_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # 2. If the recipe specifies a workshop, go there and craft.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:24:50.982476", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(pos, target, seq):\n      \"\"\"Append moves to seq to bring pos (list [x,y]) to target (list [x,y]).\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return [x,y] of nearest cell containing kind_idx, or None.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # Determine current position\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Copy the static grid to track which items have been collected\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Required primitive not found; abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)\n          # Mark the item as taken in our copy of the grid.\n          grid[target[1], target[0], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:25:15.905668", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan path from src to dst as a list of actions\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind (Manhattan)\n  # ------------------------------------------------------------------\n  def _nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify goal index for \"arrow\"\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:  # not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = _nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive not present on map \u2013 abort early\n              return action_seq\n          # Move to the primitive cell\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick up the primitive\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:25:17.048914", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions (DOWN/UP/LEFT/RIGHT) that moves from src to dst.\"\"\"\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  def _nearest_cell(grid, kind_idx, start):\n      \"\"\"Find the nearest cell (Manhattan) that contains at least one of kind_idx.\"\"\"\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  def _any_cell(grid, kind_idx):\n      \"\"\"Return any cell containing kind_idx, or None.\"\"\"\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the index of the target item (\"arrow\")\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:  # not defined in the cookbook\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are needed for a single arrow\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(arrow_idx)  # dict {kind_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting multiplicities)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = _nearest_cell(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive absent \u2013 abort early\n              return actions\n          # Move to the primitive cell\n          for a in _manhattan_path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              actions.append(a)\n              if done:\n                  return actions\n          # Pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          actions.append(USE)\n          if done:\n              return actions\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, go there and craft the item\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any_cell(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _manhattan_path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              actions.append(a)\n              if done:\n                  return actions\n          # Craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:25:52.493973", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined by CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain handles to the underlying objects.\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Fallback path: straight Manhattan moves ignoring obstacles.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def bfs_path(start, goal, walkable):\n      \"\"\"A*\u2011like BFS returning a list of movement actions from start to goal.\n      `walkable(y, x)` must return True iff the agent can occupy (y, x).\"\"\"\n      if start == goal:\n          return []\n      H, W = grid.shape[0], grid.shape[1]\n      q = deque([start])\n      came_from = {start: None}\n      action_from = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          cy, cx = cur\n          for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)):\n              ny, nx = cy + dy, cx + dx\n              if 0 <= ny < H and 0 <= nx < W and walkable(ny, nx):\n                  nxt = (ny, nx)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = act\n                      q.append(nxt)\n      else:\n          return None  # no path found\n\n      # reconstruct actions\n      actions_rev = []\n      cur = goal\n      while cur != start:\n          act = action_from[cur]\n          actions_rev.append(act)\n          cur = came_from[cur]\n      actions_rev.reverse()\n      return actions_rev\n\n  def nearest_cell(kind_idx, from_pos):\n      \"\"\"Return coordinates of the nearest cell containing `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[np.argmin(dists)])\n\n  def empty_adjacent(pos):\n      \"\"\"Return an empty neighbour of `pos` (or None).\"\"\"\n      y, x = pos\n      H, W = grid.shape[0], grid.shape[1]\n      for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n          ny, nx = y + dy, x + dx\n          if 0 <= ny < H and 0 <= nx < W:\n              if np.all(grid[ny, nx, :] == 0):\n                  return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest_cell(prim_idx, cur_pos)\n          if target is None:\n              # No more primitives of this type \u2013 abort planning.\n              return actions\n\n          adj = empty_adjacent(target)\n          if adj is None:\n              # If no empty neighbour, stand on the primitive cell after it is taken.\n              adj = target\n\n          # Walk to the adjacent (or same) cell.\n          def walkable(y, x):\n              # Cannot step on any occupied cell.\n              return np.all(grid[y, x, :] == 0) or (y, x) == adj\n\n          path = bfs_path(cur_pos, adj, walkable)\n          if path is None:\n              path = manhattan_path(cur_pos, adj)\n          actions.extend(path)\n          cur_pos = adj\n\n          # Face the primitive (move towards it; will be blocked, but direction changes).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update grid to reflect that the primitive has been taken.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = nearest_cell(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          def ws_walkable(y, x):\n              # All cells must be empty except the goal workshop cell.\n              return (y, x) == ws_cell or np.all(grid[y, x, :] == 0)\n\n          path = bfs_path(cur_pos, ws_cell, ws_walkable)\n          if path is None:\n              path = manhattan_path(cur_pos, ws_cell)\n          actions.extend(path)\n          cur_pos = ws_cell\n\n  # Trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 33, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:25:53.636583", "function_name": "make_arrow", "function_body": "  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and obtain the underlying state objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` using a Manhattan walk.\n      No obstacle checking is performed.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop).\n      Returns the coordinate (y, x) or ``None`` if not found.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for 'arrow' and the required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell (prefer one that lets us face the primitive).\n          adj = None\n          neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          for ny, nx in neighbours:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour \u2013 fallback to the primitive cell itself.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Turn to face the primitive (use a movement action that will be blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:26:16.017364", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move from cur (x, y) to target (x, y) using Manhattan steps.\n  # The actions list is extended in\u2011place.\n  # ------------------------------------------------------------------\n  def _move(cur, target, act_list):\n      x, y = cur\n      tx, ty = target\n      while x < tx:\n          act_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          act_list.append(LEFT)\n          x -= 1\n      while y < ty:\n          act_list.append(DOWN)\n          y += 1\n      while y > ty:\n          act_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Access world and current state from the Lab wrapper.\n  # ------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Determine the index of the goal item (arrow).\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      # fallback to the goal stored in the task if present\n      goal_idx = getattr(getattr(env, \"task\", None), \"goal\", None)\n      if goal_idx is None:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'.\")\n\n  # ------------------------------------------------------------------\n  # Primitive requirements for the goal (dict {prim_idx: count}).\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Make a mutable copy of the grid counts for planning so we don't\n  # repeatedly pick from the same cell.\n  planning_grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (may need >1 of a kind).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      while needed > 0:\n          # Find cells that currently contain this primitive.\n          locations = np.argwhere(planning_grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more instances available \u2013 stop trying to collect.\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          nearest = tuple(locations[dists.argmin()])\n\n          # Move to that cell.\n          cur_pos = _move(cur_pos, nearest, actions)\n\n          # How many units are available on that cell?\n          available = int(planning_grid[nearest[0], nearest[1], prim_idx])\n          take = min(available, needed)\n\n          # Pick up the required amount (one USE per unit).\n          for _ in range(take):\n              actions.append(USE)\n\n          # Update planning grid and remaining need.\n          planning_grid[nearest[0], nearest[1], prim_idx] -= take\n          needed -= take\n\n  # ------------------------------------------------------------------\n  # After gathering primitives, go to the appropriate workshop and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  # The workshop key may be stored under \"_key\" or \"_at\" depending on the YAML.\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n              workshop_pos = tuple(ws_locs[dists.argmin()])\n              cur_pos = _move(cur_pos, workshop_pos, actions)\n              actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:26:17.151580", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (as used by CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move from cur (x, y) to target (x, y) using Manhattan steps.\n  # The actions are appended to the provided list.\n  # ------------------------------------------------------------------\n  def _move(cur, target, act_list):\n      x, y = cur\n      tx, ty = target\n      while x < tx:\n          act_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          act_list.append(LEFT)\n          x -= 1\n      while y < ty:\n          act_list.append(DOWN)\n          y += 1\n      while y > ty:\n          act_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Access world and current state from the Lab wrapper.\n  # ------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Determine the index of the goal item ('arrow').\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      goal_idx = getattr(getattr(env, \"task\", None), \"goal\", None)\n      if goal_idx is None:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'.\")\n\n  # ------------------------------------------------------------------\n  # Primitive requirements for the goal (dict {prim_idx: count}).\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (may need >1 of a kind).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      while needed > 0:\n          # Find all cells currently containing this primitive.\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No instances left on the map \u2013 give up on this primitive.\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          nearest = tuple(locations[dists.argmin()])\n\n          # Move to that cell.\n          cur_pos = _move(cur_pos, nearest, actions)\n\n          # How many units are available on that cell?\n          available = int(state.grid[nearest[0], nearest[1], prim_idx])\n          take = min(available, needed)\n\n          # Pick up the required amount.\n          for _ in range(take):\n              actions.append(USE)\n\n          needed -= take\n          # Note: we do not update the simulated grid; planning only.\n\n  # ------------------------------------------------------------------\n  # After gathering primitives, go to the appropriate workshop and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n              workshop_pos = tuple(ws_locs[dists.argmin()])\n              cur_pos = _move(cur_pos, workshop_pos, actions)\n              actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 18, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:26:47.659018", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:27:03.315139", "function_name": "make_arrow", "function_body": "  import collections\n\n  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  Node = collections.namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Include position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = collections.deque([Node(init_state, [])])\n\n  MAX_STEPS = 400\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:27:28.302800", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined in CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions moving from ``start`` to a cell adjacent\n      (Manhattan distance 1) to any of ``targets`` while avoiding blocked cells.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Cells occupied by any non\u2011grabbable entity are considered blocked.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise state information.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()            # mutable copy for simulation\n  pos = tuple(state.pos)              # (x, y)\n\n  # Goal index is stored in the task definition.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Determine primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present on the map \u2013 abort planning.\n              return plan\n\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update local grid copy and decrement need.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:27:29.428010", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper constants and functions\n  # ----------------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search that returns a list of actions moving the agent\n      from ``start`` to a cell adjacent (Manhattan distance 1) to any of\n      the ``targets`` while avoiding blocked cells (non\u2011grabbable entities).\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # cells occupied by any non\u2011grabbable entity are considered blocked\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise state information\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                 # mutable copy of the world grid\n  pos = tuple(state.pos)                   # (x, y)\n\n  # Goal index is stored in the task (env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Determine all primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ----------------------------------------------------------------------\n  for kind_idx, remaining in needed.items():\n      while remaining > 0:\n          # Find cells that currently contain this primitive.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present on the map \u2013 abort planning.\n              return plan\n\n          # Compute a path to the nearest reachable primitive (adjacent).\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update the agent's position.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update the simulated grid and decrement the requirement.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          remaining -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      # Locate cells that contain the workshop.\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to the workshop.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  # Return the full action sequence.\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:27:48.166799", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell adjacent (Manhattan distance 1) to any of `targets`.\n  # Cells with any non\u2011zero kind are treated as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where blocked\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Explore neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position \u2013 return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world, cookbook and goal information (hard\u2011coded to \"arrow\")\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if needed)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid               # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells currently holding this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Greedy nearest\u2011first ordering\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Update simulated position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its workshop (if the recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be name or integer)\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Locate workshop cells\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft using the workshop\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:27:49.302989", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent to any coordinate in `targets`.\n  # Cells containing any entity are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where a cell is non\u2011empty\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent (Manhattan distance 1) to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Explore 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list (will likely fail later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Identify world, cookbook and the goal (hard\u2011coded to \"arrow\").\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state.\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary) and fetch grid.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # primitives already taken\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive, greedy nearest\u2011first.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently holding this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up.\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int).\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:28:07.105442", "function_name": "make_arrow", "function_body": "  # Reset environment to start a fresh episode\n  env.reset()\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Mapping from action name to integer id used by the environment\n  act_map = env.action_specs()\n\n  # Movement deltas for each cardinal action\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (including diagonally)\n  # to any cell in `targets`.  Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If we are adjacent (Chebyshev distance <= 1) to any target, stop\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # cell must be empty (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act]))\n      return None  # No reachable adjacent cell\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh current state\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells containing the required primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 abort this collection\n              break\n\n          # Find a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 abort\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n\n          # Pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after collecting primitives\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate workshop cells of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          # Plan a path to the workshop (adjacent cell)\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n\n          # Use action at the workshop to craft the item\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the complete action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:28:08.234817", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # Identify goal item and its recipe\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Mapping from action name to integer ID used by the env\n  act_map = env.action_specs()\n\n  # Directions for movement actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (including diagonally) to any\n  # cell in `targets`.  Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell (Chebyshev distance <= 1)\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Can only walk through empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act]))\n      return None  # No reachable adjacent cell\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh dynamic state\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate cells containing the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive unavailable \u2013 abort collection\n              break\n\n          # Find path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n\n          # Pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after collection\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate workshop cells of the needed type\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n\n          # Perform crafting action\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the compiled action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:28:34.906178", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial game state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Create a hashable representation of a state for visited\u2011set tracking\n  def _state_hash(st):\n      return (\n          st.pos,                     # position tuple\n          st.dir,                     # facing direction\n          tuple(st.inventory.tolist()),  # inventory vector\n          st.grid.tobytes(),          # full grid layout (changes when items are taken/crafted)\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Safety limits\n  MAX_PLAN_LEN = 500\n  n_actions = getattr(world, \"n_actions\", 5)   # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Trim overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:28:50.643822", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Include position, direction, inventory, and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500  # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typical action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:29:18.603961", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash includes position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400  # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typical action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:29:34.406688", "function_name": "make_arrow", "function_body": "  import collections\n\n  # Get scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \u201carrow\u201d in the cookbook\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  Node = collections.namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Include position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = collections.deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:29:57.928505", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:29:59.065678", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n  state = env._current_state\n  pos = tuple(state.pos)                     # current agent position\n  goal = env.task.goal                        # index of the desired item\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # copy of the grid to simulate removals after picking up primitives\n  grid = state.grid.copy()\n  width, height = grid.shape[:2]\n\n  # cells that are permanently blocked (non\u2011grabbable entities such as water, stone)\n  non_grab = list(env.world.non_grabbable_indices)\n  if non_grab:\n      base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      base_blocked = np.zeros((width, height), dtype=bool)\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions from start to target.\n  # If allow_target_block=True the target cell may be occupied (primitive or workshop)\n  # ----------------------------------------------------------------------\n  def bfs_path(start, target, allow_target_block=False):\n      blocked = base_blocked.copy()\n      if allow_target_block:\n          blocked[target[0], target[1]] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n      if target not in came_from:\n          return None\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_from[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Helper: simple Manhattan path (used as fallback)\n  # ----------------------------------------------------------------------\n  def manhattan_path(start, target):\n      moves = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate remaining instances of this primitive in the simulated grid\n          locs = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locs:\n              # no more instances; break (should not happen in a solvable scenario)\n              break\n          # choose the closest instance by Manhattan distance\n          target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)                     # pick up the primitive\n          # update simulated state\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0      # remove primitive from grid\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the appropriate workshop and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs_path(pos, target_ws, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop\n  else:\n      # No specific workshop; just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:30:40.563145", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # directions: (dy, dx, action)\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_blocked(y, x):\n      # Any non\u2011zero entry means the cell is occupied.\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell that contains the given kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of ``cell`` (or None if none).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # --------------------------------------------------------------\n  # Determine the goal index for 'arrow' and its recipe.\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n  collected = set()    # cells from which we already took a primitive\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # --------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (blocked move only changes direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid so the cell becomes free.\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # --------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # --------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional).\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:30:41.716241", "function_name": "make_arrow", "function_body": "  # reset environment and obtain useful handles\n  env.reset()\n  state = env._current_state            # CraftState\n  world = env.world                      # CraftWorld\n  grid = state.grid.copy()               # mutable copy of the grid\n\n  # action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[0], grid.shape[1]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any kind occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct action list\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # no path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive missing \u2013 abort early\n              return actions\n\n          # choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=set())\n          if adj is None:\n              # fallback: stand directly on the primitive cell\n              adj = target\n\n          # move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # orient towards the primitive (blocked move updates direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # pick up the primitive\n          actions.append(USE)\n\n          # update internal grid: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=set())\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # face the workshop\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:31:18.254823", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions moving from start to a cell\n  # adjacent (Manhattan distance == 1) to any target location.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)  # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Expand neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook objects from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers keep the world inside the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal is the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitives required to craft the goal (including counts).\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locations of this primitive on the grid.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark cell as empty for future planning.\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Find workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft the arrow.\n          actions.append(USE)\n      else:\n          # No visible workshop; attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:31:19.385598", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices used by CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of actions moving the agent from `start`\n  # to a cell adjacent (Manhattan distance \u2264 1) to any location in\n  # `targets`.  Cells containing any non\u2011zero kind are treated as\n  # obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop when adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance from the environment.\")\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Current position and a mutable copy of the grid for planning.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from the current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Remove the primitive from the planning grid.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or an integer).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n      # Use the workshop to craft the arrow.\n      actions.append(USE)\n  else:\n      # No specific workshop required; just use at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:31:49.104957", "function_name": "make_arrow", "function_body": "  # reset environment and get handles\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  # action constants as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  # --------------------------------------------------------------------\n  # Helper: BFS to the nearest cell containing a given kind.\n  # The search walks only through empty cells, but it may step onto the\n  # goal cell even if that cell is occupied (e.g. contains the primitive).\n  # Returns (target_position, action_path) or (None, None) if not found.\n  # --------------------------------------------------------------------\n  def _nearest_of_kind(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      from collections import deque\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (r, c), path = q.popleft()\n          if grid[r, c, kind_idx] > 0:          # found the item\n              return (r, c), path\n          for act, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:\n                  # can walk on empty cells; can also step onto the goal later\n                  if np.all(grid[nr, nc, :] == 0):\n                      visited.add((nr, nc))\n                      q.append(((nr, nc), path + [act]))\n      return None, None\n\n  # --------------------------------------------------------------------\n  # Helper: BFS path from current position to a specific target cell.\n  # Allows stepping onto the target even if it is occupied.\n  # Returns a list of actions or None if unreachable.\n  # --------------------------------------------------------------------\n  def _bfs_path(grid, start, goal):\n      if start == goal:\n          return []\n      h, w, _ = grid.shape\n      from collections import deque\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (r, c), path = q.popleft()\n          for act, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:\n                  # allow moving onto the goal cell regardless of occupancy\n                  if (nr, nc) == goal or np.all(grid[nr, nc, :] == 0):\n                      if (nr, nc) == goal:\n                          return path + [act]\n                      visited.add((nr, nc))\n                      q.append(((nr, nc), path + [act]))\n      return None\n\n  # --------------------------------------------------------------------\n  # Identify the index of the target item (\"arrow\").\n  # --------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # not present in this world\n      return []\n\n  # --------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # --------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # --------------------------------------------------------------------\n  # Collect each required primitive, respecting the required count.\n  # --------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target_pos, path_to_target = _nearest_of_kind(state.grid, prim_idx, state.pos)\n          if target_pos is None:\n              # primitive not found \u2013 abort early\n              return action_seq\n          # move to the primitive\n          for a in path_to_target:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # --------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow.\n  # --------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_pos, path_to_ws = _nearest_of_kind(state.grid, workshop_idx, state.pos)\n      if ws_pos is not None:\n          for a in path_to_ws:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # craft at workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n  else:\n      # No specific workshop \u2013 attempt crafting in place\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:31:50.234779", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the initial state/world handles.\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Action identifiers as defined in CraftLab.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  def bfs_path(start, target_kind):\n      \"\"\"Return a list of actions that moves the agent from ``start`` to the\n      nearest cell containing ``target_kind``.  The search walks through empty\n      cells and may step onto the goal cell even if it is occupied.\"\"\"\n      h, w, _ = state.grid.shape\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (r, c), path = q.popleft()\n          if state.grid[r, c, target_kind] > 0:\n              return path\n          for act, (dr, dc) in ACTIONS:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:\n                  # Allow stepping onto the target even if occupied.\n                  if state.grid[nr, nc, target_kind] > 0 or np.all(state.grid[nr, nc, :] == 0):\n                      visited.add((nr, nc))\n                      q.append(((nr, nc), path + [act]))\n      return None\n\n  def bfs_to_workshop(start, workshop_kind):\n      \"\"\"Return actions to the nearest workshop cell (may be occupied).\"\"\"\n      h, w, _ = state.grid.shape\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (r, c), path = q.popleft()\n          if state.grid[r, c, workshop_kind] > 0:\n              return path\n          for act, (dr, dc) in ACTIONS:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:\n                  if state.grid[nr, nc, workshop_kind] > 0 or np.all(state.grid[nr, nc, :] == 0):\n                      visited.add((nr, nc))\n                      q.append(((nr, nc), path + [act]))\n      return None\n\n  # --------------------------------------------------------------------\n  # Identify the index of the target item 'arrow'.\n  # --------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # Arrow not defined in this world.\n      return []\n\n  # --------------------------------------------------------------------\n  # Determine primitive resources required for a single arrow.\n  # --------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions_taken = []\n\n  # --------------------------------------------------------------------\n  # Collect each required primitive, respecting the needed count.\n  # --------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          path = bfs_path(state.pos, prim_idx)\n          if path is None:                # Primitive unreachable \u2013 abort.\n              return actions_taken\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              actions_taken.append(a)\n              if done:\n                  return actions_taken\n          # Pick up the primitive.\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          actions_taken.append(USE)\n          if done:\n              return actions_taken\n\n  # --------------------------------------------------------------------\n  # Move to the appropriate workshop (if required) and craft the arrow.\n  # --------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      path = bfs_to_workshop(state.pos, workshop_idx)\n      if path is not None:\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              actions_taken.append(a)\n              if done:\n                  return actions_taken\n      # Craft at the workshop.\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      actions_taken.append(USE)\n  else:\n      # No specific workshop; attempt crafting in place.\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      actions_taken.append(USE)\n\n  return actions_taken", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:32:22.080708", "function_name": "make_arrow", "function_body": "  # ---- Setup ----\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  state = env._current_state\n  pos = tuple(state.pos)                     # current agent position\n  goal = env.task.goal                        # index of desired item\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # copy of the grid to simulate removals after picking up primitives\n  grid = state.grid.copy()\n  width, height = grid.shape[:2]\n\n  # static blocked cells (non\u2011grabbable entities such as water, stone, etc.)\n  non_grab = list(env.world.non_grabbable_indices)\n  if non_grab:\n      base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      base_blocked = np.zeros((width, height), dtype=bool)\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions from start to target.\n  # If allow_target_block=True the target cell may be occupied (primitive or workshop)\n  # ----------------------------------------------------------------------\n  def bfs_path(start, target, allow_target_block=False):\n      blocked = base_blocked.copy()\n      if allow_target_block:\n          blocked[target[0], target[1]] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n      if target not in came_from:\n          return None\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_from[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ----------------------------------------------------------------------\n  # Helper: simple Manhattan path (fallback when BFS fails)\n  # ----------------------------------------------------------------------\n  def manhattan_path(start, target):\n      moves = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect required primitives (if any)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate remaining instances of this primitive in the simulated grid\n          locs = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locs:\n              # No more instances; break (should not happen in a solvable scenario)\n              break\n          # choose the closest instance by Manhattan distance\n          target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)                     # pick up the primitive\n          # update simulated state\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0      # remove primitive from grid\n\n  # ----------------------------------------------------------------------\n  # 2) If the goal itself is a primitive (no recipe), just pick it up\n  # ----------------------------------------------------------------------\n  if not needed:\n      # goal is a primitive; find one instance and collect it\n      locs = list(zip(*np.where(grid[:, :, goal] > 0)))\n      if locs:\n          target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)\n          # Done \u2013 return actions early\n          return actions\n\n  # ----------------------------------------------------------------------\n  # 3) Move to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs_path(pos, target_ws, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop\n  else:\n      # No specific workshop \u2013 just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:32:23.213027", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ----- basic info -------------------------------------------------\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n  state = env._current_state\n  pos = tuple(state.pos)                     # current agent position\n  goal = env.task.goal                        # index of the desired item\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # copy of the grid for internal simulation (so we can \u201cremove\u201d picked items)\n  grid = state.grid.copy()\n  width, height = grid.shape[:2]\n\n  # cells that are permanently blocked (non\u2011grabbable entities such as water, stone)\n  non_grab = list(env.world.non_grabbable_indices)\n  if non_grab:\n      base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      base_blocked = np.zeros((width, height), dtype=bool)\n\n  # ----- helper: BFS that returns actions from start to target ----------\n  def bfs_path(start, target, allow_target_block=False):\n      \"\"\"\n      Returns a list of actions to move from start to target.\n      If allow_target_block=True the target cell may be occupied.\n      \"\"\"\n      blocked = base_blocked.copy()\n      if allow_target_block:\n          blocked[target[0], target[1]] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n      if target not in came_from:\n          return None\n      # reconstruct path\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_from[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ----- helper: simple Manhattan path (fallback) ---------------------\n  def manhattan_path(start, target):\n      moves = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ----- 1) Collect all required primitives ---------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate remaining instances of this primitive in the simulated grid\n          locs = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locs:\n              # No more instances; break (should not happen in a solvable scenario)\n              break\n          # choose the closest instance by Manhattan distance (good heuristic)\n          target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)                     # pick up the primitive\n          # update simulated state\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0      # remove primitive from grid\n\n  # ----- 2) Move to workshop (if required) and craft -----------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs_path(pos, target_ws, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop\n  else:\n      # No specific workshop \u2013 just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:32:58.675271", "function_name": "make_arrow", "function_body": "  # Define action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _is_empty(cell):\n      \"\"\"Return True if the cell has no entities.\"\"\"\n      return cell.sum() == 0\n\n  def _find_nearest(grid, kind_idx, start):\n      \"\"\"Find the nearest cell (Manhattan) containing an entity of kind_idx.\"\"\"\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  def _bfs_to_adjacent(grid, start, target):\n      \"\"\"\n      Breadth\u2011first search for the shortest path (as a list of actions)\n      from start to any empty cell that is 4\u2011connected to target.\n      \"\"\"\n      h, w, _ = grid.shape\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (LEFT, (0, -1)),\n          (RIGHT, (0, 1)),\n      ]\n\n      def _adjacent(pos):\n          return (abs(pos[0] - target[0]) + abs(pos[1] - target[1])) == 1\n\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n\n      while q:\n          (r, c), path = q.popleft()\n          if _adjacent((r, c)):\n              return path\n          for act, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in visited:\n                  if _is_empty(grid[nr, nc, :]):\n                      visited.add((nr, nc))\n                      q.append(((nr, nc), path + [act]))\n      return None  # no reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      # unknown goal \u2013 nothing to do\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for one arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting multiplicities)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          # locate the nearest remaining primitive of this kind\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return action_seq\n\n          # find path to a free cell adjacent to the primitive\n          path = _bfs_to_adjacent(state.grid, state.pos, target)\n          if path is None:\n              # cannot reach it \u2013 abort\n              return action_seq\n\n          # execute movement actions\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n\n          # use the primitive (the agent should now be facing it)\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_nearest(state.grid, workshop_idx, state.pos)\n      if workshop_pos is not None:\n          path = _bfs_to_adjacent(state.grid, state.pos, workshop_pos)\n          if path is not None:\n              for a in path:\n                  reward, done, obs = env.step(a)\n                  state = env._current_state\n                  action_seq.append(a)\n                  if done:\n                      return action_seq\n              # perform the crafting action\n              reward, done, obs = env.step(USE)\n              state = env._current_state\n              action_seq.append(USE)\n\n  return action_seq", "env_interactions": 22, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:32:59.807002", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan path from src to dst (list of movement actions)\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper: Find nearest cell (Manhattan) containing a given kind\n  # ------------------------------------------------------------------\n  def _nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: Find any cell containing a given kind\n  # ------------------------------------------------------------------\n  def _any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the goal item index (\"arrow\")\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:               # not present in the cookbook\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respect multiplicities)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitives_needed.items():\n      for _ in range(cnt):\n          target = _nearest(state.grid, prim_idx, state.pos)\n          if target is None:        # primitive missing \u2013 abort\n              return action_seq\n          # Move to the primitive cell\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # If recipe specifies a workshop, go there and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:33:19.766678", "function_name": "make_arrow", "function_body": "  env.reset()\n  act_map = env.action_specs()\n  move_delta = {\"UP\": (-1,0), \"DOWN\": (1,0), \"LEFT\": (0,-1), \"RIGHT\": (0,1)}\n  from collections import deque\n  actions = []\n\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n      while q:\n          pos, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(pos[0]-tx) <= 1 and abs(pos[1]-ty) <= 1:\n                  return path\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0]+dx, pos[1]+dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              continue\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              continue\n          for act_name in path:\n              a = act_map[act_name]\n              actions.append(a)\n              env.step(a)\n          a = act_map[\"USE\"]\n          actions.append(a)\n          env.step(a)\n\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  a = act_map[act_name]\n                  actions.append(a)\n                  env.step(a)\n          a = act_map[\"USE\"]\n          actions.append(a)\n          env.step(a)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:33:20.894395", "function_name": "make_arrow", "function_body": "  # Reset environment and initialize variables\n  env.reset()\n  actions = []\n  act_map = env.action_specs()                     # e.g. {'DOWN':0, 'UP':1, ...}\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell adjacent (including diagonal) to any cell in\n  # `targets`.  It only walks through empty cells.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Only walk through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Retrieve goal information and required primitives\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells that currently contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 skip this instance\n              continue\n\n          # Plan a path to an adjacent cell of the nearest primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 skip\n              continue\n\n          # Execute movement actions\n          for act_name in path:\n              a = act_map[act_name]\n              actions.append(a)\n              env.step(a)\n\n          # Use action to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  a = act_map[act_name]\n                  actions.append(a)\n                  env.step(a)\n\n          # Use action at the workshop to craft the item\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the computed action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:33:45.275529", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Constants and helpers\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n  def _bfs(start, goal, grid):\n      \"\"\"Return a list of actions to move from start to goal (inclusive).\"\"\"\n      if start == goal:\n          return []\n      w, h, _ = grid.shape\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # a cell is blocked if it contains any entity except the goal cell\n              if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:\n                  continue\n              new_path = path + [act]\n              if (nx, ny) == goal:\n                  return new_path\n              visited.add((nx, ny))\n              q.append(((nx, ny), new_path))\n      # no path found \u2013 return empty list (will likely fail later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Access world / cookbook (works for raw env and CraftLab wrappers)\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # CraftLab stores the world inside the current state object\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = cur_state.world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal information (hard\u2011coded to the \"arrow\" item)\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Obtain current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # raw env: initialise from the scenario directly\n      if hasattr(env, \"scenario\"):\n          state = env.scenario.init()\n      else:\n          # fallback \u2013 try to reset the environment\n          env.reset()\n          state = getattr(env, \"_current_state\", None)\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy so we can clear collected items\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # locate all cells still containing this primitive\n          locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # nothing left \u2013 abort early\n              break\n          # pick the nearest location (Manhattan distance heuristic)\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations[0]\n\n          # move to the primitive cell\n          path = _bfs(pos, target, grid)\n          actions.extend(path)\n          # update position according to the path taken\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # pick it up\n          actions.append(USE)\n          # clear the primitive from the grid copy\n          grid[pos[0], pos[1], prim_idx] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Move to required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (could be a name or already an int)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      # locate workshop cells\n      ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = ws_locs[0]\n          # move to the workshop cell\n          path = _bfs(pos, ws_target, grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # craft using the workshop\n          actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:33:46.402847", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions from start to goal.\n  # Goal cell may be occupied (e.g., contains the primitive we want).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal, grid):\n      if start == goal:\n          return []\n      w, h, _ = grid.shape\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # treat the goal cell as traversable even if occupied\n              if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:\n                  continue\n              new_path = path + [act]\n              if (nx, ny) == goal:\n                  return new_path\n              visited.add((nx, ny))\n              q.append(((nx, ny), new_path))\n      return []  # no path found\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook (works for both raw env and CraftLab)\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # CraftLab stores the world inside the current state object\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal information (hard\u2011coded to \"arrow\")\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Obtain current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # fallback: initialise from the scenario directly\n      state = env.scenario.init()\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for bookkeeping\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Find all cells still containing this primitive\n          locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not locations:\n              break  # should not happen in a valid scenario\n          # Choose the closest one (Manhattan distance)\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations[0]\n\n          # Move to the primitive\n          actions.extend(_bfs_path(pos, target, grid))\n          pos = target\n\n          # Pick it up\n          actions.append(USE)\n\n          # Update bookkeeping\n          grid[pos[0], pos[1], prim_idx] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be name or integer)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      # Locate workshop cells\n      ws_locations = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locations:\n          ws_locations.sort(\n              key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])\n          )\n          ws_target = ws_locations[0]\n\n          # Move to workshop\n          actions.extend(_bfs_path(pos, ws_target, grid))\n          pos = ws_target\n\n          # Craft\n          actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:34:26.699925", "function_name": "make_arrow", "function_body": "  # reset environment and get handles\n  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  H, W = grid.shape[:2]\n  non_grab = list(world.non_grabbable_indices)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path avoiding non\u2011grabbable cells.\"\"\"\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions = []\n              cur = goal\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      actions.append(DOWN)\n                  elif py == cur[0] + 1:\n                      actions.append(UP)\n                  elif px == cur[1] - 1:\n                      actions.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      actions.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions))\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  if np.any(grid[ny, nx, non_grab] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      return []  # no path found\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Coordinates of the nearest cell containing ``kind``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      idx = int(np.argmin(dists))\n      return tuple(locs[idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions\n          ty, tx = target\n\n          # pick a free adjacent cell\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < H and 0 <= nx < W:\n                  if not np.any(grid[ny, nx, non_grab] > 0):\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              adj = target\n\n          # move to adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # set direction towards the primitive\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # pick up\n          actions.append(USE)\n\n          # update grid to reflect that the primitive has been taken\n          grid[ty, tx, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # craft\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:34:27.839846", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain current state information.\n  env.reset()\n  state = env._current_state\n  world = env.world\n  # Work on a copy of the grid so we can update it as items are collected.\n  grid = state.grid.copy()\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  # Indices of entities that block movement (cannot be grabbed).\n  non_grab = list(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable\n      obstacles. ``start`` and ``goal`` are (y, x) tuples.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # Reconstruct actions from start to goal.\n              actions = []\n              cur = goal\n              while cur != start:\n                  py, px = prev[cur]\n                  dy, dx = cur[0] - py, cur[1] - px\n                  if dy == 1:\n                      actions.append(DOWN)\n                  elif dy == -1:\n                      actions.append(UP)\n                  elif dx == 1:\n                      actions.append(RIGHT)\n                  elif dx == -1:\n                      actions.append(LEFT)\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                               (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # Cell is blocked if any non\u2011grabbable entity occupies it.\n                  if np.any(grid[ny, nx, non_grab] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen for valid tasks).\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Return the coordinates (y, x) of the nearest cell that contains\n      ``kind`` (primitive or workshop). If none exists, return None.\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the appropriate number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not np.any(grid[ny, nx, non_grab] > 0):\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fallback: stand directly on the primitive cell.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a movement action that will be blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update the grid to reflect that the primitive has been collected.\n          grid[ty, tx, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:34:55.406164", "function_name": "make_arrow", "function_body": "  # Directions correspond to action indices: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of actions that moves\n  # from `start` to any cell in `targets` while avoiding `blocked` cells.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # Should never happen in a solvable scenario\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and issue USE `cnt` times.\n  # ------------------------------------------------------------------\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Gather world / recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Resolve full crafting plan: primitives needed + ordered craft steps\n  # ------------------------------------------------------------------\n  needed_prims = {}          # primitive idx \u2192 total count required\n  craft_steps = []           # (item_idx, count) in dependency order\n\n  def resolve(item_idx, mul):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul\n          return\n      # Resolve ingredients first (skip special keys like \"_at\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mul)\n      # Schedule crafting of this item after its ingredients are ready\n      craft_steps.append((item_idx, mul))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the complete action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all primitive resources required by the recipe\n  for kind_idx, cnt in needed_prims.items():\n      acquire(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:34:56.523190", "function_name": "make_arrow", "function_body": "  # Directions: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices that moves from start to any cell in targets.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # Unreachable \u2013 return empty path (should not happen in solvable scenarios)\n      return []\n\n  def acquire(kind_idx, count):\n      \"\"\"Move to a cell containing `kind_idx` and issue USE `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          if not cells:\n              # No remaining cells; still issue a USE (environment will handle it)\n              actions.append(4)\n              continue\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE\n\n  # ------------------------------------------------------------------\n  # Gather world and recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # Resolve recipe: collect primitive requirements and ordered craft steps\n  needed_prims = {}          # primitive idx -> total count\n  craft_steps = []           # list of (item_idx, count) in dependency order\n\n  def resolve(item_idx, multiplier):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:  # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # Resolve ingredient items first (skip special keys like \"_at\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # Schedule crafting of this item after its ingredients are ready\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the final action list\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Gather all required primitive resources\n  for prim_idx, cnt in needed_prims.items():\n      acquire(prim_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:35:55.081757", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain a fresh state.\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n\n  # Action indices: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n  ACTION_USE = 4\n  # Direction vectors matching the above order.\n  dirs = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of action indices that\n  # moves the agent from `start` to `goal` while avoiding occupied cells.\n  # ------------------------------------------------------------------\n  def bfs(start, goal, occupied):\n      from collections import deque\n      W, H = occupied.shape\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) == goal:\n              return path\n          for a, (dx, dy) in enumerate(dirs):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not occupied[nx, ny] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [a]))\n      return None\n\n  # Cells that contain *any* entity are considered blocked.\n  occupied = np.any(grid, axis=2)\n\n  # ------------------------------------------------------------------\n  # Retrieve the recipe for the target item \"arrow\".\n  # ------------------------------------------------------------------\n  idx = env.world.cookbook.index\n  try:\n      arrow_idx = idx['arrow']\n  except Exception:\n      return []\n  recipe = env.world.cookbook.recipes.get(arrow_idx, {})\n  if not recipe:\n      return []\n  workshop_idx = recipe['_at']\n  ingredients = {k: v for k, v in recipe.items() if k != '_at'}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Move to a free cell adjacent to `target_pos` and make sure the\n  # agent ends up facing the target (direction `need_dir`).\n  # ------------------------------------------------------------------\n  def go_adjacent(target_pos, need_dir):\n      nonlocal pos, occupied, actions\n      for a_idx, (dx, dy) in enumerate(dirs):\n          ax, ay = target_pos[0] - dx, target_pos[1] - dy\n          if 0 <= ax < occupied.shape[0] and 0 <= ay < occupied.shape[1] and not occupied[ax, ay]:\n              path = bfs(pos, (ax, ay), occupied)\n              if path is None:\n                  continue\n              # follow the path\n              actions.extend(path)\n              for a in path:\n                  dxp, dyp = dirs[a]\n                  pos = (pos[0] + dxp, pos[1] + dyp)\n\n              # Ensure we are facing the target.\n              # Desired facing direction is `need_dir`. If we are not already\n              # facing it, perform a tiny detour: step opposite then step back.\n              opp = need_dir ^ 1                     # 0\u21941, 2\u21943\n              ox, oy = pos[0] - dirs[need_dir][0], pos[1] - dirs[need_dir][1]\n              if 0 <= ox < occupied.shape[0] and 0 <= oy < occupied.shape[1] and not occupied[ox, oy]:\n                  actions.append(opp)\n                  pos = (ox, oy)\n                  actions.append(need_dir)\n                  pos = (pos[0] + dirs[need_dir][0], pos[1] + dirs[need_dir][1])\n              else:\n                  # Fallback: try any other free neighbour then the needed direction.\n                  for alt in range(4):\n                      if alt == need_dir:\n                          continue\n                      nx, ny = pos[0] + dirs[alt][0], pos[1] + dirs[alt][1]\n                      if 0 <= nx < occupied.shape[0] and 0 <= ny < occupied.shape[1] and not occupied[nx, ny]:\n                          actions.append(alt)\n                          pos = (nx, ny)\n                          actions.append(need_dir)\n                          pos = (pos[0] + dirs[need_dir][0], pos[1] + dirs[need_dir][1])\n                          break\n              return True\n      return False\n\n  # ------------------------------------------------------------------\n  # Gather all required primitive ingredients.\n  # ------------------------------------------------------------------\n  for ing_idx, cnt in ingredients.items():\n      for _ in range(cnt):\n          # locate any remaining instance of this ingredient\n          locs = np.argwhere(grid[:, :, ing_idx] > 0)\n          if len(locs) == 0:\n              return actions\n          # pick the closest one (Manhattan distance)\n          dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])\n          target = tuple(locs[dists.argmin()])\n\n          # Find a direction that gives a free adjacent cell.\n          collected = False\n          for dir_idx, (dx, dy) in enumerate(dirs):\n              adj = (target[0] - dx, target[1] - dy)\n              if 0 <= adj[0] < occupied.shape[0] and 0 <= adj[1] < occupied.shape[1] and not occupied[adj[0], adj[1]]:\n                  if go_adjacent(target, dir_idx):\n                      actions.append(ACTION_USE)   # pick up the primitive\n                      occupied[target[0], target[1]] = False   # cell becomes free\n                      collected = True\n                      break\n          if not collected:\n              return actions\n\n  # ------------------------------------------------------------------\n  # Go to the appropriate workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if len(workshop_cells) == 0:\n      return actions\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  workshop = tuple(workshop_cells[dists.argmin()])\n\n  for dir_idx, (dx, dy) in enumerate(dirs):\n      adj = (workshop[0] - dx, workshop[1] - dy)\n      if 0 <= adj[0] < occupied.shape[0] and 0 <= adj[1] < occupied.shape[1] and not occupied[adj[0], adj[1]]:\n          if go_adjacent(workshop, dir_idx):\n              actions.append(ACTION_USE)   # craft the arrow\n              break\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:35:56.357402", "function_name": "make_arrow", "function_body": "  # Retrieve world and goal information\n  world = env.world\n  # Index of the target item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  # Primitive requirements for one arrow\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n\n  # Identify the workshop where the arrow must be crafted\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  if \"_at\" in recipe:\n      workshop_idx = recipe[\"_at\"]\n\n  # Action mapping (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4 in default specs)\n  action_map = env.action_specs()\n  # Helper to generate a straight\u2011line move sequence\n  def _move_actions(start, target):\n      sx, sy = start\n      tx, ty = target\n      seq = []\n      while sx < tx:\n          seq.append(action_map[\"DOWN\"])\n          sx += 1\n      while sx > tx:\n          seq.append(action_map[\"UP\"])\n          sx -= 1\n      while sy < ty:\n          seq.append(action_map[\"RIGHT\"])\n          sy += 1\n      while sy > ty:\n          seq.append(action_map[\"LEFT\"])\n          sy -= 1\n      return seq\n\n  # Current state information\n  state = env._current_state\n  cur_pos = tuple(state.pos)\n  grid = state.grid\n  actions = []\n\n  # Collect each required primitive (respecting the required count)\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          # Find any cell that still contains the primitive\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map \u2013 give up early\n              break\n          # Choose the first available location\n          target = tuple(locations[0])\n          # Move to that cell\n          actions.extend(_move_actions(cur_pos, target))\n          cur_pos = target\n          # Pick it up (USE interacts with the cell the agent is on)\n          actions.append(action_map[\"USE\"])\n          # Update our simulated view of the grid so we don't try to pick the same item again\n          grid[target[0], target[1], prim_idx] = max(0, grid[target[0], target[1], prim_idx] - 1)\n\n  # Finally move to the appropriate workshop and craft the arrow\n  if workshop_idx is not None:\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          workshop_pos = tuple(workshop_cells[0])\n          actions.extend(_move_actions(cur_pos, workshop_pos))\n          cur_pos = workshop_pos\n          # Use the workshop to craft the arrow\n          actions.append(action_map[\"USE\"])\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:36:24.360596", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Helper: BFS to a cell adjacent to any target while avoiding\n  # non\u2011grabbable entities.\n  # --------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  DIR_TO_ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  def bfs_adjacent(start, targets, grid, blocked_kinds):\n      \"\"\"Return a list of actions moving from ``start`` to a cell that is\n      orthogonally adjacent to any cell in ``targets``. If already adjacent,\n      returns an empty list. ``blocked_kinds`` is an iterable of kind indices\n      that cannot be stepped on.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Pre\u2011compute blocked map.\n      blocked = np.zeros((W, H), dtype=bool)\n      for k in blocked_kinds:\n          blocked |= grid[:, :, k] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacent cell.\n      return []\n\n  # --------------------------------------------------------------\n  # Initialise state.\n  # --------------------------------------------------------------\n  # Ensure the environment is in a fresh state.\n  try:\n      env.reset()\n  except Exception:\n      pass  # env may already be reset; ignore.\n\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for planning\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal item index is stored in the task.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task.\")\n\n  # --------------------------------------------------------------\n  # 1. Gather required primitives.\n  # --------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  blocked_kinds = env.world.non_grabbable_indices\n\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # Locate all cells that still contain this primitive.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive exhausted \u2013 abort planning.\n              return plan\n\n          # Find path to a cell adjacent to one of the primitives.\n          path = bfs_adjacent(pos, cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(4)   # USE action.\n\n          # Identify which primitive cell we just used (must be adjacent).\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Safety fallback \u2013 stop planning.\n              return plan\n\n          # Update local grid and decrement needed count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")   # some recipes use _key\n\n  if workshop_key is not None:\n      # Resolve workshop kind index.\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to craft at the workshop.\n          plan.append(4)   # USE\n\n  # Return the complete action sequence.\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:36:25.494478", "function_name": "make_arrow", "function_body": "  # Mapping between direction vectors and action indices\n  DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions that moves from ``start`` to a cell\n      adjacent to any cell in ``targets`` while avoiding non\u2011grabbable\n      entities. If already adjacent, returns an empty list.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Cells that cannot be entered\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n      # Immediate adjacency check\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # Unreachable\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise local copies of the state for planning.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  # Goal index stored in the task (may be an int or a Struct with .goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal not found in env.task\")\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are required.\n  # ------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive on the map \u2013 abort.\n              return plan\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update ``pos``.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Locate the primitive cell we are adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              break  # safety\n\n          # Update simulated grid and decrement the remaining count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop kind index (could be a string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Final USE to trigger crafting.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:36:42.529851", "function_name": "make_arrow", "function_body": "  # Resolve the scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Hash function for visited states (position, direction, inventory)\n  def _state_hash(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()))\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action count (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:36:58.111580", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper that creates a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action count (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:37:27.338054", "function_name": "make_arrow", "function_body": "  # action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  moves = [\n      ((0, 1), DOWN),   # down  (y+1)\n      ((0, -1), UP),    # up    (y-1)\n      ((-1, 0), LEFT),  # left  (x-1)\n      ((1, 0), RIGHT),  # right (x+1)\n  ]\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions that moves from start to goal using BFS.\n      Cells that contain any non\u2011zero kind are treated as blocked,\n      except the goal cell itself (which may hold the target item).\"\"\"\n      w, h = grid.shape[0], grid.shape[1]          # x\u2011size, y\u2011size\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing the requested kind (Manhattan).\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)   # y\u2011rows, x\u2011cols\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Planning start\n  # ------------------------------------------------------------------\n  actions = []\n\n  # current position (prefer live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # make a mutable copy of the static grid for planning\n  grid = env.scenario.init_grid.copy()\n\n  # goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # primitive not found \u2013 abort planning\n              return actions\n          actions.extend(bfs_path(cur_pos, target, grid))\n          actions.append(USE)                     # pick up primitive\n          # remove the primitive from our planning grid\n          grid[target[0], target[1], prim_kind] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)   # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  # return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:37:28.456333", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # movement vectors\n  moves = [\n      ((0, 1), DOWN),\n      ((0, -1), UP),\n      ((-1, 0), LEFT),\n      ((1, 0), RIGHT),\n  ]\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return list of actions from start to goal using BFS.\n      Cells with any non\u2011zero kind are treated as blocked, except the goal cell.\"\"\"\n      w, h = grid.shape[0], grid.shape[1]\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find nearest cell containing kind_idx (Manhattan distance).\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # current position\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # copy of static grid for planning\n  grid = env.scenario.init_grid.copy()\n\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives\n  # ------------------------------------------------------------------\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind: count}\n  for kind, cnt in primitive_reqs.items():\n      for _ in range(cnt):\n          target = nearest_kind(kind, cur_pos, grid)\n          if target is None:\n              # cannot find required primitive \u2013 abort planning\n              return actions\n          # move to target\n          actions.extend(bfs_path(cur_pos, target, grid))\n          # pick up\n          actions.append(USE)\n          # update planning grid and position\n          grid[target[0], target[1], kind] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Go to workshop and craft the goal\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)  # craft\n          cur_pos = workshop_pos\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:37:50.895275", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(cur_pos, target, seq):\n      \"\"\"Append actions to move from cur_pos to target (both [x, y] lists).\"\"\"\n      while cur_pos[0] != target[0] or cur_pos[1] != target[1]:\n          if cur_pos[0] < target[0]:\n              seq.append(RIGHT)\n              cur_pos[0] += 1\n          elif cur_pos[0] > target[0]:\n              seq.append(LEFT)\n              cur_pos[0] -= 1\n          elif cur_pos[1] < target[1]:\n              seq.append(DOWN)\n              cur_pos[1] += 1\n          elif cur_pos[1] > target[1]:\n              seq.append(UP)\n              cur_pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return [x, y] of the nearest cell containing kind_idx, or None.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Initialise planning state\n  # ------------------------------------------------------------------\n  actions = []\n\n  # Current position (list so we can modify in\u2011place)\n  if hasattr(env, \"_current_state\"):\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Working copy of the grid \u2013 we will zero out primitives once taken\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # Shortcut references\n  cookbook = env.world.cookbook\n  primitives_set = cookbook.primitives\n  recipes = cookbook.recipes\n  init_grid = env.scenario.init_grid  # for locating static workshops\n\n  # ------------------------------------------------------------------\n  # Recursive planning function\n  # ------------------------------------------------------------------\n  def _ensure_item(item_idx):\n      \"\"\"Plan actions that guarantee one unit of item_idx in inventory.\"\"\"\n      # Primitive \u2013 just collect it from the world\n      if item_idx in primitives_set:\n          target = _nearest_kind(item_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not found; give up planning\n              return False\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)           # pick up primitive\n          grid[target[1], target[0], item_idx] = 0   # remove from copy\n          return True\n\n      # Non\u2011primitive \u2013 need to craft using its recipe\n      recipe = recipes.get(item_idx)\n      if recipe is None:\n          # No way to obtain this item\n          return False\n\n      # First obtain all ingredients\n      for ingr_idx, cnt in recipe.items():\n          if ingr_idx == \"_at\":\n              continue\n          for _ in range(cnt):\n              if not _ensure_item(ingr_idx):\n                  return False\n\n      # Then go to the required workshop (if any) and craft\n      workshop_kind = recipe.get(\"_at\")\n      if workshop_kind is not None:\n          # Workshops are static; locate them in the original grid\n          ws_target = _nearest_kind(workshop_kind, cur_pos, init_grid)\n          if ws_target is None:\n              return False\n          _move_to(cur_pos, ws_target, actions)\n          actions.append(USE)   # craft at the workshop\n      else:\n          # No workshop specified \u2013 just use (should never happen)\n          actions.append(USE)\n      return True\n\n  # ------------------------------------------------------------------\n  # Start planning for the final goal\n  # ------------------------------------------------------------------\n  _ensure_item(goal_idx)\n\n  # Return the full action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
