{"timestamp": "2025-10-28T15:53:03.355583", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  actions = []\n  # current state and grid\n  state = env._current_state\n  grid = state.grid\n  cur_pos = list(state.pos)  # mutable [x, y]\n\n  world = env.world\n  idx = world.cookbook.index\n\n  # index of the target item \"arrow\"\n  arrow_idx = idx[\"arrow\"]\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n\n  # separate workshop and primitive requirements\n  workshop_idx = None\n  primitives = {}\n  for k, v in recipe.items():\n      if isinstance(k, str) and k.startswith(\"_\"):\n          workshop_idx = v\n      else:\n          primitives[int(k)] = v\n\n  # helper: find all positions that currently contain a given kind\n  def positions_of(kind):\n      pts = np.argwhere(grid[:, :, kind] > 0)\n      return [tuple(p) for p in pts]\n\n  # helper: generate moves from cur_pos to target (Manhattan moves)\n  def moves_to(target):\n      moves = []\n      dx = target[0] - cur_pos[0]\n      dy = target[1] - cur_pos[1]\n\n      while dx > 0:\n          moves.append(0)          # DOWN\n          cur_pos[0] += 1\n          dx -= 1\n      while dx < 0:\n          moves.append(1)          # UP\n          cur_pos[0] -= 1\n          dx += 1\n      while dy > 0:\n          moves.append(3)          # RIGHT\n          cur_pos[1] += 1\n          dy -= 1\n      while dy < 0:\n          moves.append(2)          # LEFT\n          cur_pos[1] -= 1\n          dy += 1\n      return moves\n\n  # -------------------------------------------------\n  # 1. Collect required primitive items\n  # -------------------------------------------------\n  for prim_idx, cnt in primitives.items():\n      for _ in range(cnt):\n          # locate nearest available primitive of this kind\n          cand = positions_of(prim_idx)\n          if not cand:\n              continue\n          nearest = min(cand, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          actions.extend(moves_to(nearest))\n          actions.append(4)                     # USE to pick up\n          # remove it from the simulated grid so we don't try to collect it again\n          grid[nearest[0], nearest[1], prim_idx] = 0\n\n  # -------------------------------------------------\n  # 2. Go to the appropriate workshop and craft\n  # -------------------------------------------------\n  if workshop_idx is not None:\n      ws_cands = positions_of(workshop_idx)\n      if ws_cands:\n          nearest_ws = min(ws_cands, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          actions.extend(moves_to(nearest_ws))\n          actions.append(4)                     # USE to craft\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:53:25.942793", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:53:27.036915", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  def _move_to(pos, tgt, seq):\n      \"\"\"Append actions to move from pos to tgt (both [x, y] lists).\"\"\"\n      while pos[0] != tgt[0] or pos[1] != tgt[1]:\n          if pos[0] < tgt[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > tgt[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < tgt[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > tgt[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, g):\n      \"\"\"Return [x, y] of the nearest cell containing kind_idx, or None.\"\"\"\n      ys, xs = np.where(g[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Begin planning\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # Current position (use the state inside the env if available)\n  if hasattr(env, \"_current_state\"):\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a copy of the initial grid so we can mark items as taken\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ----------------------------------------------------------------------\n  # 1. Gather all required primitive resources for the goal\n  # ----------------------------------------------------------------------\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, count in primitive_reqs.items():\n      for _ in range(count):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)  # pick up primitive\n          # Remove the primitive from the grid representation\n          grid[target[1], target[0], prim_kind] = 0\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)  # craft at the workshop\n\n  # Return the planned sequence of actions\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:53:57.063294", "function_name": "make_arrow", "function_body": "  actions = []\n  # Reset the environment to start a new episode\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Identify the goal item index for \"arrow\"\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index[goal_name]\n\n  # Determine which primitive resources are needed to craft one arrow\n  primitive_needs = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Helper to move the agent to a target position using Manhattan moves\n  def move_to(target):\n      nonlocal actions, state\n      while state.pos != target:\n          x, y = state.pos\n          tx, ty = target\n          if x < tx:\n              act = 3  # RIGHT\n          elif x > tx:\n              act = 2  # LEFT\n          elif y < ty:\n              act = 0  # DOWN\n          else:\n              act = 1  # UP\n          _, _ = env.step(act)\n          actions.append(act)\n          state = env._current_state\n\n  # Collect each required primitive\n  for prim_idx, needed in primitive_needs.items():\n      while needed > 0:\n          # Locate all cells containing this primitive\n          positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if positions.shape[0] == 0:\n              # No more of this primitive on the map; give up\n              break\n          # Choose the closest instance\n          cur = np.array(state.pos)\n          dists = np.sum(np.abs(positions - cur), axis=1)\n          nearest = positions[dists.argmin()]\n          target_pos = tuple(nearest.tolist())\n\n          # Move to the primitive and pick it up\n          move_to(target_pos)\n          _, _ = env.step(4)  # USE to pick up\n          actions.append(4)\n\n          needed -= 1\n\n  # After gathering primitives, go to the appropriate workshop to craft the arrow\n  recipe = world.cookbook.recipes[goal_idx]\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = world.cookbook.index[workshop_name]\n\n  # Find any workshop cell\n  ws_positions = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n  if ws_positions.shape[0] > 0:\n      workshop_pos = tuple(ws_positions[0].tolist())\n      move_to(workshop_pos)\n      _, _ = env.step(4)  # USE to craft\n      actions.append(4)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
