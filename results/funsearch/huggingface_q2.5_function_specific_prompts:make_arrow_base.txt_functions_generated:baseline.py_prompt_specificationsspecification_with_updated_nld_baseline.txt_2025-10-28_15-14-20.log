{"timestamp": "2025-10-28T22:57:27.039471", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item index\n  target_idx = cookbook.index[\"arrow\"]\n\n  # mutable planning copies\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions: list[int] = []\n\n  from collections import deque\n\n  def bfs(start: tuple[int, int], goals: set[tuple[int, int]]) -> list[int] | None:\n      \"\"\"Return a list of movement actions to reach any cell in *goals*.\"\"\"\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # consider a cell blocked if any entity occupies it, unless it is a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def apply_path(path: list[int]) -> None:\n      \"\"\"Update simulated position according to *path*.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(kind_idx: int, amount: int) -> None:\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          # locate cells still containing the primitive\n          cells = [(x, y) for x in range(width) for y in range(height)\n                   if grid[x, y, kind_idx] > 0]\n          if not cells:\n              raise RuntimeError(f\"Primitive {kind_idx} not found on map\")\n          chosen_path = None\n          chosen_cell = None\n          for cell in cells:\n              p = bfs(pos, {cell})\n              if p is not None:\n                  chosen_path, chosen_cell = p, cell\n                  break\n          if chosen_path is None:\n              raise RuntimeError(\"Primitive unreachable\")\n          actions.extend(chosen_path)\n          apply_path(chosen_path)\n          actions.append(4)                     # USE to pick up\n          grid[chosen_cell[0], chosen_cell[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          amount -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure_item(item_idx: int, needed: int) -> None:\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < needed:\n          if item_idx in primitives:\n              collect_primitive(item_idx, needed - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # first ensure all ingredients are present\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to required workshop, if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if not ws_cells:\n                  raise RuntimeError(\"Required workshop not present on map\")\n              path = bfs(pos, {ws_cells[0]})\n              if path is None:\n                  raise RuntimeError(\"Workshop unreachable\")\n              actions.extend(path)\n              apply_path(path)\n\n          # perform crafting action\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:57:56.865296", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell adjacent to any coordinate in `targets`.  Cells that contain\n  # any entity are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where a cell is non\u2011empty\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent (Manhattan distance 1) to a target,\n          # we can stop \u2013 the current path brings us next to the target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Explore 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Identify the world, cookbook and the goal (hard\u2011coded to \"arrow\").\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = state_wrapper.world\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary) and fetch grid.\n  # ----------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      if hasattr(env, \"reset\"):\n          env.reset()\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          raise RuntimeError(\"Environment does not expose a current state after reset.\")\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # primitives already taken\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive, greedy nearest\u2011first.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently holding this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Update our simulated position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up.\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int).\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:57:58.029000", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell adjacent to any coordinate in `targets`.  Cells containing any\n  # entity are treated as blocked.\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where a cell is non\u2011empty\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent (Manhattan distance 1) to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Explore 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list (will likely fail later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Identify world, cookbook and the goal (hard\u2011coded to \"arrow\").\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state.\n      state0 = getattr(env, \"_current_state\", None)\n      if state0 is not None:\n          world = state0.world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary) and fetch grid.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # primitives already taken\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive, greedy nearest\u2011first.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently holding this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Update simulated position following the path.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up.\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int).\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)   # craft the arrow\n  else:\n      # No specific workshop \u2013 just use the current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:58:26.445332", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and obtain the current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal index for the arrow and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Helper: indices of non\u2011grabbable entities\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies `pos`.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of positions from `start` to `goal` using BFS.\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path (including start)\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a position path to a list of movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing `kind` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of `target` (preferring N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback (may be blocked)\n\n  actions = []\n  cur_pos = tuple(state.pos)  # current (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect the required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              return actions  # primitive missing; abort early\n\n          # Move to a free cell adjacent to the primitive\n          stand = free_adjacent(prim_loc)\n          path = bfs_path(cur_pos, stand)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand\n\n          # Step onto the primitive cell itself (if possible) to face it\n          if not is_blocked(prim_loc):\n              path = bfs_path(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:58:27.620866", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain planning data\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Identify the goal (arrow) and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest walkable path from start to goal (inclusive).\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []   # unreachable\n\n      # reconstruct path (including start)\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a position path (including start) to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing `kind` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of `target` (preferring N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target   # fallback (may be blocked)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)   # current (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur_pos, stand_pos)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand_pos\n\n          # Step onto the primitive cell itself (if possible) to face it\n          if not is_blocked(prim_loc):\n              path = bfs_path(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect the collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe requires a specific workshop, move there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:58:47.020477", "function_name": "make_arrow", "function_body": "  \"\"\"Improved version of `make_arrow_v1` with a bit more robustness.\"\"\"\n  import numpy as np\n  from collections import deque\n\n  # Action constants as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain world information\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal item index for \"arrow\" and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest 4\u2011connected walkable path from start to goal (inclusive).\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path backwards\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions (including start) into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell that contains the given kind.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of `target` (N, S, W, E preference).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      # fallback to the target itself (might be walkable)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Collect each required primitive the required number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur_pos, stand_pos)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand_pos\n\n          # Step onto the primitive cell itself (if not blocked)\n          if not is_blocked(prim_loc):\n              path = bfs_path(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect removal\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, travel there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:58:48.210008", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain world information\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal item index for \"arrow\" and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest 4\u2011connected walkable path from start to goal (inclusive).\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path backwards\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions (including start) into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell that contains the given kind.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of `target` (N, S, W, E preference).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      # fallback: the target itself (might be walkable)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur_pos, stand_pos)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand_pos\n\n          # Step onto the primitive cell itself (if not blocked)\n          if not is_blocked(prim_loc):\n              path = bfs_path(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, travel there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:59:17.619562", "function_name": "make_arrow", "function_body": "  # Action constants as defined in CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain a mutable copy of the grid for planning\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # (H, W, n_kinds) mutable copy\n\n  # Goal item index and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  non_grab = list(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies ``pos``.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def astar_path(start, goal):\n      \"\"\"A* search on the 4\u2011connected grid avoiding blocked cells.\n      Returns a list of positions from ``start`` (excluded) to ``goal`` (included).\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      open_set = []\n      heapq.heappush(open_set, (0 + manhattan(start, goal), 0, start, None))\n      came_from = {}\n      g_score = {start: 0}\n      while open_set:\n          _, cur_g, cur, parent = heapq.heappop(open_set)\n          if cur in came_from:\n              continue\n          came_from[cur] = parent\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if is_blocked(nxt):\n                      continue\n                  tentative_g = cur_g + 1\n                  if tentative_g < g_score.get(nxt, float('inf')):\n                      g_score[nxt] = tentative_g\n                      f = tentative_g + manhattan(nxt, goal)\n                      heapq.heappush(open_set, (f, tentative_g, nxt, cur))\n      else:\n          return []   # unreachable\n\n      # reconstruct path (exclude start)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  def manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (preferring N, S, W, E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      # fallback \u2013 if no free neighbour, just use the target cell itself\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = tuple(state.pos)   # current position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = astar_path(cur, stand_pos)\n          if not path and cur != stand_pos:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself\n          path = astar_path(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect removal of the primitive\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = astar_path(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions([cur] + path))\n              cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T22:59:18.755516", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T22:59:44.939063", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the item we need to produce\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial CraftState for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 400                     # safety cutoff\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand neighbours by trying every possible action\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:00:00.627100", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Get the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Use position, direction, inventory tuple, and grid bytes\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  # BFS initialization\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500                     # safety cutoff to avoid infinite search\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # If no plan found within the search budget, return empty list\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:00:24.261242", "function_name": "make_arrow", "function_body": "  # Reset the environment and get handles to the current state and world.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = np.copy(state.grid)           # Local mutable copy of the grid.\n\n  # Action constants.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks\n      from ``start`` to ``goal`` using a simple Manhattan walk (ignores obstacles).\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of ``cell`` (or the cell itself if none).\"\"\"\n      y, x = cell\n      candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return cell\n\n  def direction_to(src, dst):\n      \"\"\"Return the action that makes the agent at ``src`` face ``dst`` (one step).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine the primitives required to craft an arrow.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # Current agent position.\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the appropriate number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          stand = free_adjacent(target)\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          turn = direction_to(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          actions.append(USE)\n\n          # Update our local copy of the grid to reflect that the primitive\n          # has been collected, preventing re\u2011selection of the same cell.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE triggers the crafting action.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:00:25.441513", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = np.copy(state.grid)           # local copy to track collected items\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell that contains the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of `cell` (or the cell itself if none).\"\"\"\n      y, x = cell\n      candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return cell\n\n  def direction_to(src, dst):\n      \"\"\"Return the action that makes the agent at src face dst (one step).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for an arrow\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present; abort early.\n              return actions\n\n          stand = free_adjacent(target)\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          turn = direction_to(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          actions.append(USE)\n\n          # Update local grid copy to reflect that the primitive has been taken.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:00:58.235740", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell (y, x) containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of `cell` (or None if none).\"\"\"\n      y, x = cell\n      candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return None\n\n  def direction_to(src, dst):\n      \"\"\"Return the movement action that makes the agent at src face dst (one step).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on; fall back to the primitive cell itself\n          adj = free_adjacent(target) or target\n\n          # Move to the chosen adjacent cell\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (optional, helps USE)\n          turn = direction_to(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if recipe specifies one) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:00:59.388795", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                    # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_free(cell):\n      \"\"\"Return True if the cell is empty (no entity occupies it).\"\"\"\n      y, x = cell\n      return grid[y, x, :].sum() == 0\n\n  def bfs(start, goal):\n      \"\"\"Bread\u2011first search on the 2\u2011D grid avoiding occupied cells.\n      Returns a list of positions from start to goal (inclusive) or\n      None if no path exists.\"\"\"\n      from collections import deque\n      h, w = grid.shape[0], grid.shape[1]\n      visited = np.full((h, w), False, dtype=bool)\n      prev = dict()\n      q = deque([start])\n      visited[start] = True\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              # reconstruct path\n              path = [cur]\n              while cur != start:\n                  cur = prev[cur]\n                  path.append(cur)\n              path.reverse()\n              return path\n          y, x = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx] and is_free((ny, nx)):\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = cur\n                  q.append((ny, nx))\n      return None\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to action indices.\"\"\"\n      act = []\n      for (y0, x0), (y1, x1) in zip(path, path[1:]):\n          if y1 == y0 + 1:\n              act.append(DOWN)\n          elif y1 == y0 - 1:\n              act.append(UP)\n          elif x1 == x0 + 1:\n              act.append(RIGHT)\n          elif x1 == x0 - 1:\n              act.append(LEFT)\n      return act\n\n  def nearest_entity(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing the given kind index.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[np.argmin(dists)])\n\n  def free_adjacent(cell):\n      \"\"\"Return a list of free orthogonal neighbours of `cell`.\"\"\"\n      y, x = cell\n      neigh = []\n      for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and is_free((ny, nx)):\n              neigh.append((ny, nx))\n      return neigh\n\n  def direction_action(src, dst):\n      \"\"\"Return the action that makes the agent at src face dst (one step).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_cell = nearest_entity(prim_idx, cur_pos)\n          if prim_cell is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on (prefer the closest one)\n          adj_candidates = free_adjacent(prim_cell)\n          if not adj_candidates:\n              # No free neighbour; cannot pick up this primitive.\n              return actions\n          # pick the candidate with minimal Manhattan distance from current pos\n          adj = min(adj_candidates,\n                    key=lambda c: abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]))\n\n          # Move to the chosen adjacent cell\n          path = bfs(cur_pos, adj)\n          if path is None:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = adj\n\n          # Face the primitive (add a turn action \u2013 moving into the occupied cell is blocked\n          # but updates the facing direction)\n          turn = direction_action(cur_pos, prim_cell)\n          if turn is not None:\n              actions.append(turn)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = nearest_entity(ws_idx, cur_pos)\n      if ws_cell is not None:\n          # Find a free adjacent cell to the workshop\n          ws_adj_candidates = free_adjacent(ws_cell)\n          if ws_adj_candidates:\n              ws_adj = min(ws_adj_candidates,\n                           key=lambda c: abs(c[0] - cur_pos[0]) + abs(c[1] - cur_pos[1]))\n              path = bfs(cur_pos, ws_adj)\n              if path is not None:\n                  actions.extend(path_to_actions(path))\n                  cur_pos = ws_adj\n\n              # Face the workshop and use\n              turn = direction_action(cur_pos, ws_cell)\n              if turn is not None:\n                  actions.append(turn)\n              actions.append(USE)\n          else:\n              # No free neighbour \u2013 fallback to using from current location if already adjacent\n              turn = direction_action(cur_pos, ws_cell)\n              if turn is not None:\n                  actions.append(turn)\n              actions.append(USE)\n  else:\n      # No specific workshop; just issue a USE to trigger crafting\n      actions.append(USE)\n\n  return actions", "env_interactions": 39, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T23:01:30.117608", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      nonlocal pos\n      for a in path:\n          if a == 0:\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1:\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2:\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3:\n              pos = (pos[0] + 1, pos[1])\n\n  def collect_primitive(prim_idx, needed):\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break\n          path = None\n          target_loc = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  path = p\n                  target_loc = loc\n                  break\n          if path is None:\n              break\n          actions.extend(path)\n          move_along(path)\n          actions.append(4)  # USE\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  p = bfs(pos, {ws_cells[0]})\n                  if p:\n                      actions.extend(p)\n                      move_along(p)\n\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:01:31.282403", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # mutable copies of the environment state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of movement actions to reach any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # treat occupied cells as walls unless they are goal cells\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update the local position according to a sequence of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection helper\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect *needed* units of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # no more primitives left\n          chosen_path = None\n          chosen_loc = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  chosen_path = p\n                  chosen_loc = loc\n                  break\n          if chosen_path is None:\n              break  # unreachable primitive\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          actions.append(4)  # USE\n          grid[chosen_loc[0], chosen_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Guarantee that inventory[item_idx] >= amount, crafting if needed.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # ensure all ingredients are present\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  p = bfs(pos, {ws_cells[0]})\n                  if p:\n                      actions.extend(p)\n                      move_along(p)\n\n          # perform the craft action\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:02:15.242182", "function_name": "make_arrow", "function_body": "  # reset env and get references\n  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # resolve action indices, fallback to defaults\n  try:\n      specs = env.action_specs()\n      DOWN = specs.get('DOWN', 0)\n      UP = specs.get('UP', 1)\n      LEFT = specs.get('LEFT', 2)\n      RIGHT = specs.get('RIGHT', 3)\n      USE = specs.get('USE', 4)\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # helper to test if a cell is blocked (non\u2011grabbable entity present)\n  def is_blocked(pos):\n      y, x = pos\n      return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  # BFS shortest path avoiding blocked cells\n  def bfs(start, goal):\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      visited = np.full((h, w), False, dtype=bool)\n      prev = {}\n      q = collections.deque([start])\n      visited[start] = True\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          cy, cx = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = cy + dy, cx + dx\n              if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx] and not is_blocked((ny, nx)):\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = cur\n                  q.append((ny, nx))\n      else:\n          return None\n      # reconstruct\n      path = [goal]\n      while path[-1] != start:\n          path.append(prev[path[-1]])\n      path.reverse()\n      return path\n\n  # translate a position path into action list\n  def path_to_actions(path):\n      act = []\n      for (y0, x0), (y1, x1) in zip(path, path[1:]):\n          if y1 == y0 + 1:\n              act.append(DOWN)\n          elif y1 == y0 - 1:\n              act.append(UP)\n          elif x1 == x0 + 1:\n              act.append(RIGHT)\n          elif x1 == x0 - 1:\n              act.append(LEFT)\n      return act\n\n  # locate nearest cell containing a given kind index\n  def nearest(kind_idx, from_pos):\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      best = locs[np.argmin(dists)]\n      return tuple(best)\n\n  # pick a free orthogonal neighbour of a cell (or the cell itself)\n  def stand_adjacent(cell):\n      y, x = cell\n      for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and not is_blocked((ny, nx)):\n              return (ny, nx)\n      return cell\n\n  # orient the agent towards a target cell (adds a single turn action)\n  def turn_towards(src, dst):\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # --------------------------------------------------------------\n  # Determine the goal (arrow) and its primitive requirements\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # --------------------------------------------------------------\n  # Collect all required primitives\n  # --------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return actions\n          stand = stand_adjacent(target)\n          path = bfs(cur_pos, stand)\n          if path is None:\n              return actions\n          actions += path_to_actions(path)\n          cur_pos = stand\n\n          turn = turn_towards(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          actions.append(USE)\n\n  # --------------------------------------------------------------\n  # Move to the workshop (if recipe specifies one) and craft\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          path = bfs(cur_pos, ws_cell)\n          if path is not None:\n              actions += path_to_actions(path)\n              cur_pos = ws_cell\n\n  # final use to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
