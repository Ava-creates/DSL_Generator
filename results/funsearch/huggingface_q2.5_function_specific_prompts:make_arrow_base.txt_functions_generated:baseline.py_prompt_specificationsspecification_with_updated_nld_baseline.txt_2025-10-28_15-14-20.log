{"timestamp": "2025-10-28T17:06:49.457502", "function_name": "make_arrow", "function_body": "  actions = []\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)  # (x, y)\n\n  def _move(cur, tgt):\n      \"\"\"Return a list of movement actions (Manhattan) from cur to tgt.\"\"\"\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  # ---- Collect primitives ----\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Find all remaining cells containing this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              break  # no more of this primitive on the map\n          # Choose the nearest by Manhattan distance\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),\n          )\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)\n          # Remove the primitive from our internal copy of the grid\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # ---- Move to workshop and craft ----\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target = min(\n              ws_locs,\n              key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),\n          )\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:07:11.806229", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftLab's action specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(cur_pos, target, seq):\n      \"\"\"Append moves that bring cur_pos (mutable [x,y]) to target (x,y).\"\"\"\n      while cur_pos[0] != target[0] or cur_pos[1] != target[1]:\n          if cur_pos[0] < target[0]:\n              seq.append(RIGHT)\n              cur_pos[0] += 1\n          elif cur_pos[0] > target[0]:\n              seq.append(LEFT)\n              cur_pos[0] -= 1\n          elif cur_pos[1] < target[1]:\n              seq.append(DOWN)\n              cur_pos[1] += 1\n          elif cur_pos[1] > target[1]:\n              seq.append(UP)\n              cur_pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return (x, y) of the nearest cell that contains `kind_idx`.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine starting position (use live state if available)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a copy of the static grid so we can mark primitives as taken.\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources needed for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # No more of this primitive on the map \u2013 stop planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                     # pick up primitive\n          grid[target[1], target[0], kind_idx] = 0  # mark as collected\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                     # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:07:12.907265", "function_name": "make_arrow", "function_body": "  # constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(pos, target, seq):\n      \"\"\"Append moves to seq to bring pos (list [x,y]) to target (list [x,y]).\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return [x,y] of nearest cell containing kind_idx, or None.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # start position\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # mutable copy of the static grid to track collected items\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # cannot find required primitive \u2013 stop planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)\n          # mark the item as taken\n          grid[target[1], target[0], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:07:42.035746", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(pos, target, seq):\n      \"\"\"Append moves to bring `pos` (list [x, y]) to `target` (list [x, y]).\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return the (x, y) of the nearest cell containing `kind_idx`.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine starting position.\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid to keep track of collected items.\n  grid = env.scenario.init_grid.copy()\n\n  # Goal index comes from the task stored in the environment.\n  goal_idx = env.task.goal\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                         # pick up the item\n          grid[target[1], target[0], kind_idx] = 0    # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                         # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:07:43.134967", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # Starting position (use live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Working copy of the static grid (to mark collected primitives)\n  grid = env.scenario.init_grid.copy()\n\n  cookbook = env.world.cookbook\n  # Simulated inventory for planning purposes\n  inventory = np.zeros(cookbook.n_kinds, dtype=int)\n\n  def _move_to(target):\n      \"\"\"Append Manhattan moves that bring ``cur_pos`` to ``target``.\"\"\"\n      while cur_pos[0] != target[0] or cur_pos[1] != target[1]:\n          if cur_pos[0] < target[0]:\n              actions.append(RIGHT)\n              cur_pos[0] += 1\n          elif cur_pos[0] > target[0]:\n              actions.append(LEFT)\n              cur_pos[0] -= 1\n          elif cur_pos[1] < target[1]:\n              actions.append(DOWN)\n              cur_pos[1] += 1\n          elif cur_pos[1] > target[1]:\n              actions.append(UP)\n              cur_pos[1] -= 1\n\n  def _nearest_kind(kind_idx):\n      \"\"\"Return coordinates of the nearest cell containing ``kind_idx``.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  def _ensure_primitive(kind_idx):\n      \"\"\"Collect one instance of a primitive ``kind_idx``.\"\"\"\n      target = _nearest_kind(kind_idx)\n      if target is None:\n          return False\n      _move_to(target)\n      actions.append(USE)                     # pick up\n      grid[target[1], target[0], kind_idx] = 0  # mark as taken\n      inventory[kind_idx] += 1\n      return True\n\n  def _craft_item(item_idx):\n      \"\"\"Recursively ensure ``item_idx`` is in inventory, crafting as needed.\"\"\"\n      if inventory[item_idx] > 0:\n          return\n\n      recipe = cookbook.recipes.get(item_idx, {})\n      # Gather all ingredient items first\n      for ing_idx, cnt in recipe.items():\n          if ing_idx == \"_at\":\n              continue\n          for _ in range(cnt):\n              if ing_idx in cookbook.primitives:\n                  if not _ensure_primitive(ing_idx):\n                      return\n              else:\n                  _craft_item(ing_idx)\n\n      # Move to the required workshop (if any) and craft\n      workshop = recipe.get(\"_at\")\n      if workshop is not None:\n          wk_pos = _nearest_kind(workshop)\n          if wk_pos is not None:\n              _move_to(wk_pos)\n      actions.append(USE)                     # craft at current location\n      inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Plan for the goal item\n  # ----------------------------------------------------------------------\n  goal_idx = env.task.goal\n  _craft_item(goal_idx)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:08:04.054022", "function_name": "make_arrow", "function_body": "  # reset environment and get handles\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # action constants (as defined in CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell (Manhattan distance) containing a kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Helper: generate a Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # arrow not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting required counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive missing \u2013 abort early\n              return action_seq\n          # move to the primitive location\n          for a in _path(state.pos, target):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n          # pick it up\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, move there before crafting\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n\n  # ------------------------------------------------------------------\n  # Final craft action (USE) at current location (workshop or open ground)\n  # ------------------------------------------------------------------\n  _, _, _ = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:08:05.164137", "function_name": "make_arrow", "function_body": "  # Action constants as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: check if a cell is traversable (empty) or is the target cell\n  # ------------------------------------------------------------------\n  def _is_traversable(grid, pos, target):\n      i, j = pos\n      if pos == target:\n          return True\n      # cell is traversable if no kind occupies it\n      return not grid[i, j, :].any()\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to find a shortest path (list of positions) from src to dst\n  # ------------------------------------------------------------------\n  def _bfs_path(src, dst, grid):\n      h, w, _ = grid.shape\n      visited = np.full((h, w), False, dtype=bool)\n      prev = dict()\n      q = collections.deque()\n      q.append(src)\n      visited[src] = True\n      while q:\n          cur = q.popleft()\n          if cur == dst:\n              # reconstruct path\n              path = []\n              while cur != src:\n                  path.append(cur)\n                  cur = prev[cur]\n              path.append(src)\n              path.reverse()\n              return path\n          r, c = cur\n          for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w:\n                  nxt = (nr, nc)\n                  if not visited[nxt] and _is_traversable(grid, nxt, dst):\n                      visited[nxt] = True\n                      prev[nxt] = cur\n                      q.append(nxt)\n      return None  # no path found\n\n  # ------------------------------------------------------------------\n  # Helper: convert a list of positions into actions\n  # ------------------------------------------------------------------\n  def _positions_to_actions(path):\n      actions = []\n      for (r0, c0), (r1, c1) in zip(path, path[1:]):\n          if r1 == r0 + 1:\n              actions.append(DOWN)\n          elif r1 == r0 - 1:\n              actions.append(UP)\n          elif c1 == c0 + 1:\n              actions.append(RIGHT)\n          elif c1 == c0 - 1:\n              actions.append(LEFT)\n          else:\n              raise ValueError(\"Invalid step in path\")\n      return actions\n\n  # ------------------------------------------------------------------\n  # Initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []  # arrow not defined\n\n  # ------------------------------------------------------------------\n  # Primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = None\n          # locate nearest instance of the primitive\n          min_dist = None\n          h, w, _ = state.grid.shape\n          for i in range(h):\n              for j in range(w):\n                  if state.grid[i, j, prim_idx] > 0:\n                      d = abs(i - state.pos[0]) + abs(j - state.pos[1])\n                      if min_dist is None or d < min_dist:\n                          min_dist = d\n                          target = (i, j)\n          if target is None:\n              # primitive missing; abort early\n              return action_seq\n\n          # find path to the primitive\n          path = _bfs_path(state.pos, target, state.grid)\n          if path is None:\n              # cannot reach; abort\n              return action_seq\n          for a in _positions_to_actions(path):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n          # pick it up\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  # ------------------------------------------------------------------\n  # If recipe specifies a workshop, go there before crafting\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = None\n      # locate any workshop cell\n      for i in range(state.grid.shape[0]):\n          for j in range(state.grid.shape[1]):\n              if state.grid[i, j, workshop_idx] > 0:\n                  workshop_pos = (i, j)\n                  break\n          if workshop_pos:\n              break\n      if workshop_pos is not None:\n          path = _bfs_path(state.pos, workshop_pos, state.grid)\n          if path is not None:\n              for a in _positions_to_actions(path):\n                  _, _, _ = env.step(a)\n                  state = env._current_state\n                  action_seq.append(a)\n\n  # ------------------------------------------------------------------\n  # Final craft action (USE) at current location\n  # ------------------------------------------------------------------\n  _, _, _ = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:08:25.414962", "function_name": "make_arrow", "function_body": "  actions = []\n  spec = env.action_specs()\n  DOWN = spec['DOWN']\n  UP = spec['UP']\n  LEFT = spec['LEFT']\n  RIGHT = spec['RIGHT']\n  USE = spec['USE']\n\n  state = env._current_state\n  pos = tuple(state.pos)\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}\n\n  # Work on a copy of the grid so we can \u201cremove\u201d items as we pick them up.\n  grid = state.grid.copy()\n\n  def _move(cur, tgt):\n      \"\"\"Return a list of actions to walk from cur to tgt using Manhattan steps.\"\"\"\n      moves = []\n      dx = tgt[0] - cur[0]\n      dy = tgt[1] - cur[1]\n      while dx:\n          if dx > 0:\n              moves.append(DOWN)\n              dx -= 1\n          else:\n              moves.append(UP)\n              dx += 1\n      while dy:\n          if dy > 0:\n              moves.append(RIGHT)\n              dy -= 1\n          else:\n              moves.append(LEFT)\n              dy += 1\n      return moves\n\n  # Collect each required primitive the required number of times.\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more of this primitive on the map; abort early.\n              break\n          # Choose the closest occurrence (Manhattan distance).\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n          )\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)\n          # Simulate picking up the item.\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # After gathering primitives, go to the appropriate workshop and craft.\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target = ws_locs[0]\n          actions.extend(_move(pos, target))\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:08:26.529757", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  pos = tuple(state.pos)\n\n  spec = env.action_specs()\n  DOWN = spec['DOWN']\n  UP = spec['UP']\n  LEFT = spec['LEFT']\n  RIGHT = spec['RIGHT']\n  USE = spec['USE']\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}\n\n  # Work on a mutable copy of the grid to track consumed items.\n  grid = state.grid.copy()\n\n  def _move_actions(cur, tgt):\n      \"\"\"Return a list of actions to move from cur to tgt using Manhattan steps.\"\"\"\n      moves = []\n      dx = tgt[0] - cur[0]\n      dy = tgt[1] - cur[1]\n      while dx != 0:\n          if dx > 0:\n              moves.append(DOWN)\n              dx -= 1\n          else:\n              moves.append(UP)\n              dx += 1\n      while dy != 0:\n          if dy > 0:\n              moves.append(RIGHT)\n              dy -= 1\n          else:\n              moves.append(LEFT)\n              dy += 1\n      return moves\n\n  # Collect each required primitive the needed number of times.\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              break  # No more of this primitive on the map.\n          # Choose the closest occurrence (Manhattan distance).\n          target = min(locations,\n                       key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          actions.extend(_move_actions(pos, target))\n          pos = target\n          actions.append(USE)\n          # Simulate picking up the item.\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # After gathering primitives, go to the appropriate workshop and craft.\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target = ws_locs[0]\n          actions.extend(_move_actions(pos, target))\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:08:54.455058", "function_name": "make_arrow", "function_body": "  # Resolve the scenario and world objects (wrappers may expose them differently)\n  scenario = getattr(env, \"scenario\", None)\n  if scenario is None:\n      scenario = env\n  world = getattr(scenario, \"world\", None)\n  if world is None:\n      world = getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Identify the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search over the state space to discover a feasible plan\n  # ------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory vector, and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:09:10.147772", "function_name": "make_arrow", "function_body": "  # retrieve scenario and world\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # get target index\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      state = node.state\n\n      if state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt = state.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:09:35.743313", "function_name": "make_arrow", "function_body": "  # Get scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n\n  # Find index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise start state\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to hash a state (position, direction, inventory, grid layout)\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Parameters\n  MAX_STEPS = 300                     # limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long sequences\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:09:51.493780", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n\n  # Identify the index of the goal item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a state for visited set\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Search parameters\n  MAX_STEPS = 300                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long sequences\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If search exhausts without finding a plan, return empty list\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:10:18.895533", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup and constants\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS shortest path that avoids non\u2011grabbable entities\n  # ----------------------------------------------------------------------\n  def _bfs_path(src, dst, grid):\n      h, w, _ = grid.shape\n      blocked = env.world.non_grabbable_indices\n\n      def cell_free(r, c):\n          if not (0 <= r < h and 0 <= c < w):\n              return False\n          # a cell is blocked if any non\u2011grabbable kind is present (>0)\n          return not any(grid[r, c, k] > 0 for k in blocked)\n\n      from collections import deque\n      q = deque([src])\n      parent = {src: None}\n      while q:\n          r, c = q.popleft()\n          if (r, c) == dst:\n              break\n          for dr, dc, act in DIRS:\n              nr, nc = r + dr, c + dc\n              if (nr, nc) not in parent and cell_free(nr, nc):\n                  parent[(nr, nc)] = (r, c, act)\n                  q.append((nr, nc))\n      if dst not in parent:\n          return []  # unreachable\n\n      # reconstruct actions from dst back to src\n      actions = []\n      cur = dst\n      while parent[cur] is not None:\n          pr, pc, act = parent[cur]\n          actions.append(act)\n          cur = (pr, pc)\n      actions.reverse()\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell (Manhattan distance) containing a kind\n  # ----------------------------------------------------------------------\n  def _nearest_cell(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ----------------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # ----------------------------------------------------------------------\n  def _any_cell(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Initialise a fresh episode\n  # ----------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ----------------------------------------------------------------------\n  # Identify the goal index for \"arrow\"\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # recipe not found\n      return []\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ----------------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (respecting required counts)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = _nearest_cell(state.grid, prim_idx, state.pos)\n          if target is None:          # primitive missing \u2013 abort early\n              return action_seq\n          # Move to the primitive using BFS (avoiding obstacles)\n          for a in _bfs_path(state.pos, target, state.grid):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n          # Pick it up\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow (possibly at a required workshop)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any_cell(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _bfs_path(state.pos, workshop_pos, state.grid):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n\n  # Perform the crafting action\n  _, _, _ = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 14, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:10:20.023886", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Constants and movement helpers\n  # --------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # --------------------------------------------------------------\n  # BFS that respects non\u2011grabbable obstacles\n  # --------------------------------------------------------------\n  def _bfs(src, dst, grid):\n      h, w, _ = grid.shape\n      blocked = env.world.non_grabbable_indices\n\n      def _free(r, c):\n          if not (0 <= r < h and 0 <= c < w):\n              return False\n          # a cell is blocked if any non\u2011grabbable kind is present\n          return not any(grid[r, c, k] > 0 for k in blocked)\n\n      from collections import deque\n      q = deque([src])\n      parent = {src: None}\n      while q:\n          r, c = q.popleft()\n          if (r, c) == dst:\n              break\n          for dr, dc, act in DIRS:\n              nr, nc = r + dr, c + dc\n              if (nr, nc) not in parent and _free(nr, nc):\n                  parent[(nr, nc)] = (r, c, act)\n                  q.append((nr, nc))\n\n      if dst not in parent:\n          return []          # unreachable\n\n      # reconstruct actions\n      actions = []\n      cur = dst\n      while parent[cur] is not None:\n          pr, pc, act = parent[cur]\n          actions.append(act)\n          cur = (pr, pc)\n      actions.reverse()\n      return actions\n\n  # --------------------------------------------------------------\n  # Find the nearest cell (Manhattan) that contains a given kind\n  # --------------------------------------------------------------\n  def _nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # --------------------------------------------------------------\n  # Find any cell that contains a given kind (used for workshops)\n  # --------------------------------------------------------------\n  def _any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # --------------------------------------------------------------\n  # Begin episode and fetch world information\n  # --------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index for the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # not found\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  needed = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive (respecting multiplicities)\n  # --------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = _nearest(state.grid, prim_idx, state.pos)\n          if target is None:          # primitive missing \u2013 abort early\n              return action_seq\n          # move to the primitive\n          for a in _bfs(state.pos, target, state.grid):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n          # pick it up\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  # --------------------------------------------------------------\n  # Move to required workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _bfs(state.pos, workshop_pos, state.grid):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n\n  # final crafting action\n  _, _, _ = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 14, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:11:19.647499", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch core objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action identifiers (as defined by CraftLab.action_specs).\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def occupied(y, x):\n      \"\"\"A cell is considered occupied if any kind is present.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Bread\u2011first search returning a list of movement actions that\n      takes the agent from ``start`` to ``goal`` while avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          y, x, path = q.popleft()\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if occupied(ny, nx):\n                  continue\n              new_path = path + [act]\n              if (ny, nx) == goal:\n                  return new_path\n              visited.add((ny, nx))\n              q.append((ny, nx, new_path))\n      return []  # No path found.\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return the coordinates of the closest cell that currently contains ``kind_idx``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, forbidden=set()):\n      \"\"\"Find a free neighbour of ``cell`` that is not in ``forbidden``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in forbidden:\n              continue\n          if not occupied(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine the goal index and the primitive requirements.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  harvested = set()                       # cells already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, forbidden=harvested)\n          if adj is None:\n              # If no free neighbour, fall back to standing on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (a blocked move changes direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid to reflect removal.\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, forbidden=harvested)\n          if ws_adj is None:\n              ws_adj = cur_pos  # Stay where we are if no free neighbour.\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop.\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger the crafting action.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:11:20.785926", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # Reset environment to start fresh\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy\n\n  # Helper functions\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_blocked(y, x):\n      \"\"\"Return True if the cell cannot be stepped on.\"\"\"\n      return grid[y, x].any()   # any entity occupies the cell\n\n  def bfs(start, goal):\n      \"\"\"Return list of actions to move from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          y, x, path = q.popleft()\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              new_path = path + [act]\n              if (ny, nx) == goal:\n                  return new_path\n              visited.add((ny, nx))\n              q.append((ny, nx, new_path))\n      # No path found \u2013 fall back to empty list\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell that contains the given kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell, forbidden=set()):\n      \"\"\"Return a free neighbour of ``cell`` that is not in ``forbidden``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in forbidden:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n  harvested = set()    # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = free_adjacent(target, forbidden=harvested)\n          if adj is None:\n              # No free neighbour; fall back to the primitive cell itself\n              adj = target\n\n          # Move to the adjacent cell\n          actions += bfs(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (if not standing on it)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n          # Use to pick up\n          actions.append(USE)\n\n          # Update internal copy of the grid so later searches ignore this cell\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = free_adjacent(ws_cell, forbidden=harvested)\n          if ws_adj is None:\n              ws_adj = cur_pos  # stay where we are if no free neighbour\n          actions += bfs(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Final USE to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:11:47.193081", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # --------------------------------------------------------------------- #\n  # Helper: BFS path finder that returns a list of movement actions.\n  # --------------------------------------------------------------------- #\n  def _bfs_path(start, target, grid, non_grab):\n      \"\"\"Return a list of movement action indices from start to target.\n\n      Args:\n          start (tuple): (x, y) current position.\n          target (tuple): (x, y) desired position.\n          grid (np.ndarray): occupancy tensor (W, H, n_kinds).\n          non_grab (list[int]): indices of non\u2011grabbable entities.\n\n      Returns:\n          list[int] | None: sequence of action indices, or None if no path.\n      \"\"\"\n      width, height = grid.shape[:2]\n\n      # Cells that cannot be entered: any non\u2011grabbable entity present\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # The target cell may be occupied (e.g., a workshop); allow stepping on it\n      blocked[target[0], target[1]] = False\n\n      # BFS structures\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_to = {}\n\n      spec = env.action_specs()\n      dirs = [\n          (spec[\"DOWN\"], (1, 0)),\n          (spec[\"UP\"], (-1, 0)),\n          (spec[\"RIGHT\"], (0, 1)),\n          (spec[\"LEFT\"], (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_to[nxt] = a\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None\n\n      # Reconstruct action list\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_to[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------------- #\n  # Gather information about the task\n  # --------------------------------------------------------------------- #\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)               # current (x, y)\n  grid = state.grid.copy()              # occupancy tensor to simulate updates\n  non_grab = list(env.world.non_grabbable_indices)\n\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # Collect each required primitive (may need multiple copies)\n  # --------------------------------------------------------------------- #\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Find all remaining instances of this primitive on the map\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more copies left; give up on this primitive\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Plan a path to the target cell\n          path = _bfs_path(pos, target, grid, non_grab)\n          if path is None:\n              # Fallback to simple Manhattan moves if BFS fails\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)                     # pick up the primitive\n\n          # Update simulated position and grid (primitive removed)\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # --------------------------------------------------------------------- #\n  # Move to the workshop (if any) and craft the final item\n  # --------------------------------------------------------------------- #\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = _bfs_path(pos, target_ws, grid, non_grab)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)                     # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:11:48.318054", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # --------------------------------------------------------------------- #\n  # Retrieve action indices from the environment specification\n  # --------------------------------------------------------------------- #\n  spec = env.action_specs()\n  DOWN = spec[\"DOWN\"]\n  UP = spec[\"UP\"]\n  LEFT = spec[\"LEFT\"]\n  RIGHT = spec[\"RIGHT\"]\n  USE = spec[\"USE\"]\n\n  # --------------------------------------------------------------------- #\n  # Goal and required primitive counts\n  # --------------------------------------------------------------------- #\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # --------------------------------------------------------------------- #\n  # Snapshot of current state (grid, position)\n  # --------------------------------------------------------------------- #\n  state = env._current_state\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid.copy()               # (W, H, n_kinds)\n\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # Helper: BFS path finder returning a list of movement actions\n  # --------------------------------------------------------------------- #\n  def bfs(start, target):\n      \"\"\"Return list of actions to move from start to target, or None.\"\"\"\n      width, height = grid.shape[:2]\n\n      # Cells that block movement: any non\u2011grabbable entity present\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Allow stepping on the target even if it would otherwise be blocked\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_to = {}\n\n      directions = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_to[nxt] = a\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None\n\n      # Reconstruct path (list of actions)\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_to[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------------- #\n  # Collect each required primitive (may need multiple copies)\n  # --------------------------------------------------------------------- #\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Locate remaining instances of this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more copies left; abort collection for this primitive\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Plan a path to the target cell\n          path = bfs(pos, target)\n          if path is None:\n              # Fallback to simple Manhattan moves if BFS fails\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)                     # pick up the primitive\n\n          # Update simulated position and grid (primitive removed)\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # --------------------------------------------------------------------- #\n  # Move to the workshop (if any) and craft the final item\n  # --------------------------------------------------------------------- #\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          target_ws = min(\n              ws_locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n          actions.extend(path)\n          actions.append(USE)                     # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:12:14.088026", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Reset the environment and fetch core objects\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                    # (WIDTH, HEIGHT, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` using a simple Manhattan walk.\n      No obstacle checking is performed.\"\"\"\n      y0, x0 = start\n      y1, x1 = goal\n      actions = []\n      dy, dx = y1 - y0, x1 - x0\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing ``kind_idx``. Returns (y, x) or None.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and its primitive requirements\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour \u2013 stand on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (if not standing on it).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # If a specific workshop is required, move to it.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # ------------------------------------------------------------------\n  # Trigger crafting of the arrow.\n  # ------------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:12:15.199437", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # Reset the environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  # Make a mutable copy of the grid so we can update it after picking items\n  grid = state.grid.copy()\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return grid[y, x].any()\n\n  def bfs(start, goal):\n      \"\"\"Return a list of actions to move from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          y, x, path = q.popleft()\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              new_path = path + [act]\n              if (ny, nx) == goal:\n                  return new_path\n              visited.add((ny, nx))\n              q.append((ny, nx, new_path))\n      # No path found \u2013 return empty list (caller may handle)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell, forbidden=set()):\n      \"\"\"Return a free neighbour of ``cell`` not in ``forbidden``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in forbidden:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def face_towards(src, dst):\n      \"\"\"Return a single movement action that makes src face dst (may be None if already aligned).\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos               # (y, x)\n  harvested_cells = set()           # remember where we already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = free_adjacent(target, forbidden=harvested_cells)\n          if adj is None:\n              # No free neighbour; fall back to staying where we are\n              adj = cur_pos\n\n          # Move to the chosen adjacent cell\n          actions += bfs(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive and pick it up\n          face_act = face_towards(cur_pos, target)\n          if face_act is not None:\n              actions.append(face_act)\n          actions.append(USE)\n\n          # Update internal grid copy so future searches ignore this cell\n          grid[target[0], target[1], prim_idx] = 0\n          harvested_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = free_adjacent(ws_cell, forbidden=harvested_cells)\n          if ws_adj is None:\n              ws_adj = cur_pos\n          actions += bfs(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop before using\n          face_act = face_towards(cur_pos, ws_cell)\n          if face_act is not None:\n              actions.append(face_act)\n\n  # Final USE to trigger crafting (or to craft directly if no workshop)\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:13:02.010312", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to find a path (as actions) from start to a cell\n  # adjacent to any target location, avoiding occupied cells.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      width, height, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # any non\u2011zero kind blocks movement\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Explore 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook objects\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n\n  # Goal information (hard\u2011coded to \"arrow\")\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locations currently containing this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Update agent position following the path\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # Locate workshop cells\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft using the workshop\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:13:03.140164", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move one step and update position + direction\n  # ------------------------------------------------------------------\n  def _step(pos, direction, act):\n      x, y = pos\n      if act == RIGHT:\n          return (x + 1, y), act\n      if act == LEFT:\n          return (x - 1, y), act\n      if act == DOWN:\n          return (x, y + 1), act\n      if act == UP:\n          return (x, y - 1), act\n      return pos, direction\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to a free cell adjacent to any target cell.\n  # Returns (list_of_actions, final_position)\n  # ------------------------------------------------------------------\n  def _bfs_adj(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (x, y)\n          for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),\n                                 (DOWN, (0, 1)), (UP, (0, -1))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return [], start\n\n  # ------------------------------------------------------------------\n  # Identify world, cookbook and goal\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Get current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n  pos = tuple(state.pos)\n  direction = int(state.dir)\n  grid = state.grid\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count_needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= count_needed:\n              break\n          # Move adjacent to the primitive\n          path, pos = _bfs_adj(pos, [loc])\n          actions.extend(path)\n          for act in path:\n              pos, direction = _step(pos, direction, act)\n\n          # Face the primitive\n          needed_dir = None\n          if loc[0] > pos[0]:\n              needed_dir = RIGHT\n          elif loc[0] < pos[0]:\n              needed_dir = LEFT\n          elif loc[1] > pos[1]:\n              needed_dir = DOWN\n          elif loc[1] < pos[1]:\n              needed_dir = UP\n\n          if needed_dir is not None and direction != needed_dir:\n              opposite = {RIGHT: LEFT, LEFT: RIGHT, DOWN: UP, UP: DOWN}[needed_dir]\n              w, h, _ = grid.shape\n              opp_dx, opp_dy = {RIGHT: (1, 0), LEFT: (-1, 0),\n                                DOWN: (0, 1), UP: (0, -1)}[opposite]\n              opp_x, opp_y = pos[0] + opp_dx, pos[1] + opp_dy\n              if 0 <= opp_x < w and 0 <= opp_y < h and not np.any(grid[opp_x, opp_y] > 0):\n                  actions.append(opposite)\n                  pos, direction = _step(pos, direction, opposite)\n                  actions.append(needed_dir)\n                  pos, direction = _step(pos, direction, needed_dir)\n              else:\n                  actions.append(needed_dir)\n                  pos, direction = _step(pos, direction, needed_dir)\n\n          # Pick up the primitive\n          actions.append(USE)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft at the required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_locs[0]\n          path, pos = _bfs_adj(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              pos, direction = _step(pos, direction, act)\n\n          # Face the workshop\n          needed_dir = None\n          if target_ws[0] > pos[0]:\n              needed_dir = RIGHT\n          elif target_ws[0] < pos[0]:\n              needed_dir = LEFT\n          elif target_ws[1] > pos[1]:\n              needed_dir = DOWN\n          elif target_ws[1] < pos[1]:\n              needed_dir = UP\n\n          if needed_dir is not None and direction != needed_dir:\n              opposite = {RIGHT: LEFT, LEFT: RIGHT, DOWN: UP, UP: DOWN}[needed_dir]\n              w, h, _ = grid.shape\n              opp_dx, opp_dy = {RIGHT: (1, 0), LEFT: (-1, 0),\n                                DOWN: (0, 1), UP: (0, -1)}[opposite]\n              opp_x, opp_y = pos[0] + opp_dx, pos[1] + opp_dy\n              if 0 <= opp_x < w and 0 <= opp_y < h and not np.any(grid[opp_x, opp_y] > 0):\n                  actions.append(opposite)\n                  pos, direction = _step(pos, direction, opposite)\n                  actions.append(needed_dir)\n                  pos, direction = _step(pos, direction, needed_dir)\n              else:\n                  actions.append(needed_dir)\n                  pos, direction = _step(pos, direction, needed_dir)\n\n          # Craft the arrow\n          actions.append(USE)\n\n  return actions", "env_interactions": 15, "island_id": 4, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:13:20.597378", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain references to the underlying objects.\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices as defined by the environment's action specifications.\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  def manhattan_path(start, goal):\n      \"\"\"Generate a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk\n      from ``start`` to ``goal`` using Manhattan distance. No obstacle checking\n      is performed; this is sufficient for the simple deterministic scenarios\n      used in the CraftWorld tasks.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Find the nearest cell that contains ``kind`` (primitive or workshop).\n      Returns a tuple (y, x) or ``None`` if the kind does not appear on the map.\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for the arrow and the primitive requirements.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # Current agent position as (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fallback: stand directly on the primitive cell.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (a blocked move updates direction).\n          dy = ty - cur_pos[0]\n          dx = tx - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:13:21.709140", "function_name": "make_arrow", "function_body": "  # Reset environment and extract core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Action indices (as defined by CraftLab.action_specs)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks\n      from ``start`` to ``goal`` using Manhattan distance only.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Find the nearest cell that currently contains ``kind``.\n      Returns (y, x) or ``None`` if not present.\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine the goal (arrow) and its primitive requirements\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not available; abort planning.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fallback: stand directly on the primitive cell.\n              adj = (ty, tx)\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (direction that would move into it).\n          dy = ty - cur_pos[0]\n          dx = tx - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:13:47.437247", "function_name": "make_arrow", "function_body": "  # Reset environment and get handles\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices (matching CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour (y, x) of ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  collected_cells = set()\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected_cells)\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell itself\n              adj = target\n\n          # Move to the chosen adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (blocked move towards it)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected_cells)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:13:48.552824", "function_name": "make_arrow", "function_body": "  # reset environment to start a fresh episode\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  # work on a mutable copy of the grid to keep track of collected items\n  grid = state.grid.copy()             # shape (WIDTH, HEIGHT, n_kinds)\n\n  # action indices (as defined by CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any non\u2011grabbable entity occupies it.\"\"\"\n      return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal,\n      avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # no path \u2013 return empty (should not happen for valid scenarios)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell to `cell` that is not in `avoid`.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  taken_cells = set()                     # primitives already collected\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, qty in needed.items():\n      for _ in range(qty):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive missing \u2013 abort early\n              return actions\n\n          # choose a free neighbouring cell to stand on while picking up\n          adj = free_adjacent(target, avoid=taken_cells)\n          if adj is None:\n              # fallback: stand on the primitive cell itself if possible\n              if not is_blocked(*target):\n                  adj = target\n              else:\n                  return actions\n\n          # move to the chosen adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # face the primitive (add a blocked move direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # pick up the primitive\n          actions.append(USE)\n\n          # update internal grid representation and remember the cell\n          grid[target[0], target[1], prim_idx] = 0\n          taken_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # try to stand on a free neighbour of the workshop\n          ws_adj = free_adjacent(ws_cell, avoid=taken_cells)\n          if ws_adj is None:\n              ws_adj = ws_cell  # fallback: stand directly on workshop cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 25, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:14:12.311340", "function_name": "make_arrow", "function_body": "  DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n  from collections import deque\n  import numpy as np\n\n  def bfs_adj(start, targets, grid):\n      \"\"\"Return a list of actions that moves the agent from ``start`` to a cell\n      adjacent to any cell in ``targets`` while avoiding non\u2011grabbable blocks.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Cells that cannot be entered.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # local mutable copy\n  pos = tuple(state.pos)            # (x, y)\n\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # Primitive (or intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect required primitives.\n  # --------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # No more of this primitive on the map \u2013 abort.\n              return plan\n\n          path = bfs_adj(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(4)   # USE action\n\n          # Identify which primitive cell we just used.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              break  # safety\n\n          # Update the simulated grid and remaining count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # --------------------------------------------------------------\n  # 2. Go to the workshop and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adj(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(4)   # USE to craft at the workshop\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:14:13.422132", "function_name": "make_arrow", "function_body": "  # action indices (consistent with CraftLab.action_specs)\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n  USE_ACT = 4\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search returning a list of actions that moves the agent\n      from ``start`` to any cell that is orthogonally adjacent to one of the\n      ``targets`` (list of (x, y) tuples).  Cells that contain any\n      non\u2011grabbable entity are treated as blocked.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # blocked cells = any non\u2011grabbable entity present\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacent cell\n      return []\n\n  # ------------------------------------------------------------------\n  # Begin planning.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable simulation of the world\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index is stored in the task (env.task.goal).  It may be an int\n  # or a Struct; we only need the integer index.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # ------------------------------------------------------------------\n  # 1. Determine primitive (and intermediate) requirements.\n  # ------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          # locate all cells that currently contain this kind\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # primitive not present \u2013 cannot continue planning\n              return plan\n\n          # compute path to a cell adjacent to any of those primitive cells\n          path = bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # simulate movement\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # use action to pick up the primitive\n          plan.append(USE_ACT)\n\n          # find which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # safety fallback \u2013 should not happen\n              break\n\n          # update simulated grid (remove one instance of the primitive)\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be string name or already an int)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action at the workshop to craft the item\n          plan.append(USE_ACT)\n\n  # Return the complete action sequence\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:14:39.569494", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # direction \u2192 action (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  DIR_TO_ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  def bfs_adjacent(start, targets, blocked):\n      \"\"\"Return a list of actions that moves the agent from ``start`` to a\n      cell adjacent (Manhattan distance 1) to any coordinate in ``targets``,\n      avoiding cells where ``blocked`` is True.\"\"\"\n      W, H = blocked.shape\n      sx, sy = start\n\n      # already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Initialise current state\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for simulation\n  pos = tuple(state.pos)            # (x, y)\n\n  # goal index stored in the task (env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # primitives (or intermediate items) required for the goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  def blocked_mask(g):\n      \"\"\"Boolean mask where True indicates an impassable cell.\"\"\"\n      return np.any(g > 0, axis=2)\n\n  # --------------------------------------------------------------\n  # 1. Collect required primitives.\n  # --------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # no more of this primitive on the map \u2013 abort planning\n              return plan\n\n          blk = blocked_mask(grid)\n          path = bfs_adjacent(pos, cells.tolist(), blk)\n          plan.extend(path)\n\n          # simulate movement\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # pick up the primitive\n          plan.append(4)   # USE\n\n          # locate the primitive cell we just used (adjacent to current pos)\n          used_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  used_cell = (cx, cy)\n                  break\n          if used_cell is None:\n              break  # safety\n\n          # update simulated grid and remaining count\n          grid[used_cell[0], used_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the workshop and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          blk = blocked_mask(grid)\n          path = bfs_adjacent(pos, ws_cells.tolist(), blk)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(4)   # USE to craft at the workshop\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:14:40.695494", "function_name": "make_arrow", "function_body": "  # map direction vectors to action indices (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, targets, blocked):\n      \"\"\"Return a list of actions moving from ``start`` to a cell adjacent to any\n      coordinate in ``targets`` while avoiding cells where ``blocked`` is True.\"\"\"\n      W, H = blocked.shape\n      sx, sy = start\n\n      # already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Initialise current state\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                 # mutable copy for planning\n  pos = tuple(state.pos)                   # (x, y)\n\n  # Goal index is stored in env.task.goal (or env.task.goal_idx)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      goal_idx = getattr(env.task, \"goal_idx\", None)\n  if goal_idx is None:\n      return []  # cannot determine goal\n\n  # ------------------------------------------------------------------\n  # Determine primitive (or intermediate) requirements for the goal\n  # ------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # Pre\u2011compute blocked cells mask (non\u2011grabbable entities block movement)\n  def compute_blocked(g):\n      blocked = np.zeros(g.shape[:2], dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= g[:, :, idx] > 0\n      return blocked\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives / intermediate items\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # required item not present on map \u2013 abort planning\n              return plan\n\n          blocked_mask = compute_blocked(grid)\n          path = bfs_adjacent(pos, cells.tolist(), blocked_mask)\n          plan.extend(path)\n\n          # simulate movement\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # use action to pick up\n          plan.append(4)   # USE\n\n          # find which cell we just used (adjacent)\n          used_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  used_cell = (cx, cy)\n                  break\n          if used_cell is None:\n              break  # safety\n\n          # update simulated grid\n          grid[used_cell[0], used_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # resolve workshop index\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          blocked_mask = compute_blocked(grid)\n          path = bfs_adjacent(pos, workshop_cells.tolist(), blocked_mask)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(4)   # USE to craft at workshop\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:15:02.465720", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy of the grid (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (consistent with CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves the\n      agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev_actions = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev_actions.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev_actions.append(UP)\n                  elif cur[1] == px + 1:\n                      rev_actions.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev_actions.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev_actions))\n          for dy, dx, _ in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to ``cell``.\n      ``avoid`` is a set of coordinates that should not be used.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  collected = set()   # track primitive cells already taken\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; cannot safely collect \u2013 abort\n              return actions\n\n          # Move to that adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a movement action that will be blocked)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand on a free neighbour of the workshop\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              # If no free neighbour, try to stand directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional \u2013 a blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:15:03.581065", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of grid\n\n  # Action indices (consistent with CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  else:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      return []  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell to ``cell`` (excluding ``avoid``).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify arrow recipe and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  collected = set()                       # cells of primitives already taken\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions  # cannot find needed primitive\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              return actions  # no safe place to collect\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked move in that direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid copy\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = ws_cell  # fallback to standing on workshop cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:15:21.703476", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions = []\n\n  # Determine starting position (use live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid to keep track of taken items\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index (the task the environment expects)\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(target):\n      \"\"\"Append actions that move the agent from cur_pos to target.\"\"\"\n      nonlocal cur_pos\n      while cur_pos[0] != target[0] or cur_pos[1] != target[1]:\n          if cur_pos[0] < target[0]:\n              actions.append(RIGHT)\n              cur_pos[0] += 1\n          elif cur_pos[0] > target[0]:\n              actions.append(LEFT)\n              cur_pos[0] -= 1\n          elif cur_pos[1] < target[1]:\n              actions.append(DOWN)\n              cur_pos[1] += 1\n          elif cur_pos[1] > target[1]:\n              actions.append(UP)\n              cur_pos[1] -= 1\n\n  def _nearest_kind(kind_idx):\n      \"\"\"Return coordinates [x, y] of the nearest cell containing kind_idx.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = _nearest_kind(prim_kind)\n          if target is None:\n              # Primitive not present \u2013 abort planning (return whatever we have)\n              return actions\n          _move_to(target)\n          actions.append(USE)                     # pick up the primitive\n          grid[target[1], target[0], prim_kind] = 0  # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind)\n      if workshop_pos is not None:\n          _move_to(workshop_pos)\n          actions.append(USE)                     # craft at the workshop\n\n  # Return the full planned action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:15:22.816792", "function_name": "make_arrow", "function_body": "  # Action indices (standard for CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Current position (use the live state if it exists, otherwise the start)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)          # [x, y]\n  else:\n      cur_pos = list(env.scenario.init_pos)           # [x, y]\n\n  # Work on a mutable copy of the initial grid so we can \u201cremove\u201d items once taken\n  grid = env.scenario.init_grid.copy()\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append actions that move the agent from `pos` to `target`.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur, g):\n      \"\"\"Return coordinates [x, y] of the nearest cell containing `kind_idx`.\"\"\"\n      ys, xs = np.where(g[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitive resources for the goal item\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal                                 # integer index of the target item\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  for prim_kind, count in primitive_requirements.items():\n      for _ in range(count):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not present \u2013 cannot plan further; return what we have\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                               # pick up the primitive\n          grid[target[1], target[0], prim_kind] = 0         # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. If the recipe requires a specific workshop, go there and craft\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                               # craft at the workshop\n\n  # ------------------------------------------------------------------\n  # Return the planned action list\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:15:41.980124", "function_name": "make_arrow", "function_body": "  # Reset environment and initialise variables\n  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()          # name \u2192 id\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Movement deltas for cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # Helper BFS: returns a list of action names that moves the agent from `start`\n  # to a cell that is Chebyshev\u2011adjacent (\u22641 in both axes) to any target cell.\n  # Traversal is allowed only through completely empty cells.\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # adjacency test\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # cell must be empty (no entity)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # locate all cells currently holding this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # primitive no longer present \u2013 stop trying\n              break\n\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # unreachable \u2013 give up on this primitive\n              break\n\n          # execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # craft using the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the full sequence of action IDs\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:15:43.097224", "function_name": "make_arrow", "function_body": "  # Reset environment and initialise containers\n  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()                     # name \u2192 id\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Cardinal movement deltas\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of action names that moves the agent from `start`\n      to any cell that is Chebyshev\u2011adjacent (\u22641 in both axes) to a target.\n      Only empty cells (no entity) may be traversed.\"\"\"\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # adjacency test\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # cell must be empty (no entity)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # locate all cells currently holding this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # primitive no longer present \u2013 stop trying\n              break\n\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # unreachable \u2013 give up on this primitive\n              break\n\n          # execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # craft using the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the full sequence of action IDs\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:16:12.736184", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that brings the agent from\n  #   start (x, y) to a cell adjacent to any target location.\n  #   The search avoids cells that are occupied in the provided grid.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, cur_grid):\n      width, height, _ = cur_grid.shape\n      occupied = np.any(cur_grid > 0, axis=2)          # any non\u2011zero kind blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Are we adjacent (or on) a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook from the environment\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = state_wrapper.world\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\"\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if needed)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  # Work on a mutable copy of the grid so we can mark collected cells as empty\n  cur_grid = state.grid.copy()    # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells that currently contain this primitive\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive (or onto it if possible)\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update position following the path\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive\n          actions.append(USE)\n          # Mark the cell as empty for future path\u2011finding\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # Locate workshop cells in the current grid\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:16:13.845994", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (standard for CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # Mapping from action to coordinate delta\n  _DELTA = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions taking the agent from\n  # `start` to a cell adjacent to any of `targets`.  Cells that contain\n  # any non\u2011zero kind are treated as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, cur_grid):\n      w, h, _ = cur_grid.shape\n      occupied = np.any(cur_grid > 0, axis=2)  # True where any entity blocks movement\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Expand neighbours\n          for act, (dx, dy) in _DELTA.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook objects\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = state_wrapper.world\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance from the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify goal (hard\u2011coded to \"arrow\") and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if needed)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells currently containing this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position for efficiency\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Plan a path to a cell adjacent to the primitive\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Simulate moving along the path to update `pos`\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use action to pick up the primitive\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n          # Update the planning grid: the primitive is now removed\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be string name or integer id)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      # Locate workshop cells\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not workshop_cells:\n          # No workshop visible \u2013 fall back to using current location\n          actions.append(USE)\n      else:\n          # Choose the nearest workshop cell\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use action to craft the arrow\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 simply use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:16:34.190054", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, targets, blocked):\n      \"\"\"Bread\u2011first search returning a list of action indices from start to the nearest target.\"\"\"\n      w, h = start_grid.shape[:2]\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 return empty path (should not happen in well\u2011formed scenarios)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Gather recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  # Primitive requirements for one arrow (handles intermediate recursion)\n  needed_prims = cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n  # Workshop location where the arrow must be crafted\n  recipe = cookbook.recipes[goal_idx]\n  workshop_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n  workshop_idx = (\n      workshop_key\n      if isinstance(workshop_key, int)\n      else cookbook.index[workshop_key]\n  )\n\n  # ----------------------------------------------------------------------\n  # Prepare static grid and blocked\u2011cell mask\n  # ----------------------------------------------------------------------\n  start_grid = env._current_state.grid\n  w, h, _ = start_grid.shape\n  blocked_mask = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked_mask |= start_grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(env._current_state.pos)\n\n  # Helper: move to the nearest cell containing a given kind and USE it\n  def collect_kind(kind_idx, qty):\n      nonlocal cur_pos, actions\n      for _ in range(qty):\n          # Locate all cells that currently contain the required kind\n          cells = {\n              (x, y)\n              for x in range(w)\n              for y in range(h)\n              if start_grid[x, y, kind_idx] > 0\n          }\n          # Find path to the closest such cell\n          path = bfs(cur_pos, cells, blocked_mask)\n          actions.extend(path)\n          # Update current position following the path\n          for a in path:\n              dx, dy = DIRS[a]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n          # Pick up the item\n          actions.append(4)  # USE\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      collect_kind(prim_idx, count)\n\n  # ----------------------------------------------------------------------\n  # Go to the workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_cells = {\n      (x, y)\n      for x in range(w)\n      for y in range(h)\n      if start_grid[x, y, workshop_idx] > 0\n  }\n  path_to_ws = bfs(cur_pos, workshop_cells, blocked_mask)\n  actions.extend(path_to_ws)\n  # (optional) update cur_pos \u2013 not needed after final step\n  actions.append(4)  # USE to craft the arrow\n\n  return actions", "env_interactions": 19, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:16:35.307671", "function_name": "make_arrow", "function_body": "  # Helper: BFS to nearest target cell avoiding blocked cells.\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # 0:DOWN, 1:UP, 2:LEFT, 3:RIGHT\n  def bfs(start, targets, blocked):\n      from collections import deque\n      w, h = start_grid.shape[:2]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable (should not happen)\n\n  # ------------------------------------------------------------------\n  # Gather world / recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n  recipe = cookbook.recipes[arrow_idx]\n\n  # workshop where the arrow must be crafted\n  workshop_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n  if isinstance(workshop_key, int):\n      workshop_idx = workshop_key\n  else:\n      workshop_idx = cookbook.index[workshop_key]\n\n  # primitive requirements for one arrow\n  needed_prims = cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Grid, position, and blocked\u2011cell mask\n  # ------------------------------------------------------------------\n  start_grid = env._current_state.grid.copy()\n  w, h, _ = start_grid.shape\n  cur_pos = tuple(env._current_state.pos)\n\n  blocked_mask = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked_mask |= start_grid[:, :, idx] > 0\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Function to move to a cell containing a given kind and pick it up\n  # ------------------------------------------------------------------\n  def move_and_pick(kind_idx, qty):\n      nonlocal cur_pos, actions, start_grid\n      for _ in range(qty):\n          # locate all cells currently holding the required kind\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if start_grid[x, y, kind_idx] > 0}\n          if not cells:\n              raise RuntimeError(f\"No remaining cells for kind {kind_idx}\")\n          path = bfs(cur_pos, cells, blocked_mask)\n          actions.extend(path)\n          # update position following the path\n          for a in path:\n              dx, dy = DIRS[a]\n              cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n          # pick up the item\n          actions.append(4)  # USE\n          # remove the item from the grid so it won't be reused\n          start_grid[cur_pos[0], cur_pos[1], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      move_and_pick(prim_idx, count)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = {(x, y) for x in range(w) for y in range(h)\n                    if start_grid[x, y, workshop_idx] > 0}\n  if not workshop_cells:\n      raise RuntimeError(\"No workshop cell found for arrow crafting\")\n  path = bfs(cur_pos, workshop_cells, blocked_mask)\n  actions.extend(path)\n  for a in path:\n      dx, dy = DIRS[a]\n      cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n  actions.append(4)  # USE to craft\n\n  return actions", "env_interactions": 19, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:16:56.981171", "function_name": "make_arrow", "function_body": "  # Directions correspond to action indices: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of movement actions\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No path found \u2013 should not happen in a solvable scenario\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing a given kind and use it\n  # ------------------------------------------------------------------\n  def acquire(kind_idx, count):\n      nonlocal pos, actions\n      for _ in range(count):\n          # Find all cells that currently hold the required kind\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Gather world / recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Resolve full crafting plan (primitives needed + ordered craft steps)\n  # ------------------------------------------------------------------\n  needed_prims = {}          # primitive idx \u2192 total count required\n  craft_steps = []           # list of (item_idx, count) in dependency order\n\n  def resolve(item_idx, multiplier):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # Resolve ingredient items first (ignore special keys like \"_at\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # After its ingredients, schedule this item to be crafted\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the final action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect every primitive required by the recipe\n  for kind_idx, cnt in needed_prims.items():\n      acquire(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # Locate any workshop cell of the required type\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # Use the workshop the required number of times\n      actions.extend([4] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:16:58.095094", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE\n\n  world = env.world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}\n  craft_steps = []\n\n  def resolve(item_idx, mul):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mul)\n      craft_steps.append((item_idx, mul))\n\n  resolve(goal_idx, 1)\n\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  for kind, cnt in needed_prims.items():\n      acquire(kind, cnt)\n\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      actions.extend([4] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:17:24.525031", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Setup and helpers\n  # ------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)          # current (x, y) position\n  w, h, _ = grid.shape\n\n  # Directions: 0=RIGHT,1=LEFT,2=UP,3=DOWN (matching env action ordering)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # Cells that cannot be traversed (non\u2011grabbable entities)\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # Bread\u2011first search returning a list of movement actions from start to any target cell\n  def bfs(start, targets, blocked_mask):\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked_mask[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []   # should not happen in a solvable scenario\n\n  # Move to a cell containing `kind_idx` and execute USE action `count` times\n  def acquire(kind_idx, count):\n      nonlocal pos, actions, grid, blocked\n      for _ in range(count):\n          # locate any cell that currently holds the required kind\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          if not cells:\n              # no more of this primitive on the map \u2013 abort early\n              return\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          # update position according to the path taken\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # pick up the item\n          actions.append(4)   # USE\n          # after pickup the cell becomes empty; update grid and blocked mask\n          x, y = pos\n          grid[x, y, kind_idx] = max(0, grid[x, y, kind_idx] - 1)\n          # picking up a primitive never creates a new obstacle,\n          # but if the cell previously held a non\u2011grabbable entity we keep it blocked\n\n  # ------------------------------------------------------------------\n  # Resolve recipe for \"arrow\": primitives needed and ordered craft steps\n  # ------------------------------------------------------------------\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n  needed_prims = {}          # primitive idx -> total count required\n  craft_steps = []           # (item_idx, count) in dependency order (post\u2011order)\n\n  def resolve(item_idx, multiplier):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:\n          # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # first resolve all ingredient items (skip special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # then schedule this item to be crafted\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1) Collect all required primitives\n  for kind_idx, cnt in needed_prims.items():\n      acquire(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # locate any workshop cell of the required type\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      if not wk_cells:\n          continue  # safety fallback; in a valid scenario this should not happen\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # use the workshop the required number of times\n      actions.extend([4] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.0}}
