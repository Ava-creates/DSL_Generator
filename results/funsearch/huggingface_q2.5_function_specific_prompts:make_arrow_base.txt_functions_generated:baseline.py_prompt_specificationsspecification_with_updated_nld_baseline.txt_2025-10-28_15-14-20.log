{"timestamp": "2025-10-29T00:33:21.471219", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action constants \u2013 match the default CraftWorld ordering.\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start`\n  # to any cell that is *adjacent* (Manhattan distance 1) to one of the\n  # `targets`.  Cells occupied by any entity are considered blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return actions to reach a cell adjacent to any target.\"\"\"\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent to a target?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              # Check adjacency to any target.\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying world and current state from the env.\n  # The env may be a CraftLab wrapper or a raw CraftScenario.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Likely a CraftLab instance \u2013 grab the hidden state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # env already is a CraftWorld or a scenario.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are required for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  grid = state.grid                       # shape (W, H, n_kinds)\n  pos = tuple(state.pos)                  # (x, y)\n  occupied = np.any(grid > 0, axis=2)     # True where any entity exists\n\n  actions = []\n  harvested = set()                       # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells that still contain this primitive and have not been harvested.\n          candidates = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not candidates:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest candidate (Manhattan distance).\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          # Plan a path to a cell adjacent to the target.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve the workshop index (may be a string name).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft at workshop\n      else:\n          # No workshop present \u2013 try to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:33:42.663896", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import collections, numpy as np\n\n  # Action constants (default ordering in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, grid):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any\n      target location.  Blocks are any cell with a non\u2011zero entry in any kind.\"\"\"\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where something blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell.\n      return []\n\n  def _move(pos, act):\n      \"\"\"Return new position after applying a movement action.\"\"\"\n      x, y = pos\n      if act == RIGHT:\n          return (x + 1, y)\n      if act == LEFT:\n          return (x - 1, y)\n      if act == DOWN:\n          return (x, y + 1)\n      if act == UP:\n          return (x, y - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Locate world / cookbook objects inside the environment wrapper.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the state instead.\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = getattr(state_tmp, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot find CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if needed) and fetch goal info.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Planning state (mutable copies for offline planning)\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                 # current agent position\n  grid = state.grid.copy()               # occupancy grid (will be mutated as we collect)\n  actions = []                           # final action list to return\n  harvested = set()                      # cells from which we already picked up\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # All cells currently containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position (greedy nearest first).\n      locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n      collected = 0\n\n      for loc in locations:\n          if collected >= needed_cnt:\n              break\n          if loc in harvested:\n              continue\n\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          for act in path:\n              pos = _move(pos, act)\n\n          # Pick it up.\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n\n          # Update planning grid \u2013 the primitive is now gone.\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be string name or integer).\n      if isinstance(workshop_key, str):\n          ws_idx = cookbook.index[workshop_key]\n      else:\n          ws_idx = int(workshop_key)\n\n      # Find all workshop cells on the map.\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          # Choose the nearest workshop cell.\n          ws_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          target_ws = ws_cells[0]\n\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              pos = _move(pos, act)\n\n  # Use action to perform the crafting (or final USE if no workshop needed).\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:33:43.809329", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (standard ordering in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  #   start (x, y) to any cell adjacent (Manhattan distance \u2264 1) to one\n  #   of the target cells. Cells that contain any entity are treated as\n  #   obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are already adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path.\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: update a (x, y) position according to an action.\n  # ------------------------------------------------------------------\n  def _move(pos, act):\n      if act == RIGHT:\n          return (pos[0] + 1, pos[1])\n      if act == LEFT:\n          return (pos[0] - 1, pos[1])\n      if act == DOWN:\n          return (pos[0], pos[1] + 1)\n      if act == UP:\n          return (pos[0], pos[1] - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Locate the CraftWorld and Cookbook objects inside the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      tmp_state = getattr(env, \"_current_state\", None)\n      if tmp_state is not None:\n          world = getattr(tmp_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a reset state.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Goal is the item named \"arrow\".\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow (primitive index \u2192 count).\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Planning state (mutable copies of position and grid).\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)               # current (x, y)\n  grid = state.grid.copy()             # mutable copy for planning\n  actions = []                         # final action sequence\n  harvested = set()                    # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          for act in path:\n              pos = _move(pos, act)\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n          # Mark the cell empty for future planning.\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str)\n                else int(workshop_key))\n      # Find all workshop cells.\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          # Choose the nearest workshop.\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              pos = _move(pos, act)\n      # Use (craft) at the workshop or current location.\n      actions.append(USE)\n  else:\n      # No specific workshop required \u2013 just use.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:34:12.935800", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects (handle wrappers)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Get index of target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to hash state\n  def _hash_state(st):\n      # Use bytes representation of inventory and grid for hashing\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  MAX_PLAN_LEN = 300  # safety limit\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune long plans\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found\n  return []", "env_interactions": 20, "island_id": 8, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:34:15.437988", "function_name": "make_arrow", "function_body": "  import collections\n  from collections import deque, namedtuple\n\n  # Unwrap possible environment wrappers to obtain the scenario and world objects.\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\" in the cookbook.\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state of the episode.\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Simple BFS node container.\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  MAX_PLAN_LEN = 300          # safety cutoff for plan length\n  MAX_VISITED = 20000         # safety cutoff for search breadth\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier and len(visited) < MAX_VISITED:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long partial plans.\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the limits.\n  return []", "env_interactions": 0, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-29T00:34:44.072741", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # Action indices used by CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any position\n  # in `targets`. All cells that contain any non\u2011zero kind are treated\n  # as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, occ_grid):\n      w, h = occ_grid.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ_grid[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # no reachable target\n\n  # ------------------------------------------------------------------\n  # Locate the world and cookbook objects inside the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrap = getattr(env, \"_current_state\", None)\n      if state_wrap is not None:\n          world = getattr(state_wrap, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not find CraftWorld instance in env.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if needed).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal is the hard\u2011coded item \u201carrow\u201d.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitives (and required counts) needed to craft the goal.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Planning state (mutable copy of the grid, simulated position, etc.).\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # mutable copy for planning\n  occupied = np.any(grid > 0, axis=2)  # boolean mask of blocked cells\n  actions = []                         # final action list to return\n  harvested = set()                    # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive, one by one, using a greedy nearest\u2011first strategy.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      while collected < needed:\n          # Find all cells that currently contain this primitive and are not yet harvested.\n          candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                        if tuple(p) not in harvested]\n          if not candidates:\n              break  # no more of this primitive reachable; exit loop\n\n          # Choose the closest candidate.\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          # Move adjacent to the target primitive.\n          path = _bfs_path(pos, [target], occupied)\n          actions.extend(path)\n\n          # Update simulated position after following the path.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell empty for subsequent planning.\n          grid[target[0], target[1], prim_idx] = 0\n          occupied[target[0], target[1]] = False\n          harvested.add(target)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      # Find workshop cells still present in the grid.\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [ws_target], occupied)\n          actions.extend(path)\n\n          # Update simulated position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n      else:\n          # No visible workshop \u2013 attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required; just use.\n      actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Return the compiled list of actions.\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:34:45.217168", "function_name": "make_arrow", "function_body": "  # action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  #   `start` to a cell adjacent (Manhattan distance \u2264 1) to any\n  #   coordinate in `targets`.  Any cell containing a non\u2011zero kind is\n  #   treated as an obstacle.\n  # --------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are already adjacent (or on) a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list.\n      return []\n\n  # --------------------------------------------------------------\n  # Locate the world and cookbook inside the environment.\n  # --------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in env.\")\n\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify the goal (hard\u2011coded to \"arrow\") and its primitive needs.\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # --------------------------------------------------------------\n  # Ensure we have a current state (reset if the env is fresh).\n  # --------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []                    # final action list to return\n  harvested = set()               # cells already used for collection\n\n  # --------------------------------------------------------------\n  # Collect each required primitive.\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      while collected < needed:\n          # Find all remaining cells that contain this primitive.\n          candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                        if tuple(p) not in harvested]\n          if not candidates:\n              break  # no more instances on the map\n          # Choose the nearest one (greedy).\n          candidates.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = candidates[0]\n\n          # Move adjacent to the target.\n          path = _bfs_path(pos, [target], grid)\n          actions.extend(path)\n\n          # Update simulated position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Mark the cell empty for future planning.\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n          collected += 1\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # --------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or an integer).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [ws_target], grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n      else:\n          # No workshop visible \u2013 attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required; just use the current cell.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:34:55.457985", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # target item index\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # required primitive counts for one arrow\n  required_prims = world.cookbook.primitives_for(target_idx)\n\n  # initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import namedtuple\n  import heapq\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\", \"cost\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation for visited set.\"\"\"\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  def _heuristic(st):\n      \"\"\"Estimate remaining steps: sum of missing primitive counts.\"\"\"\n      missing = 0\n      inv = st.inventory\n      for prim_idx, cnt in required_prims.items():\n          have = inv[prim_idx] if prim_idx < len(inv) else 0\n          if have < cnt:\n              missing += cnt - have\n      # add one for the final crafting action\n      return missing + 1\n\n  visited = set()\n  start_node = Node(init_state, [], 0)\n  heap = [( _heuristic(init_state), start_node )]\n  visited.add(_state_hash(init_state))\n\n  MAX_EXPANSIONS = 20000\n  expansions = 0\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while heap:\n      _, node = heapq.heappop(heap)\n      cur_state = node.state\n\n      # goal test\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if expansions >= MAX_EXPANSIONS:\n          break\n      expansions += 1\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h in visited:\n              continue\n          visited.add(h)\n          g = node.cost + 1\n          f = g + _heuristic(nxt_state)\n          heapq.heappush(heap, (f, Node(nxt_state, node.actions + [a], g)))\n\n  # fallback: no plan found within limits\n  return []", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-29T00:35:11.135103", "function_name": "make_arrow", "function_body": "  # Get scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for this episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Hashable representation of a CraftState for visited\u2011set\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_PLAN_LEN = 1000          # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No solution found within the search budget\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:35:39.306423", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Hashable representation of a CraftState (position, direction,\n      # inventory contents and full grid layout)\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                       # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:35:54.987789", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have an arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, cur_actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:36:19.286699", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Simple breadth\u2011first search over state space\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash includes position, direction, inventory and full grid layout\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 1000                     # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:36:34.999464", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 600                     # safety limit\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:36:59.777415", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000                         # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (index 4) before movement actions\n  if n_actions > 4:\n      action_order = [4, 0, 1, 2, 3]\n  else:\n      action_order = list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)   # reward is always 0.0 here\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:37:15.539051", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 5000  # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (usually index 4) before movement actions.\n  if n_actions > 4:\n      action_order = [4] + [i for i in range(n_actions) if i != 4]\n  else:\n      action_order = list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:37:46.999183", "function_name": "make_arrow", "function_body": "  # Obtain the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000  # safety limit for the plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (index 4) before movement actions if it exists\n  if n_actions > 4:\n      action_order = [4, 0, 1, 2, 3]\n  else:\n      action_order = list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
