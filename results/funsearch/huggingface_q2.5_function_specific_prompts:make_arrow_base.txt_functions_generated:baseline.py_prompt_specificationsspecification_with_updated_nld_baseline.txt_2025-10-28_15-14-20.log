{"timestamp": "2025-10-28T16:39:20.420841", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks\n      from ``start`` to ``goal`` using Manhattan distance. No obstacle\n      checking is performed.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Find the nearest cell that contains ``kind`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locations[nearest_idx])\n\n  # Goal index for the arrow and the primitives required to craft it.\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fallback: stand directly on the primitive cell.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (a blocked move updates direction).\n          dy = ty - cur_pos[0]\n          dx = tx - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:39:21.565044", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  H, W, _ = grid.shape\n  non_grabbable = set(world.non_grabbable_indices)\n\n  def is_blocked(y, x):\n      if y < 0 or y >= H or x < 0 or x >= W:\n          return True\n      return any(grid[y, x, k] > 0 for k in non_grabbable)\n\n  from collections import deque\n\n  def bfs(start, goal):\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not is_blocked(ny, nx):\n                  if (ny, nx) not in visited:\n                      if (ny, nx) == goal:\n                          return path + [act]\n                      visited.add((ny, nx))\n                      q.append(((ny, nx), path + [act]))\n      return None\n\n  def positions_of(kind):\n      return [tuple(p) for p in np.argwhere(grid[:, :, kind] > 0)]\n\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)\n\n  actions = []\n  cur_pos = state.pos\n\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          best_seq = None\n          best_target = None\n          best_adj = None\n          for tgt in positions_of(prim_idx):\n              for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                  ay, ax = tgt[0] + dy, tgt[1] + dx\n                  if 0 <= ay < H and 0 <= ax < W and not is_blocked(ay, ax):\n                      seq = bfs(cur_pos, (ay, ax))\n                      if seq is not None and (best_seq is None or len(seq) < len(best_seq)):\n                          best_seq = seq\n                          best_target = tgt\n                          best_adj = (ay, ax)\n          if best_seq is None:\n              return actions\n          actions.extend(best_seq)\n          cur_pos = best_adj\n          dy = best_target[0] - cur_pos[0]\n          dx = best_target[1] - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n          actions.append(USE)\n          grid[best_target[0], best_target[1], prim_idx] = 0\n\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cells = positions_of(ws_idx)\n      if ws_cells:\n          ws_target = min(ws_cells, key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          ws_path = bfs(cur_pos, ws_target)\n          if ws_path is not None:\n              actions.extend(ws_path)\n              cur_pos = ws_target\n\n  actions.append(USE)\n  return actions", "env_interactions": 21, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:39:46.431253", "function_name": "make_arrow", "function_body": "  # Reset environment and grab core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices (consistent with CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, _ in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour (y, x) of ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def direction_action(src, dst):\n      \"\"\"Return the action that would move from src towards dst (one step).\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None  # already same cell\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  collected = set()                       # cells of primitives already taken\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; abort\n              return actions\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked move in that direction)\n          dir_act = direction_action(cur_pos, target)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation and record collection\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              # If no free neighbour, stand directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional)\n          dir_act = direction_action(cur_pos, ws_cell)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:39:47.559911", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state and world objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  # Work on a mutable copy of the grid to track collected items\n  grid = state.grid.copy()             # shape (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev_actions = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev_actions.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev_actions.append(UP)\n                  elif cur[1] == px + 1:\n                      rev_actions.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev_actions.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev_actions))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighboring cell (y, x) to ``cell``.\n      ``avoid`` is a set of coordinates that should not be used.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  collected = set()   # keep track of primitive cells already taken\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; cannot safely collect \u2013 abort\n              return actions\n\n          # Move to that adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a movement action that will be blocked)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand on a free neighbour of the workshop\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              # If no free neighbour, try to stand directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional \u2013 a blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:40:10.137845", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  actions = []\n  spec = env.action_specs()\n  DOWN = spec['DOWN']\n  UP = spec['UP']\n  LEFT = spec['LEFT']\n  RIGHT = spec['RIGHT']\n  USE = spec['USE']\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}\n  state = env._current_state\n  pos = tuple(state.pos)  # (x, y)\n\n  def _move_actions(cur, tgt):\n      \"\"\"Return a list of movement actions to go from cur to tgt (Manhattan).\"\"\"\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      dx = tx - x\n      dy = ty - y\n      while dx != 0:\n          if dx > 0:\n              moves.append(DOWN)\n              x += 1\n              dx -= 1\n          else:\n              moves.append(UP)\n              x -= 1\n              dx += 1\n      while dy != 0:\n          if dy > 0:\n              moves.append(RIGHT)\n              y += 1\n              dy -= 1\n          else:\n              moves.append(LEFT)\n              y -= 1\n              dy += 1\n      return moves\n\n  # Cache locations of each primitive kind on the map\n  kind_locs = {}\n  for kind in needed:\n      coords = list(zip(*np.where(state.grid[:, :, kind] > 0)))\n      kind_locs[kind] = coords\n\n  # Collect required primitives\n  for kind, count_needed in needed.items():\n      while count_needed > 0:\n          if not kind_locs[kind]:\n              # No more instances of this primitive; abort collection for safety\n              break\n          # Choose the nearest location (Manhattan distance)\n          cur = pos\n          target = min(kind_locs[kind],\n                       key=lambda c: abs(c[0] - cur[0]) + abs(c[1] - cur[1]))\n          # Move to the target cell\n          actions.extend(_move_actions(pos, target))\n          pos = target\n          # Pick up one unit\n          actions.append(USE)\n          # Update bookkeeping: if the cell had only one unit, remove it from list\n          cell_amount = int(state.grid[target[0], target[1], kind])\n          if cell_amount <= 1:\n              kind_locs[kind].remove(target)\n          # Otherwise keep the location for potential further pickups\n          count_needed -= 1\n\n  # Go to the appropriate workshop and craft the goal item\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_coords = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if workshop_coords:\n          target_ws = workshop_coords[0]\n          actions.extend(_move_actions(pos, target_ws))\n          pos = target_ws\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:40:11.244218", "function_name": "make_arrow", "function_body": "  actions = []\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec['DOWN'],\n      spec['UP'],\n      spec['LEFT'],\n      spec['RIGHT'],\n      spec['USE'],\n  )\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}\n  state = env._current_state\n  pos = tuple(state.pos)  # current (x, y)\n\n  def _move(cur, tgt):\n      \"\"\"Return a list of movement actions to go from cur to tgt (Manhattan walk).\"\"\"\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  # ---- Collect required primitives ----\n  for prim_idx, cnt in needed.items():\n      # locate all cells that currently contain this primitive\n      locations = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n      for _ in range(cnt):\n          if not locations:\n              break  # safety: no more of this primitive on the map\n          target = locations.pop(0)\n\n          # move to the cell\n          actions.extend(_move(pos, target))\n          pos = target\n\n          # pick it up\n          actions.append(USE)\n\n  # ---- Go to the appropriate workshop and craft ----\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target = ws_locs[0]\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:40:43.946575", "function_name": "make_arrow", "function_body": "  \"\"\"Generate a sequence of actions that makes an arrow in the given CraftLab env.\n\n  The function:\n    1. Queries the goal index from the environment task.\n    2. Determines the primitive resources required for that goal.\n    3. For each required primitive, finds the nearest occurrence on the map,\n       plans a shortest Manhattan\u2011free path to it, moves there and picks it up.\n    4. Finally moves to the appropriate workshop (if any) and crafts the item.\n\n  The returned list contains action indices compatible with the env's\n  `action_specs` (DOWN, UP, LEFT, RIGHT, USE).\n  \"\"\"\n  actions: list[int] = []\n\n  # Action spec mapping\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  # Goal index and required primitives\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Current observable state (grid, position)\n  state = env._current_state\n  grid = state.grid\n  cur_pos = tuple(state.pos)  # (x, y)\n\n  # Helper: Manhattan movement actions from one cell to the next\n  def _delta_to_action(dx: int, dy: int) -> int:\n      if dx == 1:\n          return DOWN\n      if dx == -1:\n          return UP\n      if dy == 1:\n          return RIGHT\n      if dy == -1:\n          return LEFT\n      raise ValueError(\"Invalid delta for movement\")\n\n  # Helper: BFS to find shortest path to any of the target cells.\n  # `allow_target` lets us step onto a cell that is otherwise occupied.\n  def _bfs_path(start, targets, allow_target=False):\n      from collections import deque\n\n      H, W = grid.shape[0], grid.shape[1]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = np.empty((H, W), dtype=object)\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n      while q:\n          x, y = q.popleft()\n          if (x, y) in targets:\n              # reconstruct path\n              path = []\n              while (x, y) != start:\n                  path.append((x, y))\n                  x, y = prev[x, y]\n              path.reverse()\n              return path\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < H and 0 <= ny < W and not visited[nx, ny]:\n                  occupied = grid[nx, ny].any()\n                  if occupied and not (allow_target and (nx, ny) in targets):\n                      continue\n                  visited[nx, ny] = True\n                  prev[nx, ny] = (x, y)\n                  q.append((nx, ny))\n      return None  # no path found\n\n  # ---- Collect each needed primitive ----\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate all cells that still contain this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # nothing left on the map; break early\n              break\n\n          # choose the nearest reachable location\n          path = _bfs_path(cur_pos, set(locations), allow_target=True)\n          if path is None:\n              # fallback to Manhattan moves (may fail if blocked)\n              target = locations[0]\n              path = []\n              tx, ty = target\n              cx, cy = cur_pos\n              while cx < tx:\n                  path.append((cx + 1, cy))\n                  cx += 1\n              while cx > tx:\n                  path.append((cx - 1, cy))\n                  cx -= 1\n              while cy < ty:\n                  path.append((cx, cy + 1))\n                  cy += 1\n              while cy > ty:\n                  path.append((cx, cy - 1))\n                  cy -= 1\n          # translate path positions into movement actions\n          for nxt in path:\n              dx = nxt[0] - cur_pos[0]\n              dy = nxt[1] - cur_pos[1]\n              actions.append(_delta_to_action(dx, dy))\n              cur_pos = nxt\n          # pick up the primitive\n          actions.append(USE)\n          # update internal grid representation (optional, for subsequent searches)\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # ---- Move to workshop and craft ----\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          # pick the first workshop location\n          target = ws_locs[0]\n          path = _bfs_path(cur_pos, {target}, allow_target=True)\n          if path is None:\n              # simple Manhattan fallback\n              path = []\n              tx, ty = target\n              cx, cy = cur_pos\n              while cx < tx:\n                  path.append((cx + 1, cy))\n                  cx += 1\n              while cx > tx:\n                  path.append((cx - 1, cy))\n                  cx -= 1\n              while cy < ty:\n                  path.append((cx, cy + 1))\n                  cy += 1\n              while cy > ty:\n                  path.append((cx, cy - 1))\n                  cy -= 1\n          for nxt in path:\n              dx = nxt[0] - cur_pos[0]\n              dy = nxt[1] - cur_pos[1]\n              actions.append(_delta_to_action(dx, dy))\n              cur_pos = nxt\n          # craft at the workshop\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:40:45.058702", "function_name": "make_arrow", "function_body": "  # Get action indices\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n  # Goal item index\n  goal = env.task.goal\n  # Primitive requirements for the goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n  # Current state and position\n  state = env._current_state\n  pos = tuple(state.pos)  # (x, y)\n\n  # Helper: Manhattan move sequence (fallback)\n  def _manhattan(cur, tgt):\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  # Helper: BFS path finder returning list of actions\n  def _bfs_path(start, goal_pos, allow_goal=True):\n      width, height = state.grid.shape[:2]\n      # blocked cells = any non\u2011grabbable entity present\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(state.grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Goal cell may be blocked (e.g., workshop); allow stepping onto it if requested\n      if allow_goal:\n          blocked[goal_pos[0], goal_pos[1]] = False\n\n      q = collections.deque()\n      q.append(start)\n      came_from = {start: None}\n      action_from = {}\n      while q:\n          cur = q.popleft()\n          if cur == goal_pos:\n              break\n          x, y = cur\n          for a, (dx, dy) in (\n              (DOWN, (1, 0)),\n              (UP, (-1, 0)),\n              (RIGHT, (0, 1)),\n              (LEFT, (0, -1)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if blocked[nx, ny]:\n                      continue\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n\n      # Reconstruct path\n      if goal_pos not in came_from:\n          return None  # no path found\n      path_actions = []\n      cur = goal_pos\n      while cur != start:\n          a = action_from[cur]\n          path_actions.append(a)\n          cur = came_from[cur]\n      path_actions.reverse()\n      return path_actions\n\n  actions = []\n\n  # ---- Collect each required primitive ----\n  for prim_idx, cnt in needed.items():\n      # Find all locations currently holding this primitive\n      prim_locs = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n      # Simple safety: if not enough locations, break early\n      if len(prim_locs) < cnt:\n          cnt = len(prim_locs)\n      for _ in range(cnt):\n          # Choose the closest remaining location (Manhattan distance)\n          if not prim_locs:\n              break\n          distances = [abs(pos[0] - lx) + abs(pos[1] - ly) for (lx, ly) in prim_locs]\n          target = prim_locs.pop(distances.index(min(distances)))\n\n          # Compute path\n          path = _bfs_path(pos, target, allow_goal=True)\n          if path is None:\n              path = _manhattan(pos, target)\n          actions.extend(path)\n          pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ---- Move to workshop and craft ----\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          # Choose nearest workshop\n          distances = [abs(pos[0] - lx) + abs(pos[1] - ly) for (lx, ly) in ws_locs]\n          target_ws = ws_locs[distances.index(min(distances))]\n\n          # Path to workshop\n          path = _bfs_path(pos, target_ws, allow_goal=True)\n          if path is None:\n              path = _manhattan(pos, target_ws)\n          actions.extend(path)\n          pos = target_ws\n\n          # Craft at workshop\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:41:10.158131", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"])\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)\n  state = env._current_state\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  actions = []\n\n  # BFS path finder\n  import collections\n  def bfs(start, target):\n      width, height = grid.shape[:2]\n      # blocked cells: any non\u2011grabbable entity present\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n      # allow stepping on target even if blocked (e.g., workshop)\n      blocked[target[0], target[1]] = False\n      q = collections.deque([start])\n      came = {start: None}\n      act = {}\n      dirs = [(DOWN, (1,0)), (UP, (-1,0)), (RIGHT, (0,1)), (LEFT, (0,-1))]\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x,y = cur\n          for a,(dx,dy) in dirs:\n              nx, ny = x+dx, y+dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx,ny]:\n                  nxt = (nx,ny)\n                  if nxt not in came:\n                      came[nxt]=cur\n                      act[nxt]=a\n                      q.append(nxt)\n      if target not in came:\n          return None\n      path=[]\n      cur=target\n      while cur!=start:\n          path.append(act[cur])\n          cur=came[cur]\n      path.reverse()\n      return path\n\n  # collect primitives\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              break\n          # nearest by Manhattan\n          target = min(locations, key=lambda p: abs(p[0]-pos[0])+abs(p[1]-pos[1]))\n          path = bfs(pos, target)\n          if path is None:\n              # fallback Manhattan moves\n              dx = target[0]-pos[0]\n              dy = target[1]-pos[1]\n              path = []\n              while dx>0:\n                  path.append(DOWN); dx-=1\n              while dx<0:\n                  path.append(UP); dx+=1\n              while dy>0:\n                  path.append(RIGHT); dy-=1\n              while dy<0:\n                  path.append(LEFT); dy+=1\n          actions.extend(path)\n          actions.append(USE)\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # move to workshop and craft\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(ws_locs, key=lambda p: abs(p[0]-pos[0])+abs(p[1]-pos[1]))\n          path = bfs(pos, target_ws)\n          if path is None:\n              dx = target_ws[0]-pos[0]\n              dy = target_ws[1]-pos[1]\n              path = []\n              while dx>0:\n                  path.append(DOWN); dx-=1\n              while dx<0:\n                  path.append(UP); dx+=1\n              while dy>0:\n                  path.append(RIGHT); dy-=1\n              while dy<0:\n                  path.append(LEFT); dy+=1\n          actions.extend(path)\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:41:11.277437", "function_name": "make_arrow", "function_body": "  # ----- Setup -----\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n  goal = env.task.goal\n  # primitive requirements for the goal (primitive index -> count)\n  needed = env.world.cookbook.primitives_for(goal)\n\n  # current state snapshot\n  state = env._current_state\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # mutable copy to simulate pickups\n\n  # ----- Helper functions -----\n  def _bfs_path(start, target, allow_target_block=False):\n      \"\"\"Return list of actions to move from start to target using BFS.\n      start/target are (x, y) tuples. If allow_target_block is True the target\n      cell is considered traversable even if it contains a non\u2011grabbable entity.\"\"\"\n      width, height = grid.shape[:2]\n      # cells occupied by non\u2011grabbable entities are blocked\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      if allow_target_block:\n          blocked[target[0], target[1]] = False\n\n      # BFS\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in (\n              (DOWN, (1, 0)),\n              (UP, (-1, 0)),\n              (RIGHT, (0, 1)),\n              (LEFT, (0, -1)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None  # no path found\n\n      # reconstruct actions\n      actions = []\n      cur = target\n      while cur != start:\n          a = action_from[cur]\n          actions.append(a)\n          cur = came_from[cur]\n      actions.reverse()\n      return actions\n\n  def _manhattan_path(start, target):\n      \"\"\"Fallback simple Manhattan movement (ignores obstacles).\"\"\"\n      moves = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ----- Collect required primitives -----\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate all remaining instances of this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # nothing left of this primitive; abort further collection\n              break\n          # pick the closest one (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = _bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = _manhattan_path(pos, target)\n          actions.extend(path)\n          pos = target\n          # pick up the primitive\n          actions.append(USE)\n          grid[pos[0], pos[1], prim_idx] = 0  # simulate removal\n\n  # ----- Move to workshop and craft -----\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          # choose nearest workshop\n          target_ws = min(\n              ws_locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = _bfs_path(pos, target_ws, allow_target_block=True)\n          if path is None:\n              path = _manhattan_path(pos, target_ws)\n          actions.extend(path)\n          pos = target_ws\n          # craft at the workshop\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:41:33.782711", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      \"\"\"Breadth\u2011first search returning a list of action indices that reaches any target cell.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should never happen for valid scenarios\n\n  def go_to_kind(kind_idx, count):\n      \"\"\"Move to cells containing `kind_idx` and USE them `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE\n\n  # ----------------------------------------------------------------------\n  # Gather recipe information for the target item (arrow)\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}   # primitive kind -> total count required\n  craft_steps = []    # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, multiplier):\n      \"\"\"Recursively collect primitive needs and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:  # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # Resolve ingredients first (ignore special keys like \"_at\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the full action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 2) Perform crafting steps at their respective workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:41:34.898224", "function_name": "make_arrow", "function_body": "  # Directions: DOWN, UP, LEFT, RIGHT (matching action indices 0\u20114, with 4 = USE)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, targets, blocked):\n      \"\"\"Bread\u2011first search returning a list of action indices that reaches any target cell.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should never happen for a solvable scenario\n\n  def go_to_kind(kind_idx, count):\n      \"\"\"Move to cells containing `kind_idx` and USE them `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          # locate all cells that currently hold the required kind\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE action\n\n  # ----------------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # Containers for required primitives and ordered crafting steps\n  needed_prims = {}          # primitive kind -> total count needed\n  craft_steps = []           # list of (item_idx, count) in crafting order\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredients first (ignore special keys like \"_at\" or \"_key\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Then schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # Find any cell(s) that contain the required workshop type\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # Use the workshop the required number of times to craft the item\n      actions.extend([4] * cnt)   # USE action repeated `cnt` times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:41:53.141512", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices that moves from start to the nearest target.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable in a solvable scenario\n\n  def go_to_kind(kind_idx, count):\n      \"\"\"Move to a cell containing `kind_idx` and USE it `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE\n\n  # ------------------------------------------------------------------\n  # Gather recipe information for \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive needs and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:41:54.259069", "function_name": "make_arrow", "function_body": "  # Directions correspond to actions: DOWN, UP, LEFT, RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of action indices that\n  # reaches any cell in `targets` while avoiding cells marked in `blocked`.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 return empty (should not happen in valid scenarios)\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and perform the USE\n  # action `count` times (collecting primitives or using a workshop).\n  # ------------------------------------------------------------------\n  def go_to_kind(kind_idx, count):\n      nonlocal pos, actions\n      for _ in range(count):\n          # Find all cells that currently hold the required kind\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 1) Gather recipe information for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredient items first (ignore special keys like \"_at\" or \"_key\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # 2) Static environment data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 3) Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 3a) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 3b) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # Locate any workshop cell of the required type\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # Use the workshop the necessary number of times to craft the item\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:42:14.860978", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Constants for actions\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTION_DELTAS = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: Breadth\u2011first search for a walkable path (ignoring the target\n  # cell if it is occupied by the desired primitive or workshop)\n  # ------------------------------------------------------------------\n  def _bfs_path(src, dst, grid, allow_target=False):\n      \"\"\"Return a list of actions moving from src to dst avoiding blocked cells.\n\n      If allow_target is False the destination cell itself must be empty;\n      otherwise it may be occupied (used when we need to stand on a workshop\n      or a primitive cell).\"\"\"\n      h, w, _ = grid.shape\n      visited = np.full((h, w), False, dtype=bool)\n      prev = np.empty((h, w), dtype=object)\n\n      q = collections.deque()\n      q.append(src)\n      visited[src] = True\n      while q:\n          r, c = q.popleft()\n          if (r, c) == dst:\n              break\n          for act, (dr, dc) in ACTION_DELTAS.items():\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc]:\n                  # cell is walkable if empty or (allow_target and it is the dst)\n                  blocked = grid[nr, nc].sum() > 0\n                  if blocked and not (allow_target and (nr, nc) == dst):\n                      continue\n                  visited[nr, nc] = True\n                  prev[nr, nc] = (r, c, act)\n                  q.append((nr, nc))\n      else:\n          # No path found\n          return None\n\n      # reconstruct actions\n      actions = []\n      cur = dst\n      while cur != src:\n          r, c, act = prev[cur]\n          actions.append(act)\n          cur = (r, c)\n      actions.reverse()\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind (Manhattan distance)\n  # ------------------------------------------------------------------\n  def _nearest_cell(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _any_cell(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify goal index for 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # not defined in recipes\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting multiplicities)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = _nearest_cell(state.grid, prim_idx, state.pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return action_seq\n\n          # Compute path to a cell adjacent to the primitive (or onto it if walkable)\n          # Prefer standing on the primitive cell if it is walkable; otherwise stop next to it.\n          path = _bfs_path(state.pos, target, state.grid, allow_target=True)\n          if path is None:\n              # try to get adjacent cell\n              adj_found = False\n              for act, (dr, dc) in ACTION_DELTAS.items():\n                  adj = (target[0] + dr, target[1] + dc)\n                  if 0 <= adj[0] < state.grid.shape[0] and 0 <= adj[1] < state.grid.shape[1]:\n                      if state.grid[adj].sum() == 0:\n                          path = _bfs_path(state.pos, adj, state.grid, allow_target=False)\n                          if path is not None:\n                              adj_found = True\n                              break\n              if not adj_found:\n                  return action_seq\n\n          # Execute movement actions\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n\n          # Use action to pick up the primitive\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # Craft the arrow (move to workshop if required)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any_cell(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          path = _bfs_path(state.pos, workshop_pos, state.grid, allow_target=True)\n          if path is not None:\n              for a in path:\n                  reward, done, obs = env.step(a)\n                  state = env._current_state\n                  action_seq.append(a)\n                  if done:\n                      return action_seq\n          # Craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n  else:\n      # No specific workshop \u2013 attempt crafting in place\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:42:15.956672", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: Manhattan path (list of actions) from src to dst\n  # ----------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell (Manhattan) containing a given kind\n  # ----------------------------------------------------------------------\n  def _nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ----------------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # ----------------------------------------------------------------------\n  def _any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Initialise episode\n  # ----------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  # ----------------------------------------------------------------------\n  # Identify the goal index for \"arrow\"\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # arrow not defined in the recipe file\n      return []\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ----------------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (respecting multiplicities)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = _nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # Primitive missing from the map \u2013 abort early\n              return action_seq\n          # Move to the primitive cell\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick up the primitive\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow: move to workshop if the recipe specifies one\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Use the workshop to craft\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n  else:\n      # No specific workshop \u2013 attempt crafting in place\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:42:50.365571", "function_name": "make_arrow", "function_body": "  # Breadth\u2011first search to find a path of actions from start to any target cell.\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # Should never happen for a solvable scenario\n\n  # Move to a cell containing a given kind and issue a USE action `cnt` times.\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE\n\n  # ----------------------------------------------------------------------\n  # Gather world / recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ----------------------------------------------------------------------\n  # Resolve full crafting plan: primitives needed + ordered craft steps\n  # ----------------------------------------------------------------------\n  needed_prims = {}          # primitive idx \u2192 total count\n  craft_steps = []           # (item_idx, count) in dependency order\n\n  def resolve(item_idx, mul):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul\n          return\n      # Resolve ingredients first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mul)\n      # Schedule this item to be crafted after its ingredients\n      craft_steps.append((item_idx, mul))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all primitive resources required by the recipe\n  for kind, cnt in needed_prims.items():\n      acquire(kind, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:42:51.469201", "function_name": "make_arrow", "function_body": "  # Gather world and recipe information\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Resolve full dependency tree: primitives needed and craft order\n  # ------------------------------------------------------------------\n  needed_prims = {}          # primitive index -> total count required\n  craft_steps = []           # list of (item_idx, count) in post\u2011order\n\n  def resolve(item_idx: int, multiplier: int) -> None:\n      \"\"\"Populate needed_prims and craft_steps for `item_idx`.\"\"\"\n      recipe = cookbook.recipes.get(item_idx)\n      if recipe is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # Resolve ingredients first (ignore special keys)\n      for ing, cnt in recipe.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # Schedule crafting of this item after its ingredients\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static world data\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid                     # (W, H, n_kinds)\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # Directions aligned with action indices: 0\u2011DOWN, 1\u2011UP, 2\u2011LEFT, 3\u2011RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of action numbers that reaches any target cell\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, targets):\n      \"\"\"Return list of actions to reach the nearest cell in `targets`.\"\"\"\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []   # Should never happen in a solvable scenario\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)   # current (x, y)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, count in needed_prims.items():\n      # locate any cell that currently holds this primitive\n      primitive_cells = {(x, y) for x in range(w) for y in range(h)\n                         if grid[x, y, kind_idx] > 0}\n      path = bfs(pos, primitive_cells)\n      actions.extend(path)\n      for a in path:                     # update simulated position\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      actions.extend([4] * count)        # USE action (index 4) to pick up\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, count in craft_steps:\n      recipe = cookbook.recipes[item_idx]\n      wk_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      workshop_cells = {(x, y) for x in range(w) for y in range(h)\n                        if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, workshop_cells)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * count)        # USE at workshop to craft\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:43:24.688690", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined by CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # Reset the environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def occupied(y, x):\n      \"\"\"Return True if any entity occupies the cell.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Bread\u2011first search for a walkable path (ignores direction).\"\"\"\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if occupied(ny, nx):\n                  continue\n              new_path = path + [act]\n              if (ny, nx) == goal:\n                  return new_path\n              visited.add((ny, nx))\n              q.append(((ny, nx), new_path))\n      # No path found \u2013 return empty (will likely fail later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell, avoid=set()):\n      \"\"\"Return a free neighbour of ``cell`` not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not occupied(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives for 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  collected = set()                       # cells already harvested\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions\n\n          adj = free_adjacent(target, avoid=collected)\n          if adj is None:\n              return actions\n\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive before using\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          actions.append(USE)\n\n          # Update internal grid and record the harvested cell\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = free_adjacent(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = cur_pos\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:43:25.797335", "function_name": "make_arrow", "function_body": "  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Reset environment and obtain core objects\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_occupied(y, x):\n      \"\"\"A cell is occupied if any non\u2011grabbable entity is present.\"\"\"\n      if not in_bounds(y, x):\n          return True\n      # non\u2011grabbable entities are listed in world.non_grabbable_indices\n      occ = np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n      return occ\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions that moves from start to goal\n      while avoiding occupied cells.  Returns empty list if no path.\"\"\"\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          y, x, path = q.popleft()\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_occupied(ny, nx):\n                  continue\n              new_path = path + [act]\n              if (ny, nx) == goal:\n                  return new_path\n              visited.add((ny, nx))\n              q.append((ny, nx, new_path))\n      return []  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of ``cell`` not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_occupied(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives for 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  harvested = set()                       # cells already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=harvested)\n          if adj is None:\n              # No free neighbour \u2013 abort\n              return actions\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (move one step onto it)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid to reflect removal\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=harvested)\n          if ws_adj is None:\n              ws_adj = cur_pos  # stay where we are if no free neighbour\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (move onto it)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 25, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:43:58.884290", "function_name": "make_arrow", "function_body": "  DIR_TO_ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs(start, targets, grid, blocked_kinds):\n      \"\"\"Return actions moving from ``start`` to a cell adjacent to any\n      cell in ``targets`` while avoiding ``blocked_kinds``.\"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.zeros((W, H), dtype=bool)\n      for k in blocked_kinds:\n          blocked |= grid[:, :, k] > 0\n\n      sx, sy = start\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise environment and extract task information.\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task.\")\n\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind: count}\n  block_set = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_kind, cnt in needed_prims.items():\n      while cnt > 0:\n          cells = np.argwhere(grid[:, :, prim_kind] > 0)\n          if cells.size == 0:\n              # Primitive exhausted \u2013 abort planning.\n              return plan\n          path = bfs(pos, cells.tolist(), grid, block_set)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          plan.append(4)  # USE to pick up\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              break\n          grid[adj[0], adj[1], prim_kind] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get('_at') or recipe.get('_key')\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_kind = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_kind = int(workshop_key)\n      workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid, block_set)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          plan.append(4)  # USE to craft\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:43:59.992752", "function_name": "make_arrow", "function_body": "  # Mapping from direction vectors to action indices.\n  DIR_TO_ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ------------------------------------------------------------------\n  # Breadth\u2011first search that returns a list of actions moving the agent\n  # from ``start_pos`` to a position that is Manhattan\u2011adjacent to any\n  # cell in ``target_cells``.  Cells that contain any entity are treated\n  # as blocked (the agent may only stand on empty cells).\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs(start_pos, target_cells, grid):\n      \"\"\"Return actions to reach a cell adjacent to one of ``target_cells``.\"\"\"\n      W, H = grid.shape[:2]\n      # A cell is blocked if any kind occupies it.\n      blocked = np.any(grid, axis=2)\n\n      sx, sy = start_pos\n      # If we are already adjacent, no movement needed.\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise the environment and extract task information.\n  # ------------------------------------------------------------------\n  obs = env.reset()\n  state = env._current_state\n  grid = state.grid.copy()               # (W, H, K) occupancy tensor\n  pos = tuple(state.pos)                 # current (x, y) coordinates\n\n  # Goal index is stored in the task object.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in the environment's task.\")\n\n  # Primitive requirements for the goal (primitive kind \u2192 count).\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  plan = []  # List of action indices to be returned.\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          # Locate all remaining cells that contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan\n\n          # Find a path to the nearest reachable primitive (adjacent cell).\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Update simulated position according to the path taken.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use the primitive (action index 4 corresponds to USE).\n          plan.append(4)   # USE\n\n          # Determine which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation \u2013 break to avoid infinite loop.\n              break\n\n          # Remove one instance of the primitive from the local grid copy.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          needed_cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get('_at') or recipe.get('_key')\n  if workshop_key is not None:\n      # Resolve the workshop kind index (string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Update simulated position.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft the item by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:44:23.601177", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:44:24.866708", "function_name": "make_arrow", "function_body": "  # Retrieve action indices\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  # Core objects\n  world = env.world\n  state = env._current_state\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  pos = tuple(state.pos)\n\n  # Determine goal index for \"arrow\"\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n  if goal_idx is None:\n      raise RuntimeError(\"Unable to locate goal index for 'arrow'.\")\n\n  # Primitive requirements (raw resources) for the goal\n  primitives_needed = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to nearest target cells while avoiding blocked cells\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, targets):\n      \"\"\"Return a list of actions to reach any cell in *targets*.\n      Cells are considered blocked if any kind occupies them, unless the\n      cell is one of the target cells.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in targets:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # Blocked if any entity present and not a target\n              if np.any(grid[nx, ny, :]) and nxt not in targets:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def apply_path(path):\n      \"\"\"Update *pos* according to a sequence of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif a == UP:\n              pos = (pos[0], pos[1] - 1)\n          elif a == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif a == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count_needed in primitives_needed.items():\n      collected = 0\n      # Find all locations containing this primitive\n      locations = [(x, y) for x in range(width) for y in range(height)\n                   if grid[x, y, prim_idx] > 0]\n      # Simple greedy: iterate through locations until we have enough\n      loc_ptr = 0\n      while collected < count_needed and loc_ptr < len(locations):\n          target = locations[loc_ptr]\n          loc_ptr += 1\n\n          # Move to the target cell\n          path = bfs(pos, {target})\n          if path is None:\n              continue  # cannot reach this instance, try next\n          actions.extend(path)\n          apply_path(path)\n\n          # Determine how many units are on this cell\n          available = int(grid[target[0], target[1], prim_idx])\n          to_take = min(count_needed - collected, available)\n\n          for _ in range(to_take):\n              actions.append(USE)\n              inventory[prim_idx] += 1\n              grid[target[0], target[1], prim_idx] -= 1\n\n          collected += to_take\n\n      if collected < count_needed:\n          # Not enough of this primitive on the map; cannot complete task\n          raise RuntimeError(\n              f\"Insufficient primitive {prim_idx} for crafting arrow.\"\n          )\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_name is not None:\n      # Resolve workshop index\n      if isinstance(workshop_name, int):\n          workshop_idx = workshop_name\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is None:\n          raise RuntimeError(f\"Workshop '{workshop_name}' not found in index.\")\n      # Locate any workshop cell\n      workshop_cells = [(x, y) for x in range(width) for y in range(height)\n                        if grid[x, y, workshop_idx] > 0]\n      if not workshop_cells:\n          raise RuntimeError(\"No workshop cell found on the map.\")\n      ws_target = workshop_cells[0]\n      path = bfs(pos, {ws_target})\n      if path is not None:\n          actions.extend(path)\n          apply_path(path)\n      # Final USE to craft the arrow\n      actions.append(USE)\n  else:\n      # No specific workshop required; just use to craft in place\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:50:06.620781", "function_name": "make_arrow", "function_body": "  actions = []\n  # Reset the environment and obtain the initial observation.\n  obs = env.reset()\n  task_name = obs.get('task_name')\n  if isinstance(task_name, bytes):\n      task_name = task_name.decode()\n  import re, numpy as np\n\n  # Extract the goal item name from the task string, e.g. \"make[arrow]\".\n  m = re.search(r'\\[(\\w+)\\]', task_name or '')\n  goal_name = m.group(1) if m else None\n\n  # Access world, cookbook and resolve indices.\n  world = env.scenario.world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index.index(goal_name)\n\n  # Primitive requirements for the goal.\n  required = cookbook.primitives_for(goal_idx)\n\n  # Find the workshop index for the goal (stored under a non\u2011int key).\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  for k, v in recipe.items():\n      if not isinstance(k, int):\n          workshop_idx = v\n          break\n\n  # Action indices.\n  spec = env.action_specs()\n  DIR_DOWN = spec['DOWN']\n  DIR_UP = spec['UP']\n  DIR_LEFT = spec['LEFT']\n  DIR_RIGHT = spec['RIGHT']\n  DIR_USE = spec['USE']\n\n  # Current state reference.\n  state = env._current_state\n\n  # Helper to move the agent to a target cell using Manhattan moves.\n  def move_to(target):\n      nonlocal state, actions\n      while state.pos[0] < target[0]:\n          actions.append(DIR_DOWN)\n          env.step(DIR_DOWN)\n          state = env._current_state\n      while state.pos[0] > target[0]:\n          actions.append(DIR_UP)\n          env.step(DIR_UP)\n          state = env._current_state\n      while state.pos[1] < target[1]:\n          actions.append(DIR_RIGHT)\n          env.step(DIR_RIGHT)\n          state = env._current_state\n      while state.pos[1] > target[1]:\n          actions.append(DIR_LEFT)\n          env.step(DIR_LEFT)\n          state = env._current_state\n\n  # Collect each required primitive.\n  for prim_idx, need in required.items():\n      while need > 0:\n          grid = state.grid\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.shape[0] == 0:\n              break  # primitive not found; abort.\n          target = tuple(locs[0])\n          move_to(target)\n          actions.append(DIR_USE)\n          env.step(DIR_USE)\n          state = env._current_state\n          need -= 1\n\n  # Move to the appropriate workshop and craft the goal item.\n  if workshop_idx is not None:\n      grid = state.grid\n      locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if locs.shape[0] > 0:\n          target = tuple(locs[0])\n          move_to(target)\n          actions.append(DIR_USE)\n          env.step(DIR_USE)\n          state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:55:06.694305", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper to execute an action and keep the internal state in sync\n  def _do_action(action):\n      nonlocal state, actions\n      actions.append(action)\n      # CraftState.step returns (reward, new_state)\n      _, state = state.step(action)\n\n  # Start from the current state inside the environment\n  state = env._current_state\n  world = env.world\n\n  # Index of the target item (\"arrow\")\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n\n  # Primitive requirements for one arrow\n  needed = dict(world.cookbook.primitives_for(arrow_idx))\n\n  # Workshop where the arrow must be crafted (if any)\n  workshop_idx = None\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  while needed:\n      # Choose a primitive that is still needed\n      prim_idx, count_needed = next(iter(needed.items()))\n\n      # Locate all cells containing this primitive\n      positions = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if positions.size == 0:\n          # No more of this primitive on the map \u2013 cannot continue\n          raise RuntimeError(\"Required primitive not found on the grid\")\n\n      # Pick the closest one (Manhattan distance)\n      cur_x, cur_y = state.pos\n      dists = np.abs(positions[:, 0] - cur_x) + np.abs(positions[:, 1] - cur_y)\n      target_pos = positions[dists.argmin()]\n      tx, ty = target_pos.tolist()\n\n      # Move horizontally then vertically towards the target cell\n      while state.pos[0] < tx:\n          _do_action(RIGHT)\n      while state.pos[0] > tx:\n          _do_action(LEFT)\n      while state.pos[1] < ty:\n          _do_action(DOWN)\n      while state.pos[1] > ty:\n          _do_action(UP)\n\n      # Pick up the primitive (USE)\n      _do_action(USE)\n\n      # Update bookkeeping\n      count_needed -= 1\n      if count_needed == 0:\n          del needed[prim_idx]\n      else:\n          needed[prim_idx] = count_needed\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      # Find any workshop cell\n      workshop_cells = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size == 0:\n          raise RuntimeError(\"Workshop required for arrow not present\")\n      # Choose the closest workshop\n      cur_x, cur_y = state.pos\n      dists = np.abs(workshop_cells[:, 0] - cur_x) + np.abs(workshop_cells[:, 1] - cur_y)\n      wx, wy = workshop_cells[dists.argmin()].tolist()\n\n      # Move to the workshop cell\n      while state.pos[0] < wx:\n          _do_action(RIGHT)\n      while state.pos[0] > wx:\n          _do_action(LEFT)\n      while state.pos[1] < wy:\n          _do_action(DOWN)\n      while state.pos[1] > wy:\n          _do_action(UP)\n\n  # Use the workshop to craft the arrow\n  _do_action(USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:55:34.344600", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash includes position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500  # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typical action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:55:49.945823", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:56:24.470066", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan path (fallback when no obstacle\u2011aware path found)\n  # ------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that respects passable kinds (empty cells + allowed kinds)\n  # ------------------------------------------------------------------\n  def _bfs_path(grid, start, goal, allowed_kinds):\n      h, w, _ = grid.shape\n      queue = collections.deque()\n      queue.append((start, []))\n      visited = {start}\n      while queue:\n          (r, c), path = queue.popleft()\n          if (r, c) == goal:\n              return path\n          for act, (dr, dc) in ((DOWN, (1, 0)), (UP, (-1, 0)),\n                                (LEFT, (0, -1)), (RIGHT, (0, 1))):\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              if (nr, nc) in visited:\n                  continue\n              cell_kinds = np.where(grid[nr, nc, :] > 0)[0]\n              if cell_kinds.size == 0:\n                  passable = True\n              else:\n                  # cell is passable if any of its kinds are in allowed_kinds\n                  passable = any(k in allowed_kinds for k in cell_kinds)\n              if passable:\n                  visited.add((nr, nc))\n                  queue.append(((nr, nc), path + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a specific kind (Manhattan)\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: locate any cell containing a specific kind\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Begin episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify arrow index\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []  # unknown goal\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for one arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, need_cnt in primitive_needs.items():\n      for _ in range(need_cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # cannot find the primitive \u2013 abort\n              return action_seq\n\n          # compute path respecting obstacles, allowing stepping on the target primitive\n          path = _bfs_path(state.grid, state.pos, target, {prim_idx})\n          if path is None:\n              path = _manhattan_path(state.pos, target)\n\n          # execute movement actions\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n\n          # pick up the primitive\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its workshop (if required)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          path = _bfs_path(state.grid, state.pos, workshop_pos, {workshop_idx})\n          if path is None:\n              path = _manhattan_path(state.pos, workshop_pos)\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # perform crafting\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n  else:\n      # No specific workshop \u2013 just attempt to craft in place\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:56:25.570258", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # reset environment to start a new episode\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # locate the index of the target item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # primitives needed for a single arrow\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  action_seq: list[int] = []\n\n  # helper to find nearest cell containing a kind\n  def _find_nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # helper to find any cell containing a kind (used for workshop)\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # helper to generate Manhattan path actions from src to dst\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, qty in primitive_needs.items():\n      for _ in range(qty):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive not present; abort\n              return action_seq\n          for a in _path(state.pos, target):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n          # pick up the primitive\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n  # perform the crafting action\n  _, _, _ = env.step(USE)\n  state = env._current_state\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:56:56.113874", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n  ACTION_USE = 4\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices that reaches any cell in *targets*.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No path found \u2013 should not happen in well\u2011formed scenarios\n      return []\n\n  def go_to_and_use(kind_idx, count):\n      \"\"\"Move to a cell containing *kind_idx* and USE it *count* times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # Extract recipe information for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # primitive requirements and ordered crafting steps\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # list of (item_idx, multiplier) in post\u2011order\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively gather primitive counts and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredients first\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):        # ignore special keys like \"_at\"\n              resolve(ing, cnt * mult)\n      # Then schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Prepare static data about the current grid\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the full action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all primitive resources needed\n  for prim_idx, cnt in needed_prims.items():\n      go_to_and_use(prim_idx, cnt)\n\n  # 2) Perform crafting steps at the required workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:56:57.223558", "function_name": "make_arrow", "function_body": "  # Helper BFS to find a path of actions from start to any target cell.\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices that reaches any target cell.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # Should not happen for solvable scenarios\n\n  def go_to_kind(kind_idx, count):\n      \"\"\"Move to cells containing `kind_idx` and USE them `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE action\n\n  # ------------------------------------------------------------------\n  # Gather recipe information for the target item (\"arrow\")\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}\n  craft_steps = []\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively compute primitive requirements and crafting order.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:\n          # Primitive item (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredients first\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static data about the current grid\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1. Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 2. Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)  # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:57:27.304712", "function_name": "make_arrow", "function_body": "  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = {(1, 0): DOWN, (-1, 0): UP, (0, -1): LEFT, (0, 1): RIGHT}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path finder that avoids any non\u2011empty cell.\n  # It returns a list of actions that moves the agent from `start`\n  # to a position adjacent to any of the `targets` (inclusive of the\n  # possibility that `start` is already adjacent).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      width, height, _ = grid.shape\n      # Pre\u2011compute occupied cells (any non\u2011zero kind)\n      occupied = np.any(grid > 0, axis=2)\n      # Queue stores (x, y, path_actions)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = set()\n      visited.add(start)\n\n      # Convert targets to a set for fast membership testing\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent (including diagonal) to a target, stop\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  # Already on the target (rare for primitives)\n                  return path\n\n          # Explore 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if (nx, ny) in visited:\n                      continue\n                  # Can step on the cell if it is empty\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # If no path found, fall back to empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Identify world and cookbook\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n\n  # Goal information (hard\u2011coded to \"arrow\")\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Obtain current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # Reset the environment to obtain an initial state\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y) position\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count_needed in primitives_needed.items():\n      # Find all locations that currently contain this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Greedy nearest\u2011first ordering based on Manhattan distance\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= count_needed:\n              break\n          if loc in harvested:\n              continue\n          # Move to a cell adjacent to the primitive location\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          # Update agent position after following the path\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use action to pick up the primitive (must be facing it)\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft at the appropriate workshop (if the recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Locate all workshop cells of the required type\n      workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          # Choose the nearest workshop\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_locs[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use action to craft at the workshop\n          actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:57:28.433457", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = {\n      (0, 1): DOWN,\n      (0, -1): UP,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  def bfs(start, goal, blocked):\n      \"\"\"Return a list of positions from start (exclusive) to goal (inclusive).\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < blocked.shape[0] and 0 <= ny < blocked.shape[1]:\n                  if not blocked[nx, ny] and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      parent[(nx, ny)] = cur\n                      q.append((nx, ny))\n      else:\n          # No path found \u2013 return empty list (will likely fail later)\n          return []\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while parent[cur] is not None:\n          path.append(cur)\n          cur = parent[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path, start_pos):\n      \"\"\"Convert a list of positions to action indices, assuming start_pos is the\n      agent's current location.\"\"\"\n      actions = []\n      cur = start_pos\n      for nxt in path:\n          dx = nxt[0] - cur[0]\n          dy = nxt[1] - cur[1]\n          act = DIRS.get((dx, dy))\n          if act is None:\n              # should not happen\n              continue\n          actions.append(act)\n          cur = nxt\n      return actions\n\n  # ------------------------------------------------------------------\n  # Identify world, cookbook and goal\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # CraftLab wraps a scenario; the underlying world is in the scenario\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Get current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # reset the environment to obtain an initial state\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)            # (x, y)\n  grid = state.grid                  # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Determine which cells are blocked (non\u2011grabbable entities)\n  # ------------------------------------------------------------------\n  non_grabbable = set(world.non_grabbable_indices)\n  blocked = np.zeros(grid.shape[:2], dtype=bool)\n  if non_grabbable:\n      idxs = list(non_grabbable)\n      blocked = np.any(grid[:, :, idxs] > 0, axis=2)\n\n  actions = []\n  used_cells = set()   # primitives already collected\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, need_cnt in primitives_needed.items():\n      # locate all cells that currently contain this primitive\n      prim_locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position (greedy)\n      prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in prim_locs:\n          if gathered >= need_cnt:\n              break\n          if loc in used_cells:\n              continue\n\n          # Find path to the primitive location (allow stepping onto it)\n          path = bfs(pos, loc, blocked)\n          actions.extend(path_to_actions(path, pos))\n          pos = loc\n\n          # Pick up the primitive\n          actions.append(USE)\n          used_cells.add(loc)\n          gathered += 1\n\n          # After pickup the cell becomes empty \u2013 update blocked map\n          blocked[loc[0], loc[1]] = False\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an index)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n\n      # Locate workshop cells\n      ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          # Choose the nearest workshop\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_locs[0]\n\n          # Path to workshop (treat workshop cell as passable)\n          path = bfs(pos, target_ws, blocked)\n          actions.extend(path_to_actions(path, pos))\n          pos = target_ws\n\n          # Craft at the workshop\n          actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:58:04.563656", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, target_cells, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in target_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          if not cells:\n              break\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE\n\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}\n  craft_steps = []\n\n  def resolve(item_idx, mul):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mul)\n      craft_steps.append((item_idx, mul))\n\n  resolve(arrow_idx, 1)\n\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  for kind, cnt in needed_prims.items():\n      acquire(kind, cnt)\n\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      if wk_cells:\n          path = bfs(pos, wk_cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:58:05.684608", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # Should never happen for a solvable scenario\n\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE\n\n  # ------------------------------------------------------------------\n  # Gather world / recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Resolve full crafting plan: primitives needed + ordered craft steps\n  # ------------------------------------------------------------------\n  needed_prims = {}          # primitive idx \u2192 total count\n  craft_steps = []           # (item_idx, count) in dependency order\n\n  def resolve(item_idx, mul):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul\n          return\n      # Resolve ingredients first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mul)\n      # Schedule this item to be crafted after its ingredients\n      craft_steps.append((item_idx, mul))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all primitive resources required by the recipe\n  for kind, cnt in needed_prims.items():\n      acquire(kind, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:58:45.216243", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _in_bounds(pos, shape):\n      x, y = pos\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(pos, shape):\n      x, y = pos\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny), shape):\n              yield (nx, ny)\n\n  def _bfs(start, goal_set, blocked):\n      \"\"\"\n      Bread\u2011first search from ``start`` to any cell in ``goal_set``.\n      ``blocked`` is a 2\u2011D bool array where True means the cell cannot be entered.\n      Returns a list of positions (including start) representing the path,\n      or ``None`` if no path exists.\n      \"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = dict()\n      dq = deque([start])\n      visited[start] = True\n      while dq:\n          cur = dq.popleft()\n          if cur in goal_set:\n              # reconstruct path\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur, (w, h)):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _pos_to_actions(path):\n      \"\"\"\n      Convert a list of positions (including the starting cell) into a list\n      of movement actions.\n      \"\"\"\n      act_list = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              act_list.append(RIGHT)\n          elif x1 < x0:\n              act_list.append(LEFT)\n          elif y1 > y0:\n              act_list.append(DOWN)\n          elif y1 < y0:\n              act_list.append(UP)\n      return act_list\n\n  # ----------------------------------------------------------------------\n  # Main logic\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  shape = grid.shape[:2]                     # (WIDTH, HEIGHT)\n\n  # --------------------------------------------------------------\n  # Determine goal index for \"arrow\"\n  # --------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception as e:\n          raise RuntimeError(\"Could not locate goal index for 'arrow'\") from e\n\n  # --------------------------------------------------------------\n  # Primitive requirements for the goal (expanded)\n  # --------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  # --------------------------------------------------------------\n  # Build blocked map (cells that cannot be stepped on)\n  # --------------------------------------------------------------\n  blocked = np.zeros(shape, dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper: move to a target cell (any reachable cell)\n  # --------------------------------------------------------------\n  def _move_to(target):\n      nonlocal cur_pos, actions, blocked\n      path = _bfs(cur_pos, {target}, blocked)\n      if path is None:\n          # If unreachable, give up silently\n          return cur_pos\n      actions.extend(_pos_to_actions(path))\n      cur_pos = target\n      return cur_pos\n\n  # --------------------------------------------------------------\n  # Collect required primitives\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # Find any cell containing this primitive\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          # Primitive absent \u2013 cannot collect; skip\n          continue\n      prim_pos = tuple(locs[0])\n      # Move onto the primitive cell (primitives are traversable)\n      _move_to(prim_pos)\n      # Pick up the required amount\n      actions.extend([USE] * needed)\n      # After picking up, the cell becomes empty \u2013 update blocked map\n      blocked[prim_pos] = False\n\n  # --------------------------------------------------------------\n  # Move to workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  if workshop_name is not None:\n      # Resolve workshop index\n      if isinstance(workshop_name, int):\n          workshop_idx = workshop_name\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              ws_pos = tuple(ws_locs[0])\n              # Find a free adjacent cell to the workshop\n              adj_candidates = [\n                  nb for nb in _neighbors(ws_pos, shape) if not blocked[nb]\n              ]\n              if adj_candidates:\n                  # Choose the closest candidate\n                  adj_candidates.sort(\n                      key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n                  )\n                  target_adj = adj_candidates[0]\n                  _move_to(target_adj)\n  # Finally, use the workshop (or current cell) to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:58:46.337585", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # World / state shortcuts\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  shape = grid.shape[:2]  # (WIDTH, HEIGHT)\n\n  # ----------------------------------------------------------------------\n  # Determine goal index for \"arrow\"\n  # ----------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n  if goal_idx is None:\n      raise RuntimeError(\"Could not locate goal index for 'arrow'\")\n\n  # ----------------------------------------------------------------------\n  # Primitive requirements (expanded)\n  # ----------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _blocked_cells(g):\n      \"\"\"Boolean 2\u2011D array: True where any entity occupies the cell.\"\"\"\n      return np.any(g > 0, axis=2)\n\n  blocked = _blocked_cells(grid)\n\n  def _in_bounds(pos):\n      x, y = pos\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(pos):\n      x, y = pos\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny)):\n              yield (nx, ny)\n\n  def _bfs(start, goals):\n      \"\"\"Breadth\u2011first search from start to any cell in goals.\"\"\"\n      visited = np.full(shape, False, dtype=bool)\n      prev = {}\n      dq = deque([start])\n      visited[start] = True\n      while dq:\n          cur = dq.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _path_to_actions(path):\n      \"\"\"Convert a list of positions into movement actions.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              acts.append(RIGHT)\n          elif x1 < x0:\n              acts.append(LEFT)\n          elif y1 > y0:\n              acts.append(DOWN)\n          elif y1 < y0:\n              acts.append(UP)\n      return acts\n\n  # ----------------------------------------------------------------------\n  # Main plan construction\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Collect each required primitive.\n  # --------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      # Find any cell that currently holds this primitive.\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          # Primitive not present \u2013 skip.\n          continue\n      prim_pos = tuple(locs[0])\n\n      # Choose a free cell adjacent (or the cell itself if free) to stand on.\n      candidate_cells = []\n      if not blocked[prim_pos]:\n          candidate_cells.append(prim_pos)\n      for nb in _neighbors(prim_pos):\n          if not blocked[nb]:\n              candidate_cells.append(nb)\n\n      if not candidate_cells:\n          # No reachable adjacent cell \u2013 give up on this primitive.\n          continue\n\n      # Pick the candidate with minimal Manhattan distance from current pos.\n      candidate_cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n      dest = candidate_cells[0]\n\n      # Find path to the chosen destination.\n      path = _bfs(cur_pos, {dest})\n      if path is None:\n          continue\n      actions.extend(_path_to_actions(path))\n      cur_pos = dest\n\n      # Perform USE actions to pick up the required amount.\n      actions.extend([USE] * needed_cnt)\n\n      # Update blocked map: after picking up the primitive the cell becomes empty.\n      blocked[prim_pos] = False\n\n  # --------------------------------------------------------------\n  # Move to the appropriate workshop and craft the arrow.\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_key\") or recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_key is not None:\n      if isinstance(workshop_key, int):\n          workshop_idx = workshop_key\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_key)\n\n  if workshop_idx is not None:\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_pos = tuple(ws_locs[0])\n\n          # Choose a free adjacent cell (or the cell itself if free).\n          ws_candidates = []\n          if not blocked[ws_pos]:\n              ws_candidates.append(ws_pos)\n          for nb in _neighbors(ws_pos):\n              if not blocked[nb]:\n                  ws_candidates.append(nb)\n\n          if ws_candidates:\n              ws_candidates.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n              ws_dest = ws_candidates[0]\n              ws_path = _bfs(cur_pos, {ws_dest})\n              if ws_path is not None:\n                  actions.extend(_path_to_actions(ws_path))\n                  cur_pos = ws_dest\n\n  # Final USE to craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:59:11.688646", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  act_map = env.action_specs()\n  move_delta = {\"UP\": (-1, 0), \"DOWN\": (1, 0), \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n  actions = []\n\n  # Helper BFS to find path (list of action names) to a cell adjacent to any target cell\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n      while q:\n          pos, path = q.popleft()\n          # check adjacency (Chebyshev distance <=1)\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  if grid[nx, ny].sum() == 0:  # empty cell\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  # Goal and recipe information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Collect each required primitive the required number of times\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n          # locate all cells containing the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              raise RuntimeError(f\"Primitive {prim_idx} not found on map.\")\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              raise RuntimeError(f\"Cannot reach primitive {prim_idx} from {pos}.\")\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n          # pick up\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Move to workshop if needed and craft\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found.\")\n      path = bfs_to_adjacent(pos, workshop_cells, grid)\n      if path is None:\n          raise RuntimeError(\"Workshop unreachable.\")\n      for act_name in path:\n          act_id = act_map[act_name]\n          actions.append(act_id)\n          env.step(act_id)\n\n  # Final USE to craft (or to pick up if no workshop)\n  actions.append(act_map[\"USE\"])\n  env.step(act_map[\"USE\"])\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:59:12.804732", "function_name": "make_arrow", "function_body": "  # Reset the environment and prepare helpers\n  env.reset()\n  act_map = env.action_specs()  # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  move_delta = {\"UP\": (-1, 0), \"DOWN\": (1, 0), \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  actions: list[int] = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell adjacent (Chebyshev distance \u2264 1) to any\n  # cell in `targets`.  Walks only through empty cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start: tuple[int, int],\n                      targets: list[tuple[int, int]],\n                      grid: np.ndarray) -> list[str] | None:\n      W, H = grid.shape[:2]\n      visited: set[tuple[int, int]] = {start}\n      q: deque[tuple[tuple[int, int], list[str]]] = deque()\n      q.append((start, []))\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # Walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      # Done when we have at least the required amount of each primitive\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):\n          break\n\n      # Find a primitive that is still missing\n      for p_idx, cnt in needed_prims.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n\n      # Locate all cells that currently contain this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Required primitive {missing_idx} not found on the map.\")\n\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive with the USE action\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop is needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:59:27.664852", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move from cur (x, y) to target (x, y) using Manhattan steps.\n  # The actions list is extended in\u2011place.\n  # ------------------------------------------------------------------\n  def _move(cur, target, act_list):\n      x, y = cur\n      tx, ty = target\n      while x < tx:\n          act_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          act_list.append(LEFT)\n          x -= 1\n      while y < ty:\n          act_list.append(DOWN)\n          y += 1\n      while y > ty:\n          act_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Access world and current state from the Lab wrapper.\n  # ------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Determine the index of the goal item.  Prefer the explicit name\n  # \u201carrow\u201d, otherwise fall back to the goal stored in the task.\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      # task.goal may already be an integer index\n      goal_idx = getattr(getattr(env, \"task\", None), \"goal\", None)\n      if goal_idx is None:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'.\")\n\n  # ------------------------------------------------------------------\n  # Primitive requirements for the goal (dict {prim_idx: count}).\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (may need >1 of a kind).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      while needed > 0:\n          # Find all cells that currently contain this primitive.\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more instances on the map \u2013 cannot satisfy requirement.\n              # Break out; the planner will simply stop here.\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          nearest = tuple(locations[dists.argmin()])\n\n          # Move to that cell.\n          cur_pos = _move(cur_pos, nearest, actions)\n\n          # How many units are available on that cell?\n          available = int(state.grid[nearest[0], nearest[1], prim_idx])\n          take = min(available, needed)\n\n          # Pick up the required amount.\n          for _ in range(take):\n              actions.append(USE)\n\n          needed -= take\n          # Note: we do not modify the simulated grid; we only plan actions.\n\n  # ------------------------------------------------------------------\n  # After gathering primitives, go to the appropriate workshop and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n              workshop_pos = tuple(ws_locs[dists.argmin()])\n              cur_pos = _move(cur_pos, workshop_pos, actions)\n              actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 18, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:59:28.773337", "function_name": "make_arrow", "function_body": "  # Action identifiers (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move from cur (x, y) to target (x, y) using Manhattan steps.\n  # The actions list is extended in\u2011place.\n  # ------------------------------------------------------------------\n  def _move(cur, target, act_list):\n      x, y = cur\n      tx, ty = target\n      while x < tx:\n          act_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          act_list.append(LEFT)\n          x -= 1\n      while y < ty:\n          act_list.append(DOWN)\n          y += 1\n      while y > ty:\n          act_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Access world and current state from the Lab wrapper.\n  # ------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Identify the goal item index for \"arrow\".\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      # Fallback: try to read from the task description (some environments expose it).\n      goal_idx = getattr(getattr(env, \"task\", None), \"goal\", None)\n      if goal_idx is None:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'.\")\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (may need >1 of a kind).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      while needed > 0:\n          # Find all locations that currently contain the primitive.\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more instances on the map \u2013 cannot satisfy requirement.\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          nearest = tuple(locations[dists.argmin()])\n\n          # Move to that cell.\n          cur_pos = _move(cur_pos, nearest, actions)\n\n          # How many units are available on that cell?\n          available = int(state.grid[nearest[0], nearest[1], prim_idx])\n          take = min(available, needed)\n\n          # Pick up the required amount.\n          for _ in range(take):\n              actions.append(USE)\n\n          needed -= take\n          # (We do not modify the simulated grid here; we only plan actions.)\n\n  # ------------------------------------------------------------------\n  # After gathering primitives, go to the appropriate workshop and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\")\n  if workshop_name is not None:\n      # Resolve workshop index.\n      workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n              workshop_pos = tuple(ws_locs[dists.argmin()])\n              cur_pos = _move(cur_pos, workshop_pos, actions)\n              # Use action at the workshop to craft the arrow.\n              actions.append(USE)\n\n  return actions", "env_interactions": 18, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:59:51.848622", "function_name": "make_arrow", "function_body": "  # Reset environment and initialise variables\n  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()          # name \u2192 id\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Cardinal movement deltas\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of action names that moves the agent from `start`\n      to any cell that is Chebyshev\u2011adjacent (\u22641 in both axes) to a target.\n      Traversal is allowed only through completely empty cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # adjacency test\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # cell must be empty (no entity)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # locate all cells currently holding this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # primitive no longer present \u2013 stop trying\n              break\n\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # unreachable \u2013 give up on this primitive\n              break\n\n          # execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # craft using the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the full sequence of action IDs\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:59:52.962874", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n  act_map = env.action_specs()\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  def bfs_adj(start, targets, grid):\n      \"\"\"Return a list of action names moving from start to a cell adjacent to any target.\"\"\"\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # adjacency check (Chebyshev distance \u2264 1)\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # traversable only if the cell is empty\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              break  # cannot find more of this primitive\n\n          path = bfs_adj(pos, prim_cells, grid)\n          if path is None:\n              break  # unreachable primitive\n\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if needed) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_adj(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # craft at the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:00:15.747183", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Retrieve action indices from the environment (fallback to defaults if missing)\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  world = env.world\n  state = env._current_state\n\n  # Determine the goal index for the arrow (use task goal if available)\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise RuntimeError(\"Goal 'arrow' not found in the cookbook.\")\n\n  # Primitive requirements for the goal (expanded to raw resources)\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper: move Manhattan\u2011style from current position to target, updating cur_pos\n  def _move_to(target):\n      nonlocal cur_pos\n      tx, ty = target\n      while cur_pos[0] < tx:\n          actions.append(RIGHT)\n          cur_pos = (cur_pos[0] + 1, cur_pos[1])\n      while cur_pos[0] > tx:\n          actions.append(LEFT)\n          cur_pos = (cur_pos[0] - 1, cur_pos[1])\n      while cur_pos[1] < ty:\n          actions.append(DOWN)\n          cur_pos = (cur_pos[0], cur_pos[1] + 1)\n      while cur_pos[1] > ty:\n          actions.append(UP)\n          cur_pos = (cur_pos[0], cur_pos[1] - 1)\n\n  # Collect each required primitive\n  for prim_idx, needed in primitive_requirements.items():\n      if needed <= 0:\n          continue\n      # Find all cells that currently contain this primitive\n      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # Primitive not present on the map; cannot collect it\n          continue\n      # Choose the nearest occurrence to reduce steps\n      dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n      nearest_loc = tuple(locations[dists.argmin()])\n      _move_to(nearest_loc)\n      # Pick up the required amount (one USE per unit)\n      for _ in range(needed):\n          actions.append(USE)\n\n  # Locate the workshop required for the final crafting step\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = (\n          world.cookbook.index.get(workshop_name)\n          if isinstance(workshop_name, str)\n          else workshop_name\n      )\n      if workshop_idx is not None:\n          ws_locations = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locations.size > 0:\n              # Move to the nearest workshop location\n              dists = np.abs(ws_locations[:, 0] - cur_pos[0]) + np.abs(ws_locations[:, 1] - cur_pos[1])\n              nearest_ws = tuple(ws_locations[dists.argmin()])\n              _move_to(nearest_ws)\n\n  # Use the workshop (or current cell) to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:00:16.851787", "function_name": "make_arrow", "function_body": "  # Retrieve action indices (environment may provide a mapping)\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Determine which item we need to craft (arrow).  Prefer the task goal\n  # if it exists, otherwise look up by name.\n  # ------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception as e:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'\") from e\n\n  # ------------------------------------------------------------------\n  # Find the primitive resources required for the goal (expanded to raw\n  # resources).  The cookbook already returns a dict mapping primitive\n  # kind indices to the quantity needed for a single instance.\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Helper: move from the current position to a target cell using\n  # Manhattan moves.  The function updates cur_pos and appends the\n  # appropriate actions to the action list.\n  # ------------------------------------------------------------------\n  cur_pos = tuple(state.pos)\n  actions = []\n\n  def _move_to(target):\n      nonlocal cur_pos\n      tx, ty = target\n      # move in x direction\n      while cur_pos[0] < tx:\n          actions.append(RIGHT)\n          cur_pos = (cur_pos[0] + 1, cur_pos[1])\n      while cur_pos[0] > tx:\n          actions.append(LEFT)\n          cur_pos = (cur_pos[0] - 1, cur_pos[1])\n      # move in y direction\n      while cur_pos[1] < ty:\n          actions.append(DOWN)\n          cur_pos = (cur_pos[0], cur_pos[1] + 1)\n      while cur_pos[1] > ty:\n          actions.append(UP)\n          cur_pos = (cur_pos[0], cur_pos[1] - 1)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # Find all cells that currently contain this primitive.\n      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # Primitive not present on the map \u2013 cannot collect it.\n          # In a well\u2011formed scenario this should not happen.\n          continue\n      # Choose the first occurrence as the target.\n      target = tuple(locations[0])\n      _move_to(target)\n      # Pick up the required amount (one USE per unit).\n      for _ in range(needed):\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Locate the workshop (if any) where the final crafting must happen.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  # The workshop can be stored under \"_key\" or \"_at\" according to the\n  # schema described in the prompt.\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  if workshop_name is not None:\n      # Convert workshop name to its index in the global kind dictionary.\n      workshop_idx = (\n          world.cookbook.index.get(workshop_name)\n          if isinstance(workshop_name, str)\n          else workshop_name\n      )\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              ws_pos = tuple(ws_locs[0])\n              _move_to(ws_pos)\n\n  # ------------------------------------------------------------------\n  # Finally, use the workshop (or the current cell) to craft the arrow.\n  # ------------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:00:33.278686", "function_name": "make_arrow", "function_body": "  # ----- helper functions -------------------------------------------------\n  def _find_positions(grid, kind):\n      \"\"\"Return list of (x, y) positions where `kind` is present.\"\"\"\n      ys, xs = np.where(grid[:, :, kind] > 0)\n      return list(zip(xs.tolist(), ys.tolist()))\n\n  def _move_to(start_pos, target_pos, actions, act_map):\n      \"\"\"Greedy Manhattan move from start_pos to target_pos, appending actions.\"\"\"\n      x, y = start_pos\n      tx, ty = target_pos\n      while (x, y) != (tx, ty):\n          if x < tx:\n              actions.append(act_map[\"RIGHT\"])\n              x += 1\n          elif x > tx:\n              actions.append(act_map[\"LEFT\"])\n              x -= 1\n          elif y < ty:\n              actions.append(act_map[\"DOWN\"])\n              y += 1\n          elif y > ty:\n              actions.append(act_map[\"UP\"])\n              y -= 1\n      return (x, y)\n\n  # ----------------------------------------------------------------------\n  # Get core objects from the environment\n  world = env.world                     # CraftWorld instance\n  state = env._current_state            # current CraftState\n  grid = state.grid\n  pos = tuple(state.pos)                # (x, y) agent position\n\n  # Action mapping (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  act_map = env.action_specs()          # e.g. {\"DOWN\":0, \"UP\":1, ...}\n  use_action = act_map[\"USE\"]\n\n  # Resolve the goal index for \"arrow\"\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n\n  # ----------------------------------------------------------------------\n  # 1. Gather required primitive resources\n  primitives_needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  actions = []\n\n  for prim_idx, count in primitives_needed.items():\n      # Find any location that contains this primitive\n      prim_positions = _find_positions(grid, prim_idx)\n      if not prim_positions:\n          # No primitive found \u2013 cannot continue; return empty plan\n          return []\n      target = prim_positions[0]   # pick the first occurrence\n\n      for _ in range(count):\n          # Move to the primitive cell\n          pos = _move_to(pos, target, actions, act_map)\n          # Pick it up\n          actions.append(use_action)\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = recipe.get(\"_at\", None)\n  if workshop_idx is None:\n      # No workshop information \u2013 cannot craft\n      return actions\n\n  workshop_positions = _find_positions(grid, workshop_idx)\n  if not workshop_positions:\n      # No workshop found \u2013 cannot craft\n      return actions\n  workshop_target = workshop_positions[0]\n\n  # Move to the workshop cell\n  pos = _move_to(pos, workshop_target, actions, act_map)\n  # Use the workshop to craft the arrow\n  actions.append(use_action)\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
