{"timestamp": "2025-10-28T15:31:55.160120", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # helper: map direction vectors to action indices (as defined in CraftLab)\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n\n  # ----------------------------------------------------------------------\n  # BFS that returns a list of actions moving from start to a cell that is\n  # either the target cell itself or any of its 4\u2011neighbour cells.\n  # ----------------------------------------------------------------------\n  def bfs(start, target_cells, grid):\n      H, W = grid.shape[:2]\n      # cells that are occupied (any kind) are blocked for movement\n      blocked = np.any(grid > 0, axis=2)\n\n      # if start is already adjacent to a target, return empty path\n      sx, sy = start\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      # BFS over positions\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((H, W), False, dtype=bool)\n      visited[sy, sx] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:\n                  if blocked[ny, nx]:\n                      continue\n                  npath = path + [act]\n                  # check adjacency to any target cell\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[ny, nx] = True\n                  q.append((nx, ny, npath))\n      # if we cannot reach, return empty list (fallback)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main logic\n  # ----------------------------------------------------------------------\n  # obtain current state from the environment\n  state = env._current_state\n  grid = state.grid          # shape (H, W, n_kinds)\n  pos = state.pos            # (x, y)\n\n  # goal index\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      # fallback: try to read from env.scenario.world maybe\n      raise ValueError(\"Cannot determine goal index from environment.\")\n\n  # ------------------------------------------------------------------\n  # 1. Determine which primitive resources are required for the goal.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          # locate all cells containing this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # primitive not present \u2013 cannot continue\n              break\n          # compute path to the nearest primitive (by Manhattan distance)\n          # we treat the primitive cell itself as a target (we will move next to it)\n          path = bfs(pos, prim_cells.tolist(), grid)\n          actions.extend(path)\n          # update position after moving\n          for a in path:\n              dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # now we are adjacent to a primitive cell \u2013 use it\n          actions.append(4)   # USE\n          # simulate the use: inventory would increase, grid would lose the primitive\n          # For planning we only need to update our local copies.\n          # Find the primitive cell we are adjacent to (any)\n          adj_prim = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_prim = (cx, cy)\n                  break\n          if adj_prim is not None:\n              # remove one instance from the grid representation\n              grid[adj_prim[1], adj_prim[0], prim_idx] -= 1\n              needed_cnt -= 1\n          else:\n              # shouldn't happen; break to avoid infinite loop\n              break\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is None:\n      # no specific workshop \u2013 nothing to do\n      return actions\n\n  # workshop_key may be a string name or an integer index\n  if isinstance(workshop_key, str):\n      workshop_idx = env.world.cookbook.index[workshop_key]\n  else:\n      workshop_idx = workshop_key\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size > 0:\n      path = bfs(pos, workshop_cells.tolist(), grid)\n      actions.extend(path)\n      # update position after moving\n      for a in path:\n          dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # finally, use the workshop to craft the item\n      actions.append(4)   # USE\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:32:19.425305", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh start\n  env.reset()\n  # Determine the maximum number of steps allowed for the episode\n  max_steps = getattr(env, \"max_steps\", 100)\n  # Action index for the USE operation (collect/craft)\n  USE = 4\n  # Return a simple repetitive plan that keeps invoking USE\n  return [USE] * max_steps", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:32:20.541593", "function_name": "make_arrow", "function_body": "  # Helper to get index of a named kind\n  def _kind_idx(name):\n      return env.world.cookbook.index[name]\n\n  # Mapping of movement actions (assume grid rows = x, cols = y)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_to_action = {\n      (1, 0): ACTION_DOWN,\n      (-1, 0): ACTION_UP,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT,\n  }\n\n  # Reset environment to obtain initial state\n  obs = env.reset()\n  state = env._current_state\n  grid = state.grid\n  pos = state.pos\n\n  # Goal: make an arrow\n  goal_idx = _kind_idx('arrow')\n  # Primitive requirements for one arrow\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  needed = {k: v for k, v in recipe.items() if k != '_key'}\n  workshop_kind = recipe.get('_key')  # workshop where arrow is crafted\n\n  # Set of indices that block movement (non\u2011grabbable entities)\n  block_set = env.world.non_grabbable_indices\n\n  # Function to test if a cell is walkable\n  def _walkable(x, y):\n      if x < 0 or x >= grid.shape[0] or y < 0 or y >= grid.shape[1]:\n          return False\n      # blocked if any non\u2011grabbable kind is present\n      return not any(grid[x, y, idx] > 0 for idx in block_set)\n\n  # BFS to compute a path (as list of actions) from current pos to target cell\n  from collections import deque\n\n  def _bfs_path(start, target):\n      if start == target:\n          return []\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for dx, dy in [(1, 0), (-1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if _walkable(nx, ny) and (nx, ny) not in came_from:\n                  came_from[(nx, ny)] = (cur, (dx, dy))\n                  q.append((nx, ny))\n      # reconstruct actions\n      if target not in came_from:\n          return []  # no path found\n      actions = []\n      cur = target\n      while came_from[cur] is not None:\n          prev, move = came_from[cur]\n          actions.append(move_to_action[move])\n          cur = prev\n      actions.reverse()\n      return actions\n\n  # Main planning loop\n  actions_seq = []\n  max_steps = 1000  # safety guard\n  while not state.satisfies('', goal_idx) and len(actions_seq) < max_steps:\n      inventory = state.inventory\n      # Check if we have enough primitives to craft\n      have_all = True\n      for prim_idx, cnt in needed.items():\n          if inventory[prim_idx] < cnt:\n              have_all = False\n              break\n\n      if have_all:\n          # Go to workshop and craft\n          # Find any workshop cell of the required kind\n          ws_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n          if ws_cells.size == 0:\n              break  # cannot find workshop\n          # choose nearest workshop\n          dists = np.sum(np.abs(ws_cells - np.array(state.pos)), axis=1)\n          target = tuple(ws_cells[dists.argmin()])\n          actions_seq += _bfs_path(state.pos, target)\n          # execute moves\n          for a in actions_seq[-len(_bfs_path(state.pos, target)):]:\n              _, state = env.step(a)\n          # use (craft)\n          actions_seq.append(ACTION_USE)\n          _, state = env.step(ACTION_USE)\n      else:\n          # Find a primitive we still need\n          missing = None\n          for prim_idx, cnt in needed.items():\n              if inventory[prim_idx] < cnt:\n                  missing = prim_idx\n                  break\n          if missing is None:\n              break\n          # locate nearest primitive of this kind\n          prim_cells = np.argwhere(grid[:, :, missing] > 0)\n          if prim_cells.size == 0:\n              break  # cannot find needed primitive\n          dists = np.sum(np.abs(prim_cells - np.array(state.pos)), axis=1)\n          target = tuple(prim_cells[dists.argmin()])\n          actions_seq += _bfs_path(state.pos, target)\n          # execute moves\n          for a in actions_seq[-len(_bfs_path(state.pos, target)):]:\n              _, state = env.step(a)\n          # pick up primitive\n          actions_seq.append(ACTION_USE)\n          _, state = env.step(ACTION_USE)\n\n  return actions_seq", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
