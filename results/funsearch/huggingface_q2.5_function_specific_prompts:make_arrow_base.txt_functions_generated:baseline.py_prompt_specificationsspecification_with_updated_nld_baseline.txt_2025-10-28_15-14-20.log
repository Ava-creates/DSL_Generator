{"timestamp": "2025-10-28T19:21:55.094647", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices as defined in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell orthogonally adjacent to any cell in `targets`.\n  # Cells where `occ` is True are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent (Manhattan distance == 1) to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell.\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: apply a list of actions to a position.\n  # ------------------------------------------------------------------\n  def _apply_actions(pos, actions):\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its Cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state; reset the environment if needed.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal: make an \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal (primitive index \u2192 count).\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # Working copies for planning.\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # (W, H, n_kinds)\n  occ = np.any(grid, axis=2)           # occupied mask (bool)\n\n  plan_actions = []\n  harvested = set()                    # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # All cells currently containing this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed_cnt:\n              break\n          if cell in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_adjacent(pos, [cell], occ)\n          plan_actions.extend(path)\n          pos = _apply_actions(pos, path)\n\n          # Pick it up.\n          plan_actions.append(USE)\n\n          # Update planning structures: remove the primitive from the cell.\n          grid[cell[0], cell[1], prim_idx] = 0\n          occ = np.any(grid, axis=2)   # recompute occupied mask\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Go to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string or already an int).\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          # Choose the nearest workshop cell.\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], occ)\n          plan_actions.extend(path)\n          pos = _apply_actions(pos, path)\n          plan_actions.append(USE)   # craft at workshop\n      else:\n          # No visible workshop; attempt to craft in place.\n          plan_actions.append(USE)\n  else:\n      # No specific workshop required.\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:21:56.222931", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_adjacent(start, targets, blocked):\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def _apply(pos, actions):\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # locate world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ensure we have a current state; reset if needed\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # primitive requirements for the goal\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # (W, H, n_kinds)\n  blocked = np.any(grid, axis=2)       # occupied mask (bool)\n\n  plan_actions = []\n  harvested = set()                    # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # locate all cells currently containing this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed_cnt:\n              break\n          if cell in harvested:\n              continue\n          # move adjacent to the primitive\n          path = _bfs_adjacent(pos, [cell], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n\n          # pick it up\n          plan_actions.append(USE)\n\n          # update planning structures\n          grid[cell[0], cell[1], prim_idx] = 0\n          blocked = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], blocked)\n          plan_actions.extend(path)\n          pos = _apply(pos, path)\n          plan_actions.append(USE)\n      else:\n          # no visible workshop; attempt to craft in place\n          plan_actions.append(USE)\n  else:\n      # no specific workshop required\n      plan_actions.append(USE)\n\n  return plan_actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:22:30.324242", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and fetch current state/world information\n  env.reset()\n  state = env._current_state\n  world = env.world\n  # Work on a mutable copy of the grid so we can mark collected items\n  grid = state.grid.copy()\n\n  # Index of the goal item (arrow) and the primitive requirements for one arrow\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  # Helper: Manhattan\u2011distance path (vertical then horizontal)\n  def manhattan_path(start, goal):\n      y, x = start\n      gy, gx = goal\n      actions = []\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  # Helper: locate the nearest cell containing a given kind\n  def nearest_cell(kind, from_pos):\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  # Helper: pick a free adjacent cell (not occupied by non\u2011grabbable entities)\n  def free_adjacent(target):\n      ty, tx = target\n      for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      # Fallback: use the target cell itself (assumed walkable)\n      return target\n\n  actions = []\n  cur = state.pos  # current agent position (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          # Find nearest remaining primitive of this type\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # No more items of this kind \u2013 abort early\n              return actions\n\n          # Choose a free cell next to the primitive to stand on\n          stand_pos = free_adjacent(prim_loc)\n\n          # Move to the standing position\n          actions += manhattan_path(cur, stand_pos)\n          cur = stand_pos\n\n          # Determine the direction needed to step onto the primitive cell\n          dy = prim_loc[0] - cur[0]\n          dx = prim_loc[1] - cur[1]\n          if dy == 1:\n              actions.append(DOWN)\n              cur = (cur[0] + 1, cur[1])\n          elif dy == -1:\n              actions.append(UP)\n              cur = (cur[0] - 1, cur[1])\n          elif dx == 1:\n              actions.append(RIGHT)\n              cur = (cur[0], cur[1] + 1)\n          elif dx == -1:\n              actions.append(LEFT)\n              cur = (cur[0], cur[1] - 1)\n          else:\n              # Already on the primitive cell (unlikely but handled)\n              pass\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Mark the primitive as collected in our local grid copy\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          actions += manhattan_path(cur, ws_loc)\n          cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:22:31.453055", "function_name": "make_arrow", "function_body": "  import numpy as np\n  # action indices (consistent with CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # reset environment to start fresh\n  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index('arrow')\n  # primitive requirements for one arrow\n  needed = world.cookbook.primitives_for(arrow_idx)\n\n  # ------------------------------------------------------------\n  # helper functions\n  # ------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of actions moving from start to goal using Manhattan moves.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def locate_all(kind):\n      \"\"\"Return a list of (y,x) positions where `kind` is present in the grid.\"\"\"\n      positions = np.argwhere(grid[:, :, kind] > 0)\n      return [tuple(p) for p in positions]\n\n  def nearest_position(positions, from_pos):\n      \"\"\"Select the position with minimal Manhattan distance from `from_pos`.\"\"\"\n      if not positions:\n          return None\n      dists = [abs(p[0] - from_pos[0]) + abs(p[1] - from_pos[1]) for p in positions]\n      return positions[int(np.argmin(dists))]\n\n  def free_adjacent(cell):\n      \"\"\"Return a free (empty) neighbour of `cell` if any, else None.\"\"\"\n      y, x = cell\n      h, w = grid.shape[0], grid.shape[1]\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < h and 0 <= nx < w:\n              if not np.any(grid[ny, nx, :]):  # completely empty\n                  return (ny, nx)\n      return None\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------\n  # collect each required primitive\n  # ------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate nearest instance of the primitive\n          prim_positions = locate_all(prim_idx)\n          target = nearest_position(prim_positions, cur_pos)\n          if target is None:\n              # cannot find required primitive \u2013 stop early\n              return actions\n          # move to a free cell adjacent to the primitive\n          adj = free_adjacent(target)\n          if adj is None:\n              # fallback: stand on the primitive cell itself (may be impossible)\n              adj = target\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n          # after arriving, the last movement direction points toward the primitive,\n          # so a single USE is sufficient\n          actions.append(USE)\n\n  # ------------------------------------------------------------\n  # move to the workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_positions = locate_all(ws_idx)\n      ws_target = nearest_position(ws_positions, cur_pos)\n      if ws_target is not None:\n          ws_adj = free_adjacent(ws_target)\n          if ws_adj is None:\n              ws_adj = ws_target\n          actions += manhattan_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n  # final USE to perform the crafting action\n  actions.append(USE)\n\n  return actions", "env_interactions": 25, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T19:22:51.662894", "function_name": "make_arrow", "function_body": "  # Attempt to use the most recent implementation first.\n  # If it fails (e.g., missing attributes), fall back to older versions.\n  for _make in (make_arrow_v1, make_arrow_v0):\n      try:\n          return _make(env)\n      except Exception:\n          # Continue trying the next implementation.\n          continue\n  # If none of the implementations succeeded, raise an informative error.\n  raise RuntimeError(\"Unable to generate actions for making an arrow with the provided environment.\")", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T19:22:52.793707", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Action identifiers \u2013 match the default CraftWorld action ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  The search treats any non\u2011empty cell as blocked, except\n  # the target cells themselves (we only need to get next to them).\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Quick check \u2013 already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Can step on the cell if it is empty\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              # Check adjacency to any target after the move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell \u2013 return empty list (caller may fail later)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Retrieve world / cookbook information.\n  # ----------------------------------------------------------------------\n  # The environment may expose the world directly or via the current state.\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # Ensure we have a state object for position / grid.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for one arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  # If the goal has no recipe (already primitive), just return an empty list.\n  if not primitives_needed:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Current grid / position.\n  # ----------------------------------------------------------------------\n  grid = state.grid  # shape (W, H, n_kinds)\n  pos = tuple(state.pos)  # (x, y)\n\n  # Occupancy mask \u2013 True where any entity (including primitives) exists.\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []\n  harvested = set()  # locations already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells currently containing this primitive.\n          prim_locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          # Exclude locations already used.\n          prim_locs = [loc for loc in prim_locs if loc not in harvested]\n          if not prim_locs:\n              # No more primitives of this type on the map \u2013 abort.\n              break\n          # Choose the nearest location (Manhattan distance).\n          prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = prim_locs[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Perform USE to pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # After picking up, the cell becomes empty \u2013 update occupancy.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at the required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Locate workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use to craft.\n          actions.append(USE)\n      else:\n          # No workshop of required type found \u2013 fallback to using current cell.\n          actions.append(USE)\n  else:\n      # Recipe does not specify a workshop; simply USE at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:23:24.379541", "function_name": "make_arrow", "function_body": "  # reset environment and get handles\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # helper functions\n  # ------------------------------------------------------------------\n  def is_walkable(y, x):\n      \"\"\"Cell is walkable if inside bounds and either empty or a workshop.\"\"\"\n      if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):\n          return False\n      # workshop cells are allowed to stand on\n      if world.cookbook.index.get('_at') and (y, x) in workshop_cells_set:\n          return True\n      # any non\u2011grabbable entity blocks movement\n      if np.any(grid[y, x, list(world.non_grabbable_indices)] > 0):\n          return False\n      # any other entity (including primitives) also blocks movement\n      if np.any(grid[y, x] > 0):\n          return False\n      return True\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.\n      Uses 4\u2011connected BFS on walkable cells. If no path, returns empty list.\"\"\"\n      if start == goal:\n          return []\n      q = collections.deque()\n      q.append(start)\n      visited = {start: None}\n      while q:\n          y, x = q.popleft()\n          for dy, dx, a in DIRS:\n              ny, nx = y + dy, x + dx\n              if not is_walkable(ny, nx):\n                  continue\n              if (ny, nx) not in visited:\n                  visited[(ny, nx)] = (y, x, a)\n                  if (ny, nx) == goal:\n                      # reconstruct path\n                      path_actions = []\n                      cur = (ny, nx)\n                      while visited[cur] is not None:\n                          py, px, act = visited[cur]\n                          path_actions.append(act)\n                          cur = (py, px)\n                      return list(reversed(path_actions))\n                  q.append((ny, nx))\n      return []  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing `kind_idx` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_walkable(target, from_pos):\n      \"\"\"Pick a walkable neighbour of `target` (prefer the one closest to `from_pos`).\"\"\"\n      candidates = []\n      ty, tx = target\n      for dy, dx, _ in DIRS:\n          ny, nx = ty + dy, tx + dx\n          if is_walkable(ny, nx):\n              manh = abs(ny - from_pos[0]) + abs(nx - from_pos[1])\n              candidates.append((manh, (ny, nx)))\n      if not candidates:\n          # fallback: maybe we can stand on the target itself (unlikely)\n          if is_walkable(ty, tx):\n              return (ty, tx)\n          return None\n      candidates.sort()\n      return candidates[0][1]\n\n  # ------------------------------------------------------------------\n  # locate workshop cells once (used by is_walkable)\n  # ------------------------------------------------------------------\n  workshop_cells = []\n  for ws_idx in world.workshop_indices:\n      ws_cells = np.argwhere(grid[:, :, ws_idx] > 0)\n      workshop_cells.extend([tuple(c) for c in ws_cells])\n  workshop_cells_set = set(workshop_cells)\n\n  # ------------------------------------------------------------------\n  # recipe information for the arrow\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          prim_cell = find_nearest(prim_idx, cur_pos)\n          if prim_cell is None:\n              # primitive not present \u2013 give up early\n              return actions\n          # choose a walkable neighbour to stand on\n          stand_cell = adjacent_walkable(prim_cell, cur_pos)\n          if stand_cell is None:\n              # cannot reach primitive, abort\n              return actions\n          # move to the chosen cell\n          actions += bfs_path(cur_pos, stand_cell)\n          cur_pos = stand_cell\n\n          # face the primitive: issue a move towards it (will stay if blocked)\n          dy = prim_cell[0] - cur_pos[0]\n          dx = prim_cell[1] - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n\n          # pick it up\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # go to workshop (if required) and craft\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # final USE to trigger crafting of the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
