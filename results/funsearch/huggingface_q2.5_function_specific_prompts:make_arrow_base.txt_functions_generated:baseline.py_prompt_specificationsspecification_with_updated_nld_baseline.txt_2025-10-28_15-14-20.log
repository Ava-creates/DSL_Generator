{"timestamp": "2025-10-28T20:48:19.165415", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 actions (0\u20114)\n\n  # Prefer the USE action (index 4) before movement actions\n  action_order = [4] + [a for a in range(n_actions) if a != 4]\n\n  # (Optional) fetch primitive requirements for future pruning\n  try:\n      _ = world.cookbook.primitives_for(target_idx)\n  except Exception:\n      pass\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand actions in the chosen order\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:48:34.977992", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Obtain the scenario and world objects from the supplied environment.\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []                     # cannot proceed without a world\n\n  # ----------------------------------------------------------------------\n  # Resolve the index of the target item \u201carrow\u201d.  If the recipe does not\n  # contain this item we abort early.\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise the start state of the episode.\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: produce a hashable representation of a CraftState for the\n  # visited set.  Grid is converted to bytes (fast & deterministic) and the\n  # inventory is turned into a tuple.\n  # ----------------------------------------------------------------------\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # ----------------------------------------------------------------------\n  # BFS infrastructure.\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Upper bound on the number of actions we will explore.  The bound is\n  # deliberately generous \u2013 the environments are small and the search\n  # space is limited.\n  MAX_STEPS = 1500\n  n_actions = getattr(world, \"n_actions\", 5)   # default action space size\n\n  # Prefer the USE action (index 4) before movement actions; this tends to\n  # reduce the branching factor early on because collecting / crafting\n  # consumes the USE action.\n  action_order = [4] + [a for a in range(n_actions) if a != 4]\n\n  # ----------------------------------------------------------------------\n  # Main BFS loop.\n  # ----------------------------------------------------------------------\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test \u2013 we succeed as soon as the inventory contains at least one\n      # arrow.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long partial plans.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all actions in the chosen order.\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # ----------------------------------------------------------------------\n  # No plan discovered within the search limits \u2013 return an empty plan.\n  # ----------------------------------------------------------------------\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
