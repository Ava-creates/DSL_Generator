{"timestamp": "2025-10-28T23:34:24.011307", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve scenario and world objects (they may be wrapped in different ways)\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Identify the integer index for the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:  # missing index or recipe\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise the starting CraftState\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search over the state space to find a sequence of actions\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,                     # (x, y) tuple\n          st.dir,                     # facing direction (int)\n          tuple(st.inventory.tolist()),  # inventory counts\n          st.grid.tobytes(),          # full grid occupancy\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  # Safety limits \u2013 avoid endless exploration\n  MAX_STEPS = 400          # maximum plan length we are willing to search\n  MAX_NODES = 200000       # cap on total expanded nodes\n\n  # Number of actions the environment understands (standard: 0\u20114)\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  nodes_expanded = 0\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test \u2013 do we already have an arrow in the inventory?\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Depth/size limits\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n      if nodes_expanded >= MAX_NODES:\n          break\n      nodes_expanded += 1\n\n      # Expand neighbours by trying every possible action\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the limits \u2013 return empty list as a fallback\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:34:46.694812", "function_name": "make_arrow", "function_body": "  # Action indices (standard in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any of\n  # `targets`. Cells containing any non\u2011zero kind are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where any entity exists\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent to a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal is hard\u2011coded to \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Working copies of position and grid for planning.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)          # (x, y)\n  cur_grid = state.grid.copy()    # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells currently containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Greedy order: nearest first.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive (or stay if already adjacent).\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update position following the path.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell empty for future planning.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index \u2013 may be a string name.\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Locate workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:34:47.864213", "function_name": "make_arrow", "function_body": "  # Action indices (standard for CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any of the\n  # `targets`. Cells that contain any non\u2011zero kind are treated as\n  # blocked for navigation.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where something blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the world and cookbook objects. They may be stored directly\n  # on the environment or inside a wrapped state object.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world through the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if needed).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal is hard\u2011coded to the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Working copies of position and grid for planning.\n  pos = tuple(state.pos)          # (x, y)\n  cur_grid = state.grid.copy()    # (W, H, n_kinds)\n\n  actions = []                    # final action list to return\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Greedy ordering: nearest first.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive (or stay if already adjacent).\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update internal position according to the path taken.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell as empty for subsequent planning.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve the workshop index (might be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Find all workshop cells currently present.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:35:10.945241", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (match CraftWorld ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from `start` to a cell adjacent to any target.\"\"\"\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Retrieve world, state and cookbook (handle possible wrappers)\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # Cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate remaining instances of this primitive.\n          candidates = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not candidates:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest candidate (Manhattan distance).\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          # Plan a path to an adjacent cell.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop present \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:35:12.077731", "function_name": "make_arrow", "function_body": "  # Action constants \u2013 match CraftWorld ordering.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions that moves from `start` to a cell adjacent to any of `targets`.\"\"\"\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Grab world, state and cookbook (handle possible wrappers).\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # Cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate remaining instances of the primitive.\n          candidates = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not candidates:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest candidate (Manhattan distance).\n          candidates.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = candidates[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for a in path:\n              dx, dy = MOVE_DELTAS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop present \u2013 use current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T23:35:39.415216", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Get the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over state space to find a plan\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Combine position, direction, inventory and grid layout into a hashable key\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Search limits\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)  # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain the arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:35:55.215458", "function_name": "make_arrow", "function_body": "  # Locate the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Combine position, direction, inventory and the full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Search limits\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)  # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain an arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T23:36:25.203146", "function_name": "make_arrow", "function_body": "  # Obtain the scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\" in the cookbook\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space to find a plan\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_STEPS = 500                     # depth limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
