{"timestamp": "2025-10-28T20:32:29.674206", "function_name": "make_arrow", "function_body": "  # Import needed modules locally\n  import collections\n  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Action constants \u2013 match default CraftWorld ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells that contain any entity are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Obtain world, state and cookbook from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is a primitive \u2013 just use (no movement needed).\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # locations already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells holding this primitive that haven't been used.\n          prim_locs = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_locs:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = prim_locs[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Update simulated position.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Cell becomes empty \u2013 update occupancy mask.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Locate all workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft\n      else:\n          # No workshop found \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:32:52.778299", "function_name": "make_arrow", "function_body": "  # reset environment and grab useful references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk\n      from ``start`` to ``goal`` using a simple Manhattan route.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing ``kind_idx`` (primitive or\n      workshop). Returns (y, x) or ``None`` if not present.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def choose_adjacent(target):\n      \"\"\"Pick a free orthogonal neighbour of ``target``; if none are free,\n      return ``target`` itself.\"\"\"\n      ty, tx = target\n      h, w = grid.shape[:2]\n      for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n          if 0 <= ny < h and 0 <= nx < w:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Determine primitives needed for the 'arrow' item\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the appropriate number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on before using\n          stand_pos = choose_adjacent(target)\n\n          # Move to that cell\n          actions += manhattan_path(cur_pos, stand_pos)\n          cur_pos = stand_pos\n\n          # Face the primitive (by attempting a move towards it)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick it up\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop required by the recipe (if any) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE triggers the crafting of the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:32:53.922268", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                   # CraftWorld\n  # Make a mutable copy of the grid to track collected items\n  grid = np.copy(state.grid)\n\n  # Action indices (consistent with CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk\n      from ``start`` to ``goal`` using a simple Manhattan route.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that currently contains ``kind_idx``.\n      Returns a tuple (y, x) or ``None`` if no such cell exists.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free (non\u2011non\u2011grabbable) adjacent coordinate to ``cell``.\n      Preference order: up, down, left, right. If none are free, return the\n      original cell.\"\"\"\n      y, x = cell\n      candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return cell\n\n  # ------------------------------------------------------------------\n  # Determine primitives needed for an arrow\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on before using.\n          stand_pos = free_adjacent(target)\n\n          # Move to the chosen standing position.\n          actions += manhattan_path(cur_pos, stand_pos)\n          cur_pos = stand_pos\n\n          # Adjust direction to face the primitive (if not standing on it).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update the mutable grid to reflect that the primitive has been taken.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:33:17.768221", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # Cells that are occupied by any entity\n  occupied = np.any(grid > 0, axis=2)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path (as actions) from start to goal avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {start: (None, None)}  # (prev_cell, action_to_here)\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              break\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not occupied[ny, nx] and (ny, nx) not in visited:\n                      visited.add((ny, nx))\n                      parent[(ny, nx)] = ((y, x), act)\n                      q.append((ny, nx))\n\n      if goal not in parent:\n          return []  # no path found\n\n      # Reconstruct actions\n      actions = []\n      cur = goal\n      while parent[cur][0] is not None:\n          prev, act = parent[cur]\n          actions.append(act)\n          cur = prev\n      actions.reverse()\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return coordinates of the nearest cell containing `kind_idx`.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine primitives needed for an 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on.\n          adj = None\n          for dy, dx, _ in DIRS:\n              ny, nx = ty + dy, tx + dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not occupied[ny, nx]:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (best\u2011effort) by moving one step toward it.\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T20:33:18.913130", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state information\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (match CraftLab.action_specs())\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Cells that are currently occupied by any entity (including obstacles)\n  occupied = np.any(grid > 0, axis=2)\n\n  # Direction deltas together with the corresponding action index\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` while avoiding occupied cells.\n      If no path exists, returns an empty list.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {start: (None, None)}  # (previous cell, action taken to reach this cell)\n\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx, a in DIRS:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if (ny, nx) not in visited and not occupied[ny, nx]:\n                      visited.add((ny, nx))\n                      parent[(ny, nx)] = (cur, a)\n                      q.append((ny, nx))\n\n      if goal not in parent:\n          return []  # No reachable path\n\n      # Reconstruct action sequence\n      actions_rev = []\n      cur = goal\n      while parent[cur][0] is not None:\n          prev, act = parent[cur]\n          actions_rev.append(act)\n          cur = prev\n      actions_rev.reverse()\n      return actions_rev\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that contains the given kind index.\n      Returns (y, x) tuple or None if not found.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine primitives required to craft an 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # current agent position (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          # Locate the nearest instance of this primitive\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on (prefer empty)\n          adj = None\n          for dy, dx, _ in DIRS:\n              ny, nx = ty + dy, tx + dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not occupied[ny, nx]:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself\n              adj = target\n\n          # Move to the chosen adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (best\u2011effort) by moving one step towards it\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n          # If already on the same cell, direction does not matter\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE action to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T20:34:01.360293", "function_name": "make_arrow", "function_body": "  # Reset environment and extract useful references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)\n\n  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_free(cell):\n      \"\"\"Return True if `cell` is inside the grid and not blocked by a\n      non\u2011grabbable entity.\"\"\"\n      y, x = cell\n      if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):\n          return False\n      # Any non\u2011grabbable entity present?\n      occupied = np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n      return not occupied\n\n  def free_adjacent(target):\n      \"\"\"Find a free orthogonal neighbour of `target`. Return None if none.\"\"\"\n      ty, tx = target\n      for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ny, nx = ty + dy, tx + dx\n          if is_free((ny, nx)):\n              return (ny, nx)\n      return None\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of actions (DOWN/UP/LEFT/RIGHT) that moves from\n      `start` to `goal` using BFS while avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return []\n\n      from collections import deque\n      queue = deque([start])\n      # map position -> (parent_position, action_taken_to_reach)\n      parent = {start: (None, None)}\n\n      while queue:\n          cur = queue.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for (dy, dx), act in [((-1, 0), UP), ((1, 0), DOWN),\n                                ((0, -1), LEFT), ((0, 1), RIGHT)]:\n              ny, nx = y + dy, x + dx\n              nxt = (ny, nx)\n              if not is_free(nxt):\n                  continue\n              if nxt not in parent:\n                  parent[nxt] = (cur, act)\n                  queue.append(nxt)\n\n      if goal not in parent:\n          # unreachable \u2013 return empty list\n          return []\n\n      # reconstruct actions\n      actions_rev = []\n      cur = goal\n      while parent[cur][0] is not None:\n          prev, act = parent[cur]\n          actions_rev.append(act)\n          cur = prev\n      actions_rev.reverse()\n      return actions_rev\n\n  def turn_towards(src, dst):\n      \"\"\"Return a single turn action that makes `src` face `dst` (must be orthogonal).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None  # same cell or not orthogonal\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell that contains an entity of `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine goal and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in needed_prims.items():\n      for _ in range(needed_cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = free_adjacent(target)\n          if adj is None:\n              # If no free neighbour, try standing on the primitive itself\n              if is_free(target):\n                  adj = target\n              else:\n                  # Unable to access this primitive; skip it.\n                  continue\n\n          # Move to the selected adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Turn towards the primitive (if we are not on the same cell).\n          turn_act = turn_towards(cur_pos, target)\n          if turn_act is not None:\n              actions.append(turn_act)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid copy to reflect that the primitive has been taken.\n          ty, tx = target\n          grid[ty, tx, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:34:02.490114", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state            # CraftState\n  world = env.world                     # CraftWorld\n  grid = state.grid.copy()              # (W, H, n_kinds)\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  moves = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goals):\n      \"\"\"Bread\u2011first search from start to any cell in *goals*.\n      Returns a list of actions (DOWN/UP/LEFT/RIGHT) to reach the first\n      reachable goal, or an empty list if none reachable.\"\"\"\n      H, W = grid.shape[0], grid.shape[1]\n      q = collections.deque()\n      q.append(start)\n      visited = {start: (None, None)}  # pos -> (parent_pos, action)\n      goal_set = set(goals)\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) in goal_set:\n              # reconstruct path\n              actions = []\n              cur = (y, x)\n              while visited[cur][0] is not None:\n                  parent, act = visited[cur]\n                  actions.append(act)\n                  cur = parent\n              actions.reverse()\n              return actions\n          for dy, dx, act in moves:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W:\n                  if (ny, nx) in visited:\n                      continue\n                  # cell is free if no entity occupies it\n                  if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      continue\n                  visited[(ny, nx)] = ((y, x), act)\n                  q.append((ny, nx))\n      return []  # no reachable goal\n\n  def nearest_cells_of(kind_idx, from_pos):\n      \"\"\"Return list of free cells adjacent to any occurrence of *kind_idx*.\"\"\"\n      occ = np.argwhere(grid[:, :, kind_idx] > 0)\n      cells = set()\n      H, W = grid.shape[0], grid.shape[1]\n      for (y, x) in occ:\n          for dy, dx, _ in moves:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W:\n                  # free cell?\n                  if not np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      cells.add((ny, nx))\n      return list(cells)\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Find reachable adjacent cell to the nearest primitive of this type\n          candidate_cells = nearest_cells_of(prim_idx, cur_pos)\n          if not candidate_cells:\n              # No reachable primitive \u2013 abort early\n              return actions\n          path = bfs_path(cur_pos, candidate_cells)\n          if not path:\n              # Unreachable\n              return actions\n          actions.extend(path)\n          # Update current position after following the path\n          for act in path:\n              if act == DOWN:\n                  cur_pos = (cur_pos[0] + 1, cur_pos[1])\n              elif act == UP:\n                  cur_pos = (cur_pos[0] - 1, cur_pos[1])\n              elif act == LEFT:\n                  cur_pos = (cur_pos[0], cur_pos[1] - 1)\n              elif act == RIGHT:\n                  cur_pos = (cur_pos[0], cur_pos[1] + 1)\n\n          # At this point we stand on a free cell adjacent to the primitive.\n          # Use the primitive.\n          actions.append(USE)\n\n          # Remove the primitive from the grid (simulate collection)\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size > 0:\n              # take the first one (the one we were adjacent to)\n              y, x = prim_cells[0]\n              grid[y, x, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_adj_cells = nearest_cells_of(ws_idx, cur_pos)\n      if ws_adj_cells:\n          ws_path = bfs_path(cur_pos, ws_adj_cells)\n          actions.extend(ws_path)\n          # update position after moving to workshop adjacency\n          for act in ws_path:\n              if act == DOWN:\n                  cur_pos = (cur_pos[0] + 1, cur_pos[1])\n              elif act == UP:\n                  cur_pos = (cur_pos[0] - 1, cur_pos[1])\n              elif act == LEFT:\n                  cur_pos = (cur_pos[0], cur_pos[1] - 1)\n              elif act == RIGHT:\n                  cur_pos = (cur_pos[0], cur_pos[1] + 1)\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T20:34:33.200162", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state from which we will plan\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a state.\"\"\"\n      # Position, direction, inventory, and the grid occupancy\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default: 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:34:48.854381", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state from which we will plan\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a state.\"\"\"\n      # Position, direction, inventory, and the grid occupancy\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default: 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:35:18.401865", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the goal item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper that creates a hashable representation of a state\n  def _state_key(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  frontier = deque([Node(start_state, [])])\n  visited = {_state_key(start_state)}\n\n  MAX_STEPS = 300          # limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the step limit\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:35:34.436469", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Starting state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  def _hash_state(st):\n      # Combine position, direction, inventory and a hash of the grid\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  frontier = deque([Node(start_state, [])])\n  visited = {_hash_state(start_state)}\n\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:36:02.919279", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Action indices (as defined by CraftLab.action_specs)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  height, width = grid.shape[0], grid.shape[1]\n\n  def delta_to_action(dy, dx):\n      \"\"\"Convert a single\u2011step delta to the corresponding action.\"\"\"\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      raise ValueError(\"Invalid delta for movement\")\n\n  def bfs(start, goal_cells):\n      \"\"\"\n      Breadth\u2011first search from ``start`` to the nearest cell in ``goal_cells``.\n      ``goal_cells`` is a set of (y, x) tuples that are acceptable destinations.\n      Returns a list of positions from start (excluded) to the chosen goal (included),\n      or None if no path exists.\n      \"\"\"\n      from collections import deque\n\n      # cells that are blocked for movement: any non\u2011grabbable entity\n      blocked_kinds = list(world.non_grabbable_indices)\n\n      visited = np.full((height, width), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) in goal_cells:\n              return path  # path does NOT include the goal cell itself\n\n          for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < height and 0 <= nx < width and not visited[ny, nx]:\n                  # a cell is traversable if it has no non\u2011grabbable entity\n                  if not np.any(grid[ny, nx, blocked_kinds] > 0):\n                      visited[ny, nx] = True\n                      q.append(((ny, nx), path + [(ny, nx)]))\n      return None\n\n  def nearest_positions(kind_idx, from_pos):\n      \"\"\"\n      Return a list of positions that contain ``kind_idx``.\n      \"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      return [tuple(p) for p in locs]\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for 'arrow' and its primitive requirements\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          # Find all cells containing the primitive\n          prim_cells = nearest_positions(prim_idx, cur_pos)\n          if not prim_cells:\n              # Primitive not present \u2013 abort planning.\n              return actions\n\n          # For each primitive cell, consider the four adjacent free cells as\n          # possible standing positions.\n          candidate_goals = set()\n          prim_to_adj = {}   # map from adjacent cell -> primitive cell it serves\n          for py, px in prim_cells:\n              for ay, ax in ((py - 1, px), (py + 1, px), (py, px - 1), (py, px + 1)):\n                  if 0 <= ay < height and 0 <= ax < width:\n                      # cell must be free of non\u2011grabbable objects\n                      if not np.any(grid[ay, ax, list(world.non_grabbable_indices)] > 0):\n                          candidate_goals.add((ay, ax))\n                          prim_to_adj.setdefault((ay, ax), []).append((py, px))\n\n          # If no free neighbour, we will stand directly on the primitive cell\n          if not candidate_goals:\n              candidate_goals = {tuple(loc) for loc in prim_cells}\n              for cell in candidate_goals:\n                  prim_to_adj.setdefault(cell, []).append(cell)\n\n          # Find a path to the nearest reachable goal cell\n          path = bfs(cur_pos, candidate_goals)\n          if path is None:\n              # No reachable position \u2013 abort planning.\n              return actions\n\n          # Translate the path into actions\n          for nxt in path:\n              dy = nxt[0] - cur_pos[0]\n              dx = nxt[1] - cur_pos[1]\n              actions.append(delta_to_action(dy, dx))\n              cur_pos = nxt\n\n          # Now we are on a cell adjacent (or on) the primitive.\n          # Choose the associated primitive cell to face.\n          target_prim = prim_to_adj[cur_pos][0]  # pick the first linked primitive\n          ty, tx = target_prim\n\n          # Face the primitive (add a single movement action towards it; it will be\n          # blocked if the primitive occupies the cell, which correctly sets direction)\n          dy = ty - cur_pos[0]\n          dx = tx - cur_pos[1]\n          if dy != 0 or dx != 0:\n              actions.append(delta_to_action(dy, dx))\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_cells = nearest_positions(workshop_idx, cur_pos)\n      if workshop_cells:\n          goal_set = set(workshop_cells)\n          path = bfs(cur_pos, goal_set)\n          if path is not None:\n              for nxt in path:\n                  dy = nxt[0] - cur_pos[0]\n                  dx = nxt[1] - cur_pos[1]\n                  actions.append(delta_to_action(dy, dx))\n                  cur_pos = nxt\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T20:36:04.280292", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh start.\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Action indices (as defined by the environment's action specs)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks\n      from ``start`` to ``goal`` using Manhattan distance only.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind, from_pos, planning_grid):\n      \"\"\"Find the nearest cell that currently contains ``kind`` in the\n      given planning grid. Returns (y, x) or ``None`` if not present.\"\"\"\n      locations = np.argwhere(planning_grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locations[nearest_idx])\n\n  def is_free_cell(y, x, planning_grid):\n      \"\"\"Return True if the cell (y, x) does not contain any non\u2011grabbable\n      entity (e.g., water, stone). Grabbable primitives are allowed.\"\"\"\n      if not (0 <= y < planning_grid.shape[0] and 0 <= x < planning_grid.shape[1]):\n          return False\n      occupied = np.any(planning_grid[y, x, list(world.non_grabbable_indices)] > 0)\n      return not occupied\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for 'arrow' and the required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # Work on a mutable copy of the grid so we can \u201cremove\u201d collected items.\n  planning_grid = grid.copy()\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos, planning_grid)\n          if target is None:\n              # Primitive not available \u2013 abort planning.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n              if is_free_cell(ny, nx, planning_grid):\n                  adj = (ny, nx)\n                  break\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell itself.\n              adj = (ty, tx)\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (direction that would move into it).\n          dy = ty - cur_pos[0]\n          dx = tx - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update the planning grid to reflect that the primitive has been taken.\n          planning_grid[ty, tx, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos, planning_grid)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:36:29.845302", "function_name": "make_arrow", "function_body": "  # reset environment and grab current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # action indices (use the lab's mapping if available)\n  try:\n      specs = env.action_specs()\n      DOWN = specs['DOWN']\n      UP = specs['UP']\n      LEFT = specs['LEFT']\n      RIGHT = specs['RIGHT']\n      USE = specs['USE']\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk\n      from ``start`` to ``goal`` using a simple Manhattan route.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that contains ``kind_idx`` (primitive or\n      workshop). Returns a (y, x) tuple or ``None`` if not found.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine primitives required for the 'arrow' item\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Pick a free adjacent cell to stand on (prefer empty).\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  # cell is empty if no kind is present\n                  if not np.any(grid[ny, nx, :] > 0):\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No empty neighbour \u2013 stand on the primitive cell itself.\n              adj = (ty, tx)\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (by attempting a move towards it; if blocked,\n          # the agent stays but direction updates).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:36:30.959376", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Action indices (standard ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions that walk from ``start`` to ``goal``.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the goal item ('arrow')\n  # ------------------------------------------------------------------\n  goal_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # current (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on (prefer empty).\n          stand = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      stand = (ny, nx)\n                      break\n          if stand is None:\n              # No free neighbour; stand on the primitive cell itself.\n              stand = target\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (by moving towards it; direction changes even if blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:36:58.156980", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup: reset environment and retrieve necessary objects\n  # ----------------------------------------------------------------------\n  # Action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and pull out the current state and world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n\n  # Work on a mutable copy of the grid for planning purposes\n  grid = state.grid.copy()\n\n  # ----------------------------------------------------------------------\n  # Goal information: index of the target item and its primitive needs\n  # ----------------------------------------------------------------------\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Set of entity kinds that block movement (non\u2011grabbable)\n  non_grabbable = list(world.non_grabbable_indices)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grabbable] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Return the shortest walkable path (list of positions) from start to goal.\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      from collections import deque\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # Reconstruct the path backwards from goal to start\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell containing the given kind (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (preferring N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback to the target itself if surrounded\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  cur = tuple(state.pos)   # current agent position (y, x)\n\n  # --------------------------------------------------------------\n  # 1) Collect all required primitives the necessary number of times\n  # --------------------------------------------------------------\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not present; abort planning.\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          if not path and cur != stand_pos:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself\n          path = bfs_path(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # --------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions([cur] + path))\n              cur = ws_loc\n\n  # Final USE to perform the crafting action\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:36:59.288977", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices used by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and get the current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal: arrow\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  non_grab = list(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Return shortest walkable path from start to goal (excluding start).\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path (excluding start)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell containing ``kind`` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = tuple(state.pos)   # current agent position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to the primitive cell\n          path = bfs_path(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, move there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions([cur] + path))\n              cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T20:37:25.140467", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  _DELTA = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  def _bfs_path(start, targets, cur_grid):\n      \"\"\"Return a list of actions moving from `start` to a cell adjacent to any `targets`.\"\"\"\n      w, h, _ = cur_grid.shape\n      occupied = np.any(cur_grid > 0, axis=2)  # any non\u2011zero kind blocks movement\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency to any target (Manhattan distance \u2264 1)\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Expand neighbours\n          for act, (dx, dy) in _DELTA.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position\n      return []\n\n  def _apply_path(pos, path):\n      \"\"\"Update a (x, y) position by applying a sequence of actions.\"\"\"\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the world and cookbook objects.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers keep the world inside the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot find CraftWorld instance in the provided environment.\")\n  cookbook = world.cookbook\n\n  # Goal is the item named \"arrow\".\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Order by distance from current position to reduce travel.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update planning grid: the cell is now empty.\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n      # Use action to craft the arrow (whether we moved to a workshop or not).\n      actions.append(USE)\n  else:\n      # No specific workshop required \u2013 simply use at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:37:26.268889", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices as defined in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, grid):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any target.\"\"\"\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)  # any non\u2011zero kind blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if adjacent (Manhattan distance <= 1) to any target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position.\n      return []\n\n  def _apply_path(pos, path):\n      \"\"\"Update (x, y) position by applying a sequence of actions.\"\"\"\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the world and cookbook objects.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers keep the world inside the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot find CraftWorld instance in the provided environment.\")\n  cookbook = world.cookbook\n\n  # Goal is the item named \"arrow\".\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Order by distance from current position to reduce travel.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          # Update planning grid: the cell is now empty.\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n          actions.append(USE)\n      else:\n          # No visible workshop; attempt to craft where we are.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:37:56.040326", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:38:11.711143", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Position, direction, inventory contents and full grid layout uniquely identify a state\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 800          # safety bound to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have an arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:38:39.935270", "function_name": "make_arrow", "function_body": "  # Retrieve the underlying scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Search limits\n  MAX_STEPS = 1500               # maximum trajectory length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:38:55.709152", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000                     # safety limit for search depth\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:39:11.220431", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Determine primitive requirements for a single arrow\n  needed_prims = world.cookbook.primitives_for(target_idx)  # {prim_idx: count}\n  # If the recipe has no primitive requirements (unlikely), treat as empty dict\n  if not isinstance(needed_prims, dict):\n      needed_prims = {}\n\n  # Initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  import heapq\n  from collections import namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\", \"cost\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a state for visited tracking.\"\"\"\n      # Position, direction, inventory tuple, and a hash of the grid occupancy\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  def _missing_primitive_count(st):\n      \"\"\"Heuristic: total number of missing primitive items for the goal.\"\"\"\n      have = st.inventory\n      missing = 0\n      for p_idx, cnt in needed_prims.items():\n          have_cnt = have[p_idx] if p_idx < len(have) else 0\n          if have_cnt < cnt:\n              missing += cnt - have_cnt\n      # Also count if we already have the final product\n      if st.inventory[target_idx] > 0:\n          missing = 0\n      return missing\n\n  # A* search\n  start_key = _state_key(init_state)\n  visited = {start_key}\n  start_node = Node(init_state, [], 0)\n  frontier = [(0 + _missing_primitive_count(init_state), start_node)]  # (f, node)\n\n  MAX_EXPANSIONS = 50000\n  expansions = 0\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 (4 moves + USE)\n\n  while frontier:\n      _, current = heapq.heappop(frontier)\n      cur_state = current.state\n\n      # Goal test\n      if cur_state.satisfies(\"\", target_idx):\n          return current.actions\n\n      # Expansion limit\n      expansions += 1\n      if expansions > MAX_EXPANSIONS:\n          break\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n\n          g_cost = len(current.actions) + 1\n          h_cost = _missing_primitive_count(next_state)\n          f_cost = g_cost + h_cost\n          heapq.heappush(frontier, (f_cost, Node(next_state, current.actions + [a], g_cost)))\n\n  # If we exit the loop without finding a solution, return empty plan\n  return []", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-28T20:39:26.875277", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Position, direction, inventory tuple, and grid bytes give a hashable state\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal reached: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand by trying every possible action\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:39:53.703956", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and grid layout\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 800                     # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long action sequences\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:40:08.611514", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to uniquely hash a state (position, direction, inventory, grid)\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 800                     # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long action sequences\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:40:31.918436", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and retrieve world information\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal item (arrow) and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"\n      Compute the shortest 4\u2011connected walkable path from start to goal.\n      Returns a list of positions including start and goal.\n      \"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          # Unreachable\n          return []\n\n      # Reconstruct path backwards\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions (including start) into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell containing `kind` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of `target` (preferring N, S, W, E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      # If none are free, fall back to the target itself (might be blocked)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)   # current (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur_pos, stand_pos)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand_pos\n\n          # Step onto the primitive cell itself (if possible)\n          if not is_blocked(prim_loc):\n              path = bfs_path(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe requires a specific workshop, go there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:40:33.059327", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain planning data\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Identify the goal (arrow) and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of positions from start to goal (inclusive) using BFS.\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []   # unreachable\n\n      # reconstruct path (including start)\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a position path (including start) to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing `kind` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of `target` (preferring N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target   # fallback (may be blocked)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)   # current (y, x)\n\n  # Collect required primitives\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur_pos, stand_pos)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand_pos\n\n          # Step onto the primitive cell itself (if possible) to ensure we are facing it\n          if not is_blocked(prim_loc):\n              path = bfs_path(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe requires a specific workshop, move there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:41:07.602465", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrap = getattr(env, \"_current_state\", None)\n      if state_wrap is not None:\n          world = getattr(state_wrap, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld not found in environment\")\n  cookbook = world.cookbook\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  occ = np.any(grid > 0, axis=2)\n\n  actions = []\n  harvested = set()\n\n  for prim_idx, needed in primitives_needed.items():\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      gathered = 0\n      for cell in cells:\n          if gathered >= needed:\n              break\n          if cell in harvested:\n              continue\n          path = _bfs(pos, [cell], occ)\n          actions.extend(path)\n          for a in path:\n              if a == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif a == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif a == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif a == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n          grid[cell[0], cell[1], prim_idx] = 0\n          occ[cell[0], cell[1]] = False\n          harvested.add(cell)\n          gathered += 1\n\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs(pos, [target_ws], occ)\n          actions.extend(path)\n          for a in path:\n              if a == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif a == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif a == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif a == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:41:08.729787", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def bfs(start, targets, occupied):\n      \"\"\"Return a list of actions that brings the agent from *start* to a cell\n      adjacent to any position in *targets* while avoiding occupied cells.\"\"\"\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # stop when adjacent to a target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # explore neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no reachable target\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate world / cookbook objects (they may be stored in different places\n  # depending on the wrapper used for the environment).\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      tmp_state = getattr(env, \"_current_state\", None)\n      if tmp_state is not None:\n          world = getattr(tmp_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state; reset the env if necessary.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal is the item named \u201carrow\u201d.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Working copies of position and grid for planning.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)               # (x, y)\n  cur_grid = state.grid.copy()         # (W, H, n_kinds)\n  occupied = np.any(cur_grid > 0, axis=2)   # boolean mask of blocked cells\n\n  actions = []\n  harvested = set()                    # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Greedy order: nearest first.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = bfs(pos, [loc], occupied)\n          actions.extend(path)\n          # Update position following the path.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell empty for future planning.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          occupied[loc[0], loc[1]] = False\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index \u2013 may be a string name.\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Locate workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = bfs(pos, [target_ws], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:41:34.688484", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState for visited\u2011set checks.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000                     # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (index 4) before movement actions to speed up crafting.\n  action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand successors\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)   # reward is always 0.0 here\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:41:50.411032", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects.\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\".\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode.\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState for visited\u2011set checks.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  # Safety limits.\n  MAX_STEPS = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Try USE action first \u2013 it is needed for picking up / crafting.\n  action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand successors.\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits.\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:42:23.758846", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T20:42:24.883205", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance <= 1) to any cell in\n  # `targets`. `occupied` is a boolean mask where True means blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are adjacent to any target cell.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position.\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld instance.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state.\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = getattr(state_tmp, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal is fixed to the item named \"arrow\".\n  # ------------------------------------------------------------------\n  if \"arrow\" not in cookbook.index.contents:\n      raise ValueError(\"Goal item 'arrow' not defined in the recipe file.\")\n  goal_idx = cookbook.index[\"arrow\"]\n  primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # mutable copy of the world grid\n  occupied = np.any(grid > 0, axis=2)   # True = blocked cell\n\n  actions = []\n  harvested = set()                     # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # Find all cells currently containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from the current position to reduce travel.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive cell.\n          path = _bfs_path(pos, [loc], occupied)\n          actions.extend(path)\n          # Update our internal position according to the path taken.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell as empty for future navigation.\n          grid[loc[0], loc[1], prim_idx] = 0\n          occupied[loc[0], loc[1]] = False\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Locate workshop cells currently present.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop cell.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n      else:\n          # No visible workshop; attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required; simply use to craft.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:42:52.458391", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 300                     # safety bound for search depth\n  n_actions = getattr(world, \"n_actions\", 5)   # default actions: 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
