{"timestamp": "2025-10-28T17:00:58.096497", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # Goal and required primitive counts\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)\n\n  # Current state snapshot\n  state = env._current_state\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()              # occupancy tensor\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # Helper: BFS path finder that returns a list of movement actions.\n  # --------------------------------------------------------------------- #\n  def bfs(start, target):\n      \"\"\"Return list of movement actions from start to target, or None.\"\"\"\n      width, height = grid.shape[:2]\n\n      # Cells that cannot be entered: any non\u2011grabbable entity present\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Allow stepping on the target cell even if it is otherwise blocked\n      blocked[target[0], target[1]] = False\n\n      # BFS structures\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_to[nxt] = a\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None\n\n      # Reconstruct actions\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_to[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------------- #\n  # Collect each required primitive (may need multiple copies)\n  # --------------------------------------------------------------------- #\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Locate all remaining instances of this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more instances; give up on this primitive\n              break\n\n          # Choose the nearest by Manhattan distance\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Plan a path to the target cell\n          path = bfs(pos, target)\n          if path is None:\n              # Fallback: simple Manhattan moves (ignores obstacles)\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)               # pick up the primitive\n\n          # Update simulated position and grid\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # --------------------------------------------------------------------- #\n  # Move to the workshop (if any) and craft the final item\n  # --------------------------------------------------------------------- #\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n          actions.extend(path)\n          actions.append(USE)               # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:00:59.222589", "function_name": "make_arrow", "function_body": "  # Get action indices\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # Goal index and primitive requirements\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # Current state snapshot\n  state = env._current_state\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()              # keep a local copy we can modify\n  actions = []                           # list of action ids to return\n\n  # --------------------------------------------------------------------- #\n  # Helper: breadth\u2011first search on the current grid layout.\n  # Returns a list of actions that moves from start \u2192 target.\n  # --------------------------------------------------------------------- #\n  import collections\n\n  def bfs(start, target):\n      \"\"\"Return a list of actions moving from start to target, avoiding\n      non\u2011grabbable entities.  The target cell may be occupied (e.g. a\n      workshop) \u2013 it is allowed to step onto it.\"\"\"\n      width, height = grid.shape[:2]\n\n      # Build blocked map: any cell that contains a non\u2011grabbable entity.\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Target cell is allowed even if blocked (used for workshops).\n      blocked[target[0], target[1]] = False\n\n      # BFS structures\n      q = collections.deque([start])\n      parent = {start: None}\n      action_to = {}\n\n      # Directions paired with actions\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      action_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # Reconstruct actions backwards\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_to[cur])\n          cur = parent[cur]\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------------- #\n  # Collect all required primitive items.\n  # --------------------------------------------------------------------- #\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Find all cells containing this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # Primitive not present \u2013 assume it is already in inventory or\n              # unreachable; break out to avoid infinite loop.\n              break\n\n          # Choose the nearest primitive (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Compute a path to the target\n          path = bfs(pos, target)\n          if path is None:\n              # Fallback: direct Manhattan moves (may fail on obstacles)\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          # Append movement actions and the USE action to pick up the primitive\n          actions.extend(path)\n          actions.append(USE)\n\n          # Update our local state: move the agent and remove the item\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # --------------------------------------------------------------------- #\n  # Move to the appropriate workshop (if any) and craft the goal item.\n  # --------------------------------------------------------------------- #\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_locs:\n          # Choose nearest workshop\n          target_ws = min(\n              workshop_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws)\n          if path is None:\n              # Simple Manhattan fallback\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:01:26.120597", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Constants and direction helpers\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS shortest path that avoids non\u2011grabbable entities\n  # ----------------------------------------------------------------------\n  def _bfs_path(src, dst, grid):\n      h, w, _ = grid.shape\n      blocked_kinds = env.world.non_grabbable_indices\n\n      def cell_free(r, c):\n          if not (0 <= r < h and 0 <= c < w):\n              return False\n          # cell is blocked if any non\u2011grabbable kind has a positive count\n          return not any(grid[r, c, k] > 0 for k in blocked_kinds)\n\n      from collections import deque\n      q = deque([src])\n      parent = {src: None}\n      while q:\n          r, c = q.popleft()\n          if (r, c) == dst:\n              break\n          for dr, dc, act in DIRS:\n              nr, nc = r + dr, c + dc\n              if (nr, nc) not in parent and cell_free(nr, nc):\n                  parent[(nr, nc)] = (r, c, act)\n                  q.append((nr, nc))\n      if dst not in parent:\n          return []                     # no reachable path\n\n      # reconstruct action list\n      actions = []\n      cur = dst\n      while parent[cur] is not None:\n          pr, pc, act = parent[cur]\n          actions.append(act)\n          cur = (pr, pc)\n      actions.reverse()\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell (Manhattan) containing a given kind\n  # ----------------------------------------------------------------------\n  def _nearest_cell(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ----------------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # ----------------------------------------------------------------------\n  def _any_cell(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Initialise a fresh episode\n  # ----------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ----------------------------------------------------------------------\n  # Identify the goal index for \"arrow\"\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:                 # recipe not found\n      return []\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ----------------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (respecting required counts)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = _nearest_cell(state.grid, prim_idx, state.pos)\n          if target is None:          # primitive missing \u2013 abort early\n              return action_seq\n          # Move to the primitive using BFS path\n          for a in _bfs_path(state.pos, target, state.grid):\n              _, done, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick it up\n          _, done, _ = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow (possibly at a required workshop)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any_cell(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _bfs_path(state.pos, workshop_pos, state.grid):\n              _, done, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n  # Perform the crafting action\n  _, done, _ = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 14, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:01:27.220283", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:01:56.749054", "function_name": "make_arrow", "function_body": "  DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n      sx, sy = start\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []\n\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  plan = []\n  for kind_idx, count in needed.items():\n      while count > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              return plan\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          plan.append(4)  # USE\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              break\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          plan.append(4)  # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:01:57.865476", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Direction / action maps (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n  # ----------------------------------------------------------------------\n  DIR_TO_ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search: move from ``start`` to a cell adjacent (Manhattan\u20111)\n  # to any cell in ``targets`` while avoiding blocked cells.\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, targets, grid, blocked_mask):\n      \"\"\"\n      Returns a list of actions that brings the agent from ``start`` to a\n      position adjacent to any coordinate in ``targets``. ``blocked_mask`` is\n      a 2\u2011D boolean array where True indicates an impassable cell.\n      \"\"\"\n      W, H = grid.shape[:2]\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked_mask[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise environment and extract goal.\n  # ----------------------------------------------------------------------\n  obs = env.reset()\n  state = env._current_state\n  grid = state.grid.copy()                     # mutable copy for simulation\n  pos = tuple(state.pos)                       # (x, y)\n\n  # Goal index stored in the task (env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for the goal.\n  # ----------------------------------------------------------------------\n  needed_primitives = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # Build a mask of cells that are permanently blocked (non\u2011grabbable entities)\n  # and also any cell currently occupied by any object.\n  def compute_blocked(g):\n      # Any non\u2011zero entry in the last dimension blocks movement.\n      return np.any(g > 0, axis=2)\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitives.\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed_primitives.items():\n      while count > 0:\n          # Locate all cells that still contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 abort planning.\n              return plan\n\n          blocked = compute_blocked(grid)\n          path = bfs_adjacent(pos, prim_cells.tolist(), grid, blocked)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(4)   # USE\n\n          # Find which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected \u2013 break to avoid infinite loop.\n              break\n\n          # Update simulated grid and remaining need.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          count -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get('_at') or recipe.get('_key')\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          blocked = compute_blocked(grid)\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:02:22.451028", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action / direction helpers (as defined by CraftLab)\n  # ----------------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR_TO_ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search returning a list of actions that moves the agent\n  # from ``start`` to a cell adjacent to any cell in ``targets``.\n  # ----------------------------------------------------------------------\n  def bfs(start, targets, grid):\n      \"\"\"\n      Parameters\n      ----------\n      start : tuple (x, y)\n          Current agent position.\n      targets : list of (x, y)\n          Cells we want to become adjacent to.\n      grid : np.ndarray (W, H, K)\n          Current world grid. Any non\u2011zero entry in the last axis counts as\n          an obstacle for movement.\n\n      Returns\n      -------\n      list[int]\n          Sequence of action indices that brings the agent adjacent to a\n          target cell. May be empty if already adjacent or if no path exists.\n      \"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n\n      # Quick check: already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  # Current state (the environment holds a CraftLab wrapper around a CraftState).\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy of the world grid\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal item index (the task stores a ``goal`` attribute \u2013 may be an int or a struct).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal not found in env.task\")\n\n  # ------------------------------------------------------------------\n  # 1. Determine which primitive resources are needed to craft the goal.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []  # final list of actions to return\n\n  # ------------------------------------------------------------------\n  # 2. Collect each primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          # Locate all cells that currently contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 cannot continue planning.\n              return plan\n\n          # Find a path to the nearest primitive (adjacent cell).\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate the movement so that ``pos`` stays in sync.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use (collect) the primitive.\n          plan.append(ACTION_USE)\n\n          # Determine which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update our local grid copy (remove one instance) and decrement counter.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate final movement.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:02:23.561079", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action / direction helpers (as defined in CraftLab)\n  # ------------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search: returns a list of actions that moves the agent\n  # from ``start`` to a cell adjacent (Manhattan distance 1) to any\n  # cell in ``targets`` while avoiding blocked cells.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, grid):\n      W, H = grid.shape[:2]          # grid dimensions (width, height)\n      blocked = np.any(grid > 0, axis=2)   # any occupied cell is blocked\n\n      sx, sy = start\n\n      # already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # no reachable adjacency\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                 # mutable copy of world grid\n  pos = tuple(state.pos)                   # (x, y)\n\n  # Goal index is stored in the task definition\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (recursive expansion)\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # locate all cells that currently contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # primitive unavailable \u2013 abort planning\n              return plan\n\n          # compute path to the nearest reachable primitive (adjacent)\n          path = bfs(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # simulate movement to keep ``pos`` up\u2011to\u2011date\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # pick up the primitive\n          plan.append(ACTION_USE)\n\n          # find which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              break   # unexpected; avoid infinite loop\n\n          # update local grid copy and decrement needed count\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # resolve workshop index (may be a name or an integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:02:53.241837", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ----------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of action indices\n  # ----------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should not happen in valid scenarios\n\n  # ----------------------------------------------------------------------\n  # Helper: move to a cell containing a given kind and USE it `cnt` times\n  # ----------------------------------------------------------------------\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE to pick up\n\n  # ----------------------------------------------------------------------\n  # Gather world / recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ----------------------------------------------------------------------\n  # Resolve full crafting plan: primitives needed + ordered craft steps\n  # ----------------------------------------------------------------------\n  needed_prims = {}          # primitive idx \u2192 total count\n  craft_steps = []           # (item_idx, count) in dependency order\n\n  def resolve(item_idx, mul):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul\n          return\n      # first resolve ingredients (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mul)\n      # schedule this item to be crafted after its ingredients\n      craft_steps.append((item_idx, mul))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all primitive resources\n  for kind, cnt in needed_prims.items():\n      acquire(kind, cnt)\n\n  # 2) Perform crafting steps at required workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:02:54.364816", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) from start to\n  # any cell in `targets`, avoiding cells marked as blocked.\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # actions: 0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT\n\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # If we get here the target is unreachable; return empty list.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: move to a cell that currently contains `kind_idx` and USE it\n  # `cnt` times (collect primitive or craft at a workshop).\n  # ----------------------------------------------------------------------\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          # recompute set of cells that still contain the required kind\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          if not cells:\n              # nothing left of this kind \u2013 break early\n              break\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE\n\n  # ----------------------------------------------------------------------\n  # Gather world / recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ----------------------------------------------------------------------\n  # Resolve full list of primitive requirements and ordered crafting steps.\n  # `needed_prims` maps primitive kind -> total count.\n  # `craft_steps` is a list of (item_idx, count) in dependency order.\n  # ----------------------------------------------------------------------\n  needed_prims = {}\n  craft_steps = []\n\n  def resolve(item_idx, mult):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve all ingredient items first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # After ingredients, schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Static data: current grid, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect every required primitive resource\n  for prim_idx, qty in needed_prims.items():\n      acquire(prim_idx, qty)\n\n  # 2) Perform the crafting steps at their respective workshops\n  for item_idx, qty in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      # workshop key can be stored under \"_at\" or legacy \"_key\"\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # locate any workshop cell of the required type\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * qty)   # USE at workshop the needed number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:03:22.924013", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Initialise environment and obtain useful references\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  # Work on a mutable copy of the grid so we can mark collected primitives\n  grid = state.grid.copy()             # shape (WIDTH, HEIGHT, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Action identifiers (consistent with CraftLab.action_specs)\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      \"\"\"Return True if (y, x) lies inside the grid.\"\"\"\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any non\u2011grabbable entity occupies it.\"\"\"\n      # Non\u2011grabbable indices are stored in world.non_grabbable_indices (a set)\n      if not world.non_grabbable_indices:\n          return False\n      return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"\n      Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves the\n      agent from ``start`` to ``goal`` while avoiding blocked cells.\n      \"\"\"\n      if start == goal:\n          return []\n\n      from collections import deque\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      parent = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct action list\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited[ny, nx] = True\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to ``cell`` not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_primitives = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  collected_cells = set()   # keep track of primitive cells already taken\n  for prim_idx, cnt in needed_primitives.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = free_adjacent(target, avoid=collected_cells)\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell itself\n              adj = target\n\n          # Move to the chosen adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a movement that will be blocked)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Prefer a free neighbour of the workshop; otherwise stand on it\n          ws_adj = free_adjacent(ws_cell, avoid=collected_cells)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting of the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 25, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:03:24.060127", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices (consistent with CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      parent = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited[ny, nx] = True\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell to ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  collected = set()\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; cannot safely collect \u2013 abort\n              return actions\n\n          # Move to that adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (blocked move to set direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              # Fall back to standing directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:03:36.285715", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:03:37.411032", "function_name": "make_arrow", "function_body": "  # Get action indices\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # Goal index (int) for the item we need to produce\n  goal = env.task.goal\n\n  # Primitive requirements for the goal (primitive index -> count)\n  needed = env.world.cookbook.primitives_for(goal)\n\n  # Snapshot of current state to simulate pickups without affecting the env\n  state = env._current_state\n  pos = tuple(state.pos)                     # (x, y) current position\n  grid = state.grid.copy()                   # mutable copy of the grid\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS path planning that avoids non\u2011grabbable entities\n  # ----------------------------------------------------------------------\n  def _bfs_path(start, target, allow_target_block=False):\n      \"\"\"Return a list of actions moving from start to target.\n      If allow_target_block is True the target cell is considered traversable\n      even if it contains a non\u2011grabbable entity (useful for picking up the\n      item or reaching a workshop). Returns None if no path exists.\"\"\"\n      width, height = grid.shape[:2]\n\n      # Determine blocked cells (non\u2011grabbable entities)\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      if allow_target_block:\n          blocked[target[0], target[1]] = False\n\n      # BFS\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in (\n              (DOWN, (1, 0)),\n              (UP, (-1, 0)),\n              (RIGHT, (0, 1)),\n              (LEFT, (0, -1)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None  # no path found\n\n      # Reconstruct actions\n      actions = []\n      cur = target\n      while cur != start:\n          a = action_from[cur]\n          actions.append(a)\n          cur = came_from[cur]\n      actions.reverse()\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Helper: Simple Manhattan movement (ignores obstacles) as a fallback\n  # ----------------------------------------------------------------------\n  def _manhattan_path(start, target):\n      moves = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Phase 1: Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Find all remaining cells containing this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # Primitive not available; stop trying to collect more\n              break\n          # Choose the closest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          # Plan a path to the target\n          path = _bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = _manhattan_path(pos, target)\n          actions.extend(path)\n          pos = target\n          # Pick up the primitive\n          actions.append(USE)\n          # Simulate removal from the grid\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Phase 2: Move to the appropriate workshop and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          # Pick the nearest workshop\n          target_ws = min(\n              ws_locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = _bfs_path(pos, target_ws, allow_target_block=True)\n          if path is None:\n              path = _manhattan_path(pos, target_ws)\n          actions.extend(path)\n          pos = target_ws\n          # Use the workshop to craft\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:04:16.888588", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = {(1, 0): DOWN, (-1, 0): UP, (0, -1): LEFT, (0, 1): RIGHT}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS path finder that avoids any non\u2011empty cell.\n  # Returns a list of actions moving the agent from `start` to a position\n  # adjacent to any of the `targets`. The returned path does **not**\n  # include a final turn; direction handling is done separately.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      width, height, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # any non\u2011zero kind blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:          # can step on empty cell\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []                                     # no path found\n\n  # ------------------------------------------------------------------\n  # Helper: determine the action needed to face `target` from `pos`.\n  # The action is returned even if the cell in that direction is occupied;\n  # executing it will simply change the agent's direction.\n  # ------------------------------------------------------------------\n  def _face_action(pos, target):\n      dx, dy = target[0] - pos[0], target[1] - pos[1]\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      # Should never happen if target is adjacent\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify world and cookbook\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state\n      state_tmp = getattr(env, \"_current_state\", None)\n      world = getattr(state_tmp, \"world\", None) if state_tmp is not None else None\n  cookbook = world.cookbook\n\n  # Goal (hard\u2011coded to \"arrow\")\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Obtain current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, count_needed in primitives_needed.items():\n      # Locate all cells currently containing this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= count_needed:\n              break\n          if loc in harvested:\n              continue\n\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [loc])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Face the primitive (may be blocked, but direction will change)\n          face_act = _face_action(pos, loc)\n          if face_act is not None:\n              actions.append(face_act)\n\n          # Use to pick up\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft at the required workshop (if recipe specifies one)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # Locate all workshop cells of this type\n      workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          # Choose nearest workshop\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_locs[0]\n\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Face the workshop cell\n          face_act = _face_action(pos, target_ws)\n          if face_act is not None:\n              actions.append(face_act)\n\n          # Use to craft\n          actions.append(USE)\n\n  return actions", "env_interactions": 25, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:04:18.008688", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:04:35.629184", "function_name": "make_arrow", "function_body": "  # ---- 1. Gather recipe information for \"arrow\" ---------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def _resolve(item_idx: int, mult: int) -> None:\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:  # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredient items first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              _resolve(ing, cnt * mult)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, mult))\n\n  _resolve(arrow_idx, 1)\n\n  # ---- 2. Static environment data ------------------------------------------------\n  grid = env._current_state.grid                # (W, H, n_kinds)\n  w, h, _ = grid.shape\n  # cells that cannot be stepped on\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # movement directions aligned with action indices: 0\u2011DOWN, 1\u2011UP, 2\u2011LEFT, 3\u2011RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  # ---- 3. Helper functions --------------------------------------------------------\n  def _bfs(start, targets):\n      \"\"\"Return a list of actions to reach the nearest cell in `targets`.\"\"\"\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # Should never happen in a solvable scenario\n      return []\n\n  def _go_to_and_use(kind_idx, count):\n      \"\"\"Move to a cell containing `kind_idx` and apply USE `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = _bfs(pos, cells)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ---- 4. Build the action sequence -----------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 4a) Collect all required primitive resources\n  for prim_idx, cnt in needed_prims.items():\n      _go_to_and_use(prim_idx, cnt)\n\n  # 4b) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = _bfs(pos, wk_cells)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:04:36.749214", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of action indices that\n  # reaches any cell in `targets` while avoiding cells marked in `blocked`.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 should not happen in valid scenarios\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and perform the USE\n  # action `count` times (collecting primitives or using a workshop).\n  # ------------------------------------------------------------------\n  def go_to_kind(kind_idx, count):\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 1) Gather recipe information for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredient items first (ignore special keys like \"_at\" or \"_key\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # 2) Static environment data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 3) Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 3a) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 3b) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # Locate any workshop cell of the required type\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # Use the workshop the necessary number of times to craft the item\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:05:03.166020", "function_name": "make_arrow", "function_body": "  # Reset the environment\n  env.reset()\n  # Mapping from action names to indices\n  act_map = env.action_specs()\n  # Movement deltas for cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n  actions = []\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of action names that moves the agent from `start`\n      to a cell adjacent (including diagonally) to any cell in `targets`.\n      Only walks through empty cells (no entity present).\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n          # Expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # cell must be empty (no entity present)\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh current state\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Find all cells that currently contain the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 nothing to collect\n              continue\n\n          # Plan a path to an adjacent cell of the nearest primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 skip\n              continue\n\n          # Execute the movement actions\n          for act_name in path:\n              a = act_map[act_name]\n              actions.append(a)\n              env.step(a)\n\n          # Use action to pick up the primitive\n          a = act_map[\"USE\"]\n          actions.append(a)\n          env.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  a = act_map[act_name]\n                  actions.append(a)\n                  env.step(a)\n\n          # Use action at the workshop to craft the item\n          a = act_map[\"USE\"]\n          actions.append(a)\n          env.step(a)\n\n  # Return the full list of actions\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:05:04.282056", "function_name": "make_arrow", "function_body": "  # Reset environment and prepare\n  env.reset()\n  state = env._current_state\n\n  # Identify goal and required primitives\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Action mapping and movement deltas\n  act_map = env.action_specs()\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  actions = []\n\n  # Helper: BFS to a cell adjacent (including diagonal) to any target cell\n  from collections import deque\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Walk only through empty cells\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate cells containing the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present; abort collection\n              continue\n\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable; skip\n              continue\n\n          for act_name in path:\n              a = act_map[act_name]\n              actions.append(a)\n              env.step(a)\n\n          # Pick up the primitive\n          a = act_map[\"USE\"]\n          actions.append(a)\n          env.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Move to workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  a = act_map[act_name]\n                  actions.append(a)\n                  env.step(a)\n\n          # Craft at the workshop\n          a = act_map[\"USE\"]\n          actions.append(a)\n          env.step(a)\n\n  # Return the full action list\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:05:28.543942", "function_name": "make_arrow", "function_body": "  # actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Helper: Manhattan path (fallback when no better path found)\n  # --------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # --------------------------------------------------------------\n  # Helper: BFS respecting passable kinds (empty cells + allowed_kinds)\n  # --------------------------------------------------------------\n  def _bfs_path(grid, start, goal, allowed_kinds):\n      h, w, _ = grid.shape\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (r, c), path = q.popleft()\n          if (r, c) == goal:\n              return path\n          for act, (dr, dc) in ((DOWN, (1, 0)), (UP, (-1, 0)),\n                                (LEFT, (0, -1)), (RIGHT, (0, 1))):\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              if (nr, nc) in visited:\n                  continue\n              cell_kinds = np.where(grid[nr, nc, :] > 0)[0]\n              if cell_kinds.size == 0:\n                  passable = True\n              else:\n                  passable = any(k in allowed_kinds for k in cell_kinds)\n              if passable:\n                  visited.add((nr, nc))\n                  q.append(((nr, nc), path + [act]))\n      return None\n\n  # --------------------------------------------------------------\n  # Helper: locate nearest cell containing a specific kind (Manhattan)\n  # --------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # --------------------------------------------------------------\n  # Helper: locate any cell containing a specific kind (used for workshops)\n  # --------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # --------------------------------------------------------------\n  # Begin episode\n  # --------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the target item ('arrow')\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      # Arrow not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  action_seq = []\n\n  # --------------------------------------------------------------\n  # Collect all required primitives (respecting multiplicities)\n  # --------------------------------------------------------------\n  for prim_idx, need_cnt in primitive_needs.items():\n      for _ in range(need_cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return action_seq\n\n          # Find a path that can step on the primitive cell itself\n          path = _bfs_path(state.grid, state.pos, target, {prim_idx})\n          if path is None:\n              path = _manhattan_path(state.pos, target)\n\n          # Execute movement actions\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n\n          # Pick up the primitive\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # --------------------------------------------------------------\n  # Craft the arrow (may require a specific workshop)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          path = _bfs_path(state.grid, state.pos, workshop_pos, {workshop_idx})\n          if path is None:\n              path = _manhattan_path(state.pos, workshop_pos)\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Perform crafting at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n  else:\n      # No workshop required \u2013 attempt to craft in place\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:05:29.644455", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0,1,2,3,4", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:05:49.264796", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(pos, target, seq):\n      \"\"\"Append moves to `seq` that bring mutable `pos` ([x,y]) to `target`.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return the (x, y) of the nearest cell containing `kind_idx`.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  actions = []\n\n  # Current position \u2013 use live state if available, otherwise the scenario start.\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid to mark collected items.\n  grid = env.scenario.init_grid.copy()\n\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # No more of this primitive on the map \u2013 abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                     # pick up the primitive\n          grid[target[1], target[0], kind_idx] = 0  # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                     # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:05:50.382048", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  actions = []\n\n  # Current agent position (use live state if present)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Copy of the static grid so we can \u201cremove\u201d collected items\n  grid = env.scenario.init_grid.copy()\n\n  # Index of the goal item for this task\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append actions moving mutable `pos` ([x,y]) towards `target`.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur, g):\n      \"\"\"Return (x, y) of the nearest cell containing `kind_idx`.\"\"\"\n      ys, xs = np.where(g[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitive resources\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not available \u2013 stop planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                     # pick up the primitive\n          grid[target[1], target[0], kind_idx] = 0  # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                     # craft at the workshop\n\n  # ------------------------------------------------------------------\n  # Return planned action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:06:18.859468", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _in_bounds(pos, shape):\n      x, y = pos\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(pos, shape):\n      x, y = pos\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny), shape):\n              yield (nx, ny)\n\n  def _bfs(start, goal_set, blocked):\n      \"\"\"\n      Bread\u2011first search from ``start`` to any cell in ``goal_set``.\n      ``blocked`` is a 2\u2011D bool array where True means the cell cannot be entered.\n      Returns a list of positions (including start) representing the path,\n      or ``None`` if no path exists.\n      \"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      dq = deque([start])\n      visited[start] = True\n      while dq:\n          cur = dq.popleft()\n          if cur in goal_set:\n              # reconstruct path\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur, (w, h)):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) into a list of movement actions.\"\"\"\n      act_list = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              act_list.append(RIGHT)\n          elif x1 < x0:\n              act_list.append(LEFT)\n          elif y1 > y0:\n              act_list.append(DOWN)\n          elif y1 < y0:\n              act_list.append(UP)\n      return act_list\n\n  # ----------------------------------------------------------------------\n  # Main logic\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  shape = grid.shape[:2]                     # (WIDTH, HEIGHT)\n\n  # --------------------------------------------------------------\n  # Determine goal index for \"arrow\"\n  # --------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception as e:\n          raise RuntimeError(\"Could not locate goal index for 'arrow'\") from e\n\n  # --------------------------------------------------------------\n  # Primitive requirements for the goal (expanded)\n  # --------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  # --------------------------------------------------------------\n  # Build blocked map (cells that cannot be stepped on)\n  # --------------------------------------------------------------\n  blocked = np.zeros(shape, dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper: move to a target cell (any reachable cell)\n  # --------------------------------------------------------------\n  def _move_to(target):\n      nonlocal cur_pos, actions, blocked\n      path = _bfs(cur_pos, {target}, blocked)\n      if path is None:\n          # unreachable \u2013 skip\n          return cur_pos\n      actions.extend(_path_to_actions(path))\n      cur_pos = target\n      return cur_pos\n\n  # --------------------------------------------------------------\n  # Collect required primitives\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # locate all cells containing this primitive\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          continue\n      # pick the first occurrence (any is fine)\n      prim_pos = tuple(locs[0])\n      _move_to(prim_pos)\n      actions.extend([USE] * needed)\n      # after picking up, the cell becomes empty \u2013 unblock it\n      blocked[prim_pos] = False\n\n  # --------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index\n      if isinstance(workshop_key, int):\n          workshop_idx = workshop_key\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_key)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              ws_pos = tuple(ws_locs[0])\n              # Find a free adjacent cell\n              adj_cells = [nb for nb in _neighbors(ws_pos, shape) if not blocked[nb]]\n              if adj_cells:\n                  # Choose the closest adjacent cell to current position\n                  adj_cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n                  target_adj = adj_cells[0]\n                  _move_to(target_adj)\n\n  # Finally, use the workshop (or current cell) to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:06:19.987208", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _in_bounds(pos, shape):\n      x, y = pos\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(pos, shape):\n      x, y = pos\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny), shape):\n              yield (nx, ny)\n\n  def _bfs(start, goals, blocked):\n      \"\"\"\n      Bread\u2011first search from ``start`` to any cell in ``goals``.\n      ``blocked`` is a 2\u2011D bool array where True means the cell cannot be entered.\n      Returns a list of positions (including ``start``) representing the path,\n      or ``None`` if no path exists.\n      \"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      dq = deque([start])\n      visited[start] = True\n      while dq:\n          cur = dq.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur, (w, h)):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) into movement actions.\"\"\"\n      act_list = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              act_list.append(RIGHT)\n          elif x1 < x0:\n              act_list.append(LEFT)\n          elif y1 > y0:\n              act_list.append(DOWN)\n          elif y1 < y0:\n              act_list.append(UP)\n      return act_list\n\n  # ----------------------------------------------------------------------\n  # Main planning\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  shape = grid.shape[:2]                     # (WIDTH, HEIGHT)\n\n  # --------------------------------------------------------------\n  # Resolve the goal index for \"arrow\"\n  # --------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise RuntimeError(\"Could not locate index for goal 'arrow'\")\n\n  # --------------------------------------------------------------\n  # Primitive requirements (expanded)\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  # --------------------------------------------------------------\n  # Cells that cannot be stepped on (non\u2011grabbable entities)\n  # --------------------------------------------------------------\n  blocked = np.zeros(shape, dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper: move to a target cell (any reachable cell)\n  # --------------------------------------------------------------\n  def _move_to(target):\n      nonlocal cur_pos, actions, blocked\n      path = _bfs(cur_pos, {target}, blocked)\n      if path is None:\n          # unreachable \u2013 give up silently\n          return False\n      actions.extend(_path_to_actions(path))\n      cur_pos = target\n      return True\n\n  # --------------------------------------------------------------\n  # Collect each required primitive\n  # --------------------------------------------------------------\n  for prim_idx, need_cnt in primitive_needs.items():\n      # locate all cells that currently contain this primitive\n      locations = [tuple(pos) for pos in np.argwhere(grid[:, :, prim_idx] > 0)]\n      gathered = 0\n      while gathered < need_cnt and locations:\n          # pick the first available location\n          target = locations.pop(0)\n          if not _move_to(target):\n              continue\n          # pick up the item (may need multiple USE if count >1)\n          actions.extend([USE] * (need_cnt - gathered))\n          # update world view: cell becomes empty, unblock it\n          blocked[target] = False\n          grid[target[0], target[1], prim_idx] = 0\n          gathered = need_cnt\n\n  # --------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be int or name)\n      if isinstance(workshop_key, int):\n          workshop_idx = workshop_key\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_key)\n      if workshop_idx is not None:\n          workshop_cells = [tuple(pos) for pos in np.argwhere(grid[:, :, workshop_idx] > 0)]\n          if workshop_cells:\n              ws = workshop_cells[0]\n              # Find a free adjacent cell to the workshop\n              adj_candidates = [nb for nb in _neighbors(ws, shape) if not blocked[nb]]\n              if adj_candidates:\n                  # Choose the closest candidate to current position\n                  adj_candidates.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n                  _move_to(adj_candidates[0])\n\n  # --------------------------------------------------------------\n  # Final craft action\n  # --------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
