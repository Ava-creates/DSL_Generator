{"timestamp": "2025-10-28T18:39:54.717005", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Find the index for the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:        # not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns None if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # action \u2192 (dx, dy)\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = state.pos\n      sdir = state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # If the recipe dict is empty, the arrow itself is a primitive.\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  plan = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # --------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              return plan          # unreachable primitive \u2192 abort\n          plan.extend(move_seq)\n          plan.append(4)           # USE to pick up\n\n          # Keep the internal state up\u2011to\u2011date.\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          return plan          # unreachable workshop \u2192 abort\n      plan.extend(move_seq)\n      plan.append(4)           # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 craft in place.\n      plan.append(4)           # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:40:16.503936", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Mapping from action index to movement delta (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def walkable(grid, x, y):\n      \"\"\"Return True if (x, y) is inside the grid and contains no entities.\"\"\"\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"\n      Bread\u2011first search for a sequence of movement actions (0\u20113) that ends\n      with the agent facing a cell containing `target_kind`. Returns the\n      action list, or an empty list if already facing the target or unreachable.\n      \"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n\n      # If already facing the target, no movement needed\n      dx, dy = deltas[sdir]\n      fx, fy = sx + dx, sy + dy\n      if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n          return []\n\n      queue = deque()\n      queue.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # Look ahead from current orientation\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          # Expand to four possible movement actions\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      # Unreachable\n      return []\n\n  def target_ahead(state, kind):\n      \"\"\"True if the cell directly in front of the agent contains `kind`.\"\"\"\n      x, y = state.pos\n      d = state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # 1) Collect all primitive resources required for one arrow\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_seq = bfs_to_target(cur_state, prim_idx)\n          if not move_seq and not target_ahead(cur_state, prim_idx):\n              # Primitive cannot be reached \u2013 abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n\n          # Apply the actions to keep cur_state up\u2011to\u2011date\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # 2) Craft the arrow at its required workshop (if any)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if not move_seq and not target_ahead(cur_state, workshop_idx):\n          # Workshop unreachable \u2013 still issue a USE (will simply do nothing)\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No dedicated workshop \u2013 craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:40:17.685211", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state/world\n  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Mapping from action index to (dx, dy)\n  deltas = {0: (0, 1),   # DOWN\n            1: (0, -1),  # UP\n            2: (-1, 0),  # LEFT\n            3: (1, 0)}   # RIGHT\n\n  # Helper: check if a cell is walkable (no entities at all)\n  def walkable(grid, x, y):\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  # BFS that returns a list of movement actions (0\u20113) that ends with the\n  # agent facing a cell containing `target_kind`. Returns [] if already\n  # facing the target or if unreachable.\n  def bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n      queue = deque()\n      queue.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n      while queue:\n          x, y, d, acts = queue.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      return []\n\n  # Helper: is the cell directly in front of the agent of a given kind?\n  def target_ahead(state, kind):\n      x, y = state.pos\n      d = state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitive resources needed for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          move_seq = bfs_to_target(cur_state, prim_idx)\n          # If we are already facing the primitive, move_seq will be []\n          if not move_seq and not target_ahead(cur_state, prim_idx):\n              # Primitive unreachable \u2013 abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          # Simulate the actions to keep cur_state up\u2011to\u2011date\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if not move_seq and not target_ahead(cur_state, workshop_idx):\n          # Workshop unreachable \u2013 still attempt a USE (will simply fail)\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop; craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:40:43.378911", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Gather recipe information for the target item 'arrow'\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # Mapping primitive kind index -> total count needed\n  needed_prims = {}\n  # Ordered list of (item_idx, count) representing crafting steps\n  craft_steps = []\n\n  def resolve(item_idx: int, mult: int) -> None:\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      recipe = cookbook.recipes.get(item_idx)\n      if recipe is None:\n          # Primitive item (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve all ingredient items (ignore special keys like \"_at\")\n      for ing, cnt in recipe.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # After its ingredients, schedule crafting of this item\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Static world data: grid layout, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid                     # (W, H, n_kinds)\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # Action direction mapping: 0\u2011DOWN, 1\u2011UP, 2\u2011LEFT, 3\u2011RIGHT, 4\u2011USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  from collections import deque\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search returning a list of actions to reach any target.\"\"\"\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []   # Should not happen for solvable scenarios\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)   # current (x, y)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          primitive_cells = {(x, y) for x in range(w) for y in range(h)\n                             if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, primitive_cells)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE to pick up the primitive\n\n  # 2) Perform crafting steps at their respective workshops\n  for item_idx, cnt in craft_steps:\n      recipe = cookbook.recipes[item_idx]\n      wk_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      workshop_cells = {(x, y) for x in range(w) for y in range(h)\n                        if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, workshop_cells)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop to craft the item\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:40:44.499977", "function_name": "make_arrow", "function_body": "  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}\n  craft_steps = []\n\n  def resolve(item_idx: int, mult: int) -> None:\n      recipe = cookbook.recipes.get(item_idx)\n      if recipe is None:  # primitive\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      for ing, cnt in recipe.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  from collections import deque\n\n  def bfs(start, targets):\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # Collect primitives\n  for kind_idx, count in needed_prims.items():\n      for _ in range(count):\n          primitive_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, primitive_cells)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE to pick up\n\n  # Perform crafting at workshops\n  for item_idx, count in craft_steps:\n      recipe = cookbook.recipes[item_idx]\n      wk_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      workshop_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, workshop_cells)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * count)  # USE at workshop to craft\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:41:12.274317", "function_name": "make_arrow", "function_body": "  import collections\n\n  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  Node = collections.namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a state.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = collections.deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
