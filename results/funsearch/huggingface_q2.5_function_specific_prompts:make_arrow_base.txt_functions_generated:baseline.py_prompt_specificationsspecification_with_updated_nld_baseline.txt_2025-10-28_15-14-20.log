{"timestamp": "2025-10-28T21:47:52.885387", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Shortest path (as list of actions) from start to any goal cell.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # can step onto a goal even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update simulated position after following a list of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect `needed` units of a primitive from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              raise RuntimeError(f\"Cannot find primitive {prim_idx} on the map\")\n          # pick the closest reachable location\n          best_path = None\n          best_loc = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  best_path = path\n                  best_loc = loc\n                  break\n          if best_path is None:\n              raise RuntimeError(\"No reachable primitive found\")\n          actions.extend(best_path)\n          move_along(best_path)\n          actions.append(4)          # USE to pick up\n          grid[best_loc[0], best_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Make sure `amount` of `item_idx` is present in inventory.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # First, guarantee all ingredients\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to the workshop required for this recipe (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if not ws_cells:\n                  raise RuntimeError(f\"Workshop {workshop} not found on map\")\n              path = bfs(pos, {ws_cells[0]})\n              if path is None:\n                  raise RuntimeError(\"Cannot reach required workshop\")\n              actions.extend(path)\n              move_along(path)\n\n          # Perform the craft action\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:47:54.018516", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T21:48:29.537089", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and obtain the current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal index for 'arrow' and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if the cell at `pos` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest walkable path (list of positions) from start to goal inclusive.\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y-1, x), (y+1, x), (y, x-1), (y, x+1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing `kind` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of `target`; if none, return `target` itself.\"\"\"\n      y, x = target\n      for ny, nx in ((y-1, x), (y+1, x), (y, x-1), (y, x+1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  actions = []\n  cur = tuple(state.pos)\n\n  # Collect each required primitive\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              return actions  # cannot find needed primitive\n\n          # Move to a free cell adjacent to the primitive\n          stand = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur = stand\n\n          # Step onto the primitive cell (if not blocked) to face it\n          if not is_blocked(prim_loc):\n              path2 = bfs_path(cur, prim_loc)\n              if not path2:\n                  return actions\n              actions.extend(path_to_actions(path2))\n              cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, move there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur = ws_loc\n\n  # Final craft action\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:48:30.686868", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and fetch the current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal index: use the task's goal if available, otherwise fall back to 'arrow'\n  try:\n      goal_idx = env.task.goal\n  except Exception:\n      goal_idx = world.cookbook.index.index('arrow')\n\n  # Primitive requirements for the goal\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  non_grab = list(world.non_grabbable_indices)\n\n  h, w = grid.shape[:2]\n\n  def is_blocked(pos):\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs(start, goal):\n      \"\"\"Return shortest walkable path (list of positions) from start to goal inclusive.\"\"\"\n      if start == goal:\n          return [start]\n      q = deque([start])\n      prev = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in prev and not is_blocked(nxt):\n                      prev[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = prev[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find nearest cell containing `kind` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  actions = []\n  cur = tuple(state.pos)\n\n  # Collect all required primitives\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(prim_idx, cur)\n          if target is None:\n              return actions\n          path = bfs(cur, target)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur = target\n          actions.append(USE)\n          # Remove the collected primitive from the planning grid\n          grid[target[0], target[1], prim_idx] = 0\n\n  # Move to the workshop if the recipe specifies one\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur = ws_loc\n\n  # Final craft action\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T21:48:55.865372", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000                     # safety limit for search depth\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:49:11.574723", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000                     # safety limit for search depth\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:49:39.382637", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n  # target index for arrow\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n  # initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash(st):\n      # combine position, direction, inventory and grid occupancy\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 800   # safety limit\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur = node.state\n\n      if cur.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      for a in range(n_actions):\n          _, nxt = cur.step(a)\n          h = _hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:49:55.342511", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash includes position, direction, inventory contents and the full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 1000                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long partial plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt = cur.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:50:23.751518", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects (they may be wrapped in different attributes)\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Identify the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Combine position, direction, inventory and grid layout into a hashable representation\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 300                       # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)   # default action count if missing\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does inventory contain the target item?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Do not expand beyond the maximum allowed depth\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:50:39.581719", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Identify the index of the target item (\"arrow\") in the cookbook\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState for the scenario\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space to find a sequence of actions\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 500                     # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # number of possible actions\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Do not expand nodes that already exceed the length limit\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions from the current state\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # If no plan was found within the search limits, return an empty list\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:51:05.066685", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state and world info\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # ------------------------------------------------------------------\n  # Action identifiers (consistent with CraftLab.action_specs)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Return shortest list of movement actions from start to goal.\"\"\"\n      if start == goal:\n          return []\n      visited = np.full((H, W), False, dtype=bool)\n      parent = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions_rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      actions_rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      actions_rev.append(UP)\n                  elif cur[1] == px + 1:\n                      actions_rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited[ny, nx] = True\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      return []  # No path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of `cell` not in `avoid`.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal (arrow) and its recipe requirements\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  harvested = set()                       # cells already collected\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing; abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, avoid=harvested)\n          if adj is None:\n              adj = target  # fallback to standing directly on the primitive\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (blocked move to set direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid model.\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=harvested)\n          if ws_adj is None:\n              ws_adj = cur_pos  # stay where we are if no free neighbour\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop.\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:51:06.215337", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path (as a list of actions) from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      visited = np.full((H, W), False, dtype=bool)\n      parent = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions_rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      actions_rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      actions_rev.append(UP)\n                  elif cur[1] == px + 1:\n                      actions_rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited[ny, nx] = True\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return coordinates of the nearest cell containing the given kind.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Find a free neighbour of `cell` not in `avoid`.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  collected = set()                       # cells already emptied\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; fallback to standing directly on the primitive cell\n              adj = target\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (perform a blocked move to set direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid model: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:51:32.653020", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup and utilities\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item name \u2013 use \"arrow\" if available, otherwise any craftable item\n  target_name = \"arrow\"\n  if target_name not in cookbook.index.contents:\n      target_name = next(iter(cookbook.recipes))\n  target_idx = cookbook.index[target_name]\n\n  # mutable copies of the world state for planning\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search returning a list of movement actions to reach any cell\n  # in ``goals``.  Cells that contain any entity are treated as obstacles unless\n  # they are part of ``goals``.\n  def bfs(start, goals):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # occupied cells block movement unless they are a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # Update simulated position according to a list of movement actions.\n  def move_along(path):\n      nonlocal pos\n      for a in path:\n          if a == 0:      # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1:    # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2:    # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3:    # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection helper\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect ``needed`` units of primitive ``prim_idx`` from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # no more primitives available\n\n          # find the first reachable primitive cell\n          chosen_path = None\n          chosen_loc = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  chosen_path = p\n                  chosen_loc = loc\n                  break\n          if chosen_path is None:\n              break  # unreachable\n\n          # move there and pick up\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          actions.append(4)                     # USE\n          grid[chosen_loc[0], chosen_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitive_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Guarantee ``inventory[item_idx]`` >= ``amount`` by collecting or crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitive_set:\n              # primitive \u2013 just collect the missing amount\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # non\u2011primitive \u2013 craft using its recipe\n          recipe = recipes.get(item_idx, {})\n          # first ensure all ingredients are present\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              # locate workshop cells\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              # pick the first workshop and move to an adjacent empty cell\n              for ws in ws_cells:\n                  adjacents = [(ws[0] + dx, ws[1] + dy) for dx, dy in\n                               ((0, 1), (0, -1), (-1, 0), (1, 0))]\n                  reachable = [a for a in adjacents\n                               if 0 <= a[0] < width and 0 <= a[1] < height\n                               and not np.any(grid[a[0], a[1], :])]\n                  if reachable:\n                      path = bfs(pos, set(reachable))\n                      if path is not None:\n                          actions.extend(path)\n                          move_along(path)\n                      break  # stop after reaching one workshop\n\n          # perform the crafting action\n          actions.append(4)                     # USE\n          # update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the target item (arrow)\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 38, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:51:33.836655", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify the target item (arrow). Fallback to any craftable.\n  target_name = \"arrow\"\n  if target_name not in cookbook.index.contents:\n      target_name = next(iter(cookbook.recipes))\n  target_idx = cookbook.index[target_name]\n\n  # --------------------------------------------------------------\n  # Local mutable copies of the world state for planning.\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  # --------------------------------------------------------------\n  # BFS that returns a list of movement actions to reach any cell in\n  # ``goals``. Cells that contain any entity are treated as obstacles\n  # unless they are a goal cell.\n  def bfs(start, goals):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # occupied cells block movement unless they are a goal\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  # --------------------------------------------------------------\n  # Update the simulated position according to a list of actions.\n  def move_along(path):\n      nonlocal pos\n      for a in path:\n          if a == 0:      # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1:    # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2:    # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3:    # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # --------------------------------------------------------------\n  # Collect a primitive from the grid.\n  def collect_primitive(prim_idx, needed):\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # nothing left\n\n          # pick the first reachable primitive\n          chosen_path = None\n          chosen_loc = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  chosen_path = p\n                  chosen_loc = loc\n                  break\n          if chosen_path is None:\n              break  # unreachable\n\n          # move there and pick up\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          actions.append(4)                     # USE\n          grid[chosen_loc[0], chosen_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # --------------------------------------------------------------\n  # Recursive helper that guarantees ``inventory[item_idx] >= amount``.\n  recipes = cookbook.recipes\n  primitive_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitive_set:\n              # primitive \u2013 just collect the missing amount\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # non\u2011primitive \u2013 craft using its recipe\n          recipe = recipes.get(item_idx, {})\n          # first make sure all ingredients are present\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              # locate workshop cells\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              # pick the first workshop and move to an adjacent empty cell\n              for ws in ws_cells:\n                  adjacents = [(ws[0] + dx, ws[1] + dy) for dx, dy in\n                               ((0, 1), (0, -1), (-1, 0), (1, 0))]\n                  reachable = [a for a in adjacents\n                               if 0 <= a[0] < width and 0 <= a[1] < height\n                               and not np.any(grid[a[0], a[1], :])]\n                  if reachable:\n                      path = bfs(pos, set(reachable))\n                      if path is not None:\n                          actions.extend(path)\n                          move_along(path)\n                      break  # stop after reaching one workshop\n\n          # perform the crafting action\n          actions.append(4)                     # USE\n          # update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # --------------------------------------------------------------\n  # Build the target item (arrow)\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 38, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:52:12.321214", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = np.copy(state.grid)           # mutable copy of the grid\n\n  # Action indices (consistent with CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk\n      from ``start`` to ``goal`` using a simple Manhattan route.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that currently contains ``kind_idx``.\n      Returns a tuple (y, x) or ``None`` if no such cell exists.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free (non\u2011non\u2011grabbable) adjacent coordinate to ``cell``.\n      Preference order: up, down, left, right. If none are free, return the\n      original cell.\"\"\"\n      y, x = cell\n      candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return cell\n\n  # ------------------------------------------------------------------\n  # Determine primitives needed for an arrow\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on before using.\n          stand_pos = free_adjacent(target)\n\n          # Move to the chosen standing position.\n          actions += manhattan_path(cur_pos, stand_pos)\n          cur_pos = stand_pos\n\n          # Adjust direction to face the primitive (if not standing on it).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update the mutable grid to reflect that the primitive has been taken.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:52:13.479674", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = np.copy(state.grid)\n\n  # Action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Mapping from movement delta to action index\n  delta_to_action = {(1, 0): DOWN, (-1, 0): UP, (0, -1): LEFT, (0, 1): RIGHT}\n\n  from collections import deque\n\n  def is_walkable(pos):\n      \"\"\"A cell is walkable if it is inside the grid and does not contain any\n      non\u2011grabbable entity (obstacle).\"\"\"\n      y, x = pos\n      if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):\n          return False\n      return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def bfs(start, goal):\n      \"\"\"Breadth\u2011first search returning a list of positions from start to goal\n      (inclusive). Returns None if no path exists.\"\"\"\n      if start == goal:\n          return [start]\n      visited = {start}\n      prev = {}\n      q = deque([start])\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              nxt = (ny, nx)\n              if not (0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]):\n                  continue\n              if not is_walkable(nxt):\n                  continue\n              if nxt in visited:\n                  continue\n              visited.add(nxt)\n              prev[nxt] = cur\n              q.append(nxt)\n      else:\n          return None  # no path\n\n      # reconstruct path\n      path = [goal]\n      while path[-1] != start:\n          path.append(prev[path[-1]])\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions to the corresponding movement actions.\"\"\"\n      acts = []\n      for (y0, x0), (y1, x1) in zip(path, path[1:]):\n          dy, dx = y1 - y0, x1 - x0\n          acts.append(delta_to_action[(dy, dx)])\n      return acts\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that currently contains the given kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a walkable cell adjacent to ``cell`` (preferring up, down,\n      left, right). If none are walkable, return None.\"\"\"\n      y, x = cell\n      for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ny, nx = y + dy, x + dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if is_walkable((ny, nx)):\n                  return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are required to craft an ``arrow``.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          stand = free_adjacent(target)\n          if stand is None:\n              # No free neighbour; stand on the primitive cell itself.\n              stand = target\n\n          path = bfs(cur_pos, stand)\n          if path is None:\n              return actions\n          actions += path_to_actions(path)\n          cur_pos = stand\n\n          # Face the primitive (best\u2011effort direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if (dy, dx) in delta_to_action:\n              actions.append(delta_to_action[(dy, dx)])\n              # Simulate the step into the primitive cell (optional).\n              cur_pos = (cur_pos[0] + dy, cur_pos[1] + dx)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update our mutable copy of the grid.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          path = bfs(cur_pos, ws_cell)\n          if path is not None:\n              actions += path_to_actions(path)\n              cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:52:45.327067", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                   # CraftWorld\n  grid = state.grid.copy()            # mutable copy for planning\n\n  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_free(cell):\n      \"\"\"Return True if `cell` is inside the grid and not occupied by a non\u2011grabbable entity.\"\"\"\n      y, x = cell\n      if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):\n          return False\n      # Any non\u2011grabbable entity present?\n      occupied = np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n      return not occupied\n\n  def free_adjacent(target):\n      \"\"\"Find a free orthogonal neighbour of `target`. Return None if none.\"\"\"\n      ty, tx = target\n      for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ny, nx = ty + dy, tx + dx\n          if is_free((ny, nx)):\n              return (ny, nx)\n      return None\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves from\n      `start` to `goal` while avoiding non\u2011grabbable cells.\"\"\"\n      if start == goal:\n          return []\n\n      from collections import deque\n      queue = deque([start])\n      parent = {start: (None, None)}  # pos -> (prev_pos, action)\n\n      while queue:\n          cur = queue.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for (dy, dx), act in [((-1, 0), UP), ((1, 0), DOWN),\n                                ((0, -1), LEFT), ((0, 1), RIGHT)]:\n              ny, nx = y + dy, x + dx\n              nxt = (ny, nx)\n              if not is_free(nxt):\n                  continue\n              if nxt not in parent:\n                  parent[nxt] = (cur, act)\n                  queue.append(nxt)\n\n      if goal not in parent:\n          # unreachable \u2013 return empty list\n          return []\n\n      # reconstruct actions\n      actions_rev = []\n      cur = goal\n      while parent[cur][0] is not None:\n          prev, act = parent[cur]\n          actions_rev.append(act)\n          cur = prev\n      actions_rev.reverse()\n      return actions_rev\n\n  def turn_towards(src, dst):\n      \"\"\"Return a single turn action that makes `src` face `dst` (must be orthogonal).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell that contains an entity of `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine goal and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Choose a free cell to stand on: preferably adjacent, otherwise the cell itself.\n          stand = free_adjacent(target) or (target if is_free(target) else None)\n          if stand is None:\n              # Cannot reach this primitive; abort.\n              return actions\n\n          # Move to the standing position.\n          actions += bfs_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive if we are not standing on it.\n          turn = turn_towards(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update planning grid so we don't try to pick the same item again.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if the recipe requires one) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:52:46.503277", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_free(cell):\n      \"\"\"Return True if `cell` is inside the grid and not occupied by a\n      non\u2011grabbable entity.\"\"\"\n      y, x = cell\n      if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):\n          return False\n      # any non\u2011grabbable entity present?\n      occupied = np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n      return not occupied\n\n  def free_adjacent(target):\n      \"\"\"Find a free orthogonal neighbour of `target`. Return None if none.\"\"\"\n      ty, tx = target\n      for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          ny, nx = ty + dy, tx + dx\n          if is_free((ny, nx)):\n              return (ny, nx)\n      return None\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of actions (DOWN/UP/LEFT/RIGHT) moving from `start`\n      to `goal` while avoiding non\u2011grabbable cells. Empty list if unreachable.\"\"\"\n      if start == goal:\n          return []\n\n      from collections import deque\n      queue = deque([start])\n      parent = {start: (None, None)}   # pos -> (prev_pos, action)\n\n      while queue:\n          cur = queue.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for (dy, dx), act in [((-1, 0), UP), ((1, 0), DOWN),\n                                ((0, -1), LEFT), ((0, 1), RIGHT)]:\n              ny, nx = y + dy, x + dx\n              nxt = (ny, nx)\n              if not is_free(nxt):\n                  continue\n              if nxt not in parent:\n                  parent[nxt] = (cur, act)\n                  queue.append(nxt)\n\n      if goal not in parent:\n          return []   # unreachable\n\n      # reconstruct actions\n      actions_rev = []\n      cur = goal\n      while parent[cur][0] is not None:\n          prev, act = parent[cur]\n          actions_rev.append(act)\n          cur = prev\n      actions_rev.reverse()\n      return actions_rev\n\n  def turn_towards(src, dst):\n      \"\"\"Return a single turn action that makes `src` face `dst`\n      (must be orthogonal). Returns None if same cell or not orthogonal.\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing an entity of `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine goal and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in needed_prims.items():\n      for _ in range(needed_cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on; fall back to the primitive cell.\n          stand = free_adjacent(target) or target\n\n          # Move to the standing position.\n          actions += bfs_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Turn towards the primitive (if not standing on it).\n          turn = turn_towards(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update planning grid so we don't try to pick the same item again.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:53:14.939674", "function_name": "make_arrow", "function_body": "  # Reset environment and get core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n  H, W = grid.shape[:2]\n\n  # Action indices (fallback to defaults if not present)\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # Directions as (dy, dx, action)\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is considered blocked if any non\u2011grabbable entity occupies it.\"\"\"\n      return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions to go from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of `cell` not in `avoid`.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def face_towards(src, dst):\n      \"\"\"Return a single movement action that makes src face dst.\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos               # (y, x)\n  harvested = set()                 # cells already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing; stop early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, avoid=harvested)\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive and pick it up.\n          face_act = face_towards(cur_pos, target)\n          if face_act is not None:\n              actions.append(face_act)\n          actions.append(USE)\n\n          # Update internal grid copy and record the harvested cell.\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=harvested)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop before using.\n          face_act = face_towards(cur_pos, ws_cell)\n          if face_act is not None:\n              actions.append(face_act)\n\n  # Final USE to trigger crafting (or to craft directly if no workshop).\n  actions.append(USE)\n\n  return actions", "env_interactions": 25, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T21:53:16.130516", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the current state and world objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n  H, W, _ = grid.shape\n\n  # Action indices (fallback to default ordering if not present)\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\n      If no path exists, return an empty list.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      return []  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell):\n      \"\"\"Return a free neighbour of `cell` (or None if none exist).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def face_towards(src, dst):\n      \"\"\"Return a single movement action that makes src face dst.\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos               # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present; abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target)\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive and pick it up.\n          face_act = face_towards(cur_pos, target)\n          if face_act is not None:\n              actions.append(face_act)\n          actions.append(USE)\n\n          # Update internal grid copy and clear the harvested primitive.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting (or to craft directly if no workshop).\n  actions.append(USE)\n\n  return actions", "env_interactions": 33, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:53:43.233317", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ID of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"\n      Create a hashable representation of a CraftState.\n      Includes position, direction, inventory contents and the full grid.\n      \"\"\"\n      return (st.pos,\n              st.dir,\n              tuple(st.inventory.tolist()),\n              st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_PLAN_LENGTH = 800          # safety cutoff to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long trajectories\n      if len(cur_actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:53:58.990804", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Include position, direction, inventory contents, and full grid bytes.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500                     # safety cutoff for search depth\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long trajectories\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:54:27.154451", "function_name": "make_arrow", "function_body": "  # Get scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # inventory as tuple, grid as bytes (immutable)\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = set()\n  start_hash = _state_hash(init_state)\n  visited.add(start_hash)\n\n  frontier = deque([Node(init_state, [])])\n\n  # Upper bound on plan length \u2013 prevents runaway search while allowing reasonable plans\n  MAX_PLAN_LEN = 2500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No solution found within the search budget\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:54:43.031731", "function_name": "make_arrow", "function_body": "  # Extract the scenario and world objects from the environment.\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index that corresponds to the target item \"arrow\".\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial CraftState for this episode.\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_hash_state(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 2000                      # safety bound on search depth\n  n_actions = getattr(world, \"n_actions\", 5)  # number of possible actions\n\n  while frontier:\n      node = frontier.popleft()\n      state = node.state\n\n      # Goal test: have at least one arrow in the inventory.\n      if state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories.\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, nxt_state = state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget.\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:55:06.815366", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world references\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the goal item \"arrow\"\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for planning\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Determine primitive requirements (optional, used only for heuristic ordering)\n  try:\n      primitive_needs = world.cookbook.primitives_for(goal_idx)\n  except Exception:\n      primitive_needs = {}\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable snapshot of a CraftState.\"\"\"\n      # Position, direction, inventory tuple, and raw grid bytes.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_PLAN_LEN = 400                     # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)   # default actions count\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow\n      if cur_state.satisfies(\"\", goal_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:55:22.536564", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory tuple, and raw grid bytes.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 400                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default: 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories.\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the search budget.\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:55:52.344400", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # ------------------------------------------------------------------\n  # Action indices (as defined by CraftLab)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  else:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return coordinates of the closest cell containing kind_idx, or None.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of `cell` not in `avoid`, or None.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos          # (y, x)\n  harvested = set()            # cells we have already collected from\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort planning.\n              return actions\n\n          # Find a free adjacent cell to stand on while harvesting.\n          adj = adjacent_free(target, avoid=harvested)\n          if adj is None:\n              # No place to stand; abort.\n              return actions\n\n          # Move to that adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a move in its direction; the move will be blocked,\n          # but the subsequent USE will interact with the cell in front).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick it up.\n          actions.append(USE)\n\n          # Update internal grid to reflect that the primitive has been removed.\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is None:\n          return actions\n      ws_adj = adjacent_free(ws_cell, avoid=harvested)\n      if ws_adj is None:\n          ws_adj = cur_pos  # stay where we are; still attempt USE\n      actions += bfs_path(cur_pos, ws_adj)\n      cur_pos = ws_adj\n\n      dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n      if dy == 1:\n          actions.append(DOWN)\n      elif dy == -1:\n          actions.append(UP)\n      elif dx == 1:\n          actions.append(RIGHT)\n      elif dx == -1:\n          actions.append(LEFT)\n\n  # Trigger the crafting action.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:55:53.518261", "function_name": "make_arrow", "function_body": "  # Reset the environment and grab useful objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # ------------------------------------------------------------------\n  # Action indices (as defined by CraftLab)\n  # ------------------------------------------------------------------\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}  # (y,x) -> (prev_y, prev_x, action)\n      while q:\n          y, x = q.popleft()\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x, act)\n              if (ny, nx) == goal:\n                  # reconstruct actions\n                  actions = []\n                  cur = goal\n                  while cur != start:\n                      py, px, a = parent[cur]\n                      actions.append(a)\n                      cur = (py, px)\n                  actions.reverse()\n                  return actions\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (caller may handle failure)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return (int(nearest[0]), int(nearest[1]))\n\n  def adjacent_free(cell):\n      \"\"\"Return a free neighbour of `cell` (or None if none exist).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort.\n              return actions\n\n          # Find a free cell adjacent to the primitive.\n          stand = adjacent_free(target)\n          if stand is None:\n              # No place to stand next to the primitive \u2013 abort.\n              return actions\n\n          # Move to the standing position.\n          actions += bfs_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (issue a move in that direction; it will be blocked).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid to reflect that the primitive has been harvested.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Go to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is None:\n          return actions\n      ws_adj = adjacent_free(ws_cell)\n      if ws_adj is None:\n          # If we cannot stand next to the workshop, stay where we are and just face it.\n          ws_adj = cur_pos\n      actions += bfs_path(cur_pos, ws_adj)\n      cur_pos = ws_adj\n\n      dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n      if dy == 1:\n          actions.append(DOWN)\n      elif dy == -1:\n          actions.append(UP)\n      elif dx == 1:\n          actions.append(RIGHT)\n      elif dx == -1:\n          actions.append(LEFT)\n\n  # Trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:56:14.385417", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and fetch current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for bookkeeping\n\n  # Index of the goal item (\"arrow\") and its primitive requirements\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if the cell at ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"\n      Find a shortest walkable path from ``start`` to ``goal`` avoiding\n      non\u2011grabbable cells. Returns a list of positions (excluding ``start``,\n      including ``goal``). If no path exists, returns an empty list.\n      \"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # no path found\n\n      # Reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into a list of movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"\n      Return a walkable neighbour of ``target`` that is not occupied by a\n      non\u2011grabbable entity. Preference order: N, S, W, E. If none found,\n      return the target itself (assumed walkable for collection purposes).\n      \"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not found \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive itself\n          path = bfs_path(cur, prim_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local copy of the grid to reflect collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # Move to the appropriate workshop (if the recipe specifies one)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:56:15.530027", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for bookkeeping\n\n  # Index of the goal item (\"arrow\") and its primitive requirements\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if the cell at ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"\n      Find a shortest walkable path from ``start`` to ``goal`` avoiding\n      non\u2011grabbable cells. Returns a list of positions (excluding ``start``,\n      including ``goal``). If no path exists, returns an empty list.\n      \"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # no path found\n\n      # Reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into a list of movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"\n      Return a walkable neighbour of ``target`` that is not occupied by a\n      non\u2011grabbable entity. Preference order: N, S, W, E. If none found,\n      return the target itself (assumed walkable for collection purposes).\n      \"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not found \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive itself\n          path = bfs_path(cur, prim_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local copy of the grid to reflect collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # Move to the appropriate workshop (if the recipe specifies one)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
