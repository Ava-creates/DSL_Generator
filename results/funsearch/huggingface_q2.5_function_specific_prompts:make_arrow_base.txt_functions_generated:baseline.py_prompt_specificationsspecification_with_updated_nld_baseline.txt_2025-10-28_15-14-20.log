{"timestamp": "2025-10-28T18:49:33.564436", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      nonlocal pos\n      for a in path:\n          if a == 0:\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1:\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2:\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3:\n              pos = (pos[0] + 1, pos[1])\n\n  def collect_primitive(prim_idx, amount):\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break\n          best_path = None\n          best_loc = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  best_path = path\n                  best_loc = loc\n                  break\n          if best_path is None:\n              break\n          actions.extend(best_path)\n          move_along(best_path)\n          actions.append(4)\n          grid[best_loc[0], best_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          amount -= 1\n\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, needed):\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < needed:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, needed - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          actions.append(4)\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:50:00.832435", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  # ------------------------------------------------------------------\n  # 1) Resolve recipe for \u201carrow\u201d: primitives needed and crafting order\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # (item_idx, count) in dependency order\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafts.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):        # ignore special keys like \"_at\"\n              resolve(ing, cnt * mult)\n      craft_steps.append((item_idx, mult))\n\n  resolve(goal_idx, 1)\n\n  # ------------------------------------------------------------------\n  # 2) Static environment data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 3) Helper: BFS returning a list of action indices that reaches any\n  #    cell in `targets` while avoiding `blocked` cells.\n  # ------------------------------------------------------------------\n  def bfs(start, targets):\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []   # unreachable (should not happen in a valid scenario)\n\n  # ------------------------------------------------------------------\n  # 4) Helper: move to a cell containing `kind_idx` and USE `count` times\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  def collect(kind_idx, count):\n      nonlocal pos\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 5) Gather all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed_prims.items():\n      collect(kind_idx, cnt)\n\n  # ------------------------------------------------------------------\n  # 6) Perform crafting steps at the appropriate workshops\n  # ------------------------------------------------------------------\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:50:01.954126", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Constants and helpers\n  # ------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n  ACTION_USE = 4\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of movement actions that reaches any cell in `targets`.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # no path (should not happen for valid tasks)\n\n  def acquire(kind_idx, count):\n      \"\"\"Move to cells containing `kind_idx` and USE `count` times.\"\"\"\n      nonlocal pos, actions, mutable_grid\n      for _ in range(count):\n          # locate any remaining instance of the required kind\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if mutable_grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n          # mark the collected item as removed from the local copy\n          mutable_grid[pos[0], pos[1], kind_idx] = max(\n              0, mutable_grid[pos[0], pos[1], kind_idx] - 1)\n\n  # ------------------------------------------------------------------\n  # 1) Parse recipe for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}      # primitive kind idx -> total amount required\n  craft_steps = []       # list of (item_idx, multiplier) in order\n\n  def resolve(item_idx, multiplier):\n      \"\"\"Recursively collect primitive requirements and schedule crafts.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # first resolve all ingredient items (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # then schedule this item to be crafted\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(goal_idx, 1)\n\n  # ------------------------------------------------------------------\n  # 2) Static environment information\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  mutable_grid = grid.copy()                     # local copy to track pickups\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 3) Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 3a) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      acquire(kind_idx, cnt)\n\n  # 3b) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # locate any workshop cell of the required type\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # use the workshop the needed number of times\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:50:23.087060", "function_name": "make_arrow", "function_body": "  # Reset environment and initialise structures\n  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()                     # name \u2192 id\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Movement deltas for the four cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is Chebyshev\u2011adjacent (\u22641 in both axes)\n  # to any cell in `targets`. Only completely empty cells may be walked\n  # through.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Find all cells currently holding this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive no longer present \u2013 abort further attempts\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort further attempts for this primitive\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Use action to pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate all workshop cells of the appropriate kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use action at the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled sequence of action IDs\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:50:24.201781", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n  act_map = env.action_specs()\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  move_delta = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None\n\n  # Collect primitives\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              break\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              break\n          for act_name in path:\n              aid = act_map[act_name]\n              actions.append(aid)\n              env.step(aid)\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Go to workshop and craft\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  aid = act_map[act_name]\n                  actions.append(aid)\n                  env.step(aid)\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:50:49.931379", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Initialise the environment\n  env.reset()\n  act_map = env.action_specs()                     # action name \u2192 id\n  goal_idx = env.task.goal                         # index of the desired item\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)          # workshop type index, if any\n\n  # Movement deltas for the four cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through completely empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n\n      # Have we collected everything we need?\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed.items()):\n          break\n\n      # Identify a missing primitive\n      missing_idx = None\n      for p_idx, cnt in needed.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n      if missing_idx is None:\n          break  # should not happen\n\n      # Locate cells that currently contain this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Required primitive {missing_idx} not found on the map.\")\n\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive with the USE action\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop is needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:50:51.067289", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh start\n  env.reset()\n  # Mapping from action name to integer id\n  act_map = env.action_specs()\n  # Goal item index\n  goal_idx = env.task.goal\n  # Primitive requirements (recursive) for the goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n  # Recipe for the goal (may specify a workshop)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Cardinal movement deltas\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through completely empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting required counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      # Check if we already have enough of each primitive\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed.items()):\n          break\n\n      # Find a primitive we still need more of\n      missing_idx = None\n      for p_idx, cnt in needed.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n      if missing_idx is None:\n          break\n\n      # Locate cells that currently contain this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Required primitive {missing_idx} not found on the map.\")\n\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive with the USE action\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:51:26.506069", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  spec = env.action_specs()\n  DOWN = spec[\"DOWN\"]\n  UP = spec[\"UP\"]\n  LEFT = spec[\"LEFT\"]\n  RIGHT = spec[\"RIGHT\"]\n  USE = spec[\"USE\"]\n\n  actions = []\n  goal = env.task.goal\n  cookbook = env.world.cookbook\n\n  # current state snapshot (will be mutated locally)\n  state = env._current_state\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  width, height = grid.shape[:2]\n\n  non_grabbable = list(env.world.non_grabbable_indices)\n\n  def _blocked_cells():\n      \"\"\"Return a boolean mask of cells that cannot be stepped on.\"\"\"\n      if non_grabbable:\n          return np.any(grid[:, :, non_grabbable] > 0, axis=2)\n      return np.zeros((width, height), dtype=bool)\n\n  def bfs(start, target):\n      \"\"\"Bread\u2011first search avoiding non\u2011grabbable cells.\"\"\"\n      blocked = _blocked_cells()\n      # we are allowed to step onto the target even if it would otherwise be blocked\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      parent = {start: None}\n      action_to = {}\n\n      moves = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      action_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # reconstruct path\n      seq = []\n      cur = target\n      while cur != start:\n          seq.append(action_to[cur])\n          cur = parent[cur]\n      seq.reverse()\n      return seq\n\n  def manhattan_path(start, target):\n      \"\"\"Fallback path that ignores obstacles.\"\"\"\n      seq = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          seq.append(DOWN)\n          x += 1\n      while x > tx:\n          seq.append(UP)\n          x -= 1\n      while y < ty:\n          seq.append(RIGHT)\n          y += 1\n      while y > ty:\n          seq.append(LEFT)\n          y -= 1\n      return seq\n\n  def move_to(tgt):\n      \"\"\"Move the agent to `tgt`, updating `pos` and `actions`.\"\"\"\n      nonlocal pos\n      if pos == tgt:\n          return\n      path = bfs(pos, tgt)\n      if path is None:\n          path = manhattan_path(pos, tgt)\n      actions.extend(path)\n      pos = tgt\n\n  # -----------------------------------------------------------------\n  # Determine primitive requirements for the goal.\n  # -----------------------------------------------------------------\n  required = cookbook.primitives_for(goal).copy()\n  # If the goal itself is a primitive (no recipe), we need one of it.\n  if not required and goal in cookbook.primitives:\n      required = {goal: 1}\n\n  # -----------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # -----------------------------------------------------------------\n  for prim_idx, need_cnt in required.items():\n      have = int(inventory[prim_idx])\n      to_collect = max(0, need_cnt - have)\n\n      for _ in range(to_collect):\n          # locate remaining instances of this primitive on the map\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more instances left; break early.\n              break\n\n          # choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          move_to(target)\n          actions.append(USE)  # pick up the primitive\n\n          # update simulated world state\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # -----------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the goal.\n  # -----------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(state.grid[:, :, ws_idx] > 0)))\n      if ws_locations:\n          target_ws = min(\n              ws_locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          move_to(target_ws)\n          actions.append(USE)  # craft at the workshop\n  else:\n      # No specific workshop required; just use the craft action here.\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:51:27.646580", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN = spec[\"DOWN\"]\n  UP = spec[\"UP\"]\n  LEFT = spec[\"LEFT\"]\n  RIGHT = spec[\"RIGHT\"]\n  USE = spec[\"USE\"]\n\n  state = env._current_state\n  pos = tuple(state.pos)\n  goal = env.task.goal\n  cookbook = env.world.cookbook\n\n  # Determine required primitives (handle primitive goal)\n  required = cookbook.primitives_for(goal).copy()\n  if not required and goal in getattr(cookbook, \"primitives\", set()):\n      required = {goal: 1}\n\n  # Simulated mutable copies of grid and inventory\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  width, height = grid.shape[:2]\n\n  # Pre\u2011compute blocked cells (non\u2011grabbable entities)\n  non_grab = list(env.world.non_grabbable_indices)\n  if non_grab:\n      base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      base_blocked = np.zeros((width, height), dtype=bool)\n\n  # -----------------------------------------------------------------\n  # BFS pathfinder that avoids blocked cells; optionally allow stepping\n  # onto the target even if it would normally be blocked.\n  # -----------------------------------------------------------------\n  def bfs(start, target, allow_target=False):\n      blocked = base_blocked.copy()\n      if allow_target:\n          blocked[target[0], target[1]] = False\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n      moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (RIGHT, (0, 1)), (LEFT, (0, -1))]\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = a\n                      q.append(nxt)\n      if target not in parent:\n          return None\n      path = []\n      cur = target\n      while cur != start:\n          path.append(act_to[cur])\n          cur = parent[cur]\n      path.reverse()\n      return path\n\n  # Simple Manhattan fallback (ignores obstacles)\n  def manhattan(start, target):\n      seq = []\n      dx = target[0] - start[0]\n      dy = target[1] - start[1]\n      if dx > 0:\n          seq += [DOWN] * dx\n      elif dx < 0:\n          seq += [UP] * (-dx)\n      if dy > 0:\n          seq += [RIGHT] * dy\n      elif dy < 0:\n          seq += [LEFT] * (-dy)\n      return seq\n\n  actions = []\n\n  # -----------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # -----------------------------------------------------------------\n  for prim_idx, need_cnt in required.items():\n      have = int(inventory[prim_idx])\n      to_collect = max(0, need_cnt - have)\n      for _ in range(to_collect):\n          # Find remaining instances of this primitive on the map\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              break  # none left\n          # Choose the nearest instance (Manhattan distance)\n          target = min(locations, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs(pos, target, allow_target=True)\n          if path is None:\n              path = manhattan(pos, target)\n          actions.extend(path)\n          actions.append(USE)  # pick up the primitive\n          # Update simulated world state\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # -----------------------------------------------------------------\n  # Move to workshop (if any) and craft the goal item.\n  # -----------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(state.grid[:, :, ws_idx] > 0)))\n      if ws_locations:\n          target_ws = min(ws_locations, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs(pos, target_ws, allow_target=True)\n          if path is None:\n              path = manhattan(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)  # craft at workshop\n  else:\n      # No specific workshop required; just use the craft action here.\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:51:53.965430", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of actions that moves from *start* to any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # cells with any entity are blocked unless they are a goal\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update *pos* following the actions in *path*.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:      # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1:    # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2:    # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3:    # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(kind_idx, needed):\n      \"\"\"Collect *needed* units of primitive *kind_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, kind_idx] > 0]\n          if not locations:\n              break\n          best_path = None\n          best_loc = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  best_path = path\n                  best_loc = loc\n                  break\n          if best_path is None:\n              break\n          actions.extend(best_path)\n          move_along(best_path)\n          actions.append(4)                # USE\n          grid[best_loc[0], best_loc[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure(item_idx, amount):\n      \"\"\"Make sure *inventory[item_idx]* >= *amount*.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # obtain all ingredients first\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure(ing_idx, cnt)\n\n          # move to required workshop if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # craft one unit\n          actions.append(4)                # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the arrow\n  ensure(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:51:55.091858", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # current representations\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of actions (DOWN,UP,LEFT,RIGHT) to reach any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # treat any occupied cell as blocked, except if it is a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update *pos* according to a sequence of movement actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, amount):\n      \"\"\"Collect *amount* units of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # nothing left to collect\n          # pick the first reachable location (BFS guarantees shortest)\n          path = None\n          target_loc = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path = cand\n                  target_loc = loc\n                  break\n          if path is None:\n              break  # cannot reach any remaining primitive\n          actions.extend(path)\n          move_along(path)\n          # pick up the primitive\n          actions.append(4)  # USE\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          amount -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, needed):\n      \"\"\"Guarantee that *inventory[item_idx]* >= *needed* by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < needed:\n          if item_idx in primitives_set:\n              # Primitive: just collect the missing amount\n              collect_primitive(item_idx, needed - inventory[item_idx])\n              continue\n\n          # Crafting path\n          recipe = recipes.get(item_idx, {})\n          # Ensure all ingredients are present\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to the required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # Perform the craft\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:52:26.699283", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n  H, W = grid.shape[:2]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves the\n      agent from ``start`` to ``goal`` while avoiding non\u2011grabbable obstacles.\"\"\"\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions_rev = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      actions_rev.append(DOWN)\n                  elif py == cur[0] + 1:\n                      actions_rev.append(UP)\n                  elif px == cur[1] - 1:\n                      actions_rev.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # blocked if any non\u2011grabbable entity occupies the cell\n                  if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen in valid scenarios)\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locs[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using\n          adj = None\n          neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          for ny, nx in neighbours:\n              if 0 <= ny < H and 0 <= nx < W:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell itself\n              adj = (ty, tx)\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a movement action that would step into it)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:52:27.818990", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n  H, W, _ = grid.shape\n\n  # Action indices (as defined by CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable\n      obstacles.  Simple BFS over the grid.\"\"\"\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # Reconstruct actions\n              actions_rev = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      actions_rev.append(DOWN)\n                  elif py == cur[0] + 1:\n                      actions_rev.append(UP)\n                  elif px == cur[1] - 1:\n                      actions_rev.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # Cell is blocked if any non\u2011grabbable entity is present\n                  if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen in valid scenarios)\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Locate the nearest cell that still contains at least one entity of ``kind``.\n      Returns ``(y, x)`` or ``None``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort planning\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using\n          adj = None\n          for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n              if 0 <= ny < H and 0 <= nx < W:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour \u2013 fallback to the primitive cell itself\n              adj = (ty, tx)\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a movement step that would step into it)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid: remove one instance of the collected primitive\n          grid[ty, tx, prim_idx] = max(0, grid[ty, tx, prim_idx] - 1)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:52:54.813698", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Locate the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # BFS planning utilities\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 800                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action count (UP,DOWN,LEFT,RIGHT,USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: inventory contains at least one arrow\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
