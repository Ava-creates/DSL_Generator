{"timestamp": "2025-10-28T18:36:49.082039", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper mappings between movement directions and action indices.\n  # (DOWN,UP,LEFT,RIGHT) correspond to action IDs 0\u20114 in CraftLab.\n  # ----------------------------------------------------------------------\n  DIR2ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search returning a list of actions that moves the agent\n  # from ``start`` to a cell that is Manhattan\u2011adjacent to any cell in\n  # ``targets``.  Cells occupied by any entity are considered blocked.\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs(start, targets, grid):\n      \"\"\"Return actions to reach a neighbour of one of ``targets``.\"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)          # any occupied cell blocks movement\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise state information.\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy for planning\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal item index.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Primitive requirements for the goal.\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      # Goal itself may be a primitive we just need to pick up.\n      primitives_needed = {goal_idx: 1}\n\n  plan = []  # List of action indices to be returned.\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive resources.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          # Locate cells that still contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan\n\n          # Find a path to a neighbour of the nearest primitive cell.\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Update simulated position.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive (USE action = 4).\n          plan.append(4)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              break  # Unexpected; avoid infinite loop.\n\n          # Remove one instance from the simulated grid and decrement counter.\n          grid[adj[0], adj[1], prim_idx] -= 1\n          needed_cnt -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Update simulated position.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(4)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:36:50.208827", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Mapping between movement vectors and action indices (as defined in CraftLab)\n  # ----------------------------------------------------------------------\n  DIR_TO_ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search returning a list of actions that moves the agent\n  # from ``start`` to a cell that is Manhattan\u2011adjacent to any cell in\n  # ``targets``.  Cells occupied by any entity are considered blocked.\n  # ----------------------------------------------------------------------\n  def bfs(start, targets, grid):\n      \"\"\"Return a list of actions to reach a neighbour of one of ``targets``.\"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid, axis=2)            # any kind present blocks movement\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency \u2013 return empty list.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Extract current state information.\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy for planning\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal index is stored in the task object.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in the environment's task.\")\n\n  # Primitive requirements for the goal (primitive kind \u2192 count).\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  plan = []  # List of action indices to be returned.\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive resources.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              return plan\n\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Update simulated position.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use the primitive (action index 4 corresponds to USE).\n          plan.append(4)\n\n          # Find the primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              break  # unexpected; safeguard against infinite loop\n\n          # Remove one instance from the simulated grid and decrement counter.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          needed_cnt -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get('_at') or recipe.get('_key')\n  if workshop_key is not None:\n      # Resolve workshop kind index (string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Update simulated position.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft the item by using the workshop.\n          plan.append(4)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:37:54.856260", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n  # get goal and recipe info\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  act_map = env.action_specs()\n  move_delta = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return list of action names moving from start to a cell adjacent (Chebyshev <=1) to any target.\"\"\"\n      W, H = grid.shape[:2]\n      visited = np.zeros((W, H), dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # check adjacency\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # expand\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny].sum() == 0:  # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None\n\n  # collect primitives\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              continue\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              continue\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n          # pick up\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # move to workshop and craft\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n          # craft\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:37:55.971604", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal index and its recipe information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Mapping from action name to integer ID\n  act_map = env.action_specs()\n\n  # Cardinal movement deltas (used by BFS)\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent from\n  # `start` to a cell that is adjacent (Chebyshev distance \u2264 1) to any cell\n  # in `targets`. Only empty cells (no entity) may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.zeros((W, H), dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh current state after each step\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells that contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present in the world \u2013 abort collection\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 abort collection\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Use action to pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after primitive collection\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate workshop cells of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use action at the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled sequence of action IDs\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:38:22.540438", "function_name": "make_arrow", "function_body": "  \"\"\"Plan actions to craft the goal item (e.g., 'arrow') in the given CraftLab environment.\n\n  The planner:\n  1. Queries the cookbook for all primitive resources required for the goal.\n  2. Repeatedly moves to the nearest instance of each needed primitive,\n     uses the ``USE`` action to pick it up, and updates a local copy of the grid.\n  3. After all primitives are collected, moves adjacent to the required workshop\n     (if the recipe specifies one) and uses ``USE`` to craft the goal.\n\n  The function returns a flat list of action indices that can be fed directly\n  to the environment via ``env.step(action)``.\n  \"\"\"\n  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action / direction helpers (as defined by CraftLab)\n  # ----------------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of actions moving the agent\n  # from ``start`` to a cell adjacent (Manhattan distance 1) to any of\n  # the ``targets`` while avoiding blocked cells.\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Return actions to reach a cell adjacent to any target.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Cells occupied by any non\u2011grabbable entity are considered blocked.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise state information\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                 # mutable copy of the world grid\n  pos = tuple(state.pos)                   # (x, y)\n\n  # Goal index is stored in the task (env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Determine all primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ----------------------------------------------------------------------\n  for kind_idx, remaining in needed.items():\n      while remaining > 0:\n          # Find cells that currently contain this primitive.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present on the map \u2013 abort planning.\n              return plan\n\n          # Compute a path to the nearest reachable primitive (adjacent).\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update the agent's position.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update the simulated grid and decrement the requirement.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          remaining -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      # Locate cells that contain the workshop.\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to the workshop.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  # Return the full action sequence.\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:38:23.667935", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined in CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR_TO_ACT = {\n      (0, 1): ACTION_DOWN,\n      (0, -1): ACTION_UP,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  def bfs(start, targets, grid):\n      \"\"\"Bread\u2011first search returning actions that move the agent from ``start``\n      to a cell adjacent to any ``targets`` while avoiding blocked cells.\"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []\n\n  # ------------------------------------------------------------------\n  # Gather current state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  # Goal index stored in env.task.goal (could be int or Struct)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal not found in env.task\")\n\n  # ------------------------------------------------------------------\n  # Determine primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan\n\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(ACTION_USE)\n\n          adj = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              break\n\n          grid[adj[0], adj[1], prim_idx] -= 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:38:41.588405", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Reset environment and extract useful information\n  # ------------------------------------------------------------------\n  env.reset()\n  act_map = env.action_specs()                     # name \u2192 action id\n  goal_idx = env.task.goal                         # index of desired item\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)          # workshop kind index, if any\n\n  # ------------------------------------------------------------------\n  # Movement deltas for the four cardinal actions\n  # ------------------------------------------------------------------\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of *action names* moving the agent\n  # from `start` to a cell adjacent (Chebyshev distance \u2264 1) to any cell\n  # in `targets`. Traversal is allowed only through completely empty cells.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through empty cells (no entities)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n\n      # Break when we have enough of every required primitive\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed.items()):\n          break\n\n      # Find a primitive that is still missing\n      missing_idx = None\n      for p_idx, cnt in needed.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n      if missing_idx is None:\n          break\n\n      # Locate all cells that currently contain this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Required primitive {missing_idx} not found on the map.\")\n\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive with the USE action\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop is needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:38:42.710304", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and get useful mappings\n  env.reset()\n  act_map = env.action_specs()                # name \u2192 int id\n  goal_idx = env.task.goal                    # index of desired item\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)     # workshop kind index, if any\n\n  # Movement delta for each direction name\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  actions = []\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of direction names moving from `start` to a cell\n      adjacent (Chebyshev distance \u2264 1) to any cell in `targets`.\n      Only cells with zero occupancy may be traversed.\"\"\"\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          (x, y), path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(x - tx), abs(y - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for name, (dx, dy) in move_delta.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through completely empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed.items()):\n          break  # all needed primitives collected\n\n      # Find a primitive that is still missing\n      missing_idx = None\n      for p_idx, cnt in needed.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n      if missing_idx is None:\n          break\n\n      # Locate all cells currently containing this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Primitive {missing_idx} not present on the map.\")\n\n      # Plan path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} unreachable from {state.pos}.\")\n\n      # Execute movement actions\n      for name in path:\n          aid = act_map[name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if required) and craft\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop unreachable from current position.\")\n      for name in path:\n          aid = act_map[name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:39:02.792506", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state references\n  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify goal index for \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # arrow not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # positions the agent so that the cell directly in front contains\n  # `target_kind`. Returns [] if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      import numpy as np\n      from collections import deque\n\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # direction deltas matching action indices\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = state.pos\n      sd = state.dir\n      q = deque()\n      q.append((sx, sy, sd, []))\n      visited = {(sx, sy, sd)}\n\n      while q:\n          x, y, d, acts = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n      return []  # unreachable\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # 1) Collect required primitives for a single arrow.\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          # If we cannot move but are already adjacent, still allow a USE.\n          if not move_seq and not cur_state.next_to(prim_idx):\n              # Primitive unreachable \u2013 abort planning.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          # Keep state in sync.\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # 2) Craft the arrow at its required workshop (if any).\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      actions.extend(move_seq)\n      actions.append(4)  # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 attempt crafting in place.\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:39:03.926139", "function_name": "make_arrow", "function_body": "  # Reset the environment and get the current state and world objects\n  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:       # arrow not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if the target is already in\n  # front, or [] if unreachable (handled later).\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # direction deltas matching action indices\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      start_x, start_y = state.pos\n      start_dir = state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return []   # unreachable\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  plan_actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # --------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          # If BFS failed and we are not already facing the primitive, abort.\n          if not move_seq:\n              # Check whether the cell in front already holds the primitive.\n              dir_dx, dir_dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[cur_state.dir]\n              fx, fy = cur_state.pos[0] + dir_dx, cur_state.pos[1] + dir_dy\n              if not (0 <= fx < cur_state.grid.shape[0] and\n                      0 <= fy < cur_state.grid.shape[1] and\n                      cur_state.grid[fx, fy, prim_idx] > 0):\n                  return plan_actions   # unreachable primitive\n          plan_actions.extend(move_seq)\n          plan_actions.append(4)   # USE to pick up\n\n          # Apply actions to keep cur_state up\u2011to\u2011date.\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      plan_actions.extend(move_seq)\n      plan_actions.append(4)   # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 attempt crafting in place.\n      plan_actions.append(4)   # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return plan_actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:39:30.547606", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Basic utilities: directions and BFS pathfinder\n  # --------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]   # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action ids that moves from ``start`` to the\n      nearest cell in ``targets`` while avoiding ``blocked`` cells.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 should not happen for a solvable scenario\n      return []\n\n  # --------------------------------------------------------------\n  # Helper to move to a cell containing ``kind_idx`` and USE it ``cnt`` times\n  # --------------------------------------------------------------\n  def acquire(kind_idx, cnt):\n      \"\"\"Collect ``cnt`` items of type ``kind_idx`` from the grid.\"\"\"\n      nonlocal pos, actions, grid\n      for _ in range(cnt):\n          # locate all cells that currently hold this kind\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          # find shortest path to the nearest such cell\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          # update position while walking\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # pick up the item\n          actions.append(4)          # USE\n          # remove it from our mutable copy of the grid\n          grid[pos[0], pos[1], kind_idx] -= 1\n\n  # --------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # --------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Resolve full dependency tree:\n  #   * needed_prims \u2013 total primitive counts required\n  #   * craft_steps  \u2013 ordered list of (item_idx, count) to craft\n  # ------------------------------------------------------------------\n  needed_prims = {}          # primitive idx \u2192 total count\n  craft_steps = []           # (item_idx, count) in dependency order\n\n  def resolve(item_idx, mul):\n      \"\"\"Recursively expand ``item_idx`` multiplying required count by ``mul``.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul\n          return\n      # Resolve ingredients first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mul)\n      # Schedule this item to be crafted after its ingredients\n      craft_steps.append((item_idx, mul))\n\n  resolve(arrow_idx, 1)\n\n  # --------------------------------------------------------------\n  # Static data: mutable copy of the grid, blocked cells, dimensions\n  # --------------------------------------------------------------\n  grid = env._current_state.grid.copy()\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # --------------------------------------------------------------\n  # Build the final action sequence\n  # --------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect every primitive required by the whole recipe tree\n  for prim_idx, cnt in needed_prims.items():\n      acquire(prim_idx, cnt)\n\n  # 2) Perform crafting steps in the order produced by ``resolve``\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      workshop_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # locate workshop cells\n      workshop_cells = {(x, y) for x in range(w) for y in range(h)\n                        if grid[x, y, workshop_idx] > 0}\n      path = bfs(pos, workshop_cells, blocked)\n      actions.extend(path)\n      # update position after walking\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # use the workshop the required number of times\n      actions.extend([4] * cnt)   # USE\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
