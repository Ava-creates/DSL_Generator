{"timestamp": "2025-10-29T00:16:25.733610", "function_name": "make_arrow", "function_body": "  \"\"\"Improved version of `make_arrow_v0`.\"\"\"\n  import numpy as np\n  import collections\n\n  # ----------------------------------------------------------------------\n  # Action identifiers \u2013 match the default CraftWorld ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells that contain any entity are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # If already adjacent, no movement needed.\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              # Check adjacency to any target.\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Retrieve world / state objects from the environment (handle wrappers).\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use current position.\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # shape (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells currently holding this primitive.\n          prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          # Exclude cells we have already harvested.\n          prim_cells = [c for c in prim_cells if c not in harvested]\n          if not prim_cells:\n              # No more of this primitive on the map.\n              break\n\n          # Choose the nearest primitive (Manhattan distance).\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update position.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the cell becomes empty after pickup.\n          occupied[target] = False\n          # Also clear the primitive from the grid representation.\n          grid[:, :, prim_idx][target] = 0\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n\n      # Locate workshop cells.\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          # No workshop found; attempt to use current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:16:56.955897", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # helper bfs to adjacency\n  def bfs_adj(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  # helper to update position\n  def apply_path(pos, path):\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # locate world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in env.\")\n  cookbook = world.cookbook\n\n  # goal arrow\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # primitive requirements\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n\n  # make sure episode started\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)\n  grid = state.grid\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []\n  taken = set()\n\n  # collect primitives\n  for prim_idx, need in primitives_needed.items():\n      # locate all cells with this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by distance from current pos\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= need:\n              break\n          if cell in taken:\n              continue\n          path = bfs_adj(pos, [cell], occupied)\n          actions.extend(path)\n          pos = apply_path(pos, path)\n\n          actions.append(USE)\n\n          occupied[cell[0], cell[1]] = False\n          taken.add(cell)\n          collected += 1\n\n  # move to workshop if required and craft\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop '{workshop_key}' found.\")\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = bfs_adj(pos, [target_ws], occupied)\n      actions.extend(path)\n      pos = apply_path(pos, path)\n      actions.append(USE)\n  else:\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:16:58.060179", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n  DOWN, UP, LEFT, RIGHT, USE = 0,1,2,3,4", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-29T00:17:31.405000", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start` to a\n  # cell adjacent (Manhattan distance = 1) to any cell in `targets`.\n  # Occupied cells (any non\u2011zero entry in the grid) are treated as walls.\n  # ------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Ensure we start from a fresh episode.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in state.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid                       # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)     # True where movement is blocked\n\n  actions = []            # final action sequence\n  collected_cells = set() # primitives already harvested\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      gathered = 0\n      # locate all cells that currently contain this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      while gathered < needed:\n          # recompute distances from current position\n          cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          # pick the nearest not yet collected cell\n          target = None\n          for cell in cells:\n              if cell not in collected_cells:\n                  target = cell\n                  break\n          if target is None:\n              raise RuntimeError(\"Not enough primitives available for arrow.\")\n          # move adjacent to the primitive\n          path = _bfs_to_adjacent(pos, [target], occupied)\n          actions.extend(path)\n          # update our notion of position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # pick up the primitive\n          actions.append(USE)\n          # after collection the cell becomes empty \u2013 update occupancy\n          occupied[target[0], target[1]] = False\n          collected_cells.add(target)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found.\")\n      # choose nearest workshop\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_to_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # craft the arrow\n      actions.append(USE)\n  else:\n      # No specific workshop \u2013 just use the craft action at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:17:32.555653", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # ----------------------------------------------------------------------\n  # Action constants (standard CraftWorld actions)\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start` to a cell\n  # adjacent (Manhattan distance = 1) to any cell in `targets`.  Occupied\n  # cells (any non\u2011zero entry in the grid) are treated as walls.\n  # ----------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the underlying CraftWorld instance and its cookbook.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the internal state.\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not locate CraftWorld instance inside env.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we start from a fresh episode.\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  # Current position, grid and occupancy map.\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid                           # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)         # True where movement is blocked\n\n  actions = []            # final action sequence\n  collected_cells = set() # primitives already harvested\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, need in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from our current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      gathered = 0\n      for cell in cells:\n          if gathered >= need:\n              break\n          if cell in collected_cells:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_to_adjacent(pos, [cell], occupied)\n          actions.extend(path)\n          # Update our notion of position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # After collection the cell becomes empty \u2013 update occupancy.\n          occupied[cell[0], cell[1]] = False\n          collected_cells.add(cell)\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found.\")\n      # Choose the nearest workshop.\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_to_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # Craft the arrow.\n      actions.append(USE)\n  else:\n      # No specific workshop \u2013 just use the craft action at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:17:59.610780", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash(st):\n      # Position, direction, inventory tuple, and immutable grid snapshot\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default to 5 (4 moves + USE)\n\n  # Prefer USE action (usually last index) to speed up collection/crafting\n  action_order = list(range(n_actions - 1, -1, -1))\n\n  while frontier:\n      node = frontier.popleft()\n      state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in action_order:\n          _, next_state = state.step(a)\n          key = _hash(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:18:15.278339", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects.\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\".\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode.\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search over (state, action_sequence) pairs.\n  # ------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory (as a tuple), and full grid bytes.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_hash_state(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default to 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test \u2013 have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _hash_state(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search limits.\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:18:44.685154", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action constants (as defined in CraftWorld)\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells where any kind is present are treated as obstacles.\n  # ----------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent to a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:                                     # env may be a wrapper\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found inside env.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow: {kind_idx: count}\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Ensure we start with a fresh episode.\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)                # current (x, y)\n  grid = state.grid                      # (W, H, n_kinds)\n\n  # Occupancy map \u2013 True where any entity blocks movement.\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []               # final action list\n  harvested = set()          # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells that currently contain this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed:\n              break\n          if cell in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_to_adjacent(pos, [cell], occupied)\n          actions.extend(path)\n          # Update our internal position according to the path.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell as empty for future path\u2011finding.\n          if grid[cell[0], cell[1], prim_idx] == 1:\n              occupied[cell[0], cell[1]] = False\n          harvested.add(cell)\n          collected += 1\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (name \u2192 int) if needed.\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found.\")\n      # Choose the nearest workshop.\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_to_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # Craft the arrow.\n      actions.append(USE)\n  else:\n      # No specific workshop \u2013 just use the current cell.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:18:45.839983", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # ----------------------------------------------------------------------\n  # Action constants (standard CraftWorld actions)\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells where `occ` is True are treated as walls.\n  # ----------------------------------------------------------------------\n  def _bfs_to_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent to any target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found inside env.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Ensure we are at the beginning of an episode.\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Current state information.\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid                       # (W, H, n_kinds)\n\n  # Occupancy map: True where any entity blocks movement.\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []            # final action sequence\n  harvested = set()       # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (nearest\u2011first greedy).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed:\n              break\n          if cell in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_to_adjacent(pos, [cell], occupied)\n          actions.extend(path)\n          # Update our notion of position while walking.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # The cell becomes empty \u2013 update occupancy for later planning.\n          occupied[cell[0], cell[1]] = False\n          harvested.add(cell)\n          collected += 1\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop '{workshop_key}' found in the scenario.\")\n      # Choose the nearest workshop.\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_to_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # Craft the arrow.\n      actions.append(USE)\n  else:\n      # No workshop required \u2013 simply use at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:19:11.379917", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:19:27.080903", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to uniquely identify a state for the visited set\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # BFS initialization\n  frontier = deque([Node(init_state, [])])\n  visited = { _state_hash(init_state) }\n\n  # Parameters\n  MAX_PLAN_LEN = 1500                      # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: arrow present in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:19:53.232525", "function_name": "make_arrow", "function_body": "  import collections\n  from collections import deque, namedtuple\n\n  # Retrieve scenario and world objects, handling possible wrappers\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # BFS structures\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_PLAN_LEN = 400          # safety cutoff\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 8, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:20:08.253481", "function_name": "make_arrow", "function_body": "  import collections\n  from collections import deque, namedtuple\n\n  # Retrieve scenario and world objects (handle possible wrappers)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state for this episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  MAX_PLAN_LEN = 300  # safety cutoff to avoid infinite search\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 8, "scores": {"3": 2.9}}
