{"timestamp": "2025-10-28T15:59:26.093426", "function_name": "make_arrow", "function_body": "  actions = []\n  # Reset the environment to obtain the initial state.\n  env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the index for the target item \"arrow\".\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # Determine which primitive resources are required to craft an arrow.\n  primitives_needed = cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n\n  # Locate the workshop index required for crafting the arrow (if any).\n  recipe = cookbook.recipes.get(arrow_idx, {})\n  workshop_idx = recipe.get(\"_at\")\n\n  # Helper: find all positions on the grid that currently contain a given kind.\n  def find_positions(kind_idx):\n      coords = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      return [tuple(coord) for coord in coords]\n\n  # Helper: move the agent step\u2011by\u2011step towards a target cell using Manhattan moves.\n  def move_towards(target):\n      nonlocal state\n      while state.pos != target:\n          x, y = state.pos\n          tx, ty = target\n          if x < tx:          # need to move down (increase row index)\n              act = 0  # DOWN\n          elif x > tx:        # need to move up\n              act = 1  # UP\n          elif y < ty:        # need to move right (increase column index)\n              act = 3  # RIGHT\n          else:               # y > ty, move left\n              act = 2  # LEFT\n          actions.append(act)\n          _, new_state = state.step(act)\n          state = new_state\n\n  # Collect each required primitive the necessary number of times.\n  for kind_idx, count in primitives_needed.items():\n      for _ in range(count):\n          positions = find_positions(kind_idx)\n          if not positions:\n              # Primitive not present; abort early.\n              return actions\n          # Choose the closest instance (Manhattan distance).\n          cur_x, cur_y = state.pos\n          distances = [abs(px - cur_x) + abs(py - cur_y) for (px, py) in positions]\n          target = positions[int(np.argmin(distances))]\n          move_towards(target)\n          # Pick up the primitive.\n          actions.append(4)  # USE\n          _, new_state = state.step(4)\n          state = new_state\n\n  # After gathering all primitives, go to the appropriate workshop and craft.\n  if workshop_idx is not None:\n      workshop_positions = find_positions(workshop_idx)\n      if workshop_positions:\n          cur_x, cur_y = state.pos\n          distances = [abs(px - cur_x) + abs(py - cur_y) for (px, py) in workshop_positions]\n          target = workshop_positions[int(np.argmin(distances))]\n          move_towards(target)\n          # Perform the crafting action.\n          actions.append(4)  # USE\n          _, new_state = state.step(4)\n          state = new_state\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T15:59:27.383044", "function_name": "make_arrow", "function_body": "  actions = []\n  # Get the current state from the environment\n  state = env._current_state if hasattr(env, \"_current_state\") else getattr(env, \"current_state\", None)\n  if state is None:\n      return actions\n\n  grid = state.grid\n  world = env.world\n\n  # Index of the goal item (\"arrow\")\n  arrow_idx = world.cookbook.index.get(\"arrow\")\n  if arrow_idx is None:\n      return actions\n\n  # Primitive requirements for the goal\n  needed = world.cookbook.primitives_for(arrow_idx)  # {primitive_idx: count}\n  pos = list(state.pos)  # mutable copy of current position (x, y)\n\n  # Helper to move from current position to a target cell using Manhattan moves\n  def move_to(target):\n      nonlocal pos, actions\n      tx, ty = target\n\n      # Move in x direction (LEFT/RIGHT)\n      while pos[0] < tx:\n          actions.append(3)          # RIGHT\n          pos[0] += 1\n      while pos[0] > tx:\n          actions.append(2)          # LEFT\n          pos[0] -= 1\n\n      # Move in y direction (DOWN/UP) \u2013 assuming y increases downwards\n      while pos[1] < ty:\n          actions.append(0)          # DOWN\n          pos[1] += 1\n      while pos[1] > ty:\n          actions.append(1)          # UP\n          pos[1] -= 1\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitive resources\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      # Find all cells that contain this primitive\n      primitive_cells = np.argwhere(grid[:, :, prim_idx] == 1)\n      primitive_cells = [tuple(cell) for cell in primitive_cells]\n\n      # Greedy nearest\u2011first collection\n      while count > 0 and primitive_cells:\n          # Choose the nearest primitive cell\n          distances = [abs(pos[0] - x) + abs(pos[1] - y) for (x, y) in primitive_cells]\n          nearest_idx = int(np.argmin(distances))\n          target = primitive_cells.pop(nearest_idx)\n\n          # Move to the primitive and pick it up\n          move_to(target)\n          actions.append(4)          # USE (collect)\n          count -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          workshop_cells = np.argwhere(grid[:, :, workshop_idx] == 1)\n          if workshop_cells.size:\n              wk_target = tuple(workshop_cells[0])\n              move_to(wk_target)\n              actions.append(4)      # USE (craft)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:00:04.260680", "function_name": "make_arrow", "function_body": "  # Reset the environment to start from a fresh state.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices as defined by the environment.\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      walks from ``start`` to ``goal`` using Manhattan distance.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Find the nearest cell that contains ``kind`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = dists.argmin()\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              adj = target  # fallback: stand on the primitive cell itself\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Set facing direction toward the primitive (the move may be blocked\n          # but will update the agent's direction).\n          dy = ty - cur_pos[0]\n          dx = tx - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Use action to trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:00:05.379906", "function_name": "make_arrow", "function_body": "  # Reset environment and retrieve core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  # Map direction vectors to action indices\n  DIRS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of actions (DOWN/UP/LEFT/RIGHT) that moves the\n      agent from ``start`` to ``goal`` while avoiding non\u2011grabbable cells.\n      If no path is found, returns an empty list.\"\"\"\n      if start == goal:\n          return []\n      W, H = grid.shape[0], grid.shape[1]\n      blocked_kinds = list(world.non_grabbable_indices)\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = dict()  # (y,x) -> (prev_y, prev_x, action)\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:\n                  # cell is free if none of the blocked kinds are present\n                  if not np.any(grid[ny, nx, blocked_kinds] > 0):\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = (y, x, act)\n                      if (ny, nx) == goal:\n                          # reconstruct path\n                          actions = []\n                          cur = (ny, nx)\n                          while cur != start:\n                              py, px, a = prev[cur]\n                              actions.append(a)\n                              cur = (py, px)\n                          actions.reverse()\n                          return actions\n                      q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop)\n      using Manhattan distance. Returns coordinates (y, x) or None.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Move to the primitive cell (standing on it is sufficient for USE)\n          move_actions = bfs_path(cur_pos, target)\n          actions.extend(move_actions)\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions.extend(bfs_path(cur_pos, ws_cell))\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:00:33.184457", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:00:48.912590", "function_name": "make_arrow", "function_body": "  import collections\n\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  Node = collections.namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = collections.deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:01:13.031304", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _manhattan_path(src, dst):\n      \"\"\"Return a list of actions (DOWN/UP/LEFT/RIGHT) to move from src to dst.\"\"\"\n      actions = []\n      r, c = src\n      tr, tc = dst\n      # vertical moves\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      # horizontal moves\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  def _find_nearest(grid, kind_idx, start_pos):\n      \"\"\"Find the nearest cell (Manhattan) containing kind_idx.\"\"\"\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best = (i, j)\n                      best_dist = d\n      return best\n\n  def _find_any(grid, kind_idx):\n      \"\"\"Return any cell containing kind_idx (used for workshops).\"\"\"\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify goal index for 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # not defined in recipes\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives (respect counts)\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive missing \u2013 abort early\n              return action_seq\n          # Move to primitive\n          for a in _manhattan_path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick up (USE)\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # Craft the arrow (move to workshop if required)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _manhattan_path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Craft at workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n  else:\n      # No specific workshop \u2013 attempt crafting in place\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:01:14.140142", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: find the nearest cell that contains a given kind (Manhattan)\n  # ------------------------------------------------------------------\n  def _nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: locate any cell that contains a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Helper: produce a Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Initialise a fresh episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # unknown goal \u2013 nothing to do\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions_taken = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting required counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = _nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions_taken\n          # Move to the primitive location\n          for a in _manhattan_path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              actions_taken.append(a)\n              if done:\n                  return actions_taken\n          # Pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          actions_taken.append(USE)\n          if done:\n              return actions_taken\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _manhattan_path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              actions_taken.append(a)\n              if done:\n                  return actions_taken\n          # Perform the crafting action\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          actions_taken.append(USE)\n  else:\n      # No explicit workshop \u2013 attempt to craft in place\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      actions_taken.append(USE)\n\n  return actions_taken", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:01:52.154484", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action constants (as used by CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: generate a Manhattan\u2011style action list from cur \u2192 tgt\n  # ------------------------------------------------------------------\n  def _move_actions(cur, tgt):\n      \"\"\"Return a list of actions moving from cur (x,y) to tgt (x,y).\"\"\"\n      ax, ay = cur\n      bx, by = tgt\n      acts = []\n      # vertical movement (x coordinate)\n      while ax < bx:\n          acts.append(DOWN)\n          ax += 1\n      while ax > bx:\n          acts.append(UP)\n          ax -= 1\n      # horizontal movement (y coordinate)\n      while ay < by:\n          acts.append(RIGHT)\n          ay += 1\n      while ay > by:\n          acts.append(LEFT)\n          ay -= 1\n      return acts\n\n  # ------------------------------------------------------------------\n  # Reset / obtain the current underlying state\n  # ------------------------------------------------------------------\n  # ``env.reset`` returns an observation dict; the internal state is stored\n  # in ``env._current_state`` (the implementation of CraftLab keeps a\n  # reference to the CraftState instance).  We rely on that attribute.\n  _ = env.reset()\n  state = env._current_state          # type: CraftState\n  grid = state.grid.copy()            # mutable copy for planning\n  pos = list(state.pos)               # current (x, y) location\n\n  # ------------------------------------------------------------------\n  # Identify the recipe for the target item \u201carrow\u201d\n  # ------------------------------------------------------------------\n  idx = env.world.cookbook.index               # name \u2192 int mapping\n  arrow_idx = idx[\"arrow\"]                     # integer id of the goal\n  recipe = env.world.cookbook.recipes[arrow_idx]\n\n  # The workshop where the arrow must be crafted is stored under the\n  # special key ``\"_at\"`` in the recipe.\n  workshop_kind = recipe[\"_at\"]\n\n  # Primitive ingredients are all entries whose key is an integer (i.e.\n  # not ``\"_at\"``).  The value is the required count.\n  primitives = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  plan_actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting multiplicities)\n  # ------------------------------------------------------------------\n  for kind, needed in primitives.items():\n      for _ in range(needed):\n          # Locate all cells that currently contain the needed primitive.\n          locations = np.argwhere(grid[:, :, kind] > 0)\n          if locations.size == 0:\n              # No more of this primitive on the map \u2013 abort planning.\n              # (In a well\u2011formed scenario this should never happen.)\n              break\n\n          # Choose the nearest occurrence (Manhattan distance).\n          dists = np.abs(locations - pos).sum(axis=1)\n          nearest_idx = dists.argmin()\n          target = locations[nearest_idx].tolist()\n\n          # Move to the primitive and pick it up.\n          plan_actions += _move_actions(pos, target)\n          pos = target\n          plan_actions.append(USE)\n\n          # Simulate the pickup in our planning copy of the grid.\n          grid[pos[0], pos[1], kind] = 0\n\n  # ------------------------------------------------------------------\n  # Travel to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_locs = np.argwhere(grid[:, :, workshop_kind] > 0)\n  if workshop_locs.size > 0:\n      dists = np.abs(workshop_locs - pos).sum(axis=1)\n      nearest_idx = dists.argmin()\n      workshop_pos = workshop_locs[nearest_idx].tolist()\n\n      plan_actions += _move_actions(pos, workshop_pos)\n      pos = workshop_pos\n      plan_actions.append(USE)   # using the workshop crafts the arrow\n\n  # Return the complete list of action indices.\n  return plan_actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:01:53.278087", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Access world and cookbook \u2013 handle both CraftLab and raw CraftWorld objects\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # In some setups the current state holds a reference to the world\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n\n  # Goal identifier for the arrow\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # Current state information\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # If not already present, initialise a state from the scenario\n      state = env.scenario.init()\n  pos = tuple(state.pos)\n  grid = state.grid\n\n  actions = []\n\n  # Helper: generate Manhattan move sequence from cur to target\n  def _move_to(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(RIGHT)\n          cx += 1\n      while cx > tx:\n          seq.append(LEFT)\n          cx -= 1\n      while cy < ty:\n          seq.append(DOWN)\n          cy += 1\n      while cy > ty:\n          seq.append(UP)\n          cy -= 1\n      return seq\n\n  # Keep track of primitive cells already used\n  used_cells = set()\n\n  # Collect each required primitive\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # Locate all cells containing this primitive type\n      locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locs:\n          if gathered >= needed_cnt:\n              break\n          if loc in used_cells:\n              continue\n          # Move to the primitive cell\n          actions.extend(_move_to(pos, loc))\n          pos = loc\n          # Pick it up\n          actions.append(USE)\n          used_cells.add(loc)\n          gathered += 1\n\n  # After gathering primitives, head to the appropriate workshop and craft\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be name or already an index)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Find workshop locations\n      ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_locs[0]\n          actions.extend(_move_to(pos, target_ws))\n          pos = target_ws\n          actions.append(USE)\n\n  return actions", "env_interactions": 22, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:02:19.098095", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action / direction helpers\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,\n      (0, -1): ACTION_UP,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs(start, targets, grid):\n      H, W = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((H, W), False, dtype=bool)\n      visited[sy, sx] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:\n                  if blocked[ny, nx]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[ny, nx] = True\n                  q.append((nx, ny, npath))\n      return []\n\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal not found in env.task\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n  plan = []\n\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              return plan\n\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(ACTION_USE)\n\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              break\n\n          grid[adj_cell[1], adj_cell[0], prim_idx] -= 1\n          needed -= 1\n\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:02:20.224362", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action / direction helpers (indices follow CraftLab's action_specs)\n  # ------------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search: move from start to a cell adjacent to any target.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, grid):\n      \"\"\"Return a list of actions that brings the agent adjacent to a target.\n\n      Parameters\n      ----------\n      start : tuple (x, y)\n          Current agent position.\n      targets : list of (x, y)\n          Cells we want to become adjacent to.\n      grid : np.ndarray (H, W, K)\n          World grid; any non\u2011zero entry in the last axis blocks movement.\n\n      Returns\n      -------\n      list[int]\n          Action sequence (may be empty if already adjacent or unreachable).\n      \"\"\"\n      H, W = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((H, W), False, dtype=bool)\n      visited[sy, sx] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:\n                  if blocked[ny, nx]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[ny, nx] = True\n                  q.append((nx, ny, npath))\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract current state information.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                     # mutable copy of the world grid\n  pos = tuple(state.pos)                       # (x, y)\n\n  # Goal index (may be an int or a Struct with .arg)\n  goal = getattr(env.task, \"goal\", None)\n  if isinstance(goal, (int, np.integer)):\n      goal_idx = int(goal)\n  elif hasattr(goal, \"arg\"):\n      goal_idx = int(goal.arg)\n  else:\n      raise ValueError(\"Unable to determine goal index from env.task\")\n\n  # ------------------------------------------------------------------\n  # 1. Determine primitive resources needed for the goal.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []  # final action list\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitives_needed.items():\n      while count > 0:\n          # Locate all cells currently containing this primitive.\n          cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if cells.size == 0:\n              # No more primitives of this type left on the map.\n              return plan\n          # Find path to the nearest primitive (adjacent cell).\n          path = bfs(pos, cells.tolist(), grid)\n          plan.extend(path)\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use action to pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              # Should not happen; break to avoid infinite loop.\n              break\n\n          # Update local grid copy to reflect removal of one primitive.\n          grid[adj[1], adj[0], prim_idx] -= 1\n          count -= 1\n\n  # ------------------------------------------------------------------\n  # 3. Move to the workshop (if required) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use action to craft at the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:03:27.047635", "function_name": "make_arrow", "function_body": "  import collections\n\n  # direction mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, goals, blocked):\n      \"\"\"Return list of action indices to reach any goal cell.\"\"\"\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in goals:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ----------------------------------------------------------------------\n  # Access world and recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # ----------------------------------------------------------------------\n  # Prepare mutable copies of grid, inventory and blocked mask\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  inventory = state.inventory.copy()\n  w, h, _ = grid.shape\n\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Helpers to move and interact\n  # ----------------------------------------------------------------------\n  cur_pos = tuple(state.pos)\n  actions = []\n\n  def move_to_cells(kind_idx):\n      \"\"\"Move to the nearest cell containing `kind_idx` and update state.\"\"\"\n      nonlocal cur_pos, actions, grid\n      # locate all cells that still contain the kind\n      cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n      if not cells:\n          return\n      path = bfs(cur_pos, cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n      # after arriving, use the item\n      actions.append(4)  # USE\n      # update local grid and inventory\n      x, y = cur_pos\n      grid[x, y, kind_idx] = 0\n      inventory[kind_idx] += 1\n\n  def move_to_workshop(workshop_idx):\n      \"\"\"Move to any cell of the given workshop.\"\"\"\n      nonlocal cur_pos, actions\n      cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, workshop_idx] > 0}\n      if not cells:\n          return\n      path = bfs(cur_pos, cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n\n  # ----------------------------------------------------------------------\n  # Recursive planner to ensure we have `count` of `item_idx`\n  # ----------------------------------------------------------------------\n  def ensure(item_idx, count):\n      \"\"\"Collect or craft enough of `item_idx` to reach at least `count`.\"\"\"\n      nonlocal inventory\n      if inventory[item_idx] >= count:\n          return\n      need = count - inventory[item_idx]\n\n      if item_idx in cookbook.primitives:\n          for _ in range(need):\n              move_to_cells(item_idx)\n      else:\n          # craftable item\n          recipe = cookbook.recipes[item_idx]\n          workshop_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n          workshop_idx = (workshop_key if isinstance(workshop_key, int)\n                          else cookbook.index[workshop_key])\n          ingredients = {k: v for k, v in recipe.items() if isinstance(k, int)}\n          for _ in range(need):\n              # ensure each ingredient is available for one craft\n              for ing_idx, ing_cnt in ingredients.items():\n                  ensure(ing_idx, ing_cnt)\n              # go to workshop and craft\n              move_to_workshop(workshop_idx)\n              actions.append(4)  # USE to craft\n              # update inventory after crafting\n              for ing_idx, ing_cnt in ingredients.items():\n                  inventory[ing_idx] -= ing_cnt\n              inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Ensure we have at least one arrow\n  # ----------------------------------------------------------------------\n  ensure(target_idx, 1)\n\n  # Return the planned action sequence\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:03:28.166538", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # direction mapping: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, goal_cells, blocked):\n      \"\"\"Bread\u2011first search returning a list of direction indices from start to the\n      nearest cell in ``goal_cells`` while avoiding ``blocked`` cells.\"\"\"\n      w, h = start_grid.shape[:2]\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in goal_cells:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable in well\u2011formed scenarios\n\n  # ----------------------------------------------------------------------\n  # Access world / recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n  recipes = cookbook.recipes\n\n  # ----------------------------------------------------------------------\n  # Grid, blocked\u2011cell mask and initial state\n  # ----------------------------------------------------------------------\n  start_grid = env._current_state.grid\n  w, h, _ = start_grid.shape\n  blocked_mask = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked_mask |= start_grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(env._current_state.pos)\n  inventory = env._current_state.inventory.copy()\n\n  # ----------------------------------------------------------------------\n  # Helper: move to the nearest cell that contains a given kind and pick it up\n  # ----------------------------------------------------------------------\n  def move_to_and_pick(kind_idx):\n      nonlocal cur_pos, actions, inventory\n      # locate all cells that currently hold the item\n      cells = {(x, y) for x in range(w) for y in range(h)\n               if start_grid[x, y, kind_idx] > 0}\n      if not cells:\n          return  # nothing to collect; should not happen for valid tasks\n      path = bfs(cur_pos, cells, blocked_mask)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n      actions.append(4)               # USE to pick up\n      inventory[kind_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Recursive planner: ensure we have ``need`` copies of ``item_idx`` in inventory\n  # ----------------------------------------------------------------------\n  def ensure(item_idx, need):\n      nonlocal cur_pos, actions, inventory\n      if need <= 0:\n          return\n      have = inventory[item_idx]\n      if have >= need:\n          return\n      missing = need - have\n\n      # Primitive resources are collected directly from the world.\n      if item_idx in cookbook.primitives:\n          for _ in range(missing):\n              move_to_and_pick(item_idx)\n          return\n\n      # Otherwise we must craft the missing amount.\n      recipe = recipes[item_idx]\n\n      # First, make sure all ingredients are available.\n      for ing_idx, cnt in recipe.items():\n          if isinstance(ing_idx, int):          # ignore the workshop key\n              total_needed = cnt * missing\n              ensure(ing_idx, total_needed)\n\n      # Move to the appropriate workshop.\n      workshop_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n      workshop_idx = (workshop_key\n                      if isinstance(workshop_key, int)\n                      else cookbook.index[workshop_key])\n      workshop_cells = {(x, y) for x in range(w) for y in range(h)\n                        if start_grid[x, y, workshop_idx] > 0}\n      path = bfs(cur_pos, workshop_cells, blocked_mask)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          cur_pos = (cur_pos[0] + dx, cur_pos[1] + dy)\n\n      # Perform the crafting actions.\n      for _ in range(missing):\n          actions.append(4)               # USE at the workshop\n          # Consume ingredients.\n          for ing_idx, cnt in recipe.items():\n              if isinstance(ing_idx, int):\n                  inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Plan to create a single arrow.\n  # ----------------------------------------------------------------------\n  ensure(arrow_idx, 1)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:03:57.448580", "function_name": "make_arrow", "function_body": "  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and obtain the underlying state objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` using a Manhattan walk.\n      No obstacle checking is performed.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop).\n      Returns the coordinate (y, x) or ``None`` if not found.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine the goal index for 'arrow' and the required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell (prefer one that lets us face the primitive).\n          adj = None\n          neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          for ny, nx in neighbours:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour \u2013 fallback to the primitive cell itself.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Turn to face the primitive (use a movement action that will be blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:03:58.587029", "function_name": "make_arrow", "function_body": "  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and fetch underlying objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_free(y, x):\n      \"\"\"Return True if the cell is inside the map and not occupied by a\n      non\u2011grabbable entity.\"\"\"\n      if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):\n          return False\n      return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def bfs(start, goal_set):\n      \"\"\"Bread\u2011first search from start to the first position in goal_set.\n      Returns the list of positions (including start) describing the path,\n      or None if no path exists.\"\"\"\n      from collections import deque\n\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur in goal_set:\n              # reconstruct path\n              path = []\n              while cur is not None:\n                  path.append(cur)\n                  cur = visited[cur]\n              path.reverse()\n              return path\n          y, x = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              nxt = (ny, nx)\n              if nxt not in visited and is_free(ny, nx):\n                  visited[nxt] = cur\n                  q.append(nxt)\n      return None\n\n  def positions_to_actions(path):\n      \"\"\"Convert a list of positions to a list of movement actions.\"\"\"\n      acts = []\n      for (y0, x0), (y1, x1) in zip(path, path[1:]):\n          if y1 == y0 + 1:\n              acts.append(DOWN)\n          elif y1 == y0 - 1:\n              acts.append(UP)\n          elif x1 == x0 + 1:\n              acts.append(RIGHT)\n          elif x1 == x0 - 1:\n              acts.append(LEFT)\n      return acts\n\n  # ------------------------------------------------------------------\n  # Identify goal item and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate all cells that contain this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # primitive not present \u2013 abort early\n              return actions\n\n          # map each free adjacent cell to its corresponding primitive cell\n          adj_to_prim = {}\n          for py, px in prim_cells:\n              for dy, dx, face_act in [(1, 0, DOWN), (-1, 0, UP),\n                                       (0, 1, RIGHT), (0, -1, LEFT)]:\n                  ny, nx = py + dy, px + dx\n                  if is_free(ny, nx):\n                      adj_to_prim[(ny, nx)] = (py, px, face_act)\n\n          # If no free neighbour exists, fall back to the primitive cell itself\n          if not adj_to_prim:\n              # treat the primitive cell as the goal (it must be free)\n              target_cells = [(py, px) for py, px in prim_cells\n                              if is_free(py, px)]\n              if not target_cells:\n                  return actions\n              goal_set = set(target_cells)\n              path = bfs(cur_pos, goal_set)\n              if path is None:\n                  return actions\n              actions += positions_to_actions(path)\n              cur_pos = path[-1]\n              # we are on the same cell as the primitive; just USE\n              actions.append(USE)\n              continue\n\n          # Search for the nearest reachable adjacent cell\n          goal_set = set(adj_to_prim.keys())\n          path = bfs(cur_pos, goal_set)\n          if path is None:\n              return actions\n\n          # Move along the path\n          actions += positions_to_actions(path)\n          cur_pos = path[-1]\n\n          # Determine direction to face the primitive and use\n          py, px, face_act = adj_to_prim[cur_pos]\n          actions.append(face_act)   # turn towards the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          ws_set = {tuple(p) for p in workshop_cells}\n          path = bfs(cur_pos, ws_set)\n          if path is not None:\n              actions += positions_to_actions(path)\n              cur_pos = path[-1]\n\n  # Finally trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:04:22.458943", "function_name": "make_arrow", "function_body": "  # Reset the environment and initialise helpers\n  env.reset()\n  actions = []\n  act_map = env.action_specs()          # name \u2192 integer action id\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Movement deltas for the four cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If we are adjacent to any target, stop\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Traversable only if the cell is completely empty\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells currently holding the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present any more \u2013 give up on this one\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort further collection attempts\n              break\n\n          # Execute the movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Pick up the primitive with the USE action\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate all workshop cells of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          # Plan a path to the workshop (adjacent cell)\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Craft the item with the USE action\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the complete action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:04:23.589601", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Action name \u2192 integer mapping\n  act_map = env.action_specs()\n\n  # Movement deltas for each cardinal action name\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Only walk through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Refresh current state\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate cells that currently contain the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 cannot proceed\n              break\n\n          # Plan path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort collection\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Use action to pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after primitive collection\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate workshop cells of the appropriate kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use action at the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
