{"timestamp": "2025-10-28T16:37:22.034656", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:37:37.637905", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash based on position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 200                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:37:59.728646", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Determine current position (use the live state if available)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid so we can mark items as taken\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index (the task the environment expects)\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(pos, target, seq):\n      \"\"\"Append actions that move the agent from `pos` to `target`.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur, g):\n      \"\"\"Return the nearest cell (as [x, y]) that contains `kind_idx`.\"\"\"\n      ys, xs = np.where(g[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not present \u2013 abort planning (return whatever we have)\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                     # pick up the primitive\n          grid[target[1], target[0], prim_kind] = 0  # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                     # craft at the workshop\n\n  # Return the full planned action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:38:00.835100", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(pos, target, seq):\n      \"\"\"Append actions moving from `pos` to `target` (both [x, y] lists).\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return [x, y] of the nearest cell containing `kind_idx`, or None.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n\n  # Determine current position (use env's current state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid to track taken items\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitive resources\n  # ------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)  # pick up the primitive\n          grid[target[1], target[0], prim_kind] = 0  # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:38:31.460541", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[:2]\n  DIRS = [(1, 0, 0), (-1, 0, 1), (0, -1, 2), (0, 1, 3)]   # (dy,dx,action)\n  USE = 4\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def occupied(y, x):\n      \"\"\"True if the cell contains any entity (including primitives).\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque()\n      q.append(start)\n      prev = {start: None}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              actions = []\n              cur = goal\n              while prev[cur] is not None:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      actions.append(0)      # DOWN\n                  elif py == cur[0] + 1:\n                      actions.append(1)      # UP\n                  elif px == cur[1] - 1:\n                      actions.append(2)      # LEFT\n                  elif px == cur[1] + 1:\n                      actions.append(3)      # RIGHT\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in prev:\n                  continue\n              if occupied(ny, nx):\n                  continue\n              prev[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      return []   # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell, forbidden=set()):\n      \"\"\"Return a free neighbour of ``cell`` not in ``forbidden``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in forbidden:\n              continue\n          if not occupied(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives for 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  taken_cells = set()                     # primitives already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions                     # cannot find primitive\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = free_adjacent(target, forbidden=taken_cells)\n          if adj is None:\n              # If no free neighbour, stand on the primitive cell itself\n              adj = target\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked move if not standing on it)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(0)   # DOWN\n          elif dy == -1:\n              actions.append(1)   # UP\n          elif dx == 1:\n              actions.append(3)   # RIGHT\n          elif dx == -1:\n              actions.append(2)   # LEFT\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid and record that this cell is now empty\n          grid[target[0], target[1], prim_idx] = 0\n          taken_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand on a free neighbour of the workshop\n          ws_adj = free_adjacent(ws_cell, forbidden=taken_cells)\n          if ws_adj is None:\n              ws_adj = cur_pos   # fallback: stay where we are\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(0)\n          elif dy == -1:\n              actions.append(1)\n          elif dx == 1:\n              actions.append(3)\n          elif dx == -1:\n              actions.append(2)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:38:32.593128", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain core objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  # Work on a mutable copy of the grid to keep track of collected items\n  grid = state.grid.copy()             # shape (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (consistent with CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves the\n      agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev_actions = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev_actions.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev_actions.append(UP)\n                  elif cur[1] == px + 1:\n                      rev_actions.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev_actions.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev_actions))\n          for dy, dx, _ in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely lead to failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to ``cell``.\n      ``avoid`` is a set of coordinates that should not be used.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  collected = set()   # keep track of primitive cells already taken\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; cannot safely collect \u2013 abort\n              return actions\n\n          # Move to that adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a movement action that will be blocked)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand on a free neighbour of the workshop\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              # If no free neighbour, try to stand directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional \u2013 a blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
