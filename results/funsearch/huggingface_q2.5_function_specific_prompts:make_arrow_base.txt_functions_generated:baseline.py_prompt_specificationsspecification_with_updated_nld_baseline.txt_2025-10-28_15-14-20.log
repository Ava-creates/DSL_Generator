{"timestamp": "2025-10-28T21:31:38.076937", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # action constants (match CraftWorld's definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move a position according to an action (assumes movement is legal)\n  # ------------------------------------------------------------------\n  def _move(pos, act):\n      x, y = pos\n      if act == RIGHT:\n          return (x + 1, y)\n      if act == LEFT:\n          return (x - 1, y)\n      if act == DOWN:\n          return (x, y + 1)\n      if act == UP:\n          return (x, y - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions leading to a free cell\n  # adjacent to any of the target cells.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (x, y)\n          # expand neighbours\n          for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),\n                                (DOWN, (0, 1)), (UP, (0, -1))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty path and original position\n      return [], start\n\n  # ------------------------------------------------------------------\n  # Retrieve world & cookbook objects (they may be nested inside wrappers)\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # CraftLab stores the underlying state in _current_state.world\n      cur = getattr(env, \"_current_state\", None)\n      if cur is not None:\n          world = getattr(cur, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in env\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Basic information about the current situation\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)          # (x, y)\n  direction = int(state.dir)      # current facing direction\n  grid = state.grid               # (W, H, n_kinds)\n\n  # we will mutate a copy of the grid to keep track of collected items\n  mutable_grid = np.copy(grid)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Goal: make an \"arrow\"\n  # ------------------------------------------------------------------\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < required_cnt:\n          # locate all remaining instances of this primitive\n          locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # no more of this primitive on the map \u2013 abort collection loop\n              break\n\n          # pick the closest instance (Manhattan distance)\n          locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          target = locations[0]\n\n          # cells occupied by any entity (except the target we are heading for)\n          occupied = np.any(mutable_grid > 0, axis=2)\n\n          # find a path to a free cell adjacent to the target\n          path, new_pos = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # simulate the movement to keep pos & direction up\u2011to\u2011date\n          for act in path:\n              pos = _move(pos, act)\n              direction = act\n\n          # decide which direction we must face to interact with the target\n          tx, ty = target\n          needed_dir = None\n          if tx > pos[0]:\n              needed_dir = RIGHT\n          elif tx < pos[0]:\n              needed_dir = LEFT\n          elif ty > pos[1]:\n              needed_dir = DOWN\n          elif ty < pos[1]:\n              needed_dir = UP\n\n          # turn if we are not already facing the target\n          if needed_dir is not None and direction != needed_dir:\n              actions.append(needed_dir)\n              direction = needed_dir\n\n          # pick up the primitive\n          actions.append(USE)\n          gathered += 1\n\n          # update our mutable copy: the primitive is now gone\n          mutable_grid[tx, ty, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # workshop_key may be a string name; resolve to index\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n\n      # locate workshop cells (they are static, use original grid)\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          ws_target = workshop_cells[0]\n\n          occupied = np.any(mutable_grid > 0, axis=2)\n          path, new_pos = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n\n          for act in path:\n              pos = _move(pos, act)\n              direction = act\n\n          # ensure we are facing the workshop before using\n          wx, wy = ws_target\n          needed_dir = None\n          if wx > pos[0]:\n              needed_dir = RIGHT\n          elif wx < pos[0]:\n              needed_dir = LEFT\n          elif wy > pos[1]:\n              needed_dir = DOWN\n          elif wy < pos[1]:\n              needed_dir = UP\n\n          if needed_dir is not None and direction != needed_dir:\n              actions.append(needed_dir)\n              direction = needed_dir\n\n          # craft the arrow\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Return the complete list of actions\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:31:39.213615", "function_name": "make_arrow", "function_body": "  # constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: apply a movement action to a position\n  # ------------------------------------------------------------------\n  def _move(pos, act):\n      x, y = pos\n      if act == RIGHT:\n          return (x + 1, y)\n      if act == LEFT:\n          return (x - 1, y)\n      if act == DOWN:\n          return (x, y + 1)\n      if act == UP:\n          return (x, y - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions leading to a free cell\n  # adjacent to any of the target locations.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      from collections import deque\n      w, h = occupied.shape\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path, (x, y)\n          # explore neighbours\n          for act, (dx, dy) in ((RIGHT, (1, 0)), (LEFT, (-1, 0)),\n                                (DOWN, (0, 1)), (UP, (0, -1))):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not occupied[nx, ny]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no reachable adjacent cell\n      return [], start\n\n  # ------------------------------------------------------------------\n  # Retrieve world, cookbook and current state\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # some wrappers expose the world via the current state\n      cur = getattr(env, \"_current_state\", None)\n      if cur is not None:\n          world = getattr(cur, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld not found in the provided environment\")\n\n  cookbook = world.cookbook\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal: make an \"arrow\"\n  # ------------------------------------------------------------------\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Initialise mutable copies of position, direction and grid\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)          # (x, y)\n  direction = int(state.dir)      # current facing direction\n  mutable_grid = np.copy(state.grid)   # (W, H, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # locate remaining instances of this primitive\n          locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # no more primitives of this type \u2013 break to avoid infinite loop\n              break\n\n          # pick the closest instance (Manhattan distance)\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations[0]\n\n          # occupancy map (ignore the target itself \u2013 it is considered blocked)\n          occupied = np.any(mutable_grid > 0, axis=2)\n\n          # find path to a free cell adjacent to the target\n          path, pos = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # update position and facing direction following the path\n          for act in path:\n              pos = _move(pos, act)\n              direction = act\n\n          # determine direction needed to face the target cell\n          tx, ty = target\n          needed_dir = None\n          if tx > pos[0]:\n              needed_dir = RIGHT\n          elif tx < pos[0]:\n              needed_dir = LEFT\n          elif ty > pos[1]:\n              needed_dir = DOWN\n          elif ty < pos[1]:\n              needed_dir = UP\n\n          # turn if not already facing the target\n          if needed_dir is not None and direction != needed_dir:\n              actions.append(needed_dir)\n              direction = needed_dir\n\n          # collect the primitive\n          actions.append(USE)\n          gathered += 1\n\n          # mark the cell as empty in our mutable copy\n          mutable_grid[tx, ty, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be a string name)\n      workshop_idx = (cookbook.index[workshop_key]\n                     if isinstance(workshop_key, str)\n                     else workshop_key)\n\n      # locate workshop cells (they are static, use original grid)\n      workshop_cells = [tuple(p) for p in np.argwhere(state.grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = workshop_cells[0]\n\n          occupied = np.any(mutable_grid > 0, axis=2)\n          path, pos = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n\n          for act in path:\n              pos = _move(pos, act)\n              direction = act\n\n          # face the workshop\n          wx, wy = ws_target\n          needed_dir = None\n          if wx > pos[0]:\n              needed_dir = RIGHT\n          elif wx < pos[0]:\n              needed_dir = LEFT\n          elif wy > pos[1]:\n              needed_dir = DOWN\n          elif wy < pos[1]:\n              needed_dir = UP\n\n          if needed_dir is not None and direction != needed_dir:\n              actions.append(needed_dir)\n              direction = needed_dir\n\n          # craft the arrow\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Return the full action sequence\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 15, "island_id": 4, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T21:32:04.389281", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch initial state\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Work on a mutable copy of the grid so we can \u201cremove\u201d collected primitives\n  grid = np.copy(state.grid)\n\n  # Action indices (standard ordering in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions that walk from ``start`` to ``goal``.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that currently contains ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def find_adjacent_free(cell):\n      \"\"\"Return a free (non\u2011blocked) neighbour of ``cell`` if one exists, else None.\"\"\"\n      y, x = cell\n      for ny, nx in [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              # A cell is considered blocked if any non\u2011grabbable entity occupies it\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Determine primitives required for the goal item ('arrow')\n  # ----------------------------------------------------------------------\n  goal_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on (prefer a neighbour, else the cell itself)\n          stand = find_adjacent_free(target)\n          if stand is None:\n              stand = target\n\n          # Move to the chosen standing cell\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive: add a single step towards it to set direction\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Remove the primitive from our local copy of the grid\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:32:05.516394", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  goal_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on (prefer empty)\n          stand = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      stand = (ny, nx)\n                      break\n          if stand is None:\n              stand = target\n\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (best\u2011effort direction)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          actions.append(USE)\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  actions.append(USE)\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:32:46.187114", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action identifiers as used by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and fetch useful objects\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Indices of entities that block movement (non\u2011grabbable)\n  non_grab = list(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"True if a non\u2011grabbable entity occupies ``pos``.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest 4\u2011connected walkable path (including start & goal).\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          # Unreachable\n          return []\n\n      # Reconstruct path backwards\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell containing ``kind`` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (preferring N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)   # current (y, x)\n\n  # Goal item (arrow) and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur_pos, stand_pos)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand_pos\n\n          # Step onto the primitive cell itself (if possible)\n          if not is_blocked(prim_loc):\n              path = bfs_path(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe requires a specific workshop, go there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
