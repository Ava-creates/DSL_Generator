{"timestamp": "2025-10-28T19:57:23.161986", "function_name": "make_arrow", "function_body": "  # Reuse the generic BFS planner defined earlier for robustness.\n  try:\n      return make_arrow_v0(env)\n  except Exception:\n      return []", "env_interactions": 0, "island_id": 2, "scores": {}}
{"timestamp": "2025-10-28T19:57:38.821897", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000                     # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:58:09.250128", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk\n      from ``start`` to ``goal`` using a simple Manhattan route.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that contains ``kind_idx`` (primitive or\n      workshop). Returns (y, x) coordinates or ``None`` if not found.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the 'arrow' item\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on (prefer empty).\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (by attempting to move toward it; if blocked,\n          # the agent stays but direction changes).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop specified in the recipe (if any) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:58:10.419480", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state\n  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return list of movement actions from start to goal using Manhattan steps.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that contains the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine primitives needed for the 'arrow' item\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on (prefer empty).\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (best\u2011effort direction).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:58:45.001968", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Hashable representation of a state (position, direction, inventory, grid)\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:59:00.693496", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", None)\n  if scenario is None:\n      scenario = env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial CraftState for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over (state, action\u2011sequence) pairs\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Create a hashable representation of a state\n      # Includes position, direction, inventory, and the grid occupancy\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                               # safety limit\n  n_actions = getattr(world, \"n_actions\", 5)    # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours by trying every possible action\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:59:25.964831", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:59:40.786461", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Hashable representation of a state for visited\u2011set checking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 500                     # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:00:07.960967", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # make_arrow_vn\n  # ----------------------------------------------------------------------\n  # The function builds a plan that collects the primitives required for an\n  # \u201carrow\u201d and then crafts the arrow at the appropriate workshop.  It works\n  # by performing a breadth\u2011first search in the *state* space of the\n  # environment.  The search is guided by a simple heuristic that prefers\n  # actions which bring the agent closer to a needed primitive (or to the\n  # workshop once all primitives have been gathered).  The first sequence of\n  # actions that yields an inventory containing at least one ``arrow`` is\n  # returned.\n  #\n  # The implementation is deliberately self\u2011contained \u2013 it uses only the\n  # public API of the provided classes (CraftWorld, CraftScenario,\n  # CraftState, \u2026) and does not rely on any hidden implementation details.\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory vector and the occupancy of the grid.\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  def _manhattan(a, b):\n      \"\"\"Manhattan distance between two (x, y) points.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # ------------------------------------------------------------------\n  # Extract world / scenario information\n  # ------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine what we need to collect\n  # ------------------------------------------------------------------\n  # Primitive requirements for a single arrow (primitive_idx -> count)\n  primitive_needs = world.cookbook.primitives_for(target_idx)\n\n  # Workshop where the arrow can be crafted\n  recipe = world.cookbook.recipes.get(target_idx, {})\n  workshop_name = recipe.get(\"_at\")  # e.g. \"workshop\"\n  workshop_idx = None\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.get(workshop_name)\n\n  # ------------------------------------------------------------------\n  # Search node definition\n  # ------------------------------------------------------------------\n  Node = namedtuple(\"Node\", [\"state\", \"actions\", \"dist\"])\n\n  # ------------------------------------------------------------------\n  # Initialise frontier\n  # ------------------------------------------------------------------\n  frontier = deque()\n  start_node = Node(state=init_state, actions=[], dist=0)\n  frontier.append(start_node)\n  visited = {_state_hash(init_state)}\n\n  # ------------------------------------------------------------------\n  # Search parameters\n  # ------------------------------------------------------------------\n  MAX_STEPS = 3000                     # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # --------------------------------------------------------------\n      # Goal test: we have at least one arrow in the inventory\n      # --------------------------------------------------------------\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # --------------------------------------------------------------\n      # Stop expanding overly long paths\n      # --------------------------------------------------------------\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # --------------------------------------------------------------\n      # Heuristic: distance to the *nearest* needed primitive, or to the\n      # workshop if we already have everything.\n      # --------------------------------------------------------------\n      # Compute which primitives are still missing.\n      missing = {}\n      for prim_idx, req_cnt in primitive_needs.items():\n          have = int(cur_state.inventory[prim_idx])\n          if have < req_cnt:\n              missing[prim_idx] = req_cnt - have\n\n      # If nothing is missing we head for the workshop (if known).\n      if not missing:\n          # If there is no workshop information we just continue BFS.\n          if workshop_idx is not None:\n              # Find any cell that contains the workshop.\n              ws_cells = np.argwhere(cur_state.grid[:, :, workshop_idx] > 0)\n              if ws_cells.size:\n                  # Use Manhattan distance to the *closest* workshop cell.\n                  dists = [_manhattan(cur_state.pos, tuple(p[:2])) for p in ws_cells]\n                  heuristic = min(dists)\n              else:\n                  heuristic = 0\n          else:\n              heuristic = 0\n      else:\n          # Find the closest cell that holds any of the missing primitives.\n          primitive_cells = []\n          for p_idx in missing.keys():\n              cells = np.argwhere(cur_state.grid[:, :, p_idx] > 0)\n              primitive_cells.extend(cells.tolist())\n          if primitive_cells:\n              dists = [_manhattan(cur_state.pos, tuple(p[:2])) for p in primitive_cells]\n              heuristic = min(dists)\n          else:\n              # No remaining primitives on the map \u2013 continue BFS anyway.\n              heuristic = 0\n\n      # --------------------------------------------------------------\n      # Expand neighbours (actions)\n      # --------------------------------------------------------------\n      for a in range(n_actions):\n          reward, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h in visited:\n              continue\n          visited.add(h)\n\n          # Insert in frontier using a simple priority: actions that reduce\n          # the heuristic are explored first (A*\u2011like behaviour).  Because we\n          # use a deque we push \u201cgood\u201d nodes to the left and others to the\n          # right.\n          # Re\u2011compute heuristic for the child state.\n          # (We reuse the same code as above \u2013 a tiny helper.)\n          child_missing = {}\n          for prim_idx, req_cnt in primitive_needs.items():\n              have = int(nxt_state.inventory[prim_idx])\n              if have < req_cnt:\n                  child_missing[prim_idx] = req_cnt - have\n\n          if not child_missing and workshop_idx is not None:\n              ws_cells = np.argwhere(nxt_state.grid[:, :, workshop_idx] > 0)\n              child_h = min(\n                  [_manhattan(nxt_state.pos, tuple(p[:2])) for p in ws_cells]\n              ) if ws_cells.size else 0\n          else:\n              prim_cells = []\n              for p_idx in child_missing.keys():\n                  cells = np.argwhere(nxt_state.grid[:, :, p_idx] > 0)\n                  prim_cells.extend(cells.tolist())\n              child_h = (\n                  min([_manhattan(nxt_state.pos, tuple(p[:2])) for p in prim_cells])\n                  if prim_cells else 0\n              )\n\n          # Prefer nodes with smaller heuristic.\n          if child_h <= heuristic:\n              frontier.appendleft(Node(state=nxt_state,\n                                       actions=node.actions + [a],\n                                       dist=node.dist + 1))\n          else:\n              frontier.append(Node(state=nxt_state,\n                                   actions=node.actions + [a],\n                                   dist=node.dist + 1))\n\n  # No plan found within the search budget.\n  return []", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T20:00:23.630292", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Determine the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:00:51.979590", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial CraftState\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Position, direction, inventory and full grid layout uniquely identify a state\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500               # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: inventory contains at least one arrow\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:01:07.688544", "function_name": "make_arrow", "function_body": "  # locate scenario and world\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n  # target index\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n  # initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  def _state_hash(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n  while frontier:\n      node = frontier.popleft()\n      s = node.state\n      if s.satisfies(\"\", target_idx):\n          return node.actions\n      if len(node.actions) >= MAX_STEPS:\n          continue\n      for a in range(n_actions):\n          _, ns = s.step(a)\n          h = _state_hash(ns)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(ns, node.actions + [a]))\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:01:39.181871", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices used by CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # BFS returning a list of actions that moves the agent from `start`\n  # to a cell adjacent (Manhattan distance \u2264 1) to any coordinate in\n  # `targets`. Cells with any non\u2011zero kind are treated as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop when adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path.\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance from the environment.\")\n\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Current position and a mutable copy of the grid for planning.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (nearest\u2011first, handling counts).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          # Find all cells that currently hold this primitive.\n          locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # No more instances on the map \u2013 cannot satisfy requirement.\n              break\n          # Choose the closest one.\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_loc = locations[0]\n\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [target_loc], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up as many as needed from this cell.\n          while needed > 0 and cur_grid[target_loc[0], target_loc[1], prim_idx] > 0:\n              actions.append(USE)\n              cur_grid[target_loc[0], target_loc[1], prim_idx] -= 1\n              needed -= 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n      # Use the workshop to craft the arrow.\n      actions.append(USE)\n  else:\n      # No specific workshop required; just use at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:01:40.327782", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices used by CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any coordinate\n  # in `targets`.  Cells with any non\u2011zero kind are treated as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop when adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path.\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance from the environment.\")\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary) and fetch grid.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # mutable copy for planning\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive, nearest\u2011first.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All locations currently holding this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up.\n          actions.append(USE)\n          # Remove the primitive from the grid for future planning.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n  # Use (craft) at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
