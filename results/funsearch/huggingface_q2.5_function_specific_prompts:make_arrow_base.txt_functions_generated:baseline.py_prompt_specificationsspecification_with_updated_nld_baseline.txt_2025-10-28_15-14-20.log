{"timestamp": "2025-10-28T18:22:18.419739", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helpers: action \u2194 direction and BFS to a cell adjacent to any target.\n  # ----------------------------------------------------------------------\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {a: d for d, a in DIR2ACT.items()}\n\n  def bfs_adjacent(start, targets, grid, blocked_kinds):\n      \"\"\"Return a list of actions that moves the agent from *start* to a cell\n      adjacent (Manhattan distance\u202f=\u202f1) to any cell in *targets* while avoiding\n      cells that contain any kind in *blocked_kinds*.\"\"\"\n      H, W = grid.shape[:2]\n\n      # Build blocked\u2011cell mask.\n      blocked = np.zeros((H, W), dtype=bool)\n      for k in blocked_kinds:\n          blocked |= grid[:, :, k] > 0\n\n      sx, sy = start\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((H, W), dtype=bool)\n      visited[sy, sx] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:\n                  if blocked[ny, nx]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[ny, nx] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise state.\n  # ----------------------------------------------------------------------\n  # Assume the environment has already been reset; otherwise call env.reset().\n  state = env._current_state\n  grid = state.grid.copy()                # mutable local copy\n  pos = tuple(state.pos)                  # (x, y)\n\n  # Goal item index.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # ----------------------------------------------------------------------\n  # 1. Gather required primitive resources.\n  # ----------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  blocked_kinds = env.world.non_grabbable_indices\n  plan = []\n\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          # Locate remaining cells containing this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)  # (y, x) rows\n          if prim_cells.size == 0:\n              # Primitive unavailable \u2013 abort planning.\n              return plan\n\n          # Convert to (x, y) tuples for BFS.\n          prim_targets = [(int(c[1]), int(c[0])) for c in prim_cells]\n\n          # Find path to become adjacent to the nearest reachable primitive.\n          path = bfs_adjacent(pos, prim_targets, grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use (collect) the primitive.\n          plan.append(4)   # USE action\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cy, cx in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (int(cx), int(cy))\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update local grid and remaining count.\n          grid[adj_cell[1], adj_cell[0], prim_idx] -= 1\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop kind index.\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          workshop_targets = [(int(c[1]), int(c[0])) for c in workshop_cells]\n          path = bfs_adjacent(pos, workshop_targets, grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement to workshop adjacency.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft the item by using the workshop.\n          plan.append(4)   # USE action\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:22:19.558833", "function_name": "make_arrow", "function_body": "  # Ensure the environment is reset to obtain an initial state.\n  _ = env.reset()\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)  # (x, y)\n\n  # Goal index of the item to craft.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  # Mapping between movement vectors and CraftLab action indices.\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def get_positions(kind_idx):\n      \"\"\"Return a list of (x, y) coordinates where ``kind_idx`` is present.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      return list(zip(xs, ys))\n\n  def bfs_adjacent(start, targets):\n      \"\"\"\n      Bread\u2011first search returning a list of actions that moves the agent\n      from ``start`` to a cell adjacent (Manhattan distance\u202f1) to any cell\n      in ``targets`` while avoiding blocked cells (any non\u2011zero entry in the\n      grid).\n      \"\"\"\n      H, W = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((H, W), False, dtype=bool)\n      visited[sy, sx] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx] and not blocked[ny, nx]:\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[ny, nx] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitive resources.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          prim_positions = get_positions(prim_idx)\n          if not prim_positions:\n              # Primitive unavailable; abort planning.\n              return plan\n\n          # Move adjacent to the nearest reachable primitive.\n          path = bfs_adjacent(pos, prim_positions)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(4)  # USE action\n\n          # Identify the primitive cell we are now adjacent to.\n          adj = None\n          for tx, ty in prim_positions:\n              if abs(pos[0] - tx) + abs(pos[1] - ty) == 1:\n                  adj = (tx, ty)\n                  break\n          if adj is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update local grid copy and decrement requirement.\n          grid[adj[1], adj[0], prim_idx] -= 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_positions = get_positions(workshop_idx)\n      if workshop_positions:\n          path = bfs_adjacent(pos, workshop_positions)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft the item at the workshop.\n          plan.append(4)  # USE action\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:22:50.105932", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # BFS returning a list of actions that moves the agent from `start`\n  # to a cell adjacent (Manhattan distance \u2264 1) to any coordinate in\n  # `targets`. Cells with any non\u2011zero kind are treated as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent to a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world, cookbook and the goal (hard\u2011coded to \"arrow\").\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary) and fetch grid.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # mutable copy for path\u2011finding\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive, nearest\u2011first.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All locations currently holding this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up.\n          actions.append(USE)\n          # Remove the primitive from the grid for future planning.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:22:51.250489", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices \u2013 match the environment's definition.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264\u202f1) to any of the\n  # coordinates in `targets`.  Cells containing any entity are treated\n  # as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # True where a cell is non\u2011empty\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore 4\u2011connected neighbours.\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path.\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: update a position given an action.\n  # ------------------------------------------------------------------\n  def _apply_action(pos, act):\n      if act == RIGHT:\n          return (pos[0] + 1, pos[1])\n      if act == LEFT:\n          return (pos[0] - 1, pos[1])\n      if act == DOWN:\n          return (pos[0], pos[1] + 1)\n      if act == UP:\n          return (pos[0], pos[1] - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Extract world, cookbook and goal (hard\u2011coded to \u201carrow\u201d).\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  cookbook = world.cookbook\n\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)               # current (x, y)\n  cur_grid = state.grid.copy()         # mutable copy of the grid\n\n  actions = []\n  harvested = set()                    # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently holding this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from the current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          # Pick it up.\n          actions.append(USE)\n          # Remove the primitive from the grid so future path\u2011finding\n          # sees the cell as empty.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Locate all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n      else:\n          # No workshop cell found \u2013 attempt to craft at current location.\n          actions.append(USE)\n\n  # Return the complete action list.\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:23:21.160424", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Bread\u2011first search returning actions that move the agent from ``start``\n      to a cell adjacent (Manhattan distance\u202f1) to any cell in ``targets`` while\n      avoiding non\u2011grabbable obstacles.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Cells occupied by any non\u2011grabbable entity block movement.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise mutable copies of the current state.\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for simulation\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index stored in the task (env.task.goal).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (expanded recursively).\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt_needed in needed.items():\n      while cnt_needed > 0:\n          # Locate cells that currently contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive missing \u2013 abort planning.\n              return plan\n\n          # Move adjacent to the nearest reachable primitive.\n          path = bfs_adjacent(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` in sync.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update simulated grid and decrement needed count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt_needed -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:23:22.281759", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants (as defined by CraftLab)\n  # ----------------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search that moves the agent to a cell adjacent to any\n  # target cell while avoiding non\u2011grabbable obstacles.\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Parameters\n      ----------\n      start : tuple (x, y)\n          Current agent position.\n      targets : list of (x, y)\n          Cells we want to become adjacent to.\n      grid : np.ndarray (W, H, K)\n          Current world grid.\n\n      Returns\n      -------\n      list[int]\n          Sequence of actions that brings the agent adjacent to a target.\n          May be empty if already adjacent or if no path exists.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # Build a blocked mask from all non\u2011grabbable entity kinds.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # Quick check: already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise mutable copies of the current environment state.\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for planning\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index is stored in the task (env.task.goal).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for the goal (expanded recursively).\n  # ----------------------------------------------------------------------\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt_needed in needed_prims.items():\n      while cnt_needed > 0:\n          # Find all cells currently containing this primitive.\n          prim_cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present \u2013 abort planning.\n              return plan\n\n          # Move adjacent to the nearest reachable primitive.\n          path = bfs_adjacent(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected; stop to avoid infinite loop.\n              break\n\n          # Update simulated grid and decrement needed count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt_needed -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (name \u2192 int or already int).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n  else:\n      # No specific workshop \u2013 simply use the current cell to craft.\n      plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 1, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:23:42.403699", "function_name": "make_arrow", "function_body": "  # Reset environment to a clean start\n  env.reset()\n  # Action name \u2192 index mapping (e.g. {\"UP\":0, \"DOWN\":1, ...})\n  act_map = env.action_specs()\n  # Movement deltas for cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of action *names* that moves the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`.  The search walks only through empty cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours (cardinal moves only)\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # Walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Identify the goal and its recipe\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  actions: list[int] = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting required counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      # If we already have everything, break\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):\n          break\n\n      # Find a primitive we are still missing\n      missing = [(p_idx, cnt - inventory[p_idx])\n                 for p_idx, cnt in needed_prims.items()\n                 if inventory[p_idx] < cnt]\n      prim_idx, _ = missing[0]   # pick the first missing primitive\n\n      # Locate all cells currently holding this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Required primitive {prim_idx} not found on the map.\")\n\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {prim_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          act_id = act_map[act_name]\n          actions.append(act_id)\n          env.step(act_id)\n\n      # Pick up the primitive with the USE action\n      use_id = act_map[\"USE\"]\n      actions.append(use_id)\n      env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Workshop required for crafting not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          act_id = act_map[act_name]\n          actions.append(act_id)\n          env.step(act_id)\n\n  # Final USE to craft (or to pick up if no workshop is needed)\n  actions.append(act_map[\"USE\"])\n  env.step(act_map[\"USE\"])\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:23:43.523720", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment to start fresh\n  env.reset()\n  act_map = env.action_specs()                     # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  move_delta = {\"UP\": (-1, 0), \"DOWN\": (1, 0),\n                \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`.  Traverses only empty cells.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start: tuple[int, int],\n                      targets: list[tuple[int, int]],\n                      grid: np.ndarray) -> list[str] | None:\n      W, H = grid.shape[:2]\n      visited: set[tuple[int, int]] = set()\n      q: deque[tuple[tuple[int, int], list[str]]] = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # Walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Identify the goal and its recipe\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  actions: list[int] = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      # Check if we already have everything we need\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):\n          break\n\n      # Find a primitive that is still lacking\n      missing = [(p_idx, cnt - inventory[p_idx])\n                 for p_idx, cnt in needed_prims.items()\n                 if inventory[p_idx] < cnt]\n      # Choose the first missing primitive\n      prim_idx, _ = missing[0]\n\n      # Locate all cells currently holding this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Required primitive {prim_idx} not found on the map.\")\n\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {prim_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          act_id = act_map[act_name]\n          actions.append(act_id)\n          env.step(act_id)\n\n      # Pick up the primitive with the USE action\n      use_id = act_map[\"USE\"]\n      actions.append(use_id)\n      env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Workshop required for crafting not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          act_id = act_map[act_name]\n          actions.append(act_id)\n          env.step(act_id)\n\n  # Final USE to craft (or to pick up if no workshop is needed)\n  actions.append(act_map[\"USE\"])\n  env.step(act_map[\"USE\"])\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:24:01.930021", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and obtain useful mappings\n  env.reset()\n  act_map = env.action_specs()                     # name \u2192 integer id\n  goal_idx = env.task.goal                         # index of the desired item\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)          # workshop kind index, if any\n\n  # Cardinal movement deltas\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through completely empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells currently holding the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 cannot continue\n              break\n\n          # Plan a path to an adjacent cell of the nearest primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort further attempts for this primitive\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Use action to pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate all workshop cells of the appropriate kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use action at the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:24:03.045042", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  # Mapping from action names to integer IDs\n  act_map = env.action_specs()\n  # Movement deltas for cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`.  The search only walks through empty cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency (including diagonal) to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # Only walk through completely empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell found\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Find all cells that currently contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 abort planning for this item\n              break\n\n          # Plan a path to an adjacent cell of the nearest primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 abort planning for this item\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Use action to pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate all workshop cells of the appropriate kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use action at the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled list of action IDs\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:24:37.177957", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  #   `start` to a cell adjacent (Manhattan distance == 1) to any of the\n  #   `targets`.  All cells with any non\u2011zero kind are treated as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are already adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Expand 4\u2011connected neighbours.\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract world, cookbook and goal information.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Current position and a mutable copy of the grid.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []                          # accumulated action list\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from the current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark cell as empty for future path\u2011finding.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (name \u2192 int) if needed.\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T18:24:38.305855", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  #   start (x, y) to a cell adjacent (Manhattan distance \u2264 1) to any\n  #   target location. Cells with any non\u2011zero kind are treated as\n  #   obstacles.\n  # ------------------------------------------------------------------\n  def _bfs(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent to a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract world and cookbook references.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  if world is None:\n      raise RuntimeError(\"Unable to locate world object in the environment.\")\n  cookbook = world.cookbook\n\n  # Ensure we have a fresh state.\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Current position and mutable copy of the grid.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # Helper to compute occupied map (any non\u2011empty cell).\n  def occupied_map(g):\n      return np.any(g > 0, axis=2)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from the current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          occ = occupied_map(cur_grid)\n          path = _bfs(pos, [loc], occ)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Clear the cell for future path\u2011finding.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          occ = occupied_map(cur_grid)\n          path = _bfs(pos, [target_ws], occ)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:25:07.925088", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Mapping from direction vector to action index (as defined in CraftWorld)\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_adjacent(start_pos, target_cells, grid, blocked_kinds):\n      \"\"\"Return a list of actions moving from start_pos to a cell adjacent\n      (Manhattan distance\u202f=\u202f1) to any of target_cells, avoiding blocked_kinds.\"\"\"\n      W, H = grid.shape[:2]\n      # Build blocked map\n      blocked = np.zeros((W, H), dtype=bool)\n      for k in blocked_kinds:\n          blocked |= grid[:, :, k] > 0\n\n      sx, sy = start_pos\n      # Already adjacent?\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract information from the environment.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  # Goal index stored in the task (env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  blocked_kinds = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present anymore; abort planning.\n              return plan\n\n          path = bfs_adjacent(pos, cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(4)   # USE action\n\n          # Find which cell we are adjacent to.\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              # Unexpected; stop to avoid infinite loop.\n              break\n\n          # Update local grid copy and decrement needed count.\n          grid[adj[0], adj[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:25:09.074081", "function_name": "make_arrow", "function_body": "  # ----- Direction / action helpers -------------------------------------------------\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def _bfs_adjacent(start_pos, target_cells, grid, blocked_kinds):\n      \"\"\"\n      Bread\u2011first search that returns a list of actions moving the agent from\n      ``start_pos`` to a cell *adjacent* (Manhattan distance\u202f=\u202f1) to any cell in\n      ``target_cells``.  ``grid`` has shape (W, H, K).  Cells whose kind is in\n      ``blocked_kinds`` are treated as obstacles.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # Build a boolean map of blocked cells.\n      blocked = np.zeros((W, H), dtype=bool)\n      for kind in blocked_kinds:\n          blocked |= grid[:, :, kind] > 0\n\n      sx, sy = start_pos\n\n      # Already adjacent to a target?\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacent cell.\n      return []\n\n  # ----- Extract task information ---------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                 # mutable copy for planning\n  pos = tuple(state.pos)                   # (x, y)\n\n  # Goal index is stored inside the task (CraftLab passes a Task namedtuple).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in the environment task.\")\n\n  # Primitive (or intermediate) requirements for the goal.\n  required = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  blocked_kinds = env.world.non_grabbable_indices          # e.g. trees, water\n\n  plan = []\n\n  # ----- 1. Collect all required primitives -----------------------------------------\n  for kind_idx, need_cnt in required.items():\n      while need_cnt > 0:\n          # Locate all remaining instances of this kind on the map.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Not enough primitives left; abort planning.\n              return plan\n\n          # Find a path to the nearest reachable instance (adjacent).\n          path = _bfs_adjacent(pos, cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Identify which cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected \u2013 break to avoid infinite loop.\n              break\n\n          # Pick up as many as we need from this cell (could be >1).\n          while need_cnt > 0 and grid[adj_cell[0], adj_cell[1], kind_idx] > 0:\n              plan.append(4)                     # USE\n              grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n              need_cnt -= 1\n\n  # ----- 2. Move to the workshop and craft the goal item ---------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  # Workshop location can be stored under \"_at\" (new) or \"_key\" (legacy).\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index.\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = _bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement to workshop adjacency.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:25:38.058374", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Combine position, direction, inventory and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
