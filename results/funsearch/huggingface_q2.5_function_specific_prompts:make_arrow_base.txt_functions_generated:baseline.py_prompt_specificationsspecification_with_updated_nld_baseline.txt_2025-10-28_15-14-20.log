{"timestamp": "2025-10-28T18:53:19.299375", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the target item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Action \u2192 (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def walkable(grid, x, y):\n      \"\"\"True if (x, y) lies inside the grid and the cell is empty.\"\"\"\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"\n      Bread\u2011first search that returns a list of movement actions (0\u20113)\n      ending with the agent facing a cell that contains `target_kind`.\n      Empty list means either already facing the target or it is unreachable.\n      \"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n\n      # Already facing the target?\n      dx, dy = deltas[sdir]\n      fx, fy = sx + dx, sy + dy\n      if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n          return []\n\n      queue = deque()\n      queue.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # Look ahead from current orientation\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          # Expand to four possible movement actions\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      # Unreachable\n      return []\n\n  def target_ahead(state, kind):\n      \"\"\"Return True if the cell directly in front of the agent contains `kind`.\"\"\"\n      x, y = state.pos\n      d = state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1) Gather all primitive resources needed for a single arrow\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          move_seq = bfs_to_target(cur_state, prim_idx)\n          if not move_seq and not target_ahead(cur_state, prim_idx):\n              # Primitive not reachable \u2013 abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          # Update the simulated state\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # 2) Craft the arrow at its designated workshop (if any)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if not move_seq and not target_ahead(cur_state, workshop_idx):\n          # Workshop unreachable \u2013 still issue a USE (harmless)\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop; craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:53:20.409695", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Action \u2192 (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def walkable(grid, x, y):\n      \"\"\"Return True if (x, y) is inside the grid and contains no entities.\"\"\"\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"\n      Bread\u2011first search for a sequence of movement actions (0\u20113) that ends\n      with the agent facing a cell containing `target_kind`. Returns the\n      action list, or an empty list if already facing the target or unreachable.\n      \"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n\n      # Already facing the target?\n      dx, dy = deltas[sdir]\n      fx, fy = sx + dx, sy + dy\n      if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n          return []\n\n      queue = deque()\n      queue.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # Look ahead from current orientation\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n          # Expand to four possible movement actions\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      # Unreachable\n      return []\n\n  def target_ahead(state, kind):\n      \"\"\"True if the cell directly in front of the agent contains `kind`.\"\"\"\n      x, y = state.pos\n      d = state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all primitive resources required for one arrow\n  # ----------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_seq = bfs_to_target(cur_state, prim_idx)\n          if not move_seq and not target_ahead(cur_state, prim_idx):\n              # Primitive cannot be reached \u2013 abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          # Apply actions to keep cur_state up\u2011to\u2011date\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ----------------------------------------------------------------------\n  # 2) Craft the arrow at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if not move_seq and not target_ahead(cur_state, workshop_idx):\n          # Workshop unreachable \u2013 still issue a USE (harmless)\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No dedicated workshop \u2013 craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:53:52.225940", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T18:53:53.343922", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Directions: (dx, dy) and corresponding action indices\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of actions to reach any\n  # target cell while avoiding blocked cells.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No path found \u2013 should not happen for solvable tasks\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and press USE `cnt`\n  # times. Updates the current position and the action list.\n  # ------------------------------------------------------------------\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          # Find all cells that currently contain the desired kind\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)          # USE action\n\n  # ------------------------------------------------------------------\n  # Gather world / recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Resolve full crafting plan: primitive requirements and ordered steps\n  # ------------------------------------------------------------------\n  needed_prims = {}          # primitive idx \u2192 total count required\n  craft_steps = []           # list of (item_idx, count) in post\u2011order\n\n  def resolve(item_idx, multiplier):\n      \"\"\"Recursively collect primitive needs and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                         # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # First resolve ingredients (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # Then schedule this item to be crafted\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static environment data\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  pos = tuple(env._current_state.pos)\n  actions = []\n\n  # Cells that cannot be traversed (non\u2011grabbable entities)\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed_prims.items():\n      acquire(kind_idx, count)\n\n  # ------------------------------------------------------------------\n  # 2) Perform crafting steps at the appropriate workshops\n  # ------------------------------------------------------------------\n  for item_idx, count in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      workshop_cells = {(x, y) for x in range(w) for y in range(h)\n                        if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, workshop_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * count)   # USE at workshop to craft\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:54:09.541095", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-28T18:54:25.172730", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects from the given environment\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Identify the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the scenario\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Helper that creates a hashable representation of a CraftState\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                         # Upper bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # Default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions from the current state\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T18:54:44.759030", "function_name": "make_arrow", "function_body": "  # Mapping between direction vectors and action indices.\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def _bfs_to_adjacent(start_pos, target_cells, grid):\n      \"\"\"Return a list of actions that moves the agent from ``start_pos`` to a\n      cell that is Manhattan\u2011distance 1 from any cell in ``target_cells``.\n      Cells containing any non\u2011grabbable entity are treated as blocked.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # Build blocked mask from non\u2011grabbable indices.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start_pos\n\n      # If already adjacent to a target, no movement needed.\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacent cell.\n      return []\n\n  # ------------------------------------------------------------------\n  # Planning starts here.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)          # current (x, y) position\n  plan = []                        # list of action indices to return\n\n  # Goal index is stored in the task description.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # Locate cells that currently contain this primitive.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present \u2013 cannot continue planning.\n              return plan\n\n          # Compute a path to a cell adjacent to any of the candidate cells.\n          path = _bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update the agent's position.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Perform the USE action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Determine which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Safety fallback \u2013 should not happen.\n              break\n\n          # Update the local copy of the grid and decrement the remaining count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop required by the recipe and craft the item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve the workshop index (could be a string name or already an int).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = _bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use the workshop to craft the goal item.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:54:45.867466", "function_name": "make_arrow", "function_body": "  # Mapping between direction vectors and action indices.\n  DIR2ACT = {(0, 1): 0,   # DOWN\n             (0, -1): 1,  # UP\n             (-1, 0): 2,  # LEFT\n             (1, 0): 3}   # RIGHT\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Shortest sequence of actions moving from *start* to a cell\n      adjacent (Manhattan distance = 1) to any cell in *targets*.\n      Cells occupied by non\u2011grabbable entities are treated as blocked.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Build blocked mask from non\u2011grabbable kinds.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      # If already adjacent, return empty path.\n      for tx, ty in targets:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacent cell.\n      return []\n\n  # ------------------------------------------------------------------\n  # Planning.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  # Goal index is stored in env.task.goal (int).  Raise if not found.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect each required primitive.\n  # --------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present \u2013 abort planning.\n              return plan\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Find which primitive cell we are adjacent to.\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              break  # safety\n\n          # Update local copy of the grid and decrement need.\n          grid[adj[0], adj[1], kind_idx] -= 1\n          cnt -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to workshop (if required) and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be name or int).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft action.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:55:28.911684", "function_name": "make_arrow", "function_body": "  import heapq\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _a_star(start, goal, grid):\n      \"\"\"Return a list of actions moving from start to goal using A*.\"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      moves = [((0, 1), DOWN), ((0, -1), UP), ((-1, 0), LEFT), ((1, 0), RIGHT)]\n      open_set = []\n      heapq.heappush(open_set, (0 + abs(start[0] - goal[0]) + abs(start[1] - goal[1]),\n                                0, tuple(start), None))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      while open_set:\n          _, g, current, _ = heapq.heappop(open_set)\n          if list(current) == goal:\n              # reconstruct path\n              path = []\n              while current in came_from:\n                  prev, act = came_from[current]\n                  path.append(act)\n                  current = prev\n              path.reverse()\n              return path\n          for (dx, dy), act in moves:\n              nx, ny = current[0] + dx, current[1] + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              neighbor = (nx, ny)\n              # allow stepping onto the goal even if occupied\n              if neighbor != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              tentative_g = g + 1\n              if neighbor not in g_score or tentative_g < g_score[neighbor]:\n                  g_score[neighbor] = tentative_g\n                  f = tentative_g + abs(nx - goal[0]) + abs(ny - goal[1])\n                  heapq.heappush(open_set, (f, tentative_g, neighbor, act))\n                  came_from[neighbor] = (current, act)\n      # No path found \u2013 return empty list (caller may handle)\n      return []\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing the given kind.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine current position.\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid to track collected items.\n  grid = env.scenario.init_grid.copy()\n  goal_idx = env.task.goal\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx)\n  for kind_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning.\n              return actions\n          path = _a_star(cur_pos, target, grid)\n          actions.extend(path)\n          actions.append(USE)                         # pick up the item\n          grid[target[0], target[1], kind_idx] = 0    # mark as taken\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          path = _a_star(cur_pos, workshop_pos, grid)\n          actions.extend(path)\n          actions.append(USE)                         # craft at workshop\n      else:\n          # No workshop found \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 just use the action to craft.\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:55:30.030154", "function_name": "make_arrow", "function_body": "  # Helper: BFS path planning avoiding occupied cells (except the goal)\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions to move from start to goal using BFS.\n      start/goal are [x, y] lists. Cells with any occupancy are blocked,\n      except the goal cell itself.\n      \"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n      moves = [((0, 1), 0),   # DOWN\n               ((0, -1), 1),  # UP\n               ((-1, 0), 2),  # LEFT\n               ((1, 0), 3)]   # RIGHT\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1]))\n      visited = {(start[0], start[1]): (None, None)}  # pos -> (prev_pos, action)\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              visited[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n      if tuple(goal) not in visited:\n          return []  # no path found\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while visited[cur][0] is not None:\n          prev, act = visited[cur]\n          path.append(act)\n          cur = prev\n      path.reverse()\n      return path\n\n  # Helper: find nearest cell containing a specific kind\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing ``kind_idx`` (Manhattan distance).\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Initialize position and mutable grid copy\n  # ------------------------------------------------------------------\n  USE = 4\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  grid = env.scenario.init_grid.copy()\n  goal_idx = env.task.goal\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements (including goal if it is primitive)\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for kind_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              return actions  # primitive not found; abort planning\n          actions.extend(_bfs_path(cur_pos, target, grid))\n          actions.append(USE)                     # pick up\n          grid[target[0], target[1], kind_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if needed) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(_bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)                     # craft at workshop\n          cur_pos = workshop_pos\n      else:\n          actions.append(USE)                     # fallback: craft where we are\n  else:\n      actions.append(USE)                         # craft without specific workshop\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:55:47.953824", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  def _move_to(cur, target, seq):\n      \"\"\"Append moves that bring `cur` (list [x, y]) to `target`.\"\"\"\n      while cur[0] != target[0] or cur[1] != target[1]:\n          if cur[0] < target[0]:\n              seq.append(RIGHT)\n              cur[0] += 1\n          elif cur[0] > target[0]:\n              seq.append(LEFT)\n              cur[0] -= 1\n          elif cur[1] < target[1]:\n              seq.append(DOWN)\n              cur[1] += 1\n          elif cur[1] > target[1]:\n              seq.append(UP)\n              cur[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing `kind_idx`. Return [x, y] or None.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine starting position\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid so we can mark items as taken\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather required primitive resources\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Required primitive missing \u2013 abort planning early.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                     # pick up / interact\n          grid[target[1], target[0], kind_idx] = 0   # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to workshop (if recipe specifies one) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                     # perform crafting\n\n  # Return the full planned action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:55:49.072461", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: move the agent from its current position to a target cell.\n  # ----------------------------------------------------------------------\n  def _move_to(cur, target, seq):\n      while cur[0] != target[0] or cur[1] != target[1]:\n          if cur[0] < target[0]:\n              seq.append(RIGHT)\n              cur[0] += 1\n          elif cur[0] > target[0]:\n              seq.append(LEFT)\n              cur[0] -= 1\n          elif cur[1] < target[1]:\n              seq.append(DOWN)\n              cur[1] += 1\n          elif cur[1] > target[1]:\n              seq.append(UP)\n              cur[1] -= 1\n\n  # ----------------------------------------------------------------------\n  # Helper: locate the nearest cell that still contains at least one\n  # instance of the specified kind index. Returns [x, y] or None.\n  # ----------------------------------------------------------------------\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Determine the starting position (live state if available, else init)\n  # ----------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid to keep track of taken items\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n  goal_idx = env.task.goal\n\n  # ----------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal.\n  # ----------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Required primitive missing \u2013 abort planning early.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                     # pick up / interact\n          grid[target[1], target[0], kind_idx] = 0  # mark as taken\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                     # perform crafting\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:56:21.143147", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # movement deltas and corresponding action indices\n  moves = [((0, 1), DOWN), ((0, -1), UP), ((-1, 0), LEFT), ((1, 0), RIGHT)]\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions to move from start to goal using BFS.\n      Cells occupied by any kind are treated as blocked, except the goal cell.\"\"\"\n      w, h = grid.shape[0], grid.shape[1]\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == tuple(goal):\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing the given kind index.\n      Returns [x, y] or None if not found.\"\"\"\n      xs, ys = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine current agent position (live state if available)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)          # [x, y]\n  else:\n      cur_pos = list(env.scenario.init_pos)           # [x, y]\n\n  # Copy of the static grid so we can mark items as taken\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal item\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive, we must also pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Required primitive not present; abort planning.\n              return actions\n          actions += bfs_path(cur_pos, target, grid)\n          actions.append(USE)  # pick up the primitive\n          # Mark the item as taken in our copy of the grid.\n          grid[target[0], target[1], kind_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. If the recipe specifies a workshop, go there and craft the item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions += bfs_path(cur_pos, workshop_pos, grid)\n          actions.append(USE)  # craft at the workshop\n          cur_pos = workshop_pos\n\n  # ------------------------------------------------------------------\n  # Return the planned sequence of actions\n  # ------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:56:22.244676", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # movement vectors for BFS\n  moves = [((0, 1), DOWN), ((0, -1), UP), ((-1, 0), LEFT), ((1, 0), RIGHT)]\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return list of actions to move from start to goal avoiding occupied cells.\"\"\"\n      w, h = grid.shape[0], grid.shape[1]\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto goal even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n      if tuple(goal) not in prev:\n          return []  # unreachable\n      # reconstruct\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find nearest cell (x,y) containing kind_idx.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n\n  # current position\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # copy of static grid for planning\n  grid = env.scenario.init_grid.copy()\n\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives (including goal if primitive)\n  # ------------------------------------------------------------------\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx).copy()\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_reqs[goal_idx] = primitive_reqs.get(goal_idx, 0) + 1\n\n  for kind, cnt in primitive_reqs.items():\n      for _ in range(cnt):\n          target = nearest_kind(kind, cur_pos, grid)\n          if target is None:\n              return actions\n          actions.extend(bfs_path(cur_pos, target, grid))\n          actions.append(USE)\n          grid[target[0], target[1], kind] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Go to workshop and craft (if needed)\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)  # craft\n          cur_pos = workshop_pos\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
