{"timestamp": "2025-10-28T19:01:15.352203", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Helper: shortest\u2011path (BFS) returning a list of action indices\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]          # DOWN, UP, LEFT, RIGHT\n  ACTION_USE = env.action_specs().get(\"USE\", 4)\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of actions that moves from start to any cell in targets.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 should not happen for a solvable scenario\n      return []\n\n  def move_to(target_cells):\n      \"\"\"Move from the current position to the nearest cell in target_cells.\"\"\"\n      nonlocal pos, actions\n      path = bfs(pos, target_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n  def collect(kind_idx, amount):\n      \"\"\"Collect `amount` items of the given kind by moving onto them and using.\"\"\"\n      nonlocal pos, actions\n      for _ in range(amount):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          move_to(cells)\n          actions.append(ACTION_USE)   # pick up the item\n\n  # ----------------------------------------------------------------------\n  # Resolve recipe for the goal (arrow) \u2192 primitive needs + crafting order\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind \u2192 total count\n  craft_steps = []           # list of (item_idx, count) in topological order\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively accumulate primitive needs and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve all ingredient items first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Then schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Static environment data\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Gather all primitive resources needed\n  for kind_idx, cnt in needed_prims.items():\n      collect(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # locate workshop cells\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      move_to(wk_cells)\n\n      # use the workshop the required number of times\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T19:01:16.465189", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS for shortest path avoiding blocked cells.\n  # ----------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 should not happen for solvable tasks\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: move to nearest cell in `target_cells`.\n  # ----------------------------------------------------------------------\n  def move_to(target_cells):\n      nonlocal pos, actions\n      path = bfs(pos, target_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n  # ----------------------------------------------------------------------\n  # Helper: collect a specific primitive `kind_idx` a given number of times.\n  # ----------------------------------------------------------------------\n  def collect(kind_idx, amount):\n      nonlocal pos, actions\n      for _ in range(amount):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          move_to(cells)\n          actions.append(ACTION_USE)   # pick up the item\n\n  # ----------------------------------------------------------------------\n  # Resolve recipe for the goal (arrow) \u2013 compute required primitives and\n  # crafting steps in dependency order.\n  # ----------------------------------------------------------------------\n  needed_prims = {}          # primitive kind -> total count\n  craft_steps = []           # list of (item_idx, count) in topological order\n\n  def resolve(item_idx, multiplier):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # Resolve ingredients first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # Schedule this item to be crafted after its ingredients\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Static environment data\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Gather all primitive resources needed\n  for kind_idx, cnt in needed_prims.items():\n      collect(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      move_to(wk_cells)\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T19:02:03.143696", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  world = getattr(env, \"world\", None)\n  if world is None:\n      tmp_state = getattr(env, \"_current_state\", None)\n      if tmp_state is not None:\n          world = tmp_state.world\n  if world is None:\n      raise RuntimeError(\"World not found in environment.\")\n  cookbook = world.cookbook\n\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  pos = tuple(state.pos)\n  cur_grid = state.grid.copy()\n  actions = []\n  harvested = set()\n\n  def occupied(g):\n      return np.any(g > 0, axis=2)\n\n  for prim_idx, needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          occ = occupied(cur_grid)\n          path = _bfs(pos, [loc], occ)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          occ = occupied(cur_grid)\n          path = _bfs(pos, [target_ws], occ)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:02:04.280289", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any of the\n  # `target_cells`.  `occ` is a boolean 2\u2011D array where True marks a\n  # blocked cell.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, target_cells, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      targets = set(target_cells)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent to a target, stop.\n          for tx, ty in targets:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world, cookbook and current state.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_wrap = getattr(env, \"_current_state\", None)\n      if state_wrap is not None:\n          world = getattr(state_wrap, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate world object in the environment.\")\n  cookbook = world.cookbook\n\n  # Ensure we have a current state (reset if necessary).\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Goal is hard\u2011coded to \u201carrow\u201d.\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Current position and a mutable copy of the grid.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Greedy nearest\u2011first ordering.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Compute occupied map (any non\u2011empty cell blocks movement).\n          occupied = np.any(cur_grid > 0, axis=2)\n          # Find a path to a cell adjacent to the primitive.\n          path = _bfs_path(pos, [loc], occupied)\n          actions.extend(path)\n          # Update simulated position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Remove the primitive from the grid so future planning sees the cell as free.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          occupied = np.any(cur_grid > 0, axis=2)\n          path = _bfs_path(pos, [target_ws], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:02:30.570006", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash includes position, direction, inventory contents and full grid layout\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long partial plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt = cur.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:02:45.301094", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Target item index for \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Create a hashable representation of a state for visited\u2011set checking\n  def _state_hash(st):\n      # Include position, direction, inventory, and grid layout\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                         # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default: 0\u20114 (move + use)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:03:06.667282", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  moves = [\n      ((0, 1), DOWN),   # down  (y+1)\n      ((0, -1), UP),    # up    (y-1)\n      ((-1, 0), LEFT),  # left  (x-1)\n      ((1, 0), RIGHT),  # right (x+1)\n  ]\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions moving from start to goal using BFS.\n      Cells containing any entity are treated as blocked, except the goal\n      cell itself which may be occupied (e.g., a workshop or item).\"\"\"\n      w, h = grid.shape[0], grid.shape[1]          # x\u2011size, y\u2011size\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell (Manhattan) that currently contains the given kind.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)   # y\u2011rows, x\u2011cols\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine starting position (live state if available)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid for planning\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          actions.extend(bfs_path(cur_pos, target, grid))\n          actions.append(USE)                     # pick up primitive\n          # Remove the primitive from our planning grid\n          grid[target[0], target[1], prim_kind] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)   # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T19:03:07.788047", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move current position (list [x, y]) toward target (list [x, y])\n  # ------------------------------------------------------------------\n  def _move_to(cur, target, seq):\n      \"\"\"Append actions to seq that move cur to target using Manhattan moves.\"\"\"\n      while cur[0] != target[0] or cur[1] != target[1]:\n          if cur[0] < target[0]:\n              seq.append(RIGHT)\n              cur[0] += 1\n          elif cur[0] > target[0]:\n              seq.append(LEFT)\n              cur[0] -= 1\n          elif cur[1] < target[1]:\n              seq.append(DOWN)\n              cur[1] += 1\n          elif cur[1] > target[1]:\n              seq.append(UP)\n              cur[1] -= 1\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell that currently contains the requested kind.\n  # Returns [x, y] or None.\n  # ------------------------------------------------------------------\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      xs, ys = np.where(grid[:, :, kind_idx] > 0)   # x\u2011indices first, then y\u2011indices\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine starting position (live state if available, else init pos)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid so we can \u201cremove\u201d items once taken.\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive, we must also pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Required primitive missing \u2013 abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                     # pick up / interact\n          # Mark the primitive as taken in our local grid copy.\n          grid[target[0], target[1], kind_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. If the recipe specifies a workshop, go there and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)   # perform crafting at the workshop\n\n  # Return the complete sequence of actions.\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T19:03:35.281638", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  goal = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # mutable copy of occupancy\n  inventory = state.inventory.copy()         # mutable copy of inventory\n  actions = []\n\n  def bfs(start, target):\n      \"\"\"Return a list of movement actions from start to target avoiding non\u2011grabbable entities.\"\"\"\n      w, h = grid.shape[:2]\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((w, h), dtype=bool)\n      blocked[target[0], target[1]] = False  # allow stepping onto target\n\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      path = []\n      cur = target\n      while cur != start:\n          path.append(act_to[cur])\n          cur = parent[cur]\n      path.reverse()\n      return path\n\n  def move_to(target):\n      \"\"\"Move simulated agent to *target*, updating pos and actions.\"\"\"\n      nonlocal pos\n      if pos == target:\n          return\n      path = bfs(pos, target)\n      if path is None:\n          # Fallback: Manhattan moves ignoring obstacles\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          path = []\n          while dx > 0:\n              path.append(DOWN); dx -= 1\n          while dx < 0:\n              path.append(UP); dx += 1\n          while dy > 0:\n              path.append(RIGHT); dy -= 1\n          while dy < 0:\n              path.append(LEFT); dy += 1\n      actions.extend(path)\n      pos = target\n\n  # -----------------------------------------------------------------\n  # Collect required primitives (taking current inventory into account)\n  # -----------------------------------------------------------------\n  for prim_idx, req_cnt in needed_prims.items():\n      have = int(inventory[prim_idx])\n      need = max(0, req_cnt - have)\n\n      for _ in range(need):\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              break  # no more instances on the map\n\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          move_to(target)\n          actions.append(USE)  # pick up\n\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # -----------------------------------------------------------------\n  # Move to workshop (if required) and craft the goal item\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          target_ws = min(\n              ws_locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          move_to(target_ws)\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T19:03:36.409848", "function_name": "make_arrow", "function_body": "  # Action indices\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # Goal index and required primitives\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # Current simulated state\n  state = env._current_state\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # mutable copy of occupancy\n  inventory = state.inventory.copy()         # mutable copy of inventory\n\n  actions = []\n\n  from collections import deque\n  import numpy as np\n\n  # -----------------------------------------------------------------\n  # Helper: BFS path planning avoiding non\u2011grabbable entities\n  # -----------------------------------------------------------------\n  def bfs(start, target):\n      w, h = grid.shape[:2]\n\n      # Determine blocked cells (any non\u2011grabbable entity present)\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((w, h), dtype=bool)\n\n      # Allow stepping onto the target even if it would otherwise be blocked\n      blocked[target[0], target[1]] = False\n\n      q = deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # Reconstruct action list\n      path = []\n      cur = target\n      while cur != start:\n          path.append(act_to[cur])\n          cur = parent[cur]\n      path.reverse()\n      return path\n\n  # -----------------------------------------------------------------\n  # Helper: move agent (updates pos and records actions)\n  # -----------------------------------------------------------------\n  def move_to(target):\n      nonlocal pos\n      if pos == target:\n          return\n      path = bfs(pos, target)\n      if path is None:\n          # Fallback: simple Manhattan moves ignoring obstacles\n          dx, dy = target[0] - pos[0], target[1] - pos[1]\n          path = []\n          while dx > 0:\n              path.append(DOWN); dx -= 1\n          while dx < 0:\n              path.append(UP); dx += 1\n          while dy > 0:\n              path.append(RIGHT); dy -= 1\n          while dy < 0:\n              path.append(LEFT); dy += 1\n      actions.extend(path)\n      pos = target\n\n  # -----------------------------------------------------------------\n  # Collect required primitives (respecting current inventory)\n  # -----------------------------------------------------------------\n  for prim_idx, req_cnt in needed.items():\n      have = int(inventory[prim_idx])\n      need = max(0, req_cnt - have)\n\n      for _ in range(need):\n          # Locate remaining instances of this primitive on the map\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more instances available; give up further collection\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(locations, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n          move_to(target)\n          actions.append(USE)  # pick up the primitive\n\n          # Update simulated world state\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n\n  # -----------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the goal item\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          # Choose nearest workshop\n          target_ws = min(ws_locations, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          move_to(target_ws)\n          actions.append(USE)  # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
