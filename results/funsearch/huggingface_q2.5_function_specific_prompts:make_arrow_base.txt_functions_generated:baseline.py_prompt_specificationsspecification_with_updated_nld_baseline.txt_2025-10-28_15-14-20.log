{"timestamp": "2025-10-28T20:24:56.434998", "function_name": "make_arrow", "function_body": "  # constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  import collections, numpy as np\n\n  def _bfs_path(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  # locate world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = getattr(state_tmp, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld not found in env\")\n  cookbook = world.cookbook\n\n  # ensure we have a state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  prim_req = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []\n  harvested = set()\n\n  # collect primitives\n  for prim_idx, needed in prim_req.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = _bfs_path(pos, [loc], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n          grid[loc[0], loc[1], prim_idx] = 0\n          occupied[loc[0], loc[1]] = False\n          harvested.add(loc)\n          collected += 1\n\n  # craft at workshop if required\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_path(pos, [target_ws], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:25:32.922954", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, occ):\n      \"\"\"Return a list of actions that moves from start to a cell adjacent to any target.\"\"\"\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def _apply_action(pos, act):\n      if act == RIGHT:\n          return (pos[0] + 1, pos[1])\n      if act == LEFT:\n          return (pos[0] - 1, pos[1])\n      if act == DOWN:\n          return (pos[0], pos[1] + 1)\n      if act == UP:\n          return (pos[0], pos[1] - 1)\n      return pos\n\n  # Retrieve world and cookbook.\n  world = getattr(env, \"world\", None)\n  if world is None:\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  if world is None:\n      raise RuntimeError(\"World object not found in the environment\")\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\"\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Ensure we have a current state; reset if necessary.\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n  occ = np.any(grid > 0, axis=2)  # occupied cells mask\n\n  actions = []\n  harvested = set()   # locations already collected\n\n  # Collect required primitives (greedy nearest first).\n  for prim_idx, needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = _bfs_path(pos, [loc], occ)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          actions.append(USE)                     # pick up the primitive\n          occ[loc[0], loc[1]] = False\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # Move to the required workshop (if any) and craft.\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_path(pos, [target_ws], occ)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          actions.append(USE)   # craft at the workshop\n      else:\n          actions.append(USE)\n  else:\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:25:34.093691", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  # `start` to a cell adjacent (Manhattan distance == 1) to any of the\n  # coordinates in `targets`.  Cells that contain any entity are treated\n  # as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent to a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list (will be ignored by caller).\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: Update a position given an action.\n  # ------------------------------------------------------------------\n  def _apply_action(pos, act):\n      if act == RIGHT:\n          return (pos[0] + 1, pos[1])\n      if act == LEFT:\n          return (pos[0] - 1, pos[1])\n      if act == DOWN:\n          return (pos[0], pos[1] + 1)\n      if act == UP:\n          return (pos[0], pos[1] - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Extract world, cookbook and the hard\u2011coded goal (\"arrow\").\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  if world is None:\n      raise RuntimeError(\"World object not found in the environment\")\n  cookbook = world.cookbook\n\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  cur_grid = state.grid.copy()    # mutable copy for path\u2011finding\n\n  actions = []\n  harvested = set()               # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          actions.append(USE)                     # pick up the primitive\n          # Remove the primitive from the grid so future paths treat the cell as empty.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Move to the nearest workshop cell.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          actions.append(USE)   # craft at the workshop\n      else:\n          # No workshop present \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 craft at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:26:04.215143", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects (support both raw and wrapper environments)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\" (may raise if not present)\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Include position, direction, inventory and the full grid layout.\n      return (st.pos,\n              st.dir,\n              tuple(st.inventory.tolist()),\n              st.grid.tobytes())\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000                     # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:26:19.968827", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      # Grid can be large; convert to bytes for exact comparison\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000                     # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:26:40.042289", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and fetch the current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal: arrow\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  non_grab = list(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest walkable path from start to goal (list of positions).\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = collections.deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []   # unreachable\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing the given kind (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of target (preferring N, S, W, E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target   # fallback (target itself is assumed walkable)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = tuple(state.pos)   # current position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not found; abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          if not path and cur != stand_pos:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself\n          path = bfs_path(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, move there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions([cur] + path))\n              cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:26:41.192990", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and fetch the current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal item (arrow) and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  non_grabbable = list(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grabbable] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Return shortest walkable path (list of positions) from start to goal.\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      from collections import deque\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell containing ``kind`` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (preferring N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback to the target itself\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = tuple(state.pos)   # current agent position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          if not path and cur != stand_pos:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself\n          path = bfs_path(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, move there\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions([cur] + path))\n              cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:27:19.154011", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # Copy mutable structures so we can simulate actions locally.\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of actions (DOWN,UP,LEFT,RIGHT) to reach any goal cell.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # Allow stepping onto a goal cell even if it currently holds something.\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update the simulated position according to a sequence of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect *needed* units of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # Locate all cells that still contain the primitive.\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # No more of this primitive on the map.\n          # Choose the first reachable primitive.\n          path = None\n          target = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path = cand\n                  target = loc\n                  break\n          if path is None:\n              break  # Cannot reach any remaining primitive.\n          actions.extend(path)\n          move_along(path)\n          # Pick it up.\n          actions.append(4)  # USE\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Make sure inventory[item_idx] >= amount by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              # Primitive: just collect the missing amount.\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # Ensure all ingredients are available.\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to the required workshop (if any).\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # Perform the craft action.\n          actions.append(4)  # USE\n          # Consume ingredients.\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          # Add the crafted item.\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow.\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:27:20.292406", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Target item name and index\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # Copy mutable state for planning\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of actions (0=DOWN,1=UP,2=LEFT,3=RIGHT) to reach any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # cell is blocked if any kind is present, unless it's a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update simulated position according to *path*.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect *needed* units of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells still containing the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              raise RuntimeError(f\"Cannot find enough of primitive index {prim_idx}\")\n          # find the first reachable primitive\n          path = None\n          target = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  path = p\n                  target = loc\n                  break\n          if path is None:\n              raise RuntimeError(\"Primitive unreachable\")\n          actions.extend(path)\n          move_along(path)\n          # pick up with USE\n          actions.append(4)  # USE\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Guarantee that inventory[item_idx] >= amount by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives:\n              # Primitive: just collect the missing amount\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # Ensure each ingredient is available\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to required workshop if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if not ws_cells:\n                  raise RuntimeError(\"Required workshop not present in the world\")\n              path = bfs(pos, {ws_cells[0]})\n              if path is None:\n                  raise RuntimeError(\"Workshop unreachable\")\n              actions.extend(path)\n              move_along(path)\n\n          # Perform the craft action\n          actions.append(4)  # USE\n          # Update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:27:45.217504", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Create a hashable representation of a state for visited\u2011set checking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 1000                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:28:00.037010", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to hash a state (position, direction, inventory, grid)\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 600                     # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long action sequences\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:28:23.064917", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN:(0,1), UP:(0,-1), LEFT:(-1,0), RIGHT:(1,0)}\n\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n      for tx, ty in target_set:\n          if abs(start[0]-tx)+abs(start[1]-ty)==1:\n              return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x+dx, y+dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx-tx)+abs(ny-ty)==1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []\n\n  # obtain state and world\n  world = getattr(env, \"world\", None)\n  if world is None:\n      if not hasattr(env, \"_current_state\") or env._current_state is None:\n          env.reset()\n      state = env._current_state\n      world = state.world\n  else:\n      if not hasattr(env, \"_current_state\") or env._current_state is None:\n          env.reset()\n      state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  if not primitives_needed:\n      return []\n\n  grid = state.grid\n  pos = tuple(state.pos)\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []\n  harvested = set()\n\n  for prim_idx, cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < cnt:\n          cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0) if tuple(p) not in harvested]\n          if not cells:\n              break\n          cells.sort(key=lambda c: abs(c[0]-pos[0])+abs(c[1]-pos[1]))\n          target = cells[0]\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0]+dx, pos[1]+dy)\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n          occupied[target] = False\n\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0]-pos[0])+abs(c[1]-pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0]+dx, pos[1]+dy)\n          actions.append(USE)\n      else:\n          actions.append(USE)\n  else:\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:28:24.224021", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices (match CraftWorld defaults)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any target.\"\"\"\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []\n\n  # ----------------------------------------------------------------------\n  # Retrieve world and current state from the environment (handle wrappers)\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Try to get a state object directly\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is a primitive itself \u2013 nothing to do\n      return []\n\n  # ----------------------------------------------------------------------\n  # Current grid, position, and occupancy mask\n  # ----------------------------------------------------------------------\n  grid = state.grid                 # shape (W, H, n_kinds)\n  pos = tuple(state.pos)            # (x, y)\n  occupied = np.any(grid > 0, axis=2)  # True where any entity exists\n\n  actions = []\n  harvested = set()  # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells containing this primitive\n          prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          # Exclude already harvested locations\n          prim_cells = [c for c in prim_cells if c not in harvested]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 exit loop\n              break\n\n          # Choose the nearest primitive (Manhattan distance)\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update position\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the cell becomes empty after pickup\n          occupied[target] = False\n          grid[:, :, prim_idx][target] = 0\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be name or int)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          # No workshop found; just use current location\n          actions.append(USE)\n  else:\n      # No specific workshop required\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:28:53.155148", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Direction deltas matching action indices (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def walkable(grid, x, y):\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      # a cell is walkable if it contains no entities at all\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"Return a list of movement actions (0\u20113) that ends with the agent\n      facing a cell containing `target_kind`. Returns None if unreachable.\"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n      queue = deque()\n      queue.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n      while queue:\n          x, y, d, acts = queue.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      return None\n\n  def target_ahead(state, kind):\n      \"\"\"True if the cell directly in front of the agent contains `kind`.\"\"\"\n      x, y = state.pos\n      d = state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all primitive resources required for one arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  if not primitive_needs:\n      # Arrow itself is a primitive\n      primitive_needs = {arrow_idx: 1}\n\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_seq = bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              # Cannot reach this primitive; abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          # Workshop unreachable \u2013 still try a USE (will fail harmlessly)\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop; craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:28:54.291717", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Direction deltas matching action indices (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def walkable(grid, x, y):\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      # a cell is walkable if it contains no entities at all\n      return not np.any(grid[x, y, :])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"Return a list of movement actions (0\u20113) that ends with the agent\n      facing a cell containing `target_kind`. Empty list means already\n      facing the target or unreachable.\"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n      while q:\n          x, y, d, acts = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n      return []\n\n  def target_ahead(state, kind):\n      \"\"\"True if the cell directly in front of the agent contains `kind`.\"\"\"\n      x, y = state.pos\n      d = state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect all primitive resources required for one arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_seq = bfs_to_target(cur_state, prim_idx)\n          if not move_seq and not target_ahead(cur_state, prim_idx):\n              # Cannot reach this primitive; abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if not move_seq and not target_ahead(cur_state, workshop_idx):\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop; craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:29:22.568715", "function_name": "make_arrow", "function_body": "  # Retrieve the underlying scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Resolve the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the start state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper that produces a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  # Search parameters\n  MAX_STEPS = 2000                     # hard limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test \u2013 does the inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune paths that are already too long\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all primitive actions (movement + USE)\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If we exhaust the search without finding a solution, return empty plan\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:29:38.300025", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:30:06.083580", "function_name": "make_arrow", "function_body": "  import collections\n  from collections import deque, namedtuple\n\n  # Get the scenario and world objects from the environment (CraftLab or raw scenario)\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\" in the cookbook\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a state for visited\u2011set tracking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Search parameters\n  MAX_STEPS = 500                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typical actions: 0\u20114 (UP/DOWN/LEFT/RIGHT/USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:30:21.823897", "function_name": "make_arrow", "function_body": "  import collections\n\n  # Obtain scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = collections.namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(start_state)}\n  frontier = collections.deque([Node(start_state, [])])\n\n  MAX_STEPS = 300                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:30:43.631210", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined in CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Reset environment and obtain current state/world information\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # ------------------------------------------------------------------\n  # Goal information: index of \"arrow\" and its primitive requirements\n  # ------------------------------------------------------------------\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if the cell at ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"\n      Return the shortest walkable path from ``start`` to ``goal`` as a list\n      of positions **including** both endpoints.  If no path exists, returns\n      a list containing only ``start``.\n      \"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          # No path found \u2013 return trivial path\n          return [start]\n\n      # reconstruct path (goal -> start)\n      path = [goal]\n      while path[-1] != start:\n          path.append(visited[path[-1]])\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a position path (including start) to a list of movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell (Manhattan) that contains ``kind``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"\n      Return a walkable neighbour of ``target`` (preferring N, S, W, E).\n      If none are free, return ``target`` itself.\n      \"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current (y, x)\n\n  # --------------------------------------------------------------\n  # Collect all required primitive items\n  # --------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          actions.extend(path_to_actions(path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself (may be same as stand_pos)\n          path = bfs_path(cur, prim_loc)\n          actions.extend(path_to_actions(path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # --------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          actions.extend(path_to_actions(path))\n          cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:30:44.749693", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain world information\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal item index and required primitive counts\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"True if cell contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest walkable path from start to goal (excluding start).\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # no path found\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Return location of the nearest cell containing `kind` (Manhattan).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Find a walkable neighbour of `target` (prefer N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback (target itself is assumed walkable)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current (y, x)\n\n  # Collect each required primitive the required number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself\n          path = bfs_path(cur, prim_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, travel there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:31:05.147776", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial references\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: Bread\u2011first search that returns a list of movement actions\n  # (0\u20113) which brings the agent to a cell where the tile directly in front\n  # of the agent contains `target_kind`.  Returns [] if already adjacent.\n  # ----------------------------------------------------------------------\n  def _bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      # Mapping from action index to (dx, dy)\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def _in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def _walkable(x, y):\n          # A cell is walkable if it is inside the grid and contains no entities\n          return _in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      sx, sy = cur_state.pos\n      sd = cur_state.dir\n      q.append((sx, sy, sd, []))\n      visited = {(sx, sy, sd)}\n\n      while q:\n          x, y, d, acts = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              # Target is directly in front \u2013 we have found a solution\n              return acts\n\n          # Expand neighbours (move actions)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not _walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n\n      # Unreachable\n      return []\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all primitive resources needed for ONE arrow.\n  # ----------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          # Find a path to the primitive (or stay if already adjacent)\n          move_seq = _bfs_to_target(state, prim_idx)\n\n          # If BFS failed but we are already next to the primitive, we can still pick it up\n          if not move_seq and not state.next_to(prim_idx):\n              # Primitive cannot be reached \u2013 abort early\n              return actions\n\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to pick up\n\n          # Execute the actions to keep the internal state up\u2011to\u2011date\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ----------------------------------------------------------------------\n  # 2) Go to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(state, workshop_idx)\n      actions.extend(move_seq)\n      actions.append(4)                     # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      # No specific workshop \u2013 craft in place\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:31:06.268422", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the initial state and world reference\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) which\n  # bring the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if already facing the target.\n  # ------------------------------------------------------------------\n  def _bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      # Mapping from action index to (dx, dy) movement\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def _in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def _walkable(x, y):\n          # Walkable if inside bounds and the cell is empty (no entities)\n          return _in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      sx, sy = cur_state.pos\n      sd = cur_state.dir\n      q.append((sx, sy, sd, []))\n      visited = {(sx, sy, sd)}\n\n      while q:\n          x, y, d, acts = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts  # front cell already contains the target\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not _walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n      # Target not reachable\n      return []\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # 1. Gather all primitive resources required for a single arrow.\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_seq = _bfs_to_target(state, prim_idx)\n          # If we cannot reach the primitive and it's not already adjacent, abort.\n          if not move_seq and not state.next_to(prim_idx):\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to pick up\n\n          # Simulate the actions to keep `state` up\u2011to\u2011date.\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # --------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the arrow.\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      wk_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(state, wk_idx)\n      actions.extend(move_seq)\n      actions.append(4)                     # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      # No specific workshop \u2013 craft in place.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:31:36.701373", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (match CraftWorld default ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any of the\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world and current state from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # May be wrapped; ensure a reset so a state exists\n      if not hasattr(env, \"_current_state\") or env._current_state is None:\n          env.reset()\n      state = env._current_state\n      world = state.world\n  else:\n      # Ensure we have a state object for position / grid information\n      if not hasattr(env, \"_current_state\") or env._current_state is None:\n          env.reset()\n      state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are needed for one arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is already a primitive \u2013 nothing to do\n      return []\n\n  # ------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                         # (W, H, n_kinds)\n  pos = tuple(state.pos)                    # (x, y)\n  occupied = np.any(grid > 0, axis=2)       # True where any entity exists\n\n  actions = []\n  harvested = set()                         # locations already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells that currently contain this primitive\n          prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          # Remove cells we have already harvested\n          prim_cells = [c for c in prim_cells if c not in harvested]\n          if not prim_cells:\n              # No more of this primitive left on the map \u2013 give up\n              break\n\n          # Choose the nearest primitive (Manhattan distance)\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate the movement to update `pos`\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy (the cell becomes empty after pickup)\n          occupied[target] = False\n          # Also clear the primitive from the grid representation\n          grid[:, :, prim_idx][target] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at the required workshop (if the recipe specifies one).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n\n      # Locate workshop cells\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          # Choose the nearest workshop\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n\n          # Move adjacent to the workshop\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use to craft the arrow\n          actions.append(USE)\n      else:\n          # No workshop found \u2013 fall back to using current position\n          actions.append(USE)\n  else:\n      # No specific workshop required; just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:31:37.887358", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants (match CraftWorld ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP:   (0, -1),\n      LEFT: (-1, 0),\n      RIGHT:(1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any position\n  # in `targets`.  Cells where `occupied` is True are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # Unreachable\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world and current state from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Wrapped environment \u2013 ensure a state exists\n      if not hasattr(env, \"_current_state\") or env._current_state is None:\n          env.reset()\n      state = env._current_state\n      world = state.world\n  else:\n      if not hasattr(env, \"_current_state\") or env._current_state is None:\n          env.reset()\n      state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine required primitive resources for one arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is already a primitive \u2013 nothing to do\n      return []\n\n  # ------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                         # (W, H, n_kinds)\n  pos = tuple(state.pos)                    # (x, y)\n  occupied = np.any(grid > 0, axis=2)       # True where any entity exists\n\n  actions = []\n  harvested = set()                         # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate cells that currently contain this primitive and are unused\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              # No more of this primitive left on the map\n              break\n\n          # Choose the nearest primitive (Manhattan distance)\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update `pos`\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy (the primitive cell becomes empty)\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      # Locate workshop cells of the required type\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          # Choose the nearest workshop\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n\n          # Move adjacent to the workshop\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use to craft\n          actions.append(USE)\n      else:\n          # No workshop found \u2013 fallback to using at current location\n          actions.append(USE)\n  else:\n      # No specific workshop required\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T20:31:52.268888", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T20:32:07.935636", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Resolve the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the start state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper that produces a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  # Search parameters\n  MAX_STEPS = 2000                     # hard limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test \u2013 does the inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune paths that are already too long\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all primitive actions (movement + USE)\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If we exhaust the search without finding a solution, return empty plan\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T20:32:28.529414", "function_name": "make_arrow", "function_body": "  # Action constants (match CraftWorld ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Obtain world, state and cookbook from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is primitive \u2013 just use current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # locations already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all remaining instances of this primitive.\n          prim_locs = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_locs:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = prim_locs[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask (cell becomes empty).\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Find all workshop cells of the required type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No workshop found \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "i