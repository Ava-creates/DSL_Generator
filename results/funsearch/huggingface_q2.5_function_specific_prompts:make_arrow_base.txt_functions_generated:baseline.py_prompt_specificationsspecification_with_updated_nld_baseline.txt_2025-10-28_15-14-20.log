{"timestamp": "2025-10-28T15:32:49.751687", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helpers\n  # ----------------------------------------------------------------------\n  # Mapping from (dx, dy) movement vectors to CraftLab action indices.\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  # Reverse map for updating the simulated position.\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs(start, targets, grid):\n      \"\"\"\n      Breadth\u2011first search returning a list of actions that moves the agent\n      from ``start`` to a cell that is *adjacent* to any cell in ``targets``.\n      ``grid`` is the (H, W, K) array; any non\u2011zero entry in the last axis is\n      considered blocked for movement.\n      \"\"\"\n      H, W = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((H, W), False, dtype=bool)\n      visited[sy, sx] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:\n                  if blocked[ny, nx]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[ny, nx] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency \u2192 empty path (caller will handle).\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning\n  # ----------------------------------------------------------------------\n  # Current state and static info.\n  state = env._current_state\n  grid = state.grid.copy()          # local mutable copy\n  pos = tuple(state.pos)            # (x, y)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # 1. Determine primitive requirements.\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # 2. Collect each primitive.\n  for prim_idx, needed in primitives_needed.items():\n      while needed > 0:\n          # Locate all cells containing this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive unavailable \u2013 abort planning.\n              return plan\n          # Find a path to the nearest primitive (adjacent).\n          path = bfs(pos, prim_cells.tolist(), grid)\n          plan.extend(path)\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use the primitive (collect).\n          plan.append(4)   # USE action\n          # Find the primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected \u2013 break to avoid infinite loop.\n              break\n          # Update local grid (remove one instance) and decrement counter.\n          grid[adj_cell[1], adj_cell[0], prim_idx] -= 1\n          needed -= 1\n\n  # 3. Move to the workshop and craft the goal item.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is None:\n      # No specific workshop \u2192 nothing else to do.\n      return plan\n\n  # Resolve workshop index.\n  if isinstance(workshop_key, str):\n      workshop_idx = env.world.cookbook.index[workshop_key]\n  else:\n      workshop_idx = int(workshop_key)\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size > 0:\n      path = bfs(pos, workshop_cells.tolist(), grid)\n      plan.extend(path)\n      for a in path:\n          dx, dy = ACT2DIR[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n      # Craft at the workshop.\n      plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:33:15.194841", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects (handle possible wrappers)\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n\n  # Identify the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the start state\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Parameters for search\n  MAX_STEPS = 300                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T15:33:30.890635", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects, handling possible wrappers.\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the internal index for the target item \"arrow\".\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState.\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space to obtain a valid action plan.\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Combine position, direction, inventory and full grid layout into a hashable key.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typical actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search limits.\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T15:33:46.201123", "function_name": "make_arrow", "function_body": "  return []", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:33:47.308694", "function_name": "make_arrow", "function_body": "  # constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper: locate the nearest cell (Manhattan) containing a given kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # helper: locate any cell containing a given kind\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # helper: produce a simple Manhattan path from src to dst\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      cur_r, cur_c = src\n      dst_r, dst_c = dst\n      while cur_r != dst_r:\n          if cur_r < dst_r:\n              actions.append(DOWN)\n              cur_r += 1\n          else:\n              actions.append(UP)\n              cur_r -= 1\n      while cur_c != dst_c:\n          if cur_c < dst_c:\n              actions.append(RIGHT)\n              cur_c += 1\n          else:\n              actions.append(LEFT)\n              cur_c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # start episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      # unknown goal \u2013 nothing to do\n      return []\n\n  # ------------------------------------------------------------------\n  # primitive requirements for one arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          # locate nearest primitive of this kind\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # cannot find the primitive \u2013 abort\n              return action_seq\n          # move next to the cell (standing on the cell is fine for USE)\n          moves = _path(state.pos, target)\n          for a in moves:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = None\n  for k, v in recipe.items():\n      if k == \"_at\":\n          workshop_name = v\n          break\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          moves = _path(state.pos, workshop_pos)\n          for a in moves:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # perform the crafting action\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:34:10.875273", "function_name": "make_arrow", "function_body": "  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: find the nearest cell (Manhattan distance) that contains a given kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: locate any cell that contains a given kind\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Helper: produce a Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      cur_r, cur_c = src\n      dst_r, dst_c = dst\n      # vertical moves\n      while cur_r != dst_r:\n          if cur_r < dst_r:\n              actions.append(DOWN)\n              cur_r += 1\n          else:\n              actions.append(UP)\n              cur_r -= 1\n      # horizontal moves\n      while cur_c != dst_c:\n          if cur_c < dst_c:\n              actions.append(RIGHT)\n              cur_c += 1\n          else:\n              actions.append(LEFT)\n              cur_c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Start a fresh episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # unknown goal \u2013 nothing to do\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting required counts)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return action_seq\n          # Move to the target cell\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick it up (USE)\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = None\n  for k, v in recipe.items():\n      if k == \"_at\":\n          workshop_name = v\n          break\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Perform the crafting action\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  # If there is no explicit workshop, simply attempt to craft in place\n  else:\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:34:12.003442", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # action identifiers\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper: find the nearest cell (Manhattan distance) containing a kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # helper: produce a Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:                 # arrow not defined in the recipe set\n      return []\n\n  # ------------------------------------------------------------------\n  # primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # collect each required primitive (repeat for required count)\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return action_seq\n          # move to the primitive cell (standing on it is fine for USE)\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # if the recipe specifies a workshop, move there and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T15:39:26.822582", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  # Action indices \u2013 they match the ordering used in CraftLab.action_specs()\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n\n  def _move_towards(state, target):\n      \"\"\"Return a list of actions that moves the agent from its current\n      position to *target* using Manhattan moves only.\n\n      The function also updates the environment by stepping through the\n      actions, so that subsequent calls see the new position.\n      \"\"\"\n      actions = []\n      while True:\n          x, y = state.pos\n          tx, ty = target\n          if (x, y) == (tx, ty):\n              break\n          if x < tx:\n              act = ACTION_RIGHT\n              nx, ny = x + 1, y\n          elif x > tx:\n              act = ACTION_LEFT\n              nx, ny = x - 1, y\n          elif y < ty:\n              act = ACTION_DOWN\n              nx, ny = x, y + 1\n          else:  # y > ty\n              act = ACTION_UP\n              nx, ny = x, y - 1\n\n          actions.append(act)\n          _, _, obs = env.step(act)          # ignore reward & done\n          state = env._current_state          # update reference\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  # 1. reset environment and fetch the current state\n  env.reset()\n  state = env._current_state\n\n  # 2. Resolve the index of the target item (\"arrow\") and its recipe\n  arrow_idx = state.world.cookbook.index[\"arrow\"]\n  recipe = state.world.cookbook.recipes.get(arrow_idx, {})\n\n  # 3. Determine which primitive kinds are needed and how many of each\n  #    (primitives_for already expands intermediate items)\n  needed = state.world.cookbook.primitives_for(arrow_idx)\n\n  # 4. Collect each required primitive\n  action_plan = []\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate the nearest cell that contains the primitive\n          # (grid is shape (W, H, K) with binary occupancy)\n          locations = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # primitive not present \u2013 give up early\n              return action_plan\n          # pick the location with minimal Manhattan distance\n          cur_x, cur_y = state.pos\n          target = min(locations, key=lambda p: abs(p[0] - cur_x) + abs(p[1] - cur_y))\n\n          # move to the primitive and pick it up\n          action_plan += _move_towards(state, target)\n          action_plan.append(ACTION_USE)          # pick up / collect\n          _, _, obs = env.step(ACTION_USE)\n          state = env._current_state\n\n  # 5. Move to the appropriate workshop (if any) and craft the arrow\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = state.world.cookbook.index[workshop_name]\n      # find any workshop cell\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          target_ws = min(workshop_cells,\n                          key=lambda p: abs(p[0] - state.pos[0]) + abs(p[1] - state.pos[1]))\n          action_plan += _move_towards(state, target_ws)\n\n  # finally use the craft action\n  action_plan.append(ACTION_USE)\n\n  # return the complete list of actions\n  return action_plan", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
