{"timestamp": "2025-10-29T00:01:56.224956", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  def _state_key(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n  MAX_PLAN_LEN = 400\n  n_actions = getattr(world, \"n_actions\", 5)\n  while frontier:\n      node = frontier.popleft()\n      cur = node.state\n      if cur.satisfies(\"\", target_idx):\n          return node.actions\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n      for a in range(n_actions):\n          _, nxt = cur.step(a)\n          key = _state_key(nxt)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt, node.actions + [a]))\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:02:24.256225", "function_name": "make_arrow", "function_body": "  # Get scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the state space to find a plan\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Unique identifier for a state: position, direction, inventory, and grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Search limits\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)  # typical actions: 0\u20114 (DOWN,UP,LEFT,RIGHT,USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain the arrow?\n      if cur_state.inventory[target_idx] > 0:\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:02:39.970365", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Unique identifier for a state: position, direction, inventory and full grid\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_STEPS = 500                # safety limit to avoid infinite search\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 0\u20114 (move + use)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the limit\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:03:16.398931", "function_name": "make_arrow", "function_body": "  # action identifiers\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start` to a cell\n  # adjacent (Manhattan distance = 1) to any cell in `targets`.  Occupied\n  # cells (any non\u2011zero entry in the grid) are treated as walls.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the underlying CraftWorld instance and its cookbook.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the internal state.\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not locate CraftWorld instance inside env.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Ensure we start from a fresh episode.\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  # ----------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Required primitive counts for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Current position, grid and occupancy map.\n  # ----------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid                           # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)         # True where movement is blocked\n\n  actions = []            # final action sequence\n  collected_cells = set() # primitives already harvested\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, need in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from our current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      gathered = 0\n      for cell in cells:\n          if gathered >= need:\n              break\n          if cell in collected_cells:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_adjacent(pos, [cell], occupied)\n          actions.extend(path)\n          # Update our notion of position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # After collection the cell becomes empty \u2013 update occupancy.\n          occupied[cell[0], cell[1]] = False\n          collected_cells.add(cell)\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found.\")\n      # Choose the nearest workshop.\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # Craft the arrow.\n      actions.append(USE)\n  else:\n      # No specific workshop \u2013 just use the craft action at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:03:17.548130", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start` to a cell\n  # adjacent (Manhattan distance = 1) to any cell in `targets`.  Occupied\n  # cells (any non\u2011zero entry in the grid) are treated as walls.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  # ----------------------------------------------------------------------\n  # Locate the underlying CraftWorld instance and its cookbook.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the internal state.\n      state_obj = getattr(env, \"_current_state\", None)\n      if state_obj is not None:\n          world = getattr(state_obj, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Could not locate CraftWorld instance inside env.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal: craft an 'arrow'.\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Required primitive counts for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we start from a fresh episode.\n  # ----------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  # Current position, grid and occupancy map.\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid                           # (W, H, n_kinds)\n  occupied = np.any(grid > 0, axis=2)         # True where movement is blocked\n\n  actions = []            # final action sequence\n  collected_cells = set() # primitives already harvested\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, need in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from our current position.\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      gathered = 0\n      for cell in cells:\n          if gathered >= need:\n              break\n          if cell in collected_cells:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_adjacent(pos, [cell], occupied)\n          actions.extend(path)\n          # Update our notion of position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # After collection the cell becomes empty \u2013 update occupancy.\n          occupied[cell[0], cell[1]] = False\n          collected_cells.add(cell)\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if not ws_cells:\n          raise RuntimeError(f\"No workshop of type '{workshop_key}' found.\")\n      # Choose the nearest workshop.\n      ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      target_ws = ws_cells[0]\n      path = _bfs_adjacent(pos, [target_ws], occupied)\n      actions.extend(path)\n      for act in path:\n          if act == RIGHT:\n              pos = (pos[0] + 1, pos[1])\n          elif act == LEFT:\n              pos = (pos[0] - 1, pos[1])\n          elif act == DOWN:\n              pos = (pos[0], pos[1] + 1)\n          elif act == UP:\n              pos = (pos[0], pos[1] - 1)\n      # Craft the arrow.\n      actions.append(USE)\n  else:\n      # No specific workshop \u2013 just use the craft action at current location.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 9, "scores": {"3": 0.5}}
