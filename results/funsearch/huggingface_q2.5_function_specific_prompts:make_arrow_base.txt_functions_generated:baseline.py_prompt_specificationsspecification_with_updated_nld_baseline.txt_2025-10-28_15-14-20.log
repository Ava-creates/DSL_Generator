{"timestamp": "2025-10-29T00:39:14.176233", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise starting state\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hash a state based on position, direction, inventory and grid.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_STEPS = 500                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 actions (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: arrow present in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:39:36.005065", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Locate the CraftWorld instance and its cookbook\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Obtain current state (reset if necessary) and make a mutable copy of the grid\n  # ----------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  mutable_grid = state.grid.copy()  # (W, H, n_kinds)\n\n  # ----------------------------------------------------------------------\n  # Action constants (as used by CraftLab)\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n  actions = []                     # final action sequence\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions that brings the agent\n  # from `start` to a cell adjacent (or equal) to any cell in `targets`.\n  # Any non\u2011empty cell in `mutable_grid` is considered blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = mutable_grid.shape\n      occupied = np.any(mutable_grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # success if we are on a target or adjacent to one\n          for tx, ty in target_set:\n              if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no path found\n      return []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # locate remaining instances of this primitive on the map\n          locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]\n          if not locs:\n              # cannot find enough primitives \u2013 abort early\n              break\n          # choose the closest one (Manhattan distance)\n          locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locs[0]\n\n          # plan a path to an adjacent cell\n          path = _bfs_path(pos, [target])\n          actions.extend(path)\n\n          # simulate movement to update `pos`\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # pick up the primitive\n          actions.append(USE)\n          mutable_grid[target[0], target[1], prim_idx] = 0\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be a string name)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_locs[0]\n          path = _bfs_path(pos, [target_ws])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)          # craft at the workshop\n      else:\n          # workshop not present \u2013 attempt crafting at current location\n          actions.append(USE)\n  else:\n      # no specific workshop required\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:39:37.133571", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup: obtain world, cookbook, goal index, and current state\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          world = getattr(cur_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow (including nested primitives)\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # Ensure we have a state object; reset if necessary\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Working copies of position and grid (to simulate pickups)\n  pos = tuple(state.pos)          # (x, y)\n  mutable_grid = state.grid.copy()\n\n  # ----------------------------------------------------------------------\n  # Action constants (as used by CraftLab)\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n  actions: list[int] = []\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions that brings the agent\n  # from `start` to a cell adjacent (or equal) to any cell in `targets`.\n  # Any non\u2011empty cell in `mutable_grid` is considered blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_path(start: tuple[int, int], targets: list[tuple[int, int]]) -> list[int]:\n      w, h, _ = mutable_grid.shape\n      occupied = np.any(mutable_grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # success if we are on a target or adjacent to one\n          for tx, ty in target_set:\n              if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no path found\n      return []\n\n  # ----------------------------------------------------------------------\n  # Phase 1: collect all required primitives (greedy nearest\u2011first)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # locate remaining instances of this primitive on the map\n          locations = [tuple(p) for p in np.argwhere(mutable_grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # not enough primitives \u2013 abort early (environment will fail)\n              break\n\n          # choose the closest one (Manhattan distance)\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_loc = locations[0]\n\n          # plan path to an adjacent cell\n          path = _bfs_path(pos, [target_loc])\n          actions.extend(path)\n\n          # update simulated position\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # pick up the primitive\n          actions.append(USE)\n          mutable_grid[target_loc[0], target_loc[1], prim_idx] = 0\n          collected += 1\n\n  # ----------------------------------------------------------------------\n  # Phase 2: move to workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be a string name)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_locs = [tuple(p) for p in np.argwhere(mutable_grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          # move to the nearest workshop\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = workshop_locs[0]\n          path = _bfs_path(pos, [ws_target])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)   # craft at the workshop\n      else:\n          # no workshop cell found \u2013 attempt crafting at current location\n          actions.append(USE)\n  else:\n      # no specific workshop required\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:40:07.737666", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, grid):\n      \"\"\"Return actions to reach a cell adjacent to any target.\"\"\"\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def _apply_path(pos, path):\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # locate world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ensure we have a current state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  pos = tuple(state.pos)\n  grid = state.grid.copy()   # mutable planning grid\n\n  actions = []\n  harvested = set()\n\n  # collect primitives\n  for prim_idx, needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n          actions.append(USE)          # pick up\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # craft at workshop if required\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n      actions.append(USE)\n  else:\n      # no specific workshop, just use\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:40:08.861471", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, grid):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any target.\"\"\"\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # any non\u2011zero kind blocks movement\n      q = collections.deque([(start[0], start[1], [])])\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # stop if adjacent (Manhattan distance \u2264 1) to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # explore neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # unreachable \u2013 return empty list\n      return []\n\n  def _apply_path(pos, path):\n      \"\"\"Update a (x, y) position by applying a sequence of actions.\"\"\"\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate the world and cookbook objects (they may be stored in different\n  # attributes depending on the wrapper used around the environment).\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers keep the world inside the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal is hard\u2011coded to the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Working copies of position and grid for planning.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)          # (x, y)\n  cur_grid = state.grid.copy()    # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Greedy order: nearest first.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive (or stay if already adjacent).\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Mark the cell empty for future planning.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index \u2013 may be a string name.\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else int(workshop_key))\n      # Locate workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n\n  # Use (craft) at the final position.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-29T00:40:38.696088", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over state\u2011action space\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long plans\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, cur_actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:40:54.469105", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects from the environment.\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the integer index that corresponds to the target item \"arrow\".\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting CraftState for the episode.\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over the space of states to find a plan.\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                     # safety depth limit\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: does the inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long branches.\n      if len(cur_actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions from the current state.\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, cur_actions + [a]))\n\n  # No feasible plan found within the search limits.\n  return []", "env_interactions": 20, "island_id": 3, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:41:04.852257", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-29T00:41:19.635709", "function_name": "make_arrow", "function_body": "  # Retrieve the world and the index of the target item \"arrow\".\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state of the episode.\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash(state):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          state.pos,\n          state.dir,\n          state.inventory.tobytes(),\n          state.grid.tobytes(),\n      )\n\n  visited = {_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 800                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # total number of possible actions\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories.\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # If no plan was found within the search budget, return an empty list.\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:41:44.793523", "function_name": "make_arrow", "function_body": "  # Retrieve the current state; reset the environment if needed\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Obtain the CraftWorld instance (may be stored on env or on the state)\n  world = getattr(env, \"world\", None) or getattr(state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # Goal configuration\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for the goal (dict: primitive_index -> count)\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # Work on a copy of the grid to simulate pickups\n  grid = state.grid.copy()\n  pos = tuple(state.pos)          # (x, y) current agent position\n\n  # Action indices (consistent with CraftState implementation)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions taking the\n  # agent from `start` to a cell adjacent (or equal) to any target.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # any non\u2011empty cell blocks movement\n      queue = collections.deque()\n      queue.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while queue:\n          x, y, path = queue.popleft()\n          # Check if we are adjacent to (or on) a target cell\n          for tx, ty in target_set:\n              if (x, y) == (tx, ty) or abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      queue.append((nx, ny, path + [act]))\n      # No reachable target \u2013 return empty list\n      return []\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # Locate remaining instances of this primitive on the simulated grid\n          locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # No more of this primitive available; abort collection loop\n              break\n          # Choose the nearest instance (Manhattan distance)\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_loc = locations[0]\n\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [target_loc])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up the primitive\n          actions.append(USE)\n          # Remove it from the simulated grid\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      workshop_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_locs:\n          # Move to the nearest workshop\n          workshop_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = workshop_locs[0]\n          path = _bfs_path(pos, [ws_target])\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft using USE\n          actions.append(USE)\n      else:\n          # No workshop found; attempt crafting at current position\n          actions.append(USE)\n  else:\n      # No specific workshop required for this recipe\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
