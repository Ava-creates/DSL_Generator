{"timestamp": "2025-10-28T22:39:53.352021", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Find the index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Determine primitive requirements for a single arrow\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:                     # arrow may be primitive itself\n      needed = {arrow_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that moves\n  # the agent to a position where the cell directly in front contains\n  # `target_kind`. Returns None if unreachable.\n  # ------------------------------------------------------------------\n  def bfs_to_target(st, target_kind):\n      grid = st.grid\n      W, H = grid.shape[:2]\n\n      # action \u2192 (dx, dy)\n      deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      sx, sy = st.pos\n      sd = st.dir\n      q.append((sx, sy, sd, []))\n      visited = {(sx, sy, sd)}\n\n      while q:\n          x, y, d, path = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return path\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          seq = bfs_to_target(state, kind_idx)\n          if seq is None:\n              # primitive unreachable \u2013 abort planning\n              return actions\n          actions.extend(seq)\n          actions.append(4)                     # USE to pick up / interact\n          for a in seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      seq = bfs_to_target(state, workshop_idx)\n      if seq is None:\n          return actions\n      actions.extend(seq)\n      actions.append(4)                         # USE to craft\n      for a in seq + [4]:\n          _, state = state.step(a)\n  else:\n      # No specific workshop \u2013 craft in place\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:39:54.508980", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Get the index of the target item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Determine required primitive resources for a single arrow\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:\n      needed = {arrow_idx: 1}\n\n  actions = []\n\n  # Helper BFS to get movement actions to be adjacent (facing) target kind\n  def _bfs_to_target(st, target_kind):\n      grid = st.grid\n      W, H = grid.shape[:2]\n\n      # action -> delta\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      sx, sy = st.pos\n      sd = st.dir\n      q.append((sx, sy, sd, []))\n      visited = {(sx, sy, sd)}\n\n      while q:\n          x, y, d, path = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return path\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, path + [a]))\n      return None\n\n  # 1) Collect all needed primitives.\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_target(state, kind_idx)\n          if move_seq is None:\n              # Cannot reach required primitive \u2013 abort planning.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE\n\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # 2) Craft the arrow at its workshop (if any).\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(state, workshop_idx)\n      if move_seq is None:\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:40:22.839051", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action constants \u2013 these match CraftWorld's default ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell *adjacent* (Manhattan distance = 1) to any cell in `targets`.\n  # Cells where `blocked` is True are treated as obstacles.\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_adjacent(start, targets, blocked):\n      width, height = blocked.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell\n      return []\n\n  # ----------------------------------------------------------------------\n  # Retrieve the underlying world, current state and the cookbook.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # `env` is likely a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive resources are required for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  blocked = np.any(grid > 0, axis=2)    # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all remaining cells that contain this primitive.\n          locations = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not locations:\n              # No more of this primitive on the map \u2013 abort collection.\n              break\n\n          # Choose the closest one (Manhattan distance).\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], blocked)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the primitive cell becomes empty.\n          blocked[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve the workshop index (could be a name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      # Find all workshop cells of this type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], blocked)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at the workshop\n      else:\n          # No workshop present \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:40:24.015192", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action constants \u2013 match default CraftWorld ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a sequence of movement actions which brings the\n  # agent from `start` to a cell *adjacent* to any of the `targets`.  Cells\n  # where `occupied` is True are treated as blocked.  The returned path does\n  # not include a USE action \u2013 the caller should add USE after reaching the\n  # adjacent cell.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check if this new position is adjacent to any target.\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Obtain the underlying world, current state and cookbook.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env might be a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is a primitive itself \u2013 just use the current cell.\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all remaining cells containing this primitive.\n          locations = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not locations:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest one (Manhattan distance).\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations[0]\n\n          # Plan a path to stand next to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # After picking up, the cell becomes empty.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      # Find all workshop cells of this type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at the workshop\n      else:\n          # No workshop found \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:40:44.744154", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and get initial state and world reference\n  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []  # arrow not defined in this world\n\n  # Mapping from action index to movement delta (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1),   # DOWN\n            1: (0, -1),  # UP\n            2: (-1, 0),  # LEFT\n            3: (1, 0)}   # RIGHT\n  USE_ACTION = 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions which leaves the\n  # agent in a cell where the cell directly in front contains `target_kind`.\n  # Returns None if no such position is reachable.\n  # ------------------------------------------------------------------\n  def bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      q = deque()\n      sx, sy = state.pos\n      sdir = state.dir\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, path = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return path\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are needed for one arrow.\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  if not primitive_needs:               # arrow might itself be a primitive\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive resources.\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          seq = bfs_to_target(cur_state, prim_idx)\n          if seq is None:\n              # Primitive unreachable \u2013 abort planning.\n              return actions\n          actions.extend(seq)\n          actions.append(USE_ACTION)  # pick up\n          # Simulate to keep cur_state up\u2011to\u2011date\n          for a in seq + [USE_ACTION]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      seq = bfs_to_target(cur_state, workshop_idx)\n      if seq is None:\n          # Workshop unreachable \u2013 still attempt a USE (harmless)\n          actions.append(USE_ACTION)\n          _, cur_state = cur_state.step(USE_ACTION)\n      else:\n          actions.extend(seq)\n          actions.append(USE_ACTION)  # craft\n          for a in seq + [USE_ACTION]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop; craft in place.\n      actions.append(USE_ACTION)\n      _, cur_state = cur_state.step(USE_ACTION)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:40:45.891506", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []  # arrow not defined in this world\n\n  # Mapping from action index to movement delta (DOWN,UP,LEFT,RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions that ends with the\n  # agent facing a cell containing `target_kind`. Returns None if not reachable.\n  # ------------------------------------------------------------------\n  def bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, path = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return path\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are needed for one arrow.\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:               # arrow itself may be primitive\n      needed = {arrow_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      for _ in range(cnt):\n          seq = bfs_to_target(state, kind_idx)\n          if seq is None:\n              # Primitive unreachable \u2013 abort planning.\n              return actions\n          actions.extend(seq)\n          actions.append(4)          # USE to pick up\n          # Simulate the actions to keep the state up\u2011to\u2011date\n          for a in seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      seq = bfs_to_target(state, workshop_idx)\n      if seq is None:\n          # Workshop unreachable \u2013 still attempt a USE (will fail harmlessly)\n          actions.append(4)\n          _, state = state.step(4)\n      else:\n          actions.extend(seq)\n          actions.append(4)          # USE to craft\n          for a in seq + [4]:\n              _, state = state.step(a)\n  else:\n      # No specific workshop; craft in place.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:41:12.948868", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Hashable representation of a state: position, direction, inventory, and grid bytes\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 600\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T22:41:28.632783", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 600\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T22:41:54.217179", "function_name": "make_arrow", "function_body": "  # Resolve the underlying scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the item we need to produce\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState for visited checking.\"\"\"\n      # Position, direction, inventory contents and the entire grid layout\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500                     # safety cutoff\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test: do we already have an arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Prune overly long trajectories\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, cur_actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T22:41:55.656898", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Target item index for \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import namedtuple\n  import heapq\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\", \"cost\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  # Heuristic: number of missing primitive items needed for one arrow\n  try:\n      needed_prims = world.cookbook.primitives_for(target_idx)\n  except Exception:\n      needed_prims = {}\n\n  def _heuristic(st):\n      missing = 0\n      inv = st.inventory\n      for prim_idx, req_cnt in needed_prims.items():\n          have = int(inv[prim_idx]) if prim_idx < len(inv) else 0\n          missing += max(0, req_cnt - have)\n      return missing\n\n  start_key = _state_key(init_state)\n  visited = {start_key}\n  frontier = [( _heuristic(init_state), Node(init_state, [], 0) )]\n\n  MAX_PLAN_LEN = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      _, node = heapq.heappop(frontier)\n      cur_state, cur_actions = node.state, node.actions\n\n      # Goal test\n      if cur_state.satisfies(\"\", target_idx):\n          return cur_actions\n\n      # Depth cutoff\n      if len(cur_actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          key = _state_key(nxt_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          new_actions = cur_actions + [a]\n          g = len(new_actions)                     # path cost so far\n          h = _heuristic(nxt_state)                # estimated remaining work\n          heapq.heappush(frontier, (g + h, Node(nxt_state, new_actions, g)))\n\n  # No plan found within limits\n  return []", "env_interactions": 0, "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-10-28T22:42:14.194627", "function_name": "make_arrow", "function_body": "  # Action constants as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset and fetch current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable planning copy\n\n  # Goal index and required primitives\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs(start, goal):\n      \"\"\"Return a shortest 4\u2011connected walkable path (list of positions).\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      parent = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y-1, x), (y+1, x), (y, x-1), (y, x+1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in parent and not is_blocked(nxt):\n                      parent[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []          # unreachable\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = parent[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest(kind, from_pos):\n      \"\"\"Find the closest cell containing `kind` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of `target`; fallback to target.\"\"\"\n      y, x = target\n      for ny, nx in ((y-1, x), (y+1, x), (y, x-1), (y, x+1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action plan\n  # ------------------------------------------------------------------\n  actions = []\n  cur = tuple(state.pos)   # (y, x)\n\n  # Collect all required primitives\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest(prim_idx, cur)\n          if prim_loc is None:\n              return actions      # cannot find primitive, abort\n\n          # Move to a free adjacent cell\n          stand = free_adjacent(prim_loc)\n          p = bfs(cur, stand)\n          if not p and cur != stand:\n              return actions\n          actions.extend(path_to_actions([cur] + p))\n          cur = stand\n\n          # Step onto the primitive cell itself\n          p = bfs(cur, prim_loc)\n          if not p and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + p))\n          cur = prim_loc\n\n          # Pick it up\n          actions.append(USE)\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0   # update planning grid\n\n  # Move to required workshop if any\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest(ws_idx, cur)\n      if ws_loc is not None:\n          p = bfs(cur, ws_loc)\n          if p:\n              actions.extend(path_to_actions([cur] + p))\n              cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T22:42:15.348977", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and obtain the current state / world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal item index and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies the cell.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest 4\u2011connected walkable path from start to goal.\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # unreachable\n\n      # reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell containing `kind` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of `target` (preferring N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback (target itself is assumed reachable)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = tuple(state.pos)   # current (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          if not path and cur != stand_pos:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself\n          path = bfs_path(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, move there\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          if path:\n              actions.extend(path_to_actions([cur] + path))\n              cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
