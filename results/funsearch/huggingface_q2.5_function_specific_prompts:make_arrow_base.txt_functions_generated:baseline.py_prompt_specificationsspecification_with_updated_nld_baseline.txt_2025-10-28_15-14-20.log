{"timestamp": "2025-10-29T00:38:30.749345", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      try:\n          init_state = env._current_state\n      except Exception:\n          return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          st.inventory.tobytes(),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-29T00:38:45.528914", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      try:\n          init_state = env._current_state\n      except Exception:\n          return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Compact hash for a state (position, direction, inventory, grid)\n  def _hash_state(st):\n      return (st.pos, st.dir, st.inventory.tobytes(), st.grid.tobytes())\n\n  visited = {_hash_state(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 1200          # safety cap\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have the arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _hash_state(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
