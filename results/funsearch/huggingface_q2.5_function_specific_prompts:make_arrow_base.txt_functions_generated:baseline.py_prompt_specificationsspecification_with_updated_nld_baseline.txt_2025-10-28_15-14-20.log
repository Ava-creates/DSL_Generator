{"timestamp": "2025-10-28T17:50:26.249730", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any of\n  # `targets`. Cells containing any non\u2011zero kind are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # explore neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no reachable path\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the world and cookbook objects \u2013 they may live in different\n  # places depending on the environment wrapper.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal is hard\u2011coded to the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Working copies of position and grid for planning.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)          # (x, y)\n  cur_grid = state.grid.copy()    # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Greedy order: nearest first.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive (or stay if already adjacent).\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update position following the path.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell empty for future planning.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index \u2013 may be a string name.\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Locate workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:50:47.772123", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions: list[int] = []\n\n  # Determine current agent position (use live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)          # mutable [x, y]\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Copy of the static grid \u2013 we will clear cells as we \u201cpick up\u201d items\n  grid = env.scenario.init_grid.copy()\n\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _move_to(target: list[int]) -> None:\n      \"\"\"Append moves that bring cur_pos to target.\"\"\"\n      nonlocal cur_pos\n      while cur_pos[0] != target[0] or cur_pos[1] != target[1]:\n          if cur_pos[0] < target[0]:\n              actions.append(RIGHT)\n              cur_pos[0] += 1\n          elif cur_pos[0] > target[0]:\n              actions.append(LEFT)\n              cur_pos[0] -= 1\n          elif cur_pos[1] < target[1]:\n              actions.append(DOWN)\n              cur_pos[1] += 1\n          elif cur_pos[1] > target[1]:\n              actions.append(UP)\n              cur_pos[1] -= 1\n\n  def _nearest_kind(kind_idx: int) -> list[int] | None:\n      \"\"\"Return [x, y] of the nearest cell containing kind_idx, or None.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          target = _nearest_kind(kind_idx)\n          if target is None:\n              # Required primitive not found \u2013 abort planning.\n              return actions\n          _move_to(target)\n          actions.append(USE)                     # pick up / collect\n          grid[target[1], target[0], kind_idx] = 0   # mark cell as empty\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind)\n      if workshop_pos is not None:\n          _move_to(workshop_pos)\n          actions.append(USE)                     # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:50:48.889067", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions: list[int] = []\n\n  # Determine current position (use live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Copy of the static grid so we can mark items as collected\n  grid = env.scenario.init_grid.copy()\n\n  goal_idx = env.task.goal\n\n  def _move_to(pos: list[int], target: list[int]) -> None:\n      \"\"\"Append moves that bring ``pos`` (mutable ``[x, y]``) to ``target``.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              actions.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              actions.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              actions.append(DOWN)\n              pos[1] += 1\n          else:  # pos[1] > target[1]\n              actions.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx: int, cur: list[int]) -> list[int] | None:\n      \"\"\"Return ``[x, y]`` of the nearest cell containing ``kind_idx``.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = _nearest_kind(kind_idx, cur_pos)\n          if target is None:\n              # Required primitive not found \u2013 abort planning.\n              return actions\n          _move_to(cur_pos, target)\n          actions.append(USE)  # pick up the primitive\n          # Mark the cell as empty so we don't try to pick it again.\n          grid[target[1], target[0], kind_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos)\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:51:20.147593", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Resolve action indices (use defaults if missing)\n  # ----------------------------------------------------------------------\n  spec = getattr(env, \"action_specs\", lambda: {})()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _in_bounds(pos, shape):\n      x, y = pos\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(pos, shape):\n      x, y = pos\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny), shape):\n              yield (nx, ny)\n\n  def _bfs(start, goal_set, blocked):\n      \"\"\"\n      Bread\u2011first search from ``start`` to any cell in ``goal_set``.\n      ``blocked`` is a 2\u2011D bool array where True means the cell cannot be entered.\n      Returns a list of positions (including start) representing the path,\n      or ``None`` if no path exists.\n      \"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      dq = deque([start])\n      visited[start] = True\n      while dq:\n          cur = dq.popleft()\n          if cur in goal_set:\n              # reconstruct path (list of positions)\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur, (w, h)):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _positions_to_actions(path):\n      \"\"\"\n      Convert a list of positions (including the starting cell) into a list\n      of movement actions using the resolved action indices.\n      \"\"\"\n      act_list = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              act_list.append(RIGHT)\n          elif x1 < x0:\n              act_list.append(LEFT)\n          elif y1 > y0:\n              act_list.append(DOWN)\n          elif y1 < y0:\n              act_list.append(UP)\n      return act_list\n\n  # ----------------------------------------------------------------------\n  # Access world, current state and cookbook\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid.copy()                     # copy to simulate pickups\n  shape = grid.shape[:2]                       # (WIDTH, HEIGHT)\n\n  # ----------------------------------------------------------------------\n  # Identify the goal item (\"arrow\") and its recipe\n  # ----------------------------------------------------------------------\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception as e:\n      raise RuntimeError(\"Could not locate goal index for 'arrow'\") from e\n\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements (expanded to base primitives)\n  # ----------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Build a blocked map (cells that cannot be entered)\n  # ----------------------------------------------------------------------\n  blocked = np.zeros(shape, dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Planning helpers\n  # ----------------------------------------------------------------------\n  cur_pos = tuple(state.pos)   # (x, y)\n  actions = []                 # final action list\n\n  def _move_to(target):\n      \"\"\"Move the agent from cur_pos to target, updating actions & cur_pos.\"\"\"\n      nonlocal cur_pos, actions\n      if cur_pos == target:\n          return True\n      path = _bfs(cur_pos, {target}, blocked)\n      if path is None:\n          return False\n      actions.extend(_positions_to_actions(path))\n      cur_pos = target\n      return True\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      while needed > 0:\n          # locate all cells still containing this primitive\n          locs = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locs.size == 0:\n              # no more of this primitive on the map \u2013 abort collection\n              break\n          # pick the nearest location (Manhattan distance heuristic)\n          dists = np.abs(locs[:, 0] - cur_pos[0]) + np.abs(locs[:, 1] - cur_pos[1])\n          nearest_idx = int(np.argmin(dists))\n          target = tuple(locs[nearest_idx])\n\n          # move to the primitive cell (it is traversable)\n          if not _move_to(target):\n              # unreachable \u2013 remove this cell from consideration and continue\n              grid[target[0], target[1], prim_idx] = 0\n              continue\n\n          # pick up as many as needed (one USE per unit)\n          available = int(grid[target[0], target[1], prim_idx])\n          take = min(available, needed)\n          actions.extend([USE] * take)\n\n          # update simulated grid and remaining count\n          grid[target[0], target[1], prim_idx] -= take\n          needed -= take\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_name is not None:\n      # resolve workshop index (string name or already an int)\n      if isinstance(workshop_name, int):\n          workshop_idx = workshop_name\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_cells.size > 0:\n              # choose the nearest workshop cell\n              dists = np.abs(ws_cells[:, 0] - cur_pos[0]) + np.abs(ws_cells[:, 1] - cur_pos[1])\n              ws_target = tuple(ws_cells[int(np.argmin(dists))])\n              # move onto the workshop cell (it is not blocked)\n              _move_to(ws_target)\n\n  # ----------------------------------------------------------------------\n  # Final USE to perform the crafting\n  # ----------------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:51:21.273233", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action mapping from the environment (fallback to default indices)\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions from start to the\n  # nearest cell in *targets*. Cells that contain any entity are treated as\n  # blocked unless they are one of the target cells.\n  # ----------------------------------------------------------------------\n  def _bfs(start, targets, grid):\n      width, height = grid.shape[:2]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Blocked if any kind occupies the cell and it's not a target.\n              if np.any(grid[nx, ny, :]) and (nx, ny) not in targets:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      return None\n\n  # ----------------------------------------------------------------------\n  # Helper: apply a movement path to a position (used for simulation)\n  # ----------------------------------------------------------------------\n  def _apply_path(path, pos):\n      x, y = pos\n      for a in path:\n          if a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n          elif a == LEFT:\n              x -= 1\n          elif a == RIGHT:\n              x += 1\n      return (x, y)\n\n  # ----------------------------------------------------------------------\n  # Access world, current state and cookbook\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (\"arrow\") and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  recipe = cookbook.recipes.get(goal_idx, {})\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for the goal\n  # ----------------------------------------------------------------------\n  primitive_requirements = cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Work on a copy of the grid for planning purposes\n  # ----------------------------------------------------------------------\n  grid = state.grid.copy()\n  pos = tuple(state.pos)          # (x, y)\n  actions = []                    # final action list\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      while needed > 0:\n          # Find all cells that still contain this primitive\n          locations = [(x, y) for x in range(grid.shape[0])\n                       for y in range(grid.shape[1])\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              # No more of this primitive on the map; give up.\n              break\n\n          # Choose the nearest location (Manhattan distance)\n          dists = [abs(x - pos[0]) + abs(y - pos[1]) for (x, y) in locations]\n          target = locations[int(np.argmin(dists))]\n\n          # Path to the target cell\n          path = _bfs(pos, {target}, grid)\n          if path is None:\n              # Unreachable \u2013 remove this cell from future consideration\n              locations.remove(target)\n              continue\n\n          # Record movement and update simulated position\n          actions.extend(path)\n          pos = _apply_path(path, pos)\n\n          # Pick up the needed amount (may need multiple USEs)\n          available = int(grid[target[0], target[1], prim_idx])\n          take = min(available, needed)\n          actions.extend([USE] * take)\n\n          # Update simulated grid and remaining need\n          grid[target[0], target[1], prim_idx] -= take\n          needed -= take\n\n  # ----------------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one) and craft\n  # ----------------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # Resolve workshop index (string name or integer)\n      if isinstance(workshop_name, int):\n          workshop_idx = workshop_name\n      else:\n          workshop_idx = cookbook.index[workshop_name]\n\n      # Locate all workshop cells\n      workshop_cells = [(x, y) for x in range(grid.shape[0])\n                        for y in range(grid.shape[1])\n                        if grid[x, y, workshop_idx] > 0]\n\n      if workshop_cells:\n          # Choose nearest workshop cell\n          dists = [abs(x - pos[0]) + abs(y - pos[1]) for (x, y) in workshop_cells]\n          ws_target = workshop_cells[int(np.argmin(dists))]\n\n          # Move to the workshop cell\n          path = _bfs(pos, {ws_target}, grid)\n          if path is not None:\n              actions.extend(path)\n              pos = _apply_path(path, pos)\n\n  # Final USE to perform the crafting (at workshop or current location)\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:51:46.054254", "function_name": "make_arrow", "function_body": "  # Retrieve action indices\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # Primitive requirements for the goal (primitive_idx -> count)\n  required = env.world.cookbook.primitives_for(goal_idx)\n\n  # Snapshot of current state to simulate our plan locally\n  state = env._current_state\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # mutable copy\n  inventory = state.inventory.copy()         # mutable copy\n\n  actions = []                               # list of action ids to return\n\n  # -----------------------------------------------------------------\n  # Helper: BFS path planning avoiding non\u2011grabbable entities.\n  # Returns a list of actions moving from start \u2192 target.\n  # -----------------------------------------------------------------\n  import collections\n\n  def bfs(start, target):\n      \"\"\"Return list of actions from start to target (inclusive of target cell).\"\"\"\n      width, height = grid.shape[:2]\n\n      # Cells occupied by any non\u2011grabbable entity are blocked.\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Allow stepping onto the target even if it contains a non\u2011grabbable\n      # (e.g., a workshop). This does not affect the BFS expansion.\n      blocked[target[0], target[1]] = False\n\n      # BFS structures\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      # Direction vectors paired with action constants\n      directions = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # Reconstruct action list\n      path = []\n      cur = target\n      while cur != start:\n          path.append(act_to[cur])\n          cur = parent[cur]\n      path.reverse()\n      return path\n\n  # -----------------------------------------------------------------\n  # Collect each required primitive, respecting current inventory.\n  # -----------------------------------------------------------------\n  for prim_idx, needed_cnt in required.items():\n      while inventory[prim_idx] < needed_cnt:\n          # Locate all cells that still contain this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more instances on the map \u2013 abort collection loop.\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Plan a path to the target primitive\n          path = bfs(pos, target)\n          if path is None:\n              # Fallback: direct Manhattan moves (may hit obstacles)\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          # Append movement actions and the USE action to pick up.\n          actions.extend(path)\n          actions.append(USE)\n\n          # Update our simulated local state.\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0          # remove primitive from map\n          inventory[prim_idx] += 1                    # add to inventory\n\n  # -----------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the goal item.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          # Choose the nearest workshop location.\n          target_ws = min(\n              workshop_cells,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:51:47.181757", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  # Goal item index and required primitive counts.\n  goal = env.task.goal\n  required = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # Snapshot of current state.\n  state = env._current_state\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()              # local mutable copy\n  actions = []                           # accumulated action list\n\n  # -----------------------------------------------------------------\n  # Helper: BFS pathfinder on the current grid layout.\n  # Returns a list of actions moving from start \u2192 target while avoiding\n  # non\u2011grabbable entities.  The target cell may be occupied (e.g. a\n  # workshop) \u2013 it is allowed to step onto it.\n  # -----------------------------------------------------------------\n  def bfs(start, target):\n      width, height = grid.shape[:2]\n\n      # Blocked cells: any non\u2011grabbable entity present.\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Allow stepping on the target cell even if blocked (useful for workshops).\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # Reconstruct action sequence.\n      seq = []\n      cur = target\n      while cur != start:\n          seq.append(act_to[cur])\n          cur = parent[cur]\n      seq.reverse()\n      return seq\n\n  # -----------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # -----------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          # Locate all cells containing this primitive.\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # Primitive absent \u2013 assume already in inventory or unreachable.\n              break\n\n          # Choose the nearest primitive (Manhattan distance).\n          target = min(locations, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n          # Plan a path.\n          path = bfs(pos, target)\n          if path is None:\n              # Simple Manhattan fallback (may fail on obstacles).\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          # Move and pick up.\n          actions.extend(path)\n          actions.append(USE)\n\n          # Update local simulation state.\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # -----------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the goal item.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          target_ws = min(\n              workshop_cells,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)  # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:52:09.394305", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n  act_map = env.action_specs()\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # movement deltas for cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  from collections import deque\n\n  # BFS returning a list of action names that moves the agent from `start`\n  # to a cell adjacent (Chebyshev distance \u2264 1) to any cell in `targets`.\n  # Only completely empty cells may be traversed.\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny].sum() == 0:   # cell is empty\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # no reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # locate all cells currently holding the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              break   # primitive not present any more\n\n          # plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              break   # unreachable primitive\n\n          # execute movement actions\n          for act_name in path:\n              aid = act_map[act_name]\n              actions.append(aid)\n              env.step(aid)\n\n          # pick up the primitive with the USE action\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # locate all workshop cells of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  aid = act_map[act_name]\n                  actions.append(aid)\n                  env.step(aid)\n\n          # craft the item with the USE action\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:52:10.493399", "function_name": "make_arrow", "function_body": "  # Reset environment and initialise containers\n  env.reset()\n  actions = []\n  act_map = env.action_specs()                     # e.g. {'DOWN':0, 'UP':1, ...}\n  goal_idx = env.task.goal                         # integer index of the target item\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Cardinal movement deltas (matching the action names in act_map)\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent from\n  # `start` to a cell that is *adjacent* (Chebyshev distance \u2264 1) to any\n  # cell in `targets`. Only completely empty cells may be traversed.\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If we are adjacent (including diagonal) to any target cell, stop.\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Traversable only if the cell contains no entities\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None   # No reachable adjacent cell\n\n  # ----------------------------------------------------------------------\n  # 1) Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, required_cnt in needed.items():\n      for _ in range(required_cnt):\n          # Refresh current state information\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Find all cells that currently hold the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present any more \u2013 abort further collection\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 abort further collection\n              break\n\n          # Execute the movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Pick up the primitive using the USE action\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ----------------------------------------------------------------------\n  # 2) If the recipe specifies a workshop, move there and craft the goal\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after primitive collection\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled sequence of action IDs\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:52:50.649387", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  # Retrieve world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\"\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Ensure we have a current state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)               # (x, y)\n  cur_grid = state.grid.copy()         # mutable copy\n  occ = np.any(cur_grid > 0, axis=2)   # occupied cells mask\n\n  actions = []\n  harvested = set()\n\n  # Collect required primitives\n  for prim_idx, needed in primitives_needed.items():\n      cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      gathered = 0\n      for cell in cells:\n          if gathered >= needed:\n              break\n          if cell in harvested:\n              continue\n          path = _bfs_path(pos, [cell], occ)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n          cur_grid[cell[0], cell[1], prim_idx] = 0\n          occ[cell[0], cell[1]] = False\n          harvested.add(cell)\n          gathered += 1\n\n  # Craft at the required workshop, if any\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_path(pos, [target_ws], occ)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:52:51.740047", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:53:22.888510", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Shortcuts to world / state\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, K)\n  width, height, n_kinds = grid.shape\n  pos = tuple(state.pos)                       # current agent position\n\n  # ----------------------------------------------------------------------\n  # Identify goal index for \"arrow\"\n  # ----------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n  if goal_idx is None:\n      raise RuntimeError(\"Could not locate goal index for 'arrow'\")\n\n  # ----------------------------------------------------------------------\n  # Primitive requirements for the goal (expanded to raw resources)\n  # ----------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _in_bounds(p):\n      x, y = p\n      return 0 <= x < width and 0 <= y < height\n\n  def _neighbors(p):\n      x, y = p\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny)):\n              yield (nx, ny)\n\n  def _blocked(mask):\n      \"\"\"Return a 2\u2011D bool array: True where any entity occupies the cell.\"\"\"\n      return np.any(mask > 0, axis=2)\n\n  blocked = _blocked(grid)\n\n  def _bfs(start, targets):\n      \"\"\"Breadth\u2011first search from *start* to any cell in *targets*.\n      Cells occupied by any entity are considered blocked, except the\n      target cells themselves (so we can step onto a primitive/workshop).\"\"\"\n      q = deque([start])\n      prev = {start: None}\n      visited = {start}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path (list of positions)\n              path = [cur]\n              while prev[path[-1]] is not None:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur):\n              if nb in visited:\n                  continue\n              # allow stepping onto a target even if blocked\n              if blocked[nb] and nb not in targets:\n                  continue\n              visited.add(nb)\n              prev[nb] = cur\n              q.append(nb)\n      return None\n\n  def _positions_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to movement actions.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              acts.append(RIGHT)\n          elif x1 < x0:\n              acts.append(LEFT)\n          elif y1 > y0:\n              acts.append(DOWN)\n          elif y1 < y0:\n              acts.append(UP)\n      return acts\n\n  # ----------------------------------------------------------------------\n  # Main plan construction\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      collected = 0\n      # Locate all cells that currently contain this primitive.\n      prim_cells = [(x, y) for x in range(width) for y in range(height)\n                    if grid[x, y, prim_idx] > 0]\n\n      # Simple greedy: keep fetching from the nearest remaining cell.\n      while collected < needed and prim_cells:\n          # Determine nearest cell (by Manhattan distance) among reachable ones.\n          # We will use BFS to guarantee reachability.\n          target = None\n          bfs_path = None\n          # Try each candidate until we find a reachable one.\n          for cand in prim_cells:\n              path = _bfs(pos, {cand})\n              if path is not None:\n                  bfs_path = path\n                  target = cand\n                  break\n          if bfs_path is None:\n              # No reachable primitive left.\n              raise RuntimeError(\"Unable to reach required primitive for arrow.\")\n          # Move to the primitive cell.\n          actions.extend(_positions_to_actions(bfs_path))\n          pos = bfs_path[-1]\n\n          # Determine how many units are available on this cell.\n          available = int(grid[target[0], target[1], prim_idx])\n          to_take = min(needed - collected, available)\n\n          # Perform USE actions to pick them up.\n          actions.extend([USE] * to_take)\n\n          # Update internal simulation state.\n          collected += to_take\n          grid[target[0], target[1], prim_idx] -= to_take\n          if grid[target[0], target[1], prim_idx] == 0:\n              # Cell becomes empty \u2192 not blocked any more.\n              blocked[target[0], target[1]] = False\n              # Remove from list of candidate cells.\n              prim_cells = [c for c in prim_cells if c != target]\n          else:\n              # Still some left; keep the cell in the list.\n              pass\n\n      if collected < needed:\n          raise RuntimeError(\"Insufficient primitive resources for crafting arrow.\")\n\n  # --------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft.\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  workshop_idx = None\n  if workshop_key is not None:\n      if isinstance(workshop_key, int):\n          workshop_idx = workshop_key\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_key)\n\n  if workshop_idx is not None:\n      # Find any workshop cell.\n      ws_cells = [(x, y) for x in range(width) for y in range(height)\n                  if grid[x, y, workshop_idx] > 0]\n      if not ws_cells:\n          raise RuntimeError(\"Workshop required for arrow not present on map.\")\n      # Choose the nearest reachable workshop.\n      ws_path = None\n      ws_target = None\n      for cand in ws_cells:\n          p = _bfs(pos, {cand})\n          if p is not None:\n              ws_path = p\n              ws_target = cand\n              break\n      if ws_path is not None:\n          actions.extend(_positions_to_actions(ws_path))\n          pos = ws_path[-1]\n\n  # Final USE to perform the crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:53:24.025486", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Shortcuts to world/state\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid.copy()                 # mutable copy for bookkeeping\n  inventory = state.inventory.copy()\n  width, height, n_kinds = grid.shape\n  pos = tuple(state.pos)                   # current (x, y)\n\n  # ----------------------------------------------------------------------\n  # Resolve goal index for \"arrow\"\n  # ----------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n  if goal_idx is None:\n      raise RuntimeError(\"Could not locate goal index for 'arrow'\")\n\n  # ----------------------------------------------------------------------\n  # Primitive requirements for the goal (raw resources)\n  # ----------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def in_bounds(p):\n      x, y = p\n      return 0 <= x < width and 0 <= y < height\n\n  def neighbors(p):\n      x, y = p\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if in_bounds((nx, ny)):\n              yield (nx, ny)\n\n  blocked = np.any(grid > 0, axis=2)          # True where any entity occupies\n\n  from collections import deque\n\n  def bfs(start, targets):\n      \"\"\"\n      Bread\u2011first search from *start* to the nearest cell in *targets*.\n      Cells that are blocked (any entity) are avoided.\n      Returns a list of positions (including start and goal) or None.\n      \"\"\"\n      q = deque([start])\n      prev = {start: None}\n      visited = {start}\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = [cur]\n              while prev[path[-1]] is not None:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in neighbors(cur):\n              if nb not in visited and not blocked[nb]:\n                  visited.add(nb)\n                  prev[nb] = cur\n                  q.append(nb)\n      return None\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into movement actions.\"\"\"\n      acts = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              acts.append(RIGHT)\n          elif x1 < x0:\n              acts.append(LEFT)\n          elif y1 > y0:\n              acts.append(DOWN)\n          elif y1 < y0:\n              acts.append(UP)\n      return acts\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      # list all cells containing this primitive\n      prim_cells = [(x, y) for x in range(width) for y in range(height)\n                    if grid[x, y, prim_idx] > 0]\n      cell_ptr = 0\n      while collected < needed and cell_ptr < len(prim_cells):\n          cell = prim_cells[cell_ptr]\n          cell_ptr += 1\n\n          # Determine free adjacent positions (or the cell itself if free)\n          candidate_spots = []\n          if not blocked[cell]:\n              candidate_spots.append(cell)\n          for nb in neighbors(cell):\n              if not blocked[nb]:\n                  candidate_spots.append(nb)\n\n          if not candidate_spots:\n              continue  # cannot reach this primitive instance\n\n          # Choose the closest candidate to current position\n          candidate_spots.sort(key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          target_spot = candidate_spots[0]\n\n          # Find path to the chosen spot\n          path = bfs(pos, {target_spot})\n          if path is None:\n              continue  # unreachable, try next primitive instance\n\n          actions.extend(path_to_actions(path))\n          pos = target_spot\n\n          # Pick up as many as needed from this cell\n          available = int(grid[cell[0], cell[1], prim_idx])\n          take = min(needed - collected, available)\n          actions.extend([USE] * take)\n          inventory[prim_idx] += take\n          grid[cell[0], cell[1], prim_idx] -= take\n          if grid[cell[0], cell[1], prim_idx] == 0:\n              blocked[cell] = False   # cell becomes free after collection\n          collected += take\n\n      if collected < needed:\n          raise RuntimeError(f\"Insufficient primitive {prim_idx} for crafting arrow\")\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  workshop_idx = None\n  if workshop_key is not None:\n      if isinstance(workshop_key, int):\n          workshop_idx = workshop_key\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_key)\n\n  if workshop_idx is not None:\n      # locate any workshop cell\n      ws_cells = [(x, y) for x in range(width) for y in range(height)\n                  if grid[x, y, workshop_idx] > 0]\n      if not ws_cells:\n          raise RuntimeError(\"No workshop cell found on the map\")\n      ws_cell = ws_cells[0]\n\n      # find a free adjacent spot (or the cell itself if free)\n      ws_targets = []\n      if not blocked[ws_cell]:\n          ws_targets.append(ws_cell)\n      for nb in neighbors(ws_cell):\n          if not blocked[nb]:\n              ws_targets.append(nb)\n\n      if ws_targets:\n          ws_targets.sort(key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          ws_goal = ws_targets[0]\n          path = bfs(pos, {ws_goal})\n          if path is not None:\n              actions.extend(path_to_actions(path))\n              pos = ws_goal\n\n  # final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:53:54.425562", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Possible moves with associated action IDs\n  _MOVES = [((0, 1), DOWN),   # down (y+1)\n            ((0, -1), UP),   # up   (y-1)\n            ((-1, 0), LEFT), # left (x-1)\n            ((1, 0), RIGHT)] # right(x+1)\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions moving from start to goal using BFS.\n      Cells that contain any entity are blocked, except the goal cell itself.\"\"\"\n      from collections import deque\n\n      w, h = grid.shape[0], grid.shape[1]\n      start = tuple(start)\n      goal = tuple(goal)\n      q = deque([start])\n      # maps position -> (prev_position, action_taken_to_reach)\n      prev = {start: (None, None)}\n\n      while q:\n          x, y = q.popleft()\n          if (x, y) == goal:\n              break\n          for (dx, dy), act in _MOVES:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # Allow stepping onto the goal even if occupied\n              if (nx, ny) != goal and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if goal not in prev:\n          # No path found\n          return []\n\n      # Reconstruct actions backwards\n      actions = []\n      cur = goal\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          actions.append(act)\n      actions.reverse()\n      return actions\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell (Manhattan) that contains the given kind.\n      Returns [x, y] or None if not present.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Planning starts here\n  # ------------------------------------------------------------------\n  actions = []\n\n  # Determine current position (live state if available, else initial)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid for planning purposes\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Required primitive not found \u2013 abort planning\n              return actions\n          # Move to the primitive\n          actions.extend(_bfs_path(cur_pos, target, grid))\n          # Pick it up\n          actions.append(USE)\n          # Update simulated grid and position\n          grid[target[0], target[1], prim_kind] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(_bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)   # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
