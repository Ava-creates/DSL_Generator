{"timestamp": "2025-10-28T17:18:16.496466", "function_name": "make_arrow", "function_body": "  # action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance 1) to any of `targets`.\n  # Cells with any non\u2011zero kind are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, occ_grid):\n      w, h, _ = occ_grid.shape\n      occupied = np.any(occ_grid > 0, axis=2)          # bool mask of blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path \u2013 return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook from the environment (different wrappers\n  # expose them in slightly different places).\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Try to get it from the current state wrapper\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal is hard\u2011coded to the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  cur_grid = state.grid.copy()    # mutable copy for path\u2011finding\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from current position (greedy).\n      locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update position following the path.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell empty for subsequent planning.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if the recipe specifies one).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve the workshop index (could be a string name).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Find all workshop cells of that type.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:18:17.624117", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent to any of `targets`.  Movement is only\n  # allowed on empty cells (no entity present in any channel).\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      width, height, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # any non\u2011zero kind blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency (Manhattan distance 1) to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Expand 4\u2011connected neighbours\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world, cookbook and goal information\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers keep the world inside the current state\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = state_wrapper.world\n  cookbook = world.cookbook\n\n  goal_idx = cookbook.index[\"arrow\"]               # hard\u2011coded goal\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)            # (x, y)\n  cur_grid = state.grid.copy()      # mutable copy for path\u2011finding\n\n  actions = []\n  harvested = set()                 # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Greedy nearest\u2011first ordering\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update position according to the path taken\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n          # Mark cell as empty for future searches\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # Find workshop cells\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:18:59.589323", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action / direction helpers\n  # ----------------------------------------------------------------------\n  act_spec = env.action_specs()\n  ACTION_DOWN = act_spec.get('DOWN', 0)\n  ACTION_UP = act_spec.get('UP', 1)\n  ACTION_LEFT = act_spec.get('LEFT', 2)\n  ACTION_RIGHT = act_spec.get('RIGHT', 3)\n  ACTION_USE = act_spec.get('USE', 4)\n\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,\n      (0, -1): ACTION_UP,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search that stops when we are adjacent to any target cell\n  # ----------------------------------------------------------------------\n  def bfs_adj(start, targets, grid):\n      \"\"\"Return a list of actions that moves from ``start`` to a cell\n      adjacent (Manhattan distance 1) to any cell in ``targets`` while\n      avoiding non\u2011grabbable obstacles.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Cells that cannot be entered (environment / non\u2011grabbable entities)\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:\n                  npath = path + [act]\n                  # Check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # Unreachable\n      return []\n\n  # ----------------------------------------------------------------------\n  # Extract current world information\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy of the world grid\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index (stored in the task description)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []                     # nothing to do if goal is missing\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive / intermediate items are required\n  # ----------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required items\n  # ----------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          # Locate remaining cells that contain this kind\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # No more of this item on the map \u2013 abort planning\n              return plan\n\n          # Move adjacent to the nearest reachable instance\n          path = bfs_adj(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate the movement on our local position variable\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick it up\n          plan.append(ACTION_USE)\n\n          # Find which cell we just used (must be adjacent)\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Safety break \u2013 should not happen\n              break\n\n          # Update simulated grid and remaining count\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or an integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adj(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:19:00.692379", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {(0, 1): ACTION_DOWN,\n             (0, -1): ACTION_UP,\n             (-1, 0): ACTION_LEFT,\n             (1, 0): ACTION_RIGHT}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_to_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from ``start`` to a cell adjacent to any\n      target while avoiding cells marked as ``occupied`` (bool array).\"\"\"\n      W, H = occupied.shape\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[start[0], start[1]] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not occupied[nx, ny]:\n                  new_path = path + [act]\n                  # Check adjacency to any target from the new cell.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return new_path\n                  visited[nx, ny] = True\n                  q.append((nx, ny, new_path))\n      # Unreachable\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract current world information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy of the grid\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal index stored in the task\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      return []\n\n  # Primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          # Locate cells that still contain this primitive.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not available \u2013 abort planning.\n              return plan\n\n          # Cells occupied by any entity block movement.\n          occupied = np.any(grid > 0, axis=2)\n\n          # Find a path to a position adjacent to one of the primitive cells.\n          path = bfs_to_adjacent(pos, cells.tolist(), occupied)\n          plan.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Safety break to avoid infinite loop.\n              break\n\n          # Update local grid copy and decrement remaining count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          occupied = np.any(grid > 0, axis=2)\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), occupied)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:19:25.823179", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _in_bounds(pos, shape):\n      x, y = pos\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(pos, shape):\n      x, y = pos\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny), shape):\n              yield (nx, ny)\n\n  def _bfs(start, goal_set, blocked):\n      \"\"\"\n      Bread\u2011first search from ``start`` to any cell in ``goal_set``.\n      ``blocked`` is a 2\u2011D bool array where True means the cell cannot be entered.\n      Returns a list of positions (including start) representing the path,\n      or ``None`` if no path exists.\n      \"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      dq = deque([start])\n      visited[start] = True\n      while dq:\n          cur = dq.popleft()\n          if cur in goal_set:\n              # reconstruct path\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur, (w, h)):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) into a list of movement actions.\"\"\"\n      act_list = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              act_list.append(RIGHT)\n          elif x1 < x0:\n              act_list.append(LEFT)\n          elif y1 > y0:\n              act_list.append(DOWN)\n          elif y1 < y0:\n              act_list.append(UP)\n      return act_list\n\n  # ----------------------------------------------------------------------\n  # Main logic\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  shape = grid.shape[:2]                     # (WIDTH, HEIGHT)\n\n  # --------------------------------------------------------------\n  # Determine goal index for \"arrow\"\n  # --------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception as e:\n          raise RuntimeError(\"Could not locate goal index for 'arrow'\") from e\n\n  # --------------------------------------------------------------\n  # Primitive requirements for the goal (expanded)\n  # --------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  # --------------------------------------------------------------\n  # Build blocked map (cells that cannot be stepped on)\n  # --------------------------------------------------------------\n  blocked = np.zeros(shape, dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper: move to a target cell (any reachable cell)\n  # --------------------------------------------------------------\n  def _move_to(target):\n      nonlocal cur_pos, actions, blocked\n      path = _bfs(cur_pos, {target}, blocked)\n      if path is None:\n          # unreachable \u2013 skip\n          return cur_pos\n      actions.extend(_path_to_actions(path))\n      cur_pos = target\n      return cur_pos\n\n  # --------------------------------------------------------------\n  # Collect required primitives\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # locate all cells containing this primitive\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          continue\n      # pick the first occurrence (any is fine)\n      prim_pos = tuple(locs[0])\n      _move_to(prim_pos)\n      actions.extend([USE] * needed)\n      # after picking up, the cell becomes empty \u2013 unblock it\n      blocked[prim_pos] = False\n\n  # --------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index\n      if isinstance(workshop_key, int):\n          workshop_idx = workshop_key\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_key)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              ws_pos = tuple(ws_locs[0])\n              # Find a free adjacent cell\n              adj_cells = [nb for nb in _neighbors(ws_pos, shape) if not blocked[nb]]\n              if adj_cells:\n                  # Choose the closest adjacent cell to current position\n                  adj_cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n                  target_adj = adj_cells[0]\n                  _move_to(target_adj)\n\n  # Finally, use the workshop (or current cell) to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:19:26.933616", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Setup\n  # --------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  world = env.world\n  state = env._current_state\n  grid = state.grid                # shape (W, H, n_kinds)\n  shape = grid.shape[:2]           # (W, H)\n\n  # --------------------------------------------------------------\n  # Goal index for the item \"arrow\"\n  # --------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n  if goal_idx is None:\n      raise RuntimeError(\"Unable to locate goal index for 'arrow'\")\n\n  # --------------------------------------------------------------\n  # Primitive requirements (flattened)\n  # --------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # --------------------------------------------------------------\n  # Blocked cells \u2013 cannot step on non\u2011grabbable entities\n  # --------------------------------------------------------------\n  blocked = np.zeros(shape, dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  def _in_bounds(p):\n      x, y = p\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(p):\n      x, y = p\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny)):\n              yield (nx, ny)\n\n  def _bfs(start, target_set):\n      \"\"\"Return list of positions from start to any cell in target_set.\"\"\"\n      w, h = shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      dq = deque([start])\n      visited[start] = True\n      while dq:\n          cur = dq.popleft()\n          if cur in target_set:\n              # reconstruct path\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _path_to_actions(path):\n      act = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              act.append(RIGHT)\n          elif x1 < x0:\n              act.append(LEFT)\n          elif y1 > y0:\n              act.append(DOWN)\n          elif y1 < y0:\n              act.append(UP)\n      return act\n\n  def _move_to(target):\n      nonlocal cur_pos, actions\n      path = _bfs(cur_pos, {target})\n      if path is None:\n          return False\n      actions.extend(_path_to_actions(path))\n      cur_pos = target\n      return True\n\n  # --------------------------------------------------------------\n  # Collect all required primitives (greedy nearest search)\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_reqs.items():\n      while needed > 0:\n          # locate cells that still contain this primitive\n          candidates = np.argwhere(grid[:, :, prim_idx] > 0)\n          if candidates.size == 0:\n              # no more sources \u2013 break out (should not happen in valid scenarios)\n              break\n          # find the nearest candidate using BFS (stop at first found)\n          target_path = _bfs(cur_pos, {tuple(tuple(c) for c in candidates)})\n          if target_path is None:\n              # unreachable \u2013 abort remaining collection for this primitive\n              break\n          target = target_path[-1]\n          # move there\n          actions.extend(_path_to_actions(target_path))\n          cur_pos = target\n          # pick up one item\n          actions.append(USE)\n          needed -= 1\n          # update our internal view of the grid / blocked map\n          grid[target[0], target[1], prim_idx] = 0\n          blocked[target] = False\n\n  # --------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the goal\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index\n      if isinstance(workshop_key, int):\n          ws_idx = workshop_key\n      else:\n          ws_idx = world.cookbook.index.get(workshop_key)\n      if ws_idx is not None:\n          ws_cells = np.argwhere(grid[:, :, ws_idx] > 0)\n          if ws_cells.size > 0:\n              ws_pos = tuple(ws_cells[0])\n              # Choose a free adjacent cell to stand on\n              adj = [nb for nb in _neighbors(ws_pos) if not blocked[nb]]\n              if adj:\n                  # pick the adjacent cell closest to current position\n                  adj.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n                  _move_to(adj[0])\n  # finally use (craft) at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:19:55.905928", "function_name": "make_arrow", "function_body": "  # Action indices\n  spec = env.action_specs()\n  DOWN = spec[\"DOWN\"]\n  UP = spec[\"UP\"]\n  LEFT = spec[\"LEFT\"]\n  RIGHT = spec[\"RIGHT\"]\n  USE = spec[\"USE\"]\n\n  # Current state information\n  state = env._current_state\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # copy to simulate pickups\n\n  # Goal and required primitives\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)   # {prim_idx: count}\n\n  width, height = grid.shape[:2]\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan movement (fallback when BFS fails)\n  # ------------------------------------------------------------------\n  def _manhattan(cur, tgt):\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path respecting non\u2011grabbable obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal_pos, allow_goal=True):\n      # Determine blocked cells (any non\u2011grabbable entity present)\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # The destination may contain the target primitive/workshop; allow stepping onto it.\n      if allow_goal:\n          blocked[goal_pos[0], goal_pos[1]] = False\n\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n\n      while q:\n          cur = q.popleft()\n          if cur == goal_pos:\n              break\n          x, y = cur\n          for a, (dx, dy) in (\n              (DOWN, (1, 0)),\n              (UP, (-1, 0)),\n              (RIGHT, (0, 1)),\n              (LEFT, (0, -1)),\n          ):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n\n      if goal_pos not in came_from:\n          return None  # no path found\n\n      # Reconstruct action list\n      actions_rev = []\n      cur = goal_pos\n      while cur != start:\n          actions_rev.append(action_from[cur])\n          cur = came_from[cur]\n      actions_rev.reverse()\n      return actions_rev\n\n  # ------------------------------------------------------------------\n  # Main plan: collect primitives then craft at workshop.\n  # ------------------------------------------------------------------\n  actions = []\n\n  # ---- Collect each required primitive ----\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Find all current locations of this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # Nothing left to collect; abort further attempts for this primitive\n              break\n\n          # Choose nearest location (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n          )\n\n          # Compute path\n          path = _bfs_path(pos, target, allow_goal=True)\n          if path is None:\n              path = _manhattan(pos, target)\n\n          actions.extend(path)\n          pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n          grid[pos[0], pos[1], prim_idx] = 0   # simulate removal\n\n  # ---- Move to workshop and craft ----\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_locs:\n          # Choose nearest workshop\n          target_ws = min(\n              workshop_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1])\n          )\n          path = _bfs_path(pos, target_ws, allow_goal=True)\n          if path is None:\n              path = _manhattan(pos, target_ws)\n          actions.extend(path)\n          pos = target_ws\n          actions.append(USE)   # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:19:57.028034", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN = spec[\"DOWN\"]; UP = spec[\"UP\"]; LEFT = spec[\"LEFT\"]; RIGHT = spec[\"RIGHT\"]; USE = spec[\"USE\"]\n  state = env._current_state\n  pos = tuple(state.pos)\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n  # work on a mutable copy of the grid to mark collected items\n  grid = state.grid.copy()\n  width, height = grid.shape[:2]\n\n  # pre\u2011compute blocked cells (non\u2011grabbable entities)\n  non_grab = list(env.world.non_grabbable_indices)\n  if non_grab:\n      base_blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n  else:\n      base_blocked = np.zeros((width, height), dtype=bool)\n\n  def bfs_path(start, target, allow_target_block=False):\n      \"\"\"Return a list of actions from start to target avoiding base_blocked.\"\"\"\n      blocked = base_blocked.copy()\n      if allow_target_block:\n          blocked[target[0], target[1]] = False\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_from = {}\n      moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (RIGHT, (0, 1)), (LEFT, (0, -1))]\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_from[nxt] = a\n                      q.append(nxt)\n      if target not in came_from:\n          return None\n      # reconstruct\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_from[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  def manhattan_path(start, target):\n      moves = []\n      x, y = start\n      tx, ty = target\n      while x < tx:\n          moves.append(DOWN); x += 1\n      while x > tx:\n          moves.append(UP); x -= 1\n      while y < ty:\n          moves.append(RIGHT); y += 1\n      while y > ty:\n          moves.append(LEFT); y -= 1\n      return moves\n\n  actions = []\n\n  # ---- collect primitives ----\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate remaining instances of this primitive\n          locs = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locs:\n              break  # none left\n          # choose nearest by Manhattan distance\n          target = min(locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target)\n          actions.extend(path)\n          actions.append(USE)          # pick up\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0   # remove from simulated grid\n\n  # ---- move to workshop and craft ----\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_ws = min(ws_locs, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs_path(pos, target_ws, allow_target_block=True)\n          if path is None:\n              path = manhattan_path(pos, target_ws)\n          actions.extend(path)\n          actions.append(USE)   # craft\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:20:31.242328", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve action indices\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper: move from current position to a target cell using Manhattan steps\n  # ----------------------------------------------------------------------\n  def _move(cur, tgt):\n      actions = []\n      x0, y0 = cur\n      x1, y1 = tgt\n      # horizontal moves\n      while x0 < x1:\n          actions.append(RIGHT)\n          x0 += 1\n      while x0 > x1:\n          actions.append(LEFT)\n          x0 -= 1\n      # vertical moves\n      while y0 < y1:\n          actions.append(DOWN)\n          y0 += 1\n      while y0 > y1:\n          actions.append(UP)\n          y0 -= 1\n      return actions, (x0, y0)\n\n  # ----------------------------------------------------------------------\n  # Resolve goal index for \"arrow\"\n  # ----------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = env.world.cookbook.index.get(\"arrow\")\n      if goal_idx is None:\n          raise RuntimeError(\"Arrow item not found in cookbook\")\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive items are needed to craft an arrow\n  # ----------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Get current state information\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid\n  cur_pos = tuple(state.pos)\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (ignore obstacles for simplicity)\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      # locate all cells containing this primitive\n      locations = [tuple(pos) for pos in np.argwhere(grid[:, :, prim_idx] > 0)]\n      gathered = 0\n      while gathered < cnt and locations:\n          target = locations.pop(0)\n          move_acts, cur_pos = _move(cur_pos, target)\n          actions.extend(move_acts)\n          # pick up the primitive (use once; assume one item per cell)\n          actions.append(USE)\n          gathered += 1\n          # update grid so we don't try to pick the same cell again\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or integer)\n      if isinstance(workshop_key, int):\n          workshop_idx = workshop_key\n      else:\n          workshop_idx = env.world.cookbook.index.get(workshop_key)\n      if workshop_idx is not None:\n          workshop_cells = [tuple(pos) for pos in np.argwhere(grid[:, :, workshop_idx] > 0)]\n          if workshop_cells:\n              # Move next to the first workshop cell (choose an adjacent free cell)\n              ws = workshop_cells[0]\n              # simple approach: move directly onto the workshop cell itself\n              move_acts, cur_pos = _move(cur_pos, ws)\n              actions.extend(move_acts)\n\n  # ----------------------------------------------------------------------\n  # Final USE to craft the arrow\n  # ----------------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:20:32.358433", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action mapping\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _in_bounds(pos, shape):\n      x, y = pos\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(pos, shape):\n      x, y = pos\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny), shape):\n              yield (nx, ny)\n\n  def _bfs(start, goals, blocked):\n      \"\"\"Bread\u2011first search from start to any cell in goals.\"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      dq = deque([start])\n      visited[start] = True\n      while dq:\n          cur = dq.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur, (w, h)):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) into movement actions.\"\"\"\n      act_list = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              act_list.append(RIGHT)\n          elif x1 < x0:\n              act_list.append(LEFT)\n          elif y1 > y0:\n              act_list.append(DOWN)\n          elif y1 < y0:\n              act_list.append(UP)\n      return act_list\n\n  # ----------------------------------------------------------------------\n  # Main planning\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  shape = grid.shape[:2]                     # (WIDTH, HEIGHT)\n\n  # --------------------------------------------------------------\n  # Resolve the goal index for \"arrow\"\n  # --------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n  if goal_idx is None:\n      raise RuntimeError(\"Could not locate index for goal 'arrow'\")\n\n  # --------------------------------------------------------------\n  # Primitive requirements (expanded)\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  # --------------------------------------------------------------\n  # Cells that cannot be stepped on (non\u2011grabbable entities)\n  # --------------------------------------------------------------\n  blocked = np.zeros(shape, dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # --------------------------------------------------------------\n  # Helper: move to a target cell (any reachable cell)\n  # --------------------------------------------------------------\n  def _move_to(target):\n      nonlocal cur_pos, actions\n      path = _bfs(cur_pos, {target}, blocked)\n      if path is None:\n          return False\n      actions.extend(_path_to_actions(path))\n      cur_pos = target\n      return True\n\n  # --------------------------------------------------------------\n  # Collect each required primitive\n  # --------------------------------------------------------------\n  for prim_idx, need_cnt in primitive_needs.items():\n      gathered = 0\n      while gathered < need_cnt:\n          # locate all cells that currently contain this primitive\n          locations = [tuple(pos) for pos in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # no more of this primitive on the map\n              break\n\n          # pick the reachable location with the shortest path\n          best_loc = None\n          best_len = None\n          for loc in locations:\n              path = _bfs(cur_pos, {loc}, blocked)\n              if path is not None:\n                  if best_len is None or len(path) < best_len:\n                      best_loc = loc\n                      best_len = len(path)\n          if best_loc is None:\n              # none reachable \u2013 give up on this primitive\n              break\n\n          _move_to(best_loc)\n\n          # how many of this primitive are on the cell?\n          available = int(grid[best_loc[0], best_loc[1], prim_idx])\n          use_cnt = min(need_cnt - gathered, available)\n          actions.extend([USE] * use_cnt)\n\n          # update grid view (cell becomes empty if we took everything)\n          grid[best_loc[0], best_loc[1], prim_idx] = max(0, available - use_cnt)\n          gathered += use_cnt\n\n  # --------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, int):\n          workshop_idx = workshop_key\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_key)\n      if workshop_idx is not None:\n          workshop_cells = [tuple(pos) for pos in np.argwhere(grid[:, :, workshop_idx] > 0)]\n          if workshop_cells:\n              ws = workshop_cells[0]\n              # Find a free adjacent cell to the workshop\n              adj_candidates = [nb for nb in _neighbors(ws, shape) if not blocked[nb]]\n              if adj_candidates:\n                  # Choose the closest candidate to current position\n                  adj_candidates.sort(\n                      key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1])\n                  )\n                  _move_to(adj_candidates[0])\n\n  # --------------------------------------------------------------\n  # Final craft action\n  # --------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:21:25.493107", "function_name": "make_arrow", "function_body": "  # Ensure the environment starts from a fresh episode.\n  env.reset()\n  cur_state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of move actions (0\u20113) which brings\n  # the agent to a position where the cell directly in front contains\n  # the desired kind. If unreachable, returns an empty list.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  # Action \u2192 (dx, dy) mapping (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT)\n  _DIR_DELTAS = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0),   # RIGHT\n  }\n\n  def _in_bounds(x, y, w, h):\n      return 0 <= x < w and 0 <= y < h\n\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      w, h = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n\n      def walkable(x, y):\n          if not _in_bounds(x, y, w, h):\n              return False\n          # Any occupied cell blocks movement.\n          return not np.any(grid[x, y, :])\n\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, acts = q.popleft()\n          # Is the cell in front the target?\n          dx, dy = _DIR_DELTAS[d]\n          fx, fy = x + dx, y + dy\n          if _in_bounds(fx, fy, w, h) and grid[fx, fy, target_kind] > 0:\n              return acts\n          # Expand possible moves.\n          for a in (0, 1, 2, 3):\n              ndx, ndy = _DIR_DELTAS[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n      # Target not reachable.\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for the goal.\n  # ------------------------------------------------------------------\n  primitive_reqs = world.cookbook.primitives_for(goal_idx)\n\n  # Determine workshop (if any) where the goal must be crafted.\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_name = recipe.get('_at')\n      if workshop_name is not None:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect required primitives.\n  # ------------------------------------------------------------------\n  for prim_kind, count in primitive_reqs.items():\n      for _ in range(count):\n          move_seq = _bfs_to_target(cur_state, prim_kind)\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up the primitive\n          # Apply actions to keep the internal state in sync.\n          for a in move_seq + [4]:\n              _, _, _ = env.step(a)\n              cur_state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Go to the workshop (if needed) and craft the goal item.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      actions.extend(move_seq)\n      actions.append(4)  # USE to craft at the workshop\n      for a in move_seq + [4]:\n          _, _, _ = env.step(a)\n          cur_state = env._current_state\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:21:26.618002", "function_name": "make_arrow", "function_body": "  # reset environment to start state\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # retrieve action indices from the environment\n  act_spec = env.action_specs()\n  DOWN = act_spec[\"DOWN\"]\n  UP = act_spec[\"UP\"]\n  LEFT = act_spec[\"LEFT\"]\n  RIGHT = act_spec[\"RIGHT\"]\n  USE = act_spec[\"USE\"]\n\n  # direction \u2192 (dx, dy) mapping (grid indexed as [x, y])\n  deltas = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # goal item index\n  goal_idx = env.task.goal\n\n  # primitive requirements for the goal (kind \u2192 count)\n  primitive_reqs = world.cookbook.primitives_for(goal_idx)\n\n  # workshop where the goal must be crafted (if any)\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_idx = None\n  if isinstance(recipe, dict):\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name is not None:\n          workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # helper: BFS that returns a list of movement actions which leaves the\n  # agent adjacent to a cell containing ``target_kind`` and facing it.\n  # Returns None if no such sequence exists.\n  # ------------------------------------------------------------------\n  def _bfs_to_adjacent(grid, start_pos, start_dir, target_kind):\n      w, h = grid.shape[:2]\n\n      def _in_bounds(x, y):\n          return 0 <= x < w and 0 <= y < h\n\n      # already facing the target?\n      dx, dy = deltas[start_dir]\n      fx, fy = start_pos[0] + dx, start_pos[1] + dy\n      if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n          return []\n\n      from collections import deque\n\n      visited = set()\n      q = deque()\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      visited.add((start_pos[0], start_pos[1], start_dir))\n\n      while q:\n          x, y, d, path = q.popleft()\n\n          # check if the cell in front holds the target\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if _in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return path\n\n          # expand possible moves\n          for a, (mx, my) in deltas.items():\n              nx, ny = x + mx, y + my\n              if not _in_bounds(nx, ny):\n                  continue\n              # movement only allowed onto empty cells\n              if np.any(grid[nx, ny, :]):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, path + [a]))\n\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_kind, cnt in primitive_reqs.items():\n      for _ in range(cnt):\n          path = _bfs_to_adjacent(state.grid, state.pos, state.dir, prim_kind)\n          if path is None:\n              # cannot reach the primitive \u2013 abort early\n              return actions\n          for a in path:\n              _, _, _ = env.step(a)\n              state = env._current_state\n              actions.append(a)\n          # pick up the primitive\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # 2) go to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      path = _bfs_to_adjacent(state.grid, state.pos, state.dir, workshop_idx)\n      if path is not None:\n          for a in path:\n              _, _, _ = env.step(a)\n              state = env._current_state\n              actions.append(a)\n          # craft / use the workshop\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
