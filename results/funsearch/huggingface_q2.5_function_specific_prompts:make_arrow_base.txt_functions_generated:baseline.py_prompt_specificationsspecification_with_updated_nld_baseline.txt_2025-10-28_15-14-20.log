{"timestamp": "2025-10-28T22:49:32.391038", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action constants and movement deltas (match CraftWorld ordering).\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP:   (0, -1),\n      LEFT: (-1, 0),\n      RIGHT:(1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # Unreachable \u2013 return empty list (caller will handle failure)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Extract world / state / cookbook from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Most likely a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # Raw CraftWorld / scenario.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is already a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ----------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # shape (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, need_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < need_cnt:\n          # Locate all remaining instances of this primitive.\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the primitive cell becomes empty.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Find all workshop cells of this type.\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft\n      else:\n          # No workshop present \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:49:33.559318", "function_name": "make_arrow", "function_body": "  # Action identifiers (match CraftWorld ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      from collections import deque\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # Unreachable \u2013 return empty list (caller may handle failure)\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world, state and cookbook from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env is likely a wrapped CraftLab instance\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # env may be a raw CraftWorld or CraftScenario\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine primitive resources needed for one arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                         # (W, H, n_kinds)\n  pos = tuple(state.pos)                    # (x, y)\n  occupied = np.any(grid > 0, axis=2)       # True where any entity exists\n\n  actions = []\n  harvested = set()                         # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all remaining instances of this primitive not yet harvested.\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask (the primitive cell becomes empty).\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      # Locate workshop cells of the required type.\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          # Choose the nearest workshop.\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n\n          # Move adjacent to the workshop.\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use to craft.\n          actions.append(USE)\n      else:\n          # No workshop found \u2013 just use current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:49:55.377178", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Setup: obtain world, current state, and cookbook (covers possible wrappers)\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env might be a CraftLab wrapper\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive; just use the current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell adjacent (Manhattan distance = 1) to any cell in `targets`.\n  # `blocked` is a bool array where True indicates an occupied cell.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_adjacent(start, targets, blocked):\n      width, height = blocked.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in ((DOWN, (0, 1)),\n                                (UP,   (0, -1)),\n                                (LEFT, (-1, 0)),\n                                (RIGHT,(1, 0))):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell\n      return []\n\n  # ------------------------------------------------------------------\n  # Current grid, position, and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                               # (W, H, n_kinds)\n  pos = tuple(state.pos)                          # (x, y)\n  blocked = np.any(grid > 0, axis=2)              # True where any entity exists\n\n  actions = []\n  harvested = set()                               # primitives already taken\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells still containing this primitive and not yet harvested.\n          locations = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not locations:\n              # No more of this primitive on the map \u2013 stop trying.\n              break\n\n          # Choose the closest location (Manhattan distance).\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], blocked)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = ((0, 1) if act == DOWN else\n                        (0, -1) if act == UP else\n                        (-1, 0) if act == LEFT else\n                        (1, 0))\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the primitive cell becomes empty.\n          blocked[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Locate all workshop cells of this type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], blocked)\n          actions.extend(path)\n          for act in path:\n              dx, dy = ((0, 1) if act == DOWN else\n                        (0, -1) if act == UP else\n                        (-1, 0) if act == LEFT else\n                        (1, 0))\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft at the workshop\n      else:\n          # No workshop present \u2013 fallback to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T22:49:56.532731", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Setup: action constants and movement deltas\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to any cell *adjacent* to one of the `targets`.\n  # `blocked` is a 2\u2011D bool array where True means the cell cannot be\n  # entered (occupied by any entity).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def _bfs_adjacent(start, targets, blocked):\n      width, height = blocked.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying world, current state and the cookbook.\n  # This works for both raw CraftWorld environments and the\n  # CraftLab wrapper.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Likely a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are needed for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  blocked = np.any(grid > 0, axis=2)    # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all remaining cells that contain this primitive.\n          locations = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not locations:\n              # No more of this primitive on the map \u2013 abort collection.\n              break\n\n          # Choose the closest one (Manhattan distance).\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], blocked)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy: the primitive cell becomes empty.\n          blocked[target] = False\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve the workshop index (could be a name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      # Find all workshop cells of this type.\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], blocked)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at the workshop\n      else:\n          # No workshop present \u2013 fall back to using current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:50:28.293002", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (matching CraftWorld's definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper: shortest path (BFS) to any cell adjacent to a target location.\n  # Returns a list of actions that moves the agent from `start` to a cell\n  # that is orthogonally adjacent to one of `targets`.  Cells that are\n  # occupied (any non\u2011zero kind) are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_path(start, targets, occ):\n      w, h = occ.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are next to a target, stop (we can USE from here)\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Explore neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occ[nx, ny]:          # free cell\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path \u2013 return empty list (caller will ignore)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Grab world / cookbook information\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Fallback: try to obtain from the current CraftState\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Goal is the item named \"arrow\"\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary)\n  # ----------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Current mutable view of the grid and occupancy mask\n  pos = tuple(state.pos)                     # (x, y)\n  cur_grid = state.grid.copy()\n  occupied = np.any(cur_grid > 0, axis=2)    # True where any kind is present\n\n  actions = []                               # final action list\n  harvested = set()                          # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, required_cnt in primitives_needed.items():\n      # All cells that currently contain this primitive\n      prim_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position (greedy nearest\u2011first)\n      prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n\n      gathered = 0\n      for cell in prim_cells:\n          if gathered >= required_cnt:\n              break\n          if cell in harvested:\n              continue\n\n          # Move next to the cell\n          path = _bfs_path(pos, [cell], occupied)\n          actions.extend(path)\n          # Update our internal position following the path\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up the primitive\n          actions.append(USE)\n          # Remove it from our local copy of the grid so future planning sees the cell as free\n          cur_grid[cell[0], cell[1], prim_idx] = 0\n          occupied[cell[0], cell[1]] = False\n          harvested.add(cell)\n          gathered += 1\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the workshop (if the recipe specifies one) and craft\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")            # may be None or a string / index\n  if workshop_key is not None:\n      # Resolve workshop index\n      ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          # Choose nearest workshop cell\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_path(pos, [target_ws], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft the arrow\n          actions.append(USE)\n      else:\n          # No visible workshop (unlikely), just attempt to USE at current location\n          actions.append(USE)\n  else:\n      # Recipe has no explicit workshop \u2013 just USE where we are\n      actions.append(USE)\n\n  # Return the complete plan\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
