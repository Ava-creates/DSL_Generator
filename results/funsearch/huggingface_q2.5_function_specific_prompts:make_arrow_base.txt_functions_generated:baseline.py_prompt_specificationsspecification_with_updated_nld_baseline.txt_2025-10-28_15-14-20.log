{"timestamp": "2025-10-28T16:19:22.147138", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:19:37.720465", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Hash function for visited states (position, direction, inventory, grid)\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action count (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:20:05.156096", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _action_map():\n      \"\"\"Return mapping from action name to integer.\"\"\"\n      spec = env.action_specs()\n      return {\n          \"DOWN\": spec.get(\"DOWN\", 0),\n          \"UP\": spec.get(\"UP\", 1),\n          \"LEFT\": spec.get(\"LEFT\", 2),\n          \"RIGHT\": spec.get(\"RIGHT\", 3),\n          \"USE\": spec.get(\"USE\", 4),\n      }\n\n  ACTIONS = _action_map()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      ACTIONS[\"DOWN\"],\n      ACTIONS[\"UP\"],\n      ACTIONS[\"LEFT\"],\n      ACTIONS[\"RIGHT\"],\n      ACTIONS[\"USE\"],\n  )\n\n  # ----------------------------------------------------------------------\n  # Path\u2011finding (Manhattan BFS avoiding occupied cells)\n  # ----------------------------------------------------------------------\n  def _blocked_cells(grid):\n      \"\"\"Boolean 2\u2011D array: True where any entity occupies the cell.\"\"\"\n      return np.any(grid > 0, axis=2)\n\n  def _in_bounds(pos, shape):\n      x, y = pos\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(pos, shape):\n      x, y = pos\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny), shape):\n              yield (nx, ny)\n\n  def _bfs(start, goals, blocked):\n      \"\"\"\n      Breadth\u2011first search from ``start`` to any cell in ``goals``.\n      ``blocked`` is a 2\u2011D bool array where True means the cell cannot be entered.\n      Returns a list of positions (including start) representing the path,\n      or ``None`` if no path exists.\n      \"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = dict()\n\n      dq = deque()\n      dq.append(start)\n      visited[start] = True\n\n      while dq:\n          cur = dq.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur, (w, h)):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _pos_to_actions(path, cur_dir):\n      \"\"\"\n      Convert a list of positions (including the starting cell) into a list\n      of movement actions. ``cur_dir`` is ignored because the environment\n      updates direction automatically on movement.\n      Returns (actions, final_pos).\n      \"\"\"\n      actions = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              actions.append(RIGHT)\n          elif x1 < x0:\n              actions.append(LEFT)\n          elif y1 > y0:\n              actions.append(DOWN)\n          elif y1 < y0:\n              actions.append(UP)\n      return actions\n\n  # ----------------------------------------------------------------------\n  # Main logic\n  # ----------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid\n  shape = grid.shape[:2]  # (WIDTH, HEIGHT)\n\n  # --------------------------------------------------------------\n  # Determine the goal index for the item \u201carrow\u201d.\n  # --------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception as e:\n          raise RuntimeError(\"Could not find goal index for 'arrow'\") from e\n\n  # --------------------------------------------------------------\n  # Primitive requirements (expanded to raw resources)\n  # --------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  blocked = _blocked_cells(grid)\n\n  # --------------------------------------------------------------\n  # Helper: move to a target cell (or adjacent free cell) and\n  # optionally turn towards a neighbour before using.\n  # --------------------------------------------------------------\n  def _move_to_adjacent(target):\n      \"\"\"\n      Move the agent to a free cell that is orthogonally adjacent to ``target``.\n      Returns the position the agent ends up in (the adjacent cell).\n      \"\"\"\n      nonlocal cur_pos, actions, blocked\n\n      # First try the target itself if it is free (some primitives may be on\n      # the floor and not block movement). Otherwise search neighbours.\n      candidates = []\n      if not blocked[target]:\n          candidates.append(target)\n      for nb in _neighbors(target, shape):\n          if not blocked[nb]:\n              candidates.append(nb)\n\n      if not candidates:\n          # No reachable adjacent cell \u2013 give up.\n          return cur_pos\n\n      # Choose the candidate with the shortest Manhattan distance.\n      candidates.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n      dest = candidates[0]\n\n      # Find path.\n      path = _bfs(cur_pos, {dest}, blocked)\n      if path is None:\n          # No path \u2013 give up.\n          return cur_pos\n\n      # Convert to actions.\n      actions.extend(_pos_to_actions(path, None))\n      cur_pos = dest\n      return cur_pos\n\n  def _face_towards(src, tgt):\n      \"\"\"\n      Append a single movement action that points the agent from ``src`` to\n      ``tgt`` (the agent does not move if the cell is blocked, but the\n      direction changes). Returns nothing.\n      \"\"\"\n      sx, sy = src\n      tx, ty = tgt\n      if tx > sx:\n          actions.append(RIGHT)\n      elif tx < sx:\n          actions.append(LEFT)\n      elif ty > sy:\n          actions.append(DOWN)\n      elif ty < sy:\n          actions.append(UP)\n\n  # --------------------------------------------------------------\n  # Collect each required primitive.\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # Locations where the primitive currently exists.\n      locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locs.size == 0:\n          # Primitive not present \u2013 skip (cannot collect).\n          continue\n\n      # Use the first location found.\n      prim_pos = tuple(locs[0])\n\n      # Move to a free adjacent cell.\n      cur_pos = _move_to_adjacent(prim_pos)\n\n      # Face the primitive.\n      _face_towards(cur_pos, prim_pos)\n\n      # Pick up the required amount.\n      actions.extend([USE] * needed)\n\n      # Update blocked map \u2013 after picking up the primitive the cell becomes empty.\n      blocked[prim_pos] = False\n\n  # --------------------------------------------------------------\n  # Move to the workshop and craft the final item.\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  if workshop_name is not None:\n      # Resolve workshop index (could be already an int).\n      if isinstance(workshop_name, int):\n          workshop_idx = workshop_name\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_name)\n\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              ws_pos = tuple(ws_locs[0])\n              cur_pos = _move_to_adjacent(ws_pos)\n              _face_towards(cur_pos, ws_pos)\n\n  # Finally use the workshop (or current cell) to craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:20:06.272530", "function_name": "make_arrow", "function_body": "  # Retrieve action indices from the environment\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Determine the goal index (the item we need to make)\n  # ------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      # fall back to looking up by name\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception as e:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'\") from e\n\n  # ------------------------------------------------------------------\n  # Get the primitive requirements for the goal (expanded to raw items)\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Helper to move from the current position to a target cell using\n  # Manhattan moves (no path\u2011finding \u2013 assumes open space).\n  # ------------------------------------------------------------------\n  def _move_to(target, cur_pos, action_list):\n      \"\"\"Append actions that move from cur_pos to target, return new pos.\"\"\"\n      x, y = cur_pos\n      tx, ty = target\n      # Move in x direction\n      while x < tx:\n          action_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          action_list.append(LEFT)\n          x -= 1\n      # Move in y direction\n      while y < ty:\n          action_list.append(DOWN)\n          y += 1\n      while y > ty:\n          action_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # Find any cell that currently contains this primitive\n      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # Primitive not present on the map \u2013 cannot collect; skip\n          continue\n      # Choose the first occurrence as the target\n      target = tuple(locations[0])\n      cur_pos = _move_to(target, cur_pos, actions)\n      # Pick up the required amount (one USE per unit)\n      for _ in range(needed):\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  # Recipe may store workshop name under \"_key\" or \"_at\"\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name is not None:\n      # workshop_name may already be an index or a string name\n      if isinstance(workshop_name, int):\n          workshop_idx = workshop_name\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_name)\n\n  if workshop_idx is not None:\n      ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_pos = tuple(ws_locs[0])\n          cur_pos = _move_to(ws_pos, cur_pos, actions)\n\n  # Use the workshop (or current cell) to perform the crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:20:24.684611", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the initial state and world reference\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Action constants as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell (Manhattan distance) containing a kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Helper: generate a Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      # Arrow not defined in the recipe file\n      return []\n\n  # ------------------------------------------------------------------\n  # Compute primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting required counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return action_seq\n          # Move to the primitive location\n          for a in _path(state.pos, target):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n          # Pick it up\n          _, _, _ = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, go there before crafting\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              _, _, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n\n  # ------------------------------------------------------------------\n  # Final craft action (USE) at current location (workshop or open ground)\n  # ------------------------------------------------------------------\n  _, _, _ = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:20:25.806420", "function_name": "make_arrow", "function_body": "  # reset environment and get initial references\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # action indices as defined in CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # helper: locate the nearest cell (Manhattan distance) containing a kind\n  # ------------------------------------------------------------------\n  def _find_nearest(grid, kind_idx, start_pos):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start_pos[0]) + abs(j - start_pos[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _find_any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # helper: generate a Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # identify the goal item (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      # unknown goal \u2013 nothing to do\n      return []\n\n  # ------------------------------------------------------------------\n  # primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # collect each required primitive (respecting required counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          target = _find_nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive missing \u2013 abort early\n              return action_seq\n          # move to the primitive location\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # if the recipe specifies a workshop, go there before crafting\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _find_any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n\n  # ------------------------------------------------------------------\n  # final craft action (USE) at current location (workshop or open ground)\n  # ------------------------------------------------------------------\n  reward, done, obs = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:25:48.461391", "function_name": "make_arrow", "function_body": "  # Constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def _path(src, dst):\n      \"\"\"Manhattan path from src to dst as a list of actions.\"\"\"\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  def _nearest(grid, kind_idx, start):\n      \"\"\"Find nearest cell (Manhattan) containing the given kind.\"\"\"\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  def _any(grid, kind_idx):\n      \"\"\"Return any cell containing the given kind (used for workshops).\"\"\"\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Action execution wrappers that record actions\n  # ----------------------------------------------------------------------\n  action_seq = []\n\n  def _step(action):\n      \"\"\"Execute an action, record it, and update the local state.\"\"\"\n      nonlocal state\n      reward, done, obs = env.step(action)\n      state = env._current_state\n      action_seq.append(action)\n      return reward, done, obs\n\n  def _move_to(target):\n      \"\"\"Move from current position to target cell using Manhattan steps.\"\"\"\n      for a in _path(state.pos, target):\n          _, done, _ = _step(a)\n          if done:\n              return True\n      return False\n\n  def _use():\n      \"\"\"Perform USE action.\"\"\"\n      _, done, _ = _step(USE)\n      return done\n\n  # ----------------------------------------------------------------------\n  # Initialise environment and retrieve world information\n  # ----------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index for the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []  # Arrow not defined in the recipe set\n\n  # ----------------------------------------------------------------------\n  # Recursive acquisition / crafting routine\n  # ----------------------------------------------------------------------\n  primitives_set = world.cookbook.primitives\n\n  def _ensure(item_idx, needed):\n      \"\"\"Make sure the inventory contains at least `needed` of `item_idx`.\"\"\"\n      while state.inventory[item_idx] < needed:\n          # Primitive handling: just collect from the map\n          if item_idx in primitives_set:\n              target = _nearest(state.grid, item_idx, state.pos)\n              if target is None:\n                  # Primitive not present \u2013 cannot continue\n                  return False\n              _move_to(target)\n              _use()\n              continue\n\n          # Non\u2011primitive: need to craft it using its recipe\n          recipe = world.cookbook.recipes.get(item_idx, {})\n          # First, gather all ingredient items\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              # Ensure we have enough of each ingredient\n              if not _ensure(ing_idx, cnt):\n                  return False\n\n          # Move to the required workshop (if any) before crafting\n          workshop_name = recipe.get(\"_at\", None)\n          if workshop_name is not None:\n              workshop_idx = world.cookbook.index.index(workshop_name)\n              workshop_pos = _any(state.grid, workshop_idx)\n              if workshop_pos is not None:\n                  _move_to(workshop_pos)\n\n          # Craft the item\n          _use()\n      return True\n\n  # ----------------------------------------------------------------------\n  # Execute the plan to obtain a single arrow\n  # ----------------------------------------------------------------------\n  _ensure(arrow_idx, 1)\n\n  return action_seq", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:25:49.781503", "function_name": "make_arrow", "function_body": "  # Action constants (match CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # --------------------------------------------------------------\n  # Helper: BFS shortest path avoiding non\u2011grabbable entities\n  # --------------------------------------------------------------\n  def _bfs_path(src, dst, grid):\n      h, w, _ = grid.shape\n      blocked = env.world.non_grabbable_indices\n      # a cell is blocked if any non\u2011grabbable kind is present (>0)\n      def is_free(r, c):\n          if not (0 <= r < h and 0 <= c < w):\n              return False\n          return not any(grid[r, c, k] > 0 for k in blocked)\n\n      from collections import deque\n      q = deque()\n      q.append(src)\n      visited = {src: None}\n      while q:\n          r, c = q.popleft()\n          if (r, c) == dst:\n              break\n          for dr, dc, act in DIRS:\n              nr, nc = r + dr, c + dc\n              if (nr, nc) not in visited and is_free(nr, nc):\n                  visited[(nr, nc)] = (r, c, act)\n                  q.append((nr, nc))\n      # reconstruct actions\n      if dst not in visited:\n          return []  # no path found\n      actions = []\n      cur = dst\n      while visited[cur] is not None:\n          pr, pc, act = visited[cur]\n          actions.append(act)\n          cur = (pr, pc)\n      actions.reverse()\n      return actions\n\n  # --------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind (Manhattan)\n  # --------------------------------------------------------------\n  def _nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # --------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # --------------------------------------------------------------\n  def _any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # --------------------------------------------------------------\n  # Initialise episode\n  # --------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify goal index for \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # arrow not defined in recipes\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # --------------------------------------------------------------\n  # Collect required primitives (respecting counts)\n  # --------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = _nearest(state.grid, prim_idx, state.pos)\n          if target is None:\n              # primitive missing \u2013 abort early\n              return action_seq\n          # Move to the primitive cell using BFS path\n          for a in _bfs_path(state.pos, target, state.grid):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick up the primitive\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # --------------------------------------------------------------\n  # Craft the arrow (possibly at a workshop)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _bfs_path(state.pos, workshop_pos, state.grid):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Perform crafting at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n  else:\n      # No specific workshop \u2013 craft in place\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 14, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:26:19.882235", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action constants as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # make a mutable copy for planning\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable\n      obstacles. ``start`` and ``goal`` are (y, x) tuples.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions_rev = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      actions_rev.append(DOWN)\n                  elif py == cur[0] + 1:\n                      actions_rev.append(UP)\n                  elif px == cur[1] - 1:\n                      actions_rev.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # block movement if any non\u2011grabbable entity occupies the cell\n                  if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen for valid scenarios)\n      return []\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop)\n      relative to ``from_pos``. Returns (y, x) or None.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Identify goal and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using\n          adj = None\n          neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          for ny, nx in neighbours:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell itself\n              adj = target\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a movement action that will be blocked)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update our planning grid to reflect that the primitive has been taken\n          grid[ty, tx, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:26:21.005312", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (as defined by CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable\n      obstacles. ``start`` and ``goal`` are (y, x) tuples.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions_rev = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      actions_rev.append(DOWN)\n                  elif py == cur[0] + 1:\n                      actions_rev.append(UP)\n                  elif px == cur[1] - 1:\n                      actions_rev.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # cell is blocked if any non\u2011grabbable entity occupies it\n                  if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen for valid tasks)\n      return []\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Return the coordinates (y, x) of the nearest cell that contains\n      ``cell_kind`` (primitive or workshop). If none exists, return None.\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow' and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the appropriate number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using\n          adj = None\n          neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          for ny, nx in neighbours:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; fallback to the primitive cell itself\n              adj = target\n\n          # Move to the chosen adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a movement action that will be blocked)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
