{"timestamp": "2025-10-28T21:14:16.976640", "function_name": "make_arrow", "function_body": "  # ----- helpers -------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, grid):\n      \"\"\"Return a list of actions moving from *start* to a cell adjacent to any target.\"\"\"\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # any non\u2011zero kind blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # no reachable position\n      return []\n\n  def _apply_path(pos, path):\n      \"\"\"Update (x, y) position by applying a sequence of actions.\"\"\"\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # ----- locate world / cookbook --------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # some wrappers expose the world via the current state\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # ----- ensure a fresh state -----------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ----- goal information ----------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not defined in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ----- planning state -------------------------------------------\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()              # mutable copy for planning\n  actions = []\n  harvested = set()                     # cells already used for collection\n\n  # ----- collect required primitives -------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      while collected < needed:\n          # locate all remaining cells containing this primitive\n          candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                        if tuple(p) not in harvested]\n          if not candidates:\n              # no more visible primitives \u2013 stop trying\n              break\n          # pick the nearest candidate\n          candidates.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = candidates[0]\n\n          # move adjacent to the primitive\n          path = _bfs_path(pos, [target], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n\n          # pick it up\n          actions.append(USE)\n          # update planning structures\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n          collected += 1\n\n  # ----- go to workshop (if required) -----------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (could be name or int)\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # choose nearest workshop\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = workshop_cells[0]\n          path = _bfs_path(pos, [ws_target], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n          actions.append(USE)   # craft at the workshop\n      else:\n          # workshop not visible \u2013 just try to craft where we are\n          actions.append(USE)\n  else:\n      # no specific workshop required\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:14:18.128581", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices as defined in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def bfs_path(start, targets, grid):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any target.\"\"\"\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def apply_path(pos, path):\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate world and cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # Goal item name.\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements.\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)\n  grid = state.grid.copy()   # planning copy\n\n  actions = []\n  harvested = set()          # cells already collected\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      collected = 0\n      while collected < needed:\n          candidates = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n                        if tuple(p) not in harvested]\n          if not candidates:\n              break\n          candidates.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          target = candidates[0]\n\n          path = bfs_path(pos, [target], grid)\n          actions.extend(path)\n          pos = apply_path(pos, path)\n\n          actions.append(USE)\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          ws_target = workshop_cells[0]\n          path = bfs_path(pos, [ws_target], grid)\n          actions.extend(path)\n          pos = apply_path(pos, path)\n          actions.append(USE)\n      else:\n          actions.append(USE)\n  else:\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:14:45.360948", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index for the target item (\"arrow\")\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to hash a state for visited\u2011set tracking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long sequences\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # If no plan found within limits, return an empty list\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:15:01.061237", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:15:27.008590", "function_name": "make_arrow", "function_body": "  # reset environment and get current state\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # action indices (consistent with CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      visited = set([start])\n      parent = {}\n      q = deque([start])\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # no path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of ``cell`` (or None).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  collected = set()\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive missing; abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; cannot safely collect \u2013 abort\n              return actions\n\n          # Move to that adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (blocked move to set direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = ws_cell  # fallback: stand on the workshop cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:15:28.150563", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices (as defined by CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions that avoids blocked cells.\"\"\"\n      if start == goal:\n          return []\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      parent = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited[ny, nx] = True\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      return []  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of ``cell`` not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  collected = set()\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions  # primitive not present; abort\n\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # If no free neighbour, stand on the primitive cell itself\n              adj = target\n\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (use a blocked move to set direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:15:56.831598", "function_name": "make_arrow", "function_body": "  import numpy as np, collections\n\n  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, grid):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any target.\"\"\"\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)  # any non\u2011zero kind blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def _apply_path(pos, path):\n      \"\"\"Update a (x, y) position by applying a sequence of actions.\"\"\"\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate world and cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Determine goal index for 'arrow'.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # ------------------------------------------------------------------\n  # Primitive requirements.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable planning grid\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All locations containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n\n          # Pick it up.\n          actions.append(USE)\n          # Update planning grid.\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft at required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index.\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n          actions.append(USE)\n      else:\n          # No visible workshop \u2013 attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:15:57.955749", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action enums as defined in CraftWorld.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, grid):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any target.\"\"\"\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)  # any non\u2011zero kind blocks movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop when adjacent to a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # unreachable\n\n  def _apply_path(pos, path):\n      \"\"\"Update (x, y) according to a sequence of movement actions.\"\"\"\n      x, y = pos\n      for act in path:\n          if act == RIGHT:\n              x += 1\n          elif act == LEFT:\n              x -= 1\n          elif act == DOWN:\n              y += 1\n          elif act == UP:\n              y -= 1\n      return (x, y)\n\n  # ----------------------------------------------------------------------\n  # Locate the world and cookbook objects inside the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Determine the goal index for the item named \"arrow\".\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Retrieve primitive requirements for the goal.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Ensure we have a valid state (reset if the wrapper does not expose one).\n  # ----------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from the current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          grid[loc[0], loc[1], prim_idx] = 0   # cell becomes empty\n          harvested.add(loc)\n          collected += 1\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          pos = _apply_path(pos, path)\n          actions.append(USE)   # craft at the workshop\n      else:\n          # No visible workshop; attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required; simply use to craft.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:16:26.901824", "function_name": "make_arrow", "function_body": "  # Obtain scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000                     # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:16:42.946116", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  n_actions = getattr(world, \"n_actions\", 5)\n  MAX_STEPS = 2000  # safety limit for plan length\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:17:09.888172", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_LEN = 400                # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", goal_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_LEN:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:17:25.630374", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index corresponding to the target item \"arrow\"\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper function to create a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Safety limits for the search\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", goal_idx):\n          return node.actions\n\n      # Prune overly long action sequences\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions from the current state\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # If no plan was found within the limits, return an empty list\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:18:02.577920", "function_name": "make_arrow", "function_body": "  # Extract scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Identify the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Helper to create a hashable representation of a CraftState\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 actions (0\u20114)\n\n  # Prefer the USE action (index 4 if present) before movement actions\n  use_idx = 4 if n_actions > 4 else 0\n  action_order = [use_idx] + [a for a in range(n_actions) if a != use_idx]\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand actions in the chosen order\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:18:18.420363", "function_name": "make_arrow", "function_body": "  # Locate the scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Helper to produce a hashable representation of a CraftState\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000  # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (usually index 4) before movement actions\n  action_order = [4] + [a for a in range(n_actions) if a != 4]\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand actions in the chosen order\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:18:32.968289", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-28T21:18:34.081297", "function_name": "make_arrow", "function_body": "  # Resolve world and target index\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import namedtuple\n  import heapq\n  import numpy as np\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\", \"cost\"])\n\n  # Helper: hash a state for visited checking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  # Pre\u2011compute primitive requirements for the goal\n  primitives_needed = world.cookbook.primitives_for(target_idx)  # {kind_idx: count}\n  # If the goal has no recipe (i.e., is primitive) we still treat it as a craft\n  # that may be obtained by simply picking it up.\n  if not primitives_needed:\n      primitives_needed = {target_idx: 1}\n\n  # Heuristic: sum of Manhattan distances to the nearest needed primitive that we\n  # still lack (ignoring obstacles). If a needed primitive is not present on the\n  # grid we give a large penalty.\n  def heuristic(st):\n      pos = np.array(st.pos)\n      missing = 0\n      total_dist = 0\n      for kind, cnt in primitives_needed.items():\n          have = st.inventory[kind]\n          need = max(0, cnt - have)\n          if need == 0:\n              continue\n          # locate all cells containing this kind\n          locations = np.argwhere(st.grid[:, :, kind] > 0)\n          if locations.size == 0:\n              # primitive not currently on the map \u2013 give a penalty\n              total_dist += 10 * need\n              missing += need\n          else:\n              # compute Manhattan distance to the closest instance\n              dists = np.abs(locations - pos).sum(axis=1)\n              total_dist += dists.min() * need\n              missing += need\n      # add a small cost for the eventual crafting action(s)\n      return total_dist + missing\n  # Priority queue for A* (cost = g + h)\n  frontier = []\n  start_node = Node(init_state, [], 0)\n  heapq.heappush(frontier, (heuristic(init_state), start_node))\n\n  visited = {_state_hash(init_state)}\n  MAX_STEPS = 400\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      _, node = heapq.heappop(frontier)\n      cur_state = node.state\n\n      # Goal test\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand successors\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h in visited:\n              continue\n          visited.add(h)\n          g = len(node.actions) + 1\n          f = g + heuristic(nxt_state)\n          heapq.heappush(frontier, (f, Node(nxt_state, node.actions + [a], g)))\n\n  # No plan found within budget\n  return []", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-28T21:19:00.836432", "function_name": "make_arrow", "function_body": "  # Reset the environment and get the current state\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Mapping from movement delta to action\n  DIRS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  from collections import deque\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helper: BFS shortest path avoiding non\u2011grabbable entities\n  # ------------------------------------------------------------------\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal.\"\"\"\n      if start == goal:\n          return []\n\n      W, H = grid.shape[0], grid.shape[1]\n      blocked = list(world.non_grabbable_indices)\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}                     # (y,x) -> (prev_y, prev_x, action)\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if not (0 <= ny < W and 0 <= nx < H):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              # cell is blocked if any non\u2011grabbable kind occupies it\n              if blocked and np.any(grid[ny, nx, blocked] > 0):\n                  continue\n              visited[ny, nx] = True\n              prev[(ny, nx)] = (y, x, act)\n              if (ny, nx) == goal:\n                  # reconstruct path\n                  actions = []\n                  cur = (ny, nx)\n                  while cur != start:\n                      py, px, a = prev[cur]\n                      actions.append(a)\n                      cur = (py, px)\n                  actions.reverse()\n                  return actions\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind index\n  # ------------------------------------------------------------------\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return (y,x) of the closest cell that currently holds kind_idx.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # ------------------------------------------------------------------\n  # Determine the goal item ('arrow') and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  primitive_reqs = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_reqs.items():\n      for _ in range(needed):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # required primitive not present; abort early\n              return actions\n\n          # Move to the primitive cell\n          actions += bfs_path(cur_pos, target)\n          cur_pos = target\n\n          # Pick it up\n          actions.append(USE)\n\n          # Update planning grid so we don't try to collect the same instance again\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting (at current location or workshop)\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T21:19:01.981657", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIR_MAP = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[0], grid.shape[1]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any non\u2011grabbable entity occupies it.\"\"\"\n      # world.non_grabbable_indices is a set of kind ids that cannot be stepped on\n      if not world.non_grabbable_indices:\n          return False\n      ng = list(world.non_grabbable_indices)\n      return np.any(grid[y, x, ng] > 0)\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  dy, dx = cur[0] - py, cur[1] - px\n                  rev.append(DIR_MAP[(dy, dx)])\n                  cur = (py, px)\n              rev.reverse()\n              return rev\n          for dy, dx in DIR_MAP:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # no path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return coordinates of the closest cell containing `kind_idx`.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return (int(nearest[0]), int(nearest[1]))\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of `cell` not in `avoid`.\"\"\"\n      y, x = cell\n      for dy, dx in DIR_MAP:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count in primitive_needs.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive missing; abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          stand = adjacent_free(target, avoid=set())\n          if stand is None:\n              # If no free neighbour, stand on the primitive cell itself\n              stand = target\n\n          # Move to the chosen standing cell\n          actions += bfs_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (optional but helps deterministic USE)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if (dy, dx) in DIR_MAP:\n              actions.append(DIR_MAP[(dy, dx)])\n              cur_pos = (cur_pos[0] + dy, cur_pos[1] + dx)  # update direction only; position unchanged\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid: primitive is removed\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand next to workshop if possible\n          ws_adj = adjacent_free(ws_cell, avoid=set())\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if (dy, dx) in DIR_MAP:\n              actions.append(DIR_MAP[(dy, dx)])\n\n  # Final USE to trigger crafting (whether at workshop or anywhere if no workshop)\n  actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T21:19:27.471809", "function_name": "make_arrow", "function_body": "  # reset environment and get handles\n  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n\n  # action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # indices that block movement\n  non_grabbable = list(world.non_grabbable_indices)\n\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return list of movement actions from start to goal avoiding non\u2011grabbable cells.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.zeros((H, W), dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions = []\n              cur = goal\n              while cur != start:\n                  py, px = prev[cur]\n                  dy, dx = cur[0] - py, cur[1] - px\n                  if dy == 1:\n                      actions.append(DOWN)\n                  elif dy == -1:\n                      actions.append(UP)\n                  elif dx == 1:\n                      actions.append(RIGHT)\n                  elif dx == -1:\n                      actions.append(LEFT)\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n          for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  if np.any(grid[ny, nx, non_grabbable] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      return []  # no path found\n\n  def nearest(kind, from_pos):\n      \"\"\"Coordinates of nearest cell containing given kind.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  # goal index and required primitives\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)  # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # collect primitives\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions\n          ty, tx = target\n\n          # choose free adjacent cell to stand on\n          adj = None\n          for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not np.any(grid[ny, nx, non_grabbable] > 0):\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              adj = (ty, tx)\n\n          actions += bfs(cur_pos, adj)\n          cur_pos = adj\n\n          # face the primitive\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # pick up\n          actions.append(USE)\n\n          # update bookkeeping grid\n          grid[ty, tx, prim_idx] = 0\n\n  # move to workshop if required\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # craft arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:19:28.650508", "function_name": "make_arrow", "function_body": "  # Reset environment and extract underlying objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for bookkeeping\n\n  # Action indices according to the environment's spec\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Indices that block movement (non\u2011grabbable entities)\n  non_grab = list(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions that moves the agent from\n      ``start`` to ``goal`` while avoiding occupied or non\u2011grabbable cells.\n      The goal cell itself is allowed even if it is occupied (used for\n      reaching a workshop).\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}                     # maps cell -> previous cell\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              actions = []\n              cur = goal\n              while cur != start:\n                  py, px = prev[cur]\n                  dy, dx = cur[0] - py, cur[1] - px\n                  if dy == 1:\n                      actions.append(DOWN)\n                  elif dy == -1:\n                      actions.append(UP)\n                  elif dx == 1:\n                      actions.append(RIGHT)\n                  elif dx == -1:\n                      actions.append(LEFT)\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n\n          for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # Goal cell may be occupied (e.g., workshop)\n                  if (ny, nx) != goal:\n                      # block if any non\u2011grabbable entity occupies the cell\n                      if np.any(grid[ny, nx, non_grab] > 0):\n                          continue\n                      # block if any entity occupies the cell\n                      if np.any(grid[ny, nx, :] > 0):\n                          continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen for valid tasks)\n      return []\n\n  def nearest_cell(kind_idx, from_pos):\n      \"\"\"Find the coordinates of the nearest cell containing ``kind_idx``.\n      Returns None if the kind does not appear on the grid.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def empty_adjacent(pos):\n      \"\"\"Return an empty neighbour of ``pos`` (or None).\"\"\"\n      y, x = pos\n      H, W = grid.shape[:2]\n      for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1)):\n          ny, nx = y + dy, x + dx\n          if 0 <= ny < H and 0 <= nx < W:\n              # cell must be completely empty (no entities)\n              if not np.any(grid[ny, nx, :] > 0):\n                  return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest_cell(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort planning.\n              return actions\n\n          # Choose a free adjacent cell to stand on (fallback to the target cell itself)\n          adj = empty_adjacent(target)\n          if adj is None:\n              adj = target\n\n          # Move to the chosen adjacent cell\n          actions += bfs(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a move that would be blocked if adjacent)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update bookkeeping grid (primitive removed)\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = nearest_cell(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE triggers crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 33, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:20:12.942191", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n\n  # action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def bfs_to_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from `start` to a cell adjacent to any\n      target in `targets`. `occupied` is a 2\u2011D boolean array where True means\n      the cell cannot be entered.\"\"\"\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # explore neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Locate world and cookbook objects \u2013 they may be stored in different\n  # attributes depending on the environment wrapper.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      wrapper = getattr(env, \"_current_state\", None)\n      if wrapper is not None:\n          world = getattr(wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal identification (hard\u2011coded to 'arrow').\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements (recursive expansion to base resources)\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Planning copies of position and grid.\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # (W, H, n_kinds)\n  occupied = np.any(grid, axis=2)      # 2\u2011D bool mask of blocked cells\n\n  plan = []\n  used_cells = set()                   # primitives already taken\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # locate all cells that currently contain this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # greedy order: nearest first\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed:\n              break\n          if cell in used_cells:\n              continue\n          # move adjacent to the primitive\n          path = bfs_to_adjacent(pos, [cell], occupied)\n          plan.extend(path)\n          # update position following the path\n          for a in path:\n              if a == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif a == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif a == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif a == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # pick it up\n          plan.append(USE)\n\n          # mark cell empty for future planning\n          grid[cell[0], cell[1], prim_idx] = 0\n          occupied = np.any(grid, axis=2)\n          used_cells.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (may be string or already int)\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = bfs_to_adjacent(pos, [target_ws], occupied)\n          plan.extend(path)\n          for a in path:\n              if a == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif a == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif a == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif a == UP:\n                  pos = (pos[0], pos[1] - 1)\n          plan.append(USE)\n      else:\n          # workshop not visible \u2013 attempt crafting where we stand\n          plan.append(USE)\n  else:\n      # no specific workshop required\n      plan.append(USE)\n\n  return plan", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:20:14.077949", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_adjacent(start, targets, blocked):\n      \"\"\"Return a list of actions moving from start to a cell adjacent to any target.\"\"\"\n      w, h = blocked.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          # check adjacency\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # expand neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # no path found\n\n  def _apply_actions(pos, actions):\n      \"\"\"Update a (x, y) position by sequentially applying actions.\"\"\"\n      x, y = pos\n      for a in actions:\n          if a == RIGHT:\n              x += 1\n          elif a == LEFT:\n              x -= 1\n          elif a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Locate world and cookbook (may be stored in different places)\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"CraftWorld instance not found in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Goal identification (hard\u2011coded to 'arrow')\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' is not defined in the recipe file.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitives required for the arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Working copies for planning\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # (W, H, n_kinds)\n  blocked = np.any(grid, axis=2)       # True where any entity occupies the cell\n\n  plan = []            # list of action indices to return\n  harvested = set()    # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive\n      cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position (greedy nearest first)\n      cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n      collected = 0\n      for cell in cells:\n          if collected >= needed:\n              break\n          if cell in harvested:\n              continue\n          # Move adjacent to the primitive\n          path = _bfs_adjacent(pos, [cell], blocked)\n          plan.extend(path)\n          pos = _apply_actions(pos, path)\n\n          # Pick it up\n          plan.append(USE)\n\n          # Update planning structures\n          grid[cell[0], cell[1], prim_idx] = 0\n          blocked = np.any(grid, axis=2)\n          harvested.add(cell)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name)\n      ws_idx = (cookbook.index[workshop_key]\n                if isinstance(workshop_key, str) else int(workshop_key))\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = _bfs_adjacent(pos, [target_ws], blocked)\n          plan.extend(path)\n          pos = _apply_actions(pos, path)\n          plan.append(USE)\n      else:\n          # No visible workshop; attempt to craft at current location\n          plan.append(USE)\n  else:\n      # No specific workshop required; simply use to craft\n      plan.append(USE)\n\n  return plan", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:20:39.508584", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # index of the goal item \"arrow\"\n  goal_idx = world.cookbook.index.index(\"arrow\")\n  if goal_idx == 0:\n      return []  # arrow not present in this world\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of movement actions which end with the\n  # agent facing a cell that contains `target_kind`. Returns None if\n  # no such position exists.\n  # ------------------------------------------------------------------\n  def _bfs_to_face(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      # action \u2192 (dx, dy)\n      deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, path = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return path\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine primitive resources required for a single arrow.\n  # If the recipe dict is empty, treat the arrow itself as a primitive.\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(goal_idx)\n  if not needed:\n      needed = {goal_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_face(state, prim_idx)\n          if move_seq is None:\n              # unreachable primitive \u2013 abort planning\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its workshop (if any) or in place.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_face(state, workshop_idx)\n      if move_seq is None:\n          actions.append(4)\n          _, state = state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n  else:\n      actions.append(4)  # USE to craft in place\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:20:40.651775", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state/world references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\". If not present, return.\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  if goal_idx == 0:\n      return []   # arrow not defined in this world\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) which\n  # position the agent so that the cell directly in front contains\n  # `target_kind`. Returns None if unreachable.\n  # ------------------------------------------------------------------\n  def _bfs_to_face(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      # Action \u2192 (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)\n      deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          # walkable iff inside bounds and no entity occupies the cell\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, path = q.popleft()\n          # Check the cell directly in front of the agent\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return path\n          # Explore four movement actions\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # If the recipe dict is empty, treat the arrow itself as primitive.\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n  if not primitive_needs:\n      primitive_needs = {goal_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_face(state, prim_idx)\n          if move_seq is None:\n              # Primitive unreachable \u2013 abort planning and return what we have.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)          # USE action to pick up / interact\n          # Apply the actions to keep the internal state up\u2011to\u2011date.\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its workshop (if any) or directly with USE.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_face(state, workshop_idx)\n      if move_seq is None:\n          # Workshop unreachable \u2013 still try a USE (will simply do nothing).\n          actions.append(4)\n          _, state = state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)          # USE to craft at the workshop\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n  else:\n      # No specific workshop required.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:21:04.311478", "function_name": "make_arrow", "function_body": "  # Reset environment and grab useful references\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def delta_to_action(dy, dx):\n      \"\"\"Convert a unit delta into the corresponding action.\"\"\"\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      raise ValueError(\"Non\u2011unit delta\")\n\n  def bfs_path(start, goal):\n      \"\"\"Bread\u2011first search on the static map (ignores dynamic inventory).\n      Returns a list of actions that move from *start* to *goal*.\n      Cells containing any *non\u2011grabbable* entity are treated as obstacles.\"\"\"\n      H, W = grid.shape[:2]\n      q = collections.deque()\n      q.append(start)\n      visited = {start: None}          # map position -> (prev_pos, action)\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              break\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              if not (0 <= ny < H and 0 <= nx < W):\n                  continue\n              # block if any non\u2011grabbable entity occupies the cell\n              if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                  continue\n              if (ny, nx) not in visited:\n                  visited[(ny, nx)] = ((y, x), delta_to_action(dy, dx))\n                  q.append((ny, nx))\n\n      # reconstruct path\n      if goal not in visited:\n          return []          # unreachable \u2013 return empty path\n      actions_rev = []\n      cur = goal\n      while visited[cur] is not None:\n          prev, act = visited[cur]\n          actions_rev.append(act)\n          cur = prev\n      actions_rev.reverse()\n      return actions_rev\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell that contains *kind_idx* (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def choose_adjacent(target, cur):\n      \"\"\"Pick a free neighbour of *target* to stand on.\n      Preference order: above, below, left, right. If none free, return the target itself.\"\"\"\n      ty, tx = target\n      H, W = grid.shape[:2]\n      for ny, nx, facing in [\n          (ty - 1, tx, DOWN),   # stand above, face downwards\n          (ty + 1, tx, UP),     # stand below, face upwards\n          (ty, tx - 1, RIGHT),  # stand left, face rightwards\n          (ty, tx + 1, LEFT)    # stand right, face leftwards\n      ]:\n          if 0 <= ny < H and 0 <= nx < W:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx, facing)\n      # fallback: stand on the primitive cell itself (no specific facing)\n      return (ty, tx, None)\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for an ``arrow``\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required_prims.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose where to stand before using.\n          stand_y, stand_x, facing = choose_adjacent(target, cur_pos)\n\n          # Move to the chosen standing cell.\n          actions += bfs_path(cur_pos, (stand_y, stand_x))\n          cur_pos = (stand_y, stand_x)\n\n          # If we need a specific facing direction, issue a turn action.\n          if facing is not None:\n              actions.append(facing)   # turn without moving (blocked move)\n\n          # Use action to pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:21:05.475043", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Action indices (standard ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions that walk from ``start`` to ``goal``.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine required primitives for the goal item ('arrow')\n  # ------------------------------------------------------------------\n  goal_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # current (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on (prefer empty).\n          stand = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      stand = (ny, nx)\n                      break\n          if stand is None:\n              # No free neighbour; stand on the primitive cell itself.\n              stand = target\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (by moving towards it; direction changes even if blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:21:27.041174", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action identifiers \u2013 must match CraftWorld ordering.\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  def _bfs_adjacent(start, targets, occupied):\n      \"\"\"Return a list of actions moving from `start` to a cell adjacent to any `targets`.\"\"\"\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency to any target\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve the current state / world objects from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # env is likely a CraftLab \u2013 state stored in _current_state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      # env is a CraftWorld / CraftScenario \u2013 ensure we have a state.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is a primitive \u2013 just use (if a workshop is required it will be handled later).\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity occupies the cell\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells containing this primitive and not yet harvested.\n          cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not cells:\n              # No more of this primitive available \u2013 abort early.\n              break\n\n          # Choose the closest cell (Manhattan distance).\n          cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = cells[0]\n\n          # Plan a path to a cell adjacent to the target.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask \u2013 the cell becomes empty after pickup.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      )\n      ws_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if ws_cells:\n          # Choose nearest workshop.\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No visible workshop \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 craft wherever we are.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:21:28.169833", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action identifiers \u2013 must match CraftWorld ordering.\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {DOWN: (0, 1), UP: (0, -1), LEFT: (-1, 0), RIGHT: (1, 0)}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells occupied by any entity are treated as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited or occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Retrieve world, state and cookbook from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Likely a CraftLab wrapper.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow itself is a primitive \u2013 just use the current cell.\n      return [USE]\n\n  # ------------------------------------------------------------------\n  # Current grid, agent position and occupancy mask.\n  # ------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # locations already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Find all cells containing this primitive that haven't been used.\n          prim_cells = [\n              tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)\n              if tuple(p) not in harvested\n          ]\n          if not prim_cells:\n              # No more of this primitive on the map \u2013 abort early.\n              break\n\n          # Choose the closest primitive (Manhattan distance).\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to keep `pos` up\u2011to\u2011date.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Cell becomes empty after pickup \u2013 update occupancy mask.\n          occupied[target] = False\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or already an int).\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str) else workshop_key\n      )\n      workshop_cells = [\n          tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)\n      ]\n      if workshop_cells:\n          # Move to the nearest workshop.\n          workshop_cells.sort(\n              key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1])\n          )\n          ws_target = workshop_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)  # craft at workshop\n      else:\n          # No visible workshop \u2013 just use the current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:21:52.677037", "function_name": "make_arrow", "function_body": "  # Get scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      # inventory and grid are numpy arrays; use bytes for compact hashing\n      inv_bytes = st.inventory.tobytes()\n      grid_bytes = st.grid.tobytes()\n      return (st.pos, st.dir, inv_bytes, grid_bytes)\n\n  # BFS setup\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LEN = 500                     # safety cutoff\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur = node.state\n\n      # Goal test: have at least one arrow\n      if cur.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt = cur.step(a)\n          key = _state_key(nxt)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:22:08.441146", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 600                       # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:22:41.695165", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # make a mutable copy\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any kind occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # no path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing the given kind.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return (int(nearest[0]), int(nearest[1]))\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of `cell` (or None).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)          # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                # (y, x)\n  taken_cells = set()                # primitives already collected\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive missing \u2013 give up\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=taken_cells)\n          if adj is None:\n              # fallback: stand on the primitive cell itself\n              adj = target\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (a blocked move changes direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick it up\n          actions.append(USE)\n\n          # Update internal grid and record that this cell is now empty\n          grid[target[0], target[1], prim_idx] = 0\n          taken_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=taken_cells)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:22:42.855286", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the underlying objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the current grid\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Helper utilities.\n  # ------------------------------------------------------------------\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def blocked(y, x):\n      \"\"\"A cell is blocked if any kind occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path (list of movement actions) from start to goal\n      avoiding blocked cells. Returns [] if no path exists.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      parent = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          cy, cx = cur\n          for dy, dx, act in DIRS:\n              ny, nx = cy + dy, cx + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in parent:\n                  continue\n              if blocked(ny, nx):\n                  continue\n              parent[(ny, nx)] = (cur, act)\n              q.append((ny, nx))\n      else:\n          return []  # no path found\n\n      # reconstruct actions\n      actions = []\n      node = goal\n      while parent[node] is not None:\n          prev, act = parent[node]\n          actions.append(act)\n          node = prev\n      return list(reversed(actions))\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return the coordinates of the closest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of ``cell`` (or None).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Goal information.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos            # (y, x)\n  collected = set()              # cells from which we already took a primitive\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (blocked move only changes direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid so the cell becomes free.\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional, for consistency).\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:23:07.474114", "function_name": "make_arrow", "function_body": "  import collections, numpy as np\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  def bfs(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n  def move(pos, act):\n      if act == RIGHT:\n          return (pos[0] + 1, pos[1])\n      if act == LEFT:\n          return (pos[0] - 1, pos[1])\n      if act == DOWN:\n          return (pos[0], pos[1] + 1)\n      if act == UP:\n          return (pos[0], pos[1] - 1)\n      return pos\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is not None:\n          world = state.world\n  if world is None:\n      raise RuntimeError(\"World not found\")\n  cookbook = world.cookbook\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  actions = []\n  harvested = set()\n  for prim_idx, needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = bfs(pos, [loc], grid)\n          actions.extend(path)\n          for act in path:\n              pos = move(pos, act)\n          actions.append(USE)\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      ws_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_cells[0]\n          path = bfs(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              pos = move(pos, act)\n          actions.append(USE)\n      else:\n          actions.append(USE)\n  else:\n      actions.append(USE)\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:23:08.598636", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T21:23:39.814577", "function_name": "make_arrow", "function_body": "  # Reset the environment and grab the current state/world.\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  # Work on a mutable copy of the grid for planning.\n  grid = state.grid.copy()\n\n  # Action indices used by CraftWorld (DOWN, UP, LEFT, RIGHT, USE).\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk\n      from ``start`` to ``goal`` using a simple Manhattan path.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell (y, x) that contains ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of ``cell`` (or None).\"\"\"\n      y, x = cell\n      candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return None\n\n  def direction_to(src, dst):\n      \"\"\"Return the action that makes the agent at ``src`` face ``dst``\n      (assuming they are orthogonally adjacent).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, need_cnt in needed_prims.items():\n      for _ in range(need_cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present on the map \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on; fall back to the primitive cell.\n          stand = free_adjacent(target) or target\n\n          # Move to the chosen standing position.\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (if we are not standing on it).\n          if stand != target:\n              turn = direction_to(cur_pos, target)\n              if turn is not None:\n                  actions.append(turn)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update planning grid so we don't try to pick the same item again.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:23:40.986048", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state/world information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action constants (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN:  (1, 0),\n      UP:    (-1, 0),\n      LEFT:  (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_free(y, x):\n      \"\"\"Return True if the cell (y, x) is traversable (no non\u2011grabbable entity).\"\"\"\n      if not (0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]):\n          return False\n      return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def bfs(start, goal, allow_goal_blocked=False):\n      \"\"\"\n      Bread\u2011first search from start to goal returning a list of movement actions.\n      If allow_goal_blocked is False the goal cell must also be free.\n      \"\"\"\n      from collections import deque\n      sy, sx = start\n      gy, gx = goal\n      if not allow_goal_blocked and not is_free(gy, gx):\n          return None\n\n      visited = set()\n      visited.add((sy, sx))\n      queue = deque()\n      queue.append((sy, sx, []))\n\n      while queue:\n          y, x, path = queue.popleft()\n          if (y, x) == (gy, gx):\n              return path\n          for act, (dy, dx) in MOVE_DELTAS.items():\n              ny, nx = y + dy, x + dx\n              if (0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and\n                      (ny, nx) not in visited and is_free(ny, nx)):\n                  visited.add((ny, nx))\n                  queue.append((ny, nx, path + [act]))\n      return None  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of `cell` (or None if none exists).\"\"\"\n      y, x = cell\n      for dy, dx in [( -1, 0), (1, 0), (0, -1), (0, 1)]:\n          ny, nx = y + dy, x + dx\n          if is_free(ny, nx):\n              return (ny, nx)\n      return None\n\n  def direction_to(src, dst):\n      \"\"\"Return the movement action that moves one step from src towards dst.\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1 and dx == 0:\n          return DOWN\n      if dy == -1 and dx == 0:\n          return UP\n      if dy == 0 and dx == 1:\n          return RIGHT\n      if dy == 0 and dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives for ``arrow``\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed_prims = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort planning.\n              return actions\n\n          # Choose a free adjacent cell to stand on; fall back to the primitive cell itself.\n          stand = free_adjacent(target) or target\n\n          # Plan a path to the chosen standing position.\n          path_to_stand = bfs(cur_pos, stand, allow_goal_blocked=False)\n          if path_to_stand is None:\n              # No reachable path \u2013 abort.\n              return actions\n          actions.extend(path_to_stand)\n          cur_pos = stand\n\n          # Face the primitive (optional but helpful for USE).\n          turn = direction_to(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n              # Update current position if the turn action actually moves onto the primitive.\n              dy, dx = MOVE_DELTAS[turn]\n              cur_pos = (cur_pos[0] + dy, cur_pos[1] + dx)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Mark the primitive as collected in the planning grid.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          path_to_ws = bfs(cur_pos, ws_cell, allow_goal_blocked=False)\n          if path_to_ws is not None:\n              actions.extend(path_to_ws)\n              cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:24:11.801157", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper to safely obtain the world and scenario objects\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Identify the target item (\"arrow\") index in the cookbook\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:          # recipe missing or typo\n      return []\n\n  # ----------------------------------------------------------------------\n  # Get the initial state of the episode (grid, position, direction, etc.)\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Breadth\u2011first search over the (state, action\u2011sequence) space.\n  # The state space is huge but the built\u2011in CraftWorld dynamics are\n  # deterministic and the number of meaningful actions is tiny\n  # (4 moves + USE).  We therefore keep a visited set based on a compact\n  # hash of the full state (position, direction, inventory, grid bytes).\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Return a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,                     # (x, y) tuple\n          st.dir,                     # facing direction 0\u20113\n          tuple(st.inventory.tolist()),  # inventory counts\n          st.grid.tobytes(),          # raw grid contents\n      )\n\n  visited = set()\n  start_hash = _state_hash(init_state)\n  visited.add(start_hash)\n\n  frontier = deque([Node(init_state, [])])\n\n  # Upper bound on plan length \u2013 prevents infinite search on pathological maps\n  MAX_STEPS = 2000\n\n  # Number of primitive actions the environment supports (normally 5)\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  # Prefer the USE action (index 4) before movement to speed up crafting.\n  # If the environment defines fewer actions we simply iterate over all.\n  if n_actions > 4:\n      action_order = [4, 0, 1, 2, 3]\n  else:\n      action_order = list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune paths that are already too long\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand successors\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)      # reward is always 0.0 here\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If we exit the loop no plan was found within the limits.\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:24:27.520846", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n  # Prefer USE (index 4) before movement actions if available.\n  action_order = [4, 0, 1, 2, 3] if n_actions > 4 else list(range(n_actions))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in action_order:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits.\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:24:53.573292", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and obtain the initial state and world reference\n  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Mapping from action index to (dx, dy)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def _bfs_to_target(state, target_kind):\n      \"\"\"Return a list of movement actions (0\u20113) that ends with the agent\n      facing a cell containing `target_kind`.  Return None if unreachable.\"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = state.pos\n      q = deque()\n      q.append((sx, sy, state.dir, []))\n      visited = {(sx, sy, state.dir)}\n\n      while q:\n          x, y, d, acts = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n      return None\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitive resources needed for a single arrow.\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          path = _bfs_to_target(cur_state, prim_idx)\n\n          # If BFS fails but we are already adjacent, still allow a USE.\n          if path is None and not cur_state.next_to(prim_idx):\n              return actions\n          if path is None:\n              path = []  # already next to the primitive\n\n          actions.extend(path)\n          actions.append(4)  # USE to pick up\n\n          # Keep the internal state in sync with the planned actions.\n          for a in path + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      path = _bfs_to_target(cur_state, workshop_idx)\n\n      if path is None and not cur_state.next_to(workshop_idx):\n          # Cannot reach workshop \u2013 attempt to craft in place anyway.\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n          return actions\n      if path is None:\n          path = []  # already adjacent to workshop\n\n      actions.extend(path)\n      actions.append(4)  # USE to craft\n\n      for a in path + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 craft in place.\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:24:54.703315", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Action \u2192 (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  from collections import deque\n  import numpy as np\n\n  def _bfs_to_target(state, target_kind):\n      \"\"\"Return a list of movement actions (0\u20113) that ends with the\n      agent facing a cell containing `target_kind`.  Return None if\n      unreachable.\"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = state.pos\n      sdir = state.dir\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, acts = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n      return None\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Gather all primitive resources needed for a single arrow.\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          path = _bfs_to_target(cur_state, prim_idx)\n\n          # If BFS fails but we are already adjacent, still allow a USE.\n          if path is None and not cur_state.next_to(prim_idx):\n              return actions\n          if path is None:\n              path = []  # already next to the primitive\n\n          actions.extend(path)\n          actions.append(4)  # USE to pick up\n\n          # Keep internal state in sync\n          for a in path + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      path = _bfs_to_target(cur_state, workshop_idx)\n\n      if path is None and not cur_state.next_to(workshop_idx):\n          # Cannot reach workshop \u2013 attempt to craft in place anyway.\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n          return actions\n      if path is None:\n          path = []  # already adjacent to workshop\n\n      actions.extend(path)\n      actions.append(4)  # USE to craft\n\n      for a in path + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 craft in place.\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:25:32.647064", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Resolve action indices, falling back to defaults if not present.\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  # Non\u2011grabbable indices are treated as obstacles for path\u2011finding.\n  non_grab = list(world.non_grabbable_indices)\n\n  def bfs_path(start, goal):\n      \"\"\"Breadth\u2011first search returning a list of movement actions from\n      ``start`` to ``goal`` while avoiding non\u2011grabbable obstacles.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # Reconstruct action sequence.\n              rev = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      rev.append(DOWN)\n                  elif py == cur[0] + 1:\n                      rev.append(UP)\n                  elif px == cur[1] - 1:\n                      rev.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # Skip cells occupied by any non\u2011grabbable entity.\n                  if np.any(grid[ny, nx, non_grab] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen in valid scenarios).\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Return coordinates of the nearest cell containing ``kind``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locs[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx),\n                         (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not np.any(grid[ny, nx, non_grab] > 0):\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; fall back to the primitive cell itself.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a move towards it; direction changes even if blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:25:33.772667", "function_name": "make_arrow", "function_body": "  # Reset environment and get core objects\n  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Resolve action indices (fallback to default ordering if not defined)\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  # Indices of entities that block movement (non\u2011grabbable)\n  non_grab = list(world.non_grabbable_indices)\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding obstacles.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # Reconstruct action list\n              actions_rev = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      actions_rev.append(DOWN)\n                  elif py == cur[0] + 1:\n                      actions_rev.append(UP)\n                  elif px == cur[1] - 1:\n                      actions_rev.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # Cell is blocked if any non\u2011grabbable entity occupies it\n                  if np.any(grid[ny, nx, non_grab] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locs[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its primitive requirements.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing; abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx),\n                         (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not np.any(grid[ny, nx, non_grab] > 0):\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; fallback to the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a move in that direction; direction changes even if blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # If the recipe requires a specific workshop, move there.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # ------------------------------------------------------------------\n  # Craft the arrow.\n  # ------------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:25:55.427301", "function_name": "make_arrow", "function_body": "  # Retrieve the underlying scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Resolve the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state from which planning will start\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory contents, and grid occupancy\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default: 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: already have an arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n\n          # If this action yields the goal, return the full action list\n          if next_state.satisfies(\"\", target_idx):\n              return node.actions + [a]\n\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:26:11.087361", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # usually 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:26:41.961407", "function_name": "make_arrow", "function_body": "  # reset environment and fetch useful objects\n  env.reset()\n  state = env._current_state            # CraftState\n  world = env.world                     # CraftWorld\n  grid = state.grid.copy()              # mutable copy for planning\n\n  # action indices (consistent with CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  height, width, _ = grid.shape\n  non_grab = set(world.non_grabbable_indices)\n\n  def passable(pos):\n      \"\"\"Return True if the cell can be entered (no non\u2011grabbable entity).\"\"\"\n      y, x = pos\n      if not (0 <= y < height and 0 <= x < width):\n          return False\n      # any non\u2011grabbable kind present blocks movement\n      return not np.any(grid[y, x, list(non_grab)] > 0)\n\n  def bfs(start, goal):\n      \"\"\"Shortest path (list of positions) from start to goal using 4\u2011connectivity.\n      Returns None if goal is unreachable.\"\"\"\n      if start == goal:\n          return [start]\n      from collections import deque\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              nxt = (ny, nx)\n              if nxt in came_from:\n                  continue\n              if passable(nxt) or nxt == goal:   # allow stepping onto goal even if occupied by a grabbable\n                  came_from[nxt] = cur\n                  q.append(nxt)\n      else:\n          return None\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions to movement actions.\"\"\"\n      acts = []\n      for (y0, x0), (y1, x1) in zip(path, path[1:]):\n          dy, dx = y1 - y0, x1 - x0\n          if dy == 1:\n              acts.append(DOWN)\n          elif dy == -1:\n              acts.append(UP)\n          elif dx == 1:\n              acts.append(RIGHT)\n          elif dx == -1:\n              acts.append(LEFT)\n          else:\n              raise ValueError(\"Non\u2011adjacent steps in path\")\n      return acts\n\n  def nearest_of_kind(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing ``kind_idx`` that is reachable.\"\"\"\n      candidates = np.argwhere(grid[:, :, kind_idx] > 0)\n      if candidates.size == 0:\n          return None\n      # sort by Manhattan distance for efficiency\n      dists = np.abs(candidates[:, 0] - from_pos[0]) + np.abs(candidates[:, 1] - from_pos[1])\n      order = np.argsort(dists)\n      for idx in order:\n          cell = tuple(candidates[idx])\n          # ensure we can actually reach the cell\n          if bfs(from_pos, cell) is not None:\n              return cell\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine recipe for ``arrow`` and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = nearest_of_kind(prim_idx, cur_pos)\n          if target is None:\n              # primitive missing / unreachable \u2013 abort early\n              return actions\n\n          # plan movement to the primitive cell\n          path = bfs(cur_pos, target)\n          if path is None:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = target\n\n          # pick up the primitive\n          actions.append(USE)\n\n          # remove it from our planning grid so we don't try to pick it again\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = nearest_of_kind(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          path = bfs(cur_pos, ws_cell)\n          if path is not None:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_cell\n\n  # final USE to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T21:26:43.127221", "function_name": "make_arrow", "function_body": "  # Reset the environment and extract useful objects\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action indices (consistent with CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  import collections\n\n  # Directions: (dy, dx, action)\n  _DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def _in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def _is_blocked(y, x):\n      \"\"\"Return True if the cell is occupied by a non\u2011grabbable entity.\"\"\"\n      return np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def _bfs_path(start, goal):\n      \"\"\"Return a list of actions that moves from start to goal using BFS.\n      Returns None if goal is unreachable.\"\"\"\n      if start == goal:\n          return []\n      q = collections.deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), acts = q.popleft()\n          for dy, dx, act in _DIRS:\n              ny, nx = y + dy, x + dx\n              if not _in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              # Allow stepping onto the goal even if it is \u201cblocked\u201d\n              if (ny, nx) != goal and _is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              new_acts = acts + [act]\n              if (ny, nx) == goal:\n                  return new_acts\n              q.append(((ny, nx), new_acts))\n      return None\n\n  def _nearest_reachable(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing `kind_idx` that is reachable.\n      Returns (path_actions, cell) or (None, None) if none reachable.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None, None\n      # Sort by Manhattan distance for efficiency\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      order = np.argsort(dists)\n      for idx in order:\n          cell = tuple(locations[idx])\n          path = _bfs_path(from_pos, cell)\n          if path is not None:\n              return path, cell\n      return None, None\n\n  # ------------------------------------------------------------------\n  # Determine the recipe for an ``arrow``\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          path, cell = _nearest_reachable(prim_idx, cur_pos)\n          if path is None:            # primitive missing / unreachable\n              return actions\n          actions.extend(path)\n          cur_pos = cell\n          actions.append(USE)         # pick up the primitive\n          # Update planning grid so we don't try to pick the same item again\n          grid[cell[0], cell[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_path, ws_cell = _nearest_reachable(workshop_idx, cur_pos)\n      if ws_path is not None:\n          actions.extend(ws_path)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T21:27:07.750436", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  # Mapping from direction vectors to action indices\n  DIRS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable cells.\n      If no path is found, returns an empty list.\"\"\"\n      if start == goal:\n          return []\n      H, W = grid.shape[:2]   # note: grid shape is (W, H, n_kinds) but we treat first two as rows, cols\n      blocked = list(world.non_grabbable_indices)\n\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}   # (y, x) -> (prev_y, prev_x, action)\n\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  if np.any(grid[ny, nx, blocked] > 0):\n                      continue   # cell occupied by a non\u2011grabbable entity\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x, act)\n                  if (ny, nx) == goal:\n                      # reconstruct path\n                      actions = []\n                      cur = (ny, nx)\n                      while cur != start:\n                          py, px, a = prev[cur]\n                          actions.append(a)\n                          cur = (py, px)\n                      actions.reverse()\n                      return actions\n                  q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell that contains ``kind_idx`` (primitive or workshop).\n      Returns a tuple (y, x) or ``None`` if the kind does not appear anywhere.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Move to the primitive cell (standing on it is sufficient for USE)\n          move_actions = bfs_path(cur_pos, target)\n          actions.extend(move_actions)\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions.extend(bfs_path(cur_pos, ws_cell))\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T21:27:08.876002", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state information\n  env.reset()\n  state = env._current_state                # CraftState\n  world = env.world                         # CraftWorld\n  grid = state.grid.copy()                  # mutable copy for bookkeeping\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  # Map direction vectors to action indices\n  DIRS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  def bfs_path(start, goal):\n      \"\"\"Return a shortest sequence of actions (DOWN/UP/LEFT/RIGHT) from\n      ``start`` to ``goal`` while avoiding non\u2011grabbable obstacles.\"\"\"\n      if start == goal:\n          return []\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}                     # (y,x) -> (prev_y, prev_x, action)\n\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # cell blocked if any non\u2011grabbable entity occupies it\n                  if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x, act)\n                  if (ny, nx) == goal:\n                      # reconstruct path\n                      actions = []\n                      cur = (ny, nx)\n                      while cur != start:\n                          py, px, a = prev[cur]\n                          actions.append(a)\n                          cur = (py, px)\n                      actions.reverse()\n                      return actions\n                  q.append((ny, nx))\n      # No path found \u2013 should not happen in well\u2011formed scenarios\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Locate the nearest cell containing ``kind`` (primitive or workshop)\n      using Manhattan distance. Returns (y, x) or None if not present.\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Move to the primitive cell\n          actions.extend(bfs_path(cur_pos, target))\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local grid copy so we don't try to collect the same cell again\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions.extend(bfs_path(cur_pos, ws_cell))\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T21:27:33.658600", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the desired item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 400          # safety limit for plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default: 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:27:49.390593", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Resolve the world and target item index\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise the start state\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: deterministic hash for a CraftState (to avoid revisiting)\n  # ----------------------------------------------------------------------\n  def _state_hash(st):\n      # pos, dir, inventory (as tuple) and the raw grid bytes uniquely\n      # identify a state for the purpose of planning.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search over (state, action_sequence) pairs\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  frontier = deque([Node(init_state, [])])\n  visited = { _state_hash(init_state) }\n\n  MAX_STEPS = 400                     # safety bound for plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default: 4 moves + USE\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: arrow present in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:28:05.379884", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # make local mutable copies\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of movement actions to reach any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # treat occupied cells as walls unless they are a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update simulated position according to a movement path.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection helper\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect *needed* units of a primitive from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # no more of this primitive on the map\n          path = None\n          target = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path = cand\n                  target = loc\n                  break\n          if path is None:\n              break  # cannot reach any remaining primitive\n          actions.extend(path)\n          move_along(path)\n          # pick up\n          actions.append(4)  # USE\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Ensure inventory[item_idx] >= amount by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # obtain all ingredients first\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to workshop if required\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # perform the craft\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:28:06.512873", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  def collect_primitive(prim_idx, needed):\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break\n          path = None\n          target = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path, target = cand, loc\n                  break\n          if path is None:\n              break\n          actions.extend(path)\n          move_along(path)\n          actions.append(4)  # USE\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n          recipe = recipes.get(item_idx, {})\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n          actions.append(4)  # USE (craft)\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  ensure_item(target_idx, 1)\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:28:32.300716", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Standard action indices for CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # Mapping from action to coordinate delta (grid indexed as [x, y])\n  _DELTA = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of actions that brings\n  # the agent from `start` to a cell adjacent to any cell in `targets`.\n  # Cells that contain any non\u2011zero entity are treated as obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, cur_grid):\n      w, h, _ = cur_grid.shape\n      occupied = np.any(cur_grid > 0, axis=2)          # True where any kind blocks movement\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Adjacent to a target?\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Expand neighbours\n          for act, (dx, dy) in _DELTA.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world through the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = state_wrapper.world\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance from the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal identification (hard\u2011coded to the item named \"arrow\").\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Mapping primitive index \u2192 count needed to craft one arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state; reset the environment if necessary.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)               # Current (x, y) position\n  grid = state.grid.copy()             # Mutable copy for planning\n\n  actions = []                          # Accumulated action sequence\n  used_cells = set()                    # Cells already harvested\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, count_needed in primitives_needed.items():\n      # Locate all cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position for efficiency.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= count_needed:\n              break\n          if loc in used_cells:\n              continue\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Pick up the primitive.\n          actions.append(USE)\n          used_cells.add(loc)\n          gathered += 1\n          # Update planning grid \u2013 the primitive is now removed.\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or integer id).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      # Find all workshop cells currently present.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft the arrow.\n          actions.append(USE)\n      else:\n          # No visible workshop \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:28:33.435406", "function_name": "make_arrow", "function_body": "  # Action indices for CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # Mapping from action to coordinate delta (x, y)\n  _DELTA = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search that returns a list of actions moving the\n  # agent from `start` to a cell adjacent to any of `targets`.  Cells that\n  # contain any non\u2011zero kind are treated as obstacles.\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def _bfs_path(start, targets, cur_grid):\n      w, h, _ = cur_grid.shape\n      occupied = np.any(cur_grid > 0, axis=2)          # True where any entity blocks movement\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent (Manhattan distance 1) to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Expand neighbours\n          for act, (dx, dy) in _DELTA.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell \u2013 return empty path (caller may handle)\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # In many wrappers the world lives inside the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance from the environment.\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Determine the goal \u2013 hard\u2011coded to the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state to read position / grid.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position for efficiency.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use action to pick up the primitive.\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n          # Update planning grid \u2013 primitive is now removed.\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      # Find workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use action to craft.\n          actions.append(USE)\n      else:\n          # No visible workshop \u2013 just attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:29:07.003605", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1,0,DOWN), (-1,0,UP), (0,-1,LEFT), (0,1,RIGHT)]", "env_interactions": 0, "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-10-28T21:29:08.181408", "function_name": "make_arrow", "function_body": "  # Reset environment and grab state/world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices (as defined by CraftLab)\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return grid[y, x].any()\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal\n      while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell (Manhattan distance) containing ``kind_idx``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[dists.argmin()]\n      return tuple(nearest)\n\n  def free_adjacent(cell, forbidden=set()):\n      \"\"\"Return a free neighbour of ``cell`` not in ``forbidden``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in forbidden:\n              continue\n          if not blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def face_action(src, dst):\n      \"\"\"Return the single movement action needed to face ``dst`` from ``src``.\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ----------------------------------------------------------------------\n  # Identify the arrow goal and its recipe\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)      # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = world.cookbook.index.index(workshop_name) if workshop_name else None\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  harvested = set()                       # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = free_adjacent(target, forbidden=harvested)\n          if adj is None:\n              # If no free neighbour, stand on the primitive cell itself\n              adj = target\n\n          # Move to that adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive and use\n          fa = face_action(cur_pos, target)\n          if fa is not None:\n              actions.append(fa)\n          actions.append(USE)\n\n          # Update internal grid copy and record the collection\n          grid[target[0], target[1], prim_idx] = 0\n          harvested.add(target)\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = free_adjacent(ws_cell, forbidden=harvested)\n          if ws_adj is None:\n              ws_adj = cur_pos\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop before using\n          fa = face_action(cur_pos, ws_cell)\n          if fa is not None:\n              actions.append(fa)\n\n  # Final USE to trigger crafting (or to craft directly if no workshop)\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:29:35.586323", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n  try:\n      init_state = scenario.init()\n  except Exception:\n      try:\n          init_state = env._current_state\n      except Exception:\n          return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n  MAX_STEPS = 800\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T21:29:51.320039", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects (may be wrapped by a Lab wrapper)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the goal item \"arrow\"\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      # Some wrappers expose the current state directly\n      init_state = getattr(env, \"_current_state\", None)\n      if init_state is None:\n          return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory contents and full grid layout\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_hash_state(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 800          # safety bound on plan length\n  MAX_VISITED = 200_000          # safety bound on explored states\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier and len(visited) < MAX_VISITED:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", goal_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all primitive actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _hash_state(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 0, "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T21:30:23.616726", "function_name": "make_arrow", "function_body": "  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # Mapping from action to coordinate delta (x, y)\n  _DELTA = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search that returns a list of actions moving the\n  # agent from `start` to a cell adjacent to any of `targets`.  Cells that\n  # contain any entity are treated as obstacles.\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def _bfs_path(start, targets, cur_grid):\n      w, h, _ = cur_grid.shape\n      occupied = np.any(cur_grid > 0, axis=2)  # True where any kind blocks movement\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are adjacent (Manhattan distance 1) to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n              if (x, y) == (tx, ty):\n                  return path\n          # Expand neighbours.\n          for act, (dx, dy) in _DELTA.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"World object not found in the environment\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: hard\u2011coded to the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the cookbook\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state to read position / grid.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Simulate movement to update `pos`.\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n          # Remove the primitive from the grid for future planning.\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      # Find workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Move to the nearest workshop cell.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)   # craft at workshop\n      else:\n          # No visible workshop \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:30:24.760576", "function_name": "make_arrow", "function_body": "  # Action indices as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # Mapping from action to (dx, dy)\n  _DELTA = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of actions that moves\n  # the agent from `start` to a cell adjacent to any of `targets`.\n  # Any cell that has a non\u2011zero entry in any channel is considered\n  # blocked for movement.\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def _bfs_path(start, targets, cur_grid):\n      w, h, _ = cur_grid.shape\n      occupied = np.any(cur_grid > 0, axis=2)          # True where something blocks movement\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent (Manhattan distance 1) to any target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          # Expand neighbours.\n          for act, (dx, dy) in _DELTA.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable adjacent cell \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the underlying CraftWorld and its cookbook.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance inside the environment.\")\n\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal: hard\u2011coded to the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for one arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state to read the grid/position.\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All locations containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Plan path to a cell adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Simulate movement.\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n          # Remove the primitive from the planning grid.\n          grid[loc[0], loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n      # Locate workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              dx, dy = _DELTA[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)     # craft at the workshop\n      else:\n          # No visible workshop \u2013 attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
