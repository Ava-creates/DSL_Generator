{"timestamp": "2025-10-28T17:54:48.412841", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper: Bread\u2011first search returning a list of movement actions\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices that moves from ``start`` to the\n      nearest cell in ``targets`` while avoiding ``blocked`` cells.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 should not happen for a solvable scenario\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: move to a cell containing ``kind_idx`` and USE it ``cnt`` times\n  # ----------------------------------------------------------------------\n  def collect_kind(kind_idx, cnt):\n      nonlocal pos, actions, grid\n      for _ in range(cnt):\n          # locate all cells that currently hold the required kind\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          # find shortest path to the nearest such cell\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          # update current position following the path\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # perform the pickup\n          actions.append(4)          # USE\n          # remove the item from our mutable copy of the grid\n          grid[pos[0], pos[1], kind_idx] -= 1\n\n  # ----------------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # primitive requirements for a single arrow (recursively expanded)\n  needed_prims = cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # workshop where the arrow must be crafted\n  recipe = cookbook.recipes[arrow_idx]\n  wk_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n  workshop_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n  # ----------------------------------------------------------------------\n  # Static data: mutable copy of the grid, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid.copy()\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the final action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect every primitive required by the arrow recipe\n  for prim_idx, count in needed_prims.items():\n      collect_kind(prim_idx, count)\n\n  # 2) Move to the workshop and craft the arrow\n  workshop_cells = {(x, y) for x in range(w) for y in range(h)\n                    if grid[x, y, workshop_idx] > 0}\n  path_to_ws = bfs(pos, workshop_cells, blocked)\n  actions.extend(path_to_ws)\n  # (optional) update position \u2013 not needed after the final step\n  actions.append(4)          # USE to craft the arrow at the workshop\n\n  return actions", "env_interactions": 19, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:55:14.257387", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the goal item \"arrow\"\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Starting state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to uniquely hash a state (position, direction, inventory, grid)\n  def _hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = {_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_LEN = 300                         # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default action count\n\n  while frontier:\n      node = frontier.popleft()\n      cur = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur.satisfies(\"\", goal_idx):\n          return node.actions\n\n      # Prune overly long action sequences\n      if len(node.actions) >= MAX_LEN:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt = cur.step(a)\n          h = _hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:55:29.921672", "function_name": "make_arrow", "function_body": "  import collections\n\n  # Retrieve scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = collections.namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(start_state)}\n  frontier = collections.deque([Node(start_state, [])])\n\n  MAX_STEPS = 300                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long sequences\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:55:54.291318", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Resolve the index for the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  import numpy as np\n  from collections import deque, namedtuple\n\n  # Helper: hashable representation of a state for visited set\n  def _state_hash(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  # Helper: Manhattan distance\n  def _manhattan(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # Helper: locate all cells containing any of the given kind indices\n  def _positions_of_kinds(grid, kind_idxs):\n      coords = []\n      for k in kind_idxs:\n          locs = np.argwhere(grid[:, :, k] > 0)\n          for (x, y) in locs:\n              coords.append((int(x), int(y)))\n      return coords\n\n  # Helper: find nearest position (Manhattan) from current pos to any target in list\n  def _nearest(pos, targets):\n      if not targets:\n          return None, None\n      dists = [_manhattan(pos, t) for t in targets]\n      idx = int(np.argmin(dists))\n      return targets[idx], dists[idx]\n\n  # Gather recipe information for the target\n  recipe = world.cookbook.recipes.get(target_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Primitive requirements for one arrow (may be empty if arrow is primitive)\n  prim_req = world.cookbook.primitives_for(target_idx)  # dict {prim_idx: count}\n\n  # Node container for BFS\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 600                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typical actions: 0\u20114 (DOWN,UP,LEFT,RIGHT,USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Determine missing primitive counts\n      missing = {}\n      for p_idx, need_cnt in prim_req.items():\n          have = int(cur_state.inventory[p_idx])\n          if have < need_cnt:\n              missing[p_idx] = need_cnt - have\n\n      # Determine next relevant kind positions for heuristic ordering\n      # 1) Positions of missing primitives\n      prim_positions = _positions_of_kinds(cur_state.grid, list(missing.keys()))\n      # 2) Positions of workshop (if we have all primitives)\n      workshop_positions = []\n      if workshop_kind is not None and not missing:\n          workshop_positions = _positions_of_kinds(cur_state.grid, [workshop_kind])\n\n      # Compute heuristic ordering of actions\n      action_scores = {}\n      for a in range(n_actions):\n          # Simulate the action\n          _, nxt_state = cur_state.step(a)\n          # Base score: distance to nearest relevant target after action\n          if missing:\n              # try to get closer to any needed primitive\n              nearest_prim, dist = _nearest(nxt_state.pos, prim_positions)\n              score = dist if nearest_prim is not None else 1000\n          else:\n              # all primitives collected, go to workshop\n              nearest_ws, dist = _nearest(nxt_state.pos, workshop_positions)\n              score = dist if nearest_ws is not None else 1000\n          # Prefer USE when adjacent to a needed thing\n          if a == 4:  # USE action\n              # check adjacency to needed primitive or workshop\n              adjacent = False\n              for k in (list(missing.keys()) if missing else [workshop_kind]):\n                  if k is not None and nxt_state.next_to(k):\n                      adjacent = True\n                      break\n              if adjacent:\n                  score -= 5  # boost priority\n          action_scores[a] = score\n\n      # Sort actions by heuristic (lower score = higher priority)\n      sorted_actions = sorted(range(n_actions), key=lambda x: action_scores[x])\n\n      for a in sorted_actions:\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If we exit the loop without finding a plan\n  return []", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:56:09.923374", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Helper to create a hashable representation of a CraftState\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  # Optional: get primitive requirements for the target (may be used for pruning)\n  try:\n      primitive_requirements = world.cookbook.primitives_for(target_idx)\n  except Exception:\n      primitive_requirements = {}\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:56:31.600677", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # directions: 0=DOWN,1=UP,2=LEFT,3=RIGHT (as defined in env)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices that moves from start to any target.\"\"\"\n      w, h = blocked.shape\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable in solvable scenarios\n\n  def go_to_and_use(kind_idx, count):\n      \"\"\"Move to a cell containing `kind_idx` and USE it `count` times.\"\"\"\n      nonlocal pos, actions, grid, w, h, blocked\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)          # USE action\n          # after using the primitive the cell becomes empty \u2013 update blocked if needed\n          # (primitives are grabbable, so blocked does not change)\n\n  # ----------------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count needed\n  craft_steps = []           # list of (item_idx, count) in correct order\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive needs and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # no recipe \u2192 primitive\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # first resolve ingredients (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # then schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Static environment data\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_and_use(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      if isinstance(wk_key, int):\n          wk_idx = wk_key\n      else:\n          wk_idx = cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE the workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:56:32.716527", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # (dx, dy) for actions 0\u20113\n\n  def bfs(start, targets, blocked):\n      \"\"\"Bread\u2011first search returning a list of action indices reaching any target.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should not happen for solvable scenarios\n\n  def go_to_and_use(kind_idx, count):\n      \"\"\"Move to cells containing `kind_idx` and USE them `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          # locate all cells currently holding the required kind\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE action\n\n  # ----------------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}      # primitive kind -> total count required\n  craft_steps = []       # list of (item_idx, count) in crafting order\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredient requirements first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # After ingredients, schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_and_use(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # locate workshop cells\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # use the workshop the required number of times to craft the item\n      actions.extend([4] * cnt)   # USE action repeated `cnt` times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:56:57.585622", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS to reach any target cell while avoiding blocked cells.\n  # Returns a list of action indices that moves from `start` to the first\n  # cell in `targets`. If no target is reachable, returns an empty list.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and press USE `count`\n  # times (collecting a primitive or using a workshop).\n  # ------------------------------------------------------------------\n  def go_to_kind(kind_idx, count):\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 1) Resolve the recipe for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count needed\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively gather primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredient items first (ignore special keys like \"_at\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # 2) Static environment data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 3) Build the full action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 3a) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 3b) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\")\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:56:58.698495", "function_name": "make_arrow", "function_body": "  # Directions: 0=RIGHT,1=LEFT,2=UP,3=DOWN (matching CraftWorld action order)\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of action indices that\n  # reaches any cell in `targets` while avoiding blocked cells.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # No reachable target \u2013 return empty path (should not happen)\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and perform the USE\n  # action `cnt` times (collecting primitives or using a workshop).\n  # ------------------------------------------------------------------\n  def go_to_kind(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 1) Gather recipe information for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredients first (ignore special keys like \"_at\" or \"_key\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # 2) Static environment data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 3) Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 3a) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 3b) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      # Locate any workshop cell of the required type\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      # Use the workshop the necessary number of times to craft the item\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:57:21.036764", "function_name": "make_arrow", "function_body": "  # Mapping between direction vectors and action indices.\n  DIR_TO_ACT = {(0, 1): 0,   # DOWN\n                (0, -1): 1,  # UP\n                (-1, 0): 2,  # LEFT\n                (1, 0): 3}   # RIGHT\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n  ACTION_USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  def bfs(start, targets, grid, blocked_kinds):\n      \"\"\"Return a list of movement actions that brings the agent from ``start``\n      to a cell adjacent (Manhattan distance\u202f1) to any cell in ``targets``.\n      Cells containing any kind in ``blocked_kinds`` are treated as obstacles.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # Pre\u2011compute blocked mask.\n      blocked = np.zeros((W, H), dtype=bool)\n      for k in blocked_kinds:\n          blocked |= grid[:, :, k] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # Unreachable.\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract current state information.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n\n  # Goal index is stored in the task (env.task.goal).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (including counts).\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  blocked_kinds = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # Locate remaining cells that still contain this primitive.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive unavailable \u2013 abort planning.\n              return plan\n\n          # Move adjacent to the closest such cell.\n          path = bfs(pos, cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to.\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              # Safety break to avoid infinite loop.\n              break\n\n          # Update local copy of the grid and decrement the needed count.\n          grid[adj[0], adj[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:57:22.154313", "function_name": "make_arrow", "function_body": "  DIR_TO_ACT = {(0, 1): 0, (0, -1): 1, (-1, 0): 2, (1, 0): 3}\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n  ACTION_USE = 4\n\n  from collections import deque\n  import numpy as np\n\n  def bfs(start, targets, grid, block_set):\n      \"\"\"Return a list of actions moving from ``start`` to a cell adjacent to any target.\"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.zeros((W, H), dtype=bool)\n      for b in block_set:\n          blocked |= grid[:, :, b] > 0\n\n      sx, sy = start\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract current state.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  block_set = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              return plan  # primitive missing, abort planning\n\n          path = bfs(pos, cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(ACTION_USE)\n\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              break  # safety\n\n          grid[adj[0], adj[1], kind_idx] -= 1\n          count -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
