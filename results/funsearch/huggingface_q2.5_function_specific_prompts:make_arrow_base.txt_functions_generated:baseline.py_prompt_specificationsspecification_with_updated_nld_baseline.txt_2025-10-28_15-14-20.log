{"timestamp": "2025-10-28T17:17:50.975048", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices\n  spec = env.action_specs()\n  DOWN = spec[\"DOWN\"]\n  UP = spec[\"UP\"]\n  LEFT = spec[\"LEFT\"]\n  RIGHT = spec[\"RIGHT\"]\n  USE = spec[\"USE\"]\n\n  # Goal and required primitives\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # Current state snapshot\n  state = env._current_state\n  pos = tuple(state.pos)               # (x, y)\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  actions = []\n\n  # -----------------------------------------------------------------\n  # BFS path finder that avoids non\u2011grabbable entities\n  # -----------------------------------------------------------------\n  def bfs(start, target):\n      W, H = grid.shape[:2]\n\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((W, H), dtype=bool)\n\n      # The target cell may be occupied by a required item; allow stepping onto it\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_to[nxt] = a\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None\n\n      # Reconstruct actions\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_to[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # -----------------------------------------------------------------\n  # Collect all required primitives\n  # -----------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              break  # no more copies left on the map\n          # Choose the nearest location (Manhattan)\n          target = min(locations,\n                       key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs(pos, target)\n          if path is None:\n              # Fallback to simple Manhattan moves\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n          actions.extend(path)\n          actions.append(USE)                     # pick up primitive\n          # Update simulated position and grid\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # -----------------------------------------------------------------\n  # Move to workshop (if required) and craft the final item\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          target_ws = min(ws_locations,\n                          key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          path = bfs(pos, target_ws)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n          actions.extend(path)\n          actions.append(USE)                     # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
