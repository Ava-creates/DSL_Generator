{"timestamp": "2025-10-28T17:43:04.769591", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup and resolve recipe dependencies for the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive idx -> total count required\n  craft_steps = []           # list of (item_idx, count) in post\u2011order\n\n  def resolve(item_idx: int, multiplier: int) -> None:\n      \"\"\"Recursively fill needed_prims and craft_steps for `item_idx`.\"\"\"\n      recipe = cookbook.recipes.get(item_idx)\n      if recipe is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + multiplier\n          return\n      # Resolve ingredient primitives first (ignore special keys)\n      for ing, cnt in recipe.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * multiplier)\n      # Schedule crafting of this item after its ingredients\n      craft_steps.append((item_idx, multiplier))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Static world information\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid                     # (W, H, n_kinds)\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # Action directions: 0\u2011DOWN, 1\u2011UP, 2\u2011LEFT, 3\u2011RIGHT, 4\u2011USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  from collections import deque\n\n  def bfs(start, targets):\n      \"\"\"Bread\u2011first search returning a list of actions to reach any target.\"\"\"\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []   # should never happen in a solvable scenario\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)   # current (x, y)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, count in needed_prims.items():\n      for _ in range(count):\n          primitive_cells = {(x, y) for x in range(w) for y in range(h)\n                             if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, primitive_cells)\n          actions.extend(path)\n          for a in path:                     # update simulated position\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)                  # USE to pick up\n\n  # 2) Perform crafting steps at their respective workshops\n  for item_idx, count in craft_steps:\n      recipe = cookbook.recipes[item_idx]\n      wk_key = recipe.get(\"_at\", recipe.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      workshop_cells = {(x, y) for x in range(w) for y in range(h)\n                        if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, workshop_cells)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * count)            # USE at workshop to craft\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:43:29.744404", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices moving from start to the nearest target.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # Should not happen in a solvable scenario\n\n  def go_to_and_use(kind_idx, count):\n      \"\"\"Move to a cell containing `kind_idx` and USE it `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE\n\n  # ------------------------------------------------------------------\n  # Gather recipe information for \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive needs and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the final action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_and_use(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:43:30.883972", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  # ------------------------------------------------------------------\n  # Breadth\u2011first search returning a list of movement actions\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices that moves from `start` to the nearest\n      cell in `targets` while avoiding `blocked` cells.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # Should never happen in a solvable scenario\n      return []\n\n  # ------------------------------------------------------------------\n  # Move to a cell containing `kind_idx` and USE it `count` times\n  # ------------------------------------------------------------------\n  def go_to_kind(kind_idx, count):\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)          # USE\n\n  # ------------------------------------------------------------------\n  # Gather recipe information for the target item \"arrow\"\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind \u2192 total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive needs and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static data: current grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the final action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect every primitive required by the recipe\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:44:02.211080", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  # Mapping from direction vectors to action indices\n  DIRS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable cells.\n      If no path is found, returns an empty list.\"\"\"\n      if start == goal:\n          return []\n      W, H = grid.shape[0], grid.shape[1]\n      blocked = list(world.non_grabbable_indices)\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}          # (y,x) -> (prev_y, prev_x, action)\n\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:\n                  # cell is free if none of the blocked kinds are present\n                  if not np.any(grid[ny, nx, blocked] > 0):\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = (y, x, act)\n                      if (ny, nx) == goal:\n                          # reconstruct path\n                          actions = []\n                          cur = (ny, nx)\n                          while cur != start:\n                              py, px, a = prev[cur]\n                              actions.append(a)\n                              cur = (py, px)\n                          actions.reverse()\n                          return actions\n                      q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop)\n      using Manhattan distance. Returns coordinates (y, x) or None.\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Move to the primitive cell (standing on it is sufficient for USE)\n          actions.extend(bfs_path(cur_pos, target))\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if the recipe specifies one) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions.extend(bfs_path(cur_pos, ws_cell))\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:44:03.323653", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state information\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices as defined by CraftLab\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  # Mapping from (dy,dx) to the corresponding movement action\n  DIRS = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions that walks from ``start`` to ``goal``\n      while avoiding cells that contain any non\u2011grabbable entity.\n      If no path exists, an empty list is returned.\"\"\"\n      if start == goal:\n          return []\n\n      W, H = grid.shape[0], grid.shape[1]\n      blocked = list(world.non_grabbable_indices)\n\n      visited = np.full((W, H), False, dtype=bool)\n      prev = {}  # (y,x) -> (prev_y, prev_x, action)\n\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          for (dy, dx), act in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < W and 0 <= nx < H and not visited[ny, nx]:\n                  # Cell is free if none of the blocked kinds are present\n                  if not np.any(grid[ny, nx, blocked] > 0):\n                      visited[ny, nx] = True\n                      prev[(ny, nx)] = (y, x, act)\n                      if (ny, nx) == goal:\n                          # Reconstruct path\n                          actions = []\n                          cur = (ny, nx)\n                          while cur != start:\n                              py, px, a = prev[cur]\n                              actions.append(a)\n                              cur = (py, px)\n                          actions.reverse()\n                          return actions\n                      q.append((ny, nx))\n      # No reachable path\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell that contains the entity ``kind_idx``.\n      Returns a tuple (y, x) or None if the entity does not appear.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return (int(nearest[0]), int(nearest[1]))\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  primitive_requirements = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_requirements.items():\n      for _ in range(needed_cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early; return actions gathered so far.\n              return actions\n\n          # Move to the primitive cell (standing on it is sufficient for USE)\n          move_actions = bfs_path(cur_pos, target)\n          actions.extend(move_actions)\n          cur_pos = target\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions.extend(bfs_path(cur_pos, ws_cell))\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 7, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T17:44:24.694209", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVES = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n\n  def _bfs_path(grid, start, goal, allow_occupied=False):\n      \"\"\"Return a list of actions to move from start to goal.\n      If allow_occupied is True we may step onto the goal cell even if it\n      contains an entity; otherwise only empty cells are traversable.\"\"\"\n      h, w, _ = grid.shape\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (r, c), path = q.popleft()\n          if (r, c) == goal:\n              return path\n          for act, (dr, dc) in MOVES:\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              if (nr, nc) in visited:\n                  continue\n              # cell empty?\n              if np.all(grid[nr, nc, :] == 0):\n                  visited.add((nr, nc))\n                  q.append(((nr, nc), path + [act]))\n              elif allow_occupied and (nr, nc) == goal:\n                  # we are allowed to step onto the goal even if occupied\n                  visited.add((nr, nc))\n                  q.append(((nr, nc), path + [act]))\n      return None\n\n  def _nearest_of_kind(grid, kind_idx, start):\n      \"\"\"BFS search for the closest cell that contains `kind_idx`.\n      Returns (position, path) where `path` leads from `start` to that cell.\n      Traversal is only through empty cells.\"\"\"\n      h, w, _ = grid.shape\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (r, c), path = q.popleft()\n          if grid[r, c, kind_idx] > 0:\n              return (r, c), path\n          for act, (dr, dc) in MOVES:\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              if (nr, nc) in visited:\n                  continue\n              if np.all(grid[nr, nc, :] == 0):\n                  visited.add((nr, nc))\n                  q.append(((nr, nc), path + [act]))\n      return None, None\n\n  # ------------------------------------------------------------------\n  # Initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow)\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # not present in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine which primitives (and how many) are needed for ONE arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Gather each required primitive (respecting multiplicity)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          target_pos, path = _nearest_of_kind(state.grid, prim_idx, state.pos)\n          if target_pos is None:\n              # primitive not found \u2013 abort early\n              return action_seq\n\n          # move to the primitive (allow stepping onto its cell)\n          move_path = _bfs_path(state.grid, state.pos, target_pos, allow_occupied=True)\n          if move_path is None:\n              move_path = []  # fallback: already adjacent / cannot move\n\n          for a in move_path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n\n          # pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # Craft the arrow \u2013 possibly at a specific workshop\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_pos, ws_path = _nearest_of_kind(state.grid, workshop_idx, state.pos)\n      if ws_pos is not None:\n          # move to workshop (can step onto it)\n          move_path = _bfs_path(state.grid, state.pos, ws_pos, allow_occupied=True)\n          if move_path is None:\n              move_path = ws_path if ws_path is not None else []\n          for a in move_path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # craft\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n  else:\n      # no specific workshop \u2013 just use on current cell\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:44:25.815296", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial objects\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Action indices (as defined in CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions to move from start to goal.\n  # The goal cell may be occupied (e.g., contains the needed item), but\n  # all intermediate cells must be empty.\n  # ------------------------------------------------------------------\n  def _bfs_path(grid, start, goal):\n      h, w, _ = grid.shape\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n      while q:\n          (r, c), path = q.popleft()\n          if (r, c) == goal:\n              return path\n          for act, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              if (nr, nc) in visited:\n                  continue\n              # allow stepping onto the goal even if it is occupied\n              if (nr, nc) == goal or np.all(grid[nr, nc, :] == 0):\n                  visited.add((nr, nc))\n                  q.append(((nr, nc), path + [act]))\n      return None  # no path found\n\n  # ------------------------------------------------------------------\n  # Helper: Find the nearest cell that contains a given kind (BFS).\n  # Returns (position, path_to_position) or (None, None) if not found.\n  # ------------------------------------------------------------------\n  def _nearest_of_kind(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      from collections import deque\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      moves = [(DOWN, (1, 0)), (UP, (-1, 0)), (LEFT, (0, -1)), (RIGHT, (0, 1))]\n      while q:\n          (r, c), path = q.popleft()\n          if grid[r, c, kind_idx] > 0:\n              return (r, c), path\n          for act, (dr, dc) in moves:\n              nr, nc = r + dr, c + dc\n              if not (0 <= nr < h and 0 <= nc < w):\n                  continue\n              if (nr, nc) in visited:\n                  continue\n              if np.all(grid[nr, nc, :] == 0):  # walk only through empty cells\n                  visited.add((nr, nc))\n                  q.append(((nr, nc), path + [act]))\n      return None, None\n\n  # ------------------------------------------------------------------\n  # Identify the index of the target item \"arrow\"\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      # Arrow not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)  # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting multiplicities)\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          target_pos, path = _nearest_of_kind(state.grid, prim_idx, state.pos)\n          if target_pos is None:\n              # required primitive not found \u2013 abort early\n              return action_seq\n          # Follow the path to the primitive\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick up the primitive\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos, path = _nearest_of_kind(state.grid, workshop_idx, state.pos)\n      if workshop_pos is not None:\n          for a in path:\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Craft at the workshop\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n  else:\n      # No specific workshop required \u2013 attempt to craft in place\n      reward, done, obs = env.step(USE)\n      state = env._current_state\n      action_seq.append(USE)\n\n  return action_seq", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:44:51.932617", "function_name": "make_arrow", "function_body": "  # Helper to get kind index from name\n  def _idx(name):\n      return env.world.cookbook.index[name]\n\n  # Action indices (consistent with CraftWorld)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  move_to_action = {\n      (1, 0): ACTION_DOWN,\n      (-1, 0): ACTION_UP,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT,\n  }\n\n  # Reset and obtain initial state\n  env.reset()\n  state = env._current_state\n  grid = state.grid\n  pos = tuple(state.pos)\n\n  # Goal: make an arrow\n  goal_idx = _idx('arrow')\n  # Primitive (and intermediate) requirements for one arrow\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  # Workshop where arrow must be crafted\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at') or recipe.get('_key')\n  if isinstance(workshop_kind, str):\n      workshop_kind = _idx(workshop_kind)\n\n  # Set of indices that block movement (non\u2011grabbable entities)\n  block_set = env.world.non_grabbable_indices\n\n  # ------------------------------------------------------------------\n  # Utility functions\n  # ------------------------------------------------------------------\n  def _walkable(x, y):\n      \"\"\"Return True if cell (x,y) is inside the grid and not blocked by a\n      non\u2011grabbable entity.\"\"\"\n      if x < 0 or x >= grid.shape[0] or y < 0 or y >= grid.shape[1]:\n          return False\n      return not any(grid[x, y, idx] > 0 for idx in block_set)\n\n  from collections import deque\n\n  def _bfs_path(start, target_cells, require_adjacent=False):\n      \"\"\"Find a shortest path (list of actions) from start to any cell in\n      target_cells. If require_adjacent=True the returned path ends on a\n      walkable cell that is orthogonally adjacent to a target cell.\"\"\"\n      if not target_cells:\n          return []\n\n      # quick check: already adjacent (or on) a target\n      if not require_adjacent:\n          if start in target_cells:\n              return []\n      else:\n          for tx, ty in target_cells:\n              if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n                  return []\n\n      q = deque([start])\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if require_adjacent:\n              # stop when cur is adjacent to any target\n              for tx, ty in target_cells:\n                  if abs(cur[0] - tx) + abs(cur[1] - ty) == 1:\n                      goal = cur\n                      break\n              else:\n                  goal = None\n              if goal is not None:\n                  # reconstruct path\n                  actions = []\n                  while came_from[goal] is not None:\n                      prev, move = came_from[goal]\n                      actions.append(move_to_action[move])\n                      goal = prev\n                  actions.reverse()\n                  return actions\n          else:\n              if cur in target_cells:\n                  # reconstruct path\n                  actions = []\n                  while came_from[cur] is not None:\n                      prev, move = came_from[cur]\n                      actions.append(move_to_action[move])\n                      cur = prev\n                  actions.reverse()\n                  return actions\n\n          x, y = cur\n          for dx, dy in [(1, 0), (-1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if _walkable(nx, ny) and (nx, ny) not in came_from:\n                  came_from[(nx, ny)] = (cur, (dx, dy))\n                  q.append((nx, ny))\n      # no path found\n      return []\n\n  # ------------------------------------------------------------------\n  # Planning loop\n  # ------------------------------------------------------------------\n  actions_seq = []\n  max_total_steps = 2000  # safety limit\n\n  while not state.satisfies('', goal_idx) and len(actions_seq) < max_total_steps:\n      inventory = state.inventory\n\n      # Determine which primitives we still need\n      missing = None\n      for kind_idx, cnt in needed.items():\n          if inventory[kind_idx] < cnt:\n              missing = kind_idx\n              break\n\n      if missing is None:\n          # All required items are in inventory \u2013 go craft at workshop\n          if workshop_kind is None:\n              break  # no workshop info, cannot continue\n          workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n          if workshop_cells.size == 0:\n              break  # no workshop on map\n          path = _bfs_path(tuple(state.pos), workshop_cells.tolist(),\n                           require_adjacent=True)\n          actions_seq.extend(path)\n          for a in path:\n              _, state = env.step(a)\n          actions_seq.append(ACTION_USE)\n          _, state = env.step(ACTION_USE)\n      else:\n          # Need to collect the missing primitive\n          prim_cells = np.argwhere(grid[:, :, missing] > 0)\n          if prim_cells.size == 0:\n              break  # primitive not present on map\n          path = _bfs_path(tuple(state.pos), prim_cells.tolist(),\n                           require_adjacent=False)\n          actions_seq.extend(path)\n          for a in path:\n              _, state = env.step(a)\n          actions_seq.append(ACTION_USE)\n          _, state = env.step(ACTION_USE)\n\n  return actions_seq", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:44:53.047944", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper constants and functions\n  # ----------------------------------------------------------------------\n  # Action indices (as used by CraftWorld)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {(1, 0): ACTION_DOWN,\n             (-1, 0): ACTION_UP,\n             (0, -1): ACTION_LEFT,\n             (0, 1): ACTION_RIGHT}\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_adjacent(start, targets, blocked):\n      \"\"\"\n      Return a list of actions that moves from ``start`` to a cell\n      adjacent (Manhattan distance = 1) to any coordinate in ``targets``.\n      ``blocked`` is a 2\u2011D bool array where True means the cell cannot be entered.\n      \"\"\"\n      W, H = blocked.shape\n      sx, sy = start\n      # already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny] and not blocked[nx, ny]:\n                  npath = path + [act]\n                  # check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []  # unreachable\n\n  # ----------------------------------------------------------------------\n  # Initialise environment / state\n  # ----------------------------------------------------------------------\n  # Reset to a fresh state (if not already reset)\n  try:\n      env.reset()\n  except Exception:\n      pass  # env may already be in a reset state\n\n  state = env._current_state\n  grid = state.grid.copy()            # mutable copy for planning\n  pos = tuple(state.pos)              # (x, y)\n\n  # Goal: make an arrow\n  goal_idx = env.world.cookbook.index.get('arrow')\n  if goal_idx is None:\n      return []  # cannot find arrow in index\n\n  # ----------------------------------------------------------------------\n  # Determine required primitives / intermediate items\n  # ----------------------------------------------------------------------\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # Pre\u2011compute a mask of cells that block movement (non\u2011grabbable entities)\n  def blocked_mask_from_grid(g):\n      mask = np.zeros(g.shape[:2], dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          mask |= g[:, :, idx] > 0\n      return mask\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required items\n  # ----------------------------------------------------------------------\n  for kind_idx, required_cnt in needed.items():\n      while required_cnt > 0:\n          # locate cells that still contain the needed kind\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # no more of this item on the map \u2013 abort planning\n              return plan\n\n          # compute current blocked cells\n          blocked = blocked_mask_from_grid(grid)\n          # find path to a cell adjacent to any of the candidate cells\n          path = bfs_adjacent(pos, cells.tolist(), blocked)\n          plan.extend(path)\n\n          # simulate movement\n          for act in path:\n              dx, dy = ACT2DIR[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # use action to pick up the item\n          plan.append(ACTION_USE)\n\n          # determine which item cell we interacted with (must be adjacent)\n          used_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  used_cell = (cx, cy)\n                  break\n          if used_cell is None:\n              # safety fallback \u2013 stop planning\n              return plan\n\n          # update simulated grid (remove one instance)\n          grid[used_cell[0], used_cell[1], kind_idx] -= 1\n          required_cnt -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get('_at') or recipe.get('_key')\n  if workshop_key is not None:\n      # Resolve workshop index (could be string name or integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index.get(workshop_key)\n      else:\n          workshop_idx = int(workshop_key)\n\n      if workshop_idx is not None:\n          workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n          if workshop_cells.size > 0:\n              blocked = blocked_mask_from_grid(grid)\n              path = bfs_adjacent(pos, workshop_cells.tolist(), blocked)\n              plan.extend(path)\n\n              # simulate movement to workshop\n              for act in path:\n                  dx, dy = ACT2DIR[act]\n                  pos = (pos[0] + dx, pos[1] + dy)\n\n              # final USE to craft the arrow\n              plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:45:13.531901", "function_name": "make_arrow", "function_body": "  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  world = env.world\n  state = env._current_state\n\n  # Determine goal index for 'arrow'\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception as e:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'\") from e\n\n  # Primitive requirements for the goal (expanded to raw items)\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  def _move_to(target, cur_pos, action_list):\n      \"\"\"Append actions moving from cur_pos to target using Manhattan steps.\"\"\"\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          action_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          action_list.append(LEFT)\n          x -= 1\n      while y < ty:\n          action_list.append(DOWN)\n          y += 1\n      while y > ty:\n          action_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Collect each needed primitive\n  for prim_idx, needed in primitive_requirements.items():\n      # locate any cell containing this primitive\n      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # primitive not present; cannot collect \u2013 skip\n          continue\n      target = tuple(locations[0])\n      cur_pos = _move_to(target, cur_pos, actions)\n      for _ in range(needed):\n          actions.append(USE)\n\n  # Move to workshop (if required) and craft the arrow\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name is not None:\n      if isinstance(workshop_name, int):\n          workshop_idx = workshop_name\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_name)\n\n  if workshop_idx is not None:\n      ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_pos = tuple(ws_locs[0])\n          cur_pos = _move_to(ws_pos, cur_pos, actions)\n\n  actions.append(USE)\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:45:14.649852", "function_name": "make_arrow", "function_body": "  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  world = env.world\n  state = env._current_state\n\n  # Determine the goal index for the arrow item\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception as e:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'\") from e\n\n  # Primitive requirements (expanded) for the goal\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  # Helper: move from current position to target using Manhattan moves\n  def _move_to(target, cur_pos, action_list):\n      \"\"\"Append actions that move from cur_pos to target; return new position.\"\"\"\n      x, y = cur_pos\n      tx, ty = target\n      while x < tx:\n          action_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          action_list.append(LEFT)\n          x -= 1\n      while y < ty:\n          action_list.append(DOWN)\n          y += 1\n      while y > ty:\n          action_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # Primitive not present on the map; skip (might be unreachable)\n          continue\n      # Choose the first occurrence as target\n      target = tuple(locations[0])\n      cur_pos = _move_to(target, cur_pos, actions)\n      # Pick up the required amount (one USE per unit)\n      for _ in range(needed):\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name is not None:\n      if isinstance(workshop_name, int):\n          workshop_idx = workshop_name\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_name)\n\n  if workshop_idx is not None:\n      ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          ws_pos = tuple(ws_locs[0])\n          cur_pos = _move_to(ws_pos, cur_pos, actions)\n\n  # Use the workshop (or current cell) to perform the crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:45:39.032400", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(pos, target, seq):\n      \"\"\"Append moves to bring `pos` (list [x, y]) to `target` (list [x, y]).\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return the (x, y) of the nearest cell containing `kind_idx`.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # Determine starting position.\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Copy the initial grid to track collected items.\n  grid = env.scenario.init_grid.copy()\n\n  # Goal index.\n  goal_idx = env.task.goal\n\n  actions = []\n\n  # Collect primitives needed for the goal.\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not found; abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                         # pick up the item\n          grid[target[1], target[0], kind_idx] = 0    # mark as taken\n\n  # Move to workshop (if required) and craft the goal.\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                         # craft at workshop\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:45:40.153919", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(pos, target, seq):\n      \"\"\"Append moves that bring mutable ``pos`` (list [x, y]) to ``target``.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Return the (x, y) of the nearest cell containing ``kind_idx``.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine starting position.\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid to keep track of collected items.\n  grid = env.scenario.init_grid.copy()\n\n  # Goal index comes from the task stored in the environment.\n  goal_idx = env.task.goal\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                         # pick up the item\n          grid[target[1], target[0], kind_idx] = 0    # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                         # craft at workshop\n      else:\n          # No workshop found; attempt to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 just use the action to craft.\n      actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:46:14.704132", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Reset environment and obtain core objects\n  # ----------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  height, width, _ = grid.shape\n\n  def in_bounds(y, x):\n      return 0 <= y < height and 0 <= x < width\n\n  def cell_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from *start* to *goal* while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              rev.reverse()\n              return rev\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty (will cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing *kind_idx* (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to *cell* not in *avoid*.\n      If none exist, return None.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe information\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)      # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  taken_positions = set()                 # remember cells we already harvested\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = free_adjacent(target, avoid=taken_positions)\n          if adj is None:\n              # No free neighbour; fallback to standing on the primitive itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (if not standing on it).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid representation and remember the location.\n          grid[target[0], target[1], prim_idx] = 0\n          taken_positions.add(target)\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = free_adjacent(ws_cell, avoid=taken_positions)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop.\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:46:15.829079", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and fetch current state/world.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from *start* to *goal* while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              rev.reverse()\n              return rev\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing *kind_idx* (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y, x) to *cell* not in *avoid*.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                 # (y, x)\n  collected = set()                   # positions of primitives already taken\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; fallback to standing on the primitive cell itself.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a directional action; may be a no\u2011op move if blocked).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid representation and remember the location.\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow.\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = ws_cell  # fallback to the workshop cell itself\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop.\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:46:43.070344", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour (y, x) of ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def direction_action(src, dst):\n      \"\"\"Return the action that would move from src towards dst (one step).\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None  # already same cell\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  collected = set()                       # cells of primitives already taken\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; abort\n              return actions\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked move in that direction)\n          dir_act = direction_action(cur_pos, target)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation and record collection\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              # If no free neighbour, stand directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional)\n          dir_act = direction_action(cur_pos, ws_cell)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:46:44.263249", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch current state/world\n  env.reset()\n  state = env._current_state            # CraftState\n  world = env.world                     # CraftWorld\n  grid = state.grid.copy()              # mutable copy of the grid\n\n  # Action indices (as defined by CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any kind occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour (y, x) of ``cell`` that is not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  def direction_action(src, dst):\n      \"\"\"Return the action that would move from src towards dst (one step).\"\"\"\n      dy, dx = dst[0] - src[0], dst[1] - src[1]\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None  # already same cell\n\n  # ----------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n  collected = set()                       # cells of primitives already taken\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell itself\n              adj = target\n\n          # Move to the adjacent (or same) cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked move in that direction)\n          dir_act = direction_action(cur_pos, target)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid representation and record collection\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ----------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ----------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              # If no free neighbour, stand directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional)\n          dir_act = direction_action(cur_pos, ws_cell)\n          if dir_act is not None:\n              actions.append(dir_act)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T17:47:09.856992", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects from the environment\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Create a hashable representation of a state for visited\u2011set checking\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default actions: 0\u20114\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:47:25.548881", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \u201carrow\u201d\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Hash function for visited states (position, direction, inventory, full grid)\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default to five primitive actions\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T17:48:01.619283", "function_name": "make_arrow", "function_body": "  # action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # movement vectors paired with their action indices\n  _MOVES = [\n      ((0, 1), DOWN),   # down  (y+1)\n      ((0, -1), UP),    # up    (y-1)\n      ((-1, 0), LEFT),  # left  (x-1)\n      ((1, 0), RIGHT),  # right (x+1)\n  ]\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions that moves from start to goal using BFS.\n      Cells that contain any non\u2011zero kind are treated as blocked,\n      except the goal cell itself (which may hold the target item).\"\"\"\n      w, h = grid.shape[0], grid.shape[1]          # width (x), height (y)\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in _MOVES:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing the requested kind (Manhattan).\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)   # y\u2011rows, x\u2011cols\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Planning start\n  # ------------------------------------------------------------------\n  actions = []\n\n  # current position (prefer live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # mutable copy of the static grid for planning (so we can \u201cremove\u201d items once taken)\n  grid = env.scenario.init_grid.copy()\n\n  # goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # primitive not found \u2013 abort planning.\n              return actions\n          # move to the primitive\n          actions.extend(_bfs_path(cur_pos, target, grid))\n          # pick it up\n          actions.append(USE)\n          # mark the cell as empty for subsequent planning\n          grid[target[1], target[0], kind_idx] = 0\n          # update current position\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(_bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)          # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  # return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:48:02.768883", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  _moves = [\n      ((0, 1), DOWN),   # down  (y+1)\n      ((0, -1), UP),    # up    (y-1)\n      ((-1, 0), LEFT),  # left  (x-1)\n      ((1, 0), RIGHT),  # right (x+1)\n  ]\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions moving from start to goal avoiding occupied cells.\"\"\"\n      w, h = grid.shape[0], grid.shape[1]   # x\u2011size, y\u2011size\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}   # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in _moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and grid[ny, nx].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing the given kind (Manhattan distance).\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Planning start\n  # ------------------------------------------------------------------\n  actions = []\n\n  # Current position (use live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Copy of the static grid for planning (we will mark collected items)\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_needs = dict(env.world.cookbook.primitives_for(goal_idx))\n\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning.\n              return actions\n          actions.extend(_bfs_path(cur_pos, target, grid))\n          actions.append(USE)                     # pick up the primitive\n          # Mark the primitive as taken in our planning grid.\n          grid[target[1], target[0], kind_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(_bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)   # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  # Return the complete action sequence.\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:48:34.488055", "function_name": "make_arrow", "function_body": "  \"\"\"Plan a sequence of actions that gathers the required primitives and\n  crafts an ``arrow`` in the provided CraftLab environment.\n\n  The function works for any environment that follows the CraftWorld\n  interface.  It extracts the goal index (either from the current task or\n  by looking up the name ``'arrow'``), determines the primitive\n  requirements, and then uses a BFS planner to move to the nearest\n  instances of each primitive while avoiding non\u2011grabbable obstacles.\n  Finally it moves to the appropriate workshop (if any) and issues a\n  ``USE`` action to craft the arrow.\n\n  Returns\n  -------\n  List[int]\n      A list of action indices (as defined by the environment's\n      ``action_specs``) that, when executed, should produce an arrow.\n  \"\"\"\n  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action mapping (environment may use non\u2011default indices)\n  # ------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec.get(\"DOWN\", 0)\n  UP = spec.get(\"UP\", 1)\n  LEFT = spec.get(\"LEFT\", 2)\n  RIGHT = spec.get(\"RIGHT\", 3)\n  USE = spec.get(\"USE\", 4)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def _in_bounds(pos, shape):\n      x, y = pos\n      w, h = shape\n      return 0 <= x < w and 0 <= y < h\n\n  def _neighbors(pos, shape):\n      x, y = pos\n      for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):\n          if _in_bounds((nx, ny), shape):\n              yield (nx, ny)\n\n  def _bfs(start, targets, blocked):\n      \"\"\"Bread\u2011first search from ``start`` to the closest cell in ``targets``.\n      Returns the path as a list of positions (including ``start``) or\n      ``None`` if no target is reachable.\n      \"\"\"\n      w, h = blocked.shape\n      visited = np.full((w, h), False, dtype=bool)\n      prev = {}\n      dq = deque([start])\n      visited[start] = True\n      while dq:\n          cur = dq.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = [cur]\n              while path[-1] != start:\n                  path.append(prev[path[-1]])\n              path.reverse()\n              return path\n          for nb in _neighbors(cur, (w, h)):\n              if not visited[nb] and not blocked[nb]:\n                  visited[nb] = True\n                  prev[nb] = cur\n                  dq.append(nb)\n      return None\n\n  def _path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to movement actions.\"\"\"\n      act_list = []\n      for (x0, y0), (x1, y1) in zip(path, path[1:]):\n          if x1 > x0:\n              act_list.append(RIGHT)\n          elif x1 < x0:\n              act_list.append(LEFT)\n          elif y1 > y0:\n              act_list.append(DOWN)\n          elif y1 < y0:\n              act_list.append(UP)\n      return act_list\n\n  # ------------------------------------------------------------------\n  # Access world and current state\n  # ------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  grid = state.grid.copy()                     # work on a copy for planning\n  shape = grid.shape[:2]                       # (WIDTH, HEIGHT)\n\n  # ------------------------------------------------------------------\n  # Resolve the goal index for ``arrow``\n  # ------------------------------------------------------------------\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      goal_idx = world.cookbook.index.get(\"arrow\")\n  if goal_idx is None:\n      raise RuntimeError(\"Unable to locate goal index for 'arrow'.\")\n\n  # ------------------------------------------------------------------\n  # Primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Cells that are not walkable (non\u2011grabbable entities)\n  # ------------------------------------------------------------------\n  blocked = np.zeros(shape, dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Helper: move to a reachable target cell\n  # ------------------------------------------------------------------\n  def _move_to(target):\n      nonlocal cur_pos, actions\n      path = _bfs(cur_pos, {target}, blocked)\n      if path is None:\n          return False\n      actions.extend(_path_to_actions(path))\n      cur_pos = target\n      return True\n\n  # ------------------------------------------------------------------\n  # Gather each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      gathered = 0\n      while gathered < needed:\n          # locate all cells that currently contain this primitive\n          candidates = [tuple(pos) for pos in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not candidates:\n              # no more of this primitive on the map \u2013 give up\n              break\n\n          # pick the reachable candidate with the shortest path\n          best_loc = None\n          best_len = None\n          for loc in candidates:\n              path = _bfs(cur_pos, {loc}, blocked)\n              if path is not None:\n                  if best_len is None or len(path) < best_len:\n                      best_loc = loc\n                      best_len = len(path)\n\n          if best_loc is None:\n              # nothing reachable\n              break\n\n          # move to the chosen location\n          _move_to(best_loc)\n\n          # pick up as many as needed (or available)\n          available = int(grid[best_loc[0], best_loc[1], prim_idx])\n          take = min(available, needed - gathered)\n          actions.extend([USE] * take)\n\n          # update planning grid\n          grid[best_loc[0], best_loc[1], prim_idx] = max(0, available - take)\n          gathered += take\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # workshop_key may be a string name or already an index\n      if isinstance(workshop_key, int):\n          workshop_idx = workshop_key\n      else:\n          workshop_idx = world.cookbook.index.get(workshop_key)\n\n      if workshop_idx is not None:\n          # locate workshop cells\n          workshop_cells = [tuple(pos) for pos in np.argwhere(grid[:, :, workshop_idx] > 0)]\n          if workshop_cells:\n              # pick the closest workshop cell\n              ws = min(workshop_cells,\n                       key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n              # find a free adjacent cell to stand on\n              adj_free = [nb for nb in _neighbors(ws, shape) if not blocked[nb]]\n              if adj_free:\n                  # choose the adjacent cell closest to current position\n                  target_adj = min(adj_free,\n                                   key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n                  _move_to(target_adj)\n\n  # ------------------------------------------------------------------\n  # Final craft action\n  # ------------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:48:35.592676", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T17:48:55.785310", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Action / direction maps (as defined by CraftLab)\n  # ----------------------------------------------------------------------\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n  ACTION_USE = 4\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from ``start``\n  # to a cell adjacent (Manhattan distance 1) to any cell in ``targets``.\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return actions to get adjacent to any target cell.\"\"\"\n      W, H = grid.shape[:2]\n\n      # blocked cells = any non\u2011grabbable entity present (>0)\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # unreachable\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise mutable copies of the current state\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for planning\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index stored in the task object\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive (and intermediate) requirements for the goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives (including intermediates)\n  # ----------------------------------------------------------------------\n  for kind_idx, cnt_needed in needed.items():\n      while cnt_needed > 0:\n          # locate all cells that currently contain this kind\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # primitive not present \u2013 abort planning\n              return plan\n\n          # move adjacent to the nearest reachable primitive\n          path = bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # simulate movement\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # pick it up\n          plan.append(ACTION_USE)\n\n          # find which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # unexpected \u2013 stop to avoid infinite loop\n              break\n\n          # update local grid copy and decrement needed count\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt_needed -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # resolve workshop index (name -> int or already int)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:48:56.911612", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search that returns a list of actions moving the agent\n      from ``start`` to a cell adjacent (Manhattan distance 1) to any cell\n      in ``targets`` while avoiding non\u2011grabbable obstacles.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # Cells occupied by any non\u2011grabbable entity block movement.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise mutable copies of the current state\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for simulation\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index is stored in the task definition (env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (expanded recursively)\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, cnt_needed in needed.items():\n      while cnt_needed > 0:\n          # Locate all cells that currently contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present \u2013 abort planning\n              return plan\n\n          # Move adjacent to the nearest reachable primitive\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update position\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected; safety break to avoid infinite loop\n              break\n\n          # Update the simulated grid and decrement needed count\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt_needed -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:49:19.108754", "function_name": "make_arrow", "function_body": "  # Reset environment and initialise structures\n  env.reset()\n  actions = []\n  act_map = env.action_specs()          # name \u2192 integer id\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Cardinal movement deltas\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Only walk through completely empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells currently holding the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 cannot continue\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort further attempts for this primitive\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Use action to pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate all workshop cells of the appropriate kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use action at the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:49:20.226711", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n  act_map = env.action_specs()\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # movement deltas for cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If we are adjacent to any target, stop\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Traversable only if the cell is completely empty\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells currently holding the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present any more \u2013 abort this collection\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort further attempts for this primitive\n              break\n\n          # Execute the movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Pick up the primitive with the USE action\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate all workshop cells of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          # Plan a path to the workshop (adjacent cell)\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Craft the item with the USE action\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:49:44.513182", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n  act_map = env.action_specs()\n  move_delta = {\"UP\": (-1, 0), \"DOWN\": (1, 0), \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of action names moving from `start` to a cell adjacent\n      (Chebyshev distance \u2264\u202f1) to any cell in `targets`. Only empty cells may be\n      traversed.\"\"\"\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # adjacency test\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny].sum() == 0:      # empty cell\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in needed.items():\n      while True:\n          state = env._current_state\n          if state.inventory[prim_idx] >= required_cnt:\n              break\n          grid = state.grid\n          pos = state.pos\n\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # primitive not present anywhere \u2013 give up on this item\n              break\n\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # unreachable primitive \u2013 abort collection for this type\n              break\n\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:49:45.641902", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain initial state\n  env.reset()\n  # Goal index and recipe information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Mapping from action name to integer ID\n  act_map = env.action_specs()\n\n  # Cardinal movement deltas\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent from\n  # `start` to a cell that is adjacent (Chebyshev distance \u2264 1) to any cell\n  # in `targets`. Only empty cells (no entity) may be traversed.\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.zeros((W, H), dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh current state\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate cells containing the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present; abort collection\n              break\n\n          # Plan path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive; abort\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Use action to pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after primitive collection\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate workshop cells of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use action at the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled sequence of action IDs\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
