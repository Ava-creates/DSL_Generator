{"timestamp": "2025-10-28T22:32:24.092778", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to create a hashable representation of a CraftState\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n\n  # Primitive requirements for the target (used only for optional pruning)\n  try:\n      primitive_requirements = world.cookbook.primitives_for(target_idx)\n  except Exception:\n      primitive_requirements = {}\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: arrow present in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Stop expanding overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h in visited:\n              continue\n          visited.add(h)\n          frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T22:32:51.082914", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()            # mutable copy for bookkeeping\n\n  # Resolve action indices (use env specs if present)\n  try:\n      specs = env.action_specs()\n      DOWN = specs['DOWN']\n      UP = specs['UP']\n      LEFT = specs['LEFT']\n      RIGHT = specs['RIGHT']\n      USE = specs['USE']\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walk\n      from ``start`` to ``goal`` using a simple Manhattan route.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing ``kind_idx`` (primitive or workshop).\n      Returns a (y, x) tuple or ``None`` if not found.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(target):\n      \"\"\"Return a free adjacent coordinate to ``target`` (prefer empty).\n      If none are free, return ``target`` itself.\"\"\"\n      ty, tx = target\n      candidates = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are needed for the 'arrow' item\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos   # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on (or the primitive cell itself)\n          stand_pos = free_adjacent(target)\n\n          # Move to the chosen position\n          actions += manhattan_path(cur_pos, stand_pos)\n          cur_pos = stand_pos\n\n          # Face the primitive before using (direction update via a step)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update bookkeeping grid to reflect that the primitive was taken\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:32:52.260471", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  base_grid = state.grid               # immutable occupancy grid\n\n  # Resolve action identifiers (fallback to default ordering)\n  try:\n      specs = env.action_specs()\n      DOWN = specs['DOWN']\n      UP = specs['UP']\n      LEFT = specs['LEFT']\n      RIGHT = specs['RIGHT']\n      USE = specs['USE']\n  except Exception:\n      DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Mapping from coordinate delta to movement action\n  delta_to_action = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, 1): RIGHT,\n      (0, -1): LEFT,\n  }\n\n  # Helper: Manhattan path (used as fallback)\n  def manhattan_path(start, goal):\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  # Helper: BFS shortest path avoiding non\u2011grabbable entities\n  def bfs_path(start, goal):\n      from collections import deque\n      h, w = base_grid.shape[:2]\n      non_grab = list(world.non_grabbable_indices)\n\n      def occupied(pos):\n          y, x = pos\n          return np.any(base_grid[y, x, non_grab] > 0)\n\n      if start == goal:\n          return []\n\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (y, x), path = q.popleft()\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and (ny, nx) not in visited:\n                  if occupied((ny, nx)):\n                      continue\n                  new_path = path + [(ny, nx, act)]\n                  if (ny, nx) == goal:\n                      return new_path\n                  visited.add((ny, nx))\n                  q.append(((ny, nx), new_path))\n      # No path found \u2013 fallback to Manhattan (may hit obstacles)\n      return [(None, None, a) for a in manhattan_path(start, goal)]\n\n  # Helper: Convert a BFS\u2011style path (list of (y,x,action)) to action list\n  def path_to_actions(path):\n      return [act for _, _, act in path if act is not None]\n\n  # Helper: Find nearest cell containing a given kind index (using a mutable copy)\n  def find_nearest(kind_idx, from_pos, mutable_grid):\n      locs = np.argwhere(mutable_grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  # Helper: Choose a free adjacent cell (or the cell itself if none)\n  def choose_adjacent(target, mutable_grid):\n      ty, tx = target\n      h, w = mutable_grid.shape[:2]\n      for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n          if 0 <= ny < h and 0 <= nx < w:\n              occupied = np.any(mutable_grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are required for the 'arrow' item\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # Mutable copy of the grid to track collected primitives\n  mutable_grid = base_grid.copy()\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in required_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos, mutable_grid)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          stand_pos = choose_adjacent(target, mutable_grid)\n\n          # Compute movement actions to reach the standing position\n          bfs_result = bfs_path(cur_pos, stand_pos)\n          if bfs_result:\n              actions += path_to_actions(bfs_result)\n          else:\n              actions += manhattan_path(cur_pos, stand_pos)\n\n          cur_pos = stand_pos\n\n          # Face the primitive (if not standing on it)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if (dy, dx) in delta_to_action:\n              actions.append(delta_to_action[(dy, dx)])\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update mutable grid to reflect that the primitive was taken\n          mutable_grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos, mutable_grid)\n      if ws_cell is not None:\n          bfs_result = bfs_path(cur_pos, ws_cell)\n          if bfs_result:\n              actions += path_to_actions(bfs_result)\n          else:\n              actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
