{"timestamp": "2025-10-28T17:22:05.730788", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Setup and helper definitions\n  # --------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  # Action indices as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of movement actions (0\u20113) from start to the\n  # nearest cell in *goals*. Cells that contain any entity are treated as\n  # blocked unless they are one of the goal cells.\n  # ------------------------------------------------------------------\n  def _bfs(start, goals, grid):\n      width, height = grid.shape[:2]\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in goals:\n              return path\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Allow stepping onto a goal cell even if occupied.\n              if np.any(grid[nx, ny, :]) and (nx, ny) not in goals:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Apply a sequence of movement actions to update the current position.\n  # ------------------------------------------------------------------\n  def _apply_path(path, pos):\n      x, y = pos\n      for a in path:\n          if a == DOWN:\n              y += 1\n          elif a == UP:\n              y -= 1\n          elif a == LEFT:\n              x -= 1\n          elif a == RIGHT:\n              x += 1\n      return (x, y)\n\n  # --------------------------------------------------------------\n  # Access the current world, state and cookbook.\n  # --------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify the goal item (\"arrow\") and its recipe.\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  recipe = cookbook.recipes.get(goal_idx, {})\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for the goal.\n  # --------------------------------------------------------------\n  primitive_requirements = cookbook.primitives_for(goal_idx)\n\n  # --------------------------------------------------------------\n  # Work on a copy of the grid so we can simulate pickups.\n  # --------------------------------------------------------------\n  grid = state.grid.copy()\n  pos = tuple(state.pos)          # current agent position (x, y)\n  actions = []                    # planned action sequence\n\n  # --------------------------------------------------------------\n  # Helper: collect a given primitive until the needed amount is met.\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      while needed > 0:\n          # Locate all cells that still contain this primitive.\n          locations = [(x, y) for x in range(grid.shape[0])\n                       for y in range(grid.shape[1])\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              # No more instances on the map \u2013 abort collection.\n              break\n\n          # Choose the nearest location (Manhattan distance) as a heuristic.\n          dists = [abs(x - pos[0]) + abs(y - pos[1]) for (x, y) in locations]\n          target = locations[int(np.argmin(dists))]\n\n          # Find a path to the target cell.\n          path = _bfs(pos, {target}, grid)\n          if path is None:\n              # Unreachable \u2013 remove this cell from future consideration.\n              locations.remove(target)\n              continue\n\n          # Append movement actions and update position.\n          actions.extend(path)\n          pos = _apply_path(path, pos)\n\n          # Use action to pick up the primitive (may need multiple USEs if count >1).\n          available = int(grid[target[0], target[1], prim_idx])\n          take = min(available, needed)\n          for _ in range(take):\n              actions.append(USE)\n\n          # Update simulated grid and remaining need.\n          grid[target[0], target[1], prim_idx] -= take\n          needed -= take\n\n  # --------------------------------------------------------------\n  # After gathering all primitives, go to the appropriate workshop\n  # (if any) and craft the arrow.\n  # --------------------------------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      # Resolve workshop index (could be a string name or already an int).\n      if isinstance(workshop_name, int):\n          workshop_idx = workshop_name\n      else:\n          workshop_idx = cookbook.index[workshop_name]\n\n      # Locate workshop cells.\n      workshop_cells = [(x, y) for x in range(grid.shape[0])\n                        for y in range(grid.shape[1])\n                        if grid[x, y, workshop_idx] > 0]\n\n      if workshop_cells:\n          # Choose the nearest workshop cell.\n          dists = [abs(x - pos[0]) + abs(y - pos[1]) for (x, y) in workshop_cells]\n          ws_target = workshop_cells[int(np.argmin(dists))]\n\n          # Move to the workshop.\n          path = _bfs(pos, {ws_target}, grid)\n          if path is not None:\n              actions.extend(path)\n              pos = _apply_path(path, pos)\n\n  # Final USE to perform the crafting at the workshop (or in place).\n  actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T17:22:27.451781", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  #   start (x, y) to a cell adjacent (Manhattan distance \u2264 1) to any\n  #   target location. Cells with any non\u2011zero kind are treated as\n  #   obstacles.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent to a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path \u2013 return empty list.\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract world and cookbook references.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Current position and mutable copy of the grid.\n  pos = tuple(state.pos)                # (x, y)\n  cur_grid = state.grid.copy()          # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from the current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Clear the cell for future path\u2011finding.\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      # Find all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
