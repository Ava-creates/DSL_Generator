{"timestamp": "2025-10-28T16:12:14.722311", "function_name": "make_arrow", "function_body": "  # Mapping from movement vectors to action indices (as defined in CraftLab).\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start_pos, target_cells, grid):\n      \"\"\"\n      Bread\u2011first search that returns a list of actions moving the agent\n      from ``start_pos`` to a cell adjacent (Manhattan distance 1) to any\n      cell in ``target_cells``. ``grid`` has shape (W, H, K). Cells that\n      contain any non\u2011grabbable entity are considered blocked.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # Compute blocked cells: any non\u2011grabbable kind present.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start_pos\n\n      # Already adjacent?\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Main planning logic.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()            # mutable copy for simulation\n  pos = tuple(state.pos)              # (x, y)\n\n  # Goal index is stored in the task (env.task.goal).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Determine all primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect each required primitive.\n  # --------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          # Find all cells currently holding this kind.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present on the map \u2013 abort planning.\n              return plan\n\n          # Compute a path to the nearest reachable primitive (adjacent).\n          path = bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update position.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update local grid copy (remove one instance) and decrement need.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or already an int).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      # Locate workshop cells.\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to workshop.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:12:15.841116", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Mapping from movement vectors to action indices.\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search that returns a list of actions moving the agent\n      from ``start`` to a cell adjacent (Manhattan distance 1) to any\n      cell in ``targets``.  ``grid`` has shape (W, H, K) and any non\u2011zero\n      entry in the last axis is considered blocked for movement.\n      \"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)          # True where a cell holds anything\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Main planning logic\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy for simulation\n  pos = tuple(state.pos)                 # (x, y)\n\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Determine primitive (and intermediate) counts required for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # --------------------------------------------------------------\n  for kind_idx, count_needed in needed.items():\n      while count_needed > 0:\n          # Locate all cells that currently contain this kind.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive missing \u2013 abort planning.\n              return plan\n\n          # Find a path to the nearest reachable primitive (adjacent).\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update local grid copy (remove one instance) and decrement need.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count_needed -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to the workshop adjacency.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:12:42.513633", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Helper: map movement vectors to action indices and back.\n  # ------------------------------------------------------------------\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {a: d for d, a in DIR2ACT.items()}\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of actions moving the agent from ``start``\n  # to a cell adjacent (Manhattan distance 1) to any cell in ``targets``.\n  # ``blocked_kinds`` is a set of kind indices that are impassable.\n  # ------------------------------------------------------------------\n  def bfs_adjacent(start, targets, grid, blocked_kinds):\n      W, H = grid.shape[:2]\n\n      # Pre\u2011compute boolean blocked map: any cell containing a blocked kind.\n      blocked = np.zeros((W, H), dtype=bool)\n      for k in blocked_kinds:\n          blocked |= grid[:, :, k] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise environment state.\n  # ------------------------------------------------------------------\n  # Ensure the environment is in a fresh state.\n  _ = env.reset()\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy for planning\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal index from the task definition.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # ------------------------------------------------------------------\n  # Determine which primitive resources are needed for the goal.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  # Cells that cannot be traversed (e.g., water, stone, trees, etc.).\n  blocked_kinds = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          # Locate remaining instances of this primitive on the map.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive unavailable \u2013 abort planning.\n              return plan\n\n          # Find a path to the nearest reachable primitive (adjacent).\n          path = bfs_adjacent(pos, prim_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected \u2013 break to avoid infinite loop.\n              break\n\n          # Update local grid copy (remove one instance) and decrement need.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          needed_cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      # Locate workshop cells on the (possibly updated) grid.\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement to workshop adjacency.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:12:43.618061", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action \u2194 direction helpers (environment uses 0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n  # ------------------------------------------------------------------\n  DIR2ACT = {\n      (0, 1): 0,    # DOWN\n      (0, -1): 1,   # UP\n      (-1, 0): 2,   # LEFT\n      (1, 0): 3,    # RIGHT\n  }\n  ACT2DIR = {a: d for d, a in DIR2ACT.items()}\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of actions moving the agent\n  # from ``start`` to a cell adjacent (Manhattan distance 1) to any\n  # cell in ``targets`` while avoiding cells that contain any index in\n  # ``blocked_kinds``.\n  # ------------------------------------------------------------------\n  def bfs_adjacent(start, targets, grid, blocked_kinds):\n      W, H = grid.shape[:2]\n\n      # Build a boolean mask of blocked cells.\n      blocked = np.zeros((W, H), dtype=bool)\n      for k in blocked_kinds:\n          blocked |= grid[:, :, k] > 0\n\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.zeros((W, H), dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise environment state.\n  # ------------------------------------------------------------------\n  # Ensure the environment has been reset; ``reset`` also returns the\n  # initial observation which we do not need here.\n  _ = env.reset()\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n\n  # Goal index (the item we need to craft).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Primitive requirements for the goal (only raw resources).\n  required_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  blocked_kinds = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in required_prims.items():\n      while needed_cnt > 0:\n          # Locate all cells that still contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not present anywhere \u2013 abort planning.\n              return plan\n\n          # Find actions to become adjacent to the nearest reachable primitive.\n          path = bfs_adjacent(pos, prim_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(4)   # USE action\n\n          # Identify which primitive cell we are adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Something went wrong; break to avoid infinite loop.\n              break\n\n          # Update our local copy of the grid and decrement need.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          needed_cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve the workshop kind index.\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement to workshop adjacency.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft the item by using the workshop.\n          plan.append(4)   # USE action\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:13:06.371026", "function_name": "make_arrow", "function_body": "  # Reset the environment and get the initial state\n  env.reset()\n  # Mapping from action names to indices\n  act_map = env.action_specs()\n  # Movement deltas for cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (including diagonally) to\n  # any cell in `targets`.  It only walks through empty cells.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If we are adjacent (including diagonal) to any target cell,\n          # we have reached a usable location.\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Only walk through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Get goal information and required primitives\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh current state\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells that currently contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 skip\n              continue\n\n          # Plan a path to an adjacent cell of the nearest primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 skip\n              continue\n\n          # Execute movement actions\n          for act_name in path:\n              a = act_map[act_name]\n              actions.append(a)\n              env.step(a)\n\n          # Use action to pick up the primitive\n          a = act_map[\"USE\"]\n          actions.append(a)\n          env.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after collecting primitives\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  a = act_map[act_name]\n                  actions.append(a)\n                  env.step(a)\n\n          # Use action at the workshop to craft the item\n          a = act_map[\"USE\"]\n          actions.append(a)\n          env.step(a)\n\n  # Return the computed action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:13:07.480849", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment to start fresh\n  env.reset()\n  # Current state reference (will be updated after each step)\n  state = env._current_state\n\n  # Goal index and associated recipe information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Mapping from action names to their integer IDs\n  act_map = env.action_specs()\n\n  # Movement deltas for the four cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (including diagonally) to\n  # any cell in `targets`.  The search only walks through empty cells.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency (including diagonal) to any target cell\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell found\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh state after each action\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate cells that currently contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present in the world \u2013 abort planning\n              break\n\n          # Plan a path to a cell adjacent to the nearest primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 abort planning\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n\n          # Use action to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after collecting primitives\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n\n          # Use action at the workshop to craft the item\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the constructed sequence of action IDs\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:13:28.033864", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper to move from one grid cell to another using Manhattan moves\n  # ------------------------------------------------------------------\n  def _move_to(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(RIGHT)\n          cx += 1\n      while cx > tx:\n          seq.append(LEFT)\n          cx -= 1\n      while cy < ty:\n          seq.append(DOWN)\n          cy += 1\n      while cy > ty:\n          seq.append(UP)\n          cy -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Extract world, cookbook and goal information\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # For raw CraftWorld instances the world is the env itself\n      world = env\n  cookbook = world.cookbook\n\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for ONE arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Get the current CraftState (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # Reset the environment to obtain an initial state\n      # env.reset() returns an observation dict; the state is stored internally\n      env.reset()\n      state = env._current_state\n\n  # Current position and static grid layout\n  pos = tuple(state.pos)\n  grid = state.grid  # shape (W, H, n_kinds)\n\n  actions = []\n  used_cells = set()   # cells already harvested\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # Find all cells that currently contain this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position (greedy nearest)\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed_cnt:\n              break\n          if loc in used_cells:\n              continue\n          # Move to the primitive cell\n          actions.extend(_move_to(pos, loc))\n          pos = loc\n          # Pick it up\n          actions.append(USE)\n          used_cells.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Locate workshop cells on the grid\n      ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_locs[0]\n          actions.extend(_move_to(pos, target_ws))\n          pos = target_ws\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:13:29.148772", "function_name": "make_arrow", "function_body": "  # constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper: shortest path (BFS) returning list of action indices\n  # ------------------------------------------------------------------\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions to move from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      w, h, _ = grid.shape\n      queue = collections.deque()\n      queue.append((start, []))\n      visited = {start}\n      while queue:\n          (x, y), path = queue.popleft()\n          for dx, dy, act in DIRS:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # a cell is blocked if it contains any entity (non\u2011zero) except the goal cell\n              if (nx, ny) != goal and grid[nx, ny, :].sum() > 0:\n                  continue\n              new_path = path + [act]\n              if (nx, ny) == goal:\n                  return new_path\n              visited.add((nx, ny))\n              queue.append(((nx, ny), new_path))\n      # if no path found, fall back to empty list (will likely fail later)\n      return []\n\n  # ------------------------------------------------------------------\n  # Access world and cookbook (works for both CraftLab and raw env)\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # CraftLab stores the world inside the internal state\n      world = getattr(env, \"_current_state\", None).world\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its primitive requirements\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Get current state (CraftLab keeps it in _current_state after reset)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # fallback: initialise from the scenario directly\n      state = env.scenario.init()\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy so we can \u201cremove\u201d collected items\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      collected = 0\n      while collected < needed_cnt:\n          # locate all remaining cells containing this primitive\n          locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          if not locations:\n              # nothing left \u2013 abort (should not happen in a valid scenario)\n              break\n          # pick the location with the shortest Manhattan distance (good heuristic)\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations[0]\n\n          # move to the primitive\n          actions.extend(_bfs_path(pos, target, grid))\n          pos = target\n\n          # pick it up\n          actions.append(USE)\n\n          # update grid to reflect that the primitive has been taken\n          grid[pos[0], pos[1], prim_idx] = 0\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the item\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # resolve workshop index (could be a name or already an int)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n\n      # locate workshop cells\n      ws_locations = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locations:\n          ws_locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = ws_locations[0]\n\n          # move to workshop and use\n          actions.extend(_bfs_path(pos, ws_target, grid))\n          actions.append(USE)\n\n  return actions", "env_interactions": 24, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:13:54.868846", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:13:55.963817", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities (local to the function)\n  # ----------------------------------------------------------------------\n  # Mapping from action names to indices as defined in the environment.\n  action_map = env.action_specs()\n  USE = action_map[\"USE\"]\n  # Direction vectors and corresponding action indices.\n  DIRS = [\n      ((1, 0), action_map[\"DOWN\"]),\n      ((-1, 0), action_map[\"UP\"]),\n      ((0, -1), action_map[\"LEFT\"]),\n      ((0, 1), action_map[\"RIGHT\"]),\n  ]\n\n  # ----------------------------------------------------------------------\n  # Simple BFS that returns a list of actions to move from `start` to a cell\n  # that is adjacent to `target` (including the final facing direction).\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, target, grid, non_grabbable):\n      \"\"\"Return a list of action indices to reach a cell adjacent to target.\"\"\"\n      # pre\u2011compute blocked cells (non\u2011grabbable entities)\n      blocked = np.any(grid[:, :, list(non_grabbable)] > 0, axis=2)\n\n      # all cells that are walkable (including the target itself \u2013 we never step on it)\n      walkable = ~blocked\n\n      # BFS state\n      from collections import deque\n\n      q = deque()\n      q.append((start, []))\n      visited = set()\n      visited.add(start)\n\n      # Helper to test adjacency\n      def is_adjacent(p):\n          return abs(p[0] - target[0]) + abs(p[1] - target[1]) == 1\n\n      while q:\n          (x, y), path = q.popleft()\n          if is_adjacent((x, y)):\n              # ensure the last move points towards the target\n              # (i.e., the direction from (x, y) to target)\n              dx, dy = target[0] - x, target[1] - y\n              for (vec, act) in DIRS:\n                  if vec == (dx, dy):\n                      return path + [act]\n              # if for some reason the direction is not one of the four,\n              # just return the path (will need an extra turn later)\n              return path\n\n          for (dx, dy), act in DIRS:\n              nx, ny = x + dx, y + dy\n              if (\n                  0 <= nx < grid.shape[0]\n                  and 0 <= ny < grid.shape[1]\n                  and walkable[nx, ny]\n                  and (nx, ny) not in visited\n              ):\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [act]))\n      # No path found \u2013 return empty list (the caller will fail later)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise the episode and extract useful structures.\n  # ----------------------------------------------------------------------\n  _ = env.reset()  # start a fresh episode\n  state = env._current_state  # current CraftState (internal attribute)\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  # Goal item index\n  goal = env.task.goal\n\n  # Recipe for the goal\n  recipe = env.world.cookbook.recipes[goal]\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive kinds are needed and how many of each.\n  # ----------------------------------------------------------------------\n  needed = {}\n  for k, v in recipe.items():\n      if k == \"_at\":\n          continue\n      needed[int(k)] = int(v)  # ensure plain ints\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper to update the simulated state after a move action.\n  # ----------------------------------------------------------------------\n  def apply_move(p, act):\n      for (dx, dy), a in DIRS:\n          if a == act:\n              return (p[0] + dx, p[1] + dy)\n      return p  # should never happen\n\n  # ----------------------------------------------------------------------\n  # Collect all required primitives.\n  # ----------------------------------------------------------------------\n  for kind, cnt in needed.items():\n      while cnt > 0:\n          # Locate all cells that currently contain this primitive.\n          locs = np.argwhere(grid[:, :, kind] > 0)\n          if locs.size == 0:\n              # No more instances on the map \u2013 break to avoid infinite loop.\n              break\n          # Choose the nearest one (Manhattan distance).\n          dists = np.abs(locs[:, 0] - pos[0]) + np.abs(locs[:, 1] - pos[1])\n          nearest_idx = int(np.argmin(dists))\n          target_cell = tuple(locs[nearest_idx])\n\n          # Plan a path to a cell adjacent to the target.\n          path = bfs_to_adjacent(pos, target_cell, grid, env.world.non_grabbable_indices)\n          actions.extend(path)\n\n          # Update simulated position after following the path.\n          for a in path:\n              pos = apply_move(pos, a)\n\n          # Now we are adjacent and facing the target (by construction of bfs).\n          actions.append(USE)  # pick up the primitive\n          # Simulate the pick\u2011up.\n          grid[target_cell[0], target_cell[1], kind] = 0\n          inventory[kind] += 1\n          cnt -= 1\n\n  # ----------------------------------------------------------------------\n  # Go to the appropriate workshop and craft the goal item.\n  # ----------------------------------------------------------------------\n  workshop_kind = int(recipe[\"_at\"])\n  workshop_cells = np.argwhere(grid[:, :, workshop_kind] > 0)\n  if workshop_cells.size == 0:\n      # No workshop on the map \u2013 nothing we can do.\n      return actions\n\n  # Choose the nearest workshop.\n  dists = np.abs(workshop_cells[:, 0] - pos[0]) + np.abs(workshop_cells[:, 1] - pos[1])\n  nearest_idx = int(np.argmin(dists))\n  workshop_cell = tuple(workshop_cells[nearest_idx])\n\n  # Plan path to an adjacent cell of the workshop.\n  path = bfs_to_adjacent(pos, workshop_cell, grid, env.world.non_grabbable_indices)\n  actions.extend(path)\n\n  # Update simulated position.\n  for a in path:\n      pos = apply_move(pos, a)\n\n  # Use the workshop to craft.\n  actions.append(USE)\n\n  # ----------------------------------------------------------------------\n  # Return the complete action sequence.\n  # ----------------------------------------------------------------------\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:14:16.976633", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions = []\n  act_map = env.action_specs()\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  move_delta = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n      while q:\n          pos, path = q.popleft()\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None\n\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              break\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              break\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:14:18.172575", "function_name": "make_arrow", "function_body": "  # Reset environment to start a fresh episode\n  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()  # action name \u2192 integer id\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)  # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Movement deltas for the four cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only completely empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Traversable only if the cell is completely empty\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells currently holding the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive no longer present \u2013 abort further attempts\n              break\n\n          # Plan a path to an adjacent cell\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort collection for this primitive\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate all workshop cells of the required kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the full action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:14:49.109773", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (match CraftLab's action specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper to move from current position to target using Manhattan moves\n  def _move(cur, target, act_list):\n      x, y = cur\n      tx, ty = target\n      # move in x direction\n      while x < tx:\n          act_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          act_list.append(LEFT)\n          x -= 1\n      # move in y direction\n      while y < ty:\n          act_list.append(DOWN)\n          y += 1\n      while y > ty:\n          act_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  world = env.world\n  state = env._current_state\n\n  # Determine goal index (arrow). Prefer task goal if present, otherwise look up by name.\n  goal_idx = None\n  task = getattr(env, \"task\", None)\n  if task is not None:\n      goal_idx = getattr(task, \"goal\", None)\n  if goal_idx is None:\n      # fallback to name lookup\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception:\n          raise RuntimeError(\"Unable to determine goal index for arrow.\")\n\n  # Primitive requirements for the goal (recursive expansion)\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Collect each required primitive\n  for prim_idx, needed in primitive_requirements.items():\n      # Find any location that currently contains this primitive\n      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # Primitive not present in the current grid \u2013 cannot collect\n          continue\n      target = tuple(locations[0])\n      cur_pos = _move(cur_pos, target, actions)\n      # Pick up the required amount (one USE per unit)\n      for _ in range(needed):\n          actions.append(USE)\n\n  # Move to the appropriate workshop and craft the item\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name is not None:\n      if isinstance(workshop_name, str):\n          workshop_idx = world.cookbook.index.get(workshop_name)\n      else:\n          workshop_idx = workshop_name  # assume already an index\n\n  if workshop_idx is not None:\n      ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n      if ws_locs.size > 0:\n          workshop_pos = tuple(ws_locs[0])\n          cur_pos = _move(cur_pos, workshop_pos, actions)\n\n  # Use the workshop (or current cell) to craft the goal item\n  actions.append(USE)\n\n  return actions", "env_interactions": 1, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:14:50.224400", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Retrieve action indices from the environment\n  action_map = env.action_specs()\n  DOWN = action_map.get(\"DOWN\", 0)\n  UP = action_map.get(\"UP\", 1)\n  LEFT = action_map.get(\"LEFT\", 2)\n  RIGHT = action_map.get(\"RIGHT\", 3)\n  USE = action_map.get(\"USE\", 4)\n\n  world = env.world\n  state = env._current_state\n\n  # Determine the goal index for the arrow\n  goal_idx = None\n  if hasattr(env, \"task\") and hasattr(env.task, \"goal\"):\n      goal_idx = env.task.goal\n  if goal_idx is None:\n      try:\n          goal_idx = world.cookbook.index[\"arrow\"]\n      except Exception as e:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'\") from e\n\n  # Primitive requirements for the goal (expanded to raw resources)\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # Helper to move Manhattan-style from current position to target\n  def _move_to(target):\n      nonlocal cur_pos\n      tx, ty = target\n      # Move in x direction\n      while cur_pos[0] < tx:\n          actions.append(RIGHT)\n          cur_pos = (cur_pos[0] + 1, cur_pos[1])\n      while cur_pos[0] > tx:\n          actions.append(LEFT)\n          cur_pos = (cur_pos[0] - 1, cur_pos[1])\n      # Move in y direction\n      while cur_pos[1] < ty:\n          actions.append(DOWN)\n          cur_pos = (cur_pos[0], cur_pos[1] + 1)\n      while cur_pos[1] > ty:\n          actions.append(UP)\n          cur_pos = (cur_pos[0], cur_pos[1] - 1)\n\n  # Collect each required primitive\n  for prim_idx, needed in primitive_requirements.items():\n      # Find all cells containing this primitive\n      locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # Primitive not present on the map; skip (cannot craft)\n          continue\n      # Choose the first occurrence as a target\n      target = tuple(locations[0])\n      _move_to(target)\n      # Pick up the required amount (USE once per unit)\n      for _ in range(needed):\n          actions.append(USE)\n\n  # Locate the workshop for the final crafting step\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\") or recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              ws_pos = tuple(ws_locs[0])\n              _move_to(ws_pos)\n              actions.append(USE)  # craft the arrow at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:15:14.820490", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (as defined in CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move from cur (x,y) to target (x,y) using Manhattan steps.\n  # The actions list is extended in\u2011place.\n  # ------------------------------------------------------------------\n  def _move(cur, target, act_list):\n      x, y = cur\n      tx, ty = target\n      while x < tx:\n          act_list.append(RIGHT)\n          x += 1\n      while x > tx:\n          act_list.append(LEFT)\n          x -= 1\n      while y < ty:\n          act_list.append(DOWN)\n          y += 1\n      while y > ty:\n          act_list.append(UP)\n          y -= 1\n      return (x, y)\n\n  # ------------------------------------------------------------------\n  # Access world and current state from the Lab wrapper.\n  # ------------------------------------------------------------------\n  world = env.world\n  state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Determine the index of the goal item (\"arrow\").\n  # ------------------------------------------------------------------\n  try:\n      goal_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      # Fallback: try to read from the task description.\n      goal_idx = getattr(getattr(env, \"task\", None), \"goal\", None)\n      if goal_idx is None:\n          raise RuntimeError(\"Unable to locate goal index for 'arrow'.\")\n\n  # ------------------------------------------------------------------\n  # Primitive requirements for the goal (dict {prim_idx: count}).\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(goal_idx)\n\n  actions = []\n  cur_pos = tuple(state.pos)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (may need >1 of a kind).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      while needed > 0:\n          # Locate all cells that currently contain the primitive.\n          locations = np.argwhere(state.grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # No more instances on the map \u2013 cannot satisfy requirement.\n              break\n\n          # Choose the nearest instance (Manhattan distance).\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          nearest = tuple(locations[dists.argmin()])\n\n          # Move to that cell.\n          cur_pos = _move(cur_pos, nearest, actions)\n\n          # How many units are available on that cell?\n          available = int(state.grid[nearest[0], nearest[1], prim_idx])\n          take = min(available, needed)\n\n          # Pick up the required amount.\n          for _ in range(take):\n              actions.append(USE)\n\n          needed -= take\n          # (We do not modify the simulated grid here; we only plan actions.)\n\n  # ------------------------------------------------------------------\n  # After gathering primitives, go to the appropriate workshop and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_key\")\n  if workshop_name is not None:\n      # Resolve workshop index.\n      workshop_idx = world.cookbook.index.get(workshop_name)\n      if workshop_idx is not None:\n          ws_locs = np.argwhere(state.grid[:, :, workshop_idx] > 0)\n          if ws_locs.size > 0:\n              dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n              workshop_pos = tuple(ws_locs[dists.argmin()])\n              cur_pos = _move(cur_pos, workshop_pos, actions)\n              # Use action at the workshop to craft the arrow.\n              actions.append(USE)\n\n  return actions", "env_interactions": 18, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:15:15.908548", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:15:40.726316", "function_name": "make_arrow", "function_body": "  # Reset the environment and initialise helpers\n  env.reset()\n  actions = []\n  act_map = env.action_specs()\n  move_delta = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of *action names* moving the\n  # agent from `start` to any cell that is adjacent (including diagonally)\n  # to one of the cells in `targets`.  It walks only through empty cells.\n  # ------------------------------------------------------------------\n  def bfs_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If we are adjacent (Chebyshev distance \u2264 1) to any target, stop.\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours.\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through empty cells (no entity present).\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell.\n\n  # ------------------------------------------------------------------\n  # Goal information.\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells that currently contain the primitive.\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive unavailable \u2013 skip this instance.\n              continue\n\n          path = bfs_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 skip.\n              continue\n\n          # Execute the movement actions.\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Pick up the primitive.\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the goal item.\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Craft the item at the workshop.\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the full action list.\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:15:41.837772", "function_name": "make_arrow", "function_body": "  # Reset the environment and initialize containers\n  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()                     # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  # Mapping from action names to movement deltas (row, col)\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a sequence of action names moving the agent\n  # from `start` to a cell that is adjacent (including diagonally) to any\n  # cell in `targets`.  Walks only through empty cells (grid sum == 0).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start: tuple[int, int],\n                      targets: list[tuple[int, int]],\n                      grid: np.ndarray) -> list[str] | None:\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target (Chebyshev distance \u2264 1)\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Only traverse empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Identify goal and required primitives\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          # Current state snapshot\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells that currently contain the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present on the map \u2013 skip this instance\n              continue\n\n          # Plan a path to an adjacent cell of the nearest primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 skip\n              continue\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Pick up the primitive with the USE action\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Craft the item with the USE action at the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the full action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:16:26.082549", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Helper to generate Manhattan moves from pos to target.\n  def _manhattan_path(start, target):\n      x, y = start\n      tx, ty = target\n      moves = []\n      # Move in x direction\n      while x < tx:\n          moves.append(3)   # RIGHT\n          x += 1\n      while x > tx:\n          moves.append(2)   # LEFT\n          x -= 1\n      # Move in y direction\n      while y < ty:\n          moves.append(0)   # DOWN\n          y += 1\n      while y > ty:\n          moves.append(1)   # UP\n          y -= 1\n      return moves, (x, y)\n\n  # ------------------------------------------------------------------\n  # Access world, grid and initial position from the environment.\n  # The exact attribute names may differ between implementations,\n  # so we try a few common possibilities.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # some wrappers expose the world via a nested attribute\n      world = getattr(getattr(env, \"_current_state\", None), \"world\", None)\n\n  # obtain the initial grid layout\n  grid = None\n  if hasattr(env, \"scenario\"):\n      grid = getattr(env.scenario, \"init_grid\", None)\n      init_pos = getattr(env.scenario, \"init_pos\", None)\n  if grid is None:\n      # fallback to the current state's grid (may be after a reset)\n      cur_state = getattr(env, \"_current_state\", None)\n      if cur_state is not None:\n          grid = getattr(cur_state, \"grid\", None)\n          init_pos = getattr(cur_state, \"pos\", None)\n\n  if grid is None or init_pos is None or world is None:\n      # unable to retrieve necessary information \u2013 return empty plan\n      return []\n\n  # ------------------------------------------------------------------\n  # Identify the goal index for \"arrow\".\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.get(\"arrow\")\n  if arrow_idx is None:\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine which primitive items are needed and how many of each.\n  # ------------------------------------------------------------------\n  primitive_requirements = world.cookbook.primitives_for(arrow_idx)  # dict {prim_idx: count}\n  actions = []\n  cur_pos = tuple(init_pos)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # locate all cells that contain this primitive\n      locations = np.argwhere(grid[:, :, prim_idx] > 0)\n      if locations.size == 0:\n          # primitive not present \u2013 cannot fulfill the task\n          return []\n      # we will repeatedly collect from the nearest location (simple heuristic)\n      loc_ptr = 0\n      for _ in range(needed):\n          target = tuple(locations[loc_ptr % len(locations)])\n          # move to the primitive cell\n          path, cur_pos = _manhattan_path(cur_pos, target)\n          actions.extend(path)\n          # use action to pick up the item\n          actions.append(4)   # USE\n          # after picking up, the primitive disappears from the grid,\n          # but for planning we keep using the same location list.\n          loc_ptr += 1\n\n  # ------------------------------------------------------------------\n  # Find the workshop required for crafting the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n      return []\n  workshop_idx = world.cookbook.index.get(workshop_name)\n  if workshop_idx is None:\n      return []\n\n  # locate a workshop cell\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      return []\n  workshop_pos = tuple(workshop_cells[0])\n\n  # move to the workshop\n  path, cur_pos = _manhattan_path(cur_pos, workshop_pos)\n  actions.extend(path)\n  # craft the arrow\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:16:27.191572", "function_name": "make_arrow", "function_body": "  # Initialize and fetch world information\n  actions = []\n  obs = env.reset()\n  world = env.world\n  idx = world.cookbook.index\n\n  # Index of the goal item\n  arrow_idx = idx[\"arrow\"]\n\n  # Primitive requirements for one arrow\n  needed = dict(world.cookbook.primitives_for(arrow_idx))\n\n  # Workshop type where the arrow must be crafted\n  workshop_kind = world.cookbook.recipes[arrow_idx][\"_at\"]\n  workshop_idx = idx[workshop_kind]\n\n  # Helper: convert normalized position to integer grid coordinates\n  def get_pos(o):\n      pos_norm = o[\"features_dict\"][\"pos\"]\n      grid_shape = o[\"features_dict\"][\"features_global\"].shape\n      return (\n          int(round(pos_norm[0] * (grid_shape[0] - 1))),\n          int(round(pos_norm[1] * (grid_shape[1] - 1))),\n      )\n\n  # Helper: locate all cells that contain a given kind (one\u2011hot channel)\n  def find_cells(o, kind):\n      grid = o[\"features_dict\"][\"features_global\"]\n      cells = np.argwhere(grid[:, :, kind] == 1)\n      return [tuple(c) for c in cells]\n\n  # Action mapping (DOWN, UP, LEFT, RIGHT, USE)\n  act_map = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      act_map[\"DOWN\"],\n      act_map[\"UP\"],\n      act_map[\"LEFT\"],\n      act_map[\"RIGHT\"],\n      act_map[\"USE\"],\n  )\n\n  # Simple Manhattan move generator\n  def move_to(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(RIGHT)\n          cx += 1\n      while cx > tx:\n          seq.append(LEFT)\n          cx -= 1\n      while cy < ty:\n          seq.append(DOWN)\n          cy += 1\n      while cy > ty:\n          seq.append(UP)\n          cy -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  while any(v > 0 for v in needed.values()):\n      cur_pos = get_pos(obs)\n\n      # Find the nearest needed primitive that is currently visible\n      chosen_cell = None\n      chosen_kind = None\n      for kind, cnt in needed.items():\n          if cnt <= 0:\n              continue\n          cells = find_cells(obs, kind)\n          if not cells:\n              continue\n          cells.sort(key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n          chosen_cell = cells[0]\n          chosen_kind = kind\n          break\n\n      # If we cannot see any remaining primitive, abort the loop\n      if chosen_cell is None:\n          break\n\n      # Move to the cell (or adjacent to it) and pick it up\n      path = move_to(cur_pos, chosen_cell)\n      for a in path:\n          actions.append(a)\n          _, _, obs = env.step(a)\n\n      actions.append(USE)\n      _, _, obs = env.step(USE)\n\n      # Update bookkeeping\n      needed[chosen_kind] = max(0, needed[chosen_kind] - 1)\n\n  # ------------------------------------------------------------------\n  # 2. Go to the appropriate workshop and craft the arrow\n  # ------------------------------------------------------------------\n  workshop_cells = find_cells(obs, workshop_idx)\n  if workshop_cells:\n      target_ws = workshop_cells[0]\n      cur_pos = get_pos(obs)\n      path = move_to(cur_pos, target_ws)\n      for a in path:\n          actions.append(a)\n          _, _, obs = env.step(a)\n\n      actions.append(USE)\n      _, _, obs = env.step(USE)\n\n  return actions", "env_interactions": 33, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:16:58.729943", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks\n      from ``start`` to ``goal`` using Manhattan distance. No obstacle\n      checking is performed.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Find the nearest cell that contains ``kind`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locations[nearest_idx])\n\n  # Goal index for the arrow and the primitives required to craft it.\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not found \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fallback: stand directly on the primitive cell.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (a blocked move updates direction).\n          dy = ty - cur_pos[0]\n          dx = tx - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:16:59.848367", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Initialise environment and retrieve useful objects\n  # ----------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  # Directions used for movement and BFS\n  _DIRS = [\n      (1, 0, DOWN),   # down\n      (-1, 0, UP),    # up\n      (0, -1, LEFT),  # left\n      (0, 1, RIGHT),  # right\n  ]\n\n  def _blocked_cells():\n      \"\"\"Return a 2\u2011D bool array where True indicates a cell that cannot be walked through.\"\"\"\n      if not world.non_grabbable_indices:\n          return np.zeros(grid.shape[:2], dtype=bool)\n      idxs = list(world.non_grabbable_indices)\n      return np.any(grid[:, :, idxs] > 0, axis=2)\n\n  _blocked = _blocked_cells()\n\n  def _bfs(start, goals, allow_goal_on_block=False):\n      \"\"\"\n      Bread\u2011first search from ``start`` to any cell in ``goals``.\n      Returns a list of actions (DOWN/UP/LEFT/RIGHT) that lead to the goal,\n      or an empty list if no path is found.\n      \"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      q = collections.deque()\n      q.append((start, []))\n      visited[start] = True\n      goal_set = set(goals)\n\n      while q:\n          (y, x), path = q.popleft()\n          if (y, x) in goal_set:\n              return path\n          for dy, dx, act in _DIRS:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # If the neighbour is blocked we may still enter it if it is the goal\n                  if _blocked[ny, nx] and not (allow_goal_on_block and (ny, nx) in goal_set):\n                      continue\n                  visited[ny, nx] = True\n                  q.append(((ny, nx), path + [act]))\n      return []  # no path found\n\n  def _nearest_primitive(kind, from_pos):\n      \"\"\"Find the coordinate of the closest cell containing ``kind``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[dists.argmin()]\n      return tuple(nearest)\n\n  def _adjacent_free_cells(y, x):\n      \"\"\"Return a list of free neighbour coordinates around (y, x).\"\"\"\n      H, W = grid.shape[:2]\n      cells = []\n      for dy, dx, _ in _DIRS:\n          ny, nx = y + dy, x + dx\n          if 0 <= ny < H and 0 <= nx < W and not _blocked[ny, nx]:\n              cells.append((ny, nx))\n      return cells\n\n  # ----------------------------------------------------------------------\n  # Determine the goal (arrow) and its primitive requirements\n  # ----------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          prim_loc = _nearest_primitive(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n          py, px = prim_loc\n\n          # Choose a free adjacent cell to stand on before using.\n          free_adj = _adjacent_free_cells(py, px)\n          if not free_adj:\n              # No free neighbour; fall back to standing on the primitive cell itself.\n              target_cell = (py, px)\n              allow_block = True\n          else:\n              # Pick the adjacent cell with the shortest Manhattan distance.\n              dists = [abs(py - cy) + abs(px - cx) for cy, cx in free_adj]\n              target_cell = free_adj[int(np.argmin(dists))]\n              allow_block = False\n\n          # Move to the chosen cell.\n          path = _bfs(cur_pos, [target_cell], allow_goal_on_block=allow_block)\n          actions.extend(path)\n          cur_pos = target_cell\n\n          # Face the primitive (a movement action that will be blocked updates direction).\n          dy, dx = py - cur_pos[0], px - cur_pos[1]\n          if dy > 0:\n              actions.append(DOWN)\n          elif dy < 0:\n              actions.append(UP)\n          elif dx > 0:\n              actions.append(RIGHT)\n          elif dx < 0:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update the local grid copy so that the same primitive is not reused.\n          grid[py, px, prim_idx] = 0\n          # Re\u2011compute blocked cells after removal (primitives are grabbable, so they were already blocked).\n          # No need to change _blocked because primitives are not in non_grabbable_indices.\n\n  # ----------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_locs = np.argwhere(grid[:, :, ws_idx] > 0)\n      if ws_locs.size > 0:\n          # Choose the nearest workshop cell.\n          dists = np.abs(ws_locs[:, 0] - cur_pos[0]) + np.abs(ws_locs[:, 1] - cur_pos[1])\n          ws_y, ws_x = ws_locs[dists.argmin()]\n          # Allow stepping onto the workshop cell even if it is marked as blocked.\n          path = _bfs(cur_pos, [(ws_y, ws_x)], allow_goal_on_block=True)\n          actions.extend(path)\n          cur_pos = (ws_y, ws_x)\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:17:19.380956", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a fresh episode.\n  env.reset()\n  actions = []\n\n  # Mapping from action names to integer indices.\n  action_map = env.action_specs()\n  move_names = [\"DOWN\", \"UP\", \"LEFT\", \"RIGHT\"]\n  move_inds = [action_map[name] for name in move_names if name in action_map]\n  use_ind = action_map.get(\"USE\")\n\n  # Upper bound on the number of steps we will try.\n  max_steps = getattr(env, \"max_steps\", 1000)\n\n  for _ in range(max_steps):\n      # Goal reached?  The CraftState `satisfies` method ignores the name argument.\n      if env._current_state.satisfies(\"\", env.task.goal):\n          break\n\n      # Try to use (collect/craft) in the current facing direction.\n      if use_ind is not None:\n          actions.append(use_ind)\n          reward, done, obs = env.step(use_ind)\n          if done:\n              break\n\n      # If not done, move randomly to explore the world.\n      if move_inds:\n          act = int(np.random.choice(move_inds))\n          actions.append(act)\n          reward, done, obs = env.step(act)\n          if done:\n              break\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:17:20.463794", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Reset the environment to start a new episode and obtain the initial observation.\n  # The reset may return a dictionary; we ignore its contents here.\n  try:\n      env.reset()\n  except Exception:\n      # If reset requires a seed argument, provide a default one.\n      env.reset(seed=0)\n\n  # Determine the maximum number of steps allowed in the episode.\n  # CraftLab stores this as `task.steps`; fall back to a reasonable default.\n  max_steps = getattr(getattr(env, \"task\", None), \"steps\", 1000)\n\n  # Retrieve the list of possible action integers from the environment.\n  # `action_specs()` returns a dict mapping action names to integer codes.\n  try:\n      action_values = list(env.action_specs().values())\n  except Exception:\n      # If the method is unavailable, assume 5 standard actions (0\u20114).\n      action_values = list(range(5))\n\n  actions = []\n  done = False\n  step_count = 0\n\n  # Simple random policy: keep taking random actions until the episode ends\n  # or we exceed the step limit. This generic approach works for any goal,\n  # including \u201cmake[arrow]\u201d.\n  while not done and step_count < max_steps:\n      action = int(np.random.choice(action_values))\n      actions.append(action)\n\n      # Perform the action; the step method returns (reward, done, obs).\n      try:\n          _, done, _ = env.step(action)\n      except Exception:\n          # If the environment uses a different signature, ignore the return values.\n          env.step(action)\n          done = False\n\n      step_count += 1\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:17:55.510065", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:17:56.619107", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch initial objects\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Action indices (as defined in CraftLab)\n  # --------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Helper: Manhattan path (list of actions) from src to dst\n  # --------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # --------------------------------------------------------------\n  # Helper: nearest cell (Manhattan) containing a given kind\n  # --------------------------------------------------------------\n  def _nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # --------------------------------------------------------------\n  # Helper: any cell containing a given kind (used for workshops)\n  # --------------------------------------------------------------\n  def _any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # --------------------------------------------------------------\n  # Identify the index for the goal item (\"arrow\")\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # not defined \u2192 nothing to do\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  needed = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive (respecting counts)\n  # --------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = _nearest(state.grid, prim_idx, state.pos)\n          if target is None:               # primitive missing \u2192 abort\n              return action_seq\n          # Move to the primitive cell\n          for a in _path(state.pos, target):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick it up\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # --------------------------------------------------------------\n  # If the recipe specifies a workshop, go there before crafting\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _path(state.pos, workshop_pos):\n              reward, done, obs = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n\n  # --------------------------------------------------------------\n  # Final craft action (USE) at current location (workshop or open ground)\n  # --------------------------------------------------------------\n  reward, done, obs = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:18:16.938625", "function_name": "make_arrow", "function_body": "  # direction vectors correspond to action indices: 0=DOWN,1=UP,2=LEFT,3=RIGHT,4=USE\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ----------------------------------------------------------------------\n  # Helper: breadth\u2011first search returning list of action indices\n  # ----------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should not happen in valid scenarios\n\n  # ----------------------------------------------------------------------\n  # Helper: move to a cell containing a given kind and USE it `cnt` times\n  # ----------------------------------------------------------------------\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE\n\n  # ----------------------------------------------------------------------\n  # Gather world / recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n  # ----------------------------------------------------------------------\n  # Resolve full crafting plan: primitives needed + ordered craft steps\n  # ----------------------------------------------------------------------\n  needed_prims = {}          # primitive idx \u2192 total count\n  craft_steps = []           # (item_idx, count) in dependency order\n\n  def resolve(item_idx, mul):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mul\n          return\n      # first resolve ingredients (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mul)\n      # schedule this item to be crafted after its ingredients\n      craft_steps.append((item_idx, mul))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # Build action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all primitive resources\n  for kind, cnt in needed_prims.items():\n      acquire(kind, cnt)\n\n  # 2) Perform crafting steps at required workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T16:18:18.035071", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:18:33.138737", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan path (no obstacles considered)\n  # ------------------------------------------------------------------\n  def _move_to(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(RIGHT)\n          cx += 1\n      while cx > tx:\n          seq.append(LEFT)\n          cx -= 1\n      while cy < ty:\n          seq.append(DOWN)\n          cy += 1\n      while cy > ty:\n          seq.append(UP)\n          cy -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Identify world and cookbook\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      world = env\n  cookbook = world.cookbook\n\n  # Goal information\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Required primitives for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # ------------------------------------------------------------------\n  # Obtain current state (reset if needed)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid                # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                # cells already used\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, count_needed in primitives_needed.items():\n      # Locate all cells containing this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Greedy nearest-first ordering\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= count_needed:\n              break\n          if loc in harvested:\n              continue\n          # Move to the primitive cell\n          actions.extend(_move_to(pos, loc))\n          pos = loc\n          # Pick it up\n          actions.append(USE)\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft at the appropriate workshop (if required)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Find workshop locations on the grid\n      ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_locs[0]\n          actions.extend(_move_to(pos, target_ws))\n          pos = target_ws\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:18:34.255881", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Constants for actions\n  # --------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Helper: Manhattan move sequence (ignores obstacles)\n  # --------------------------------------------------------------\n  def _move_to(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(RIGHT)\n          cx += 1\n      while cx > tx:\n          seq.append(LEFT)\n          cx -= 1\n      while cy < ty:\n          seq.append(DOWN)\n          cy += 1\n      while cy > ty:\n          seq.append(UP)\n          cy -= 1\n      return seq\n\n  # --------------------------------------------------------------\n  # Extract world, cookbook and goal information\n  # --------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      world = env                     # env might itself be a CraftWorld\n  cookbook = world.cookbook\n\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for ONE arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)\n\n  # --------------------------------------------------------------\n  # Ensure we have a fresh state (reset if needed)\n  # --------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  # Current position and static grid layout\n  pos = tuple(state.pos)\n  grid = state.grid                     # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                     # cells already taken\n\n  # --------------------------------------------------------------\n  # Collect each required primitive (greedy nearest first)\n  # --------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # locate all cells that currently contain this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed_cnt:\n              break\n          if loc in harvested:\n              continue\n          # move to the primitive cell\n          actions.extend(_move_to(pos, loc))\n          pos = loc\n          # pick it up\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n\n  # --------------------------------------------------------------\n  # Go to the appropriate workshop (if the recipe specifies one) and craft\n  # --------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string)\n      workshop_idx = cookbook.index[workshop_key] if isinstance(workshop_key, str) else workshop_key\n      # locate workshop cells\n      ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_locs[0]\n          actions.extend(_move_to(pos, target_ws))\n          pos = target_ws\n          actions.append(USE)          # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 4, "scores": {"3": 0.0}}
