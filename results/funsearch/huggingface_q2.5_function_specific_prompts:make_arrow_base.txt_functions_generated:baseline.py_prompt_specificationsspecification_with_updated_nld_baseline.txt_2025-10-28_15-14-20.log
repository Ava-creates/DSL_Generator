{"timestamp": "2025-10-28T18:29:56.281074", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n  try:\n      init_state = scenario.init()\n  except Exception:\n      try:\n          init_state = env._current_state\n      except Exception:\n          return []\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  def _state_hash(st):\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n      if len(node.actions) >= MAX_STEPS:\n          continue\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T18:30:25.087769", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Combine position, direction, inventory, and a hash of the grid layout.\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 600            # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typical action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget.\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T18:30:40.756182", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Include position, direction, inventory and the full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 800                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typical action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T18:31:09.766994", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-10-28T18:31:11.041758", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item name and index\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # copies of mutable state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of actions (DOWN,UP,LEFT,RIGHT) to reach any goal cell.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # allow stepping onto a goal cell even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update the local position according to a sequence of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect `needed` units of a primitive from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # nothing left\n          # pick the first reachable location (BFS guarantees shortest)\n          path = None\n          target_loc = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  target_loc = loc\n                  break\n          if path is None:\n              break  # cannot reach any remaining primitive\n          actions.extend(path)\n          move_along(path)\n          # pick up the primitive\n          actions.append(4)  # USE\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Guarantee at least `amount` of `item_idx` in inventory.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          # if the item is a primitive, just collect it\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # otherwise we need to craft it using its recipe\n          recipe = recipes.get(item_idx, {})\n          # first ensure all ingredients are available\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # perform the craft action\n          actions.append(4)  # USE\n          # update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:31:40.535222", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup: retrieve action indices and goal requirements.\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  goal_idx = env.task.goal\n  # Mapping primitive kind index -> count needed to craft one goal item.\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)\n\n  # Snapshot of current state (grid, position).\n  cur_state = env._current_state\n  pos = tuple(cur_state.pos)                 # (x, y)\n  grid = cur_state.grid.copy()                # mutable local copy\n\n  actions = []                                 # final action list\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS path finder that avoids non\u2011grabbable entities.\n  # Returns a list of actions moving from `start` to `target`.\n  # ----------------------------------------------------------------------\n  def bfs_path(start, target):\n      \"\"\"Return list of actions from start to target, or None if unreachable.\"\"\"\n      width, height = grid.shape[:2]\n\n      # Cells occupied by any non\u2011grabbable kind are blocked.\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Target cell may be occupied (e.g. workshop); allow stepping onto it.\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # Reconstruct actions from target back to start.\n      seq = []\n      cur = target\n      while cur != start:\n          seq.append(act_to[cur])\n          cur = parent[cur]\n      seq.reverse()\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          # Find all cells that currently contain this primitive.\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Nothing left on the map \u2013 assume we already have it in inventory.\n              break\n\n          # Choose the closest primitive (Manhattan distance) as a heuristic.\n          target = min(prim_cells,\n                       key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n          path = bfs_path(pos, target)\n          if path is None:\n              # Fallback: simple Manhattan walk (may ignore obstacles).\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          # Execute movement and pick\u2011up.\n          actions.extend(path)\n          actions.append(USE)\n\n          # Update our simulated view of the world.\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0  # primitive removed from ground.\n\n  # ----------------------------------------------------------------------\n  # If the recipe specifies a workshop, move there and craft the goal.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          # Choose nearest workshop.\n          target_ws = min(\n              workshop_cells,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs_path(pos, target_ws)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop.\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:31:41.667564", "function_name": "make_arrow", "function_body": "  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  goal = env.task.goal\n  required = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy of the grid\n  actions = []\n\n  # -----------------------------------------------------------------\n  # Helper: breadth\u2011first search returning a list of actions from start\n  # to target while avoiding non\u2011grabbable entities.\n  # -----------------------------------------------------------------\n  def bfs(start, target):\n      width, height = grid.shape[:2]\n\n      # cells occupied by any non\u2011grabbable entity are blocked\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # allow stepping onto the target cell (useful for workshops)\n      blocked[target[0], target[1]] = False\n\n      q = collections.deque([start])\n      parent = {start: None}\n      act_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for act, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in parent:\n                      parent[nxt] = cur\n                      act_to[nxt] = act\n                      q.append(nxt)\n\n      if target not in parent:\n          return None\n\n      # reconstruct action list\n      seq = []\n      cur = target\n      while cur != start:\n          seq.append(act_to[cur])\n          cur = parent[cur]\n      seq.reverse()\n      return seq\n\n  # -----------------------------------------------------------------\n  # Collect required primitives.\n  # -----------------------------------------------------------------\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          # locate all cells that currently contain this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # primitive not present on the map \u2013 assume already in inventory\n              break\n\n          # pick the nearest one (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          path = bfs(pos, target)\n          if path is None:\n              # fallback to straight Manhattan moves (may hit obstacles)\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)   # pick up the primitive\n\n          # update simulated state\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # -----------------------------------------------------------------\n  # Move to the workshop (if required) and craft the goal item.\n  # -----------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          target_ws = min(\n              workshop_cells,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = bfs(pos, target_ws)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:32:08.891018", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain useful mappings\n  env.reset()\n  act_map = env.action_specs()                     # name \u2192 integer id\n  goal_idx = env.task.goal                         # index of the desired item\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)          # workshop kind index, if any\n\n  # Cardinal movement deltas for BFS\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  actions: list[int] = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If pos is adjacent to any target cell, we are done\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Explore neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through completely empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n\n      # Check if we already have enough of each required primitive\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed.items()):\n          break\n\n      # Find a primitive that is still missing\n      for p_idx, cnt in needed.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n\n      # Locate all cells that currently contain this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Required primitive {missing_idx} not found on the map.\")\n\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive with the USE action\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:32:09.998142", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset the environment and gather useful mappings\n  env.reset()\n  act_map = env.action_specs()                     # name \u2192 integer id\n  goal_idx = env.task.goal                         # index of the desired item\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)          # workshop kind index, if any\n\n  # Cardinal movement deltas\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Walk only through completely empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed.items()):\n          break\n\n      # Find a primitive that is still missing\n      missing_idx = None\n      for p_idx, cnt in needed.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n      if missing_idx is None:\n          break\n\n      # Locate all cells that currently contain this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Required primitive {missing_idx} not found on the map.\")\n\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive with the USE action\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop is needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:32:33.291369", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # --------------------------------------------------------------------- #\n  # Helper: BFS that returns a list of movement actions from start to target.\n  # --------------------------------------------------------------------- #\n  def _bfs(start, target, grid, non_grab):\n      \"\"\"Return list of action indices to move from start to target.\n      Returns None if no path is found.\"\"\"\n      width, height = grid.shape[:2]\n\n      # Determine blocked cells (any non\u2011grabbable entity present)\n      if non_grab:\n          blocked = np.any(grid[:, :, list(non_grab)] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Allow stepping onto the target even if it is otherwise blocked\n      blocked[target[0], target[1]] = False\n\n      # BFS structures\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_to = {}\n\n      # Action mapping\n      spec = env.action_specs()\n      dirs = [\n          (spec[\"DOWN\"], (1, 0)),\n          (spec[\"UP\"], (-1, 0)),\n          (spec[\"RIGHT\"], (0, 1)),\n          (spec[\"LEFT\"], (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_to[nxt] = a\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None\n\n      # Reconstruct action list\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_to[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------------- #\n  # Gather task specifics\n  # --------------------------------------------------------------------- #\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"], spec[\"UP\"], spec[\"LEFT\"], spec[\"RIGHT\"], spec[\"USE\"]\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)               # current (x, y)\n  grid = state.grid.copy()              # occupancy tensor (W, H, n_kinds)\n  non_grab = set(env.world.non_grabbable_indices)\n\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # Collect each required primitive (including multiple copies)\n  # --------------------------------------------------------------------- #\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Find all remaining instances of this primitive on the map\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # Primitive not available; abort collection for this type\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Plan a path to the target\n          path = _bfs(pos, target, grid, non_grab)\n          if path is None:\n              # Fallback to naive Manhattan moves (ignores obstacles)\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)                     # pick up the primitive\n\n          # Update simulated position and grid (primitive removed)\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # --------------------------------------------------------------------- #\n  # Move to the appropriate workshop (if required) and craft the goal.\n  # --------------------------------------------------------------------- #\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          target_ws = min(\n              ws_locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = _bfs(pos, target_ws, grid, non_grab)\n          if path is None:\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n          actions.extend(path)\n          actions.append(USE)                     # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:32:34.471580", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # --------------------------------------------------------------------- #\n  # Action indices\n  # --------------------------------------------------------------------- #\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  # --------------------------------------------------------------------- #\n  # Goal and required primitive counts\n  # --------------------------------------------------------------------- #\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  # --------------------------------------------------------------------- #\n  # Snapshot of current state (used for planning only)\n  # --------------------------------------------------------------------- #\n  state = env._current_state\n  pos = tuple(state.pos)                # (x, y)\n  grid = state.grid.copy()               # occupancy tensor (W, H, n_kinds)\n  actions = []\n\n  # --------------------------------------------------------------------- #\n  # Helper: BFS that returns a list of movement actions from start to target.\n  # --------------------------------------------------------------------- #\n  def _bfs(start, target):\n      \"\"\"Return list of movement actions from start to target, or None.\"\"\"\n      width, height = grid.shape[:2]\n\n      # Cells that cannot be entered: any non\u2011grabbable entity present\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # Allow stepping onto the target even if it is otherwise blocked\n      blocked[target[0], target[1]] = False\n\n      # BFS structures\n      q = collections.deque([start])\n      came_from = {start: None}\n      action_to = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and not blocked[nx, ny]:\n                  nxt = (nx, ny)\n                  if nxt not in came_from:\n                      came_from[nxt] = cur\n                      action_to[nxt] = a\n                      q.append(nxt)\n\n      if target not in came_from:\n          return None\n\n      # Reconstruct action list\n      path = []\n      cur = target\n      while cur != start:\n          path.append(action_to[cur])\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # --------------------------------------------------------------------- #\n  # Collect each required primitive (multiple copies possible)\n  # --------------------------------------------------------------------- #\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Find remaining instances of this primitive on the map\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more copies left; abort further collection of this primitive\n              break\n\n          # Choose the nearest instance (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          # Plan a path to the target cell\n          path = _bfs(pos, target)\n          if path is None:\n              # Fallback: direct Manhattan moves (ignores obstacles)\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)                     # pick up the primitive\n\n          # Update simulated position and remove the primitive from the grid\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # --------------------------------------------------------------------- #\n  # Move to the appropriate workshop (if any) and craft the final item\n  # --------------------------------------------------------------------- #\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          # Choose the nearest workshop\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = _bfs(pos, target_ws)\n          if path is None:\n              # Fallback to Manhattan moves\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n          actions.extend(path)\n          actions.append(USE)                     # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
