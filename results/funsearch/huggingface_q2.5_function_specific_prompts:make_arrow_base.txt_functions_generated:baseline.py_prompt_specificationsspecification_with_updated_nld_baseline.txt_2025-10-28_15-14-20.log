{"timestamp": "2025-10-28T16:05:34.076213", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain the initial state.\n  env.reset()\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = state.pos  # (x, y)\n  direction = state.dir\n\n  world = env.world\n  cookbook = world.cookbook\n\n  # Index of the target item.\n  arrow_idx = cookbook.index[\"arrow\"]\n  recipe = cookbook.recipes[arrow_idx]\n\n  # Workshop where the arrow must be crafted.\n  workshop_idx = recipe[\"_at\"]\n\n  # Primitive requirements (exclude the workshop entry).\n  prim_counts = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Occupancy map: True where any entity occupies the cell.\n  occ = np.any(grid > 0, axis=2)  # shape (WIDTH, HEIGHT)\n\n  # Direction vectors: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n  dx = [0, 0, -1, 1]\n  dy = [1, -1, 0, 0]\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search on (x, y, direction) state space.\n  # Returns a list of movement actions that brings the agent from\n  # (sx, sy, sd) to (tx, ty, td).  Raises if no path exists.\n  # ------------------------------------------------------------------\n  def bfs(sx, sy, sd, tx, ty, td):\n      W, H = occ.shape\n      visited = np.zeros((W, H, 4), dtype=bool)\n      prev = {}\n      dq = collections.deque()\n      dq.append((sx, sy, sd))\n      visited[sx, sy, sd] = True\n      while dq:\n          x, y, d = dq.popleft()\n          if (x, y, d) == (tx, ty, td):\n              # Reconstruct path.\n              path = []\n              cur = (x, y, d)\n              while cur != (sx, sy, sd):\n                  cur_prev, act = prev[cur]\n                  path.append(act)\n                  cur = cur_prev\n              path.reverse()\n              return path\n          for a in range(4):  # movement actions\n              nx = x + dx[a]\n              ny = y + dy[a]\n              if 0 <= nx < W and 0 <= ny < H and not occ[nx, ny]:\n                  nd = a\n                  if not visited[nx, ny, nd]:\n                      visited[nx, ny, nd] = True\n                      prev[(nx, ny, nd)] = ((x, y, d), a)\n                      dq.append((nx, ny, nd))\n      raise ValueError(\"No path found\")\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in prim_counts.items():\n      for _ in range(needed):\n          # Locate remaining instances of the primitive.\n          locations = np.argwhere(grid[..., prim_idx] > 0)\n          if locations.size == 0:\n              raise ValueError(\"Required primitive not present on the map\")\n          reached = False\n          for (tx, ty) in locations:\n              # Try each direction that would let us face the primitive.\n              for d in range(4):\n                  adj_x = tx - dx[d]\n                  adj_y = ty - dy[d]\n                  if not (0 <= adj_x < occ.shape[0] and 0 <= adj_y < occ.shape[1]):\n                      continue\n                  if occ[adj_x, adj_y]:\n                      continue\n                  try:\n                      move_seq = bfs(pos[0], pos[1], direction, adj_x, adj_y, d)\n                  except ValueError:\n                      continue\n                  # Move to the chosen adjacent cell.\n                  actions.extend(move_seq)\n                  # Use action to pick up the primitive.\n                  actions.append(4)  # USE\n                  # Update internal state.\n                  pos = (adj_x, adj_y)\n                  direction = d\n                  grid[tx, ty, prim_idx] = 0\n                  occ = np.any(grid > 0, axis=2)\n                  reached = True\n                  break\n              if reached:\n                  break\n          if not reached:\n              raise ValueError(\"Unable to reach a required primitive\")\n\n  # ------------------------------------------------------------------\n  # Move to the workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  workshop_cells = np.argwhere(grid[..., workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise ValueError(\"Workshop not found on the map\")\n  crafted = False\n  for (wx, wy) in workshop_cells:\n      for d in range(4):\n          adj_x = wx - dx[d]\n          adj_y = wy - dy[d]\n          if not (0 <= adj_x < occ.shape[0] and 0 <= adj_y < occ.shape[1]):\n              continue\n          if occ[adj_x, adj_y]:\n              continue\n          try:\n              move_seq = bfs(pos[0], pos[1], direction, adj_x, adj_y, d)\n          except ValueError:\n              continue\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft\n          crafted = True\n          break\n      if crafted:\n          break\n  if not crafted:\n      raise ValueError(\"Unable to reach the workshop for crafting\")\n\n  return actions", "env_interactions": 0, "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:06:03.563560", "function_name": "make_arrow", "function_body": "  # Placeholder implementation: no actions are generated.\n  # In a full solution this would plan moves and USE actions\n  # to collect required primitives and craft the arrow.\n  return []", "env_interactions": 0, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:06:04.693325", "function_name": "make_arrow", "function_body": "  # Access current state and world configuration\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify the target item (\"arrow\") and its recipe\n  arrow_idx = cookbook.index[\"arrow\"]\n  recipe = cookbook.recipes[arrow_idx]\n\n  # Extract required ingredients (ignore the workshop entry)\n  required = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Make local mutable copies of grid, position and inventory for planning\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n\n  width, height, _ = grid.shape\n  actions = []\n\n  # Helper: BFS to find shortest path from start to any goal cell,\n  # allowing stepping onto the goal even if it is occupied.\n  from collections import deque\n\n  def bfs(start, goal_set):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goal_set:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              nxt = (nx, ny)\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if nxt in visited:\n                  continue\n              # Blocked if any entity occupies the cell, unless it is a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goal_set:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  # Gather each required primitive\n  for ing_idx, needed_cnt in required.items():\n      # Locate all cells that currently hold this ingredient\n      locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ing_idx] > 0]\n      gathered = 0\n      while gathered < needed_cnt and locations:\n          target = locations.pop(0)\n\n          # Move to the target cell\n          path = bfs(pos, {target})\n          if path is None:\n              continue\n          actions.extend(path)\n          # Simulate movement\n          for a in path:\n              if a == 0:   # DOWN\n                  pos = (pos[0], pos[1] + 1)\n              elif a == 1:  # UP\n                  pos = (pos[0], pos[1] - 1)\n              elif a == 2:  # LEFT\n                  pos = (pos[0] - 1, pos[1])\n              elif a == 3:  # RIGHT\n                  pos = (pos[0] + 1, pos[1])\n\n          # Use action to pick up the item\n          actions.append(4)  # USE\n          # Update our local copies to reflect the pickup\n          grid[target[0], target[1], ing_idx] = 0\n          inventory[ing_idx] += 1\n          gathered += 1\n\n  # Move to the appropriate workshop for crafting the arrow\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = workshop_name if isinstance(workshop_name, int) else cookbook.index[workshop_name]\n  workshop_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, workshop_idx] > 0]\n  if workshop_cells:\n      ws_target = workshop_cells[0]\n      path = bfs(pos, {ws_target})\n      if path:\n          actions.extend(path)\n          for a in path:\n              if a == 0:\n                  pos = (pos[0], pos[1] + 1)\n              elif a == 1:\n                  pos = (pos[0], pos[1] - 1)\n              elif a == 2:\n                  pos = (pos[0] - 1, pos[1])\n              elif a == 3:\n                  pos = (pos[0] + 1, pos[1])\n\n  # Finally, use the workshop to craft the arrow\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 18, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:06:29.369096", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal index and recipe information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Mapping from action names to indices\n  act_map = env.action_specs()\n\n  # Movement deltas for cardinal actions\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (including diagonally) to\n  # any cell in `targets`.  It only walks through empty cells.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If we are adjacent (including diagonal) to any target cell,\n          # we have reached a usable location.\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Only walk through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh current state\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells that currently contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 abort planning\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 abort\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n\n          # Use action to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after collecting primitives\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n\n          # Use action at the workshop to craft the item\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the computed action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:06:30.485986", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Reset environment and get initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Action mapping and movement deltas\n  act_map = env.action_specs()\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  actions = []\n\n  # BFS that returns a list of action names moving the agent from `start`\n  # to a cell adjacent (including diagonally) to any cell in `targets`.\n  def bfs_to_adjacent(start, targets, grid):\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # cell must be empty (no entity present)\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # no path found\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Refresh current state information\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells that currently contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 cannot continue\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              break  # unreachable primitive\n\n          # Execute movement actions\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n\n          # Use action to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n\n          # Use action at the workshop to craft the item\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:06:52.401306", "function_name": "make_arrow", "function_body": "  # --- Setup --------------------------------------------------------------\n  # Action indices (consistent with CraftWorld)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Resolve world and cookbook objects (works for raw CraftWorld or CraftLab)\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # CraftLab stores the world inside the current state\n      state = getattr(env, \"_current_state\", None)\n      if state is not None:\n          world = state.world\n      else:\n          # Fallback: maybe env.scenario.world exists\n          world = getattr(getattr(env, \"scenario\", None), \"world\", None)\n  cookbook = world.cookbook\n\n  # Goal we want to craft\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Obtain a fresh state (grid, position).  For CraftLab we may already have one.\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # CraftLab: env.scenario.init() creates the initial state\n      state = env.scenario.init()\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid                # shape (W, H, n_kinds)\n\n  actions = []                     # result list\n\n  # -----------------------------------------------------------------------\n  # Helper to generate a Manhattan move sequence from cur \u2192 target\n  def _move_to(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(RIGHT); cx += 1\n      while cx > tx:\n          seq.append(LEFT);  cx -= 1\n      while cy < ty:\n          seq.append(DOWN);  cy += 1\n      while cy > ty:\n          seq.append(UP);    cy -= 1\n      return seq\n\n  # Keep track of cells already harvested (avoid picking same primitive twice)\n  used_cells = set()\n\n  # -----------------------------------------------------------------------\n  # 1) Gather all required primitives\n  for prim_idx, needed_cnt in primitives_needed.items():\n      # Find all locations that currently contain this primitive\n      locs = [tuple(p) for p in __import__(\"numpy\").argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position for efficiency\n      locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locs:\n          if gathered >= needed_cnt:\n              break\n          if loc in used_cells:\n              continue\n          # Move to the primitive cell\n          actions.extend(_move_to(pos, loc))\n          pos = loc\n          # Pick it up\n          actions.append(USE)\n          used_cells.add(loc)\n          gathered += 1\n\n  # -----------------------------------------------------------------------\n  # 2) Go to the workshop for the arrow and craft it\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name string)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Locate workshop cells on the map\n      ws_locs = [tuple(p) for p in __import__(\"numpy\").argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_locs[0]\n          actions.extend(_move_to(pos, target_ws))\n          pos = target_ws\n          actions.append(USE)   # craft at the workshop\n\n  # Return the complete action list\n  return actions", "env_interactions": 22, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:06:53.513343", "function_name": "make_arrow", "function_body": "  # constants for actions (match CraftWorld ordering)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Helper to obtain the CraftWorld instance and the Cookbook\n  # ----------------------------------------------------------------------\n  # env may be a CraftLab or a raw CraftWorld; handle both.\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # CraftLab stores the underlying world in its current state\n      state = getattr(env, \"_current_state\", None)\n      if state is not None:\n          world = state.world\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance from env\")\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify goal (arrow) and its primitive requirements\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive counts needed for ONE arrow (already recursively expanded)\n  primitive_requirements = cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n\n  # ----------------------------------------------------------------------\n  # Get current state (grid, position, inventory)\n  # ----------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # If env is a raw CraftWorld, we need to initialise a scenario first\n      # Assume env has attribute 'scenario'\n      if hasattr(env, \"scenario\"):\n          state = env.scenario.init()\n      else:\n          raise RuntimeError(\"Cannot obtain current CraftState from env\")\n  pos = tuple(state.pos)                 # (x, y)\n  grid = state.grid                       # (W, H, n_kinds)\n  inventory = state.inventory.copy()      # 1\u2011D array length n_kinds\n\n  actions = []                            # plan to return\n\n  # ----------------------------------------------------------------------\n  # Simple Manhattan move generator (ignores obstacles)\n  # ----------------------------------------------------------------------\n  def _move_to(start, target):\n      cx, cy = start\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(RIGHT); cx += 1\n      while cx > tx:\n          seq.append(LEFT); cx -= 1\n      while cy < ty:\n          seq.append(DOWN); cy += 1\n      while cy > ty:\n          seq.append(UP); cy -= 1\n      return seq\n\n  # ----------------------------------------------------------------------\n  # Collect required primitives (skip those already in inventory)\n  # ----------------------------------------------------------------------\n  used_cells = set()   # locations already harvested in this plan\n\n  for prim_idx, total_needed in primitive_requirements.items():\n      already_have = int(inventory[prim_idx])\n      need = max(0, total_needed - already_have)\n      if need == 0:\n          continue\n\n      # locate all cells that currently contain this primitive\n      locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position (greedy)\n      locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n\n      gathered = 0\n      for loc in locs:\n          if gathered >= need:\n              break\n          if loc in used_cells:\n              continue\n          # move to the primitive cell\n          actions.extend(_move_to(pos, loc))\n          pos = loc\n          # pick it up\n          actions.append(USE)\n          used_cells.add(loc)\n          gathered += 1\n          # update our mental inventory & grid for subsequent planning\n          inventory[prim_idx] += 1\n          # pretend the cell is now empty (so we don't try to reuse it)\n          # (no need to modify grid as we track used_cells)\n\n      # if we couldn't find enough instances, we just stop \u2013 the plan will\n      # inevitably fail at execution time, but this is the best we can do\n      # without a full search.\n\n  # ----------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the arrow\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string or already an int)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n\n      # Find all workshop cells\n      ws_locs = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locs:\n          ws_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = ws_locs[0]\n          actions.extend(_move_to(pos, target_ws))\n          pos = target_ws\n          actions.append(USE)   # craft at the workshop\n      else:\n          # No workshop found \u2013 fall back to using current cell\n          actions.append(USE)\n  else:\n      # No specific workshop required; just use current cell to craft\n      actions.append(USE)\n\n  return actions", "env_interactions": 22, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:07:21.152455", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n  act_map = env.action_specs()\n  move_delta = {\"UP\":(-1,0),\"DOWN\":(1,0),\"LEFT\":(0,-1),\"RIGHT\":(0,1)}\n  actions = []\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited=set()\n      q=deque()\n      q.append((start,[]))\n      visited.add(start)\n      target_set=set(targets)\n      while q:\n          pos,path=q.popleft()\n          for tx,ty in target_set:\n              if abs(pos[0]-tx)<=1 and abs(pos[1]-ty)<=1:\n                  return path\n          for act,(dx,dy) in move_delta.items():\n              nx,ny=pos[0]+dx,pos[1]+dy\n              if 0<=nx<W and 0<=ny<H:\n                  if grid[nx,ny].sum()==0 and (nx,ny) not in visited:\n                      visited.add((nx,ny))\n                      q.append(((nx,ny),path+[act]))\n      return None\n  for prim_idx,count in needed.items():\n      for _ in range(count):\n          state=env._current_state\n          grid=state.grid\n          pos=state.pos\n          prim_cells=list(zip(*np.where(grid[:,:,prim_idx]>0)))\n          if not prim_cells:\n              break\n          path=bfs_to_adjacent(pos,prim_cells,grid)\n          if path is None:\n              break\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n  if workshop_kind is not None:\n      state=env._current_state\n      grid=state.grid\n      pos=state.pos\n      workshop_cells=list(zip(*np.where(grid[:,:,workshop_kind]>0)))\n      if workshop_cells:\n          path=bfs_to_adjacent(pos,workshop_cells,grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:07:22.261404", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain initial state\n  env.reset()\n  state = env._current_state\n\n  # Goal index and its recipe information\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Mapping from action name to integer id\n  act_map = env.action_specs()\n\n  # Cardinal movement deltas (used for BFS)\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent from\n  # `start` to a cell that is adjacent (including diagonally) to any cell\n  # in `targets`.  The BFS only walks through empty cells (grid sum == 0).\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # If current position is adjacent to any target cell, stop\n          for tx, ty in target_set:\n              if abs(pos[0] - tx) <= 1 and abs(pos[1] - ty) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H:\n                  # Only walk through empty cells\n                  if grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act]))\n      return None  # no reachable adjacent cell found\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive items\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          # Refresh current state (position, grid, etc.)\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Find all cells that currently contain the needed primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive missing \u2013 cannot continue; abort planning\n              break\n\n          # Find a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # No reachable primitive \u2013 abort\n              break\n\n          # Execute the movement actions\n          for act_name in path:\n              actions.append(act_map[act_name])\n              env.step(act_map[act_name])\n\n          # Use action to pick up the primitive\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the goal item\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after collecting primitives\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  actions.append(act_map[act_name])\n                  env.step(act_map[act_name])\n\n          # Use action at the workshop to craft the item\n          actions.append(act_map[\"USE\"])\n          env.step(act_map[\"USE\"])\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:07:51.011783", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Node used in BFS\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Hash function for visited states (position, direction, inventory, grid)\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                         # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # default action count (0\u20114)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:08:06.596342", "function_name": "make_arrow", "function_body": "  # Resolve the scenario and world objects from the supplied environment\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Helper to hash a state for fast visited\u2011set lookup\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  # Safety limits \u2013 adjust if the world is larger\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)   # typical action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt = cur_state.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:08:47.373457", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # Helper to move from current position to a target cell using Manhattan steps\n  # ----------------------------------------------------------------------\n  def _move_actions(cur_pos, target, act_map):\n      cx, cy = cur_pos\n      tx, ty = target\n      acts = []\n      # horizontal moves (x axis)\n      while cx < tx:\n          acts.append(act_map[\"RIGHT\"])\n          cx += 1\n      while cx > tx:\n          acts.append(act_map[\"LEFT\"])\n          cx -= 1\n      # vertical moves (y axis)\n      while cy < ty:\n          acts.append(act_map[\"DOWN\"])\n          cy += 1\n      while cy > ty:\n          acts.append(act_map[\"UP\"])\n          cy -= 1\n      return acts, (cx, cy)\n\n  # ----------------------------------------------------------------------\n  # Retrieve action index mapping from the environment\n  # ----------------------------------------------------------------------\n  action_map = {k: v for k, v in env.action_specs().items()}\n\n  # ----------------------------------------------------------------------\n  # Get the underlying world objects and recipe information\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n\n  # ----------------------------------------------------------------------\n  # Identify the goal item (\"arrow\") and its recipe\n  # ----------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # primitives required to craft one arrow (primitive_idx -> count)\n  needed_prims = cookbook.primitives_for(goal_idx)\n\n  # ----------------------------------------------------------------------\n  # Track simulated position and inventory while building the plan\n  # ----------------------------------------------------------------------\n  # reset the environment to obtain a fresh state (but do NOT step it)\n  _ = env.reset()\n  state = env._current_state          # current CraftState after reset\n  cur_pos = tuple(state.pos)          # (x, y)\n  inventory = np.copy(state.inventory)  # mutable copy\n\n  # ----------------------------------------------------------------------\n  # Function to locate the nearest cell containing a given kind index\n  # ----------------------------------------------------------------------\n  def _nearest_position(kind_idx, cur):\n      grid_layer = state.grid[..., kind_idx]\n      positions = np.argwhere(grid_layer > 0)\n      if positions.size == 0:\n          return None\n      dists = np.sum(np.abs(positions - np.array(cur)), axis=1)\n      return tuple(positions[dists.argmin()])\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ----------------------------------------------------------------------\n  plan_actions = []\n\n  for prim_idx, required_cnt in needed_prims.items():\n      while inventory[prim_idx] < required_cnt:\n          # locate nearest primitive of this type\n          target_pos = _nearest_position(prim_idx, cur_pos)\n          if target_pos is None:\n              # No more primitives of this type on the map \u2013 abort planning\n              return plan_actions\n          # move to the primitive\n          move_acts, cur_pos = _move_actions(cur_pos, target_pos, action_map)\n          plan_actions.extend(move_acts)\n          # pick it up\n          plan_actions.append(action_map[\"USE\"])\n          inventory[prim_idx] += 1  # simulate successful pickup\n\n  # ----------------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the arrow\n  # ----------------------------------------------------------------------\n  # The workshop type is stored under the special key \"_at\" in the recipe\n  workshop_kind = None\n  recipe_dict = cookbook.recipes.get(goal_idx, {})\n  if \"_at\" in recipe_dict:\n      workshop_kind = recipe_dict[\"_at\"]\n  else:\n      # fallback: some recipes store the workshop as an integer directly\n      for k, v in recipe_dict.items():\n          if isinstance(k, int) and k not in needed_prims:\n              workshop_kind = k\n              break\n\n  if workshop_kind is not None:\n      target_ws = _nearest_position(workshop_kind, cur_pos)\n      if target_ws is not None:\n          move_acts, cur_pos = _move_actions(cur_pos, target_ws, action_map)\n          plan_actions.extend(move_acts)\n          # craft at the workshop\n          plan_actions.append(action_map[\"USE\"])\n          inventory[goal_idx] += 1  # simulate successful crafting\n\n  # ----------------------------------------------------------------------\n  # Return the complete list of action indices\n  # ----------------------------------------------------------------------\n  return plan_actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:08:48.477512", "function_name": "make_arrow", "function_body": "  # reset environment\n  obs = env.reset()\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # index of the target item and its recipe\n  arrow_idx = cookbook.index[\"arrow\"]\n  req = cookbook.primitives_for(arrow_idx)          # primitive -> count\n  recipe = cookbook.recipes[arrow_idx]\n\n  # find workshop index from the recipe\n  workshop_idx = None\n  for k, v in recipe.items():\n      if isinstance(k, str):                         # usually the \"_at\" key\n          if isinstance(v, str):\n              workshop_idx = cookbook.index.get(v, None)\n          else:\n              workshop_idx = v\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions (0\u2011DOWN,1\u2011UP,2\u2011LEFT,3\u2011RIGHT)\n  # that brings the agent from start to any cell in `targets`.\n  # ------------------------------------------------------------------\n  def bfs(start, targets):\n      from collections import deque\n      w, h, _ = state.grid.shape\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate([(0, 1), (0, -1), (-1, 0), (1, 0)]):  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  blocked = state.grid[nx, ny, :].sum() != 0\n                  if not blocked or (nx, ny) in targets:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives.\n  # ------------------------------------------------------------------\n  while True:\n      inv = state.inventory\n      need = None\n      for p_idx, cnt in req.items():\n          if inv[p_idx] < cnt:\n              need = p_idx\n              break\n      if need is None:\n          break\n\n      # locate a cell that contains the needed primitive\n      positions = np.argwhere(state.grid[..., need] > 0)\n      if len(positions) == 0:\n          raise RuntimeError(\"Required primitive not found on the map\")\n      tx, ty = positions[0]\n\n      # compute empty neighbours of that cell (where we can stand)\n      w, h, _ = state.grid.shape\n      adj = []\n      for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n          ax, ay = tx + dx, ty + dy\n          if 0 <= ax < w and 0 <= ay < h and state.grid[ax, ay, :].sum() == 0:\n              adj.append((ax, ay))\n\n      path = bfs(state.pos, set(adj))\n      if path is None:\n          raise RuntimeError(\"No path to required primitive\")\n\n      # walk to the neighbour cell\n      for a in path:\n          reward, done, _ = env.step(a)\n          actions.append(a)\n          state = env._current_state\n\n      # pick up the primitive (USE)\n      reward, done, _ = env.step(4)\n      actions.append(4)\n      state = env._current_state\n\n  # ------------------------------------------------------------------\n  # Go to the workshop and craft the arrow.\n  # ------------------------------------------------------------------\n  if workshop_idx is None:\n      raise RuntimeError(\"Workshop index not found for arrow\")\n\n  workshop_cells = np.argwhere(state.grid[..., workshop_idx] > 0)\n  if len(workshop_cells) == 0:\n      raise RuntimeError(\"Workshop cell not present in the map\")\n  wx, wy = workshop_cells[0]\n\n  adj = []\n  w, h, _ = state.grid.shape\n  for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n      ax, ay = wx + dx, wy + dy\n      if 0 <= ax < w and 0 <= ay < h and state.grid[ax, ay, :].sum() == 0:\n          adj.append((ax, ay))\n\n  path = bfs(state.pos, set(adj))\n  if path is None:\n      raise RuntimeError(\"No path to workshop\")\n\n  for a in path:\n      reward, done, _ = env.step(a)\n      actions.append(a)\n      state = env._current_state\n\n  # craft the arrow (USE at workshop)\n  reward, done, _ = env.step(4)\n  actions.append(4)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:09:22.589454", "function_name": "make_arrow", "function_body": "  # Action indices as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and fetch core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable\n      obstacles using a simple BFS.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque()\n      q.append(start)\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions_rev = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      actions_rev.append(DOWN)\n                  elif py == cur[0] + 1:\n                      actions_rev.append(UP)\n                  elif px == cur[1] - 1:\n                      actions_rev.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # blocked if any non\u2011grabbable entity occupies the cell\n                  if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen in valid scenarios)\n      return []\n\n  def find_nearest(cell_kind, from_pos):\n      \"\"\"Find the nearest cell containing ``cell_kind`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, cell_kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  # ------------------------------------------------------------------\n  # Identify goal and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using\n          adj = None\n          neighbours = [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]\n          for ny, nx in neighbours:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell itself\n              adj = target\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (use a movement action that will be blocked)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:09:23.720851", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (consistent with CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Reset and obtain core objects\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_occupied(y, x):\n      \"\"\"True if the cell contains any entity (including primitives).\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` using BFS avoiding\n      occupied cells. ``goal`` must be free.\"\"\"\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = set()\n      visited.add(start)\n      while q:\n          y, x, path = q.popleft()\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_occupied(ny, nx):\n                  continue\n              new_path = path + [act]\n              if (ny, nx) == goal:\n                  return new_path\n              visited.add((ny, nx))\n              q.append((ny, nx, new_path))\n      # No path found \u2013 fall back to empty list (will likely fail later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell (y,x) to ``cell``.\n      ``avoid`` is a set of coordinates that should not be used.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_occupied(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives for 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  collected_primitives = set()            # cells already taken\n\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected_primitives)\n          if adj is None:\n              # No free neighbour; cannot collect safely \u2013 abort\n              return actions\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a movement action that will be blocked)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pickup\n          actions.append(USE)\n\n          # Update internal grid representation: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected_primitives.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand on a free neighbour of the workshop\n          ws_adj = adjacent_free(ws_cell, avoid=collected_primitives)\n          if ws_adj is None:\n              ws_adj = cur_pos  # fallback \u2013 stay where we are\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n          # Face the workshop (optional \u2013 a blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:09:35.539355", "function_name": "make_arrow", "function_body": "  import random\n\n  # Reset the environment to start a new episode and obtain the initial observation.\n  # The reset method returns an observation dict (we do not need its contents here).\n  env.reset()\n\n  actions = []\n  done = False\n  # Upper bound on the number of steps we will try before giving up.\n  max_steps = 1000\n\n  while not done and len(actions) < max_steps:\n      # Simple exploration policy: choose a random action from the 5 possible actions.\n      # Action indices follow the mapping defined in CraftLab.action_specs():\n      #   DOWN \u2192 0, UP \u2192 1, LEFT \u2192 2, RIGHT \u2192 3, USE \u2192 4\n      act = random.choice([0, 1, 2, 3, 4])\n\n      # Step the environment with the chosen action.\n      # env.step returns a tuple (reward, done, observation).\n      _, done, _ = env.step(act)\n\n      # Record the action we just performed.\n      actions.append(act)\n\n      # If the environment reports that the episode is done (goal achieved or max steps reached),\n      # we exit the loop early.\n      if done:\n          break\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
