{"timestamp": "2025-10-28T16:26:41.894313", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  moves = [\n      ((0, 1), DOWN),   # down\n      ((0, -1), UP),    # up\n      ((-1, 0), LEFT),  # left\n      ((1, 0), RIGHT),  # right\n  ]\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions moving from start to goal using BFS.\n      Cells with any non\u2011zero kind are considered blocked, except the goal\n      cell itself (which may contain the target item).\"\"\"\n      w, h = grid.shape[0], grid.shape[1]\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # Goal cell may be occupied (item we want to pick up)\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # no reachable path\n      # reconstruct\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell (Manhattan) that contains the given kind.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # Determine current position (use live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid for planning purposes\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal\n  # ------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # primitive not found \u2013 abort planning\n              return actions\n          actions.extend(bfs_path(cur_pos, target, grid))\n          actions.append(USE)                     # pick up the primitive\n          grid[target[0], target[1], prim_kind] = 0   # remove from simulated grid\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)   # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:27:09.747699", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  moves = [((0, 1), DOWN), ((0, -1), UP), ((-1, 0), LEFT), ((1, 0), RIGHT)]\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions moving from start to goal using BFS.\"\"\"\n      w, h = grid.shape[0], grid.shape[1]\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []  # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing the given kind.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  actions = []\n\n  # Determine current position (live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the static grid for planning\n  grid = env.scenario.init_grid.copy()\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal item\n  # ------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          actions.extend(bfs_path(cur_pos, target, grid))\n          actions.append(USE)                     # pick up the primitive\n          grid[target[0], target[1], prim_kind] = 0   # remove from simulated grid\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)   # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:27:10.846189", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  moves = [\n      ((0, 1), DOWN),   # down\n      ((0, -1), UP),    # up\n      ((-1, 0), LEFT),  # left\n      ((1, 0), RIGHT),  # right\n  ]\n\n  def bfs_path(start, goal, grid):\n      \"\"\"Return list of actions to move from start to goal using BFS.\n      Cells containing any non\u2011zero kind are treated as blocked, except the\n      goal cell itself (which may be occupied by the target item or workshop).\"\"\"\n      w, h = grid.shape[0], grid.shape[1]\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}  # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in moves:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # unreachable\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find nearest cell (Manhattan) containing the given kind.\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if len(xs) == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Initial state extraction\n  # ----------------------------------------------------------------------\n  # Current position (use live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Static grid copy for planning (we will modify it as we pick up items)\n  grid = env.scenario.init_grid.copy()\n\n  # Simulated inventory (starts empty)\n  inv = np.zeros(env.world.cookbook.n_kinds, dtype=int)\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ----------------------------------------------------------------------\n  # Planning utilities\n  # ----------------------------------------------------------------------\n  primitives = env.world.cookbook.primitives\n  recipes = env.world.cookbook.recipes\n\n  actions = []\n\n  def ensure_item(item_idx, count):\n      \"\"\"Make sure `inv[item_idx]` is at least `count`, updating actions.\"\"\"\n      nonlocal cur_pos, grid, inv, actions\n\n      while inv[item_idx] < count:\n          # If item is a primitive, just collect it\n          if item_idx in primitives:\n              target = nearest_kind(item_idx, cur_pos, grid)\n              if target is None:\n                  # cannot find required primitive \u2013 abort planning\n                  return False\n              actions.extend(bfs_path(cur_pos, target, grid))\n              actions.append(USE)                     # pick up\n              grid[target[0], target[1], item_idx] = 0   # remove from world\n              inv[item_idx] += 1\n              cur_pos = target\n              continue\n\n          # Otherwise we need to craft it using its recipe\n          recipe = recipes.get(item_idx, {})\n          if not recipe:\n              # No recipe and not primitive \u2013 impossible\n              return False\n\n          # First ensure all ingredient counts\n          for ing_idx, ing_cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              if not ensure_item(ing_idx, ing_cnt):\n                  return False\n\n          # Move to the required workshop (if any)\n          workshop_kind = recipe.get(\"_at\")\n          if workshop_kind is not None:\n              workshop_pos = nearest_kind(workshop_kind, cur_pos, grid)\n              if workshop_pos is None:\n                  return False\n              actions.extend(bfs_path(cur_pos, workshop_pos, grid))\n              actions.append(USE)   # perform crafting\n              cur_pos = workshop_pos\n          else:\n              # No specific workshop \u2013 just use current cell\n              actions.append(USE)\n\n          # Update simulated inventory: consume ingredients, add product\n          for ing_idx, ing_cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inv[ing_idx] -= ing_cnt\n          inv[item_idx] += 1\n      return True\n\n  # ----------------------------------------------------------------------\n  # Execute planning for the final goal\n  # ----------------------------------------------------------------------\n  ensure_item(goal_idx, 1)\n\n  # Return the assembled action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:27:31.282972", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item index and its recipe\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n  recipe = cookbook.recipes.get(target_idx, {})\n  # ingredients (ignore workshop entry)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  # ---- helper functions -------------------------------------------------\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return list of actions (0\u20113) to reach any cell in *goals*,\n      or None if unreachable.  Agent may step onto a goal cell even if it\n      is occupied.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # cell is blocked if any kind occupies it and it is not a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update *pos* according to a list of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ---- collect required primitives ---------------------------------------\n  for ing_idx, needed in ingredients.items():\n      # locate all cells that currently contain this ingredient\n      locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ing_idx] > 0]\n      collected = 0\n      while collected < needed and locations:\n          target = locations.pop(0)\n\n          # move to the target cell\n          path = bfs(pos, {target})\n          if path is None:\n              # cannot reach this instance; skip it\n              continue\n          actions.extend(path)\n          move_along(path)\n\n          # pick up the item\n          actions.append(4)          # USE\n          grid[target[0], target[1], ing_idx] = 0\n          inventory[ing_idx] += 1\n          collected += 1\n\n  # ---- go to the workshop and craft --------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # no workshop needed; just use the item if it can be crafted in place\n      actions.append(4)\n      return actions\n\n  workshop_idx = workshop_name if isinstance(workshop_name, int) else cookbook.index[workshop_name]\n  workshop_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, workshop_idx] > 0]\n\n  if workshop_cells:\n      ws_target = workshop_cells[0]\n      path = bfs(pos, {ws_target})\n      if path:\n          actions.extend(path)\n          move_along(path)\n\n  # final USE to craft the arrow\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 18, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:27:32.388653", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Identify arrow recipe\n  arrow_idx = cookbook.index[\"arrow\"]\n  recipe = cookbook.recipes[arrow_idx]\n\n  # Ingredients (ignore workshop entry)\n  required = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  # Local mutable copies for planning\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  # BFS that can step onto goal cells even if occupied\n  def bfs(start, goal_set):\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goal_set:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # Blocked if any entity occupies the cell, unless it's a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goal_set:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  # Collect each required primitive\n  for ing_idx, needed_cnt in required.items():\n      gathered = 0\n      # Locate all cells currently holding this ingredient\n      locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ing_idx] > 0]\n      while gathered < needed_cnt and locations:\n          target = locations.pop(0)\n\n          # Move to the target cell\n          path = bfs(pos, {target})\n          if path is None:\n              continue\n          actions.extend(path)\n          for a in path:\n              if a == 0:   # DOWN\n                  pos = (pos[0], pos[1] + 1)\n              elif a == 1:  # UP\n                  pos = (pos[0], pos[1] - 1)\n              elif a == 2:  # LEFT\n                  pos = (pos[0] - 1, pos[1])\n              elif a == 3:  # RIGHT\n                  pos = (pos[0] + 1, pos[1])\n\n          # Pick up the item\n          actions.append(4)  # USE\n          grid[target[0], target[1], ing_idx] = 0\n          inventory[ing_idx] += 1\n          gathered += 1\n\n  # Navigate to the workshop for crafting\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = workshop_name if isinstance(workshop_name, int) else cookbook.index[workshop_name]\n  workshop_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, workshop_idx] > 0]\n  if workshop_cells:\n      ws_target = workshop_cells[0]\n      path = bfs(pos, {ws_target})\n      if path:\n          actions.extend(path)\n          for a in path:\n              if a == 0:\n                  pos = (pos[0], pos[1] + 1)\n              elif a == 1:\n                  pos = (pos[0], pos[1] - 1)\n              elif a == 2:\n                  pos = (pos[0] - 1, pos[1])\n              elif a == 3:\n                  pos = (pos[0] + 1, pos[1])\n\n  # Craft the arrow\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 18, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:28:02.569019", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper maps between movement vectors and action indices.\n  # ----------------------------------------------------------------------\n  DIR_TO_ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search returning a list of actions that moves the agent\n  # from ``start`` to a cell *adjacent* to any cell in ``targets``.\n  # Cells containing any index from ``block_set`` are treated as obstacles.\n  # ----------------------------------------------------------------------\n  def bfs(start_pos, target_cells, grid, block_set):\n      W, H = grid.shape[:2]\n      # Build a boolean map of blocked cells.\n      blocked = np.zeros((W, H), dtype=bool)\n      for b in block_set:\n          blocked |= grid[:, :, b] > 0\n\n      sx, sy = start_pos\n      # Already adjacent?\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initialise state and extract goal information.\n  # ----------------------------------------------------------------------\n  obs = env.reset()\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Primitive requirements for the goal (expanded to primitives only).\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  block_set = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect each required primitive.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          # Locate all cells that currently contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive no longer present \u2013 abort planning.\n              return plan\n\n          # Find a path to the nearest reachable primitive (adjacent).\n          path = bfs(pos, prim_cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          # Simulate the movement to update ``pos``.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation \u2013 break to avoid infinite loop.\n              break\n\n          # Update local grid copy (remove one instance) and decrement need.\n          grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n          needed_cnt -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get('_at') or recipe.get('_key')\n  if workshop_key is not None:\n      # Resolve workshop index.\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid, block_set)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:28:03.678900", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper mappings and BFS to reach a cell adjacent to any target cell.\n  # ----------------------------------------------------------------------\n  DIR_TO_ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs(start_pos, target_cells, grid, blocked_kinds):\n      \"\"\"Return a list of actions moving from ``start_pos`` to a position\n      adjacent (Manhattan distance\u202f=\u202f1) to any cell in ``target_cells``.\n      ``grid`` has shape (W, H, K). Cells whose kind is in ``blocked_kinds``\n      are treated as obstacles.\n      \"\"\"\n      W, H = grid.shape[:2]\n      # Build a boolean map of blocked cells.\n      blocked = np.zeros((W, H), dtype=bool)\n      for kind in blocked_kinds:\n          blocked |= grid[:, :, kind] > 0\n\n      sx, sy = start_pos\n      # If we are already adjacent, no movement needed.\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell.\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacent cell.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Extract task information from the environment.\n  # ----------------------------------------------------------------------\n  # Current state and a mutable copy of the grid.\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n\n  # Goal index as stored in the task.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in the environment task.\")\n\n  # Primitive requirements for the goal (primitive kind \u2192 count).\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)\n\n  # Kinds that block movement (e.g., trees, water, etc.).\n  blocked_kinds = env.world.non_grabbable_indices\n\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ----------------------------------------------------------------------\n  for prim_kind, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          # Locate remaining instances of this primitive on the map.\n          prim_cells = np.argwhere(grid[:, :, prim_kind] > 0)\n          if prim_cells.size == 0:\n              # Not enough primitives left; abort planning.\n              return plan\n\n          # Find a path to the nearest reachable primitive (adjacent).\n          path = bfs(pos, prim_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement to update our current position.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation \u2013 break to avoid an infinite loop.\n              break\n\n          # Update the local grid copy (remove one instance) and decrement need.\n          grid[adj_cell[0], adj_cell[1], prim_kind] -= 1\n          needed_cnt -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  # Workshop can be stored under '_at' or legacy '_key'.\n  workshop_key = recipe.get('_at') or recipe.get('_key')\n  if workshop_key is not None:\n      # Resolve workshop kind index.\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid, blocked_kinds)\n          plan.extend(path)\n\n          # Simulate movement to the workshop adjacency.\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:28:34.712237", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Action / direction helpers (CraftLab action indices)\n  # ----------------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search returning a list of actions that moves the agent\n  # from ``start`` to a cell adjacent to any cell in ``targets`` while\n  # avoiding non\u2011grabbable obstacles.\n  # ----------------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return actions that move from ``start`` to a position adjacent to any\n      cell in ``targets``. ``grid`` has shape (W, H, K). Cells are blocked if\n      they contain any non\u2011grabbable entity.\"\"\"\n      W, H = grid.shape[:2]\n\n      # Build blocked mask using the environment's non\u2011grabbable indices.\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target.\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                     # mutable copy of world grid\n  pos = tuple(state.pos)                       # (x, y)\n\n  # Goal index stored in the task (could be int or struct with .goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives / intermediate items.\n  # --------------------------------------------------------------\n  for kind_idx, count_needed in needed.items():\n      while count_needed > 0:\n          # Find all cells that currently contain this kind.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present any more \u2013 abort planning.\n              return plan\n\n          # Move adjacent to the nearest such cell.\n          path = bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Identify which cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected \u2013 break to avoid infinite loop.\n              break\n\n          # Update local grid copy and decrement needed count.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count_needed -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the goal.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name string or already an int).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft by using the workshop.\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:28:35.828077", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined by CraftLab)\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,   # down (y + 1)\n      (0, -1): ACTION_UP,    # up   (y - 1)\n      (-1, 0): ACTION_LEFT,  # left (x - 1)\n      (1, 0): ACTION_RIGHT,  # right(x + 1)\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs(start, targets, grid):\n      \"\"\"\n      Bread\u2011first search returning a list of actions that moves the agent\n      from ``start`` to a cell adjacent to any cell in ``targets``.\n      \"\"\"\n      W, H = grid.shape[:2]                     # grid dimensions (x, y)\n      blocked = np.any(grid > 0, axis=2)        # any occupied cell blocks movement\n      sx, sy = start\n\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                 # mutable copy of the world grid\n  pos = tuple(state.pos)                   # (x, y)\n\n  # Goal index (stored in env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal not found in env.task\")\n\n  # Primitive requirements for the goal (including intermediate items)\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, cnt_needed in needed.items():\n      while cnt_needed > 0:\n          # Locate cells that currently contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive unavailable \u2013 abort planning\n              return plan\n\n          # Find path to a position adjacent to the nearest primitive\n          path = bfs(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected; break to avoid infinite loop\n              break\n\n          # Update local grid copy and decrement needed count\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt_needed -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (name or integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:28:54.609879", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Helper functions\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(pos, target, seq):\n      \"\"\"Append actions that move the agent from `pos` to `target`.\"\"\"\n      while pos[0] != target[0] or pos[1] != target[1]:\n          if pos[0] < target[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > target[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < target[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > target[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing `kind_idx` (Manhattan distance).\"\"\"\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Planning start\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # Determine current position (use env's current state if it exists)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid so we can mark primitives as taken\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index (the environment's task goal)\n  goal_idx = env.task.goal\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal\n  # ----------------------------------------------------------------------\n  primitive_requirements = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, needed in primitive_requirements.items():\n      for _ in range(needed):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not present \u2013 abort planning (return what we have)\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)          # pick up the primitive\n          grid[target[1], target[0], prim_kind] = 0   # remove from our copy\n\n  # ----------------------------------------------------------------------\n  # 2. Go to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)          # craft at the workshop\n\n  # Return the full action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:28:55.723576", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _move_to(pos, tgt, seq):\n      \"\"\"Append actions to move from pos to tgt (both [x, y] lists).\"\"\"\n      while pos[0] != tgt[0] or pos[1] != tgt[1]:\n          if pos[0] < tgt[0]:\n              seq.append(RIGHT)\n              pos[0] += 1\n          elif pos[0] > tgt[0]:\n              seq.append(LEFT)\n              pos[0] -= 1\n          elif pos[1] < tgt[1]:\n              seq.append(DOWN)\n              pos[1] += 1\n          elif pos[1] > tgt[1]:\n              seq.append(UP)\n              pos[1] -= 1\n\n  def _nearest_kind(kind_idx, cur_pos, g):\n      \"\"\"Return [x, y] of the nearest cell containing kind_idx, or None.\"\"\"\n      ys, xs = np.where(g[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ----------------------------------------------------------------------\n  # Begin planning\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # Determine current position (use internal state if present)\n  if hasattr(env, \"_current_state\"):\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the grid to track taken items\n  grid = env.scenario.init_grid.copy()\n\n  # Index of the goal item\n  goal_idx = env.task.goal\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all primitive resources required for the goal\n  # ----------------------------------------------------------------------\n  primitive_reqs = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_kind, count in primitive_reqs.items():\n      for _ in range(count):\n          target = _nearest_kind(prim_kind, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)  # pick up primitive\n          # Mark the primitive as collected in our grid copy\n          grid[target[1], target[0], prim_kind] = 0\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)  # craft at the workshop\n\n  # Return the planned sequence of actions\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:29:27.663789", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper: map movement vectors to action indices (as defined in CraftLab)\n  # ----------------------------------------------------------------------\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of actions moving from `start`\n  # to a cell that is adjacent to any cell in `target_cells`.\n  # ----------------------------------------------------------------------\n  def bfs(start, target_cells, grid):\n      \"\"\"Return actions to reach a neighbour of one of `target_cells`.\"\"\"\n      w, h = grid.shape[:2]                     # width, height\n      blocked = np.any(grid > 0, axis=2)        # any occupied cell blocks movement\n      sx, sy = start\n\n      # already adjacent?\n      for tx, ty in target_cells:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((w, h), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # check adjacency to any target cell\n                  for tx, ty in target_cells:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # no reachable neighbour \u2013 return empty list (fallback)\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for planning\n  pos = state.pos                   # (x, y)\n\n  # Goal index (the item we must make)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Cannot determine goal index from environment.\")\n\n  # ------------------------------------------------------------------\n  # 1. Determine primitive requirements for the goal.\n  # ------------------------------------------------------------------\n  primitives_needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  # If the recipe is empty, the goal itself may be a primitive we just need to pick up.\n  if not primitives_needed:\n      primitives_needed = {goal_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 2. Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      while needed_cnt > 0:\n          # locate cells that currently contain this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # cannot find required primitive \u2013 abort planning\n              break\n\n          # find path to a neighbour of the nearest primitive cell\n          path = bfs(pos, prim_cells.tolist(), grid)\n          actions.extend(path)\n\n          # update simulated position\n          for a in path:\n              dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # use the primitive (pick it up)\n          actions.append(4)   # USE\n\n          # remove one instance from the simulated grid and decrement counter\n          # find a primitive cell adjacent to current position\n          adj_cell = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is not None:\n              grid[adj_cell[0], adj_cell[1], prim_idx] -= 1\n              needed_cnt -= 1\n          else:\n              # should not happen; break to avoid infinite loop\n              break\n\n  # ------------------------------------------------------------------\n  # 3. Move to the appropriate workshop and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")   # support both possible keys\n\n  if workshop_key is not None:\n      # workshop may be given as a name (string) \u2013 resolve to index\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          actions.extend(path)\n\n          # update simulated position\n          for a in path:\n              dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # finally use the workshop to craft the item\n          actions.append(4)   # USE\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:29:28.766235", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helper: map movement vectors to the action indices used by CraftLab\n  # ----------------------------------------------------------------------\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search that returns a list of actions moving the agent from\n  # `start` to a cell that is *adjacent* (Manhattan distance 1) to any cell\n  # in `targets`.  Cells occupied by any entity are considered blocked.\n  # ----------------------------------------------------------------------\n  def bfs_adjacent(start, targets, grid):\n      H, W = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n\n      # Early exit if already adjacent\n      sx, sy = start\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((H, W), False, dtype=bool)\n      visited[sy, sx] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[ny, nx]:\n                  if blocked[ny, nx]:\n                      continue\n                  new_path = path + [act]\n                  # check adjacency to any target cell\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return new_path\n                  visited[ny, nx] = True\n                  q.append((nx, ny, new_path))\n      # No reachable adjacent cell\n      return []\n\n  # ----------------------------------------------------------------------\n  # Main planning logic\n  # ----------------------------------------------------------------------\n  # Reset (or just read) the current state\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for planning\n  pos = state.pos                   # (x, y)\n\n  # Goal: make an arrow\n  arrow_idx = env.world.cookbook.index.get('arrow')\n  if arrow_idx is None:\n      raise ValueError(\"Arrow item not found in cookbook index.\")\n\n  # Primitive requirements for ONE arrow (expanded recursively)\n  needed = env.world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      while count > 0:\n          # locate all cells that currently hold this primitive\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              raise RuntimeError(f\"Required primitive {prim_idx} not present on the map.\")\n          # choose the nearest primitive (Manhattan distance)\n          dists = np.abs(prim_cells - np.array(pos)).sum(axis=1)\n          target_cell = tuple(prim_cells[dists.argmin()])   # (x, y)\n\n          # move adjacent to the chosen primitive\n          path = bfs_adjacent(pos, [target_cell], grid)\n          actions.extend(path)\n          # update simulated position\n          for a in path:\n              dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # use action to pick up the primitive\n          actions.append(4)   # USE\n          # update simulated grid: remove one instance from the primitive cell\n          grid[target_cell[1], target_cell[0], prim_idx] -= 1\n          count -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Go to the workshop for the arrow and craft it\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(arrow_idx, {})\n  workshop_key = recipe.get('_at')\n  if workshop_key is None:\n      # No explicit workshop \u2013 nothing else to do\n      return actions\n\n  # Resolve workshop index (may be a string name)\n  if isinstance(workshop_key, str):\n      workshop_idx = env.world.cookbook.index[workshop_key]\n  else:\n      workshop_idx = workshop_key\n\n  workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n  if workshop_cells.size == 0:\n      raise RuntimeError(\"Workshop for arrow not found on the map.\")\n\n  # pick the nearest workshop cell\n  dists = np.abs(workshop_cells - np.array(pos)).sum(axis=1)\n  target_ws = tuple(workshop_cells[dists.argmin()])\n\n  # move adjacent to the workshop\n  path = bfs_adjacent(pos, [target_ws], grid)\n  actions.extend(path)\n  for a in path:\n      dx, dy = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}[a]\n      pos = (pos[0] + dx, pos[1] + dy)\n\n  # final USE to craft the arrow\n  actions.append(4)   # USE\n\n  return actions", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:29:48.685648", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch initial state information\n  env.reset()\n  state = env._current_state\n\n  # Goal and recipe information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {primitive_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Mapping from action name to integer ID\n  act_map = env.action_specs()\n\n  # Cardinal movement deltas\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  ( 1, 0),\n      \"LEFT\":  ( 0,-1),\n      \"RIGHT\": ( 0, 1),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent from\n  # `start` to a cell that is adjacent (Chebyshev distance \u2264 1) to any cell\n  # in `targets`. Only empty cells may be traversed.\n  # ----------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Only walk through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect each required primitive the needed number of times\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Refresh current state\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate cells that currently contain the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 cannot proceed further\n              break\n\n          # Plan a path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort collection for this primitive\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Use action to pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      # Refresh state after primitive collection\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate workshop cells of the appropriate kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use action at the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:29:49.795808", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n\n  # Goal information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Action name \u2192 integer mapping\n  act_map = env.action_specs()\n\n  # Movement deltas for each cardinal action name\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`. Only empty cells may be traversed.\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Only walk through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  actions = []\n\n  # 1) Collect each required primitive the needed number of times\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Refresh current state\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate cells that currently contain the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present \u2013 cannot proceed\n              break\n\n          # Plan path to the nearest primitive (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable \u2013 abort collection\n              break\n\n          # Execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Use action to pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # 2) Move to the required workshop (if any) and craft the goal item\n  if workshop_kind is not None:\n      # Refresh state after primitive collection\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate workshop cells of the appropriate kind\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Use action at the workshop to craft the item\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled action sequence (list of integer action IDs)\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:30:21.375812", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Reset environment and fetch core objects\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def cell_occupied(y, x):\n      \"\"\"Return True if any entity occupies the cell.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding occupied cells.\"\"\"\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          y, x, path = q.popleft()\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if cell_occupied(ny, nx):\n                  continue\n              new_path = path + [act]\n              if (ny, nx) == goal:\n                  return new_path\n              visited.add((ny, nx))\n              q.append((ny, nx, new_path))\n      # No path found \u2013 return empty list (will likely fail later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbouring cell to ``cell`` not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not cell_occupied(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives for 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  collected = set()                       # cells already harvested\n\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=collected)\n          if adj is None:\n              # No free neighbour; abort\n              return actions\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (blocked move sets direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pickup\n          actions.append(USE)\n\n          # Update internal grid: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              # If no free neighbour, stay where we are (will still try to USE)\n              ws_adj = cur_pos\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:30:22.499245", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Reset environment and fetch core objects\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any kind occupies it.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions to reach a free goal cell.\"\"\"\n      if start == goal:\n          return []\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      while q:\n          y, x, path = q.popleft()\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              new_path = path + [act]\n              if (ny, nx) == goal:\n                  return new_path\n              visited.add((ny, nx))\n              q.append((ny, nx, new_path))\n      # No path found \u2013 return empty list (will likely fail later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell (by Manhattan distance) containing kind_idx.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = locs[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell, avoid=set()):\n      \"\"\"Return a free neighbour of ``cell`` not in ``avoid``.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives for 'arrow'\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  taken_cells = set()                     # primitives already collected\n\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up.\n          adj = free_adjacent(target, avoid=taken_cells)\n          if adj is None:\n              # No free neighbour; cannot safely collect.\n              return actions\n\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked move to set direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pickup the primitive.\n          actions.append(USE)\n\n          # Update internal grid and record the cell as taken.\n          grid[target[0], target[1], prim_idx] = 0\n          taken_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = free_adjacent(ws_cell, avoid=taken_cells)\n          if ws_adj is None:\n              # Fallback: stay where we are if no free neighbour.\n              ws_adj = cur_pos\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (blocked move to set direction).\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T16:30:53.623177", "function_name": "make_arrow", "function_body": "  # Reset the environment to obtain a fresh initial state.\n  env.reset()\n  # The current internal CraftState after reset.\n  init_state = env._current_state\n\n  # Goal index for the current task (e.g., \"arrow\").\n  goal_idx = env.task.goal\n\n  # Breadth\u2011first search over state space with a modest depth limit.\n  from collections import deque\n\n  max_depth = 50                     # safety bound on plan length\n  n_actions = env.world.n_actions    # number of possible actions\n\n  # Helper to create a hashable representation of a state.\n  def _state_key(st):\n      return (\n          st.grid.tobytes(),\n          st.pos,\n          st.dir,\n          st.inventory.tobytes()\n      )\n\n  start_key = _state_key(init_state)\n  visited = {start_key}\n  queue = deque()\n  queue.append((init_state, []))\n\n  while queue:\n      cur_state, cur_actions = queue.popleft()\n\n      # Goal reached?\n      if cur_state.satisfies(\"\", goal_idx):\n          return cur_actions\n\n      # Depth limit.\n      if len(cur_actions) >= max_depth:\n          continue\n\n      # Expand all possible actions.\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key in visited:\n              continue\n          visited.add(key)\n          queue.append((next_state, cur_actions + [a]))\n\n  # If no plan found within the depth limit, return an empty list.\n  return []", "env_interactions": 0, "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:30:54.739410", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  actions = []\n  # Get the goal index for the current task\n  goal = env.task.goal\n\n  # Determine which primitive resources are required for this goal\n  needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}\n\n  # Current state information\n  state = env._current_state\n  pos = tuple(state.pos)  # (x, y)\n\n  # Helper to translate a delta into action indices using the env's spec\n  spec = env.action_specs()\n  DOWN = spec['DOWN']\n  UP = spec['UP']\n  LEFT = spec['LEFT']\n  RIGHT = spec['RIGHT']\n  USE = spec['USE']\n\n  def _move_actions(cur, tgt):\n      \"\"\"Return a list of movement actions to go from cur to tgt.\"\"\"\n      moves = []\n      dx = tgt[0] - cur[0]\n      dy = tgt[1] - cur[1]\n      while dx != 0:\n          if dx > 0:\n              moves.append(DOWN)\n              dx -= 1\n          else:\n              moves.append(UP)\n              dx += 1\n      while dy != 0:\n          if dy > 0:\n              moves.append(RIGHT)\n              dy -= 1\n          else:\n              moves.append(LEFT)\n              dy += 1\n      return moves\n\n  # Collect each required primitive\n  for prim_idx, cnt in needed.items():\n      # Find all cells that currently contain this primitive\n      locations = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n      for _ in range(cnt):\n          if not locations:\n              break  # safety \u2013 no more of this primitive on the map\n          target = locations.pop(0)\n\n          # Move next to the primitive (simple Manhattan walk)\n          actions.extend(_move_actions(pos, target))\n          pos = target\n\n          # Pick it up\n          actions.append(USE)\n\n  # After having the ingredients, go to the appropriate workshop and craft\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(state.grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target = ws_locs[0]\n          actions.extend(_move_actions(pos, target))\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:31:27.849964", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Helpers\n  # ------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN = spec[\"DOWN\"]\n  UP = spec[\"UP\"]\n  LEFT = spec[\"LEFT\"]\n  RIGHT = spec[\"RIGHT\"]\n  USE = spec[\"USE\"]\n\n  def _delta_to_action(dx, dy):\n      \"\"\"Convert a grid delta into the corresponding movement action.\"\"\"\n      if dx == 1:\n          return DOWN\n      if dx == -1:\n          return UP\n      if dy == 1:\n          return RIGHT\n      if dy == -1:\n          return LEFT\n      raise ValueError(\"Invalid delta for movement\")\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"\n      Bread\u2011first search on the occupancy grid.\n      Cells where any kind > 0 are considered blocked,\n      except the goal cell itself which is allowed.\n      Returns a list of positions from start to goal (inclusive).\n      \"\"\"\n      width, height = grid.shape[:2]\n      occupied = np.any(grid > 0, axis=2)\n\n      # allow stepping onto the goal cell even if occupied\n      occupied[goal[0], goal[1]] = False\n\n      q = collections.deque()\n      q.append(start)\n      came_from = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          x, y = cur\n          for nx, ny in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):\n              if 0 <= nx < width and 0 <= ny < height:\n                  if not occupied[nx, ny] and (nx, ny) not in came_from:\n                      came_from[(nx, ny)] = cur\n                      q.append((nx, ny))\n      else:\n          # no path found\n          return []\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = came_from[cur]\n      path.reverse()\n      return path\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n\n  # goal index for the current task\n  goal_idx = env.task.goal\n\n  # primitive requirements for the goal\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # current state snapshot\n  state = env._current_state\n  cur_pos = tuple(state.pos)  # (x, y)\n  grid = state.grid\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate all cells that currently contain this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # no more of this primitive on the map \u2013 abort planning\n              break\n\n          # pick the nearest one (Manhattan distance as heuristic)\n          distances = [abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in prim_cells]\n          target = prim_cells[int(np.argmin(distances))]\n\n          # compute a path to the target cell\n          path = _bfs_path(cur_pos, target, grid)\n          if not path:\n              # fallback to direct Manhattan moves if BFS fails\n              dx = target[0] - cur_pos[0]\n              dy = target[1] - cur_pos[1]\n              while dx != 0:\n                  actions.append(DOWN if dx > 0 else UP)\n                  dx += -1 if dx > 0 else 1\n              while dy != 0:\n                  actions.append(RIGHT if dy > 0 else LEFT)\n                  dy += -1 if dy > 0 else 1\n          else:\n              # translate path steps into actions (skip the first cell \u2013 current pos)\n              for nxt in path[1:]:\n                  act = _delta_to_action(nxt[0] - cur_pos[0], nxt[1] - cur_pos[1])\n                  actions.append(act)\n                  cur_pos = nxt\n\n          # now we are on the primitive cell; pick it up\n          actions.append(USE)\n\n          # update local grid snapshot to reflect that the primitive has been taken\n          grid[cur_pos[0], cur_pos[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop and craft the item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if workshop_cells:\n          # choose the nearest workshop\n          distances = [\n              abs(cur_pos[0] - x) + abs(cur_pos[1] - y) for (x, y) in workshop_cells\n          ]\n          target_ws = workshop_cells[int(np.argmin(distances))]\n\n          path = _bfs_path(cur_pos, target_ws, grid)\n          if not path:\n              dx = target_ws[0] - cur_pos[0]\n              dy = target_ws[1] - cur_pos[1]\n              while dx != 0:\n                  actions.append(DOWN if dx > 0 else UP)\n                  dx += -1 if dx > 0 else 1\n              while dy != 0:\n                  actions.append(RIGHT if dy > 0 else LEFT)\n                  dy += -1 if dy > 0 else 1\n          else:\n              for nxt in path[1:]:\n                  act = _delta_to_action(nxt[0] - cur_pos[0], nxt[1] - cur_pos[1])\n                  actions.append(act)\n                  cur_pos = nxt\n\n          # perform the crafting action\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:31:28.961175", "function_name": "make_arrow", "function_body": "  actions = []\n  state = env._current_state\n  pos = tuple(state.pos)\n\n  spec = env.action_specs()\n  DOWN = spec['DOWN']\n  UP = spec['UP']\n  LEFT = spec['LEFT']\n  RIGHT = spec['RIGHT']\n  USE = spec['USE']\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}\n\n  # Work on a mutable copy of the grid so we can \u201cremove\u201d items as we pick them up.\n  grid = state.grid.copy()\n\n  def _move_actions(cur, tgt):\n      \"\"\"Return a list of movement actions to go from cur to tgt using Manhattan steps.\"\"\"\n      moves = []\n      dx = tgt[0] - cur[0]\n      dy = tgt[1] - cur[1]\n      while dx != 0:\n          if dx > 0:\n              moves.append(DOWN)\n              dx -= 1\n          else:\n              moves.append(UP)\n              dx += 1\n      while dy != 0:\n          if dy > 0:\n              moves.append(RIGHT)\n              dy -= 1\n          else:\n              moves.append(LEFT)\n              dy += 1\n      return moves\n\n  # Collect each required primitive the needed number of times.\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              break  # No more of this primitive on the map.\n          # Choose the closest occurrence (Manhattan distance).\n          target = min(locations,\n                       key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n          actions.extend(_move_actions(pos, target))\n          pos = target\n          actions.append(USE)\n          # Simulate picking up the item.\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # After gathering primitives, go to the appropriate workshop and craft.\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target = ws_locs[0]\n          actions.extend(_move_actions(pos, target))\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:31:56.279324", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects (they may be nested)\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the desired item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      start_state = scenario.init()\n  except Exception:\n      return []\n\n  # Simple breadth\u2011first search over the deterministic state space\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # Hash includes position, direction, inventory and the full grid layout\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(start_state)}\n  frontier = deque([Node(start_state, [])])\n\n  MAX_STEPS = 400                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 actions (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:32:12.034193", "function_name": "make_arrow", "function_body": "  # Obtain scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to hash a state for fast visited\u2011set lookup\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # typical action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt = cur_state.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T16:32:51.263308", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan path (list of actions) from src to dst\n  # ------------------------------------------------------------------\n  def _manhattan_path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper: find nearest cell (Manhattan) containing a given kind\n  # ------------------------------------------------------------------\n  def _nearest_cell(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _any_cell(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Initialise a fresh episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the goal index for \"arrow\"\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # unknown goal\n      return []\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # ------------------------------------------------------------------\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (respecting counts)\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      for _ in range(cnt):\n          target = _nearest_cell(state.grid, prim_idx, state.pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return action_seq\n          # Move to the primitive cell\n          for a in _manhattan_path(state.pos, target):\n              _, done, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n          # Pick it up (USE)\n          _, done, _ = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  # ------------------------------------------------------------------\n  # If the recipe specifies a workshop, move there before crafting\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      workshop_pos = _any_cell(state.grid, workshop_idx)\n      if workshop_pos is not None:\n          for a in _manhattan_path(state.pos, workshop_pos):\n              _, done, _ = env.step(a)\n              state = env._current_state\n              action_seq.append(a)\n              if done:\n                  return action_seq\n\n  # ------------------------------------------------------------------\n  # Craft the arrow (USE at current location)\n  # ------------------------------------------------------------------\n  _, done, _ = env.step(USE)\n  action_seq.append(USE)\n\n  return action_seq", "env_interactions": 21, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:32:52.382196", "function_name": "make_arrow", "function_body": "  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan path from src to dst (list of actions)\n  # ------------------------------------------------------------------\n  def _path(src, dst):\n      actions = []\n      r, c = src\n      tr, tc = dst\n      while r != tr:\n          if r < tr:\n              actions.append(DOWN)\n              r += 1\n          else:\n              actions.append(UP)\n              r -= 1\n      while c != tc:\n          if c < tc:\n              actions.append(RIGHT)\n              c += 1\n          else:\n              actions.append(LEFT)\n              c -= 1\n      return actions\n\n  # ------------------------------------------------------------------\n  # Helper: locate nearest cell containing a given kind (Manhattan distance)\n  # ------------------------------------------------------------------\n  def _nearest(grid, kind_idx, start):\n      h, w, _ = grid.shape\n      best = None\n      best_dist = None\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  d = abs(i - start[0]) + abs(j - start[1])\n                  if best_dist is None or d < best_dist:\n                      best_dist = d\n                      best = (i, j)\n      return best\n\n  # ------------------------------------------------------------------\n  # Helper: locate any cell containing a given kind (used for workshops)\n  # ------------------------------------------------------------------\n  def _any(grid, kind_idx):\n      h, w, _ = grid.shape\n      for i in range(h):\n          for j in range(w):\n              if grid[i, j, kind_idx] > 0:\n                  return (i, j)\n      return None\n\n  # ------------------------------------------------------------------\n  # Initialise episode\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the goal index for \"arrow\"\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:          # unknown goal \u2013 nothing to do\n      return []\n\n  # ------------------------------------------------------------------\n  # Build a post\u2011order list of items that must be crafted (including arrow)\n  # ------------------------------------------------------------------\n  def _craft_order(goal_idx):\n      order = []\n      visited = set()\n\n      def _dfs(item):\n          if item in visited:\n              return\n          visited.add(item)\n          recipe = world.cookbook.recipes.get(item, {})\n          for ing, cnt in recipe.items():\n              if ing == \"_at\":\n                  continue\n              _dfs(ing)\n          order.append(item)\n\n      _dfs(goal_idx)\n      return order\n\n  craft_sequence = _craft_order(arrow_idx)\n\n  # Set of primitive kind indices for quick lookup\n  primitive_set = world.cookbook.primitives\n\n  action_seq = []\n\n  # ------------------------------------------------------------------\n  # Execute the plan: for each item in the post\u2011order list, ensure its\n  # ingredients are present, then move to its workshop (if any) and craft.\n  # ------------------------------------------------------------------\n  for item_idx in craft_sequence:\n      recipe = world.cookbook.recipes.get(item_idx, {})\n\n      # --------------------------------------------------------------\n      # Satisfy ingredient requirements (collect primitives as needed)\n      # --------------------------------------------------------------\n      for ing_idx, need_cnt in recipe.items():\n          if ing_idx == \"_at\":\n              continue\n          # Keep collecting / crafting until we have enough of this ingredient\n          while state.inventory[ing_idx] < need_cnt:\n              if ing_idx in primitive_set:\n                  # ---- Collect primitive from the world -----------------\n                  target = _nearest(state.grid, ing_idx, state.pos)\n                  if target is None:\n                      # Primitive not available \u2013 abort early\n                      return action_seq\n                  for a in _path(state.pos, target):\n                      reward, done, obs = env.step(a)\n                      state = env._current_state\n                      action_seq.append(a)\n                      if done:\n                          return action_seq\n                  # Pick it up\n                  reward, done, obs = env.step(USE)\n                  state = env._current_state\n                  action_seq.append(USE)\n                  if done:\n                      return action_seq\n              else:\n                  # ---- Craft the missing non\u2011primitive ingredient -------\n                  sub_recipe = world.cookbook.recipes.get(ing_idx, {})\n                  workshop_name = sub_recipe.get(\"_at\")\n                  if workshop_name is not None:\n                      ws_idx = world.cookbook.index.index(workshop_name)\n                      ws_pos = _any(state.grid, ws_idx)\n                      if ws_pos is not None:\n                          for a in _path(state.pos, ws_pos):\n                              reward, done, obs = env.step(a)\n                              state = env._current_state\n                              action_seq.append(a)\n                              if done:\n                                  return action_seq\n                          reward, done, obs = env.step(USE)\n                          state = env._current_state\n                          action_seq.append(USE)\n                          if done:\n                              return action_seq\n                  else:\n                      # No workshop required \u2013 just use the action\n                      reward, done, obs = env.step(USE)\n                      state = env._current_state\n                      action_seq.append(USE)\n                      if done:\n                          return action_seq\n\n      # --------------------------------------------------------------\n      # All ingredients ready \u2013 craft the current item\n      # --------------------------------------------------------------\n      workshop_name = recipe.get(\"_at\")\n      if workshop_name is not None:\n          ws_idx = world.cookbook.index.index(workshop_name)\n          ws_pos = _any(state.grid, ws_idx)\n          if ws_pos is not None:\n              for a in _path(state.pos, ws_pos):\n                  reward, done, obs = env.step(a)\n                  state = env._current_state\n                  action_seq.append(a)\n                  if done:\n                      return action_seq\n              reward, done, obs = env.step(USE)\n              state = env._current_state\n              action_seq.append(USE)\n              if done:\n                  return action_seq\n      else:\n          # Craft in place\n          reward, done, obs = env.step(USE)\n          state = env._current_state\n          action_seq.append(USE)\n          if done:\n              return action_seq\n\n  return action_seq", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:33:20.462895", "function_name": "make_arrow", "function_body": "  # Mapping between movement direction vectors and action indices.\n  DIR2ACT = {(0, 1): 0,    # DOWN\n             (0, -1): 1,   # UP\n             (-1, 0): 2,   # LEFT\n             (1, 0): 3}    # RIGHT\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_adjacent(start, targets, grid):\n      \"\"\"Return a list of actions that moves the agent from ``start`` to a\n      cell adjacent (Manhattan distance 1) to any coordinate in ``targets``.\n      ``grid`` has shape (W, H, K); any non\u2011zero entry in the last axis is\n      considered blocked for movement.\n      \"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n      # Already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency.\n      return []\n\n  # ------------------------------------------------------------------\n  # Main planning logic.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()               # mutable copy for simulation\n  pos = tuple(state.pos)                 # (x, y)\n\n  # Goal index is stored in the task (env.task.goal).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Determine all primitive requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect each required primitive.\n  # --------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          # Locate cells that still contain this primitive.\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present on the map \u2013 abort planning.\n              return plan\n\n          # Compute a path to the nearest reachable primitive (adjacent).\n          path = bfs_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to update position.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(4)   # USE\n\n          # Identify which primitive cell we are now adjacent to.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop.\n              break\n\n          # Update local grid copy (remove one instance) and decrement need.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or already an int).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      # Locate workshop cells.\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to workshop.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop.\n          plan.append(4)   # USE\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:33:21.575795", "function_name": "make_arrow", "function_body": "  # direction \u2192 action mapping (consistent with CraftWorld)\n  DIR2ACT = {\n      (0, 1): 0,   # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  from collections import deque\n  import numpy as np\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return actions moving from ``start`` to a cell adjacent to any\n      ``targets``. ``grid`` has shape (W, H, K). Cells containing any\n      non\u2011grabbable entity are considered blocked.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # compute blocked cells\n      blocked = np.zeros((W, H), dtype=bool)\n      for idx in env.world.non_grabbable_indices:\n          blocked |= grid[:, :, idx] > 0\n\n      sx, sy = start\n\n      # already adjacent?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Main planning logic.\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()          # mutable copy for simulation\n  pos = tuple(state.pos)            # (x, y)\n\n  # Goal index is stored in the task (env.task.goal).\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in environment task.\")\n\n  # Determine primitive (and intermediate) requirements for the goal.\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect each required primitive.\n  # --------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      while count > 0:\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive not present \u2013 abort planning.\n              return plan\n\n          path = bfs_to_adjacent(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          plan.append(4)   # USE\n\n          # Find the adjacent primitive cell we just used.\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              break  # safety\n\n          # Update local grid and decrement need.\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          count -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the appropriate workshop and craft the goal item.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index.\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs_to_adjacent(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          plan.append(4)   # USE to craft\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:33:57.439866", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Action constants (as defined by CraftLab)\n  # ------------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR_TO_ACT = {\n      (0, 1): ACTION_DOWN,    # y+ (down)\n      (0, -1): ACTION_UP,     # y- (up)\n      (-1, 0): ACTION_LEFT,   # x- (left)\n      (1, 0): ACTION_RIGHT,   # x+ (right)\n  }\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search: returns a list of actions that moves the agent\n  # from ``start`` to a cell adjacent (Manhattan distance 1) to any\n  # cell in ``targets`` while avoiding blocked cells.\n  # ------------------------------------------------------------------\n  def bfs(start, targets, grid):\n      W, H = grid.shape[:2]\n      # A cell is blocked if any kind occupies it (including obstacles)\n      blocked = np.any(grid > 0, axis=2)\n\n      sx, sy = start\n\n      # Already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target cell\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency\n      return []\n\n  # ------------------------------------------------------------------\n  # Initialise state information\n  # ------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                     # mutable copy of world grid\n  pos = tuple(state.pos)                       # (x, y)\n\n  # Goal index is stored in the task definition\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (recursive expansion)\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives\n  # ------------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # Find all cells that currently contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive unavailable \u2013 abort planning\n              return plan\n\n          # Compute path to the nearest reachable primitive (adjacent)\n          path = bfs(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to\n          adj_cell = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj_cell = (cx, cy)\n                  break\n          if adj_cell is None:\n              # Unexpected situation; break to avoid infinite loop\n              break\n\n          # Update local grid copy and decrement needed count\n          grid[adj_cell[0], adj_cell[1], kind_idx] -= 1\n          cnt -= 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or an integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate final movement\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:33:58.547968", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,\n      (0, -1): ACTION_UP,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  def bfs(start, targets, grid):\n      \"\"\"Return a list of actions moving from ``start`` to a cell adjacent\n      (Manhattan distance 1) to any cell in ``targets`` while avoiding blocked\n      cells (any occupied cell in ``grid``).\"\"\"\n      W, H = grid.shape[:2]\n      blocked = np.any(grid > 0, axis=2)  # True where any entity occupies the cell\n      sx, sy = start\n\n      # Already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # Check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency\n      return []\n\n  # ----------------------------------------------------------------------\n  # Extract current world information\n  # ----------------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)  # (x, y)\n\n  # Goal index (stored in env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (including intermediate items)\n  needed = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  plan = []\n\n  # ----------------------------------------------------------------------\n  # 1. Collect required primitives\n  # ----------------------------------------------------------------------\n  for kind_idx, remaining in needed.items():\n      while remaining > 0:\n          # Locate cells that still contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive unavailable \u2013 abort planning\n              return plan\n\n          # Find a path to a position adjacent to the nearest reachable primitive\n          path = bfs(pos, cells.tolist(), grid)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              # Should not happen; break to avoid infinite loop\n              break\n\n          # Update local grid copy and decrement needed count\n          grid[adj[0], adj[1], kind_idx] -= 1\n          remaining -= 1\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or an integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid)\n          plan.extend(path)\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:34:38.392050", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T16:34:39.505333", "function_name": "make_arrow", "function_body": "  # Helper: BFS to reach a state where the cell in front contains the target kind.\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      w, h = grid.shape[:2]\n      # Directions: 0 DOWN, 1 UP, 2 LEFT, 3 RIGHT\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n      non_grab = env.world.non_grabbable_indices\n\n      def in_bounds(x, y):\n          return 0 <= x < w and 0 <= y < h\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # any entity (including target) blocks movement\n          return not np.any(grid[x, y, list(non_grab)]) and not np.any(grid[x, y, :])\n\n      start_pos = state.pos\n      start_dir = state.dir\n      from collections import deque\n      queue = deque()\n      queue.append((start_pos[0], start_pos[1], start_dir, []))\n      visited = set()\n      visited.add((start_pos[0], start_pos[1], start_dir))\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # check if the cell in front contains the target\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n          # expand moves\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      # No path found \u2013 return empty list (will cause failure later)\n      return []\n\n  actions = []\n  # Current mutable state reference\n  cur_state = env._current_state\n  world = env.world\n  goal_idx = env.task.goal\n\n  # Determine primitive requirements for the goal\n  primitive_reqs = world.cookbook.primitives_for(goal_idx)\n\n  # Determine workshop kind for the goal (if any)\n  workshop_kind = None\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  if isinstance(recipe, dict):\n      workshop_kind = recipe.get('_at')\n\n  # Collect each required primitive the necessary number of times\n  for prim_kind, count in primitive_reqs.items():\n      for _ in range(count):\n          move_actions = _bfs_to_target(cur_state, prim_kind)\n          actions.extend(move_actions)\n          actions.append(4)  # USE to pick up the primitive\n          # Apply actions to keep cur_state in sync\n          for a in move_actions + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # Finally, go to the appropriate workshop and use it to craft the goal item\n  if workshop_kind is not None:\n      move_actions = _bfs_to_target(cur_state, workshop_kind)\n      actions.extend(move_actions)\n      actions.append(4)  # USE to craft at the workshop\n      # (optional) apply these actions to cur_state for completeness\n      for a in move_actions + [4]:\n          _, cur_state = cur_state.step(a)\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:34:58.081146", "function_name": "make_arrow", "function_body": "  # action constants (may differ per env, but default ordering is used)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan\u2011style movement from cur (x,y) to target (x,y)\n  # ------------------------------------------------------------------\n  def _move_to(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(RIGHT)\n          cx += 1\n      while cx > tx:\n          seq.append(LEFT)\n          cx -= 1\n      while cy < ty:\n          seq.append(DOWN)\n          cy += 1\n      while cy > ty:\n          seq.append(UP)\n          cy -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Get world, cookbook and initial state\n  # ------------------------------------------------------------------\n  # reset env to obtain a fresh state (if not already reset)\n  obs = env.reset()\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      # fallback: some wrappers may store the state differently\n      raise RuntimeError(\"Unable to obtain initial CraftState from env.\")\n\n  # world can be accessed via the scenario stored in the state\n  world = state.world\n\n  # index helper\n  idx = world.cookbook.index\n\n  # ------------------------------------------------------------------\n  # Identify the goal (hard\u2011coded to 'arrow')\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in idx.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in cookbook.\")\n  goal_idx = idx[goal_name]\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for ONE instance of the goal\n  # ------------------------------------------------------------------\n  primitives_needed = world.cookbook.primitives_for(goal_idx)  # dict {prim_idx: count}\n  if not primitives_needed:\n      # goal might be a primitive itself; nothing to collect\n      primitives_needed = {}\n\n  # ------------------------------------------------------------------\n  # Current position and static grid layout\n  # ------------------------------------------------------------------\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid                           # (W, H, n_kinds)\n\n  actions = []\n  harvested = set()                           # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest first)\n  # ------------------------------------------------------------------\n  for prim_idx, need_cnt in primitives_needed.items():\n      # locate all cells that contain this primitive (value > 0)\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # sort by Manhattan distance from current position\n      locations.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= need_cnt:\n              break\n          if loc in harvested:\n              continue\n          # move to the primitive cell\n          actions.extend(_move_to(pos, loc))\n          pos = loc\n          # pick it up\n          actions.append(USE)\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name)\n      if isinstance(workshop_key, str):\n          workshop_idx = idx[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # locate workshop cells\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]))\n          target_ws = ws_cells[0]\n          actions.extend(_move_to(pos, target_ws))\n          pos = target_ws\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:34:59.189385", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # ------------------------------------------------------------------\n  # Action constants (match CraftWorld's default ordering)\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: Manhattan moves from cur to target (returns list of actions)\n  # ------------------------------------------------------------------\n  def _move_to(cur, target):\n      cx, cy = cur\n      tx, ty = target\n      seq = []\n      while cx < tx:\n          seq.append(RIGHT)\n          cx += 1\n      while cx > tx:\n          seq.append(LEFT)\n          cx -= 1\n      while cy < ty:\n          seq.append(DOWN)\n          cy += 1\n      while cy > ty:\n          seq.append(UP)\n          cy -= 1\n      return seq\n\n  # ------------------------------------------------------------------\n  # Resolve world / cookbook\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", env)          # CraftLab wraps a CraftWorld\n  cookbook = world.cookbook\n\n  # Goal: make an \"arrow\"\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # dict {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if needed)\n  # ------------------------------------------------------------------\n  if not hasattr(env, \"_current_state\") or env._current_state is None:\n      env.reset()\n  state = env._current_state\n\n  pos = tuple(state.pos)                     # current agent position\n  grid = state.grid                           # static grid layout (W,H,kind)\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1. Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, required_cnt in primitives_needed.items():\n      # locate all cells that currently contain this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      gathered = 0\n      while gathered < required_cnt and locations:\n          # choose nearest remaining location\n          locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = locations.pop(0)\n          actions.extend(_move_to(pos, target))\n          pos = target\n          actions.append(USE)                # pick up the primitive\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (name \u2192 int or already int)\n      workshop_idx = (\n          cookbook.index[workshop_key]\n          if isinstance(workshop_key, str)\n          else workshop_key\n      )\n      # locate workshop cells\n      ws_locations = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_locations:\n          ws_locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = ws_locations[0]\n          actions.extend(_move_to(pos, ws_target))\n          pos = ws_target\n          actions.append(USE)                # craft at the workshop\n\n  return actions", "env_interactions": 22, "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:35:19.140615", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Helper mappings between directions and action indices (CraftLab)\n  # --------------------------------------------------------------\n  DIR_TO_ACT = {(0, 1): 0,   # DOWN\n                (0, -1): 1,  # UP\n                (-1, 0): 2,  # LEFT\n                (1, 0): 3}   # RIGHT\n  ACT_TO_DIR = {v: k for k, v in DIR_TO_ACT.items()}\n  ACTION_USE = 4\n\n  # --------------------------------------------------------------\n  # Bread\u2011first search that returns a list of actions moving from\n  # ``start`` to a cell adjacent (Manhattan distance\u202f1) to any cell in\n  # ``targets`` while avoiding blocked cells.\n  # --------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs(start, targets, grid, block_set):\n      \"\"\"Return actions to reach a position adjacent to any target cell.\n\n      Args:\n          start (tuple): (x, y) current position.\n          targets (list of tuple): list of (x, y) cells we want to be adjacent to.\n          grid (np.ndarray): (W, H, K) world grid.\n          block_set (set[int]): kind indices that are non\u2011grabbable (treated as obstacles).\n\n      Returns:\n          list[int]: sequence of movement actions; empty if already adjacent or unreachable.\n      \"\"\"\n      W, H = grid.shape[:2]\n\n      # pre\u2011compute blocked boolean map\n      blocked = np.zeros((W, H), dtype=bool)\n      for b in block_set:\n          blocked |= grid[:, :, b] > 0\n\n      sx, sy = start\n\n      # already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR_TO_ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      return []   # no reachable adjacency\n\n  # --------------------------------------------------------------\n  # Extract current state information\n  # --------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n\n  # Goal index is stored in the task (env.task.goal)\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (including counts)\n  needed = env.world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  block_set = env.world.non_grabbable_indices\n\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives\n  # --------------------------------------------------------------\n  for kind_idx, cnt in needed.items():\n      while cnt > 0:\n          # Find cells that still contain this primitive\n          cells = np.argwhere(grid[:, :, kind_idx] > 0)\n          if cells.size == 0:\n              # Primitive unavailable \u2013 abort planning\n              return plan\n\n          # Compute path to a position adjacent to the nearest primitive\n          path = bfs(pos, cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          # Simulate movement to keep ``pos`` up\u2011to\u2011date\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive\n          plan.append(ACTION_USE)\n\n          # Identify which primitive cell we are now adjacent to\n          adj = None\n          for cx, cy in cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              # Unexpected \u2013 stop to avoid infinite loop\n              break\n\n          # Update local copy of the grid and decrement needed count\n          grid[adj[0], adj[1], kind_idx] -= 1\n          cnt -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer)\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          for a in path:\n              dx, dy = ACT_TO_DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Craft by using the workshop\n          plan.append(ACTION_USE)\n\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:35:20.267697", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Helper constants and mappings for actions/directions.\n  # --------------------------------------------------------------\n  ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = 0, 1, 2, 3, 4\n  DIR2ACT = {\n      (0, 1): ACTION_DOWN,\n      (0, -1): ACTION_UP,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n  ACT2DIR = {v: k for k, v in DIR2ACT.items()}\n\n  # --------------------------------------------------------------\n  # Bread\u2011first\u2011search returning a list of actions that brings the\n  # agent to a cell adjacent (Manhattan distance\u202f1) to any cell in\n  # ``targets`` while avoiding blocked cells (any entity whose kind\n  # is in ``block_set``).\n  # --------------------------------------------------------------\n  from collections import deque\n  import numpy as np\n\n  def bfs(start, targets, grid, block_set):\n      W, H = grid.shape[:2]\n\n      # pre\u2011compute boolean map of blocked cells\n      blocked = np.zeros((W, H), dtype=bool)\n      for b in block_set:\n          blocked |= grid[:, :, b] > 0\n\n      sx, sy = start\n\n      # already adjacent to a target?\n      for tx, ty in targets:\n          if abs(sx - tx) + abs(sy - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((sx, sy, []))\n      visited = np.full((W, H), False, dtype=bool)\n      visited[sx, sy] = True\n\n      while q:\n          x, y, path = q.popleft()\n          for (dx, dy), act in DIR2ACT.items():\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  if blocked[nx, ny]:\n                      continue\n                  npath = path + [act]\n                  # check adjacency to any target\n                  for tx, ty in targets:\n                      if abs(nx - tx) + abs(ny - ty) == 1:\n                          return npath\n                  visited[nx, ny] = True\n                  q.append((nx, ny, npath))\n      # No reachable adjacency\n      return []\n\n  # --------------------------------------------------------------\n  # Extract current world state and task information.\n  # --------------------------------------------------------------\n  state = env._current_state\n  grid = state.grid.copy()                     # (W, H, K)\n  pos = tuple(state.pos)                       # (x, y)\n\n  # Goal index is stored in the task object.\n  goal_idx = getattr(env.task, \"goal\", None)\n  if goal_idx is None:\n      raise ValueError(\"Goal index not found in env.task\")\n\n  # Primitive requirements for the goal (only primitives, counts).\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  block_set = env.world.non_grabbable_indices\n\n  plan = []\n\n  # --------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # --------------------------------------------------------------\n  for prim_idx, cnt in needed_prims.items():\n      while cnt > 0:\n          # Find all cells that still contain this primitive.\n          prim_cells = np.argwhere(grid[:, :, prim_idx] > 0)\n          if prim_cells.size == 0:\n              # Primitive not available \u2013 abort planning.\n              return plan\n\n          # Compute a path to a cell adjacent to the nearest reachable primitive.\n          path = bfs(pos, prim_cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          # Simulate the movement to keep ``pos`` up\u2011to\u2011date.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          plan.append(ACTION_USE)\n\n          # Determine which primitive cell we are now adjacent to.\n          adj = None\n          for cx, cy in prim_cells:\n              if abs(pos[0] - cx) + abs(pos[1] - cy) == 1:\n                  adj = (cx, cy)\n                  break\n          if adj is None:\n              # Unexpected \u2013 break to avoid infinite loop.\n              break\n\n          # Update local copy of the grid and decrement the required count.\n          grid[adj[0], adj[1], prim_idx] -= 1\n          cnt -= 1\n\n  # --------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # --------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\") or recipe.get(\"_key\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = env.world.cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      workshop_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if workshop_cells.size > 0:\n          path = bfs(pos, workshop_cells.tolist(), grid, block_set)\n          plan.extend(path)\n\n          # Simulate movement to the workshop.\n          for a in path:\n              dx, dy = ACT2DIR[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to craft at the workshop.\n          plan.append(ACTION_USE)\n\n  # --------------------------------------------------------------\n  # Return the complete action sequence.\n  # --------------------------------------------------------------\n  return plan", "env_interactions": 0, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:35:40.025180", "function_name": "make_arrow", "function_body": "  # Reset environment and initialise helpers\n  env.reset()\n  act_map = env.action_specs()                     # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  move_delta = {\"UP\": (-1, 0), \"DOWN\": (1, 0),\n                \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action *names* moving the agent\n  # from `start` to a cell that is adjacent (Chebyshev distance \u2264 1)\n  # to any cell in `targets`.  Traverses only empty cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start: tuple[int, int],\n                      targets: list[tuple[int, int]],\n                      grid: np.ndarray) -> list[str] | None:\n      W, H = grid.shape[:2]\n      visited: set[tuple[int, int]] = set()\n      q: deque[tuple[tuple[int, int], list[str]]] = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # Walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Identify the goal and its recipe\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  actions: list[int] = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      # Check if we already have everything we need\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):\n          break\n\n      # Find a primitive that is still lacking\n      missing = [(p_idx, cnt - inventory[p_idx])\n                 for p_idx, cnt in needed_prims.items()\n                 if inventory[p_idx] < cnt]\n      # Choose the first missing primitive (could be improved with heuristics)\n      prim_idx, _ = missing[0]\n\n      # Locate all cells currently holding this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, prim_idx] > 0)))\n      if not prim_cells:\n          # Primitive not present on map \u2013 cannot proceed\n          raise RuntimeError(f\"Required primitive {prim_idx} not found on the map.\")\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {prim_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          act_id = act_map[act_name]\n          actions.append(act_id)\n          env.step(act_id)\n\n      # Pick up the primitive with the USE action\n      use_id = act_map[\"USE\"]\n      actions.append(use_id)\n      env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Workshop required for crafting not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          act_id = act_map[act_name]\n          actions.append(act_id)\n          env.step(act_id)\n\n  # Final USE to craft (or to pick up if no workshop is needed)\n  actions.append(act_map[\"USE\"])\n  env.step(act_map[\"USE\"])\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:35:41.141378", "function_name": "make_arrow", "function_body": "  # Reset environment and initialise containers\n  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()                     # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent from\n  # `start` to a cell that is adjacent (Chebyshev distance \u2264 1) to any\n  # cell in `targets`.  Walks only through empty cells (grid slice sum == 0).\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start: tuple[int, int],\n                      targets: list[tuple[int, int]],\n                      grid: np.ndarray) -> list[str] | None:\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # Check adjacency to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Only traverse empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # Identify the goal and the primitives required to craft it\n  # ------------------------------------------------------------------\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Locate all cells currently holding the primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive absent \u2013 cannot collect further\n              continue\n\n          # Plan a path to an adjacent cell of the nearest reachable primitive\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 skip this instance\n              continue\n\n          # Execute the movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Pick up the primitive (USE)\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Craft the item with USE at the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the accumulated action sequence\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T16:36:08.615015", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      \"\"\"Breadth\u2011first search returning a list of action indices that reaches any target.\"\"\"\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should not happen for valid scenarios\n\n  def go_to_kind(kind_idx, count):\n      \"\"\"Move to cells containing `kind_idx` and USE them `count` times.\"\"\"\n      nonlocal pos, actions\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE\n\n  # ------------------------------------------------------------------\n  # Gather recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive kind -> total count required\n  craft_steps = []           # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive needs and schedule crafting steps.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # first resolve all ingredient items (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # then schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all needed primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_kind(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop the required number of times\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
