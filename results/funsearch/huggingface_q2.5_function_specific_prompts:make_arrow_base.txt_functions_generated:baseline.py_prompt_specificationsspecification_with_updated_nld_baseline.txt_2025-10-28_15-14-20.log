{"timestamp": "2025-10-28T18:46:54.203388", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # Find the index for the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:        # arrow not defined in this world\n      return []\n\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns None if unreachable.\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # action \u2192 (dx, dy)\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = state.pos\n      sdir = state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  # Determine primitive requirements for a single arrow.\n  # If the recipe dict is empty, the arrow itself is a primitive.\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  plan = []\n\n  # Collect each required primitive the needed number of times.\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              return plan          # unreachable primitive \u2192 abort\n          plan.extend(move_seq)\n          plan.append(4)           # USE to pick up\n\n          # Keep the internal state up\u2011to\u2011date.\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # Craft the arrow at its designated workshop (if any).\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          return plan          # unreachable workshop \u2192 abort\n      plan.extend(move_seq)\n      plan.append(4)           # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 craft in place.\n      plan.append(4)           # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:46:55.318761", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state and world reference\n  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Locate the index for the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:      # arrow not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS returning a list of movement actions (0\u20113) that places\n  # the agent so that the cell directly in front contains `target_kind`.\n  # Returns None if the target cannot be reached.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      from collections import deque\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # action \u2192 (dx, dy) matching the environment's action ordering\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = state.pos\n      sdir = state.dir\n\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # If the recipe dict is empty, the arrow itself is a primitive.\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  plan = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # --------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              # Primitive unreachable \u2013 abort planning.\n              return plan\n          plan.extend(move_seq)\n          plan.append(4)                     # USE to pick up\n\n          # Keep the internal state up\u2011to\u2011date.\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          # Workshop unreachable \u2013 abort planning.\n          return plan\n      plan.extend(move_seq)\n      plan.append(4)                         # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 craft in place.\n      plan.append(4)                         # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:47:20.040369", "function_name": "make_arrow", "function_body": "  # Action indices \u2013 must match the environment's definition.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  # `start` to a cell adjacent (Manhattan distance == 1) to any of the\n  # coordinates in `targets`.  Cells that contain any entity are treated\n  # as blocked.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) == 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []  # unreachable\n\n  # ------------------------------------------------------------------\n  # Helper: update a position given an action.\n  # ------------------------------------------------------------------\n  def _apply_action(pos, act):\n      if act == RIGHT:\n          return (pos[0] + 1, pos[1])\n      if act == LEFT:\n          return (pos[0] - 1, pos[1])\n      if act == DOWN:\n          return (pos[0], pos[1] + 1)\n      if act == UP:\n          return (pos[0], pos[1] - 1)\n      return pos\n\n  # ------------------------------------------------------------------\n  # Extract world, cookbook and the hard\u2011coded goal (\"arrow\").\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  if world is None:\n      raise RuntimeError(\"World object not found in the environment\")\n  cookbook = world.cookbook\n\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  cur_grid = state.grid.copy()    # mutable copy for path\u2011finding\n\n  actions = []\n  harvested = set()               # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          actions.append(USE)                     # pick up the primitive\n          cur_grid[loc[0], loc[1], prim_idx] = 0   # cell becomes empty\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          actions.append(USE)   # craft at the workshop\n      else:\n          # No workshop cell found \u2013 try to craft at current location.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:47:21.154465", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  # Action indices \u2013 match the environment's definition.\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in [(0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  def _apply_action(pos, act):\n      if act == RIGHT:\n          return (pos[0] + 1, pos[1])\n      if act == LEFT:\n          return (pos[0] - 1, pos[1])\n      if act == DOWN:\n          return (pos[0], pos[1] + 1)\n      if act == UP:\n          return (pos[0], pos[1] - 1)\n      return pos\n\n  # Locate world and cookbook.\n  world = getattr(env, \"world\", None)\n  if world is None:\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = wrapper_state.world\n  if world is None:\n      raise RuntimeError(\"World object not found in environment\")\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Ensure we have a fresh state.\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)\n  cur_grid = state.grid.copy()\n\n  actions = []\n  harvested = set()\n\n  # Collect required primitives.\n  for prim_idx, needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = _bfs_path(pos, [loc], cur_grid)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          actions.append(USE)\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # Craft at the required workshop, if any.\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else workshop_key)\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], cur_grid)\n          actions.extend(path)\n          for act in path:\n              pos = _apply_action(pos, act)\n          actions.append(USE)\n      else:\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
