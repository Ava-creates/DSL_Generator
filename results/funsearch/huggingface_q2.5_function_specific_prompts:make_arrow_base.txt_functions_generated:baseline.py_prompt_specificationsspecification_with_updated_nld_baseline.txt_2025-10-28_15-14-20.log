{"timestamp": "2025-10-28T22:42:43.102692", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  def _state_hash(st):\n      # Combine position, direction, inventory tuple and grid bytes for hashing\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 800                      # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5) # typically 5 actions (0\u20114)\n\n  # Prefer using the USE action before movement actions\n  action_order = [4] + [i for i in range(n_actions) if i != 4]\n\n  while frontier:\n      node = frontier.popleft()\n      state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long partial plans\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all possible actions in the chosen order\n      for a in action_order:\n          _, nxt = state.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No feasible plan found within limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T22:43:05.250232", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Determine which primitive kinds are required for the goal\n  try:\n      required_primitives = world.cookbook.primitives_for(target_idx)  # dict {kind_idx: count}\n  except Exception:\n      required_primitives = {}\n\n  from collections import deque, namedtuple\n  import heapq\n  import numpy as np\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\", \"g\"])\n\n  def state_hash(st):\n      \"\"\"Hash a state for visited\u2011set lookup.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  def manhattan(p1, p2):\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  def heuristic(st):\n      \"\"\"\n      Simple admissible heuristic:\n      distance to the closest missing primitive (if any are still needed).\n      Returns 0 when all required primitives are already in inventory.\n      \"\"\"\n      # Find which primitives we still lack\n      missing = []\n      for kind, need in required_primitives.items():\n          have = st.inventory[kind]\n          if have < need:\n              missing.append((kind, need - have))\n\n      if not missing:\n          return 0  # all required primitives are in inventory; crafting can be done in place\n\n      # Compute Manhattan distance to the nearest cell containing any missing primitive\n      min_dist = None\n      for kind, _ in missing:\n          ys, xs = np.where(st.grid[:, :, kind] > 0)\n          for y, x in zip(ys, xs):\n              d = manhattan(st.pos, (x, y))\n              if (min_dist is None) or (d < min_dist):\n                  min_dist = d\n      return min_dist if min_dist is not None else 0\n\n  # A* search structures\n  n_actions = getattr(world, \"n_actions\", 5)  # default action space size\n  start_h = heuristic(init_state)\n  frontier = [(start_h, 0, Node(init_state, [], 0))]  # (f = g+h, g, Node)\n  visited = {state_hash(init_state): 0}  # map hash -> best g seen\n\n  MAX_STEPS = 400  # safety cap on plan length\n\n  while frontier:\n      f, g, node = heapq.heappop(frontier)\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      if g >= MAX_STEPS:\n          continue\n\n      # Expand possible actions (typically 0\u20114 where 4 == USE)\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          nxt_hash = state_hash(nxt_state)\n          nxt_g = g + 1\n\n          # If we have seen this state with a lower or equal cost, skip it\n          if nxt_hash in visited and visited[nxt_hash] <= nxt_g:\n              continue\n\n          visited[nxt_hash] = nxt_g\n          nxt_h = heuristic(nxt_state)\n          heapq.heappush(frontier, (nxt_g + nxt_h, nxt_g, Node(nxt_state, node.actions + [a], nxt_g)))\n\n  # No plan found within limits\n  return []", "env_interactions": 0, "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-10-28T22:43:20.914364", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Retrieve scenario and world objects from the provided environment.\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Identify the index of the target item \"arrow\".\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Obtain the initial state of the episode.\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search over the state space to find a sequence of actions\n  # that yields at least one \"arrow\" in the inventory.\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory contents, and full grid layout.\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety cap on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune paths that exceed the step limit.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions.\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If no plan was found within the search budget, return an empty list.\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T22:43:49.248721", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined by CraftLab)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Initialise environment and obtain useful objects\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Entities that block movement (non\u2011grabbable)\n  non_grab = list(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies ``pos``.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest 4\u2011connected walkable path (including start & goal).\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          # Unreachable\n          return []\n      # Reconstruct path backwards\n      path = []\n      cur = goal\n      while cur is not None:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell containing ``kind`` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)   # current (y, x)\n\n  # Goal item (arrow) and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Move to the primitive cell\n          path = bfs_path(cur_pos, prim_loc)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid to reflect that the primitive has been taken\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe requires a specific workshop, move there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = bfs_path(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 19, "island_id": 3, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T22:43:50.417541", "function_name": "make_arrow", "function_body": "  \"\"\"Version 2 of the arrow\u2011making planner.\n\n  This implementation follows the same overall strategy as the previous\n  versions but adds a few robustness improvements:\n    * Uses a simple A* search (Manhattan heuristic) for potentially shorter\n      paths on larger maps.\n    * Guarantees that the agent faces the target cell before issuing a USE\n      action by explicitly turning towards it.\n    * Updates the internal planning grid after each pickup to avoid revisiting\n      already\u2011collected primitives.\n  \"\"\"\n  import numpy as np\n  from collections import deque\n\n  # Action identifiers used by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ----------------------------------------------------------------------\n  # Initialise environment and fetch useful objects\n  # ----------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Indices of entities that block movement (non\u2011grabbable)\n  non_grab = list(world.non_grabbable_indices)\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def is_blocked(pos):\n      \"\"\"Return True if a non\u2011grabbable entity occupies ``pos``.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def heuristic(a, b):\n      \"\"\"Manhattan distance \u2013 admissible heuristic for A*.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      \"\"\"Return a list of positions from start to goal (inclusive) using A*.\"\"\"\n      if start == goal:\n          return [start]\n      h, w = grid.shape[:2]\n      open_set = {start}\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      while open_set:\n          current = min(open_set, key=lambda p: f_score.get(p, np.inf))\n          if current == goal:\n              # reconstruct path\n              path = [current]\n              while current in came_from:\n                  current = came_from[current]\n                  path.append(current)\n              path.reverse()\n              return path\n          open_set.remove(current)\n          y, x = current\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  neighbor = (ny, nx)\n                  if is_blocked(neighbor):\n                      continue\n                  tentative_g = g_score[current] + 1\n                  if tentative_g < g_score.get(neighbor, np.inf):\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g\n                      f_score[neighbor] = tentative_g + heuristic(neighbor, goal)\n                      open_set.add(neighbor)\n      # unreachable\n      return []\n\n  def path_to_actions(path):\n      \"\"\"Translate a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def turn_towards(src, dst):\n      \"\"\"Return the single USE\u2011compatible turn action (UP/DOWN/LEFT/RIGHT).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == -1:\n          return UP\n      if dy == 1:\n          return DOWN\n      if dx == -1:\n          return LEFT\n      if dx == 1:\n          return RIGHT\n      # already on the same cell \u2013 no turn needed\n      return None\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the closest cell containing ``kind`` (Manhattan distance).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (N, S, W, E order).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback (may be blocked)\n\n  # ----------------------------------------------------------------------\n  # Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  cur_pos = tuple(state.pos)   # current (y, x)\n\n  # Goal item (arrow) and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Collect each required primitive the required number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur_pos)\n          if prim_loc is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = a_star(cur_pos, stand_pos)\n          if not path:\n              return actions\n          actions.extend(path_to_actions(path))\n          cur_pos = stand_pos\n\n          # Turn towards the primitive and step onto it (if possible)\n          turn = turn_towards(cur_pos, prim_loc)\n          if turn is not None:\n              actions.append(turn)   # face the primitive\n          if not is_blocked(prim_loc):\n              path = a_star(cur_pos, prim_loc)\n              if not path:\n                  return actions\n              actions.extend(path_to_actions(path))\n              cur_pos = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update planning grid \u2013 primitive has been collected\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, move there before crafting\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur_pos)\n      if ws_loc is not None:\n          path = a_star(cur_pos, ws_loc)\n          if path:\n              actions.extend(path_to_actions(path))\n              cur_pos = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:44:26.913133", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy of the grid\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < grid.shape[0] and 0 <= x < grid.shape[1]\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return grid[y, x].any()\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      rev.append(UP)\n                  elif cur[1] == px + 1:\n                      rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if (ny, nx) in visited:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited.add((ny, nx))\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found \u2013 return empty list (will likely cause failure later)\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the closest cell containing ``kind_idx`` (primitive or workshop).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighboring cell (y, x) to ``cell``.\n      ``avoid`` is a set of coordinates that should not be used.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                     # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  taken_cells = set()\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=taken_cells)\n          if adj is None:\n              # No free neighbour; fallback to standing on the primitive cell itself\n              adj = target\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (add a blocked move in that direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          taken_cells.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand on a free neighbour of the workshop if possible\n          ws_adj = adjacent_free(ws_cell, avoid=taken_cells)\n          if ws_adj is None:\n              # If no free neighbour, stand directly on the workshop cell\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
