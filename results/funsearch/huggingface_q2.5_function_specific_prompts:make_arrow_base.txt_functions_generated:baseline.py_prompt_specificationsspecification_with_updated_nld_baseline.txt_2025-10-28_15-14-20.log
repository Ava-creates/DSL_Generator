{"timestamp": "2025-10-28T21:03:58.349444", "function_name": "make_arrow", "function_body": "  # Reset environment and obtain current state and world reference\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world\n\n  # ------------------------------------------------------------------\n  # Identify the integer index of the goal item \"arrow\"\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:                   # arrow not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) which\n  # bring the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns None if unreachable.\n  # ------------------------------------------------------------------\n  def _bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      # Mapping from action index to (dx, dy)\n      deltas = {0: (0, 1),   # DOWN\n                1: (0, -1),  # UP\n                2: (-1, 0),  # LEFT\n                3: (1, 0)}   # RIGHT\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # `primitives_for` expands the recipe recursively to true primitives.\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:                         # arrow itself may be primitive\n      needed = {arrow_idx: 1}\n\n  plan = []  # list of action indices to be returned\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_target(state, prim_idx)\n          if move_seq is None:          # cannot reach this primitive\n              return plan\n          plan.extend(move_seq)\n          plan.append(4)                # USE to pick it up\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).  If the recipe\n  # does not specify a workshop, we can craft in place.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(state, workshop_idx)\n      if move_seq is None:              # unreachable workshop\n          return plan\n      plan.extend(move_seq)\n      plan.append(4)                    # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      plan.append(4)                    # USE to craft directly\n      _, state = state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T21:03:59.488843", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # BFS to reach a cell whose front contains target_kind\n  def _bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}  # action -> (dx, dy)\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, acts = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n      return None\n\n  # Determine primitive requirements\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:\n      needed = {arrow_idx: 1}\n\n  plan = []\n\n  # Collect primitives\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          seq = _bfs_to_target(state, prim_idx)\n          if seq is None:\n              return plan\n          plan.extend(seq)\n          plan.append(4)  # USE to pick up\n          for a in seq + [4]:\n              _, state = state.step(a)\n\n  # Craft at workshop if required\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      seq = _bfs_to_target(state, workshop_idx)\n      if seq is None:\n          return plan\n      plan.extend(seq)\n      plan.append(4)  # USE to craft\n      for a in seq + [4]:\n          _, state = state.step(a)\n  else:\n      plan.append(4)\n      _, state = state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
