{"timestamp": "2025-10-28T19:32:44.256249", "function_name": "make_arrow", "function_body": "  # Constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and grab current state / world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks\n      from ``start`` to ``goal`` using a simple Manhattan walk.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def nearest_location(locations, from_pos):\n      \"\"\"Pick the nearest location (in Manhattan distance) from ``from_pos``.\"\"\"\n      if not locations:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      idx = np.argmin(dists)\n      return tuple(locations[idx])\n\n  def free_adjacent(cell, cur_pos):\n      \"\"\"Return a free adjacent cell to ``cell`` (prefer a cell that keeps us\n      facing the target). If none are free, return the target cell itself.\"\"\"\n      y, x = cell\n      candidates = [\n          (y - 1, x),  # above   (facing DOWN)\n          (y + 1, x),  # below   (facing UP)\n          (y, x - 1),  # left    (facing RIGHT)\n          (y, x + 1),  # right   (facing LEFT)\n      ]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              # check if any non\u2011grabbable entity occupies the cell\n              occupied = False\n              if world.non_grabbable_indices:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      # fallback \u2013 may be blocked but we have no better option\n      return cell\n\n  # ------------------------------------------------------------------\n  # Determine the primitive requirements for an arrow\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      # Gather all locations of this primitive at the start\n      prim_locs = np.argwhere(grid[:, :, prim_idx] > 0)\n      for _ in range(count):\n          target = nearest_location(prim_locs, cur_pos)\n          if target is None:\n              # Not enough primitives \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on\n          adj = free_adjacent(target, cur_pos)\n\n          # Move to the adjacent cell\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (best\u2011effort \u2013 add a direction action)\n          ty, tx = target\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n          # If already on the same cell, direction does not matter\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Remove the used location so we don't try to collect it again\n          prim_locs = np.array([loc for loc in prim_locs if tuple(loc) != target])\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_locs = np.argwhere(grid[:, :, workshop_idx] > 0)\n      ws_target = nearest_location(ws_locs, cur_pos)\n      if ws_target is not None:\n          actions += manhattan_path(cur_pos, ws_target)\n          cur_pos = ws_target\n\n  # Final USE to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-10-28T19:33:05.415988", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Action \u2192 (dx, dy) mapping (DOWN, UP, LEFT, RIGHT)\n  deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}\n\n  def bfs_to_target(cur_state, target_kind):\n      \"\"\"Bread\u2011first search that returns a list of movement actions (0\u20113)\n      leading to a position where the cell directly in front contains\n      `target_kind`. Returns None if the target is unreachable.\"\"\"\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  # Determine primitive requirements (recursively expanded)\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:  # arrow itself may be primitive\n      needed = {arrow_idx: 1}\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          seq = bfs_to_target(state, prim_idx)\n          if seq is None:\n              # Unreachable primitive \u2013 abort planning\n              return plan\n          plan.extend(seq)\n          plan.append(4)  # USE to pick up\n          for a in seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      seq = bfs_to_target(state, workshop_idx)\n      if seq is None:\n          # Unreachable workshop \u2013 abort planning\n          return plan\n      plan.extend(seq)\n      plan.append(4)  # USE to craft\n      for a in seq + [4]:\n          _, state = state.step(a)\n  else:\n      # No specific workshop; craft in place\n      plan.append(4)\n      _, state = state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:33:06.590544", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:                   # arrow not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that brings\n  # the agent to a cell whose *front* contains `target_kind`.  Returns\n  # None if the target cannot be reached.\n  # ------------------------------------------------------------------\n  deltas = {0: (0, 1),   # DOWN\n            1: (0, -1),  # UP\n            2: (-1, 0),  # LEFT\n            3: (1, 0)}   # RIGHT\n\n  def _bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:                         # arrow itself is primitive\n      needed = {arrow_idx: 1}\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          move_seq = _bfs_to_target(state, prim_idx)\n          if move_seq is None:          # unreachable primitive \u2192 abort planning\n              return plan\n          plan.extend(move_seq)\n          plan.append(4)                # USE to pick up\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(state, workshop_idx)\n      if move_seq is None:              # unreachable workshop \u2192 abort\n          return plan\n      plan.extend(move_seq)\n      plan.append(4)                    # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      plan.append(4)                    # USE to craft in place\n      _, state = state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:33:24.747241", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh start\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions that walk from ``start`` to ``goal``.\n      This simple planner ignores obstacles \u2013 it works when the map is largely\n      open (which is the case for most CraftWorld levels).\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Linear scan for the nearest cell containing ``kind_idx``.\n      Returns (y, x) or ``None`` if the kind does not appear on the map.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine the primitive requirements for an ``arrow``\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in required_prims.items():\n      for _ in range(needed_cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present on the map \u2013 give up early.\n              return actions\n\n          ty, tx = target\n\n          # Choose an adjacent free cell to stand on before using.\n          # Preference order: above, below, left, right.\n          adj = None\n          for ny, nx, facing in [\n              (ty - 1, tx, DOWN),   # stand above, face downwards\n              (ty + 1, tx, UP),     # stand below, face upwards\n              (ty, tx - 1, RIGHT),  # stand left, face rightwards\n              (ty, tx + 1, LEFT)    # stand right, face leftwards\n          ]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  # Check that the cell is not occupied by any non\u2011grabbable entity.\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx, facing)\n                      break\n\n          # If no free neighbour, we will stand on the primitive cell itself.\n          if adj is None:\n              adj = (ty, tx, None)\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj[:2])\n          cur_pos = adj[:2]\n\n          # Adjust direction if needed.\n          if adj[2] is not None:\n              # The direction we need to face is encoded in the third element.\n              if adj[2] == DOWN:\n                  actions.append(DOWN)\n              elif adj[2] == UP:\n                  actions.append(UP)\n              elif adj[2] == RIGHT:\n                  actions.append(RIGHT)\n              elif adj[2] == LEFT:\n                  actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger the crafting action.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:33:25.911863", "function_name": "make_arrow", "function_body": "  # Reset environment to start fresh\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (W, H, n_kinds)\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks\n      from ``start`` to ``goal`` using a simple Manhattan walk.  This ignores\n      obstacles \u2013 the CraftWorld maps are typically open enough for this\n      heuristic to succeed.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Linear scan for the nearest cell containing ``kind_idx``.\n      Returns (y, x) or ``None`` if the kind does not appear on the grid.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine the primitives required to craft an ``arrow``\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free neighboring cell to stand on (so we can USE).\n          neighbours = [\n              (ty - 1, tx),  # above (face DOWN)\n              (ty + 1, tx),  # below (face UP)\n              (ty, tx - 1),  # left  (face RIGHT)\n              (ty, tx + 1),  # right (face LEFT)\n          ]\n          adj = None\n          for ny, nx in neighbours:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fall back to standing directly on the primitive cell.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (best\u2011effort direction change).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n          # If already on the same cell, direction does not matter.\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE triggers crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:33:51.448625", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  # `start` to any cell adjacent (Manhattan distance \u2264\u202f1) to one of the\n  # `targets`.  `occupied` is a 2\u2011D bool array where True marks cells that\n  # cannot be stepped on.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent (or on) a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable target.\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve the world and cookbook objects from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state.\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = getattr(state_tmp, \"world\", None)\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\".\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary) and fetch grid.\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)                     # (x, y)\n  grid = state.grid.copy()                   # mutable copy\n  occupied = np.any(grid > 0, axis=2)        # True where any entity exists\n\n  actions = []\n  harvested = set()                          # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Current locations of this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from the agent.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], occupied)\n          actions.extend(path)\n          # Update position according to the taken path.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick it up.\n          actions.append(USE)\n          # Mark the cell as empty for future planning.\n          grid[loc[0], loc[1], prim_idx] = 0\n          occupied[loc[0], loc[1]] = False\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or already an int).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Locate workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda w: abs(w[0] - pos[0]) + abs(w[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:33:52.618509", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def bfs(start, targets, occupied):\n      w, h = occupied.shape\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  # Retrieve world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_tmp = getattr(env, \"_current_state\", None)\n      world = state_tmp.world if state_tmp is not None else None\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\"\n  goal_idx = cookbook.index[\"arrow\"]\n  needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # Ensure we have a current state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  occupied = np.any(grid > 0, axis=2)\n\n  actions = []\n  collected = set()\n\n  # Collect required primitives\n  for prim_idx, cnt in needed.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      have = 0\n      for loc in locations:\n          if have >= cnt:\n              break\n          if loc in collected:\n              continue\n          path = bfs(pos, [loc], occupied)\n          actions.extend(path)\n          for a in path:\n              if a == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif a == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif a == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif a == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n          grid[loc[0], loc[1], prim_idx] = 0\n          occupied[loc[0], loc[1]] = False\n          collected.add(loc)\n          have += 1\n\n  # Craft at the required workshop (if any)\n  recipe = cookbook.recipes.get(goal_idx, {})\n  ws_key = recipe.get(\"_at\")\n  if ws_key is not None:\n      ws_idx = cookbook.index[ws_key] if isinstance(ws_key, str) else ws_key\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, ws_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = ws_cells[0]\n          path = bfs(pos, [target], occupied)\n          actions.extend(path)\n          for a in path:\n              if a == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif a == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif a == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif a == UP:\n                  pos = (pos[0], pos[1] - 1)\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:34:21.322448", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions that walk from ``start`` to ``goal``.\n      Simple planner that moves vertically then horizontally.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Linear scan for the nearest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine what primitives are needed for an ``arrow``\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in required_prims.items():\n      for _ in range(needed_cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present on the map \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose an adjacent free cell to stand on before using.\n          # Preference order: above, below, left, right.\n          adj = None\n          for ny, nx, facing in [\n              (ty - 1, tx, DOWN),   # stand above, face downwards\n              (ty + 1, tx, UP),     # stand below, face upwards\n              (ty, tx - 1, RIGHT),  # stand left, face rightwards\n              (ty, tx + 1, LEFT)    # stand right, face leftwards\n          ]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx, facing)\n                      break\n\n          # If no free neighbour, we will stand on the primitive cell itself.\n          if adj is None:\n              adj = (ty, tx, None)\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj[:2])\n          cur_pos = adj[:2]\n\n          # Adjust direction if needed.\n          if adj[2] is not None:\n              actions.append(adj[2])\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger the crafting action.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:34:22.452335", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions that walk from ``start`` to ``goal``.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the closest cell containing ``kind_idx`` (using Manhattan distance).\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for an ``arrow``.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in required_prims.items():\n      for _ in range(needed_cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          # Move to the primitive cell.\n          actions += manhattan_path(cur_pos, target)\n          cur_pos = target\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update our planning copy so we don't try to pick the same item again.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 22, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T19:34:48.080098", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices (as defined in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks\n      from ``start`` to ``goal`` using a simple Manhattan walk.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing ``kind_idx``.\n      Returns (y, x) tuple or ``None`` if not present.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are required for the 'arrow' item\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # current agent position (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          # Move to the primitive cell.\n          actions += manhattan_path(cur_pos, target)\n          cur_pos = target\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE triggers crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 22, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T19:34:49.221745", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that walks\n      from ``start`` to ``goal`` using a simple Manhattan walk.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Linear scan for the nearest cell containing ``kind_idx``.\n      Returns (y, x) or ``None`` if the kind does not appear on the grid.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine the primitives required to craft an ``arrow``\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free neighboring cell to stand on (so we can USE).\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fall back to standing directly on the primitive cell.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (best\u2011effort direction change).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE triggers crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:35:19.177155", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects (handle possible wrappers)\n  try:\n      scenario = env.scenario\n  except Exception:\n      scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      arrow_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over (state, action\u2011history) pairs\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      # Position, direction, inventory and full grid uniquely identify a state\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_hash_state(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Search limits\n  MAX_STEPS = 400\n  n_actions = getattr(world, \"n_actions\", 5)  # default to standard 5 actions\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", arrow_idx):\n          return node.actions\n\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _hash_state(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the depth limit\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:35:34.988918", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Obtain scenario and world objects (the environment may be wrapped)\n  # ----------------------------------------------------------------------\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Index of the target item (\"arrow\")\n  # ----------------------------------------------------------------------\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Initial state of the episode\n  # ----------------------------------------------------------------------\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Bread\u2011first search over (state, action\u2011sequence) pairs.\n  # A simple heuristic ordering prefers the USE action before movement.\n  # ----------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory (as tuple), and full grid bytes.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  MAX_STEPS = 300                     # safety bound to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)   # default to 5 (including USE)\n\n  # Action ordering: try USE first, then the four movement actions.\n  # The exact index of USE is assumed to be the last one (common in CraftWorld).\n  ordered_actions = list(range(n_actions - 1, -1, -1))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test \u2013 have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours.\n      for a in ordered_actions:\n          # Guard against out\u2011of\u2011range indices (in case world reports a different count).\n          if a >= n_actions:\n              continue\n          _, nxt_state = cur_state.step(a)\n          key = _hash_state(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If we exhaust the search without finding a plan, return an empty list.\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:36:04.193310", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Hashable representation of a state (position, direction, inventory, grid)\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # safety limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours by trying every possible action\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:36:20.105126", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world from the provided environment\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      # Hashable representation of a state (position, direction, inventory, grid)\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 400                     # Upper bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # Usually 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours by trying every possible action\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:36:46.959918", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()\n\n  # Action indices\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Non\u2011grabbable entity indices block movement\n  non_grab = list(world.non_grabbable_indices)\n\n  H, W = grid.shape[:2]\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, 1, RIGHT), (0, -1, LEFT)]\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding\n      non\u2011grabbable obstacles.\"\"\"\n      from collections import deque\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions = []\n              cur = goal\n              while cur != start:\n                  py, px = prev[cur]\n                  dy, dx = cur[0] - py, cur[1] - px\n                  if dy == 1:\n                      actions.append(DOWN)\n                  elif dy == -1:\n                      actions.append(UP)\n                  elif dx == 1:\n                      actions.append(RIGHT)\n                  elif dx == -1:\n                      actions.append(LEFT)\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  if np.any(grid[ny, nx, non_grab] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing ``kind_idx``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(cell):\n      \"\"\"Return a free neighbour of *cell* (or None).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if 0 <= ny < H and 0 <= nx < W:\n              if not np.any(grid[ny, nx, non_grab] > 0):\n                  return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its recipe\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_idx = None\n  if \"_at\" in recipe:\n      workshop_idx = world.cookbook.index.index(recipe[\"_at\"])\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          adj = free_adjacent(target)\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself.\n              adj = target\n\n          actions += bfs(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a blocked move in that direction).\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update internal grid (primitive disappears).\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE triggers crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T19:36:48.106694", "function_name": "make_arrow", "function_body": "  # Reset environment and get current state/world\n  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid.copy()                     # mutable copy for bookkeeping\n\n  # Action indices from the environment\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # Set of indices that block movement (non\u2011grabbable entities)\n  non_grab = list(world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  H, W = grid.shape[:2]\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable\n      obstacles. ``start`` and ``goal`` are (y, x) tuples.\"\"\"\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              actions = []\n              cur = goal\n              while cur != start:\n                  py, px = prev[cur]\n                  dy, dx = cur[0] - py, cur[1] - px\n                  if dy == 1:\n                      actions.append(DOWN)\n                  elif dy == -1:\n                      actions.append(UP)\n                  elif dx == 1:\n                      actions.append(RIGHT)\n                  elif dx == -1:\n                      actions.append(LEFT)\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n\n          for dy, dx, act in ((1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)):\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # blocked if any non\u2011grabbable entity occupies the cell\n                  if np.any(grid[ny, nx, non_grab] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list (should not happen for valid tasks)\n      return []\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the coordinates (y, x) of the nearest cell that contains ``kind``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  # ------------------------------------------------------------------\n  # Identify goal (arrow) and required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          target = nearest_cell(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = None\n          for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n              if 0 <= ny < H and 0 <= nx < W:\n                  if not np.any(grid[ny, nx, non_grab] > 0):\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # If no free neighbour, stand on the primitive cell itself\n              adj = (ty, tx)\n\n          # Move to the chosen adjacent cell\n          actions += bfs(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a blocked move in the correct direction)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update bookkeeping grid (primitive disappears)\n          grid[ty, tx, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if recipe specifies one) and craft the arrow\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = nearest_cell(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE triggers crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:37:16.970528", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices (match CraftWorld's definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving from `start` to a cell\n  # adjacent (Manhattan distance == 1) to any of the `targets`.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # cells that block movement\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # If we are already adjacent (or on) a target, stop.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []   # no path found (should not happen in well\u2011formed worlds)\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook objects from the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n  cookbook = world.cookbook\n\n  # ------------------------------------------------------------------\n  # Goal is the item named \"arrow\".\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in the cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitives required to craft the goal (including counts).\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y) position\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Find all cells that contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Update internal position tracker.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell as empty for future planning.\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (string name or integer).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Locate workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Craft the arrow.\n          actions.append(USE)\n      else:\n          # No visible workshop; attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required \u2013 just use the craft action.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:37:18.103861", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n      while q:\n          x, y, path = q.popleft()\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      return []\n\n  # Locate world and cookbook\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"World object not found in environment\")\n  cookbook = world.cookbook\n\n  # Goal item\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in cookbook\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Required primitives (including counts)\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n\n  # Ensure we have a fresh state\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)\n  grid = state.grid.copy()\n  actions = []\n  harvested = set()\n\n  # Helper to update position after an action\n  def _move(pos, act):\n      if act == RIGHT:\n          return (pos[0] + 1, pos[1])\n      if act == LEFT:\n          return (pos[0] - 1, pos[1])\n      if act == DOWN:\n          return (pos[0], pos[1] + 1)\n      if act == UP:\n          return (pos[0], pos[1] - 1)\n      return pos\n\n  # Collect each primitive\n  for prim_idx, needed in primitives_needed.items():\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          for act in path:\n              pos = _move(pos, act)\n          actions.append(USE)\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # Craft at workshop if required\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              pos = _move(pos, act)\n          actions.append(USE)\n      else:\n          actions.append(USE)\n  else:\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:42:59.718219", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state\n  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # Find the index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # not defined\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that brings\n  # the agent to a position where the cell directly in front contains\n  # `target_kind`. Returns None if the target is unreachable.\n  # ----------------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      import numpy as np\n      from collections import deque\n\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # Action -> (dx, dy) mapping\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # walkable iff the cell is completely empty\n          return not np.any(grid[x, y, :])\n\n      start_x, start_y = state.pos\n      start_dir = state.dir\n      queue = deque()\n      queue.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while queue:\n          x, y, d, actions = queue.popleft()\n          # Check the cell directly ahead\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          # Expand neighbours (movement actions also set direction)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, actions + [a]))\n\n      # Unreachable\n      return None\n\n  # ----------------------------------------------------------------------\n  # Recursive production helper: ensure `item_idx` is present at least\n  # `needed` times in the inventory, collecting primitives or crafting\n  # intermediate items as required.\n  # ----------------------------------------------------------------------\n  actions = []\n\n  def _ensure(item_idx, needed):\n      nonlocal cur_state, actions\n      # Loop until we have enough of the item\n      while cur_state.inventory[item_idx] < needed:\n          # Primitive items can be collected directly\n          if item_idx in world.cookbook.primitives:\n              seq = _bfs_to_target(cur_state, item_idx)\n              if seq is None:\n                  # Cannot reach the primitive \u2013 abort\n                  return False\n              actions.extend(seq)\n              actions.append(4)          # USE to pick up\n              for a in seq + [4]:\n                  _, cur_state = cur_state.step(a)\n              continue\n\n          # Non\u2011primitive: need to craft it using its recipe\n          recipe = world.cookbook.recipes.get(item_idx)\n          if not recipe:\n              # No way to produce this item\n              return False\n\n          # First ensure all ingredient counts are satisfied (one craft at a time)\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              # Ensure we have at least `cnt` of this ingredient\n              if not _ensure(ing_idx, cnt):\n                  return False\n\n          # Move to required workshop (if any) before crafting\n          workshop_name = recipe.get('_at')\n          if workshop_name is not None:\n              ws_idx = world.cookbook.index.index(workshop_name)\n              seq = _bfs_to_target(cur_state, ws_idx)\n              if seq is None:\n                  return False\n              actions.extend(seq)\n              actions.append(4)          # USE to craft\n              for a in seq + [4]:\n                  _, cur_state = cur_state.step(a)\n          else:\n              # Craft in place\n              actions.append(4)          # USE to craft\n              _, cur_state = cur_state.step(4)\n\n      return True\n\n  # ----------------------------------------------------------------------\n  # Produce a single arrow\n  # ----------------------------------------------------------------------\n  _ensure(arrow_idx, 1)\n\n  return actions", "env_interactions": 0, "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-10-28T19:43:01.053633", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Primitive requirements for one arrow (recursively expanded)\n  prim_req = world.cookbook.primitives_for(arrow_idx)\n  if not prim_req:\n      # Arrow itself is a primitive that must be picked up\n      prim_req = {arrow_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of movement actions (0\u20113) that brings the\n  # agent to a cell where the cell directly in front contains\n  # `target_kind`. Returns None if the target cannot be reached.\n  # ------------------------------------------------------------------\n  def bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # action index \u2192 (dx, dy) displacement (also sets direction)\n      deltas = {0: (0, 1),   # DOWN\n                1: (0, -1),  # UP\n                2: (-1, 0),  # LEFT\n                3: (1, 0)}   # RIGHT\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      start_x, start_y = state.pos\n      start_dir = state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while q:\n          x, y, d, acts = q.popleft()\n\n          # Check cell directly ahead\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          # Expand neighbours (moving also sets direction)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n\n      # Unreachable\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for kind_idx, total_needed in prim_req.items():\n      # Account for any already\u2011present items in the inventory\n      already_have = int(cur_state.inventory[kind_idx])\n      need = max(0, total_needed - already_have)\n\n      for _ in range(need):\n          move_seq = bfs_to_target(cur_state, kind_idx)\n          if move_seq is None:\n              # Target cannot be reached \u2013 abort early.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)                     # USE to pick up / interact\n\n          # Apply actions to keep the simulated state in sync\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)                     # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt crafting in place.\n      actions.append(4)                     # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:43:28.059147", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # ----------------------------------------------------------------------\n  # Action identifiers \u2013 match the default CraftWorld ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells that contain any entity are treated as blocked,\n  # except the target cells themselves (we only need to get next to them).\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Quick test \u2013 already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # Cannot step onto occupied cells.\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              # Check adjacency after the move.\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell.\n      return []\n\n  # ----------------------------------------------------------------------\n  # Retrieve world / state objects from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the state only.\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  # If the goal is already primitive (no recipe), nothing to do.\n  if not primitives_needed:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid          # shape (W, H, n_kinds)\n  pos = tuple(state.pos)     # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()          # locations already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells that currently contain this primitive.\n          prim_locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          # Discard locations we have already harvested.\n          prim_locs = [loc for loc in prim_locs if loc not in harvested]\n          if not prim_locs:\n              # No more primitives of this type on the map \u2013 give up.\n              break\n          # Choose the closest primitive (Manhattan distance).\n          prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = prim_locs[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement to update the agent's position.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use action to pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # After picking up, the cell becomes empty \u2013 update occupancy.\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name or already an int).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Find all workshop cells of the required type.\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          # Move to the nearest workshop.\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          # Use to perform the crafting action.\n          actions.append(USE)\n      else:\n          # No workshop found \u2013 fall back to using the current cell.\n          actions.append(USE)\n  else:\n      # Recipe does not require a specific workshop.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:43:29.193101", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Imports and basic constants\n  # ----------------------------------------------------------------------\n  import numpy as np\n  from collections import deque\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP:   (0, -1),\n      LEFT: (-1, 0),\n      RIGHT:(1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any of the\n  # positions in `targets`.  Cells that are occupied (any non\u2011zero kind)\n  # are treated as blocked.\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      w, h = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              new_path = path + [act]\n              # Check adjacency after this move\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              visited.add((nx, ny))\n              q.append((nx, ny, new_path))\n      # No reachable adjacent cell\n      return []\n\n  # ----------------------------------------------------------------------\n  # Retrieve world and current state from the environment\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # May be wrapped; ensure a reset so a state exists\n      if not hasattr(env, \"_current_state\") or env._current_state is None:\n          env.reset()\n      state = env._current_state\n      world = state.world\n  else:\n      # Ensure we have a state object for position / grid information\n      if not hasattr(env, \"_current_state\") or env._current_state is None:\n          env.reset()\n      state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine which primitive resources are needed for one arrow\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  if not primitives_needed:\n      # Arrow is already a primitive \u2013 nothing to do\n      return []\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask\n  # ----------------------------------------------------------------------\n  grid = state.grid                         # (W, H, n_kinds)\n  pos = tuple(state.pos)                    # (x, y)\n  occupied = np.any(grid > 0, axis=2)       # True where any entity exists\n\n  actions = []\n  harvested = set()                         # locations already collected\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first)\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells that currently contain this primitive\n          prim_cells = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          # Remove cells we have already harvested\n          prim_cells = [c for c in prim_cells if c not in harvested]\n          if not prim_cells:\n              # No more of this primitive left on the map \u2013 give up\n              break\n\n          # Choose the nearest primitive (Manhattan distance)\n          prim_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          target = prim_cells[0]\n\n          # Plan a path to a cell adjacent to the primitive\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate the movement to update `pos`\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy (the cell becomes empty after pickup)\n          occupied[target] = False\n          # Also clear the primitive from the grid representation\n          grid[:, :, prim_idx][target] = 0\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at the required workshop (if the recipe specifies one)\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a string name)\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n\n      # Locate workshop cells\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          # Choose the nearest workshop\n          ws_cells.sort(key=lambda c: abs(c[0] - pos[0]) + abs(c[1] - pos[1]))\n          ws_target = ws_cells[0]\n\n          # Move adjacent to the workshop\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Use to craft the arrow\n          actions.append(USE)\n      else:\n          # No workshop found \u2013 fall back to using current position\n          actions.append(USE)\n  else:\n      # No specific workshop required; just use at current location\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:43:49.485473", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # Identify the index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # item not defined in this world\n      return []\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that brings\n  # the agent to a position where the cell directly in front contains\n  # `target_kind`. Returns None if unreachable.\n  # ----------------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # Mapping from action index to (dx, dy) movement\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          # A cell is walkable if it is inside the grid and empty\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      start_x, start_y = state.pos\n      start_dir = state.dir\n\n      from collections import deque\n      queue = deque()\n      queue.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while queue:\n          x, y, d, actions = queue.popleft()\n          # Is the cell directly in front the target?\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          # Expand neighbours (move + turn)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, actions + [a]))\n\n      # Unreachable\n      return None\n\n  # ----------------------------------------------------------------------\n  # Determine which primitives are required to craft one arrow.\n  # If the recipe is empty, the arrow itself is a primitive that must be\n  # collected directly.\n  # ----------------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              # Cannot reach the required primitive \u2013 abort early.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)   # USE to pick up / interact\n\n          # Keep cur_state in sync.\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          # Workshop unreachable \u2013 abort.\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)   # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt to craft in place.\n      actions.append(4)   # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:43:50.604361", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # item not defined\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns None if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # action \u2192 (dx, dy)\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = state.pos\n      sdir = state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, act_seq = q.popleft()\n          # check cell in front\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return act_seq\n\n          # expand moves (also turning implicitly by moving in that direction)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, act_seq + [a]))\n\n      return None\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for one arrow\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  # If recipe is empty, arrow itself is a primitive to pick up\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the required number of times\n  # --------------------------------------------------------------\n  for prim_idx, req_cnt in primitive_needs.items():\n      for _ in range(req_cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              # cannot reach required primitive \u2013 abort early\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)          # USE to pick up / interact\n\n          # keep cur_state in sync\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)              # USE to craft\n\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt crafting in place\n      actions.append(4)              # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:44:19.596708", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # copy mutable state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Find shortest sequence of movement actions from start to any cell in goals.\n      Cells that contain any entity are treated as obstacles unless they are a goal.\n      \"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # occupied cells block movement unless they are the goal\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update pos according to a list of movement actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect *needed* units of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # list all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              # nothing left; give up\n              break\n          # pick the reachable location with the shortest path\n          best_path = None\n          best_loc = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  best_path = path\n                  best_loc = loc\n                  break\n          if best_path is None:\n              # cannot reach any remaining primitive\n              break\n          actions.extend(best_path)\n          move_along(best_path)\n          # use action to pick it up\n          actions.append(4)   # USE\n          grid[best_loc[0], best_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Guarantee that inventory[item_idx] >= amount, crafting or collecting as needed.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # first make sure all ingredients are available\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # perform the craft\n          actions.append(4)   # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:44:20.740969", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # local copies of mutable state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of movement actions to reach any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # treat any occupied cell as wall unless it's a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update *pos* according to a sequence of movement actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect *needed* units of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # no more primitives available\n          # find the first reachable one (BFS is cheap enough)\n          chosen_path = None\n          chosen_loc = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  chosen_path = p\n                  chosen_loc = loc\n                  break\n          if chosen_path is None:\n              break  # unreachable\n          # move to the primitive and pick it up\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          actions.append(4)  # USE\n          grid[chosen_loc[0], chosen_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Guarantee that inventory[item_idx] >= amount, crafting if needed.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              # primitive: just collect the missing amount\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # non\u2011primitive: use its recipe\n          recipe = recipes.get(item_idx, {})\n          # first ensure all ingredient quantities are present\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to the required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # perform the crafting action\n          actions.append(4)  # USE\n          # update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:44:48.499758", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and fetch the current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for bookkeeping\n\n  # Index of the goal item (\u201carrow\u201d) and its primitive requirements\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if the cell at ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"\n      Find a shortest walkable path from ``start`` to ``goal`` avoiding\n      non\u2011grabbable cells. Returns a list of positions (excluding ``start``,\n      including ``goal``). If no path exists, returns an empty list.\n      \"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # no path found\n\n      # Reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into a list of movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"\n      Return a walkable neighbour of ``target`` that is not occupied by a\n      non\u2011grabbable entity. Preference order: N, S, W, E. If none found,\n      return the target itself (assumed walkable for collection purposes).\n      \"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not found \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive itself\n          path = bfs_path(cur, prim_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local copy of the grid to reflect collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # Move to the appropriate workshop (if the recipe specifies one)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:44:49.624277", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-10-28T19:45:27.104869", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  from collections import deque\n\n  def bfs_path(start, goal):\n      \"\"\"Find a shortest path avoiding non\u2011grabbable obstacles.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions_rev = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      actions_rev.append(DOWN)\n                  elif py == cur[0] + 1:\n                      actions_rev.append(UP)\n                  elif px == cur[1] - 1:\n                      actions_rev.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # cell blocked if any non\u2011grabbable entity occupies it\n                  if np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty (should not happen)\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Return the nearest cell containing ``kind``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = int(np.argmin(dists))\n      return tuple(locations[nearest_idx])\n\n  # --------------------------------------------------------------\n  # Determine goal and required primitives\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # --------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fall back to standing directly on the primitive cell\n              adj = target\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (a blocked move updates direction)\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n  # --------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:45:28.247681", "function_name": "make_arrow", "function_body": "  # Reset the environment and obtain the main objects.\n  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n\n  # Resolve action identifiers (fall back to the default ordering if missing).\n  specs = env.action_specs()\n  DOWN = specs.get(\"DOWN\", 0)\n  UP = specs.get(\"UP\", 1)\n  LEFT = specs.get(\"LEFT\", 2)\n  RIGHT = specs.get(\"RIGHT\", 3)\n  USE = specs.get(\"USE\", 4)\n\n  # --------------------------------------------------------------\n  # Helper utilities\n  # --------------------------------------------------------------\n  from collections import deque\n\n  # Non\u2011grabbable entity indices \u2013 treat these cells as obstacles.\n  non_grab = list(world.non_grabbable_indices)\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that\n      moves the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable\n      obstacles using BFS.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # Reconstruct the action sequence.\n              rev = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  if py == cur[0] - 1:\n                      rev.append(DOWN)\n                  elif py == cur[0] + 1:\n                      rev.append(UP)\n                  elif px == cur[1] - 1:\n                      rev.append(RIGHT)\n                  elif px == cur[1] + 1:\n                      rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(rev))\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  # Cell is blocked if any non\u2011grabbable entity occupies it.\n                  if np.any(grid[ny, nx, non_grab] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 should not happen for valid scenarios.\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Find the nearest cell that contains ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      nearest = int(np.argmin(dists))\n      return tuple(locs[nearest])\n\n  # --------------------------------------------------------------\n  # Identify goal (arrow) and its primitive requirements.\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {primitive_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # --------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx),\n                         (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not np.any(grid[ny, nx, non_grab] > 0):\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; fall back to the primitive cell itself.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a move towards it; direction changes even if blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # --------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow.\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:45:49.194387", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Determine which primitive resources are needed.\n  # If the arrow has no recipe, treat it as a primitive to pick up.\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:\n      needed = {arrow_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that brings\n  # the agent to a position where the cell directly in front contains\n  # `target_kind`. Returns None if the target cannot be reached.\n  # ------------------------------------------------------------------\n  def bfs_to_target(st, target_kind):\n      grid = st.grid\n      W, H = grid.shape[:2]\n      deltas = {0: (0, 1), 1: (0, -1), 2: (-1, 0), 3: (1, 0)}  # DOWN, UP, LEFT, RIGHT\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      q.append((st.pos[0], st.pos[1], st.dir, []))\n      visited = {(st.pos[0], st.pos[1], st.dir)}\n\n      while q:\n          x, y, d, seq = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return seq\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, seq + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives.\n  # ------------------------------------------------------------------\n  for kind_idx, count in needed.items():\n      for _ in range(count):\n          seq = bfs_to_target(state, kind_idx)\n          if seq is None:\n              # Primitive unreachable \u2013 abort planning.\n              return actions\n          actions.extend(seq)\n          actions.append(4)  # USE to pick up / interact\n\n          # Keep the simulated state in sync.\n          for a in seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      seq = bfs_to_target(state, workshop_idx)\n      if seq is None:\n          # Workshop unreachable \u2013 still attempt a USE (will simply fail).\n          actions.append(4)\n          _, state = state.step(4)\n      else:\n          actions.extend(seq)\n          actions.append(4)  # USE to craft\n          for a in seq + [4]:\n              _, state = state.step(a)\n  else:\n      # No specific workshop; craft in place.\n      actions.append(4)\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:45:50.316746", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # Determine primitive resources needed for a single arrow.\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  # If the arrow has no recipe (i.e., it is itself a primitive), just pick it up.\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that brings\n  # the agent to a position where the cell directly in front contains\n  # `target_kind`. Returns None if unreachable.\n  # ------------------------------------------------------------------\n  def _bfs_to_target(st, target_kind):\n      grid = st.grid\n      W, H = grid.shape[:2]\n\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      q.append((st.pos[0], st.pos[1], st.dir, []))\n      visited = {(st.pos[0], st.pos[1], st.dir)}\n\n      while q:\n          x, y, d, seq = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return seq\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, seq + [a]))\n\n      return None\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          move_seq = _bfs_to_target(state, prim_idx)\n          if move_seq is None:\n              # Cannot reach the required primitive; abort planning.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up / interact\n\n          # Update simulated state.\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # 2) Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(state, workshop_idx)\n      if move_seq is None:\n          # Workshop unreachable; abort.\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)  # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      # No specific workshop \u2013 craft in place.\n      actions.append(4)  # USE to craft\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:46:16.229792", "function_name": "make_arrow", "function_body": "  # Retrieve the underlying scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Get the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to produce a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque()\n  frontier.append(Node(init_state, []))\n  visited.add(_state_hash(init_state))\n\n  # Limit on plan length to keep search tractable\n  MAX_STEPS = 500\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Do not expand paths that are already too long\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # If we exit the loop no plan was found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:46:31.920818", "function_name": "make_arrow", "function_body": "  # Get the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to create a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 400                     # hard limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:46:54.201240", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh state and obtain the initial state\n  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Goal item index (the arrow or whatever the task specifies)\n  goal_idx = env.task.goal\n\n  # Mapping of action indices to movement deltas (DOWN, UP, LEFT, RIGHT)\n  deltas = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0)    # RIGHT\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper utilities\n  # ----------------------------------------------------------------------\n  def walkable(grid, x, y):\n      \"\"\"Return True if (x, y) is inside the grid and not blocked by a non\u2011grabbable entity.\"\"\"\n      W, H = grid.shape[:2]\n      if not (0 <= x < W and 0 <= y < H):\n          return False\n      # a cell is blocked if any non\u2011grabbable kind is present there\n      non_grab = world.non_grabbable_indices\n      if not non_grab:\n          return True\n      return not np.any(grid[x, y, list(non_grab)])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"\n      Bread\u2011first search for a sequence of movement actions (0\u20113) that ends\n      with the agent facing a cell containing `target_kind`. Returns the\n      action list, or an empty list if already facing the target or unreachable.\n      \"\"\"\n      grid = state.grid\n      W, H = grid.shape[:2]\n      sx, sy = state.pos\n      sdir = state.dir\n\n      # Check if we are already facing the target\n      dx, dy = deltas[sdir]\n      fx, fy = sx + dx, sy + dy\n      if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n          return []\n\n      queue = deque()\n      queue.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while queue:\n          x, y, d, acts = queue.popleft()\n          # Look ahead from current orientation\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if 0 <= fx < W and 0 <= fy < H and grid[fx, fy, target_kind] > 0:\n              return acts\n\n          # Expand neighbours (move in any of the four directions)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(grid, nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, acts + [a]))\n      # Unreachable\n      return []\n\n  def target_ahead(state, kind):\n      \"\"\"True if the cell directly in front of the agent contains `kind`.\"\"\"\n      x, y = state.pos\n      d = state.dir\n      dx, dy = deltas[d]\n      fx, fy = x + dx, y + dy\n      W, H = state.grid.shape[:2]\n      return (0 <= fx < W and 0 <= fy < H and state.grid[fx, fy, kind] > 0)\n\n  # ----------------------------------------------------------------------\n  # Planning\n  # ----------------------------------------------------------------------\n  actions = []\n\n  # 1) Gather all primitive resources required for the goal\n  primitive_needs = world.cookbook.primitives_for(goal_idx)  # {kind_idx: count}\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_seq = bfs_to_target(cur_state, prim_idx)\n          # If we cannot reach the primitive, abort planning\n          if not move_seq and not target_ahead(cur_state, prim_idx):\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up the primitive\n\n          # Update the simulated state so subsequent searches are accurate\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # 2) Move to the required workshop (if any) and craft the goal item\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if not move_seq and not target_ahead(cur_state, workshop_idx):\n          # Workshop unreachable \u2013 still issue a USE (will simply do nothing)\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)  # USE to craft at the workshop\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No dedicated workshop \u2013 craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T19:46:55.342794", "function_name": "make_arrow", "function_body": "  # Reset environment to a clean start and fetch initial state\n  env.reset()\n  cur_state = env._current_state\n  world = env.world\n\n  # Goal item index (provided by the task)\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Direction vectors: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT\n  deltas = [(1, 0), (-1, 0), (0, -1), (0, 1)]\n\n  def in_bounds(r, c, h, w):\n      return 0 <= r < h and 0 <= c < w\n\n  def walkable(grid, r, c):\n      \"\"\"A cell is walkable if it is inside the grid and does not contain any\n      non\u2011grabbable entity.\"\"\"\n      h, w, _ = grid.shape\n      if not in_bounds(r, c, h, w):\n          return False\n      # non\u2011grabbable indices are stored in the world object\n      non_grab = world.non_grabbable_indices\n      return not np.any(grid[r, c, list(non_grab)])\n\n  from collections import deque\n\n  def bfs_to_target(state, target_kind):\n      \"\"\"\n      Bread\u2011first search that returns a list of movement actions (0\u20113) which\n      ends with the agent facing a cell that contains `target_kind`.\n      Returns an empty list if already facing the target or if the target is\n      unreachable.\n      \"\"\"\n      grid = state.grid\n      h, w, _ = grid.shape\n      sr, sc = state.pos\n      sdir = state.dir\n\n      # check if we are already facing the target\n      dr, dc = deltas[sdir]\n      fr, fc = sr + dr, sc + dc\n      if in_bounds(fr, fc, h, w) and grid[fr, fc, target_kind] > 0:\n          return []\n\n      # BFS over (row, col, direction)\n      q = deque()\n      q.append((sr, sc, sdir, []))\n      visited = {(sr, sc, sdir)}\n\n      while q:\n          r, c, d, acts = q.popleft()\n          # look ahead from current orientation\n          dr, dc = deltas[d]\n          nr, nc = r + dr, c + dc\n          if in_bounds(nr, nc, h, w) and grid[nr, nc, target_kind] > 0:\n              return acts\n          # expand to four possible movement actions\n          for a in range(4):\n              ar, ac = deltas[a]\n              rr, cc = r + ar, c + ac\n              if not walkable(grid, rr, cc):\n                  continue\n              if (rr, cc, a) in visited:\n                  continue\n              visited.add((rr, cc, a))\n              q.append((rr, cc, a, acts + [a]))\n      # unreachable\n      return []\n\n  def cell_ahead_contains(state, kind):\n      \"\"\"True if the cell directly in front of the agent contains `kind`.\"\"\"\n      r, c = state.pos\n      d = state.dir\n      dr, dc = deltas[d]\n      nr, nc = r + dr, c + dc\n      h, w, _ = state.grid.shape\n      return in_bounds(nr, nc, h, w) and state.grid[nr, nc, kind] > 0\n\n  # ------------------------------------------------------------------\n  # Planning\n  # ------------------------------------------------------------------\n  actions = []\n\n  # 1) Gather all primitive resources required for the goal item\n  primitive_needs = world.cookbook.primitives_for(goal_idx)   # {kind_idx: count}\n  for prim_kind, count in primitive_needs.items():\n      for _ in range(count):\n          move_seq = bfs_to_target(cur_state, prim_kind)\n          # If BFS failed and we are not already facing the primitive, abort\n          if not move_seq and not cell_ahead_contains(cur_state, prim_kind):\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)          # USE to pick up\n          # Update current state by executing the actions we just added\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # 2) Move to the required workshop (if any) and craft the item\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = bfs_to_target(cur_state, workshop_idx)\n      if not move_seq and not cell_ahead_contains(cur_state, workshop_idx):\n          # Workshop unreachable \u2013 still issue a USE (will have no effect)\n          actions.append(4)\n          _, cur_state = cur_state.step(4)\n      else:\n          actions.extend(move_seq)\n          actions.append(4)          # USE to craft\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n  else:\n      # No dedicated workshop \u2013 craft in place\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 1, "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T19:47:24.401830", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined in CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and obtain current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Goal item index and its primitive requirements\n  goal_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"True if cell at ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest walkable path from ``start`` to ``goal`` (excluding start).\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # no path found\n\n      # Reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Translate a position path into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Locate the nearest cell containing ``kind``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (preferring N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, cnt in required.items():\n      for _ in range(cnt):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive missing \u2013 abort early\n              return actions\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself\n          path = bfs_path(cur, prim_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update grid to reflect collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # If the recipe specifies a workshop, go there\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:47:25.532297", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and grab the current state/world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for bookkeeping\n\n  # Index of the goal item (\"arrow\") and its primitive requirements\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"True if the cell at ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest walkable path from ``start`` to ``goal`` (list of positions).\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # no path found\n\n      # reconstruct path\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Return position of the nearest cell containing ``kind``.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Find a walkable neighbour of ``target`` (prefers N,S,W,E).\"\"\"\n      y, x = target\n      for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current agent position (y, x)\n\n  # Collect each required primitive the needed number of times\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              return actions  # primitive missing; abort\n\n          # Move to a free cell adjacent to the primitive\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Ensure we are facing the primitive: move one step away and back if needed\n          dy = prim_loc[0] - cur[0]\n          dx = prim_loc[1] - cur[1]\n          needed_dir = None\n          if dy == -1:\n              needed_dir = DOWN\n              opposite = UP\n              opp_move = (cur[0] - 1, cur[1])\n          elif dy == 1:\n              needed_dir = UP\n              opposite = DOWN\n              opp_move = (cur[0] + 1, cur[1])\n          elif dx == -1:\n              needed_dir = RIGHT\n              opposite = LEFT\n              opp_move = (cur[0], cur[1] - 1)\n          elif dx == 1:\n              needed_dir = LEFT\n              opposite = RIGHT\n              opp_move = (cur[0], cur[1] + 1)\n\n          if needed_dir is not None:\n              # Try a quick turn by stepping away and back if possible\n              if 0 <= opp_move[0] < grid.shape[0] and 0 <= opp_move[1] < grid.shape[1] and not is_blocked(opp_move):\n                  # step away\n                  actions.append({UP: UP, DOWN: DOWN, LEFT: LEFT, RIGHT: RIGHT}[opposite])\n                  # step back towards primitive\n                  actions.append(needed_dir)\n              else:\n                  # cannot step away; just add a dummy move in needed direction (will stay in place)\n                  actions.append(needed_dir)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update local grid copy to reflect collection\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # Move to the workshop required for crafting the arrow (if any)\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = ws_loc\n\n  # Final USE to craft the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 26, "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T19:47:49.956456", "function_name": "make_arrow", "function_body": "  # obtain scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initial state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  import collections\n\n  Node = collections.namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      # hash based on position, direction, inventory, and grid contents\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = collections.deque([Node(init_state, [])])\n\n  MAX_STEPS = 500                     # safety limit on plan length\n  n_actions = getattr(world, \"n_actions\", 5)   # default action space size\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # no plan found within budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:48:05.607801", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Hash function for fast visited\u2011set lookup\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 300                     # depth limit to keep search tractable\n  n_actions = getattr(world, \"n_actions\", 5)   # size of the action space\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in the inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long trajectories\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt = cur_state.step(a)\n          h = _state_hash(nxt)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt, node.actions + [a]))\n\n  # No plan found within the search budget\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:48:32.751602", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of actions (DOWN,UP,LEFT,RIGHT) to reach any goal cell.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # allow stepping onto a goal cell even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update simulated position according to a sequence of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect `needed` units of a primitive from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells that still contain the primitive\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break  # nothing left\n          # pick the closest reachable location\n          chosen_path = None\n          chosen_loc = None\n          for loc in locations:\n              p = bfs(pos, {loc})\n              if p is not None:\n                  chosen_path = p\n                  chosen_loc = loc\n                  break\n          if chosen_path is None:\n              break  # cannot reach any remaining primitive\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          # use action to pick up\n          actions.append(4)  # USE\n          grid[chosen_loc[0], chosen_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Make sure at least `amount` of `item_idx` is present in inventory.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          # primitive: just collect\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # ensure each ingredient is available for one craft\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to required workshop if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # perform the craft action\n          actions.append(4)  # USE\n          # update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target item\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:48:33.883504", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # copy mutable state\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return list of actions to reach any cell in *goals* (shortest path).\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # treat any occupied cell as blocked, except when it is a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update simulated position according to *path*.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect *needed* units of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate all cells that still contain the primitive\n          locations = [\n              (x, y)\n              for x in range(width)\n              for y in range(height)\n              if grid[x, y, prim_idx] > 0\n          ]\n          if not locations:\n              break  # nothing left, should not happen for solvable tasks\n          # pick the first reachable location\n          path = None\n          target = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  target = loc\n                  break\n          if path is None:\n              break  # unreachable primitive\n          actions.extend(path)\n          move_along(path)\n          # use action to pick up\n          actions.append(4)  # USE\n          grid[target[0], target[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Make sure inventory[item_idx] >= amount, crafting/collecting as needed.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          # primitive -> just collect\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # get recipe\n          recipe = recipes.get(item_idx, {})\n          # ensure all ingredients are available\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [\n                  (x, y)\n                  for x in range(width)\n                  for y in range(height)\n                  if grid[x, y, ws_idx] > 0\n              ]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # perform craft action\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:49:04.028355", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Action indices (as defined by CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset the environment and obtain the current state/world\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for bookkeeping\n\n  # Goal item index and its primitive requirements\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # Helper data\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos, ignore_target=False):\n      \"\"\"Return True if ``pos`` contains a non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      if ignore_target:\n          return False\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs(start, goal):\n      \"\"\"Shortest walkable path from ``start`` to ``goal`` avoiding obstacles.\n      Returns a list of positions (excluding ``start``, including ``goal``).\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited:\n                      blocked = is_blocked(nxt, ignore_target=(nxt == goal))\n                      if not blocked:\n                          visited[nxt] = cur\n                          q.append(nxt)\n      else:\n          return []  # no path found\n\n      # Reconstruct path backwards\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions into movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  actions = []\n  cur = state.pos  # current position (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not found \u2013 abort early\n              return actions\n\n          # Move to the primitive cell\n          path = bfs(cur, prim_loc)\n          if not path and cur != prim_loc:\n              return actions\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick it up\n          actions.append(USE)\n\n          # Update local grid copy\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the appropriate workshop (if required)\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs(cur, ws_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = ws_loc\n\n  # ------------------------------------------------------------------\n  # Craft the arrow\n  # ------------------------------------------------------------------\n  actions.append(USE)\n\n  return actions", "env_interactions": 22, "island_id": 3, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T19:49:05.152456", "function_name": "make_arrow", "function_body": "  \"\"\"Implementation for make_arrow_vn (variant 2).\n\n  This version uses BFS to find shortest walkable paths while avoiding\n  non\u2011grabbable entities (e.g., water, trees).  It collects all required\n  primitives for the 'arrow' recipe, moves to the appropriate workshop\n  (if any), and finally issues a USE action to craft the arrow.\n  \"\"\"\n  import numpy as np\n  from collections import deque\n\n  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Reset environment and obtain the current state / world.\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # mutable copy for bookkeeping\n\n  # Index of the target item ('arrow') and its primitive requirements.\n  arrow_idx = world.cookbook.index.index('arrow')\n  required = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  non_grab = list(world.non_grabbable_indices)\n\n  def is_blocked(pos):\n      \"\"\"Return True if the cell at ``pos`` contains any non\u2011grabbable entity.\"\"\"\n      y, x = pos\n      return np.any(grid[y, x, non_grab] > 0)\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest walkable path from ``start`` to ``goal`` avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      h, w = grid.shape[:2]\n      q = deque([start])\n      visited = {start: None}\n      while q:\n          cur = q.popleft()\n          if cur == goal:\n              break\n          y, x = cur\n          for ny, nx in ((y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)):\n              if 0 <= ny < h and 0 <= nx < w:\n                  nxt = (ny, nx)\n                  if nxt not in visited and not is_blocked(nxt):\n                      visited[nxt] = cur\n                      q.append(nxt)\n      else:\n          return []  # No path found\n\n      # Reconstruct path (excluding start, including goal)\n      path = []\n      cur = goal\n      while cur != start:\n          path.append(cur)\n          cur = visited[cur]\n      path.reverse()\n      return path\n\n  def path_to_actions(path):\n      \"\"\"Convert a list of positions (including start) to movement actions.\"\"\"\n      acts = []\n      for (y1, x1), (y2, x2) in zip(path, path[1:]):\n          if y2 == y1 + 1:\n              acts.append(DOWN)\n          elif y2 == y1 - 1:\n              acts.append(UP)\n          elif x2 == x1 + 1:\n              acts.append(RIGHT)\n          elif x2 == x1 - 1:\n              acts.append(LEFT)\n      return acts\n\n  def nearest_cell(kind, from_pos):\n      \"\"\"Find the nearest cell containing ``kind`` (primitive or workshop).\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  def free_adjacent(target):\n      \"\"\"Return a walkable neighbour of ``target`` (preferring N, S, W, E).\"\"\"\n      ty, tx = target\n      for ny, nx in ((ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)):\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if not is_blocked((ny, nx)):\n                  return (ny, nx)\n      return target  # fallback (assumed walkable for collection)\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  cur = state.pos  # current position (y, x)\n\n  # Collect each primitive the required number of times.\n  for prim_idx, count in required.items():\n      for _ in range(count):\n          prim_loc = nearest_cell(prim_idx, cur)\n          if prim_loc is None:\n              # Primitive not present; abort early.\n              return actions\n\n          # Move to a free cell adjacent to the primitive.\n          stand_pos = free_adjacent(prim_loc)\n          path = bfs_path(cur, stand_pos)\n          actions.extend(path_to_actions([cur] + path))\n          cur = stand_pos\n\n          # Step onto the primitive cell itself.\n          path = bfs_path(cur, prim_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = prim_loc\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update local copy of the grid to reflect collection.\n          grid[prim_loc[0], prim_loc[1], prim_idx] = 0\n\n  # Move to the workshop required by the recipe (if any).\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_loc = nearest_cell(ws_idx, cur)\n      if ws_loc is not None:\n          path = bfs_path(cur, ws_loc)\n          actions.extend(path_to_actions([cur] + path))\n          cur = ws_loc\n\n  # Final USE to craft the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:49:38.900783", "function_name": "make_arrow", "function_body": "  # Retrieve the scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Find the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  # Helper to create a hashable representation of a state\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_state_hash(init_state))\n\n  # Limits for the search\n  MAX_STEPS = 800\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does the inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible primitive actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:49:54.790976", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = set()\n  frontier = deque()\n  frontier.append(Node(init_state, []))\n  visited.add(_state_hash(init_state))\n\n  MAX_STEPS = 2000\n  n_actions = getattr(world, \"n_actions\", 5)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: does inventory contain at least one arrow?\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Skip overly long paths\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, nxt_state = cur_state.step(a)\n          h = _state_hash(nxt_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 2, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:50:13.464872", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) to walk\n      from ``start`` to ``goal`` using a simple Manhattan route.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Find the nearest cell containing ``kind_idx`` (primitive or workshop).\n      Returns the cell coordinates (y, x) or ``None`` if not found.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine which primitives are needed for the 'arrow' item\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # current agent position (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed_prims.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on (prefer empty).\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # No free neighbour; stand on the primitive cell itself.\n              adj = target\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (best\u2011effort direction).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop specified in the recipe (if any) and craft.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:50:14.596638", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = state.grid\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  for prim_idx, needed_cnt in needed_prims.items():\n      for _ in range(needed_cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              adj = (ty, tx)\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (best\u2011effort direction).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # Move to the required workshop (if any) and craft the arrow.\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:50:42.136608", "function_name": "make_arrow", "function_body": "  # Retrieve scenario and world objects\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state for the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # ------------------------------------------------------------------\n  # Bread\u2011first search over (state, action_sequence) pairs.\n  # ------------------------------------------------------------------\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _hash_state(st):\n      \"\"\"Create a hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory (as tuple), and full grid bytes.\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  MAX_STEPS = 300                     # safety bound\n  n_actions = getattr(world, \"n_actions\", 5)   # default to 5 (including USE)\n\n  # Action ordering: try USE first (assumed last index), then movement actions.\n  ordered_actions = list(range(n_actions - 1, -1, -1))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test \u2013 have at least one arrow in inventory.\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit.\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours.\n      for a in ordered_actions:\n          if a >= n_actions:\n              continue\n          _, nxt_state = cur_state.step(a)\n          key = _hash_state(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within the search limits.\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:50:58.100819", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects from the provided env\n  scenario = getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", getattr(env, \"world\", None))\n  if world is None:\n      return []\n\n  # Identify the index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Obtain the initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Helper to create a hashable representation of a CraftState\n  def _hash_state(st):\n      # Position, direction, inventory tuple, and grid bytes\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  visited = set()\n  frontier = deque([Node(init_state, [])])\n  visited.add(_hash_state(init_state))\n\n  # Safety limits\n  MAX_STEPS = 300\n  n_actions = getattr(world, \"n_actions\", 5)  # default to 5 actions (including USE)\n\n  # Prefer the USE action first, then movement actions (order may vary)\n  # Assuming USE is the last action index (common in CraftWorld)\n  ordered_actions = list(range(n_actions - 1, -1, -1))\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Depth limit to keep search tractable\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand neighbours\n      for a in ordered_actions:\n          if a >= n_actions:\n              continue\n          _, nxt_state = cur_state.step(a)\n          key = _hash_state(nxt_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(nxt_state, node.actions + [a]))\n\n  # No plan found within limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:51:21.141217", "function_name": "make_arrow", "function_body": "", "env_interactions": 0, "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-10-28T19:51:22.276875", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # ----------------------------------------------------------------------\n  # Action identifiers \u2013 match the default CraftWorld ordering.\n  # ----------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MOVE_DELTAS = {\n      DOWN: (0, 1),\n      UP: (0, -1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from `start`\n  # to a cell that is *adjacent* (Manhattan distance = 1) to any cell in\n  # `targets`.  Cells that contain any entity are treated as blocked,\n  # except the target cells themselves (we only need to get next to them).\n  # ----------------------------------------------------------------------\n  def _bfs_adjacent(start, targets, occupied):\n      width, height = occupied.shape\n      target_set = set(targets)\n\n      # Already adjacent?\n      for tx, ty in target_set:\n          if abs(start[0] - tx) + abs(start[1] - ty) == 1:\n              return []\n\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n\n      while q:\n          x, y, path = q.popleft()\n          for act, (dx, dy) in MOVE_DELTAS.items():\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              if occupied[nx, ny]:\n                  continue\n              visited.add((nx, ny))\n              new_path = path + [act]\n              for tx, ty in target_set:\n                  if abs(nx - tx) + abs(ny - ty) == 1:\n                      return new_path\n              q.append((nx, ny, new_path))\n      return []  # no reachable adjacent cell\n\n  # ----------------------------------------------------------------------\n  # Retrieve world / state objects from the environment.\n  # ----------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n      world = state.world\n  else:\n      state = getattr(env, \"_current_state\", None)\n      if state is None:\n          env.reset()\n          state = env._current_state\n\n  cookbook = world.cookbook\n  goal_name = \"arrow\"\n  goal_idx = cookbook.index[goal_name]\n\n  # ----------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ----------------------------------------------------------------------\n  primitives_needed = cookbook.primitives_for(goal_idx)  # {prim_idx: count}\n  if not primitives_needed:\n      return []\n\n  # ----------------------------------------------------------------------\n  # Current grid, position and occupancy mask.\n  # ----------------------------------------------------------------------\n  grid = state.grid                     # (W, H, n_kinds)\n  pos = tuple(state.pos)                # (x, y)\n  occupied = np.any(grid > 0, axis=2)   # True where any entity exists\n\n  actions = []\n  harvested = set()                     # cells already collected from\n\n  # ----------------------------------------------------------------------\n  # Collect each required primitive (greedy nearest\u2011first).\n  # ----------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitives_needed.items():\n      gathered = 0\n      while gathered < needed_cnt:\n          # Locate all cells that currently contain this primitive.\n          prim_locs = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n          prim_locs = [loc for loc in prim_locs if loc not in harvested]\n          if not prim_locs:\n              break  # cannot find more of this primitive\n\n          # Choose the nearest one (Manhattan distance).\n          prim_locs.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target = prim_locs[0]\n\n          # Plan a path to a cell adjacent to the primitive.\n          path = _bfs_adjacent(pos, [target], occupied)\n          actions.extend(path)\n\n          # Simulate movement.\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n\n          # Pick up the primitive.\n          actions.append(USE)\n          harvested.add(target)\n          gathered += 1\n\n          # Update occupancy mask (the cell becomes empty after pickup).\n          occupied[target] = False\n\n  # ----------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ----------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index.\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = workshop_key\n      # Find workshop locations.\n      ws_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if ws_cells:\n          ws_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          ws_target = ws_cells[0]\n          path = _bfs_adjacent(pos, [ws_target], occupied)\n          actions.extend(path)\n          for act in path:\n              dx, dy = MOVE_DELTAS[act]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(USE)\n      else:\n          # No workshop found; just attempt to use current cell.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:51:56.120171", "function_name": "make_arrow", "function_body": "  # --------------------------------------------------------------\n  # Constants for actions (match CraftWorld ordering)\n  # --------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # --------------------------------------------------------------\n  # Helper: BFS returning a list of actions that moves the agent from\n  #   `start` to a cell adjacent (Manhattan distance \u2264 1) to any of\n  #   the positions in `targets`.  All cells with any non\u2011zero kind\n  #   are treated as obstacles.\n  # --------------------------------------------------------------\n  def _bfs_path(start, targets, grid):\n      w, h, _ = grid.shape\n      occupied = np.any(grid > 0, axis=2)          # blocked cells\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are already adjacent (or on) a target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found \u2013 return empty list.\n      return []\n\n  # --------------------------------------------------------------\n  # Locate the world and cookbook objects inside the environment.\n  # --------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      state_wrapper = getattr(env, \"_current_state\", None)\n      if state_wrapper is not None:\n          world = getattr(state_wrapper, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Unable to locate CraftWorld instance in env.\")\n\n  cookbook = world.cookbook\n\n  # --------------------------------------------------------------\n  # Identify the goal (hard\u2011coded to \"arrow\") and its primitive needs.\n  # --------------------------------------------------------------\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not present in cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # --------------------------------------------------------------\n  # Ensure we have a current state (reset if the env is fresh).\n  # --------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []                    # final action list to return\n  harvested = set()               # cells already used for collection\n\n  # --------------------------------------------------------------\n  # Collect each required primitive.\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells currently containing this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Order by Manhattan distance from current position (greedy).\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], grid)\n          actions.extend(path)\n          # Update simulated position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive.\n          actions.append(USE)\n          # Mark the cell empty for future planning.\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # --------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or an integer).\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str)\n                      else int(workshop_key))\n      # Find all workshop cells in the current grid.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], grid)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n      else:\n          # No visible workshop \u2013 attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T19:51:57.258194", "function_name": "make_arrow", "function_body": "  import numpy as np\n  import collections\n\n  # Action indices (match CraftWorld's definition)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # `start` to a cell adjacent (Manhattan distance \u2264 1) to any target.\n  # `occupied` is a 2\u2011D bool array where True marks blocked cells.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Stop if we are adjacent to any target.\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Explore neighbours.\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable position.\n      return []\n\n  # ------------------------------------------------------------------\n  # Locate the world and cookbook objects inside the environment.\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers expose the world via the current state.\n      wrapper_state = getattr(env, \"_current_state\", None)\n      if wrapper_state is not None:\n          world = getattr(wrapper_state, \"world\", None)\n  if world is None:\n      raise RuntimeError(\"Cannot locate CraftWorld instance in the environment.\")\n\n  cookbook = world.cookbook\n\n  # Goal item is \"arrow\".\n  goal_name = \"arrow\"\n  if goal_name not in cookbook.index.contents:\n      raise ValueError(f\"Goal '{goal_name}' not found in cookbook.\")\n  goal_idx = cookbook.index[goal_name]\n\n  # Primitive requirements for a single arrow.\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a fresh state (reset if necessary).\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)          # current (x, y)\n  grid = state.grid.copy()        # mutable copy for planning\n\n  actions = []\n  harvested = set()               # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # All cells that currently contain this primitive.\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Greedy nearest\u2011first ordering.\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n\n          # Occupancy map for planning (treat the target cell as free for the final step).\n          occupied = np.any(grid > 0, axis=2)\n          occupied[loc[0], loc[1]] = False\n\n          # Move adjacent to the primitive.\n          path = _bfs_path(pos, [loc], occupied)\n          actions.extend(path)\n\n          # Update simulated position.\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Mark the cell as empty for future planning.\n          grid[loc[0], loc[1], prim_idx] = 0\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (may be a name or an integer).\n      if isinstance(workshop_key, str):\n          workshop_idx = cookbook.index[workshop_key]\n      else:\n          workshop_idx = int(workshop_key)\n\n      # Locate all workshop cells.\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop.\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n\n          occupied = np.any(grid > 0, axis=2)\n          # Move adjacent to the workshop.\n          path = _bfs_path(pos, [target_ws], occupied)\n          actions.extend(path)\n\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n\n          # Use the workshop to craft the arrow.\n          actions.append(USE)\n      else:\n          # No visible workshop \u2013 attempt to craft in place.\n          actions.append(USE)\n  else:\n      # No specific workshop required.\n      actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
