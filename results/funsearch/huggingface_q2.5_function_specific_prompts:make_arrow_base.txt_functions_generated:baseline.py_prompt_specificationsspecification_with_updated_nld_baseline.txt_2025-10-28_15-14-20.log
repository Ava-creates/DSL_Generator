{"timestamp": "2025-10-28T19:54:00.568721", "function_name": "make_arrow", "function_body": "  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # hashable representation of a CraftState for visited set\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 1000                     # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 actions (0\u20114)\n\n  # prioritize using the tool before moving\n  action_order = [4] + [i for i in range(n_actions) if i != 4]\n\n  # primitive requirements for the goal (may be useful for future pruning)\n  try:\n      primitive_requirements = world.cookbook.primitives_for(target_idx)\n  except Exception:\n      primitive_requirements = {}\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # check if goal achieved\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # expand actions in the chosen order\n      for a in action_order:\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # no feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:54:16.364264", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or getattr(env, \"scenario\", env)\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initialise the starting state\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  # Helper to create a hashable representation of a state for the visited set\n  def _state_hash(st):\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_STEPS = 1000                      # safety bound on plan length\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 actions (0\u20114)\n\n  # Optional: primitive requirements for the target (may be useful for pruning)\n  try:\n      primitive_requirements = world.cookbook.primitives_for(target_idx)\n  except Exception:\n      primitive_requirements = {}\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long candidate plans\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand all possible actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          h = _state_hash(next_state)\n          if h not in visited:\n              visited.add(h)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No feasible plan found within the limits\n  return []", "env_interactions": 20, "island_id": 5, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T19:54:41.098655", "function_name": "make_arrow", "function_body": "  # Reset environment and get references to underlying objects.\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # work on a mutable copy\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  non_grab = list(world.non_grabbable_indices)\n\n  def bfs(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding non\u2011grabbable\n      obstacles. ``start`` and ``goal`` are (y, x) tuples.\"\"\"\n      H, W = grid.shape[:2]\n      visited = np.full((H, W), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct path\n              actions = []\n              cur = goal\n              while cur != start:\n                  py, px = prev[cur]\n                  dy, dx = cur[0] - py, cur[1] - px\n                  if dy == 1:\n                      actions.append(DOWN)\n                  elif dy == -1:\n                      actions.append(UP)\n                  elif dx == 1:\n                      actions.append(RIGHT)\n                  elif dx == -1:\n                      actions.append(LEFT)\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < H and 0 <= nx < W and not visited[ny, nx]:\n                  if np.any(grid[ny, nx, non_grab] > 0):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list.\n      return []\n\n  def find_nearest(kind, from_pos):\n      \"\"\"Return coordinates (y, x) of the nearest cell containing ``kind``.\n      If none exist, return None.\"\"\"\n      locs = np.argwhere(grid[:, :, kind] > 0)\n      if locs.size == 0:\n          return None\n      dists = np.abs(locs[:, 0] - from_pos[0]) + np.abs(locs[:, 1] - from_pos[1])\n      return tuple(locs[dists.argmin()])\n\n  # ------------------------------------------------------------------\n  # Determine the goal (arrow) and required primitives.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n          ty, tx = target\n\n          # Choose a free adjacent cell to stand on before using.\n          adj = None\n          for ny, nx in [(ty - 1, tx), (ty + 1, tx), (ty, tx - 1), (ty, tx + 1)]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  if not np.any(grid[ny, nx, non_grab] > 0):\n                      adj = (ny, nx)\n                      break\n          if adj is None:\n              # Fallback: stand directly on the primitive cell.\n              adj = target\n\n          # Move to the adjacent cell.\n          actions += bfs(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (issue a movement that will be blocked).\n          dy, dx = ty - cur_pos[0], tx - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n          # Update the grid to reflect the collection.\n          grid[ty, tx, prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += bfs(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Trigger crafting at the current location.\n  actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 7, "scores": {"3": 0.5}}
