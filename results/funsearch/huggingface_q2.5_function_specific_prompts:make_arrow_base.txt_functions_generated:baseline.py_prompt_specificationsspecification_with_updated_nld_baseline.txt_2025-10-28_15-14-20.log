y\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, acts + [a]))\n\n      # Unreachable\n      return []\n\n  # --------------------------------------------------------------\n  # Determine primitive requirements for a single arrow\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # --------------------------------------------------------------\n  for prim_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          move_actions = _bfs_to_target(cur_state, prim_idx)\n          # If BFS failed but we are already adjacent, we can still pick up\n          if not move_actions and not cur_state.next_to(prim_idx):\n              # cannot reach this primitive \u2013 abort early\n              return actions\n          actions.extend(move_actions)\n          actions.append(4)                     # USE to pick up\n          # Apply actions to keep cur_state in sync\n          for a in move_actions + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_actions = _bfs_to_target(cur_state, workshop_idx)\n      actions.extend(move_actions)\n      actions.append(4)                     # USE to craft\n      for a in move_actions + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt crafting in place\n      actions.append(4)                     # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:17:20.348746", "function_name": "make_arrow", "function_body": "  actions = []\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {primitive_idx: count}\n  state = env._current_state\n  # Work on a copy so we can keep track of what we have already taken\n  grid = state.grid.copy()\n  pos = tuple(state.pos)  # current (x, y) position\n\n  def _move(cur, tgt):\n      \"\"\"Return a list of actions moving Manhattan\u2011style from cur to tgt.\"\"\"\n      moves = []\n      x, y = cur\n      tx, ty = tgt\n      while x < tx:\n          moves.append(DOWN)\n          x += 1\n      while x > tx:\n          moves.append(UP)\n          x -= 1\n      while y < ty:\n          moves.append(RIGHT)\n          y += 1\n      while y > ty:\n          moves.append(LEFT)\n          y -= 1\n      return moves\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitives\n  # ----------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate all cells that still contain this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # no more of this primitive on the map \u2013 abort early\n              break\n          # choose the nearest one (Manhattan distance)\n          target = min(\n              locations,\n              key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),\n          )\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)          # pick it up\n          grid[pos[0], pos[1], prim_idx] = 0   # remove from our copy\n\n  # ----------------------------------------------------------------------\n  # 2) Go to the appropriate workshop and craft the goal item\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is not None:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locations = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locations:\n          target = min(\n              ws_locations,\n              key=lambda loc: abs(loc[0] - pos[0]) + abs(loc[1] - pos[1]),\n          )\n          actions.extend(_move(pos, target))\n          pos = target\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:17:21.485404", "function_name": "make_arrow", "function_body": "  actions = []\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n  state = env._current_state\n  grid = np.copy(state.grid)          # internal copy we can modify\n  pos = tuple(state.pos)              # (row, col)\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that avoids non\u2011grabbable cells.\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  def bfs(start, targets, blocked_kinds):\n      \"\"\"Return a list of actions (DOWN/UP/RIGHT/LEFT) leading from start to the\n      nearest cell in *targets* while avoiding cells containing any kind in\n      *blocked_kinds*. If no path exists, returns an empty list.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for act, (dx, dy) in (\n              (DOWN, (1, 0)),\n              (UP, (-1, 0)),\n              (RIGHT, (0, 1)),\n              (LEFT, (0, -1)),\n          ):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]):\n                  continue\n              if (nx, ny) in visited:\n                  continue\n              # check if the cell is blocked by any non\u2011grabbable entity\n              blocked = False\n              for k in blocked_kinds:\n                  if grid[nx, ny, k] > 0:\n                      blocked = True\n                      break\n              if blocked:\n                  continue\n              visited.add((nx, ny))\n              q.append(((nx, ny), path + [act]))\n      return []  # no reachable target\n\n  blocked_kinds = list(env.world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # locate remaining instances of this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # nothing left on the map \u2013 break early\n              break\n          target_set = set(locations)\n\n          # try to find a path that respects obstacles\n          path = bfs(pos, target_set, blocked_kinds)\n\n          if not path:\n              # fallback: simple Manhattan moves ignoring obstacles\n              # pick the first location (they are guaranteed reachable in tests)\n              target = locations[0]\n              tx, ty = target\n              while pos[0] < tx:\n                  actions.append(DOWN)\n                  pos = (pos[0] + 1, pos[1])\n              while pos[0] > tx:\n                  actions.append(UP)\n                  pos = (pos[0] - 1, pos[1])\n              while pos[1] < ty:\n                  actions.append(RIGHT)\n                  pos = (pos[0], pos[1] + 1)\n              while pos[1] > ty:\n                  actions.append(LEFT)\n                  pos = (pos[0], pos[1] - 1)\n              actions.append(USE)\n          else:\n              # follow the BFS path\n              actions.extend(path)\n              for a in path:\n                  if a == DOWN:\n                      pos = (pos[0] + 1, pos[1])\n                  elif a == UP:\n                      pos = (pos[0] - 1, pos[1])\n                  elif a == RIGHT:\n                      pos = (pos[0], pos[1] + 1)\n                  elif a == LEFT:\n                      pos = (pos[0], pos[1] - 1)\n              actions.append(USE)\n\n          # update internal copy of the grid \u2013 primitive has been taken\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          target_set = set(ws_locs)\n          path = bfs(pos, target_set, blocked_kinds)\n\n          if not path:\n              # fallback Manhattan moves to the first workshop location\n              tx, ty = ws_locs[0]\n              while pos[0] < tx:\n                  actions.append(DOWN)\n                  pos = (pos[0] + 1, pos[1])\n              while pos[0] > tx:\n                  actions.append(UP)\n                  pos = (pos[0] - 1, pos[1])\n              while pos[1] < ty:\n                  actions.append(RIGHT)\n                  pos = (pos[0], pos[1] + 1)\n              while pos[1] > ty:\n                  actions.append(LEFT)\n                  pos = (pos[0], pos[1] - 1)\n          else:\n              actions.extend(path)\n              for a in path:\n                  if a == DOWN:\n                      pos = (pos[0] + 1, pos[1])\n                  elif a == UP:\n                      pos = (pos[0] - 1, pos[1])\n                  elif a == RIGHT:\n                      pos = (pos[0], pos[1] + 1)\n                  elif a == LEFT:\n                      pos = (pos[0], pos[1] - 1)\n\n          # use the workshop to craft the goal item\n          actions.append(USE)\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:17:46.651176", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of action indices that reaches any target\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      # solvable scenarios should never hit this\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and perform `cnt` USEs\n  # ------------------------------------------------------------------\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)   # USE to pick up the primitive\n\n  # ------------------------------------------------------------------\n  # Gather world / recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  # ------------------------------------------------------------------\n  # Resolve full crafting plan:\n  #   needed_prims -> primitive index \u2192 total count required\n  #   craft_steps  -> list of (item_idx, count) in post\u2011order\n  # ------------------------------------------------------------------\n  needed_prims = {}\n  craft_steps = []\n\n  def resolve(item_idx, mult):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Prepare static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build the action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 1) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      acquire(kind_idx, cnt)\n\n  # 2) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)   # USE at workshop to craft\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:17:47.781960", "function_name": "make_arrow", "function_body": "  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]  # DOWN, UP, LEFT, RIGHT\n\n  def bfs(start, targets, blocked):\n      w, h = grid.shape[:2]\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # should not happen\n\n  def acquire(kind_idx, cnt):\n      nonlocal pos, actions\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(4)  # USE\n\n  # ------------------------------------------------------------------\n  # Gather world and recipe information\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}\n  craft_steps = []\n\n  def resolve(item_idx, mult):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # Static data: grid, blocked cells, dimensions\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # Build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # Collect primitives\n  for kind_idx, cnt in needed_prims.items():\n      acquire(kind_idx, cnt)\n\n  # Craft items at workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h) if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([4] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:18:15.319997", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Determine current position (use live state if available)\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)  # [x, y]\n  else:\n      cur_pos = list(env.scenario.init_pos)   # [x, y]\n\n  # Work on a mutable copy of the static grid for planning\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  _MOVES = [((0, 1), DOWN),   # down  (y+1)\n            ((0, -1), UP),    # up    (y-1)\n            ((-1, 0), LEFT),  # left  (x-1)\n            ((1, 0), RIGHT)]  # right (x+1)\n\n  def _bfs_path(start, goal, occ_grid):\n      \"\"\"Return a list of actions moving from start to goal using BFS.\n      Cells containing any non\u2011zero kind are treated as blocked,\n      except the goal cell itself.\"\"\"\n      w, h = occ_grid.shape[0], occ_grid.shape[1]   # width, height\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}           # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in _MOVES:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and occ_grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def _nearest_kind(kind_idx, cur, occ_grid):\n      \"\"\"Find the nearest cell containing the requested kind (Manhattan distance).\"\"\"\n      xs, ys = np.where(occ_grid[:, :, kind_idx] > 0)   # xs: x\u2011coords, ys: y\u2011coords\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur[0]) + np.abs(ys - cur[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning.\n              return actions\n          actions.extend(_bfs_path(cur_pos, target, grid))\n          actions.append(USE)                     # pick up the primitive\n          # Mark the cell as empty for subsequent planning\n          grid[target[1], target[0], kind_idx] = 0\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(_bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)                     # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:18:16.444528", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  # Movement vectors paired with their corresponding action index\n  _MOVES = [\n      ((0, 1), DOWN),   # down  (y+1)\n      ((0, -1), UP),    # up    (y-1)\n      ((-1, 0), LEFT),  # left  (x-1)\n      ((1, 0), RIGHT),  # right (x+1)\n  ]\n\n  def _bfs_path(start, goal, grid):\n      \"\"\"Return a list of actions that moves from start to goal using BFS.\n      Cells that contain any non\u2011zero kind are treated as blocked,\n      except the goal cell itself (which may hold the target item).\"\"\"\n      w, h = grid.shape[0], grid.shape[1]          # width (x), height (y)\n      from collections import deque\n      q = deque([tuple(start)])\n      prev = {tuple(start): (None, None)}          # pos -> (prev_pos, action)\n\n      while q:\n          x, y = q.popleft()\n          if [x, y] == goal:\n              break\n          for (dx, dy), act in _MOVES:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if (nx, ny) in prev:\n                  continue\n              # allow stepping onto the goal cell even if occupied\n              if (nx, ny) != tuple(goal) and grid[nx, ny].sum() != 0:\n                  continue\n              prev[(nx, ny)] = ((x, y), act)\n              q.append((nx, ny))\n\n      if tuple(goal) not in prev:\n          return []   # unreachable\n\n      # reconstruct path\n      path = []\n      cur = tuple(goal)\n      while prev[cur][0] is not None:\n          cur, act = prev[cur]\n          path.append(act)\n      path.reverse()\n      return path\n\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      \"\"\"Find the nearest cell containing the requested kind (Manhattan).\"\"\"\n      xs, ys = np.where(grid[:, :, kind_idx] > 0)   # xs: x\u2011coords, ys: y\u2011coords\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Planning start\n  # ------------------------------------------------------------------\n  actions = []\n\n  # Determine current position (prefer live state if available)\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Mutable copy of the static grid for planning (so we can \u201cremove\u201d items once taken)\n  grid = env.scenario.init_grid.copy()\n\n  # Goal item index\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources required for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n\n  # If the goal itself is a primitive we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Primitive not found \u2013 abort planning.\n              return actions\n          # Move to the primitive\n          actions.extend(_bfs_path(cur_pos, target, grid))\n          # Pick it up\n          actions.append(USE)\n          # Mark the cell as empty for subsequent planning\n          grid[target[0], target[1], kind_idx] = 0\n          # Update current position\n          cur_pos = target\n\n  # ------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          actions.extend(_bfs_path(cur_pos, workshop_pos, grid))\n          actions.append(USE)          # perform crafting at the workshop\n          cur_pos = workshop_pos\n\n  # Return the complete action sequence\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:18:34.805014", "function_name": "make_arrow", "function_body": "  # Action indices\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a sequence of actions moving the agent from\n  # start position to a cell adjacent (or on) any of the target cells.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency to any target\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No reachable path\n      return []\n\n  # ------------------------------------------------------------------\n  # Extract world, cookbook and goal information\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  cookbook = world.cookbook\n\n  # Goal is fixed to \"arrow\"\n  goal_idx = cookbook.index[\"arrow\"]\n  primitive_requirements = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)                # current (x, y)\n  grid = state.grid.copy()              # mutable copy of the world grid\n  occupied = np.any(grid > 0, axis=2)   # boolean mask of blocked cells\n\n  actions = []\n  harvested = set()                     # cells already used for collection\n\n  # ------------------------------------------------------------------\n  # Collect all required primitive items\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitive_requirements.items():\n      # All locations that currently contain this primitive\n      locations = [tuple(p) for p in np.argwhere(grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      collected = 0\n      for loc in locations:\n          if collected >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive cell\n          path = _bfs_path(pos, [loc], occupied)\n          actions.extend(path)\n          # Update position according to the path taken\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive\n          actions.append(USE)\n          # Mark the cell as empty for future navigation\n          grid[loc[0], loc[1], prim_idx] = 0\n          occupied[loc[0], loc[1]] = False\n          harvested.add(loc)\n          collected += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a name or already an int)\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Find all workshop cells currently present\n      workshop_cells = [tuple(p) for p in np.argwhere(grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop cell\n          workshop_cells.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:18:35.933060", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of actions moving the agent from\n  # start position to a cell adjacent (or on) any of the target cells.\n  # ------------------------------------------------------------------\n  def _bfs_path(start, targets, occupied):\n      w, h = occupied.shape\n      q = collections.deque()\n      q.append((start[0], start[1], []))\n      visited = {start}\n      target_set = set(targets)\n\n      while q:\n          x, y, path = q.popleft()\n          # Check adjacency (including same cell)\n          for tx, ty in target_set:\n              if abs(x - tx) + abs(y - ty) <= 1:\n                  return path\n          # Expand neighbours\n          for dx, dy, act in ((0, 1, DOWN), (0, -1, UP),\n                              (-1, 0, LEFT), (1, 0, RIGHT)):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not occupied[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append((nx, ny, path + [act]))\n      # No path found\n      return []\n\n  # ------------------------------------------------------------------\n  # Retrieve world and cookbook from the environment\n  # ------------------------------------------------------------------\n  world = getattr(env, \"world\", None)\n  if world is None:\n      # Some wrappers store the world inside the current state\n      state_tmp = getattr(env, \"_current_state\", None)\n      if state_tmp is not None:\n          world = state_tmp.world\n  cookbook = world.cookbook\n\n  # Goal is hard\u2011coded to \"arrow\"\n  goal_idx = cookbook.index[\"arrow\"]\n  primitives_needed = cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  # ------------------------------------------------------------------\n  # Ensure we have a current state (reset if necessary)\n  # ------------------------------------------------------------------\n  state = getattr(env, \"_current_state\", None)\n  if state is None:\n      env.reset()\n      state = env._current_state\n\n  pos = tuple(state.pos)               # (x, y)\n  cur_grid = state.grid.copy()         # mutable copy of the grid\n  occupied = np.any(cur_grid > 0, axis=2)   # boolean mask of occupied cells\n\n  actions = []\n  harvested = set()                    # cells already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive\n  # ------------------------------------------------------------------\n  for prim_idx, needed in primitives_needed.items():\n      # Locate all cells that currently contain this primitive\n      locations = [tuple(p) for p in np.argwhere(cur_grid[:, :, prim_idx] > 0)]\n      # Sort by Manhattan distance from current position for efficiency\n      locations.sort(key=lambda l: abs(l[0] - pos[0]) + abs(l[1] - pos[1]))\n      gathered = 0\n      for loc in locations:\n          if gathered >= needed:\n              break\n          if loc in harvested:\n              continue\n          # Move adjacent to the primitive (or onto it if possible)\n          path = _bfs_path(pos, [loc], occupied)\n          actions.extend(path)\n          # Update position according to the path taken\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Pick up the primitive\n          actions.append(USE)\n          # Mark the cell as empty for future path\u2011finding\n          cur_grid[loc[0], loc[1], prim_idx] = 0\n          occupied[loc[0], loc[1]] = False\n          harvested.add(loc)\n          gathered += 1\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its required workshop (if any)\n  # ------------------------------------------------------------------\n  recipe = cookbook.recipes.get(goal_idx, {})\n  workshop_key = recipe.get(\"_at\")\n  if workshop_key is not None:\n      # Resolve workshop index (could be a string name or already an int)\n      workshop_idx = (cookbook.index[workshop_key]\n                      if isinstance(workshop_key, str) else workshop_key)\n      # Find all workshop cells in the current grid\n      workshop_cells = [tuple(p) for p in np.argwhere(cur_grid[:, :, workshop_idx] > 0)]\n      if workshop_cells:\n          # Choose the nearest workshop\n          workshop_cells.sort(key=lambda w: abs(w[0] - pos[0]) + abs(w[1] - pos[1]))\n          target_ws = workshop_cells[0]\n          # Move adjacent to the workshop\n          path = _bfs_path(pos, [target_ws], occupied)\n          actions.extend(path)\n          for act in path:\n              if act == RIGHT:\n                  pos = (pos[0] + 1, pos[1])\n              elif act == LEFT:\n                  pos = (pos[0] - 1, pos[1])\n              elif act == DOWN:\n                  pos = (pos[0], pos[1] + 1)\n              elif act == UP:\n                  pos = (pos[0], pos[1] - 1)\n          # Use the workshop to craft the arrow\n          actions.append(USE)\n\n  return actions", "env_interactions": 23, "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:18:59.713381", "function_name": "make_arrow", "function_body": "  # Reset environment to start a fresh episode\n  env.reset()\n\n  # Goal information and recipe details\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)          # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Action name \u2192 integer ID mapping\n  act_map = env.action_specs()          # e.g. {\"UP\":0, \"DOWN\":1, \"LEFT\":2, \"RIGHT\":3, \"USE\":4}\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ----------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent from\n  # `start` to a cell that is adjacent (Chebyshev distance \u2264 1) to any cell\n  # in `targets`.  Only empty cells (no entity present) may be traversed.\n  # ----------------------------------------------------------------------\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return list of action names to reach a cell adjacent to any target.\"\"\"\n      W, H = grid.shape[:2]\n      visited = set()\n      q = deque()\n      q.append((start, []))\n      visited.add(start)\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n          # If already adjacent to a target, we are done\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:\n                  # Walk only through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  actions = []\n\n  # ----------------------------------------------------------------------\n  # 1) Collect all required primitive items (respecting required counts)\n  # ----------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inventory = state.inventory\n      # Check if we already have all needed primitives\n      if all(inventory[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):\n          break\n\n      # Identify a missing primitive\n      missing_idx = None\n      for p_idx, cnt in needed_prims.items():\n          if inventory[p_idx] < cnt:\n              missing_idx = p_idx\n              break\n      if missing_idx is None:\n          break  # Should not happen\n\n      # Locate cells that currently contain this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Primitive {missing_idx} not found on the map.\")\n\n      # Plan a path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from position {state.pos}.\")\n\n      # Execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # Pick up the primitive with the USE action\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ----------------------------------------------------------------------\n  # 2) Move to the appropriate workshop (if any) and craft the goal item\n  # ----------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:19:00.850276", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch useful maps\n  env.reset()\n  act_map = env.action_specs()                     # e.g. {\"UP\":0, \"DOWN\":1, ...}\n  goal_idx = env.task.goal\n  needed_prims = env.world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\", None)\n\n  # Movement helpers\n  move_delta = {\"UP\": (-1, 0), \"DOWN\": (1, 0), \"LEFT\": (0, -1), \"RIGHT\": (0, 1)}\n  move_names = list(move_delta.keys())\n\n  from collections import deque\n\n  def bfs_to_adjacent(start, targets, grid):\n      \"\"\"Return a list of action names moving from `start` to a cell adjacent\n      (Chebyshev distance \u2264 1) to any cell in `targets`. Walk only through empty cells.\"\"\"\n      W, H = grid.shape[:2]\n      visited = np.zeros((W, H), dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # adjacency check\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # expand neighbours\n          for name in move_names:\n              dx, dy = move_delta[name]\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # can only walk through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [name]))\n      return None  # unreachable\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (respecting the required counts)\n  # ------------------------------------------------------------------\n  while True:\n      state = env._current_state\n      inv = state.inventory\n      if all(inv[p_idx] >= cnt for p_idx, cnt in needed_prims.items()):\n          break  # all primitives gathered\n\n      # pick a missing primitive (first that is insufficient)\n      missing_idx = next(p for p, c in needed_prims.items() if inv[p] < c)\n\n      # locate all cells containing this primitive\n      prim_cells = list(zip(*np.where(state.grid[:, :, missing_idx] > 0)))\n      if not prim_cells:\n          raise RuntimeError(f\"Primitive {missing_idx} not present on the map.\")\n\n      # plan path to an adjacent cell of the nearest primitive\n      path = bfs_to_adjacent(state.pos, prim_cells, state.grid)\n      if path is None:\n          raise RuntimeError(f\"Primitive {missing_idx} is unreachable from {state.pos}.\")\n\n      # execute movement actions\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n      # pick up the primitive\n      use_aid = act_map[\"USE\"]\n      actions.append(use_aid)\n      env.step(use_aid)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      workshop_cells = list(zip(*np.where(state.grid[:, :, workshop_kind] > 0)))\n      if not workshop_cells:\n          raise RuntimeError(\"Required workshop not found on the map.\")\n      path = bfs_to_adjacent(state.pos, workshop_cells, state.grid)\n      if path is None:\n          raise RuntimeError(\"Workshop is unreachable from current position.\")\n      for act_name in path:\n          aid = act_map[act_name]\n          actions.append(aid)\n          env.step(aid)\n\n  # Final USE to craft (or to pick up if no workshop needed)\n  final_use = act_map[\"USE\"]\n  actions.append(final_use)\n  env.step(final_use)\n\n  return actions", "env_interactions": 1, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:19:28.195057", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item and its recipe\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n  recipe = cookbook.recipes.get(target_idx, {})\n  ingredients = {k: v for k, v in recipe.items() if k != \"_at\"}\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Return a list of movement actions (0\u20113) to reach any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # treat a cell as blocked if any entity occupies it and it is not a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update *pos* according to a list of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ---- collect required primitives ---------------------------------------\n  for ing_idx, needed in ingredients.items():\n      # find all cells containing this ingredient\n      locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ing_idx] > 0]\n      collected = 0\n      while collected < needed and locations:\n          target = locations.pop(0)\n\n          # move to the target cell\n          path = bfs(pos, {target})\n          if path is None:\n              continue  # cannot reach this instance\n          actions.extend(path)\n          move_along(path)\n\n          # pick up the item\n          actions.append(4)          # USE\n          grid[target[0], target[1], ing_idx] = 0\n          inventory[ing_idx] += 1\n          collected += 1\n\n  # ---- go to the workshop and craft --------------------------------------\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      actions.append(4)   # USE directly if no workshop required\n      return actions\n\n  workshop_idx = workshop_name if isinstance(workshop_name, int) else cookbook.index[workshop_name]\n  workshop_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, workshop_idx] > 0]\n\n  if workshop_cells:\n      ws_target = workshop_cells[0]\n      path = bfs(pos, {ws_target})\n      if path:\n          actions.extend(path)\n          move_along(path)\n\n  # final USE to craft the arrow\n  actions.append(4)  # USE\n\n  return actions", "env_interactions": 18, "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:19:29.333194", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # target item\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # current representations\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Shortest path (list of actions) from start to any cell in goals.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in [(0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)]:  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # allow moving onto a goal cell even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update *pos* according to a sequence of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, amount):\n      \"\"\"Collect *amount* of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          # find any remaining cell containing the primitive\n          locations = [(x, y) for x in range(width) for y in range(height) if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break\n          # pick the closest reachable one\n          best_path = None\n          best_loc = None\n          for loc in locations:\n              path = bfs(pos, {loc})\n              if path is not None:\n                  best_path = path\n                  best_loc = loc\n                  break\n          if best_path is None:\n              break\n          actions.extend(best_path)\n          move_along(best_path)\n          # pick up\n          actions.append(4)          # USE\n          grid[best_loc[0], best_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          amount -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, needed):\n      \"\"\"Make sure *inventory[item_idx]* >= needed.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < needed:\n          # if primitive, just collect\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, needed - inventory[item_idx])\n              continue\n\n          # otherwise we need to craft it using its recipe\n          recipe = recipes.get(item_idx, {})\n          # ensure all ingredients are available\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              req = cnt\n              if inventory[ing_idx] < req:\n                  ensure_item(ing_idx, req)\n\n          # move to required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # craft one unit\n          actions.append(4)   # USE\n          # simulate inventory changes\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:19:48.422125", "function_name": "make_arrow", "function_body": "  # Reset the environment to start a fresh episode\n  env.reset()\n  actions: list[int] = []\n\n  # Mapping from action name (e.g., \"UP\") to the integer ID used by the env\n  act_map = env.action_specs()\n\n  # Identify the goal item index and its recipe information\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # Cardinal movement deltas (used for BFS)\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of action names moving the agent\n  # from `start` to a cell that is Chebyshev\u2011adjacent (\u22641 in both axes)\n  # to any cell in `targets`. Only completely empty cells may be walked\n  # through (grid cell sum == 0).\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # Check if current cell is adjacent to any target cell\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # Expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # Only walk through empty cells (no entity present)\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # No reachable adjacent cell\n\n  # ------------------------------------------------------------------\n  # 1) Collect all required primitives (in the quantities needed)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # Find all cells that currently contain this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # Primitive not present any more; abort collection for this type\n              break\n\n          # Compute a path to the nearest instance (adjacent cell)\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # Unreachable primitive \u2013 give up on this one\n              break\n\n          # Execute the movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # Pick up the primitive using the USE action\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the required workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      # Locate all workshop cells of the appropriate type\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # Perform the crafting action at the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # Return the compiled list of action IDs that achieve the goal\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:19:49.554959", "function_name": "make_arrow", "function_body": "  env.reset()\n  actions: list[int] = []\n  act_map = env.action_specs()          # name \u2192 id\n  goal_idx = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal_idx)   # primitive idx \u2192 count\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get('_at', None)\n\n  # cardinal movement deltas\n  move_delta = {\n      \"UP\":    (-1, 0),\n      \"DOWN\":  (1, 0),\n      \"LEFT\":  (0, -1),\n      \"RIGHT\": (0, 1),\n  }\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returning a list of action names that moves the agent\n  # from `start` to a cell Chebyshev\u2011adjacent (\u22641) to any of `targets`.\n  # Traversal is allowed only through empty cells.\n  # ------------------------------------------------------------------\n  def bfs_to_adjacent(start, targets, grid):\n      from collections import deque\n      W, H = grid.shape[:2]\n      visited = np.full((W, H), False, dtype=bool)\n      q = deque()\n      q.append((start, []))\n      visited[start] = True\n      target_set = set(targets)\n\n      while q:\n          pos, path = q.popleft()\n\n          # adjacency test\n          for tx, ty in target_set:\n              if max(abs(pos[0] - tx), abs(pos[1] - ty)) <= 1:\n                  return path\n\n          # expand neighbours\n          for act_name, (dx, dy) in move_delta.items():\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < W and 0 <= ny < H and not visited[nx, ny]:\n                  # can walk only through completely empty cells\n                  if grid[nx, ny].sum() == 0:\n                      visited[nx, ny] = True\n                      q.append(((nx, ny), path + [act_name]))\n      return None  # unreachable\n\n  # ------------------------------------------------------------------\n  # 1) Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          state = env._current_state\n          grid = state.grid\n          pos = state.pos\n\n          # locate all cells currently holding this primitive\n          prim_cells = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not prim_cells:\n              # primitive missing \u2013 stop trying\n              break\n\n          path = bfs_to_adjacent(pos, prim_cells, grid)\n          if path is None:\n              # unreachable \u2013 give up on this primitive\n              break\n\n          # execute movement actions\n          for act_name in path:\n              act_id = act_map[act_name]\n              actions.append(act_id)\n              env.step(act_id)\n\n          # pick up the primitive\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  # ------------------------------------------------------------------\n  # 2) Move to the workshop (if any) and craft the goal item\n  # ------------------------------------------------------------------\n  if workshop_kind is not None:\n      state = env._current_state\n      grid = state.grid\n      pos = state.pos\n\n      workshop_cells = list(zip(*np.where(grid[:, :, workshop_kind] > 0)))\n      if workshop_cells:\n          path = bfs_to_adjacent(pos, workshop_cells, grid)\n          if path:\n              for act_name in path:\n                  act_id = act_map[act_name]\n                  actions.append(act_id)\n                  env.step(act_id)\n\n          # craft using the workshop\n          use_id = act_map[\"USE\"]\n          actions.append(use_id)\n          env.step(use_id)\n\n  return actions", "env_interactions": 0, "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:20:23.993051", "function_name": "make_arrow", "function_body": "  # ------------------------------------------------------------------\n  # Prepare environment information and helper utilities\n  # ------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)  # {prim_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)          # (row, col)\n  grid = state.grid.copy()        # occupancy tensor\n  actions = []\n\n  # indices of entities that block movement (cannot be entered)\n  non_grab = list(env.world.non_grabbable_indices)\n\n  # ------------------------------------------------------------------\n  # Path\u2011finding: A* (Manhattan heuristic) avoiding non\u2011grabbable cells\n  # ------------------------------------------------------------------\n  from heapq import heappush, heappop\n\n  def find_path(start, target):\n      \"\"\"Return a list of movement actions from *start* to *target* while\n      avoiding cells that contain any non\u2011grabbable entity.\n      Returns None if no path exists.\"\"\"\n      if start == target:\n          return []\n\n      width, height = grid.shape[:2]\n\n      # Build a boolean mask of blocked cells\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((width, height), dtype=bool)\n\n      # The target cell is allowed even if it would otherwise be blocked\n      blocked[target[0], target[1]] = False\n\n      # A* priority queue\n      open_q = []\n      heappush(open_q, (0 + abs(start[0] - target[0]) + abs(start[1] - target[1]), 0, start))\n      came_from = {start: None}\n      action_from = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while open_q:\n          _, cost, cur = heappop(open_q)\n          if cur == target:\n              break\n          x, y = cur\n          for a, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              if blocked[nx, ny]:\n                  continue\n              nxt = (nx, ny)\n              new_cost = cost + 1\n              if nxt not in came_from:\n                  came_from[nxt] = cur\n                  action_from[nxt] = a\n                  priority = new_cost + abs(nx - target[0]) + abs(ny - target[1])\n                  heappush(open_q, (priority, new_cost, nxt))\n\n      if target not in came_from:\n          return None\n\n      # Reconstruct action list\n      rev_actions = []\n      cur = target\n      while cur != start:\n          rev_actions.append(action_from[cur])\n          cur = came_from[cur]\n      rev_actions.reverse()\n      return rev_actions\n\n  # ------------------------------------------------------------------\n  # 1. Collect all required primitives (may need multiple copies)\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Find all remaining instances of this primitive on the map\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              # No more instances; abort collection of this primitive\n              break\n\n          # Choose the nearest instance by Manhattan distance (fast heuristic)\n          target = min(\n              locations,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n\n          path = find_path(pos, target)\n          if path is None:\n              # Fallback: direct Manhattan moves ignoring obstacles\n              path = []\n              dx, dy = target[0] - pos[0], target[1] - pos[1]\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)  # pick up the primitive\n\n          # Update simulated position and clear the primitive from the grid copy\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # 2. Move to the workshop (if required) and craft the goal item\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          # Choose the nearest workshop\n          target_ws = min(\n              ws_locs,\n              key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]),\n          )\n          path = find_path(pos, target_ws)\n          if path is None:\n              # Fallback Manhattan moves\n              path = []\n              dx, dy = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              while dx > 0:\n                  path.append(DOWN)\n                  dx -= 1\n              while dx < 0:\n                  path.append(UP)\n                  dx += 1\n              while dy > 0:\n                  path.append(RIGHT)\n                  dy -= 1\n              while dy < 0:\n                  path.append(LEFT)\n                  dy += 1\n\n          actions.extend(path)\n          actions.append(USE)   # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:20:25.154949", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup and utilities\n  # ----------------------------------------------------------------------\n  spec = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = (\n      spec[\"DOWN\"],\n      spec[\"UP\"],\n      spec[\"LEFT\"],\n      spec[\"RIGHT\"],\n      spec[\"USE\"],\n  )\n\n  goal = env.task.goal\n  needed = env.world.cookbook.primitives_for(goal)          # {prim_idx: count}\n\n  state = env._current_state\n  pos = tuple(state.pos)                                    # (row, col)\n  grid = state.grid.copy()                                  # occupancy tensor\n  actions = []\n\n  from collections import deque\n  import numpy as np\n\n  # ----------------------------------------------------------------------\n  # BFS that returns a list of movement actions from start to the *nearest*\n  # cell in ``targets`` while avoiding non\u2011grabbable objects.\n  # ----------------------------------------------------------------------\n  def bfs_to_target(start, targets):\n      \"\"\"Find shortest path (as action list) from ``start`` to any cell in\n      ``targets``. Returns (path, target_cell) or (None, None) if unreachable.\"\"\"\n      w, h = grid.shape[:2]\n\n      # Cells that cannot be entered (any non\u2011grabbable entity present)\n      non_grab = list(env.world.non_grabbable_indices)\n      if non_grab:\n          blocked = np.any(grid[:, :, non_grab] > 0, axis=2)\n      else:\n          blocked = np.zeros((w, h), dtype=bool)\n\n      q = deque([start])\n      came_from = {start: None}\n      act_from = {}\n\n      dirs = [\n          (DOWN, (1, 0)),\n          (UP, (-1, 0)),\n          (RIGHT, (0, 1)),\n          (LEFT, (0, -1)),\n      ]\n\n      while q:\n          cur = q.popleft()\n          if cur in targets:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(act_from[cur])\n                  cur = came_from[cur]\n              path.reverse()\n              return path, cur  # cur is the target reached\n          x, y = cur\n          for a, (dx, dy) in dirs:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < w and 0 <= ny < h):\n                  continue\n              if blocked[nx, ny] and (nx, ny) not in targets:\n                  continue\n              nxt = (nx, ny)\n              if nxt not in came_from:\n                  came_from[nxt] = cur\n                  act_from[nxt] = a\n                  q.append(nxt)\n\n      return None, None  # no reachable target\n\n  # ----------------------------------------------------------------------\n  # 1. Collect all required primitives (may need several copies).\n  # ----------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # locate remaining instances of this primitive\n          locations = list(zip(*np.where(grid[:, :, prim_idx] > 0)))\n          if not locations:\n              break  # nothing left on the map\n\n          path, target = bfs_to_target(pos, set(locations))\n          if path is None:\n              # fallback: simple Manhattan moves ignoring obstacles\n              target = locations[0]\n              dr, dc = target[0] - pos[0], target[1] - pos[1]\n              path = []\n              while dr > 0:\n                  path.append(DOWN)\n                  dr -= 1\n              while dr < 0:\n                  path.append(UP)\n                  dr += 1\n              while dc > 0:\n                  path.append(RIGHT)\n                  dc -= 1\n              while dc < 0:\n                  path.append(LEFT)\n                  dc += 1\n\n          actions.extend(path)\n          actions.append(USE)                 # pick up the primitive\n          pos = target\n          grid[pos[0], pos[1], prim_idx] = 0  # remove from simulated grid\n\n  # ----------------------------------------------------------------------\n  # 2. Move to the appropriate workshop (if any) and craft the goal.\n  # ----------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal, {})\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      ws_locs = list(zip(*np.where(grid[:, :, workshop_idx] > 0)))\n      if ws_locs:\n          path, target_ws = bfs_to_target(pos, set(ws_locs))\n          if path is None:\n              # fallback Manhattan moves\n              target_ws = ws_locs[0]\n              dr, dc = target_ws[0] - pos[0], target_ws[1] - pos[1]\n              path = []\n              while dr > 0:\n                  path.append(DOWN)\n                  dr -= 1\n              while dr < 0:\n                  path.append(UP)\n                  dr += 1\n              while dc > 0:\n                  path.append(RIGHT)\n                  dc -= 1\n              while dc < 0:\n                  path.append(LEFT)\n                  dc += 1\n\n          actions.extend(path)\n          actions.append(USE)                 # craft at the workshop\n\n  return actions", "env_interactions": 0, "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T18:20:55.181476", "function_name": "make_arrow", "function_body": "  # Directions correspond to action ids: 0=DOWN,1=UP,2=LEFT,3=RIGHT\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  # ------------------------------------------------------------------\n  # Helper: BFS returns list of actions to reach any cell in `targets`\n  # ------------------------------------------------------------------\n  def bfs(start, targets, blocked):\n      w, h = blocked.shape\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable in valid scenarios\n\n  # ------------------------------------------------------------------\n  # Helper: move to a cell containing `kind_idx` and USE it `cnt` times\n  # ------------------------------------------------------------------\n  def go_to_and_use(kind_idx, cnt):\n      nonlocal pos, actions, grid, w, h, blocked\n      for _ in range(cnt):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ------------------------------------------------------------------\n  # 1) Resolve recipe for \"arrow\": primitives needed and crafting order\n  # ------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}          # primitive idx -> total count\n  craft_steps = []           # list of (item_idx, count) in execution order\n\n  def resolve(item_idx, mult):\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive, no recipe\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredient items first (ignore special keys)\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # After ingredients are ensured, schedule this item to be crafted\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ------------------------------------------------------------------\n  # 2) Static environment data\n  # ------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ------------------------------------------------------------------\n  # 3) Build action sequence\n  # ------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 3a) Collect all required primitive resources\n  for kind_idx, count in needed_prims.items():\n      go_to_and_use(kind_idx, count)\n\n  # 3b) Perform crafting steps at their workshops\n  for item_idx, count in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([ACTION_USE] * count)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:20:56.313757", "function_name": "make_arrow", "function_body": "  import collections\n  import numpy as np\n\n  DIRS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  ACTION_USE = 4\n\n  def bfs(start, targets, blocked):\n      \"\"\"Return a list of action indices moving from start to any target cell.\"\"\"\n      w, h = blocked.shape\n      q = collections.deque([(start, [])])\n      visited = {start}\n      while q:\n          (x, y), path = q.popleft()\n          if (x, y) in targets:\n              return path\n          for a, (dx, dy) in enumerate(DIRS):\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < w and 0 <= ny < h and (nx, ny) not in visited:\n                  if not blocked[nx, ny]:\n                      visited.add((nx, ny))\n                      q.append(((nx, ny), path + [a]))\n      return []  # unreachable in solvable scenarios\n\n  def go_to_and_use(kind_idx, count):\n      \"\"\"Move to a cell containing `kind_idx` and press USE `count` times.\"\"\"\n      nonlocal pos, actions, grid, w, h, blocked\n      for _ in range(count):\n          cells = {(x, y) for x in range(w) for y in range(h)\n                   if grid[x, y, kind_idx] > 0}\n          path = bfs(pos, cells, blocked)\n          actions.extend(path)\n          for a in path:\n              dx, dy = DIRS[a]\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions.append(ACTION_USE)\n\n  # ----------------------------------------------------------------------\n  # 1) Gather recipe information for the target item \"arrow\"\n  # ----------------------------------------------------------------------\n  world = env.world\n  cookbook = world.cookbook\n  arrow_idx = cookbook.index[\"arrow\"]\n\n  needed_prims = {}   # primitive kind -> total count required\n  craft_steps = []    # ordered list of (item_idx, count) to craft\n\n  def resolve(item_idx, mult):\n      \"\"\"Recursively collect primitive requirements and schedule crafting.\"\"\"\n      rec = cookbook.recipes.get(item_idx)\n      if rec is None:                     # primitive (no recipe entry)\n          needed_prims[item_idx] = needed_prims.get(item_idx, 0) + mult\n          return\n      # Resolve ingredient items first (ignore special keys like \"_at\" or \"_key\")\n      for ing, cnt in rec.items():\n          if isinstance(ing, int):\n              resolve(ing, cnt * mult)\n      # Schedule this item to be crafted after its ingredients are ready\n      craft_steps.append((item_idx, mult))\n\n  resolve(arrow_idx, 1)\n\n  # ----------------------------------------------------------------------\n  # 2) Static environment data\n  # ----------------------------------------------------------------------\n  grid = env._current_state.grid\n  w, h, _ = grid.shape\n  blocked = np.zeros((w, h), dtype=bool)\n  for idx in world.non_grabbable_indices:\n      blocked |= grid[:, :, idx] > 0\n\n  # ----------------------------------------------------------------------\n  # 3) Build the action sequence\n  # ----------------------------------------------------------------------\n  actions = []\n  pos = tuple(env._current_state.pos)\n\n  # 3a) Collect all required primitive resources\n  for kind_idx, cnt in needed_prims.items():\n      go_to_and_use(kind_idx, cnt)\n\n  # 3b) Perform crafting steps at the appropriate workshops\n  for item_idx, cnt in craft_steps:\n      rec = cookbook.recipes[item_idx]\n      wk_key = rec.get(\"_at\", rec.get(\"_key\"))\n      wk_idx = wk_key if isinstance(wk_key, int) else cookbook.index[wk_key]\n\n      wk_cells = {(x, y) for x in range(w) for y in range(h)\n                  if grid[x, y, wk_idx] > 0}\n      path = bfs(pos, wk_cells, blocked)\n      actions.extend(path)\n      for a in path:\n          dx, dy = DIRS[a]\n          pos = (pos[0] + dx, pos[1] + dy)\n\n      actions.extend([ACTION_USE] * cnt)\n\n  return actions", "env_interactions": 20, "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-10-28T18:21:16.572033", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # item not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if already adjacent/facing,\n  # or None if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # Mapping from action index to (dx, dy) movement\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          # A cell is walkable if it is inside the grid and empty\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      start_x, start_y = state.pos\n      start_dir = state.dir\n\n      from collections import deque\n      queue = deque()\n      queue.append((start_x, start_y, start_dir, []))\n      visited = {(start_x, start_y, start_dir)}\n\n      while queue:\n          x, y, d, actions = queue.popleft()\n          # Is the cell directly in front the target?\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          # Expand neighbours (move + turn)\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              queue.append((nx, ny, a, actions + [a]))\n\n      # Unreachable\n      return None\n\n  # --------------------------------------------------------------\n  # Determine which primitives are required to craft one arrow.\n  # If the recipe is empty, the arrow itself is a primitive that must\n  # be collected directly.\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  if not primitive_needs:\n      # Arrow is itself a primitive; just pick it up.\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # --------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              # Cannot reach the required primitive \u2013 abort early.\n              return actions\n          actions.extend(move_seq)\n          actions.append(4)   # USE to pick up / interact\n\n          # Keep cur_state in sync.\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          # Workshop unreachable \u2013 abort.\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)   # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 just attempt to craft in place.\n      actions.append(4)   # USE to craft\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:21:17.720374", "function_name": "make_arrow", "function_body": "  env.reset()\n  cur_state = env._current_state          # CraftState\n  world = env.world\n\n  # --------------------------------------------------------------\n  # Identify the index of the goal item \"arrow\"\n  # --------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:   # item not defined in this world\n      return []\n\n  # --------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that\n  # brings the agent to a position where the cell directly in front\n  # contains `target_kind`. Returns [] if already adjacent/facing,\n  # or None if unreachable.\n  # --------------------------------------------------------------\n  def _bfs_to_target(state, target_kind):\n      grid = state.grid\n      W, H = grid.shape[:2]\n\n      # action \u2192 (dx, dy)\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          if not in_bounds(x, y):\n              return False\n          # walkable iff the cell contains no entities at all\n          return not np.any(grid[x, y, :])\n\n      sx, sy = state.pos\n      sd = state.dir\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sd, []))\n      visited = {(sx, sy, sd)}\n\n      while q:\n          x, y, d, path = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return path\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, path + [a]))\n      return None\n\n  # --------------------------------------------------------------\n  # Determine primitives needed for one arrow.\n  # If recipe empty, treat arrow itself as a primitive to pick up.\n  # --------------------------------------------------------------\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)   # {kind_idx: count}\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # --------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # --------------------------------------------------------------\n  for prim_idx, cnt in primitive_needs.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_target(cur_state, prim_idx)\n          if move_seq is None:\n              return actions          # cannot reach; abort early\n          actions.extend(move_seq)\n          actions.append(4)           # USE to pick up / interact\n          for a in move_seq + [4]:\n              _, cur_state = cur_state.step(a)\n\n  # --------------------------------------------------------------\n  # Craft the arrow at its workshop (if any).\n  # --------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(cur_state, workshop_idx)\n      if move_seq is None:\n          return actions\n      actions.extend(move_seq)\n      actions.append(4)               # USE to craft\n      for a in move_seq + [4]:\n          _, cur_state = cur_state.step(a)\n  else:\n      # No specific workshop \u2013 try to craft in place.\n      actions.append(4)\n      _, cur_state = cur_state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T18:21:40.732768", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:\n      return []\n\n  # primitive requirements for one arrow; if none, treat arrow itself as a primitive to pick up\n  primitive_needs = world.cookbook.primitives_for(arrow_idx)\n  if not primitive_needs:\n      primitive_needs = {arrow_idx: 1}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # BFS that returns a list of movement actions (0\u20113) that brings the\n  # agent to a position where the cell directly in front contains\n  # `target_kind`. Returns None if unreachable.\n  # ------------------------------------------------------------------\n  def _bfs_to_target(st, target_kind):\n      grid = st.grid\n      W, H = grid.shape[:2]\n\n      # action \u2192 (dx, dy) for movement actions\n      deltas = {\n          0: (0, 1),   # DOWN\n          1: (0, -1),  # UP\n          2: (-1, 0),  # LEFT\n          3: (1, 0),   # RIGHT\n      }\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      from collections import deque\n      q = deque()\n      q.append((st.pos[0], st.pos[1], st.dir, []))\n      visited = {(st.pos[0], st.pos[1], st.dir)}\n\n      while q:\n          x, y, d, seq = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return seq\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, seq + [a]))\n\n      return None\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in primitive_needs.items():\n      for _ in range(needed_cnt):\n          move_seq = _bfs_to_target(state, prim_idx)\n          if move_seq is None:\n              return actions  # cannot reach required primitive\n          actions.extend(move_seq)\n          actions.append(4)  # USE to pick up / interact\n\n          # keep the simulated state in sync\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(state, workshop_idx)\n      if move_seq is None:\n          return actions  # workshop unreachable\n      actions.extend(move_seq)\n      actions.append(4)  # USE to craft\n\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      actions.append(4)  # USE to craft in place\n      _, state = state.step(4)\n\n  return actions", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
