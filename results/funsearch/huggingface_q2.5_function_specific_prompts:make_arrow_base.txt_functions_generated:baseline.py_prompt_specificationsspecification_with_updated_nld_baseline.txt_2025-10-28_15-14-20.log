{"timestamp": "2025-10-28T18:57:03.271480", "function_name": "make_arrow", "function_body": "  import numpy as np\n\n  # Action indices (as defined in the environment)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper: move from current position to a target cell, appending actions.\n  # ------------------------------------------------------------------\n  def _move_to(cur_pos, target, seq):\n      while cur_pos[0] != target[0] or cur_pos[1] != target[1]:\n          if cur_pos[0] < target[0]:\n              seq.append(RIGHT)\n              cur_pos[0] += 1\n          elif cur_pos[0] > target[0]:\n              seq.append(LEFT)\n              cur_pos[0] -= 1\n          elif cur_pos[1] < target[1]:\n              seq.append(DOWN)\n              cur_pos[1] += 1\n          elif cur_pos[1] > target[1]:\n              seq.append(UP)\n              cur_pos[1] -= 1\n\n  # ------------------------------------------------------------------\n  # Helper: locate the nearest cell that still contains at least one of\n  # the given kind index. Returns [x, y] or None if none are left.\n  # ------------------------------------------------------------------\n  def _nearest_kind(kind_idx, cur_pos, grid):\n      ys, xs = np.where(grid[:, :, kind_idx] > 0)\n      if xs.size == 0:\n          return None\n      dists = np.abs(xs - cur_pos[0]) + np.abs(ys - cur_pos[1])\n      best = int(np.argmin(dists))\n      return [int(xs[best]), int(ys[best])]\n\n  # ------------------------------------------------------------------\n  # Determine starting position (live state if available, else init).\n  # ------------------------------------------------------------------\n  if hasattr(env, \"_current_state\") and env._current_state is not None:\n      cur_pos = list(env._current_state.pos)\n  else:\n      cur_pos = list(env.scenario.init_pos)\n\n  # Work on a mutable copy of the initial grid so we can mark items as taken.\n  grid = env.scenario.init_grid.copy()\n\n  actions = []\n  goal_idx = env.task.goal\n\n  # ------------------------------------------------------------------\n  # 1. Gather all primitive resources needed for the goal.\n  # ------------------------------------------------------------------\n  primitive_needs = env.world.cookbook.primitives_for(goal_idx).copy()\n  # If the goal itself is a primitive, we also need to pick it up.\n  if goal_idx in env.world.cookbook.primitives:\n      primitive_needs[goal_idx] = primitive_needs.get(goal_idx, 0) + 1\n\n  for kind_idx, needed in primitive_needs.items():\n      for _ in range(needed):\n          target = _nearest_kind(kind_idx, cur_pos, grid)\n          if target is None:\n              # Required primitive missing \u2013 abort planning.\n              return actions\n          _move_to(cur_pos, target, actions)\n          actions.append(USE)                     # pick up / interact\n          grid[target[1], target[0], kind_idx] = 0  # mark as taken\n\n  # ------------------------------------------------------------------\n  # 2. Move to the required workshop (if any) and craft the final item.\n  # ------------------------------------------------------------------\n  recipe = env.world.cookbook.recipes.get(goal_idx, {})\n  workshop_kind = recipe.get(\"_at\")\n  if workshop_kind is not None:\n      workshop_pos = _nearest_kind(workshop_kind, cur_pos, grid)\n      if workshop_pos is not None:\n          _move_to(cur_pos, workshop_pos, actions)\n          actions.append(USE)                     # perform crafting\n\n  return actions", "env_interactions": 0, "island_id": 0, "scores": {"3": 0.0}}
