{"timestamp": "2025-10-28T22:19:40.294258", "function_name": "make_arrow", "function_body": "  # Resolve scenario and world objects\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state for planning\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  # Bread\u2011first search over (state, action\u2011history) pairs\n  from collections import deque, namedtuple\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_key(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      return (\n          st.pos,\n          st.dir,\n          tuple(st.inventory.tolist()),\n          st.grid.tobytes(),\n      )\n\n  visited = {_state_key(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  MAX_PLAN_LENGTH = 1000                     # safety cap\n  n_actions = getattr(world, \"n_actions\", 5)  # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have at least one arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune overly long sequences\n      if len(node.actions) >= MAX_PLAN_LENGTH:\n          continue\n\n      # Expand all primitive actions\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_key(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # No plan found within the limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
{"timestamp": "2025-10-28T22:20:06.985131", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:  # arrow not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that brings\n  # the agent to a cell whose *front* contains `target_kind`. Returns\n  # None if the target cannot be reached.\n  # ------------------------------------------------------------------\n  deltas = {0: (0, 1),   # DOWN\n            1: (0, -1),  # UP\n            2: (-1, 0),  # LEFT\n            3: (1, 0)}   # RIGHT\n\n  def _bfs_to_front(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:  # arrow itself is a primitive\n      needed = {arrow_idx: 1}\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          move_seq = _bfs_to_front(state, prim_idx)\n          if move_seq is None:          # unreachable primitive \u2192 abort planning\n              return plan\n          plan.extend(move_seq)\n          plan.append(4)                # USE to pick up\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_front(state, workshop_idx)\n      if move_seq is None:              # unreachable workshop \u2192 abort\n          return plan\n      plan.extend(move_seq)\n      plan.append(4)                    # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      plan.append(4)                    # USE to craft in place\n      _, state = state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:20:08.132382", "function_name": "make_arrow", "function_body": "  # Reset environment and get initial state/world references\n  env.reset()\n  state = env._current_state          # current CraftState\n  world = env.world\n\n  # Index of the goal item \"arrow\"\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  if arrow_idx == 0:                   # arrow not defined in this world\n      return []\n\n  # ------------------------------------------------------------------\n  # Helper: BFS that returns a list of movement actions (0\u20113) that brings\n  # the agent to a cell whose *front* contains `target_kind`.  Returns\n  # None if the target cannot be reached.\n  # ------------------------------------------------------------------\n  deltas = {0: (0, 1),   # DOWN\n            1: (0, -1),  # UP\n            2: (-1, 0),  # LEFT\n            3: (1, 0)}   # RIGHT\n\n  def _bfs_to_target(cur_state, target_kind):\n      grid = cur_state.grid\n      W, H = grid.shape[:2]\n\n      def in_bounds(x, y):\n          return 0 <= x < W and 0 <= y < H\n\n      def walkable(x, y):\n          return in_bounds(x, y) and not np.any(grid[x, y, :])\n\n      sx, sy = cur_state.pos\n      sdir = cur_state.dir\n\n      from collections import deque\n      q = deque()\n      q.append((sx, sy, sdir, []))\n      visited = {(sx, sy, sdir)}\n\n      while q:\n          x, y, d, actions = q.popleft()\n          dx, dy = deltas[d]\n          fx, fy = x + dx, y + dy\n          if in_bounds(fx, fy) and grid[fx, fy, target_kind] > 0:\n              return actions\n\n          for a in (0, 1, 2, 3):\n              ndx, ndy = deltas[a]\n              nx, ny = x + ndx, y + ndy\n              if not walkable(nx, ny):\n                  continue\n              if (nx, ny, a) in visited:\n                  continue\n              visited.add((nx, ny, a))\n              q.append((nx, ny, a, actions + [a]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine primitive requirements for a single arrow.\n  # ------------------------------------------------------------------\n  needed = world.cookbook.primitives_for(arrow_idx)\n  if not needed:                         # arrow itself is a primitive\n      needed = {arrow_idx: 1}\n\n  plan = []\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the required number of times.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          move_seq = _bfs_to_target(state, prim_idx)\n          if move_seq is None:          # unreachable primitive \u2192 abort planning\n              return plan\n          plan.extend(move_seq)\n          plan.append(4)                # USE to pick up\n          for a in move_seq + [4]:\n              _, state = state.step(a)\n\n  # ------------------------------------------------------------------\n  # Craft the arrow at its designated workshop (if any).\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name is not None:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      move_seq = _bfs_to_target(state, workshop_idx)\n      if move_seq is None:              # unreachable workshop \u2192 abort\n          return plan\n      plan.extend(move_seq)\n      plan.append(4)                    # USE to craft\n      for a in move_seq + [4]:\n          _, state = state.step(a)\n  else:\n      plan.append(4)                    # USE to craft in place\n      _, state = state.step(4)\n\n  return plan", "env_interactions": 26, "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:20:33.453248", "function_name": "make_arrow", "function_body": "  # Reset the environment and get core objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid.copy()             # mutable copy for planning\n\n  # Action indices (consistent with CraftLab.action_specs)\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  from collections import deque\n\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x])\n\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def bfs_path(start, goal):\n      \"\"\"Shortest path (list of actions) from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      visited = np.full((H, W), False, dtype=bool)\n      parent = {}\n      q = deque([start])\n      visited[start] = True\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions_rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      actions_rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      actions_rev.append(UP)\n                  elif cur[1] == px + 1:\n                      actions_rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited[ny, nx] = True\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Return coordinates of the nearest cell containing the given kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Find a free neighbour of `cell` not in `avoid`.\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                      # (y, x)\n  cleared = set()                          # cells we have already collected from\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present; abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          adj = adjacent_free(target, avoid=cleared)\n          if adj is None:\n              # No free neighbour; fall back to standing on the primitive cell\n              adj = target\n\n          # Move to the adjacent cell\n          actions += bfs_path(cur_pos, adj)\n          cur_pos = adj\n\n          # Face the primitive (by attempting a move into its cell)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid model: primitive disappears\n          grid[target[0], target[1], prim_idx] = 0\n          cleared.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          ws_adj = adjacent_free(ws_cell, avoid=cleared)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting of the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:20:34.619474", "function_name": "make_arrow", "function_body": "  # Reset the environment to a fresh state\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid.copy()             # Local mutable copy for planning\n\n  # Action indices as defined by the environment's action specs\n  specs = env.action_specs()\n  DOWN = specs[\"DOWN\"]\n  UP = specs[\"UP\"]\n  LEFT = specs[\"LEFT\"]\n  RIGHT = specs[\"RIGHT\"]\n  USE = specs[\"USE\"]\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  H, W = grid.shape[:2]\n\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def is_blocked(y, x):\n      \"\"\"A cell is blocked if any entity occupies it.\"\"\"\n      return np.any(grid[y, x, :])\n\n  # Directions with associated action indices\n  DIRS = [(1, 0, DOWN), (-1, 0, UP), (0, -1, LEFT), (0, 1, RIGHT)]\n\n  def bfs_path(start, goal):\n      \"\"\"Return a shortest path (list of actions) from start to goal avoiding blocked cells.\"\"\"\n      if start == goal:\n          return []\n      from collections import deque\n      q = deque([start])\n      visited = np.full((H, W), False, dtype=bool)\n      visited[start] = True\n      parent = {}\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # Reconstruct actions\n              actions_rev = []\n              cur = goal\n              while cur != start:\n                  py, px = parent[cur]\n                  if cur[0] == py + 1:\n                      actions_rev.append(DOWN)\n                  elif cur[0] == py - 1:\n                      actions_rev.append(UP)\n                  elif cur[1] == px + 1:\n                      actions_rev.append(RIGHT)\n                  elif cur[1] == px - 1:\n                      actions_rev.append(LEFT)\n                  cur = (py, px)\n              return list(reversed(actions_rev))\n          for dy, dx, act in DIRS:\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if visited[ny, nx]:\n                  continue\n              if is_blocked(ny, nx):\n                  continue\n              visited[ny, nx] = True\n              parent[(ny, nx)] = (y, x)\n              q.append((ny, nx))\n      # No path found\n      return []\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[dists.argmin()]\n      return tuple(nearest)\n\n  def adjacent_free(cell, avoid=set()):\n      \"\"\"Return a free neighbour of `cell` not in `avoid` (or None).\"\"\"\n      y, x = cell\n      for dy, dx, _ in DIRS:\n          ny, nx = y + dy, x + dx\n          if not in_bounds(ny, nx):\n              continue\n          if (ny, nx) in avoid:\n              continue\n          if not is_blocked(ny, nx):\n              return (ny, nx)\n      return None\n\n  # ------------------------------------------------------------------\n  # Identify the goal (arrow) and its required primitives\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index(\"arrow\")\n  needed = world.cookbook.primitives_for(arrow_idx)   # dict {primitive_idx: count}\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get(\"_at\")\n  workshop_idx = None\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n\n  actions = []\n  cur_pos = state.pos                       # (y, x)\n  collected = set()                         # cells we have already emptied\n\n  # ------------------------------------------------------------------\n  # Collect all required primitives\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive missing; abort early with whatever actions we have\n              return actions\n\n          # Choose a free adjacent cell to stand on while picking up\n          stand = adjacent_free(target, avoid=collected)\n          if stand is None:\n              # No free neighbour; as a fallback stand directly on the primitive cell\n              stand = target\n\n          # Move to the chosen standing cell\n          actions += bfs_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (perform a blocked move to set direction)\n          dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update internal grid model to reflect the collected primitive\n          grid[target[0], target[1], prim_idx] = 0\n          collected.add(target)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow\n  # ------------------------------------------------------------------\n  if workshop_idx is not None:\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          # Stand adjacent to the workshop if possible\n          ws_adj = adjacent_free(ws_cell, avoid=collected)\n          if ws_adj is None:\n              ws_adj = ws_cell\n          actions += bfs_path(cur_pos, ws_adj)\n          cur_pos = ws_adj\n\n          # Face the workshop (optional blocked move)\n          dy, dx = ws_cell[0] - cur_pos[0], ws_cell[1] - cur_pos[1]\n          if dy == 1:\n              actions.append(DOWN)\n          elif dy == -1:\n              actions.append(UP)\n          elif dx == 1:\n              actions.append(RIGHT)\n          elif dx == -1:\n              actions.append(LEFT)\n\n  # Trigger crafting of the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 37, "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:20:56.310518", "function_name": "make_arrow", "function_body": "  # Reset the environment and fetch the initial state and world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = np.copy(state.grid)           # (WIDTH, HEIGHT, n_kinds)\n\n  # Action constants as defined in CraftWorld\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell (y, x) containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of `cell` (or the cell itself if none).\"\"\"\n      y, x = cell\n      candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return cell\n\n  def direction_to(src, dst):\n      \"\"\"Return the movement action that makes the agent at src face dst (one step).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives\n  # ------------------------------------------------------------------\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the needed number of times\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early\n              return actions\n\n          # Choose a free adjacent cell to stand on (or stay on the cell if none)\n          stand = free_adjacent(target)\n\n          # Move to the chosen standing location\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          # Face the primitive (helps the USE action)\n          turn = direction_to(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          # Pick up the primitive\n          actions.append(USE)\n\n          # Update our internal copy of the grid to reflect the collected item\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if the recipe specifies one) and craft the goal\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting of the arrow\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:20:57.469737", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state\n  world = env.world\n  grid = np.copy(state.grid)\n\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) from start to goal.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy = gy - y\n      dx = gx - x\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind index.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  def free_adjacent(cell):\n      \"\"\"Return a free orthogonal neighbour of `cell` (or the cell itself if none).\"\"\"\n      y, x = cell\n      candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n              if not occupied:\n                  return (ny, nx)\n      return cell\n\n  def direction_to(src, dst):\n      \"\"\"Return the action that makes the agent at src face dst (one step).\"\"\"\n      sy, sx = src\n      dy, dx = dst[0] - sy, dst[1] - sx\n      if dy == 1:\n          return DOWN\n      if dy == -1:\n          return UP\n      if dx == 1:\n          return RIGHT\n      if dx == -1:\n          return LEFT\n      return None\n\n  # Identify the goal and its required primitives\n  goal_name = \"arrow\"\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos\n\n  # Collect each required primitive the necessary number of times\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present; abort early.\n              return actions\n\n          stand = free_adjacent(target)\n          actions += manhattan_path(cur_pos, stand)\n          cur_pos = stand\n\n          turn = direction_to(cur_pos, target)\n          if turn is not None:\n              actions.append(turn)\n\n          actions.append(USE)\n\n          # Update the internal copy of the grid to reflect collection\n          grid[target[0], target[1], prim_idx] = 0\n\n  # Move to the workshop (if the recipe specifies one) and craft the arrow\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:21:14.413117", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # copy mutable structures\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Shortest path (as list of actions) from start to any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # can step onto a goal cell even if occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update simulated position according to *path*.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection helper\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect *needed* units of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break\n          path = None\n          target_loc = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path = cand\n                  target_loc = loc\n                  break\n          if path is None:\n              break\n          actions.extend(path)\n          move_along(path)\n          actions.append(4)  # USE to pick up\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Make sure inventory[item_idx] >= amount by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # gather ingredients first\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # move to workshop if required\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # perform crafting\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:21:15.607595", "function_name": "make_arrow", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  # Local mutable copies of the environment\n  grid = state.grid.copy()\n  pos = tuple(state.pos)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions = []\n\n  from collections import deque\n\n  def bfs(start, goals):\n      \"\"\"Shortest path (list of actions) from start to any cell in *goals*.\"\"\"\n      q = deque()\n      q.append((start, []))\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # allow moving onto a goal cell even if it is occupied\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path):\n      \"\"\"Update simulated position according to *path*.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(prim_idx, needed):\n      \"\"\"Collect *needed* units of primitive *prim_idx* from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          locations = [(x, y) for x in range(width) for y in range(height)\n                       if grid[x, y, prim_idx] > 0]\n          if not locations:\n              break\n          path = None\n          target_loc = None\n          for loc in locations:\n              cand = bfs(pos, {loc})\n              if cand is not None:\n                  path = cand\n                  target_loc = loc\n                  break\n          if path is None:\n              break\n          actions.extend(path)\n          move_along(path)\n          actions.append(4)  # USE to pick up\n          grid[target_loc[0], target_loc[1], prim_idx] = 0\n          inventory[prim_idx] += 1\n          needed -= 1\n\n  # ------------------------------------------------------------------\n  # Recursive crafting helper\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n\n  def ensure_item(item_idx, amount):\n      \"\"\"Make sure inventory[item_idx] >= amount by collecting/crafting.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          if item_idx in primitives_set:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          recipe = recipes.get(item_idx, {})\n          # Gather required ingredients first\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to the appropriate workshop if needed\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if ws_cells:\n                  path = bfs(pos, {ws_cells[0]})\n                  if path:\n                      actions.extend(path)\n                      move_along(path)\n\n          # Perform the crafting action\n          actions.append(4)  # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:21:39.295642", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # Setup\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  target_name = \"arrow\"\n  target_idx = cookbook.index[target_name]\n\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions: list[int] = []\n\n  from collections import deque\n\n  # ----------------------------------------------------------------------\n  # Helpers\n  def bfs(start: tuple[int, int], goals: set[tuple[int, int]]) -> list[int] | None:\n      \"\"\"Return a list of movement actions to reach any cell in *goals*.\"\"\"\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):  # DOWN,UP,LEFT,RIGHT\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # Blocked if occupied by a non\u2011workshop entity and not a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  # If the occupied cell is a workshop, we may step onto it\n                  occupied_kinds = np.where(grid[nx, ny, :] > 0)[0]\n                  if not any(k in world.workshop_indices for k in occupied_kinds):\n                      continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  def move_along(path: list[int]) -> None:\n      \"\"\"Update simulated position according to a sequence of actions.\"\"\"\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ----------------------------------------------------------------------\n  # Primitive collection\n  def collect_primitive(kind_idx: int, needed: int) -> None:\n      \"\"\"Collect *needed* units of a primitive from the grid.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while needed > 0:\n          # locate any cell that still contains this primitive\n          cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, kind_idx] > 0]\n          if not cells:\n              raise RuntimeError(f\"Not enough primitive {kind_idx} on the map\")\n          # find a reachable one (first reachable)\n          chosen_path = None\n          chosen_cell = None\n          for cell in cells:\n              p = bfs(pos, {cell})\n              if p is not None:\n                  chosen_path, chosen_cell = p, cell\n                  break\n          if chosen_path is None:\n              raise RuntimeError(\"Primitive unreachable\")\n          # travel to the primitive\n          actions.extend(chosen_path)\n          move_along(chosen_path)\n          # pick it up\n          actions.append(4)   # USE\n          grid[chosen_cell[0], chosen_cell[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          needed -= 1\n\n  # ----------------------------------------------------------------------\n  # Recursive crafting\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure_item(item_idx: int, amount: int) -> None:\n      \"\"\"Make sure at least *amount* of *item_idx* are in the inventory.\"\"\"\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < amount:\n          # Primitive \u2013 just collect\n          if item_idx in primitives:\n              collect_primitive(item_idx, amount - inventory[item_idx])\n              continue\n\n          # Craft using its recipe\n          recipe = recipes.get(item_idx, {})\n          # First, ensure all ingredients are available\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to required workshop (if any)\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = workshop if isinstance(workshop, int) else cookbook.index[workshop]\n              ws_cells = [(x, y) for x in range(width) for y in range(height) if grid[x, y, ws_idx] > 0]\n              if not ws_cells:\n                  raise RuntimeError(\"Required workshop not present on the map\")\n              path = bfs(pos, {ws_cells[0]})\n              if path is None:\n                  raise RuntimeError(\"Workshop unreachable\")\n              actions.extend(path)\n              move_along(path)\n\n          # Perform the craft action\n          actions.append(4)   # USE\n          # Update simulated inventory\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ----------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:21:40.455808", "function_name": "make_arrow", "function_body": "  import numpy as np\n  from collections import deque\n\n  # ------------------------------------------------------------------\n  # Basic references\n  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Target item index (arrow)\n  target_idx = cookbook.index[\"arrow\"]\n\n  # Local copies for planning\n  grid = state.grid.copy()\n  pos = tuple(state.pos)                     # (x, y)\n  inventory = state.inventory.copy()\n  width, height, _ = grid.shape\n  actions: list[int] = []\n\n  # ------------------------------------------------------------------\n  # Helper: breadth\u2011first search for a path of actions to any goal cell\n  def bfs(start: tuple[int, int], goals: set[tuple[int, int]]) -> list[int] | None:\n      q = deque([(start, [])])\n      visited = {start}\n      while q:\n          cur, path = q.popleft()\n          if cur in goals:\n              return path\n          x, y = cur\n          for dx, dy, act in ((0, 1, 0), (0, -1, 1), (-1, 0, 2), (1, 0, 3)):\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < width and 0 <= ny < height):\n                  continue\n              nxt = (nx, ny)\n              if nxt in visited:\n                  continue\n              # cell is blocked if any kind is present, unless it is a goal cell\n              if np.any(grid[nx, ny, :]) and nxt not in goals:\n                  continue\n              visited.add(nxt)\n              q.append((nxt, path + [act]))\n      return None\n\n  # ------------------------------------------------------------------\n  # Update simulated position according to a sequence of actions\n  def apply_path(path: list[int]) -> None:\n      nonlocal pos\n      for a in path:\n          if a == 0:   # DOWN\n              pos = (pos[0], pos[1] + 1)\n          elif a == 1: # UP\n              pos = (pos[0], pos[1] - 1)\n          elif a == 2: # LEFT\n              pos = (pos[0] - 1, pos[1])\n          elif a == 3: # RIGHT\n              pos = (pos[0] + 1, pos[1])\n\n  # ------------------------------------------------------------------\n  # Collect a primitive from the map\n  def collect_primitive(kind_idx: int, amount: int) -> None:\n      nonlocal actions, grid, inventory, pos\n      while amount > 0:\n          # locate cells that still contain the primitive\n          cells = [(x, y) for x in range(width) for y in range(height)\n                   if grid[x, y, kind_idx] > 0]\n          if not cells:\n              raise RuntimeError(f\"Not enough primitive {kind_idx} on the map\")\n          # find a reachable cell (first one found)\n          path = None\n          target = None\n          for cell in cells:\n              p = bfs(pos, {cell})\n              if p is not None:\n                  path, target = p, cell\n                  break\n          if path is None:\n              raise RuntimeError(\"Primitive unreachable\")\n          actions.extend(path)\n          apply_path(path)\n          # pick up the primitive\n          actions.append(4)                     # USE\n          grid[target[0], target[1], kind_idx] = 0\n          inventory[kind_idx] += 1\n          amount -= 1\n\n  # ------------------------------------------------------------------\n  # Ensure we have at least `need` units of `item_idx` in inventory\n  recipes = cookbook.recipes\n  primitives = cookbook.primitives\n\n  def ensure_item(item_idx: int, need: int) -> None:\n      nonlocal actions, grid, inventory, pos\n      while inventory[item_idx] < need:\n          # Primitive: just collect\n          if item_idx in primitives:\n              collect_primitive(item_idx, need - inventory[item_idx])\n              continue\n\n          # Craft using recipe\n          recipe = recipes.get(item_idx, {})\n          # Gather ingredients first\n          for ing_idx, cnt in list(recipe.items()):\n              if ing_idx == \"_at\":\n                  continue\n              if inventory[ing_idx] < cnt:\n                  ensure_item(ing_idx, cnt)\n\n          # Move to required workshop, if any\n          workshop = recipe.get(\"_at\")\n          if workshop is not None:\n              ws_idx = (workshop if isinstance(workshop, int)\n                        else cookbook.index[workshop])\n              ws_cells = [(x, y) for x in range(width) for y in range(height)\n                          if grid[x, y, ws_idx] > 0]\n              if not ws_cells:\n                  raise RuntimeError(\"Required workshop not found on map\")\n              p = bfs(pos, {ws_cells[0]})\n              if p is None:\n                  raise RuntimeError(\"Workshop unreachable\")\n              actions.extend(p)\n              apply_path(p)\n\n          # Perform the craft action\n          actions.append(4)                     # USE\n          for ing_idx, cnt in recipe.items():\n              if ing_idx == \"_at\":\n                  continue\n              inventory[ing_idx] -= cnt\n          inventory[item_idx] += 1\n\n  # ------------------------------------------------------------------\n  # Build the target arrow\n  ensure_item(target_idx, 1)\n\n  return actions", "env_interactions": 41, "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:22:10.881843", "function_name": "make_arrow", "function_body": "  # Reset environment and fetch current state information\n  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                   # CraftWorld instance\n  grid = state.grid                   # (WIDTH, HEIGHT, n_kinds)\n\n  # Action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def is_free(pos):\n      \"\"\"Return True if a cell is traversable (no non\u2011grabbable entity).\"\"\"\n      y, x = pos\n      return not np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n\n  def bfs(start, goals):\n      \"\"\"Breadth\u2011first search from ``start`` to any cell in ``goals``.\"\"\"\n      from collections import deque\n      q = deque([start])\n      visited = {start}\n      parent = {}\n\n      while q:\n          cur = q.popleft()\n          if cur in goals:\n              # reconstruct path\n              path = []\n              while cur != start:\n                  path.append(cur)\n                  cur = parent[cur]\n              path.append(start)\n              path.reverse()\n              return path\n          y, x = cur\n          for dy, dx in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  nxt = (ny, nx)\n                  if nxt not in visited and is_free(nxt):\n                      visited.add(nxt)\n                      parent[nxt] = cur\n                      q.append(nxt)\n      return None\n\n  def path_to_adjacent(target, from_pos):\n      \"\"\"\n      Find a path to a free cell adjacent to ``target``.\n      Returns (path, facing_dir) where ``facing_dir`` is the direction\n      the agent must face to use the primitive (or None if standing on it).\n      \"\"\"\n      ty, tx = target\n      # candidate adjacent cells (position, direction needed to face the target)\n      candidates = []\n      for dy, dx, face in [(-1, 0, DOWN), (1, 0, UP),\n                           (0, -1, RIGHT), (0, 1, LEFT)]:\n          ny, nx = ty + dy, tx + dx\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1] and is_free((ny, nx)):\n              candidates.append(((ny, nx), face))\n\n      if not candidates:\n          # No free neighbour \u2013 fall back to standing on the primitive itself.\n          path = bfs(from_pos, {target})\n          return path, None\n\n      # Choose the reachable candidate with the shortest path.\n      best_path, best_face = None, None\n      best_len = None\n      for cand, face in candidates:\n          path = bfs(from_pos, {cand})\n          if path is not None:\n              if best_len is None or len(path) < best_len:\n                  best_path, best_face, best_len = path, face, len(path)\n\n      if best_path is None:\n          # Could not reach any adjacent cell; try the primitive cell itself.\n          path = bfs(from_pos, {target})\n          return path, None\n      return best_path, best_face\n\n  def actions_from_path(path):\n      \"\"\"Convert a list of positions to a list of movement actions.\"\"\"\n      acts = []\n      for (y0, x0), (y1, x1) in zip(path, path[1:]):\n          if y1 > y0:\n              acts.append(DOWN)\n          elif y1 < y0:\n              acts.append(UP)\n          elif x1 > x0:\n              acts.append(RIGHT)\n          elif x1 < x0:\n              acts.append(LEFT)\n      return acts\n\n  # ------------------------------------------------------------------\n  # Determine primitives needed for an ``arrow``\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in required_prims.items():\n      for _ in range(needed_cnt):\n          # Locate the nearest instance of the primitive.\n          locations = np.argwhere(grid[:, :, prim_idx] > 0)\n          if locations.size == 0:\n              # Primitive missing \u2013 abort early.\n              return actions\n          dists = np.abs(locations[:, 0] - cur_pos[0]) + np.abs(locations[:, 1] - cur_pos[1])\n          target = tuple(locations[np.argmin(dists)])\n\n          # Find a path to an adjacent free cell and the direction to face.\n          path, face_dir = path_to_adjacent(target, cur_pos)\n          if path is None:\n              return actions\n\n          # Move along the path.\n          actions += actions_from_path(path)\n          cur_pos = path[-1]\n\n          # Face the primitive if required.\n          if face_dir is not None:\n              actions.append(face_dir)\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_locations = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_locations.size > 0:\n          dists = np.abs(ws_locations[:, 0] - cur_pos[0]) + np.abs(ws_locations[:, 1] - cur_pos[1])\n          ws_target = tuple(ws_locations[np.argmin(dists)])\n          ws_path = bfs(cur_pos, {ws_target})\n          if ws_path:\n              actions += actions_from_path(ws_path)\n              cur_pos = ws_path[-1]\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:22:12.059910", "function_name": "make_arrow", "function_body": "  env.reset()\n  state = env._current_state          # CraftState instance\n  world = env.world                    # CraftWorld instance\n  grid = state.grid                     # (WIDTH, HEIGHT, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Constants and helper utilities\n  # ------------------------------------------------------------------\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def manhattan_path(start, goal):\n      \"\"\"Return a list of movement actions that walk from ``start`` to ``goal``.\"\"\"\n      actions = []\n      y, x = start\n      gy, gx = goal\n      dy, dx = gy - y, gx - x\n\n      if dy > 0:\n          actions += [DOWN] * dy\n      elif dy < 0:\n          actions += [UP] * (-dy)\n\n      if dx > 0:\n          actions += [RIGHT] * dx\n      elif dx < 0:\n          actions += [LEFT] * (-dx)\n\n      return actions\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Linear scan for the nearest cell containing ``kind_idx``.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest = locations[np.argmin(dists)]\n      return tuple(nearest)\n\n  # ------------------------------------------------------------------\n  # Determine primitives required for an ``arrow``\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  required_prims = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos  # (row, col)\n\n  # ------------------------------------------------------------------\n  # Collect each required primitive the necessary number of times\n  # ------------------------------------------------------------------\n  for prim_idx, needed_cnt in required_prims.items():\n      for _ in range(needed_cnt):\n          target = find_nearest(prim_idx, cur_pos)\n          if target is None:\n              # Primitive not present \u2013 abort early.\n              return actions\n\n          ty, tx = target\n\n          # Choose an adjacent free cell to stand on before using.\n          adj = None\n          for ny, nx, facing in [\n              (ty - 1, tx, DOWN),   # stand above, face down\n              (ty + 1, tx, UP),     # stand below, face up\n              (ty, tx - 1, RIGHT),  # stand left, face right\n              (ty, tx + 1, LEFT)    # stand right, face left\n          ]:\n              if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n                  occupied = np.any(grid[ny, nx, list(world.non_grabbable_indices)] > 0)\n                  if not occupied:\n                      adj = (ny, nx, facing)\n                      break\n\n          # If no free neighbour, stand on the primitive cell itself.\n          if adj is None:\n              adj = (ty, tx, None)\n\n          # Move to the chosen adjacent cell.\n          actions += manhattan_path(cur_pos, adj[:2])\n          cur_pos = adj[:2]\n\n          # Adjust direction if needed.\n          if adj[2] is not None:\n              actions.append(adj[2])\n\n          # Pick up the primitive.\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if required) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(workshop_idx, cur_pos)\n      if ws_cell is not None:\n          actions += manhattan_path(cur_pos, ws_cell)\n          cur_pos = ws_cell\n\n  # Final USE triggers the crafting action.\n  actions.append(USE)\n\n  return actions", "env_interactions": 27, "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-10-28T22:23:04.940807", "function_name": "make_arrow", "function_body": "  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # ------------------------------------------------------------------\n  # Reset environment and fetch current state/world information.\n  # ------------------------------------------------------------------\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  # Work on a mutable copy of the grid so we can update it after pickups.\n  grid = state.grid.copy()             # (W, H, n_kinds)\n\n  # ------------------------------------------------------------------\n  # Helper functions\n  # ------------------------------------------------------------------\n  def bfs(start, goal, allow_goal_occupied=False):\n      \"\"\"Return a list of movement actions (DOWN/UP/LEFT/RIGHT) that moves\n      the agent from ``start`` to ``goal`` while avoiding occupied cells.\n      ``allow_goal_occupied`` lets the goal cell be occupied (used for\n      reaching a primitive cell that we will later pick up).\"\"\"\n      from collections import deque\n\n      h, w = grid.shape[0], grid.shape[1]\n      visited = np.full((h, w), False, dtype=bool)\n      prev = {}\n      q = deque([start])\n      visited[start] = True\n\n      while q:\n          y, x = q.popleft()\n          if (y, x) == goal:\n              # reconstruct actions\n              actions = []\n              cur = (y, x)\n              while cur != start:\n                  py, px = prev[cur]\n                  dy, dx = cur[0] - py, cur[1] - px\n                  if dy == 1:\n                      actions.append(DOWN)\n                  elif dy == -1:\n                      actions.append(UP)\n                  elif dx == 1:\n                      actions.append(RIGHT)\n                  elif dx == -1:\n                      actions.append(LEFT)\n                  cur = (py, px)\n              actions.reverse()\n              return actions\n\n          for dy, dx, act in [(1, 0, DOWN), (-1, 0, UP),\n                              (0, 1, RIGHT), (0, -1, LEFT)]:\n              ny, nx = y + dy, x + dx\n              if 0 <= ny < h and 0 <= nx < w and not visited[ny, nx]:\n                  occupied = np.any(grid[ny, nx, :] > 0)\n                  if occupied and not (allow_goal_occupied and (ny, nx) == goal):\n                      continue\n                  visited[ny, nx] = True\n                  prev[(ny, nx)] = (y, x)\n                  q.append((ny, nx))\n      # No path found \u2013 return empty list.\n      return []\n\n  def nearest_cells(kind_idx, from_pos):\n      \"\"\"Return list of coordinates containing ``kind_idx`` sorted by\n      Manhattan distance from ``from_pos``.\"\"\"\n      cells = np.argwhere(grid[:, :, kind_idx] > 0)\n      if cells.size == 0:\n          return []\n      dists = np.abs(cells[:, 0] - from_pos[0]) + np.abs(cells[:, 1] - from_pos[1])\n      order = np.argsort(dists)\n      return [tuple(cells[i]) for i in order]\n\n  def free_adjacent(cell, exclude=set()):\n      \"\"\"Return a free adjacent coordinate to ``cell`` (4\u2011neighbourhood).\n      If several are free, pick the one with smallest Manhattan distance\n      to the current position (computed later). Returns None if none are free.\"\"\"\n      y, x = cell\n      candidates = [(y - 1, x), (y + 1, x), (y, x - 1), (y, x + 1)]\n      free = []\n      for ny, nx in candidates:\n          if 0 <= ny < grid.shape[0] and 0 <= nx < grid.shape[1]:\n              if (ny, nx) in exclude:\n                  continue\n              if not np.any(grid[ny, nx, :] > 0):\n                  free.append((ny, nx))\n      return free if free else None\n\n  # ------------------------------------------------------------------\n  # Determine goal index and required primitives.\n  # ------------------------------------------------------------------\n  goal_name = 'arrow'\n  goal_idx = world.cookbook.index.index(goal_name)\n  needed = world.cookbook.primitives_for(goal_idx)   # {prim_idx: count}\n\n  actions = []\n  cur_pos = state.pos   # (y, x)\n\n  # ------------------------------------------------------------------\n  # Collect required primitives.\n  # ------------------------------------------------------------------\n  for prim_idx, count in needed.items():\n      for _ in range(count):\n          # Locate nearest primitive cell (dynamic, based on current grid)\n          candidates = nearest_cells(prim_idx, cur_pos)\n          if not candidates:\n              # Primitive not present \u2013 abort early.\n              return actions\n          target = candidates[0]   # nearest\n\n          # Choose a free adjacent cell to stand on (if possible)\n          adj_options = free_adjacent(target)\n          if adj_options:\n              # Pick the adjacent cell with minimal distance from cur_pos\n              adj = min(adj_options,\n                        key=lambda p: abs(p[0] - cur_pos[0]) + abs(p[1] - cur_pos[1]))\n              path = bfs(cur_pos, adj)\n          else:\n              # No free neighbour; we will step onto the primitive cell itself.\n              # Allow the goal cell to be occupied for the purpose of pickup.\n              path = bfs(cur_pos, target, allow_goal_occupied=True)\n              adj = target\n\n          actions.extend(path)\n          cur_pos = adj\n\n          # Determine facing direction towards the primitive (if not on same cell)\n          if cur_pos != target:\n              dy, dx = target[0] - cur_pos[0], target[1] - cur_pos[1]\n              if dy == 1:\n                  actions.append(DOWN)\n              elif dy == -1:\n                  actions.append(UP)\n              elif dx == 1:\n                  actions.append(RIGHT)\n              elif dx == -1:\n                  actions.append(LEFT)\n              # Now we are facing the primitive.\n          # Use action to pick it up.\n          actions.append(USE)\n\n          # Update grid to reflect that the primitive has been collected.\n          grid[target[0], target[1], prim_idx] = 0\n\n  # ------------------------------------------------------------------\n  # Move to required workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(goal_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      workshop_idx = world.cookbook.index.index(workshop_name)\n      # Find nearest workshop cell (static \u2013 workshops never disappear)\n      ws_cells = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if ws_cells.size > 0:\n          dists = np.abs(ws_cells[:, 0] - cur_pos[0]) + np.abs(ws_cells[:, 1] - cur_pos[1])\n          nearest_ws = tuple(ws_cells[np.argmin(dists)])\n          path = bfs(cur_pos, nearest_ws)\n          actions.extend(path)\n          cur_pos = nearest_ws\n\n  # Final USE to trigger crafting.\n  actions.append(USE)\n\n  return actions", "env_interactions": 21, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T22:23:06.091058", "function_name": "make_arrow", "function_body": "  # Action indices as defined by CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  # Direction vectors corresponding to the above actions\n  DIRS = {\n      DOWN: (1, 0),\n      UP: (-1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n\n  # Reset environment and obtain the current state and world objects\n  env.reset()\n  state = env._current_state          # CraftState\n  world = env.world                    # CraftWorld\n  grid = state.grid                     # (H, W, n_kinds)\n\n  H, W, _ = grid.shape\n  cur_pos = tuple(state.pos)            # (y, x)\n  cur_dir = int(state.dir)              # initial facing direction\n\n  # ------------------------------------------------------------------\n  # Helper utilities\n  # ------------------------------------------------------------------\n  def in_bounds(y, x):\n      return 0 <= y < H and 0 <= x < W\n\n  def cell_free(y, x):\n      \"\"\"Return True if the cell is traversable (no non\u2011grabbable or any item).\"\"\"\n      if not in_bounds(y, x):\n          return False\n      # Non\u2011grabbable entities block movement\n      occupied = np.any(grid[y, x, list(world.non_grabbable_indices)] > 0)\n      # Any item (including primitives) also blocks movement\n      occupied = occupied or np.any(grid[y, x, :] > 0)\n      return not occupied\n\n  def bfs_path(start, goal):\n      \"\"\"Return a list of movement actions from start to goal avoiding blocked cells.\n      If no path is found, returns empty list.\"\"\"\n      if start == goal:\n          return []\n      queue = collections.deque()\n      queue.append(start)\n      came_from = {start: None}\n      action_from = {}\n      while queue:\n          y, x = queue.popleft()\n          for act, (dy, dx) in DIRS.items():\n              ny, nx = y + dy, x + dx\n              if not in_bounds(ny, nx):\n                  continue\n              if not cell_free(ny, nx):\n                  continue\n              if (ny, nx) not in came_from:\n                  came_from[(ny, nx)] = (y, x)\n                  action_from[(ny, nx)] = act\n                  if (ny, nx) == goal:\n                      # reconstruct path\n                      path = []\n                      cur = goal\n                      while cur != start:\n                          path.append(action_from[cur])\n                          cur = came_from[cur]\n                      return list(reversed(path))\n                  queue.append((ny, nx))\n      return []  # no path found\n\n  def find_nearest(kind_idx, from_pos):\n      \"\"\"Locate the nearest cell containing the given kind.\"\"\"\n      locations = np.argwhere(grid[:, :, kind_idx] > 0)\n      if locations.size == 0:\n          return None\n      dists = np.abs(locations[:, 0] - from_pos[0]) + np.abs(locations[:, 1] - from_pos[1])\n      nearest_idx = np.argmin(dists)\n      return tuple(locations[nearest_idx])\n\n  def adjacent_free_cells(y, x):\n      \"\"\"Return list of free neighbour coordinates around (y,x).\"\"\"\n      neigh = []\n      for dy, dx in DIRS.values():\n          ny, nx = y + dy, x + dx\n          if in_bounds(ny, nx) and cell_free(ny, nx):\n              neigh.append((ny, nx))\n      return neigh\n\n  # ------------------------------------------------------------------\n  # Determine the goal index and the primitive requirements.\n  # ------------------------------------------------------------------\n  arrow_idx = world.cookbook.index.index('arrow')\n  needed = world.cookbook.primitives_for(arrow_idx)   # {prim_idx: count}\n\n  actions = []\n\n  # ------------------------------------------------------------------\n  # Collect each needed primitive.\n  # ------------------------------------------------------------------\n  for prim_idx, cnt in needed.items():\n      for _ in range(cnt):\n          # Locate the next instance of this primitive\n          prim_cell = find_nearest(prim_idx, cur_pos)\n          if prim_cell is None:\n              # primitive not present \u2013 abort planning\n              return actions\n\n          # Choose a free adjacent cell to stand on\n          adj_candidates = adjacent_free_cells(*prim_cell)\n          if not adj_candidates:\n              # cannot reach this primitive \u2013 abort\n              return actions\n          # pick the candidate with minimal Manhattan distance from current pos\n          dists = [abs(cy - cur_pos[0]) + abs(cx - cur_pos[1]) for (cy, cx) in adj_candidates]\n          adj = adj_candidates[int(np.argmin(dists))]\n\n          # Move to the chosen adjacent cell\n          move_seq = bfs_path(cur_pos, adj)\n          actions.extend(move_seq)\n          if move_seq:\n              cur_dir = move_seq[-1]   # last movement sets facing direction\n              cur_pos = adj\n\n          # Determine direction we need to face to interact with the primitive\n          dy = prim_cell[0] - cur_pos[0]\n          dx = prim_cell[1] - cur_pos[1]\n          needed_dir = None\n          for act, (ady, adx) in DIRS.items():\n              if (ady, adx) == (dy, dx):\n                  needed_dir = act\n                  break\n\n          # If we are not already facing the primitive, perform a turn by stepping\n          # temporarily to a neighbouring free cell and stepping back.\n          if needed_dir is not None and cur_dir != needed_dir:\n              # Compute a helper cell opposite to the needed direction relative to current pos\n              opp_y, opp_x = cur_pos[0] - dy, cur_pos[1] - dx\n              if in_bounds(opp_y, opp_x) and cell_free(opp_y, opp_x):\n                  # move to opposite cell\n                  turn_seq = bfs_path(cur_pos, (opp_y, opp_x))\n                  actions.extend(turn_seq)\n                  if turn_seq:\n                      cur_dir = turn_seq[-1]\n                      cur_pos = (opp_y, opp_x)\n                  # move back to original adjacent cell (this sets direction correctly)\n                  back_action = needed_dir\n                  actions.append(back_action)\n                  cur_dir = needed_dir\n                  cur_pos = adj\n              else:\n                  # fallback: just append the needed direction as a move (may be blocked)\n                  actions.append(needed_dir)\n                  cur_dir = needed_dir\n                  # position unchanged\n\n          # Use action to pick up the primitive\n          actions.append(USE)\n\n  # ------------------------------------------------------------------\n  # Move to the workshop (if any) and craft the arrow.\n  # ------------------------------------------------------------------\n  recipe = world.cookbook.recipes.get(arrow_idx, {})\n  workshop_name = recipe.get('_at')\n  if workshop_name:\n      ws_idx = world.cookbook.index.index(workshop_name)\n      ws_cell = find_nearest(ws_idx, cur_pos)\n      if ws_cell is not None:\n          move_seq = bfs_path(cur_pos, ws_cell)\n          actions.extend(move_seq)\n          if move_seq:\n              cur_dir = move_seq[-1]\n              cur_pos = ws_cell\n\n  # Final USE to trigger crafting\n  actions.append(USE)\n\n  return actions", "env_interactions": 30, "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-10-28T22:23:32.225691", "function_name": "make_arrow", "function_body": "  # ----------------------------------------------------------------------\n  # make_arrow_vn: generic BFS planner to obtain at least one \"arrow\"\n  # ----------------------------------------------------------------------\n  # Retrieve scenario and world objects (they may be wrapped in the env)\n  scenario = getattr(env, \"scenario\", None) or env\n  world = getattr(scenario, \"world\", None) or getattr(env, \"world\", None)\n  if world is None:\n      return []\n\n  # Index of the target item \"arrow\"\n  try:\n      target_idx = world.cookbook.index[\"arrow\"]\n  except Exception:\n      return []\n\n  # Initial state of the episode\n  try:\n      init_state = scenario.init()\n  except Exception:\n      return []\n\n  from collections import deque, namedtuple\n\n  Node = namedtuple(\"Node\", [\"state\", \"actions\"])\n\n  def _state_hash(st):\n      \"\"\"Hashable representation of a CraftState.\"\"\"\n      # Position, direction, inventory tuple, and immutable grid snapshot\n      return (st.pos, st.dir, tuple(st.inventory.tolist()), st.grid.tobytes())\n\n  # BFS frontier\n  visited = {_state_hash(init_state)}\n  frontier = deque([Node(init_state, [])])\n\n  # Safety limits\n  MAX_STEPS = 500                     # max plan length explored\n  n_actions = getattr(world, \"n_actions\", 5)   # typically 5 (4 moves + USE)\n\n  while frontier:\n      node = frontier.popleft()\n      cur_state = node.state\n\n      # Goal test: have an arrow in inventory\n      if cur_state.satisfies(\"\", target_idx):\n          return node.actions\n\n      # Prune excessively long action sequences\n      if len(node.actions) >= MAX_STEPS:\n          continue\n\n      # Expand each possible action\n      for a in range(n_actions):\n          _, next_state = cur_state.step(a)\n          key = _state_hash(next_state)\n          if key not in visited:\n              visited.add(key)\n              frontier.append(Node(next_state, node.actions + [a]))\n\n  # If we exit the loop no plan was found within limits\n  return []", "env_interactions": 20, "island_id": 1, "scores": {"3": 2.9}}
